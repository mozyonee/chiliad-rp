forward bool:Zone_IsCoordsInZone(Float:x, Float:y, Float:z, zoneid);

Zone_GetNameByCoords(Float:x, Float:y, Float:z, name[], size = sizeof name)
{
	for (new zoneid; zoneid < sizeof(ZoneData); zoneid++)
	{
		if (Zone_IsCoordsInZone(x, y, z, zoneid))
		{
			format(name, size, "%s", ZoneData[zoneid][ZoneName]);
			return 1;
		}
	}

	format(name, size, "Unknown");
	return 0;
}

bool:Zone_IsCoordsInZone(Float:x, Float:y, Float:z, zoneid)
{
	return x >= ZoneData[zoneid][ZoneMinX] && x < ZoneData[zoneid][ZoneMaxX]
		&& y >= ZoneData[zoneid][ZoneMinY] && y < ZoneData[zoneid][ZoneMaxY]
		&& z >= ZoneData[zoneid][ZoneMinZ] && z < ZoneData[zoneid][ZoneMaxZ];
}
