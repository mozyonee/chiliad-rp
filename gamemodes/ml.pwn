					MYSQL_GLOBAL[0] = EOS;
					mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL),"DELETE FROM `priz` WHERE `id` = '%i'",CountInfo[playerid][cont_id][GetPVarInt(playerid,"list_predm")]);
