			case 1: ShowPlayerDialog(playerid,D_TAXI_FARE_2,DSI,""P"Слоган","\n"YELLOW"Зміна гасла таксі (до 13 символов)"W"\n\nВведіть нижче нове гасло:","Далі","Скасувати");
			}
