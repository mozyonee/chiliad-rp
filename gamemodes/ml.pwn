							ShowPlayerDialog(playerid,D_SAFE_TRAILER_2,DSI, ""P"Сейф","\n\n"W"Вкажіть к-сть аптечок, яку ви хочете взяти з сейфу:\n\n"NO"*"G" Недостатньо аптечок у сейфі\n\n","Взяти","Скасувати");
							return 1;
						}
