	case D_TAXI_FARE_1: {
			if(!response) return 1;
			new veh = GetPlayerVehicleID(playerid), tar[10];
			if(strval(inputtext) < 75 || strval(inputtext) > 150) return ShowPlayerDialog(playerid,D_TAXI_FARE_1,DSI,""P"Тариф","\n"YELLOW"Зміна тарифа таксі (від 75$ до 30$)"W"\n\nВведіть нижче нову вартість за 1 км:","Далі","Скасувати");
			VehicleInfo[veh][vTarif] = strval(inputtext); 
