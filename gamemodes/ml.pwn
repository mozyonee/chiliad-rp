{
	new rows, query[128];
	cache_get_row_count(rows);
	if(rows)
	{
		mysql_format(connects, query, sizeof(query),"UPDATE `"TABLE_HOUSE"` SET `ownerid` = '0' WHERE `ownerid` = '%d'",id);
		mysql_tquery(connects,query);
	}
	return 1;
}
