								"P"6."W" Заборона TeamKill\t[%s"W"]\n\
								"P"7."W" Назви рангів\n\
								"P"8."W" Склад офлайн\n\
								"P"9."W" Чорний список\n"; 
		new string[sizeof(f_str) +1 + (-2 + 33) + (-2 + 33) + (-2 + 33) + (-2 + 33) + 40];
		format(string,sizeof(string),f_str,GetRankName(PI[playerid][pMember],FI[PI[playerid][pMember]][fInviteRang]),FI[PI[playerid][pMember]][fInviteRang],
		GetRankName(PI[playerid][pMember],FI[PI[playerid][pMember]][fUninviteRang]),FI[PI[playerid][pMember]][fUninviteRang],
		GetRankName(PI[playerid][pMember],FI[PI[playerid][pMember]][fGiveRang]),FI[PI[playerid][pMember]][fGiveRang],
		GetRankName(PI[playerid][pMember],FI[PI[playerid][pMember]][fSpawnRang]),FI[PI[playerid][pMember]][fSpawnRang],
		FI[PI[playerid][pMember]][fAntiTK]?(""NO"Вимкнена"):(""GREEN"Увімкнена"));
		ShowPlayerDialog(playerid,D_LMENU,DSL,""P"Панель лідера", string, "Обрати", "Закрити");
	}
	else
	{
		static const f_str[] = ""P"1."W" Може приймати\t"G"%s[%i]"W"\n\
								"P"2."W" Може звільняти\t"G"%s[%i]"W"\n\
								"P"3."W" Можт підвищувати\t"G"%s[%i]\n\
								"P"4."W" Доступ до складу\t"G"%s[%i]\n\
								"P"5."W" Спавн авто\t\t"G"%s[%i]\n\
								"P"6."W" Банк фракції\n\
								"P"7."W" Заборона TeamKill\t[%s"W"]\n\
								"P"8."W" Назви рангів\n\
								"P"9."W" Склад офлайн\n\
								"P"10."W" Чорний список\n\
								"P"11."W" Дипломатія";
		new string[sizeof(f_str) +1 + (-2 + 33) + (-2 + 33) + (-2 + 33) + (-2 + 33) + 40 + 15];
		format(string,sizeof(string),f_str,GetRankName(PI[playerid][pMember],FI[PI[playerid][pMember]][fInviteRang]),FI[PI[playerid][pMember]][fInviteRang],
		GetRankName(PI[playerid][pMember],FI[PI[playerid][pMember]][fUninviteRang]),FI[PI[playerid][pMember]][fUninviteRang],
		GetRankName(PI[playerid][pMember],FI[PI[playerid][pMember]][fGiveRang]),FI[PI[playerid][pMember]][fGiveRang],
		GetRankName(PI[playerid][pMember],FI[PI[playerid][pMember]][fUseStock]),FI[PI[playerid][pMember]][fUseStock],
		GetRankName(PI[playerid][pMember],FI[PI[playerid][pMember]][fSpawnRang]),FI[PI[playerid][pMember]][fSpawnRang],
		FI[PI[playerid][pMember]][fAntiTK]?(""NO"Вимкнути"):(""GREEN"Увімкнути"));
		ShowPlayerDialog(playerid,D_LMENU_2,DSL,""P"Панель лідера", string, "Обрати", "Закрити");
	}
	return 1;
}
CMD:changecar(playerid,params[]) {
	if(!PI[playerid][pRoom] && !PI[playerid][pHouse]) return SendError(playerid, "У вас немає т/з.");
	new giveplayerid,car_1,car_2,price;
	if(sscanf(params, "dddd",giveplayerid,car_1,car_2,price)) {
		SendClientMessage(playerid, COLOR_WHITE,"Використайте: /changecar [playerid] [your vehicle slot] [player vehicle slot] [player's surcharge]");
		new string[144];
		format(string,sizeof(string),"Слот #1 [%s]. Слот #2 [%s].",gTransport[CarsInfo[playerid][carModel][0]-400][trName],gTransport[CarsInfo[playerid][carModel][1]-400][trName]);
		SendError(playerid,string);
		return 1;
	}
	if(!PI[giveplayerid][pHouse] && !PI[giveplayerid][pRoom]) return SendError(playerid, "У гравця немає т/з.");
	if((car_1 < 1 && car_1 > 2) || (car_2 < 1 && car_2 > 2)) return 1;
	new model = GetVehicleModel(house_car[playerid][car_1-1]);
	if(!house_car[playerid][car_1-1] || model == 481) return SendError(playerid, "Не можна пропонувати обмін на BMX.");
	if(!model) return SendError(playerid, "Вигоніть автомобіль на вулицю.");
	if(price < 1 || price > 15000000) return SendError(playerid, "Не можна менше $1 і більше $15.000.000.");
	if(!IsPlayerStream(5.0, playerid, giveplayerid)) return SendError(playerid, "Гравець не поруч з вами.");
	if(giveplayerid == playerid) return SendError(playerid,not_id);
	SetPVarInt(giveplayerid,"carProdaet",playerid + 1);
	SetPVarInt(playerid,"carPokupaet",giveplayerid + 1);
	SetPVarInt(giveplayerid,"carCena",price);
	SetPVarInt(playerid,"numbercar1",car_1);
	SetPVarInt(playerid,"numbercar2",car_2);
	SetPVarInt(playerid,"sellcar_type",1);
	new improve[256];
	if(CarsInfo[giveplayerid][carVehcom_1][car_2-1]) strcat(improve,"\t\t\t[Спойлер]\n");
	if(CarsInfo[giveplayerid][carVehcom_2][car_2-1]) strcat(improve,"\t\t\t[Капот]\n");
	if(CarsInfo[giveplayerid][carVehcom_3][car_2-1]) strcat(improve,"\t\t\t[Повітрозабірник]\n");
	if(CarsInfo[giveplayerid][carVehcom_4][car_2-1]) strcat(improve,"\t\t\t[Бічна спідниця]\n");
	if(CarsInfo[giveplayerid][carVehcom_5][car_2-1]) strcat(improve,"\t\t\t[Фари]\n");
	if(CarsInfo[giveplayerid][carVehcom_6][car_2-1]) strcat(improve,"\t\t\t[Нітро]\n");
	if(CarsInfo[giveplayerid][carVehcom_7][car_2-1]) strcat(improve,"\t\t\t[Вихлопная труба]\n");
	if(CarsInfo[giveplayerid][carVehcom_8][car_2-1]) strcat(improve,"\t\t\t[Диски]\n");
	if(CarsInfo[giveplayerid][carVehcom_9][car_2-1]) strcat(improve,"\t\t\t[Стерео]\n");
	if(CarsInfo[giveplayerid][carVehcom_10][car_2-1]) strcat(improve,"\t\t\t[Гідравліка]\n");
	if(CarsInfo[giveplayerid][carVehcom_11][car_2-1]) strcat(improve,"\t\t\t[Передній бампер]\n");
	if(CarsInfo[giveplayerid][carVehcom_12][car_2-1]) strcat(improve,"\t\t\t[Задній бампер]\n");
	new improve2[256];
	if(CarsInfo[playerid][carVehcom_1][car_1-1]) strcat(improve2,"\t\t\t[Спойлер]\n");
	if(CarsInfo[playerid][carVehcom_2][car_1-1]) strcat(improve2,"\t\t\t[Капот]\n");
	if(CarsInfo[playerid][carVehcom_3][car_1-1]) strcat(improve2,"\t\t\t[Повітрозабірник]\n");
	if(CarsInfo[playerid][carVehcom_4][car_1-1]) strcat(improve2,"\t\t\t[Бічна спідниця]\n");
	if(CarsInfo[playerid][carVehcom_5][car_1-1]) strcat(improve2,"\t\t\t[Фари]\n");
	if(CarsInfo[playerid][carVehcom_6][car_1-1]) strcat(improve2,"\t\t\t[Нітро]\n");
	if(CarsInfo[playerid][carVehcom_7][car_1-1]) strcat(improve2,"\t\t\t[Вихлопна труба]\n");
	if(CarsInfo[playerid][carVehcom_8][car_1-1]) strcat(improve2,"\t\t\t[Диски]\n");
	if(CarsInfo[playerid][carVehcom_9][car_1-1]) strcat(improve2,"\t\t\t[Стерео]\n");
	if(CarsInfo[playerid][carVehcom_10][car_1-1]) strcat(improve2,"\t\t\t[Гідравліка]\n");
	if(CarsInfo[playerid][carVehcom_11][car_1-1]) strcat(improve2,"\t\t\t[Передній бампер]\n");
	if(CarsInfo[playerid][carVehcom_12][car_1-1]) strcat(improve2,"\t\t\t[Задній бампер]\n");
	new model1 = CarsInfo[playerid][carModel][car_1-1]-400;
	new model2 = CarsInfo[giveplayerid][carModel][car_2-1]-400;
	new classname[12];
	new classname2[12];
	GetCarClassName(gTransport[model1][trClass],classname);
	GetCarClassName(gTransport[model2][trClass],classname2);
	static const f_str[] = ""YELLOW"\t\t\tВаше авто:\n\n\
							"W"Марка авто: \t\t"P"%s\n\
							"W"Клас: \t\t\t"P"%s\n\
							"W"Пробіг: \t\t"P"%.0fкм\n\
							"W"Бензобак: \t\t"P"%dл\n\
							"W"Тюнінг:\n\
							"GREEN"%s\n\n\
							"YELLOW"\t\t\tАвто іншого гравця:\n\n\
							"W"Марка авто: \t\t"P"%s\n\
							"W"Клас: \t\t\t"P"%s\n\
							"W"Пробіг: \t\t"P"%.0fкм\n\
							"W"Бензобак: \t\t"P"%dл\n\
							"W"Тюнінг:\n\
							"GREEN"%s\n\n\
							"NO"Ви дійсно хочете запропонувати обмін з доплатою від іншого гравця:"ORANGE" $%d?";
	new string[900];
	format(string,sizeof(string),f_str,gTransport[model1][trName],classname,CarsInfo[playerid][carDrived][car_1-1],gTransport[model1][trTank],improve2,
	gTransport[model2][trName],classname2,CarsInfo[giveplayerid][carDrived][car_2-1],gTransport[model2][trTank],improve,price);
	ShowPlayerDialog(playerid,D_CHANGECAR,DSM, ""P"Обмін авто",string,"Так","Скасувати");
	return 1;
}
set_string(param_1[], param_2[])
{
    strmid(param_1, param_2, 0, strlen(param_2), 255);
    return 1;
}
CMD:sellcar(playerid, params[]) {
	if(GetPVarInt(playerid,"car_pokupaet")) return SendError(playerid, "У вас активний обмін т/з з гравцем.");
	if(!PI[playerid][pHouse] && !PI[playerid][pRoom] && !PI[playerid][pTempKey]) return SendError(playerid, "Ви не маєте будинку або квартири.");
	if(PI[playerid][pCredit]) return SendError(playerid, "У вас не виплачений кредит. Продаж т/з заборонений.");
	if(!params[0]) {
		new string[128];
		format(string,sizeof(string),""W"1. Транспорт #1 "P"[%s]\n"W"2. Транспорт #2 "P"[%s]",gTransport[CarsInfo[playerid][carModel][0]-400][trName],gTransport[CarsInfo[playerid][carModel][1]-400][trName]);
		ShowPlayerDialog(playerid,D_HOUSE_CARSELL,DSL,""P"Продати домашній транспорт",string,"Обрати","Закрити");
		return 1;
	}
	if(sscanf(params, "uii",params[0],params[1], params[2])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /sellcar [playerid] [1 чи 2 авто] [price]");
	if(!IsPlayerConnected(params[0]) || playerid == params[0]) return SendError(playerid,not_id);
	if(params[1] < 1 && params[1] > 2) return SendError(playerid,"Оберіть 1 или 2 автомобіль.");
	new model_sell = GetVehicleModel(house_car[playerid][params[1]-1]);
	if(!house_car[playerid][params[1]-1] || model_sell == 481) return SendError(playerid, "Не можна пропонувати обмін на BMX.");
	if(GetPlayerDistanceToPlayer(playerid,params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Ви далеко один від одного");
	new slot_car = -1;
	for(new i = 0; i < 2; i++) {
		if(CarsInfo[params[0]][carModel][i] != 481) continue;
		slot_car = i;
		break;
	}
	if(slot_car == -1) return SendError(playerid, "У гравця немає вільних місць під автомобіль.");
	if(params[2] <= 0) return SendError(playerid, "Вартість автомобіля не може бути менше $1.");
	SetPVarInt(params[0], "car_prodaet", playerid+1);
	SetPVarInt(playerid, "car_pokupaet", params[0]+1);
	SetPVarInt(params[0],"carCena",params[2]);
	SetPVarInt(playerid,"carnumber",params[1]-1);
	SetPVarInt(playerid,"sellcar",1);
	new improve[256];
	if(CarsInfo[playerid][carVehcom_1][params[1]-1]) strcat(improve,"\t\t\t[Спойлер]\n");
	if(CarsInfo[playerid][carVehcom_2][params[1]-1]) strcat(improve,"\t\t\t[Капот]\n");
	if(CarsInfo[playerid][carVehcom_3][params[1]-1]) strcat(improve,"\t\t\t[Повітрозабірник]\n");
	if(CarsInfo[playerid][carVehcom_4][params[1]-1]) strcat(improve,"\t\t\t[Бічна спідниця]\n");
	if(CarsInfo[playerid][carVehcom_5][params[1]-1]) strcat(improve,"\t\t\t[Фари]\n");
	if(CarsInfo[playerid][carVehcom_6][params[1]-1]) strcat(improve,"\t\t\t[Нітро]\n");
	if(CarsInfo[playerid][carVehcom_7][params[1]-1]) strcat(improve,"\t\t\t[Вихлопна труба]\n");
	if(CarsInfo[playerid][carVehcom_8][params[1]-1]) strcat(improve,"\t\t\t[Диски]\n");
	if(CarsInfo[playerid][carVehcom_9][params[1]-1]) strcat(improve,"\t\t\t[Стерео]\n");
	if(CarsInfo[playerid][carVehcom_10][params[1]-1]) strcat(improve,"\t\t\t[Гідравліка]\n");
	if(CarsInfo[playerid][carVehcom_11][params[1]-1]) strcat(improve,"\t\t\t[Передній бампер]\n");
	if(CarsInfo[playerid][carVehcom_12][params[1]-1]) strcat(improve,"\t\t\t[Задній бампер]\n");
	new model = CarsInfo[playerid][carModel][params[1]-1]-400;
	new classname[12];
	GetCarClassName(gTransport[model][trClass],classname);
	static const f_str[] = ""W"Марка авто: \t\t"P"%s\n\
							"W"Клас: \t\t\t"P"%s\n\
							"W"Пробіг: \t\t"P"%.0fкм\n\
							"W"Бензобак: \t\t"P"%dл\n\
							"W"Тюнінг:\n\
							"GREEN"%s\n\n\
							"W"Ви хочете продати автомобіль гравцю"ORANGE" %s"W" за"ORANGE" $%d?";
	new string[400];
	format(string,sizeof(string),f_str,gTransport[model][trName],classname,CarsInfo[playerid][carDrived][params[1]-1],gTransport[model][trTank],improve, player_name[params[0]], params[2]);
	ShowPlayerDialog(playerid,D_SELL_CAR,DSM, ""P"Продаж автомобіля",string,"Так","Скасувати");
	return 1;
}
CMD:dropgun(playerid, param[]) {
	if(!TI[playerid][tLogin] && AntiCheatIsKickedWithDesync(playerid)) return 1;
	new weaponid = GetPlayerWeapon(playerid);
	if(weaponid != 24 && weaponid != 25 && weaponid != 26 && weaponid != 29 && weaponid != 30 && weaponid != 31 && weaponid != 33) return SendError(playerid, "Неможливо викинути заборонену зброю.");
	if(IsPlayerInAnyVehicle(playerid)) return 0;
	if(TI[playerid][tDuel] != -1) return 0;
	new ammo = GetPlayerAmmo(playerid);
	if(!weaponid) return 0;
	if(!ammo) return 0;
	if(weaponid < 1 || weaponid > 47) return SendError(playerid, "Зброя має знаходитись в руках.");
	DropGun(playerid,weaponid,ammo);
	return 1;
}
CMD:changeskin(playerid,params[]) {
	new mes[400];
	if(!PI[playerid][pMember]) return SendError(playerid, "Ви не перебуваєте в організації.");
	if(!start_work[playerid]) return SendError(playerid, "Необхідно розпочати робочий день.");
	if(PI[playerid][pRank] < FI[PI[playerid][pMember]][fUninviteRang]) {
		format(mes,128,"Ця функція доступна з %i рангу.", FI[PI[playerid][pMember]][fUninviteRang]);
		SendError(playerid,mes);
		return 1;
	}
	if(sscanf(params,"u",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /changeskin [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(PI[params[0]][pMember] != PI[playerid][pMember]) return SendError(playerid, "Гравець не є членом вашої організації.");
	if(PI[params[0]][pRank] >= PI[playerid][pRank] && params[0] != playerid) return SendError(playerid, "Ваш ранг недостатній.");
	SetPVarInt(playerid,"params[0]",params[0]);
	for(new i; i < 14;i++) {
		new skinid = gFractionSkin[PI[playerid][pMember]][i];
		if(!skinid) break;
		if(skinid == PI[params[0]][pFracSkin]) {
			if(!i) format(mes,sizeof(mes),""P"Скін %d [%d]",i+1,skinid);
			else format(mes,sizeof(mes),"%s\n"P"Скін %d [%d]",mes,i+1,skinid);
		}
		else {
			if(!i) format(mes,sizeof(mes),"Скін %d [%d]",i+1,skinid);
			else format(mes,sizeof(mes),"%s\nСкін %d [%d]",mes,i+1,skinid);
		}
	}
	ShowPlayerDialog(playerid,dFractionSkin,2,player_name[params[0]],mes,"Змінити","Скасувати");
	return 1;
}
stock HideMenuSave(playerid)
{
	new query[200];
	mysql_format(connects, query, sizeof(query),"UPDATE `accounts` SET `ahMenu0`= '%d',`ahMenu1`= '%d',`ahMenu2`= '%d',`ahMenu3`= '%d' WHERE `Name` = '%s' LIMIT 1",
		ahMenu[playerid][0],ahMenu[playerid][1],ahMenu[playerid][2],ahMenu[playerid][3],player_name[playerid]);
	mysql_tquery(connects,query);
	return 1;
}
CMD:hidemenu(playerid) return HideMenu(playerid);
stock HideMenu(playerid)
{
    if(!PI[playerid][pAdmin]) return 1;
    //if(!PI[playerid][giveHide]) return 1;
    FSPD(playerid,1285,DST,""cServer"Hide Menu","Обрати","Закрити",""cServer"[1]{FFFFFF} Сховати себе з /admins\t%s\n"cServer"[2]{FFFFFF} Сховати свій рівень з /admins\t%s\n"cServer"[3]{FFFFFF} Показати фейк рівень в /admins\t%s\n"cServer"[4]{FFFFFF} Підмінити свій нік\t%s",(ahMenu[playerid][0] == 0) ? ("{FF0000}| Деактивовано") : ("{00FF00}| Активовано"), (ahMenu[playerid][1] == 0) ? ("{FF0000}| Деактивовано") : ("{00FF00}| Активовано"), (ahMenu[playerid][2] == 0) ? ("{FF0000}| Деактивовано") : ("{00FF00}| Активовано"), (ahMenu[playerid][3] == 0) ? ("{FF0000}| Деактивовано") : ("{00FF00}| Активовано"));
    return 1;
}
alias:rank("giverank");
CMD:rank(playerid, params[]) {
	if(!PI[playerid][pMember]) return SendError(playerid, "Ви не перебуваєте в організації.");
	if(!start_work[playerid]) return SendError(playerid, "Необхідно розпочати робочий день.");
	new string[512];
	if(PI[playerid][pRank] < FI[PI[playerid][pMember]][fGiveRang]) {
		format(string,128,"Доступно з %i рангу.", FI[PI[playerid][pMember]][fGiveRang]);
		SendError(playerid,string);
		return 1;
	}
	if(sscanf(params,"i",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /rank [playerid]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return SendError(playerid,not_id);
	if(PI[params[0]][pLeader] >= 1) return SendError(playerid, not_id);
	if(PI[playerid][pMember] != PI[params[0]][pMember]) return SendError(playerid, "Гравець не знаходиться у вашій організації.");
	if(PI[playerid][pRank] <= PI[params[0]][pRank]) return SendError(playerid, "Ваш ранг недостатній.");
	if(PI[playerid][pRank] == FI[PI[playerid][pMember]][fMaxRang]) {
		for(new i = 1; i <= FI[PI[playerid][pMember]][fMaxRang]; i++) {
			if(i>= PI[playerid][pRank]) break;
			format(string,sizeof(string),"%s%s%s (%i)\n",string,(PI[params[0]][pRank] == i) ? (""P"") : (""),GetRankName(PI[playerid][pMember],i),i);
			ShowPlayerDialog(playerid,dRank,DSL,""P"Оберіть ранг",string,"Обрати","Закрити");
		}
		SetPVarInt(playerid,"id_giverank",params[0]);
	}
	else if(PI[playerid][pRank] == FI[PI[playerid][pMember]][fMaxRang]-(FI[PI[playerid][pMember]][fMaxRang]-PI[playerid][pRank])) {
		for(new i = 1; i <= FI[PI[playerid][pMember]][fMaxRang]; i++) {
			if(i>= PI[playerid][pRank]) break;
			format(string,sizeof(string),"%s%s%s (%i)\n",string,(PI[params[0]][pRank] == i) ? (""P"") : (""),GetRankName(PI[playerid][pMember],i),i);
			ShowPlayerDialog(playerid,dRank,DSL,""P"Оберіть ранг",string,"Обрати","Закрити");
		}
		SetPVarInt(playerid,"id_giverank",params[0]);
	}
	return 1;
}
CMD:f(playerid, params[]) {
	if(!IsAMafia(playerid) && !IsAGang(playerid) && !IsABikers(playerid)) return 1;
	if(!PI[playerid][pSettings][1]) return SendError(playerid, "Для початку ввімкніть чат організації (/mn > Налаштування > Чат організації)");
	if(PI[playerid][pFmute] > 0) return SendError(playerid, "У вас заглушка.");
	new result[128];
	if(sscanf(params, "s[128]",result)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /f [text]");
	if(PI[playerid][pMute] > 0) return SendError(playerid, "У вас бан чату.");
	if(TI[playerid][tGag]) return SendError(playerid, "У вас кляп.");
	static const f_str[] = "[F] %s %s: %s";
	new string[sizeof(f_str) +1 + (-2 + 24) + (-2 + MAX_PLAYER_NAME) + (-2 + 105)];
	format(string, sizeof(string), f_str,GetRankName(PI[playerid][pMember],PI[playerid][pRank]), player_name[playerid], result);
	SendFamilyMessage(PI[playerid][pMember], 0x6699ccFF, string);
	foreach(new i:Player) if(GetPVarInt(i,"admin_tipster") == PI[playerid][pMember]) SendClientMessage(i, COLOR_LIGHTRED, string);
	SendSpyMessage(PI[playerid][pMember], 0xADFFEFFF, string);
	return 1;
}
