					AddItem(playerid, 132, 1);
				}
			case 2: {
					PI[playerid][pAcsJob][2] = 0;
					AddItem(playerid, 133, 1);
				}
			case 3: {
					PI[playerid][pAcsJob][3] = 0;
					AddItem(playerid, 134, 1);
				}
			case 4: {
					PI[playerid][pAcsJob][4] = 0;
					AddItem(playerid, 139, 1);
				}
