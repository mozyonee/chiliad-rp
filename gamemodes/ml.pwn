CMD:r(playerid, params[]) {
	if(!IsACop(playerid) && !IsAMedic(playerid) && !IsAArm(playerid) && !IsANews(playerid) && PI[playerid][pMember] != fINSTRUCTORS && PI[playerid][pMember] != fWHITEHOUSE) return 1;
