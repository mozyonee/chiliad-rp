		if(id == 44 && TI[playerid][tGym]) return SendError(playerid, "Необхідно завершити тренування");
		if(id == 57 && GetPVarInt(playerid,"krup")) return SendError(playerid, "Необхідно завершити роботу круп'є");
		TI[playerid][tTPpick] = true;
