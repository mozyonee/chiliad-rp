				SetPVarInt(playerid,"kanal_skin",1);
			}
			else {
				if(PI[playerid][pMember] > 0) A_SetPlayerSkin(playerid,PI[playerid][pFracSkin]);
				else A_SetPlayerSkin(playerid,PI[playerid][pSkin]);
				DeletePVar(playerid,"kanal_skin");
