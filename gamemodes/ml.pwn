    switch(listitem) {
	case 0: {
			if(PI[playerid][bizz_status] != 3) return SendError(playerid, "Тільки для керівника аукціона гаражів.");
			new bizid = PI[playerid][pBusiness]-1;
			new status[20];
			new atext[24];
			switch(gBusiness[bizid][bizzMafia]){
			case fRM: atext = "Медельїнський картель";
			case fLCN: atext = "Ла Коза Ностра";
			case fYAKUZA: atext = "Якудза";
			default: atext = "---";
			}
			if(gBusiness[bizid][bizzStatus]) strcat(status,""GREEN"Працює");
			else strcat(status,""NO"Не працює");
			new day;
			day = (gBusiness[bizid][bizzDay]-gettime())/86400;
			static const f_str[] = ""W"Назва: "YELLOW"%s\n\n\
								"W"Державна ціна: "ORANGE"$%d\n\
								"W"Каса: "ORANGE"$%d"W"\n\
								"W"Зароблено за добу: "ORANGE"$%d"W"\n\n\
