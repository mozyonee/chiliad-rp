			case 1: ShowPlayerDialog(playerid, D_JAIL_1, DSM, ""P"Як зменшити термін?",""W"Щоб зменшити термін, Вам необхідно:\n\n- Працювати на території в'язниці.\n- Звільнитися достроково за гроші.\n- Спланувати та здійснити втечу.\n", "Назад", "");
			case 2: ShowPlayerDialog(playerid, D_JAIL_2, DSL, ""P"Оберіть метод оплати",""P"1."W" Готівка\n"P"2."W" Банківською картою", "Обрати", "Закрити");
			case 3: ShowPlayerDialog(playerid, D_JAIL_1, DSM, ""P"Втеча з в'язниці",""W"Для організації втечіви повинні мати відмички. (10 штук)\n\n\
		Сплануйте свою втечу правильно, оскільки один неправильний рух означає хрест на майбутньому\n\
		Вас поернуть назад у в'язницю зі збільшеним у два рази терміном.\n\
		Щоб розпочати втечу, підійдіть до воріт і"ORANGE" встаньте на замок.", "Назад", "");
			}
		}
	case D_JAIL_1: {
			if(!response) return 1;
			ShowPlayerDialog(playerid,D_JAIL,DSL, ""P"В'язниця","Що тут робити?\nЯк зменшити термін?\nЗвільнитися достроково з в'язниці"GREEN" (500.000$)"W"\nОрганізувати втечу з в'язниці","Обрати","Закрити");
		}
	case D_JAIL_2: {
			if(!response) return 1;
			if(!PI[playerid][pJailTime]) return SendError(playerid, "Ви не є в'язнем.");
			switch(listitem) {
			case 0: {
					if(PI[playerid][pCash] < 500000) return SendError(playerid, "У вас недостатньо грошей.");
					GiveMoney(playerid, -500000, "Вихід з в'язниці");
				}
			case 1: {
					if(PI[playerid][pBank] < 500000) return SendError(playerid, "У вас недостатньо грошей у банку.");
					PI[playerid][pBank] -= 500000;
					UpdatePlayerData(playerid, "pBank", PI[playerid][pBank]);
				}
			}
			SendClientMessage(playerid, COLOR_WHITE, "Ви були достроково звільнені. За повторного порушення правил, ви будее покарані сильніше.");
			PI[playerid][pJailTime] = 0;
			PI[playerid][pJail] = 0;
			UpdatePlayerData(playerid,"pJailTime",0);
			UpdatePlayerData(playerid,"pJail",0);
			SetCameraBehindPlayer(playerid);
			A_SetPlayerSkin(playerid,PI[playerid][pSkin]);
			GameTextForPlayer(playerid,"~g~Freedom", 5000, 1);
			PlayerSpawn(playerid);
		}
	case D_JAIL_3: {
