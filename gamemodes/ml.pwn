					ShowPlayerDialog(playerid,D_FAMILY_BL,DSL,""P"Чорний список", ""P"1."W" Занести в ЧС\n"P"2."W" Викреслити з ЧС\n"P"3."W" Очистити повний список ЧС\n"P"4."W" Список занесених в ЧС", "Обрати", "Закрити");
				}
			case 8: {
