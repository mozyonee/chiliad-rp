	mysql_format(connects, MYSQL_GLOBAL,sizeof(MYSQL_GLOBAL),"SELECT * FROM `"TABLE_CARS"` WHERE BINARY `owner` = '%s'",player_name[playerid]);
	mysql_tquery(connects, MYSQL_GLOBAL,"load_cars","i",playerid);
