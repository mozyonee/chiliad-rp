	case D_TAKE: {
			if(!response) return DeletePVar(playerid,"takelic");
			new acter = GetPVarInt(playerid,"takelic");
			if(!IsPlayerStream(10.0, playerid, acter)) return SendError(playerid, "Гравець не поруч з вами.");
			if(listitem < 4) {
				if(!lic[acter][listitem]) return SendError(playerid, "У гравця немає цієї лицензії.");
			}
			new string[156];
			if(listitem >= 4) {
				switch(listitem) {
				case 4: {
						if(!GetInvent(acter, 2)) return SendError(playerid, "У гравця немає наркотиків.");
						format(string, sizeof(string), "Ви забрали у "P"%s"W" наркотики.", player_name[acter]);
						SendUse(playerid, string);
						format(string, sizeof(string), "Працівник "P"%s"W" забрав у вас наркотики.", player_name[playerid]);
						SendUse(acter, string);
						DeleteItem(acter, 2, GetInvent(acter, 2));
					}
				case 5: {
						if(!GetInvent(acter, 453)) return SendError(playerid, "У гравця немає матеріалів.");
						format(string, sizeof(string), "Ви забрали у "P"%s"W" матеріали.", player_name[acter]);
						SendUse(playerid, string);
						format(string, sizeof(string), "Працівник "P"%s"W" забрав у вас матеріали.", player_name[playerid]);
						SendUse(acter, string);
						DeleteItem(acter, 453, GetInvent(acter, 453));
					}
				}
				DeletePVar(playerid,"takelic");
				return 1;
			}
			new lics[28];
			switch(listitem) {
			case 0: lics = "на наземний транспорт";
			case 1: lics = "на повітряний транспорт";
			case 2: lics = "на водний транспорт";
			case 3: lics = "на носіння зброї";
			}
			format(string, sizeof(string), "Ви забрали у "P"%s"W" ліцензію %s.", player_name[acter],lics);
			SendUse(playerid, string);
			format(string, sizeof(string), "Працівник "P"%s"W" забрав у вас ліцензію %s.", player_name[playerid],lics);
			SendUse(acter, string);
			lic[acter][listitem]=0;
			UpdateLicenses(acter);
			DeletePVar(playerid,"takelic");
			return 1;
		}
	case D_ATM: {
			if(!response) return 1;
			switch(listitem) {
			case 0: {
					static const f_str[] = ""W"На вашому основному банківському рахунку доступно "P"$%d\n\n"W"Введіть суму, яку хочете зняти з основного банківського рахунку:";
					new string[sizeof(f_str) +1 + (-2 + 11)];
					format(string,sizeof(string),f_str,PI[playerid][pBank]);
					ShowPlayerDialog(playerid,D_ATM_INPUT,DSI, ""P"Зняти гроші",string,"зняти","Скасувати");
				}
			case 1: {
					static const f_str[] = ""W"На вашому рахнку доступно "P"$%d\n\n"W"Введіть суму, яку хочете покласти на основной банківський рахунок:";
					new string[sizeof(f_str) +1 + (-2 + 11)];
					format(string,sizeof(string),f_str,PI[playerid][pCash]);
					ShowPlayerDialog(playerid,D_ATM_PUT,DSI, ""P"Покласти гроші",string,"Покласти","Скасувати");
				}
			case 2: {
					if(!PI[playerid][pPhone]) return SendError(playerid, "У вас немає мобільного телефона.");
					static const f_str[] = ""W"Доступно коштів готівкою: "P"$%d\n\
											"W"На вашому мобільному рахунку доступно: "P"$%d.\n\n\
											"W"Введіть суму, яку хочете покласти на мобільний рахунок:";
					new string[sizeof(f_str) +1 + (-2 + 11)];
					format(string,sizeof(string),f_str,PI[playerid][pCash],PI[playerid][pMobile]);
					ShowPlayerDialog(playerid,D_ATM_PHONE,DSI, ""P"Оплата мобільного",string,"Зняти","Скасувати");
				}
			}
		}
	case D_ATM_INPUT: {
			if(!response) return ShowATMMenu(playerid);
			new amount = strval(inputtext);
			new atmID = GetPVarInt(playerid,"atm_id");
			
			if(ATMData[atmID][atm_cash] < amount) return ShowPlayerDialog(playerid,DIALOG_NONE,DSM, ""P"Видача готівки",""W"В банкоматі недостатньо коштів","Закрити","");
			if(amount < 1 || amount > 50000) return ShowPlayerDialog(playerid,D_ATM_INPUT,DSI, ""P"Видача готівки","\n\n"W"Введіть суму, яку хочете зняти з основного банківськго рахунку:\n\n"NO"*"G" Від $1 до $50.000\n\n","Зняти","Назад");
			if(ATMData[atmID][atm_cash] < amount) return ShowPlayerDialog(playerid,D_ATM_INPUT,DSI, ""P"Видача готівки",""W"Введіть суму, яку хочете зняти з основного банківськго рахунку:\n\n"NO"*"G" Недостатньо коштів","Зняти","Назад");
			if(PI[playerid][pBank] < amount) return ShowPlayerDialog(playerid,D_ATM_INPUT,DSI, ""P"Видача готівки",""W"Введіть суму, яку хочете зняти з основного банківськго рахунку:\n\n"NO"*"G" Недостатньо коштів","Зняти","Назад");
			PI[playerid][pBank] -= amount;
			UpdatePlayerData(playerid,"pBank",PI[playerid][pBank]);
			GiveMoney(playerid, amount,"зняття з банк счета");
			
			ATMData[atmID][atm_cash] -= amount;
			UpdateATMLabel(atmID);
			
			new query[128];
			mysql_format(connects, query, sizeof(query),"UPDATE `atms` SET `cash` = '%d' WHERE `ID` = '%d'", ATMData[atmID][atm_cash], atmID);
			mysql_tquery(connects, query);
			static const f_str[] = ""W"Знято средств:\t\t"ORANGE"$%d"W"\n\
								"W"Баланс:\t\t\t"ORANGE"$%d\n";
			new string[sizeof(f_str) +1 + (-2 + 11) + (-2 + 11)];
			format(string,sizeof(string),f_str,amount,PI[playerid][pBank]);
			ShowPlayerDialog(playerid,DIALOG_NONE,DSM, ""P"Видача наличных",string,"Закрити","");
		}
	case D_ATM_PUT: {
			if(!response) return ShowATMMenu(playerid);
			new amount = strval(inputtext);
			new atmID = GetPVarInt(playerid,"atm_id");
			if(amount < 1 || amount > 50000) return ShowPlayerDialog(playerid,D_ATM_PUT,DSI, ""P"Поповнення рахунку","\n\n"W"Введіть суму яку хочете покласти на основний банківський рахунок:\n\n"NO"*"G" Від $1 до $50.000\n\n","Покласти","Назад");
			if(PI[playerid][pCash] < amount) return ShowPlayerDialog(playerid,D_ATM_PUT,DSI, ""P"Поповнення рахунку",""W"Введіть суму яку хочете покласти на основний банківський рахунок:\n\n"NO"*"G" Недостатньо коштів","Покласти","Назад");
			PI[playerid][pBank] += amount;
			UpdatePlayerData(playerid,"pBank",PI[playerid][pBank]);
			GiveMoney(playerid, -amount,"Поповнення банк счета");
			
			ATMData[atmID][atm_cash] += amount;
			UpdateATMLabel(atmID);
			
			new query[128];
			mysql_format(connects, query, sizeof(query),"UPDATE `atms` SET `cash` = '%d' WHERE `ID` = '%d'", ATMData[atmID][atm_cash], atmID);
			mysql_tquery(connects, query);
			static const f_str[] = ""W"Внесено средств:\t\t"ORANGE"$%d\n\
								"W"Баланс:\t\t\t"ORANGE"$%d\n";
			new string[sizeof(f_str) +1 + (-2 + 11) + (-2 + 11)];
			format(string,sizeof(string),f_str,amount,amount,PI[playerid][pBank]);
			ShowPlayerDialog(playerid,DIALOG_NONE,DSM, ""P"ПоПолнение счёта",string,"Закрити","");
		}
	case D_ATM_PHONE: {
			if(!response) return ShowATMMenu(playerid);
			new amount = strval(inputtext);
			if(amount < 1 || amount > 10000) return ShowPlayerDialog(playerid,D_ATM_PHONE,DSI, ""P"Оплата мобільного рахунку",""W"Введіть суму яку хочете покласти:\n\n"NO"*"G" Від $1 до $10.000","Покласти","Назад");
			if(GetPlayerMoneyEx(playerid) < amount) return ShowPlayerDialog(playerid,D_ATM_PHONE,DSI, ""P"Оплата мобільного рахунку",""W"Введіть суму яку хочете покласти:\n\n"NO"*"G" Недостатньо коштів","Покласти","Назад");
			GiveMoney(playerid,-amount,"поповнення моб.телефона");
			PI[playerid][pMobile] += amount; 
			UpdatePlayerData(playerid,"pMobile",PI[playerid][pMobile]);
			static const f_str[] = ""W"Внесено коштів:\t\t"ORANGE"$%d"W"\n\
								"W"На мобильном счёте:\t\t"ORANGE"$%d\n";
			new string[sizeof(f_str) +1 + (-2 + 11) + (-2 + 11)];
			format(string,sizeof(string),f_str,amount,PI[playerid][pMobile]);
			ShowPlayerDialog(playerid,DIALOG_NONE,DSM, ""P"Оплата мобільного рахунку",string,"Закрити","");
		}
	case D_TICKET: {
			if(!response) return 1;
			switch(listitem) {
			case 0: {
					new price;
					for(new i = 0; i < TOTALTICKETS[playerid]; i++) price += TL[playerid][i][tPrice];
					static const f_str[] = ""W"Ви собираетесь Оплатити "YELLOW"%i"W" штрафов на суму: "GREEN"$%i\n"W"Ви дійсно хочете прозвести оплату?";
					new string[sizeof(f_str) +1 + (-2 + 5)];
					format(string,sizeof(string),f_str,TOTALTICKETS[playerid],price);
					ShowPlayerDialog(playerid,D_TICKET_1,DSM, ""P"Оплата штрафа",string,"Оплатити","Назад");
				}
			default: SetPVarInt(playerid,"ticket",listitem), ShowPlayerDialog(playerid,D_TICKET_2,DSL,""P"штрафи",""GREEN"1."W" Оплатити штраф\n"GREEN"2."W" інформація о штрафе","Далі","Назад");
			}
		}
	case D_TICKET_1: {
			if(!response) return GetTickets(playerid);
			new price;
			for(new i = 0; i < TOTALTICKETS[playerid]; i++) price += TL[playerid][i][tPrice];
			if(PI[playerid][pBank] < price) return SendError(playerid, "На основном банковском счету Недостатньо коштів"), GetTickets(playerid);
			PI[playerid][pBank] -= price;
			UpdatePlayerData(playerid,"pBank",PI[playerid][pBank]);
			new query[128];
			for(new i = 0; i < TOTALTICKETS[playerid]; i++) {
				mysql_format(connects, query, sizeof(query),"DELETE FROM `"TABLE_TICKETS"` WHERE `id` = '%i'",TL[playerid][i][tID]);
				mysql_tquery(connects,query,"","");
			}
			static const f_str[] = "Ви оплатили "P"%i"W" штрафов на суму "ORANGE"$%i";
			new string[sizeof(f_str) +1 + (-2 + 4) + (-2 + 8)];
			format(string,sizeof(string),f_str, TOTALTICKETS[playerid],price);
			SendUse(playerid,string);
			return 1;
		}
	case D_TICKET_2: {
			if(!response) return GetTickets(playerid);
			new i = GetPVarInt(playerid,"ticket")-1;
			switch(listitem) {
			case 0: {
					if(PI[playerid][pBank] < TL[playerid][i][tPrice]) return SendError(playerid, "На основном банковском счету Недостатньо коштів"), GetTickets(playerid);
					PI[playerid][pBank] -= TL[playerid][i][tPrice];
					UpdatePlayerData(playerid,"pBank",PI[playerid][pBank]);
					new query[128];
					mysql_format(connects, query, sizeof(query),"DELETE FROM `"TABLE_TICKETS"` WHERE `id` = '%i'",TL[playerid][i][tID]);
					mysql_tquery(connects,query,"","");
					static const f_str[] = "Ви оплатили штраф: #%i";
					new string[sizeof(f_str) +1 + (-2 + 7)];
					format(string,sizeof(string),f_str, i+1);
					SendOK(playerid,string);
					return GetTickets(playerid);
				}
			case 1: {
					static const f_str[] = ""W"Штраф #%i\n\n\
										Причина: "NO"%s\n\
										"W"Сума штрафа: {FACC2E}%i вирт\n\
										"W"Кем был Видан: {1DADF0}%s\n\
										"W"Дата Видачи: {04B404}%s";
					new string[sizeof(f_str) +1 + (-2 + 64) + (-2 + 7) + (-2 + MAX_PLAYER_NAME) + (-2 + 32)];
					format(string,sizeof(string),f_str,i+1,TL[playerid][i][tReason],TL[playerid][i][tPrice],
					TL[playerid][i][tName],TL[playerid][i][tDate]);
					return ShowPlayerDialog(playerid,D_TICKET_3,DSM, ""P"Інформація",string,"Назад","");
				}
			}
			return 1;
		}
	case D_TICKET_3: return GetTickets(playerid);
	case D_TIPSTER: {
			new veh = GetPVarInt(playerid,"veh");
			if(!response) {
				GetVehicleParamsEx(veh,engine,lights,alarm,doors,bonnet,boot,objective);
				SetVehicleParamsEx(veh,engine,lights,alarm,doors,bonnet,false,objective);
				DeletePVar(playerid,"veh");
				return 1;
			}
			switch(listitem) {
			case 0: {
					if(GetPVarInt(playerid,"tipster")) {
						SendError(playerid, "У вас вже є жучок.");
						GetVehicleParamsEx(veh,engine,lights,alarm,doors,bonnet,boot,objective);
						SetVehicleParamsEx(veh,engine,lights,alarm,doors,bonnet,false,objective);
						return 1;
					}
					SendUse(playerid, "Ви взяли "P"1"W" жучок. Для використання, введіть "P"/tipster"W".");
					SetPVarInt(playerid,"tipster", true);
				}
			}
			GetVehicleParamsEx(veh,engine,lights,alarm,doors,bonnet,boot,objective);
			SetVehicleParamsEx(veh,engine,lights,alarm,doors,bonnet,false,objective);
			DeletePVar(playerid,"veh");
			return 1;
		}
	case D_FUEL: {
			if(!response) return 1;
			new fuel = GetPVarInt(playerid,"azs_id");
			new vehicleid = GetPlayerVehicleID(playerid);
			new modelid = GetVehicleModel(vehicleid) - 400;
			new tank = strval(inputtext);
			if(tank < 1 || tank > 100 || VehicleInfo[vehicleid][vFuel]+tank > gTransport[modelid][trTank]) {
				static const f_str[] = "\n"W"Укажіть на скільки літрів заправити ваше т/з:\n\nДоступно літрів в баку: {FF9968}%.0f"W"\nМісткість баку: {FF9968}%d"W"\nМожна заправити на: {FF9968}%.0fл"W"\nВартість 1л: "GREEN"$%d\n";
				new string[sizeof(f_str) +1 + 30];
				format(string, sizeof(string), f_str, VehicleInfo[vehicleid][vFuel],gTransport[modelid][trTank],gTransport[modelid][trTank]-VehicleInfo[vehicleid][vFuel],gBusiness[fuel][bizzPrice]);
				ShowPlayerDialog(playerid,D_FUEL,DSI, ""P"Заправка",string,"Заправить", "Скасувати");
				return 1;
			}
			SetPVarInt(playerid,"tank_fill",tank);
			new string[128];
			format(string, sizeof(string), " \n  \n"W"Ви дійсно хочете заправиться на "CA"%d"W" літрів?\nВартість: "GREEN"$%d\n\n",
			tank,tank*gBusiness[fuel][bizzPrice]);
			ShowPlayerDialog(playerid,D_FUEL_2,DSM, ""P"Заправка",string,"Так", "Ні");
			return 1;
		}
	case D_FUEL_2: {
			if(!response) return DeletePVar(playerid,"tank_fill");
			new fuel = GetPVarInt(playerid,"azs_id");
			new price = GetPVarInt(playerid,"tank_fill")*gBusiness[fuel][bizzPrice];
			if(PI[playerid][pCash] < price) return SendError(playerid, "У вас недостатньо грошей.");
			GiveMoney(playerid,-price,"заправка авто АЗС");
			if(gBusiness[fuel][bizzProduct] - GetPVarInt(playerid,"tank_fill") > 0) {
				gBusiness[fuel][bizzProduct] -= GetPVarInt(playerid,"tank_fill");
				bizz_pay(fuel,price);
			}
			if(QuestProgress[playerid][44] == 0 && AcceptQuest[playerid][44] != 0)
			{
				QuestProgress[playerid][44] ++;
				save_quest(playerid,44);
				ShowPlayerDialog(playerid,DIALOG_NONE,DSM, "Виконання квесту",""W"Ви завершили виконання щоденного квесту\n\t"NO"Квест можна завершити в /quest","Закрити","");
			}
			SetVehicleParamsEx(GetPlayerVehicleID(playerid), 0, lights, alarm, doors, bonnet, boot, objective);
			
			SetPVarInt(playerid,"tank_vfuel", floatround(VehicleInfo[GetPlayerVehicleID(playerid)][vFuel])); 
			SetTimerEx("FuelCar",500,0,"i",playerid);
			TogglePlayerControllable(playerid,false);
		}
	case D_BUY_FUEL: {
			if(!response) return 1;
			new fuel = GetNearestTrunckFuel(playerid);
			if(fuel==-1) return 1;
			new price = 10*gBusiness[fuel][bizzPrice];
			if(PI[playerid][pCash] < price) return SendError(playerid, "У вас недостатньо грошей.");
			if(gBusiness[fuel][bizzProduct] - 10 > 0) {
				gBusiness[fuel][bizzProduct] -= 10;
				bizz_pay(fuel,price);
			}
			if(GetInvSet(playerid) >= 40) return SendError(playerid, "Ваш інвентар повний, звільніть місце.");
			GiveMoney(playerid,-price,"купівля каністри");
			UpdateBusinessText(fuel);
			AddItem(playerid, 454, 1);
			SendOK(playerid,"Ви придбали канистру з бензином. Для заправки т/з, введіть "P"/fillcar"W".");
		}
	case D_SELL_CAR: {
			new id_pokupaet = GetPVarInt(playerid,"car_pokupaet")-1;
			if(!response) {
				DeletePVar(id_pokupaet,"car_prodaet");
				DeletePVar(id_pokupaet,"carCena");
				
				DeletePVar(id_pokupaet,"car_pokupaet");
				DeletePVar(id_pokupaet,"car_number");
				return 1;
			}
			new string[350];
			format(string, sizeof(string), ""P"%s"W" запропонував купити свій автомобіль"P" %s."W" Вартість: "GREEN"%i$",player_name[playerid],gTransport[CarsInfo[playerid][carModel][GetPVarInt(playerid,"carnumber")]-400][trName], GetPVarInt(id_pokupaet,"carCena"));
			SendUse(id_pokupaet, string);
			SendClientMessage(id_pokupaet,COLOR_BLUE,"Натисніть "YES"Y "BLUE"щоб погодитися, або "NO"N "BLUE"для відмови.");
			format(string, sizeof(string), "Ви запропонували "P"%s "W"купити автомобіль "W"%s"W". Вартість: "GREEN"%i$",player_name[id_pokupaet],gTransport[CarsInfo[playerid][carModel][GetPVarInt(playerid,"carnumber")]-400][trName], GetPVarInt(id_pokupaet,"carCena"));
			SendUse(playerid, string);
			DeletePVar(playerid,"sellcar");
			SetPVarInt(id_pokupaet,"sellcar",1);
		}
