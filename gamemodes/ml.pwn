						new query[128];
						mysql_format(connects, query, sizeof(query),"UPDATE `"TABLE_DNK"` SET `medkit` = '%d' WHERE id = '%d'",PlayerTrailer[c][carHealth],PlayerTrailer[c][carID]);
						mysql_tquery(connects, query);
					}
