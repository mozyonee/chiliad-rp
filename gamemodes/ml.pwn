					if(DonateX == 3) DonateX = 1;
					else DonateX = 3;
					FSAM(-1, "[A] : {FF0000}(A-System) {FFFFFF}%s[%d] %s x3 Donate.",player_name[playerid],playerid, DonateX == 3 ? "увімкнув" : "вимкнув");
