		}
	case D_UNBAN: {
			if(!response) return 1;
			if(!IsBannedName(UnbanName[playerid])) return SendError(playerid, "Цей гравець не заблокований.");
			new string[144];
			format(string,sizeof(string),"[A] Адміністратор %s розблокував гравця %s.",player_name[playerid],UnbanName[playerid]);
			AdmMSG(0xAFAFAFAA, string);
			WriteLog(LOG_UNBAN,player_name[playerid],UnbanName[playerid],"разблокування");
			UnBanName(UnbanName[playerid]);
		}
	case D_MAYOR: {
			if(!response) return 1;
			switch(listitem) {
			case 0: ShowPlayerDialog(playerid,D_MAYOR_BLAGO,DSI, ""P"Благодійність","\n\n"W"Введіть суму, яку хочете пожертвувати в казну штата:\n\n","Перевести", "Скасувати");
			case 1: {
					new name[24],rows, string[300];
					new blago, colvo = 0;
					new Cache:result = mysql_query(connects, "SELECT * FROM `accounts` WHERE `pBlago` > 0 ORDER BY `pBlago` DESC LIMIT 5");
					cache_get_row_count(rows);
					if(rows)
					{
						string = ""W"# Им'я\t"W"Пожертвував\n\n";
						static const f_str[] = ""YELLOW"%i. "W"%s\t"GREEN"%d$\n";
						new str[sizeof(f_str) +1 + (-2 + MAX_PLAYER_NAME) + (-2 + 7)];
						for(new i; i < rows; i ++) {
							cache_get_value_name(i, "Name", name, MAX_PLAYER_NAME);
							cache_get_value_name_int(i, "pBlago",blago);
							format(str, sizeof(str), f_str, i+1, name,blago);
							strcat(string, str);
							colvo++;
						}
						ShowPlayerDialog(playerid, DIALOG_NONE, DSTH, ""P"Найщедріші пожертви", string, "Закрити", "");
					}
					if(colvo == 0) return ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Найщедріші пожертви", ""W"Пожертвований не знайдено", "Закрити", "");
					cache_delete(result);
				}
			case 2: {
					static const f_str[] = ""W"Процент при продажу бізнесу в державу: "GREEN"%d%%\n\
											"W"Процент при продажу будинку в державу: "GREEN"%d%%\n\
											"W"Процент при продажу автомобиля в державу: "GREEN"%d%%\n\
											"W"Процент адвокатських послуг: "GREEN"15%%";
					new string[sizeof(f_str) +1 + (-2 + 13) + (-2 + 3) + (-2 + 3) + (-2 + 3) + (-2 + 3) + (-2 + 3) + (-2 + 3) + (-2 + 3)];
					format(string,sizeof(string),f_str,Nalog[3],Nalog[0], Nalog[4]);
					ShowPlayerDialog(playerid,D_ECONOMY_MENU_1,DSM, ""P"Інформація",string,"Назад","");
				}
			}
		}
	case D_MAYOR_BLAGO: {
			if(!response) return 1;
			new salary = strval(inputtext);
			if(salary < 1000 || salary > 1000000) {
				ShowPlayerDialog(playerid,D_MAYOR_BLAGO,DSI, ""P"Благотворительность","\n\n"W"Введіть суму, яку хочете пожертвовать в казну штата:\n\n"NO"*"G" Від $1.000 до $1.000.000\n\n","Перевести", "Скасувати");
				return 1;
			}
			if(GetPlayerMoneyEx(playerid) < salary) return SendError(playerid, "У вас недостатньо коштів.");
			GiveMoney(playerid,-salary,"пожертвование");
			PI[playerid][pBlago] += salary;
			UpdatePlayerData(playerid,"pBlago",PI[playerid][pBlago]);
			FI[fWHITEHOUSE][fBank] += salary;
			UpdateFraction(fWHITEHOUSE,"Bank",FI[fWHITEHOUSE][fBank]);
			static const f_string[] = "Ви успішно пожертвували "ORANGE"$%d"W" в казну штата.";
			new str[sizeof(f_string) +1 + (-2 + 9)];
			format(str,sizeof(str),f_string,salary);
			SendUse(playerid,str);
		}
	case dRentCar: {
			if(!response) return DeletePVar(playerid,"rent_carid");
			new arid = GetArendCarID(GetPVarInt(playerid, "rent_carid"));
			DeletePVar(playerid,"rent_carid");
			if(!lic[playerid][0]) return SendError(playerid, "У вас немає водійських прав.");
			if(arid != -1) {
				if(TI[playerid][tArendKey] == -1) {
					if(ArendInfo[arid][aPlayerID] == INVALID_PLAYER_ID || !IsPlayerConnected(ArendInfo[arid][aPlayerID])) {
						if(PI[playerid][pCash] < ArendInfo[arid][aCost]) return SendError(playerid, "У вас недостатньо коштів.");
						GiveMoney(playerid,-ArendInfo[arid][aCost],"оренда т/з");
						//bizz_pay(ArendInfo[arid][aBizz],floatround(ArendInfo[arid][aCost]));
						TI[playerid][tArendKey] = arid;
						ArendInfo[arid][aPlayerID] = playerid;
						ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Транспортний засіб орендовано", ""W"Список доступних команд:\n\n"YELLOW"/lock 3"W" - закрити чи відкрити орендований транспорт\n"YELLOW"/unrent"W" - відмовитися від оренди\n\n"NO"При віддаленні від т/з на 2км контракт автоматично розривається", "Закрити", "");
					}
					else SendError(playerid, "Цей транспорт вже орендують.");
				}
				else SendError(playerid, "Ви вже орендуєте транспорт.");
			}
		}
	case D_COP_GUN: {
			if(!response) return 1;
			switch(listitem) {
			case 0: GivePlayerWeapon(playerid,24,21);
			case 1: GivePlayerWeapon(playerid,25,30);
			case 2: GivePlayerWeapon(playerid,29,90);
			case 3: GivePlayerWeapon(playerid,31,150);
			case 4: GivePlayerWeapon(playerid,3,1);
			case 5: SetArmour(playerid,100);
			}
		}
	case dGiveGunTD: {
			if(!response) return 1;
			if(!PI[playerid][pMember]) return 1;
			if(strfind(inputtext, "Бронежилет") != -1) {
				SetArmour(playerid, 100.0);
				return 1;
			}
			if(listitem >= 13) return 1;
			if(GunTickGet[playerid][listitem] > unix) return SendError(playerid, "Не можна брати зброю занадто часто.");
			GunTickGet[playerid][listitem] = unix+20;
			new team;
			switch(GetPlayerVirtualWorld(playerid)) {
			case 31: team = fARMYLS;
			case 1: team = fLSPD;
			case 6: team = fRCSO;
			case 43: team = fFBI;
			}
			for(new i = 0 ; i < 12 ; i++) {
				if(strfind(inputtext, FW[i][team][fwName]) != -1) {
					new count_minus = 100;
					switch(FW[i][team][fwGunID]) {
					case 24: count_minus = 60;
					case 25: count_minus = 60;
					case 29: count_minus = 80;
					case 31: count_minus = 100;
					case 30: count_minus = 100;
					case 34: count_minus = 250;
					case 99: count_minus = 30;
					default: count_minus = 90;
					}
					if(FI[team][fMats] < count_minus) return SendError(playerid, "Недостатньо боєприпасів.");
					if(IsACop(playerid) && PI[playerid][pRank] == 1 && FW[i][team][fwGunID] != 3) {
						SendError(playerid, "Для вашого рангу доступний лише кийок.");
						return 1;
					}
					FI[team][fMats] -= count_minus;
					UpdateFraction(team,"Mats",FI[team][fMats]);
					if(FW[i][team][fwGunID] == 99) {
						if(GetInvSet(playerid) >= 40) return SendError(playerid, "Ваш інвентар повний, звільніть місце.");
						AddItem(playerid, 120, 1);
						return 1;
					}
					GivePlayerWeapon(playerid,FW[i][team][fwGunID],FW[i][team][fwGunAmmo]);
					break;
				}
			}
			ShowGetGun(playerid);
			return 1;
		}
