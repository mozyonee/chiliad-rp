			При досягненні навички "ORANGE"'Шофер'"W" - ви отримаєте аксесуар "P"'Фуражка водія'"W"\n\n",PI[playerid][pExpJob][5]);
				}
			case 6: {
					format(string,sizeof(string),""W"Навичка роботи розвізника їжі:"ORANGE" %d"W"\n\nНавичка роботи\t\tПотрібний досвід\n"P"1."W" Стажер\t\t"ORANGE"0"W"\n" P"2."W" Кур'єр\t\t\t"ORANGE"100"W"\n\
			"P"3."W" Фахівець\t\t\t"ORANGE"200"W"\n"P"4."W" Професіонал\t\t"ORANGE"300\n\n\
			"W"Досягши навички "ORANGE"'Професіонал'"W" - ви отримаєте аксесуар "P"'Бургер'"W"\n\n",PI[playerid][pExpJob][6]);
				}
			case 7: {
					format(string,sizeof(string),""W"Навичка роботи механіка: "ORANGE" %d"W"\n\nНавичка роботи\t\tПотрібний досвід\n"P"1."W" Аматор\t\t\t"ORANGE"0"W"\n"P "2."W" Слюсар\t\t\t"ORANGE"100"W"\n\
			"P"3."W" Фахівець\t\t\t"ORANGE"200"W"\n"P"4."W" Професіонал\t\t"ORANGE"300\n"P"5."W" Майстер\t\t\t"ORANGE"400"W"\n\n\
			При досягненні навички "P"'Майстер'"W" - ви отримаєте аксесуар "P"'Літак'"W"\n\n",PI[playerid][pExpJob][7]);
				}
			case 8: {
					format(string,sizeof(string),""W"Навичка роботи розвізника піци:"ORANGE" %d"W"\n\nНавичка роботи\t\tНеобхідний досвід\n"P"1."W" Стажер\t\t\t"ORANGE"0"W"\n"P"2."W" Співробітнік\t\t\t"ORANGE"15"W"\n\
					"P"3."W" Досвідчений\t\t\t"ORANGE"50"W"\n"P"4."W" Профі\t\t\t"ORANGE"100"W"\n\n\
					При досягненні навички "P"'Профі'"W" - ви отримаєте аксесуар "P"'Маска півня'"W"\n\n",PI[playerid][pExpJob][8]);
				}
			case 9: {
					new null = 0;
					
					if(PI[playerid][pAcsJob][0]) strcat(string,"Аксесуар 'Жилет'\n"), take_items[playerid][null] = 0, null++;
					if(PI[playerid][pAcsJob][1]) strcat(string,"Аксесуар 'Ковпак'\n"), take_items[playerid][null] = 1, null++;
					if(PI[playerid][pAcsJob][2]) strcat(string,"Аксесуар 'Магніт'\n"), take_items[playerid][null] = 2, null++;
					if(PI[playerid][pAcsJob][3]) strcat(string,"Аксесуар 'Долар'\n"), take_items[playerid][null] = 3, null++;
					if(PI[playerid][pAcsJob][4]) strcat(string,"Аксесуар 'Череп'\n"), take_items[playerid][null] = 4, null++;
					if(PI[playerid][pAcsJob][5]) strcat(string,"Аксесуар 'Фуражка водія'\n"), take_items[playerid][null] = 5, null++;
					if(PI[playerid][pAcsJob][6]) strcat(string,"Аксесуар 'Бургер'\n"), take_items[playerid][null] = 6, null++;
					if(PI[playerid][pAcsJob][7]) strcat(string,"Аксесуар 'Літак'\n"), take_items[playerid][null] = 7, null++;
					if(PI[playerid][pAcsJob][8]) strcat(string,"Аксесуар 'Маска півня'\n"), take_items[playerid][null] = 8, null++;
					if(null == 0) return SendError(playerid, "Ви не заробили ніяких аксесуарів.");
					ShowPlayerDialog(playerid,DIALOG_JOB_PROGRESS_2,DSL, ""P"Аксесуари з робіт",string, "Забрати", "Назад");
					return 1;
				}
			}
			ShowPlayerDialog(playerid,DIALOG_JOB_PROGRESS_1,DSM, ""P"Прогрес",string, "Назад", "");
		}
	case DIALOG_JOB_PROGRESS_1: {
			if(!response) return 1;
