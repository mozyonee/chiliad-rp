	"P"3."W" Внутрішньоігрова валюта ($150.000)\n\
	"P"4."W" Внутрішньоігрова валюта ($400.000)\n\
	"P"5."W" Внутрішньоігрова валюта ($700.000)\n\
	"P"6."W" Преміум-акаунт на 48 годин\n\
	"P"7."W" Одяг (294, 189)\n\
	"P"8."W" UAH (50, 150)\n\
	"P"9."W" Аксесуар 'Дреди'\n\
	"P"10."W" Аксесуар 'Ангельське кільце'", "Закрити", "");
		}
	}
	return 1;
}
CMD:contstart(playerid) {
	if(PI[playerid][pAdmin] < 7 || dostup[playerid] == 0) return 1;
	SendClientMessageToAll(-1, ""P"[Контейнери]"W" Через 10 хвилин в порту ЛС пройде аукціон контейнерів. (/gps > Розваги > Контейнери)");
	open_cont_time = 600;
	open_cont = 1;
	return 1;
}
CMD:garagestart(playerid){
	if(PI[playerid][pAdmin] < 7 || dostup[playerid] == 0) return 1;
	SendClientMessageToAll(-1, ""P"[Аукціон гаражів]"W" Через 10 хвилин можна буде придбати закинуті гаражі. (/gps > Розваги > Аукціон гаражів)");
	open_zg_time = 600;
	open_zg = 1;
	return 1;
}
CMD:priz(playerid) { // список прзів MySQL
	MYSQL_GLOBAL[0] = EOS;
	mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL),"SELECT * FROM `priz` WHERE `accid` = '%d' LIMIT 30",PI[playerid][pID]);
	mysql_tquery(connects, MYSQL_GLOBAL, "GetPrizes", "d", playerid);
	return 1;
}
CB: GetMarket(playerid) {
	new rows;
	cache_get_row_count(rows);
	STRING_GLOBAL[0] = EOS;
	if(!rows) return SendError(playerid, "У продажу немає доступних товарів.");
	format(STRING_GLOBAL,sizeof(STRING_GLOBAL),""W"Назва товару\t"W"Кількість\t"W"Вартість\n");
	if(rows) {
		for(new i; i < rows; i ++)
		{
			cache_get_value_name_int(i,"id", market_id[playerid][i]);
			cache_get_value_name_int(i,"item", market_item[playerid][i]);
			cache_get_value_name_int(i,"ammout", market_ammout[playerid][i]);
			cache_get_value_name_int(i,"cash", market_cash[playerid][i]);
			format(STRING_GLOBAL,sizeof(STRING_GLOBAL),"%s%s\t%d\t"GREEN"%d$"W"\n",STRING_GLOBAL,ItemsInfo[market_item[playerid][i]][ItemName], market_ammout[playerid][i],market_cash[playerid][i]);
		}
	}
	if(PI[playerid][pPalatka] == Market[GetPVarInt(playerid,"p_id")][m_id]) ShowPlayerDialog(playerid, D_MARKET_PLAYER_3, DSTH, ""P"Мої товари", STRING_GLOBAL, "Забрати","Скасувати");
	else ShowPlayerDialog(playerid, D_MARKET_PLAYER_3, DSTH, ""P"Товари у продажу", STRING_GLOBAL, "Купити","Скасувати");
	return 1;
}
CB: GetPrizes(playerid) {
	new rows, type, prize,cash;
	cache_get_row_count(rows);
	STRING_GLOBAL[0] = EOS;
	if(!rows) return SendError(playerid, "У вас немає призів.");
	format(STRING_GLOBAL,sizeof(STRING_GLOBAL),"Назва\tПродаж на ринку\n");
	if(rows)
	{
		for(new i; i < rows; i ++) {
			cache_get_value_name_int(i,"id", CountInfo[playerid][cont_id][i]);
			cache_get_value_name_int(i,"type", type);
			cache_get_value_name_int(i,"prize", prize);
			cache_get_value_name_int(i,"cash", cash);
			
			CountInfo[playerid][cont_model][i] = prize;
			CountInfo[playerid][cont_cash][i] = cash;
			CountInfo[playerid][cont_type][i] = type;
			
			switch(type) {
			case 1: format(STRING_GLOBAL,sizeof(STRING_GLOBAL),"%sАксесуар '%s'\t%d$\n",STRING_GLOBAL,ItemsInfo[prize][ItemName],cash);
			case 2: format(STRING_GLOBAL,sizeof(STRING_GLOBAL),"%sПреміум-акаунт на %d годин\t%d$\n",STRING_GLOBAL,prize,cash);
			case 3: format(STRING_GLOBAL,sizeof(STRING_GLOBAL),"%sОдяг # %d\t%d$\n",STRING_GLOBAL,prize,cash);
			case 4: format(STRING_GLOBAL,sizeof(STRING_GLOBAL),"%sГроші ($100.000)\t%d$\n",STRING_GLOBAL,cash);
			case 5: format(STRING_GLOBAL,sizeof(STRING_GLOBAL),"%sGOLD кейс\t%d$\n",STRING_GLOBAL,cash);
			case 6: format(STRING_GLOBAL,sizeof(STRING_GLOBAL),"%sEXP (3 шт.)\t%d$\n",STRING_GLOBAL,cash);
			case 7: format(STRING_GLOBAL,sizeof(STRING_GLOBAL),"%sUAH (2 шт.)\t%d$\n",STRING_GLOBAL,cash);
			case 8: format(STRING_GLOBAL,sizeof(STRING_GLOBAL),"%sГроші ($200.000)\t%d$\n",STRING_GLOBAL,cash);
			}
		}
	}
	ShowPlayerDialog(playerid, D_CONTAINER_2, DSTH, ""P"Призи з контейнера", STRING_GLOBAL, "Обрати","Скасувати");
	return 1;
}
stock container_win(playerid, id) {
	new query[150];
	if(gContainer[id][cClass] == 1) {
		new rand = Random(0, 8);
		STRING_GLOBAL[0] = EOS;
		format(STRING_GLOBAL,sizeof(STRING_GLOBAL),""W"Вітаємо, ви виграли — {F9C7A1} %s"W"\n\nПредмет додано до списку всіх призів "G"/priz", PrizeInfo[rand][cont_name]);
		ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Список призів",STRING_GLOBAL, "Закрити", "");
		mysql_format(connects, query, sizeof(query),"INSERT INTO `priz`(`accid`, `prize`, `type`, `cash`) VALUES ('%i','%i','%i','%i')",PI[playerid][pID],PrizeInfo[rand][cont_model],PrizeInfo[rand][cont_type],PrizeInfo[rand][cont_price]);
