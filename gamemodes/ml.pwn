			case 2:
				{
					if(PI[playerid][pRouble] < 350) return ShowPlayerDialog(playerid, DIALOG_NONE, DSM, " ", ""W"Недостатньо грошей на акаунті\n\nПоповнити свій рахунок можна на сайті{F2BB68} chiliad-rp.com/donate", "Закрити", "");
					GiveDonate(playerid, -350, "купівля преміум-акаунта на 4 тижня");
					PI[playerid][pPremium] = gettime()+(21*24*60*60);
				}
			case 3:
				{
					if(PI[playerid][pRouble] < 700) return ShowPlayerDialog(playerid, DIALOG_NONE, DSM, " ", ""W"Недостатньо грошей на акаунті\n\nПоповнити свій рахунок можна на сайті{F2BB68} chiliad-rp.com/donate", "Закрити", "");
					PI[playerid][pPremium] = gettime()+(90*24*60*60);
					GiveDonate(playerid, -700, "купівля преміум-акаунта на 3 місяці");
					UpdatePlayerData(playerid,"premium",PI[playerid][pPremium]);
				}
			}
			new string[200];
			new esc = floatround((PI[playerid][pPremium]-gettime())/3600/24, floatround_ceil);
			format(string,sizeof(string),"\n\n"W"Вітаємо з купівлею"ORANGE" преміум-акаунта!"W"\n\nТермін дії преміум-акаунта -"P" %i днів\n\n",esc);
			ShowPlayerDialog(playerid, DIALOG_NONE, DSM, " ", string, "Закрити", "");
			UpdatePlayerData(playerid,"premium",PI[playerid][pPremium]);
			DeletePVar(playerid,"premium_");
		}
	case D_DONATE_CONVERT: {
			if(!response) return pc_cmd_donate(playerid);
			new moneys;
			if(sscanf(inputtext,"i", moneys)) return ShowPlayerDialog(playerid, D_DONATE_CONVERT, DSI, ""P"Купівля ігрової валюти", ""W"Введіть нижче суму, яку хочете обміняти на вірти\n{F2BB68}(1 UAH = $2.000)", "Купити", "Назад");
			if(PI[playerid][pRouble] < moneys) return ShowPlayerDialog(playerid, DIALOG_NONE, DSM, " ", ""W"Недостатньо грошей на акаунті\n\nПоповнити свій рахунок можна на сайті{F2BB68} chiliad-rp.com/donate", "Закрити", "");
			if(moneys < 1) return ShowPlayerDialog(playerid, D_DONATE_CONVERT, DSI, ""P"Купівля ігрової валюти", ""W"Введіть нижче суму, яку хочете обміняти на вірти\n{F2BB68}(1 UAH = $2.000)", "Купити", "Назад");
			GiveMoney(playerid,moneys*2000,"донат конверт");
			ShowPlayerDialog(playerid, DIALOG_NONE, DSM, " ", ""W"Ваш ігровий рахунок успішно поповнений.", "Закрити", "");
			GiveDonate(playerid, -moneys, "донат-конверт");
			return 1;
		}
	case D_DONATE_CHANGENAME: {
			if(!response) return pc_cmd_donate(playerid);
			if(PI[playerid][pWarns] >= 1) return ShowPlayerDialog(playerid, DIALOG_NONE, DSM, " ", ""G"На вашому акаунті присутні попередження", "Закрити", "");
			if(!strlen(inputtext)) return ShowPlayerDialog(playerid, D_DONATE_CHANGENAME, DSI, ""P"Зміна игрового нікнейму", ""W"Введіть нижче нікнейм, на який хочете змінити\n\n{F2BB68}Вартість послуги: 20 UAH", "Сменить", "Назад");
			if(PI[playerid][pRouble] < 20) return ShowPlayerDialog(playerid, DIALOG_NONE, DSM, " ", ""W"Недостатньо грошей на акаунті\n\nПоповнити свій рахунок можна на сайті{F2BB68} chiliad-rp.com/donate", "Закрити", "");
			if(!strlen(inputtext) || IsTextInvalid(inputtext) || strlen(inputtext) < 6 || strlen(inputtext) > 20 || !IsARPName(inputtext) || strfind(inputtext, " ") != -1) return ShowPlayerDialog(playerid, D_DONATE_CHANGENAME, DSI, ""P"Зміна ігрового нікнейму", ""W"Введіть нижче нікнейм, на який хочете змінити\n\n{F2BB68}Вартість послуги: 20 UAH", "Змінити", "Назад");
			SetPVarString(playerid,"WantNickChange", inputtext);
			new query[128];
			mysql_format(connects, query, sizeof(query),"SELECT `Name` FROM `accounts` WHERE `Name` = '%s' LIMIT 1", inputtext);
			mysql_tquery(connects, query, "GrandChangeName", "d", playerid);
			GiveDonate(playerid, -20, "зміна нікнейму");
			return 1;
		}
	case D_SELL_SIM: {
			if(response) {
				new sell_sim_id = GetPVarInt(playerid, "sim_id_sell")-1;
				new sell_sim_sum = GetPVarInt(playerid, "sim_summ");
				DeletePVar(playerid, "sim_id_sell");
				DeletePVar(playerid, "sim_summ");
				if(!IsPlayerConnected(sell_sim_id)) return SendError(playerid, "Гравець, який хотів продати вам SIM-карту, офлайн.");
				if(PI[playerid][pCash] < sell_sim_sum) {
					SendError(playerid, "У вас немає стільки грошей.");
					SendError(sell_sim_id,"У покупця недостатньо коштів.");
					return 1;
				}
				new string[128];
				format(string, sizeof(string), "Ви купили SIM-карту у "P"%s "W"за "ORANGE"$%i.", player_name[sell_sim_id],sell_sim_sum);
				SendUse(playerid, string);
				format(string, sizeof(string), ""P"%s "W"купив у вас SIM-карту за "ORANGE"$%i.", player_name[playerid],sell_sim_sum);
				SendUse(sell_sim_id, string);
				
				string[0] = EOS;
				format(string,64,"продал симку %s",player_name[playerid]);
				GiveMoney(sell_sim_id, sell_sim_sum, string);
				string[0] = EOS;
				format(string,64,"купил симку у %s",player_name[sell_sim_id]);
				GiveMoney(playerid, -sell_sim_sum, string);
				PI[playerid][pPhone] = PI[sell_sim_id][pPhone];
				PI[sell_sim_id][pPhone] = 0;
				UpdatePlayerData(playerid,"pPhone",PI[playerid][pPhone]);
				UpdatePlayerData(sell_sim_id,"pPhone",PI[sell_sim_id][pPhone]);
				format(string, sizeof(string), "Ваш ноВий номер: "W"%i",PI[playerid][pPhone]);
				SendClientMessage(playerid, CGOLD, string);
			}
			else {
				SendOK(GetPVarInt(playerid, "sim_id_sell")-1, "Гравець відмовився від купівлі SIM-карти.");
				SendOK(playerid, "Ви відмовились від купівлі SIM-карти");
				DeletePVar(playerid, "sim_id_sell");
				DeletePVar(playerid, "sim_summ");
			}
		}
	
