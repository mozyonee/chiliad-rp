			}
			new heh = GoogleAuthenticatorCode(PI[playerid][pGenGoogle], gettime());
			if(strval(inputtext) != heh) SendClientMessage(playerid,-1,"Ключ вказано неправильно.");
			else {
				PI[playerid][pGoogleSec] = 1;
