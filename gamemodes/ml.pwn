			if(Sewer[u][seTime] > gettime()) return SendError(playerid, "Люк зачинений. Почекайте, коли мусор утилізуєтся.");
			EnableGPSForPlayer(playerid, Sewer[u][seX],Sewer[u][seY],Sewer[u][seZ]);
