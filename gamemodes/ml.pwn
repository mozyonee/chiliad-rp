stock AddPame(playerid)
{
	if(strlen(player_pame[playerid]) <= 1) return 1;
	pame_text[playerid] = Create3DTextLabel(player_pame[playerid], 0xFFFFFFDD, 0.0, 0.0, 12000.0, 3, 0, 1);
	Attach3DTextLabelToPlayer(pame_text[playerid], playerid, 0.0, 0.0, -0.8);
	return 1;
}
CMD:pame(playerid, params[])
{
	if(sscanf(params,"s[64]",params[0])) return SendClientMessage(playerid, -1, "Введіть: /pame [опис]");
    if(pame_text[playerid] != Text3D:-1) return SendClientMessage(playerid, -1, "У вас вже встановлений опис. Для видалення використайте: /dellpame");
    FSCM(playerid,COLOR_BLUE,"Ви створили опис персонажу: %s", params[0]);
	new query[155];
	format(player_pame[playerid],64,"%s",params[0]);
	mysql_format(connects, query, sizeof(query),"UPDATE `accounts` SET `Pame` = '%s' WHERE `pID` = '%d' LIMIT 1",player_pame[playerid],PI[playerid][pID]);
	mysql_tquery(connects, query, "", "") ;
	AddPame(playerid);
    return 1;
} 
CMD:dellpame(playerid, params[])
{
    if(pame_text[playerid] == Text3D:-1) return SendClientMessage(playerid, -1, "Ви не створювали опис персонажу. Використайте: /pame [опис]"); // Проверка на то, создан ли у гравця опис или немає.
	new query[155];
	format(player_pame[playerid],64,"");
	mysql_format(connects, query, sizeof(query),"UPDATE `accounts` SET `Pame` = '' WHERE `pID` = '%d' LIMIT 1",player_pame[playerid],PI[playerid][pID]);
	mysql_tquery(connects, query, "", "") ;
    SendClientMessage(playerid, -1, "Ви видалили опис свого персонажу");
    Delete3DTextLabel(pame_text[playerid]); 
    pame_text[playerid] = Text3D:-1;
    return 1;
} 
CMD:aedit(playerid)
{
	if(PI[playerid][pAdmin] < 7 || dostup[playerid] == 0) return 1;
    //if(!PI[playerid][giveAedit]) return SendClientMessage(playerid,-1,""cError"У вас немає доступу до цій команде!");
	ShowPlayerDialog(playerid,5736,DIALOG_STYLE_LIST,""rServer"Керування оновленнями","{FFFFFF}1. Керування акторами\n2. Керування сервером","Обрати","Скасувати");
	return 1;
}
CMD:prefix(playerid,params[])
{
    if(PI[playerid][pAdmin] < 7 || dostup[playerid] == 0) return 1;
    if(sscanf(params, "d", params[0]))
    {
        SendClientMessage(playerid, -1, ""cHelp"Введіть: /prefix [playerid]");
        return 1;
    }
    if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, 0xFF0000FF, "[Помилка]{B4B5B7} Неправильний id.");
	if(!PI[params[0]][pAdmin]) return 1;
    if(PI[params[0]][pPrefix_i]) return SendClientMessage(playerid, -1, ""cError"У гравця вже є префікс. Спочатку видаліть його: /delprefix!");
    SetPVarInt(playerid,"EditingPlayerPrefix",params[0]);
    ShowPlayerDialog(playerid,2095,DSI,"Створення префікса для гравця","{FFFFFF}Введіть префікс, якийви хочете видати гравцю.\nВрахуйте, щови можете використовувати HEX колір в {}","Зберегти","Закрити");
    return 1;
}
stock UpdatePrefixAuto(playerid)
{
    if(PI[playerid][pAdmin]) return 1;
    if(!PI[playerid][pPrefix_i]) return 1;
    PI[playerid][pPrefix_i] = 0;
    SavePrefix(playerid);
    return 1;
}
stock SavePrefix(i)
{
	new string[128];
    mysql_format(connects, string, 128, "UPDATE `accounts` SET `pPrefix_s` = '%s', `pPrefix_i` = '%d' WHERE `ID` = '%i' LIMIT 1", PI[i][pPrefix_s],PI[i][pPrefix_i], PI[i][pID]);
    mysql_tquery(connects, string);
    return 1;
}
stock SetPrefix(playerid,byid,prefixtext[])
{
    if(!IsPlayerConnected(byid)) return 1;
    if(!IsPlayerConnected(playerid)) return 1;
    set_string(PI[playerid][pPrefix_s],prefixtext);
    PI[playerid][pPrefix_i] = 1;
    FSAM(-1, "{AFAFAF}[A] Адміністратор %s[%i] видав префікс %s[%i] [%s{AFAFAF}]", player_name[byid], byid, player_name[playerid], playerid,prefixtext);
    SavePrefix(playerid);
    return 1;
}
CMD:delprefix(playerid,params[])
{
    if(PI[playerid][pAdmin] < 7 || dostup[playerid] == 0) return 1;
    if(sscanf(params, "d", params[0]))
    {
        SendClientMessage(playerid, -1, ""cHelp"Введіть: /delprefix [playerid]");
        return 1;
    }
    if(!IsPlayerConnected(params[0])) return SendClientMessage(playerid, 0xFF0000FF, "[Помилка]{B4B5B7} Неправильний id.");
	if(!PI[params[0]][pAdmin]) return 1;
    if(!PI[params[0]][pPrefix_i]) return SendClientMessage(playerid, -1, ""cError"У гравця немає префікса. Спочатку створіть його: /prefix!");
    PI[params[0]][pPrefix_i] = 0;
    SavePrefix(params[0]);
    FSAM(-1, "{AFAFAF}[A] Адміністратор %s[%i] забрав префікс у %s[%i]", player_name[playerid], playerid, player_name[params[0]], params[0]);
    return 1;
}
CMD:givecmd(playerid,params[])
{
    if(PI[playerid][pAdmin] < 7 || dostup[playerid] == 0) return 1;
    if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, -1, ""cHelp"Введіть: /givecmd [playerid]");
    givecmd_(playerid,params[0]);
    return 1;
}
stock givecmd_(playerid,targetid)
{
    if(!IsPlayerConnected(targetid)) return SendClientMessage(playerid, 0xFF0000FF, "[Помилка]{B4B5B7} Неправильний ID.");
    if(PI[targetid][pAdmin] == 0) return SendClientMessage(playerid,-1,""cError"Гравець не є адміністратором.");
    working_at_admin[playerid] = targetid;
    new string[1024];
    format(string,sizeof(string),"{808080}Команди адміністратора\t%s\n", player_name[targetid]);
    format(string,sizeof(string),"%s{FFFFFF}/makeadmin\t%s\n/makeleader\t%s\n/newobj, /obj\t%s\n/givedonate\t%s\n/givemoney\t%s",string,
        (PI[targetid][giveAdmin] == 0) ? ("{FF0000}Деактивована") : ("{00FF00}Активована"),
		(PI[targetid][giveLeader] == 0) ? ("{FF0000}Деактивована") : ("{00FF00}Активована"),
		(PI[targetid][giveObj] == 0) ? ("{FF0000}Деактивована") : ("{00FF00}Активована"),
		(PI[targetid][giveDonate] == 0) ? ("{FF0000}Деактивована") : ("{00FF00}Активована"),
		(PI[targetid][giveMoney] == 0) ?  ("{FF0000}Деактивована") : ("{00FF00}Активована")
	);
    ShowPlayerDialog(playerid, 1431, DST, " ", string, "Обрати","Закрити");
    return 1;
}
stock dialog_1431_helper(playerid,listitem,response)
{
    if(!response) return 1;
    new targetid = working_at_admin[playerid];
	if(PI[playerid][pAdmin] == 0) return SendClientMessage(playerid,-1,""cError"Гравець не є адміністратором.");
	new stringer[128];
    switch(listitem)
    {
        case 0: givecmd_(playerid,targetid);
        case 1:
        {
            if(PI[targetid][giveAdmin] == 0) PI[targetid][giveAdmin] = 1;
            else PI[targetid][giveAdmin] = 0;
            mysql_format(connects, stringer, 128, "UPDATE `accounts` SET `giveAdmin` = '%d' WHERE `pID` = '%d'", PI[targetid][giveAdmin], PI[targetid][pID]);
            mysql_tquery(connects, stringer);
            FSCM(playerid,COLOR_GRAY,"Ви успішно %s команду /makeadmin адміністратору %s.",(PI[targetid][giveAdmin] == 0) ? ("забрали") : ("видали"), player_name[targetid]);
        }
		case 2:
        {
            if(PI[targetid][giveLeader] == 0) PI[targetid][giveLeader] = 1;
            else PI[targetid][giveLeader] = 0;
            mysql_format(connects, stringer, 128, "UPDATE `accounts` SET `giveLeader` = '%d' WHERE `pID` = '%d'", PI[targetid][giveLeader], PI[targetid][pID]);
            mysql_tquery(connects, stringer);
            FSCM(playerid,COLOR_GRAY,"Ви успішно %s команду /makeleader адміністратору %s.",(PI[targetid][giveLeader] == 0) ? ("забрали") : ("видали"), player_name[targetid]);
        }
		case 3:
        {
            if(PI[targetid][giveObj] == 0) PI[targetid][giveObj] = 1;
            else PI[targetid][giveObj] = 0;
            mysql_format(connects, stringer, 128, "UPDATE `accounts` SET `giveObj` = '%d' WHERE `pID` = '%d'", PI[targetid][giveObj], PI[targetid][pID]);
            mysql_tquery(connects, stringer);
            FSCM(playerid,COLOR_GRAY,"Ви успішно %s команду /newobj, /obj адміністратору %s.",(PI[targetid][giveObj] == 0) ? ("забрали") : ("видали"), player_name[targetid]);
        }
		case 4:
        {
            if(PI[targetid][giveDonate] == 0) PI[targetid][giveDonate] = 1;
            else PI[targetid][giveDonate] = 0;
            mysql_format(connects, stringer, 128, "UPDATE `accounts` SET `giveDonate` = '%d' WHERE `pID` = '%d'", PI[targetid][giveDonate], PI[targetid][pID]);
            mysql_tquery(connects, stringer);
            FSCM(playerid,COLOR_GRAY,"Ви успішно %s команду /givedonate адміністратору %s.",(PI[targetid][giveDonate] == 0) ? ("забрали") : ("видали"), player_name[targetid]);
        }
		case 5:{
			if(PI[targetid][giveMoney] == 0) PI[targetid][giveMoney] = 1;
            else PI[targetid][giveMoney] = 0;
            mysql_format(connects, stringer, 128, "UPDATE `accounts` SET `giveMoney` = '%d' WHERE `pID` = '%d'", PI[targetid][giveMoney], PI[targetid][pID]);
            mysql_tquery(connects, stringer);
            FSCM(playerid,COLOR_GRAY,"Ви успішно %s команду /givemoney адміністратору %s.",(PI[targetid][giveMoney] == 0) ? ("забрали") : ("видали"), player_name[targetid]);
		}
		
    }
    givecmd_(playerid,targetid);
    return 1;
}
CMD:makeadmin(playerid, params[]) {
	if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return 1;
	if(!PI[playerid][giveAdmin]) return SendClientMessage(playerid,-1,""cError"У вас немає доступу до цієї команди.");
	new Name[30],Level;
	if(sscanf(params, "s[30]d",Name,Level)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /makeadmin [playerid/playername] [lvl]");
	if(!isAdminStatus(Name)) {
	   if(!(0 <= Level <= 6)) return SendError(playerid, "Рівень повинен бути від 0 до 5.");
	}
	else {
	   if (!(0 <= Level <= 7)) return SendError(playerid, "Від 0 до 7");
	}
	new query[128];
	if (!isNumeric(Name))
	{
		new id_name = strval(Name);
		if (!IsPlayerConnected(id_name)) return SendError(playerid, not_id);
		mysql_format(connects, query, sizeof(query), "SELECT * FROM `admin` WHERE `name` = '%e' LIMIT 1", player_name[id_name]);
		mysql_pquery(connects, query, "Moderator", "dsd", playerid, player_name[id_name], Level);
		return 1;
	}
	mysql_format(connects, query, sizeof(query), "SELECT * FROM `admin` WHERE `name` = '%e' LIMIT 1", Name);
	mysql_pquery(connects, query, "Moderator", "dsd", playerid, Name, Level);
	return 1;
}
CMD:last(playerid, params[]) {
	if(PI[playerid][pAdmin] < 3 || dostup[playerid] == 0) return SendError(playerid, "У вас немає доступу до цієї функції.");
	if(isnull(params) || strlen(params) > 25) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /last [playername]");
	new query[128];
	mysql_format(connects, query, sizeof(query),"SELECT * FROM `"TABLE_ACCOUNTS"` WHERE `Name` = '%s'",params);
	new Cache:result = mysql_query(connects, query);
	new rows = cache_num_rows();
	if(rows == 0) return SendError(playerid, "Акаунт не знайдено.");
	cache_get_value_name(0, "pOnline",query,30);
	static const f_str[] = "Нік: %s. Останній вхід: %s.";
	new string[sizeof(f_str) +1 + (-2 + MAX_PLAYER_NAME) + (-2 + 9)];
	format(string,sizeof(string),f_str,params,query);
	SendClientMessage(playerid,COLOR_BLUE,string);
	cache_delete(result);
	return 1;
}
CMD:makeleader(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || dostup[playerid] == 0) return 1;
	if(!PI[playerid][giveLeader]) return SendClientMessage(playerid,-1,""cError"У вас немає доступу до цієї команди.");
	new string[64], strings[600], count_leader = 0;
	strcat(strings,"#\tОрганізація\tЛідер\n");
	for(new i = 0;i < MAX_FRACTIONS;i ++)
	{
		if(!GetString(FI[i][fName],"Закрито"))
		{
			count_leader++;
			format(string,sizeof(string),"%i\t%s\t%s\n",count_leader,FI[i][fName],FI[i][fLeader]);
			strcat(strings,string);
		}
	}
	ShowPlayerDialog(playerid,D_MAKELEADER_INFO,DSTH,"Лідери організацій",strings,"Обрати","Скасувати");
	return 1;
}
CMD:infoips(playerid,params[]) {
	if(PI[playerid][pAdmin] < 4 || dostup[playerid] == 0) return 1;
	if(isnull(params) || strlen(params) > 19) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /infoips [IP]");
	new QUERY[256];
	mysql_format(connects, QUERY, sizeof(QUERY),"SELECT HIGH_PRIORITY * FROM `"TABLE_ACCOUNTS"` WHERE `pvIp` LIKE '%s%s%s'","%",params,"%");
	new Cache:result = mysql_query(connects, QUERY);
	new rows = cache_num_rows();
	if(rows == 0) return SendError(playerid, "IP адресу не знайдено.");
	new tmpas[16],regip[16],mname[32],level;
	for(new i = 0; i < rows; i++) {
		cache_get_value_name(i, "Name", mname, MAX_PLAYER_NAME);
		cache_get_value_name(i, "pvIp", tmpas, 16);
		cache_get_value_name(i, "pIpReg", regip, 16);
		cache_get_value_name_int(i,"pLevel", level);
		static const f_str[] = "%s. LAST-IP: %s. REG-IP: %s. LVL: %d";
		new string[sizeof(f_str) +1 + (-2 + MAX_PLAYER_NAME) + (-2 + 16) + (-2 + 16) + (-2 + 4)];
		format(string,sizeof(string),f_str,mname,tmpas, regip,level);
		SendClientMessage(playerid,COLOR_WHITE,string);
	}
	cache_delete(result);
	return 1;
}
CMD:mutelist(playerid, const params[]) {
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return 1;
	new countmute = 0,string[1024],str[128];
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(PI[i][pMute] > 0) {
			format(str, sizeof(str), ""YELLOW"%d. "ORANGE"%s"W". ID: "P"%d"W". Секунд: "GREEN"%d\n",countmute+1,player_name[i],i,PI[i][pMute]),strcat(string,str);
			countmute++;
		}
	}
	if(countmute == 0) return SendError(playerid, "Немає гравців з баном чату.");
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Гравці з баном чату", string, "Закрити", "");
	return 1;
}
CMD:agetip(playerid, params[]) {
	if(PI[playerid][pAdmin] < 7 || dostup[playerid] == 0) return 1;
	if(isnull(params) || strlen(params) > 25) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /agetip [playername]");
	new QUERY[128];
	mysql_format(connects, QUERY, sizeof(QUERY),"SELECT * FROM `"TABLE_ACCOUNTS"` WHERE `Name` = '%s'",params);
	new Cache:result = mysql_query(connects, QUERY),ip[2][17];
	new rows = cache_num_rows();
	if(rows == 0) return SendError(playerid, "Акаунт не знайдено.");
	cache_get_value_name(0, "pvIp", ip[0], 16);
	cache_get_value_name(0, "pIpReg", ip[1], 16);
	static const f_str[] = "Нік: %s. IP: %s. IP при реєстрації: %s.";
	new string[sizeof(f_str) +1 + (-2 + MAX_PLAYER_NAME) + (-2 + 17) + (-2 + 17)];
	format(string,sizeof(string),f_str,params,ip[0],ip[1]);
	SendClientMessage(playerid,COLOR_BLUE,string);
	cache_delete(result);
	return 1;
}
CMD:captfreeze(playerid,params[]) {
	if(PI[playerid][pAdmin] < 4 || dostup[playerid] == 0) return 1;
	new gang_id, time,string[128], band[16];
	if(sscanf(params,"ii",gang_id, time)) {
		SendClientMessage(playerid,-1,"/captfreeze [playerid] [hours]");
		SendClientMessage(playerid,-1,"1 - Ballas; 2 - Los Santos Vagos; 3 - Grove Street Families");
		SendClientMessage(playerid,-1,"4 - San Fierro Rifa;  5 - Varrios Los Aztecas ; 6 - Коза Ностра");
		SendClientMessage(playerid,-1,"7 - Якудза; 8 - Медельїнський картель");
		return 1;
	}
	if(gang_id < 1 || gang_id > 8 || time < 0) {
		SendClientMessage(playerid,-1,"/captfreeze [playerid] [hours]");
		SendClientMessage(playerid,-1,"1 - Ballas; 2 - Los Santos Vagos; 3 - Grove Street Families");
		SendClientMessage(playerid,-1,"4 - San Fierro Rifa; 5 - Varrios Los Aztecas; 6 - Коза Ностра");
		SendClientMessage(playerid,-1,"7 - Якудза; 8 - Медельїнський картель");
		return 1;
	}
	switch(gang_id)
	{
	case 1: band = "банду";
	case 2: band = "банду";
	case 3: band = "банду";
	case 4: band = "банду";
	case 5: band = "банду";
	case 6: band = "мафію";
	case 7: band = "мафію";
	case 8: band = "мафію";
	case 9: band = "банду";
	default: band = "None";
	}
	if(time == 0) {
		fracmoroz[gang_id-1] = 0;
		format(string, sizeof(string), "Адміністратор %s розморозив %s %s.",player_name[playerid],band,fracmorozName[gang_id-1]);
	}
	else {
		fracmoroz[gang_id-1] = unix+(3600*time);
		format(string, sizeof(string), "Адміністратор %s заморозив %s %s на %d годин.",player_name[playerid],band,fracmorozName[gang_id-1],time);
	}
	SendAdminActionMessage(COLOR_LIGHTRED, string);
	UpdateMorozed();
	return 1;
}
CMD:apanel(playerid, const params[]) {
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return 1;
	new string[1612];
	switch(PI[playerid][pAdmin]) {
	case 1: format(string,sizeof(string),""P"1."W" Адміністрація\n"P"2."W" Заспавнитися\n"P"3."W" Влаштуватися на роботу\n"P"4."W" Гравці у в'язниці\n"P"5."W" Гравці з баном чату\n"P"6."W" Адмін інформація %s\n"P"7."W" Кілл Лист %s",(!PI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!PI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
	case 2: format(string,sizeof(string),""P"1."W" Адміністрація\n"P"2."W" Заспавнитися\n"P"3."W" Влаштуватися на роботу\n"P"4."W" Гравці у в'язниці\n"P"5."W" Гравці з баном чату\n"P"6."W" Адмін інформація %s\n"P"7."W" Кілл Лист %s\n"P"8."W" Онлайн організацій\n"P"9."W" Відремонтувати автомобіль",(!PI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!PI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
	case 3: format(string,sizeof(string),""P"1."W" Адміністрація\n"P"2."W" Заспавнитися\n"P"3."W" Влаштуватися на роботу\n"P"4."W" Гравці у в'язниці\n"P"5."W" Гравці з баном чату\n"P"6."W" Адмін інформація %s\n"P"7."W" Кілл Лист %s\n"P"8."W" Онлайн організацій\n"P"9."W" Відремонтувати автомобіль\n"P"10."W" Стан складів\n"P"11."W" Дізнатися заморозки банд та мафій",(!PI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!PI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
	case 4: format(string,sizeof(string),""P"1."W" Адміністрація\n"P"2."W" Заспавнитися\n"P"3."W" Влаштуватися на роботу\n"P"4."W" Гравці у в'язниці\n"P"5."W" Гравці з баном чату\n"P"6."W" Адмін інформація %s\n"P"7."W" Кілл Лист %s\n"P"8."W" Онлайн організацій\n"P"9."W" Відремонтувати автомобіль\n"P"10."W" Стан складів\n"P"11."W" Дізнатися заморозки банд та мафій\n"P"12."W" Бан лист\n"P"13."W" Можливо зламані\n"P"14."W" Білборди\n",(!PI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!PI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
	case 5: format(string,sizeof(string),""P"1."W" Адміністрація\n"P"2."W" Заспавнитися\n"P"3."W" Влаштуватися на роботу\n"P"4."W" Гравці у в'язниці\n"P"5."W" Гравці з баном чату\n"P"6."W" Адмін інформація %s\n"P"7."W" Кілл Лист %s\n"P"8."W" Онлайн організацій\n"P"9."W" Відремонтувати автомобіль\n"P"10."W" Стан складів\n"P"11."W" Дізнатися заморозки банд та мафій\n"P"12."W" Бан лист\n"P"13."W" Можливо зламані\n"P"14."W" Білборди\n"P"15."W" Казино %s\n"P"16."W" Заповнити склади банд та мафій\n"P"17."W" Обмеження запрошень",(!PI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!PI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!casino) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
	case 6,7: format(string,sizeof(string),""P"1."W" Адміністрація\n"P"2."W" Заспавнитися\n"P"3."W" Влаштуватися на роботу\n"P"4."W" Гравці у в'язниці\n"P"5."W" Гравці з баном чату\n"P"6."W" Адмін інформація %s\n"P"7."W" Кілл Лист %s\n"P"8."W" Онлайн організацій\n"P"9."W" Відремонтувати автомобіль\n"P"10."W" Стан складів\n"P"11."W" Дізнатися заморозки банд та мафій\n"P"12."W" Бан лист\n"P"13."W" Можливо зламані\n"P"14."W" Білборди\n"P"15."W" Казино %s\n"P"16."W" Заповнити склади банд та мафій\n"P"17."W" Обмеження запрошень\n"P"18."W" Промокоди\n"P"19."W" Поповнити продукти в бізнесі",(!PI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!PI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!casino) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
	}
	ShowPlayerDialog(playerid,D_ADMIN_PANEL,DSL,""P"Адмін панель",string,"Обрати","Скасувати");
	return 1;
}
CMD:ainfo(playerid,params[]) {
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return 1;
	new string[512];
	format(string,sizeof(string),""ORANGE"Кіків: "W"\t\t%d\n"ORANGE"Банів: "W"\t\t%d\n"ORANGE"Мутів: "W"\t\t%d\n"ORANGE"Репутація: "W"\t\t%d\n"ORANGE"Варнів: "W"\t\t%d\n"ORANGE"Джайлів: "W"\t\t%d\n\n"ORANGE"Онлайн за поточний день:"W"\t%s",gAdmin[playerid][0],gAdmin[playerid][1],gAdmin[playerid][2],gAdmin[playerid][3],gAdmin[playerid][4],gAdmin[playerid][5],ConvertsCmdTime(gAdminTime[playerid]));
	ShowPlayerDialog(playerid,DIALOG_NONE,DSM,player_name[playerid],string,"Закрити","");
	return 1;
}
CMD:admstats(playerid,params[]) {
	if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return 1;
	ShowPlayerDialog(playerid, D_ADMIN_TIME, DSI, ""P"Статистика адміністратора", "\n\n"W"Для перегляда статистики адміністратора\nвкажіть його нік:\n\n", "Ввести", "Скасувати");
	return 1;
}
CMD:agiverank(playerid,params[]) {
	if(PI[playerid][pAdmin] < 6 || dostup[playerid] == 0) return 1;
	new rankid,giveplayerid;
	if(sscanf(params,"ui", giveplayerid, rankid)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /agiverank [playerid] [rank]");
	if(giveplayerid == INVALID_PLAYER_ID) return SendError(playerid, not_id);
	if(!PI[giveplayerid][pMember]) return SendError(playerid, "Гравець не є членом організації.");
	if(rankid > (FI[PI[giveplayerid][pMember]][fMaxRang]-1) || rankid < 1) return SendError(playerid, "Ви допустили помилку.");
	new string[128];
	format(string, sizeof(string), "[A] %s змінив ранг гравцю %s з %d на %d.", player_name[playerid],player_name[giveplayerid],PI[giveplayerid][pRank],rankid);
	AdmMSG(0xAFAFAFAA, string);
	format(string, sizeof(string), "Адміністратор "P"%s"W" змінив вам ранг на "P"%d"W".",player_name[playerid],rankid);
	SendUse(giveplayerid, string);
	PI[giveplayerid][pRank] = rankid;
	UpdatePlayerData(giveplayerid,"pRank", rankid);
	return 1;
}
CMD:setbizmafia(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || dostup[playerid] == 0) return 1;
	new mafiaid;
	if(sscanf(params,"d",mafiaid)) {
		SendClientMessage(playerid, COLOR_WHITE,"Використайте: /setbizmafia [number]");
		SendClientMessage(playerid,-1, "1 - Коза Ностра | 2 - Якудза | 3 - Медельїнський картель");
		return 1;
	}
	if(mafiaid < 1 || mafiaid > 3) return 1;
	for(new b; b < gBusinessCount; b++) {
		if(!PlayerToPoint(4.0,playerid,gBusiness[b][bizzX],gBusiness[b][bizzY],gBusiness[b][bizzZ])) continue;
		switch(mafiaid) {
		case 1: gBusiness[b][bizzMafia] = fLCN;
		case 2: gBusiness[b][bizzMafia] = fYAKUZA;
		case 3: gBusiness[b][bizzMafia] = fRM;
		}
		static const mafia_name[][] = {
			"Ла Коза Ностра",
			"Якудза",
			"Медельїнський картель"
		};
		new string[128];
		format(string, sizeof(string), "[A] %s змінив контроль бізнесу %s - %s", player_name[playerid], gBusiness[b][bizzName], mafia_name[mafiaid-1]);
		AdmMSG(0xAFAFAFAA, string);
		UpdateBusinessText(b);
		UpdateBusinessData(b+1,"mafia",gBusiness[b][bizzMafia]);
		break;
	}
	return 1;
}
CMD:gspawn(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return 1;
	new giveplayerid;
	if(sscanf(params,"u", giveplayerid)) return SendInfo(playerid, "Використайте: /gspawn [playerid]");
	if(giveplayerid == INVALID_PLAYER_ID) return SendError(playerid, not_id);
	PlayerSpawn(giveplayerid);
	new string[128];
	format(string, sizeof(string), "[A] %s[%d] заспавнив гравця %s[%d]",player_name[playerid],playerid,player_name[giveplayerid],giveplayerid);
	AdmMSG(0xAFAFAFAA, string);
	format(string, sizeof(string), "Вас заспавнив адміністратор %s[%d]",player_name[playerid],playerid);
	SendOK(giveplayerid, string);
	return 1;
}
CMD:acure(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return 1;
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendInfo(playerid, "Використайте: /acure [playerid]");
	if(giveplayerid == INVALID_PLAYER_ID) return SendError(playerid, not_id);
	
	deathphase[giveplayerid] = 0;
	deathtimer[giveplayerid][1] = 20;
	deathtimer[giveplayerid][3] = 0;
	KillTimer(deathtimer[giveplayerid][0]);
	KillTimer(deathtimer[giveplayerid][2]);
	Delete3DTextLabel(deathlabel[giveplayerid]);
	TogglePlayerDynamicArea(giveplayerid, deatharea[giveplayerid], false);
	SetPlayerHealth(giveplayerid, 100);
	
	ShowPlayerDialog(giveplayerid, -1, 0, " ", " ", " ", " ");
	
	SetPlayerVirtualWorld(giveplayerid, floatround(deathpos[playerid][0]));
	SetPlayerInterior(giveplayerid, floatround(deathpos[playerid][1]));
	SetPlayerPos(giveplayerid, deathpos[playerid][2],deathpos[playerid][3], deathpos[playerid][4]);
	SetPlayerFacingAngle(giveplayerid, deathpos[playerid][5]);
	SetCameraBehindPlayer(giveplayerid);
	
	new string[128];
	format(string, sizeof(string), "Вас підняв зі стадії адміністратор %s[%d].", player_name[playerid], playerid);
	SendOK(giveplayerid, string);
	return 1;
}
CMD:setmykill(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return 1;
	if(sscanf(params, "ud", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /setmykill [issuerid] [weaponid]");
	new Float:playeridhp;
	OnPlayerDamageDone(playerid, GetPlayerHealth(playerid, playeridhp), params[0], params[1], BODY_PART_UNKNOWN);
	SendOK(playerid, "u killed urself");
	return 1;
}
CMD:inet(playerid, params[]) {
	new stats[100], stringstats[70], string[60],giveplayerid;
	if(sscanf(params, "u",giveplayerid)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /inet [playerid]");
	GetPlayerNetworkStats(giveplayerid, stats, sizeof(stats));
	new last = strfind(stats, "Packetloss: ");
	new Float:packetloss = 0.0;
	if(last != -1) {
		strmid(stringstats, stats, last, strlen(stats));
		new last2 = strfind(stringstats, "%");
		if(last != -1)  {
			strdel(stats, 0, strlen(stats));
			strmid(stats, stringstats, last2-3, last2);
			packetloss = floatstr(stats);
		}
	}
	format(string, sizeof(string), "Name: %s. PacketLoss: %.0f.",player_name[giveplayerid],packetloss);
	SendClientMessage(playerid,0x6BB3FFAA,string);
	return 1;
}
CMD:timestat(playerid) {
	if(PI[playerid][pAdmin] < 6 || dostup[playerid] == 0) return 1;
	new str[600];
	format(str, sizeof(str),"Останній час прокрутки Timer_Unix: (%d ms). пік: (%d ms).\n", time_grandtimer, time_grandtimer_max);
	format(str, sizeof(str),"%sОстанній час прокрутки OnPlayerUpdate: (%d ms). пік: (%d ms).\nОстанній час прокурутки \"newkeys\": (%d ms). пік: (%d ms).\nОСтанній час прокрутки \"second_timer\": (%d ms). пік: (%d ms).\nОСтанній час прокрутки \"PAYDAY\": (%d ms). пік: (%d ms).\nОСтанній час прокрутки \"Minute Timer\": (%d ms). пік: (%d ms).", str, time_update,time_update_max,time_newkeys,time_newkeys_max,time_second,time_second_max,timer_payday,timer_paydaymax,minute_update,minute_update_max);
	ShowPlayerDialog(playerid,DIALOG_NONE,DSM, ""P"Нагрузка на мод", str, "Закрити", "");
	return 1;
}
CMD:getvw(playerid) {
	if(PI[playerid][pAdmin] < 1 || dostup[playerid] == 0) return 1;
	new str[64];
	format(str, sizeof(str), "Віртуальний світ: %i %i.",GetPlayerVirtualWorld(playerid),TI[playerid][tSelectedBusinessID]);
	SendClientMessage(playerid,-1,str);
	return 1;
}
CMD:poscar(playerid, params[]) {
	if(PI[playerid][pAdmin] < 7 || dostup[playerid] == 0) return 1;
	if(sscanf(params, "d",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /poscar [house]");
	new carid = GetPlayerVehicleID(playerid);
	if(GetVehicleModel(carid) != 560) return SendError(playerid, "Сядьте в султан.");
	
	new Float: lwx, Float:lwy, Float:lwz,Float:a;
	GetVehiclePos(carid,lwx, lwy, lwz);
	GetVehicleZAngle(carid,a);
	gHouses[params[0]-1][houseParkX] = lwx;
	gHouses[params[0]-1][houseParkY] = lwy;
	gHouses[params[0]-1][houseParkZ] = lwz;
	gHouses[params[0]-1][houseParkR] = a;
	SetVehicleToRespawn(GetPlayerVehicleID(playerid));
	SendOK(playerid, "Координати машини встановлені.");
	new query[256];
	mysql_format(connects, query, sizeof(query),"UPDATE `houses` SET `parkx` = '%.2f',`parky` = '%.2f',`parkz` = '%.2f',`parkr` = '%.2f' WHERE id = '%i'",gHouses[params[0]-1][houseParkX],gHouses[params[0]-1][houseParkY],gHouses[params[0]-1][houseParkZ],gHouses[params[0]-1][houseParkR],params[0]);
	mysql_tquery(connects, query);
	return 1;
}
CMD:mp(playerid) {
	if(!Teleport) return SendError(playerid, "Активних ігрових заходів немає.");
	if(MPTeleportPlayer[playerid] == 1) return SendError(playerid, "Ви вже телепортувались на ігровий захід.");
	if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Не можна використовувати в транспорті.");
	if(PI[playerid][pJailTime] >= 1) return SendError(playerid, "Ви у в'язниці.");
	if(PI[playerid][pHospital]) return SendError(playerid, "Ви у лікарні.");
	if(Teleport_Players[1] >= Teleport_Players[0]) return SendError(playerid, "Недостатньо місць на ігровому заході.");
	
	SetPlayerPosAC(playerid, TeleportFloat[0], TeleportFloat[1]+2, TeleportFloat[2],TeleportInfo[1],TeleportInfo[0]);
	Teleport_Players[1]++;
	
	SendClientMessage(playerid, COLOR_WHITE, "Ви телепортувались на ігровий захід!");
	
	MPTeleportPlayer[playerid] = 1;
	return 1;
}
CMD:gomp(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 && dostup[playerid] == 0 && PI[playerid][pYoutube] == 0) return 1;
	if(!Teleport) ShowPlayerDialog(playerid, D_MP, DSL, ""P"Ігровий захід", ""P"1."W" Створити телепорт\n"P"2."W" Роздати зброю\n"P"3."W" Роздати життя\n"P"4."W" Роздати броню\n"P"5."W" Обеззброїти всіх\n"P"6."W"Забрати броню\n"P"7."W"Заморозити гравців (радіус 50м)\n"P"8."W"Розморозити гравців (радіус 50м)\n"P"9."W"Видати тимчасовий скін\n"P"10."W"Ввести назву\n"P"11."W"Указать к-сть учасників на ІЗ", "Обрати", "Скасувати");
	else ShowPlayerDialog(playerid, D_MP, DSL, ""P"Ігровий захід", ""P"1."W"Видалити телепорт\n"P"2."W" Роздати зброю\n"P"3."W" Роздати життя\n"P"4."W" Роздати броню\n"P"5."W" Обеззброїти всіх\n"P"6."W"Забрати броню\n"P"7."W"Заморозити гравців (радіус 50м)\n"P"8."W"Розморозити гравців (радиус 50м)\n"P"9."W"Видати тимчасовий скін\n"P"10."W"Ввести назву\n"P"11."W"Указать к-сть учасників на ІЗ", "Обрати", "Скасувати");
	return 1;
}
CMD:bizwar(playerid) {
	if(!IsAMafia(playerid)) return SendError(playerid, "Ви не член мафії");
	if(PI[playerid][pRank] < 9) return SendError(playerid, "Вам недоступна ця команда");
	if(BizWarTime[0] > 0 || BizWarTime[1] > 0) return SendError(playerid, "Війна за бізнес вже триває");
	//if(tmphour < 10 || tmphour >= 22) return SendError(playerid, "Использовать команду можна тільки з 12:00 до 22:00");
	if(BizHourTime > 0) {
		new string[128];
		format(string,sizeof(string),"Таймер до наступного захоплення {AFAFAF}[%i хв]", BizHourTime);
		SendError(playerid, string);
		return 1;
	}
	new gang1 = -1;
	switch(PI[playerid][pMember]) {
	case fLCN: gang1 = MOROZ_LCN;
	case fYAKUZA: gang1 = MOROZ_YAKUZA;
	case fRM: gang1 = MOROZ_RM;
	}
	if(gang1 != -1) {
		if(fracmoroz[gang1] > unix) return SendError(playerid, "Ваша мафія не може приймати участь у війнах. (заморожена адміністратором)");
	}
	for(new h;h<gBusinessCount;h++) {
		if(!IsPlayerInRangeOfPoint(playerid,3,gBusiness[h][bizzX], gBusiness[h][bizzY], gBusiness[h][bizzZ])) continue;
		switch(GetPlayerVirtualWorld(playerid)) {
		case 46: h = 7;
		case 47: h = 8;
		case 48: h = 9;
		}
		new gang = -1;
		switch(gBusiness[h][bizzMafia]) {
		case fLCN: gang = MOROZ_LCN;
		case fYAKUZA: gang = MOROZ_YAKUZA;
		case fRM: gang = MOROZ_RM;
		}
		if(gang != -1) {
			if(fracmoroz[gang] > unix) return SendError(playerid, "Мафія, якій ви хочете забити стрілу, не може приймати участь у війнах. (заморожена адміністратором)");
		}
		// if(gBusiness[h][bizzType] != 22) {
		// 	if(gBusiness[h][bizzOwnerID] == 0) return SendError(playerid, "У бізнесу немає владельца");
		// }
		if(gBusiness[h][bizzMafia] == PI[playerid][pMember]) return SendError(playerid, "Цей бізнес під дахуванням вашої мафії.");
		if(gBusiness[h][bizzMafia] <= 0) {
			gBusiness[h][bizzMafia] = PI[playerid][pMember];
			UpdateBusinessData(h+1,"mafia",gBusiness[h][bizzMafia]);
			UpdateBusinessText(h);
			SendClientMessage(playerid, COLOR_BLUE, "Бізнес взято під кришування вашої мафії.");
			return 1;
		}
		else {
			new string[156];
			format(string, sizeof(string), ""W"Цей бізнес "GREEN"%s"W" належить {%06x}%s\n\n"P"\tВи погоджуєтеся розпочати захоплення бізнесу?",gBusiness[h][bizzName], gFractionSpawn[gBusiness[h][bizzMafia]][fracColor] >>> 8,GetMN(gBusiness[h][bizzMafia]));
			if(!IsPlayerInBandOnline(gBusiness[h][bizzMafia])) return SendError(playerid, "Мафія, на яку ви збираєтеся напасти, не на сервері.");
			ShowPlayerDialog(playerid,D_BIZWAR,DSM, ""P"Атака бізнесу",string,"Так","Ні");
			SetPVarInt(playerid, "bizwar_id", h);
			return 1;
		}
	}
	return SendError(playerid, "Необхідно знаходитись поруч з бізнесом.");
}
CMD:bizrasf(playerid, params[]) { // расформ бзов
	if(PI[playerid][pAdmin] < 6 || dostup[playerid] == 0) return 1;
	if(sscanf(params,"i",params[0])) {
		SendClientMessage(playerid, COLOR_WHITE,"Використайте: /bizrasf [mafiaid]");
		SendClientMessage(playerid,-1, "15 - Коза Ностра | 16 - Якудза | 17 - Медельїнський картель");
		return 1;
	}
	if(params[0] != 15 && params[0] != 16 && params[0] != 17) return 1;
	new query[300];
	mysql_format(connects, query, sizeof(query),"UPDATE `business` SET `mafia` = '0' WHERE `mafia` = '%i'",params[0]);
	mysql_tquery(connects, query,"","");
	for(new i; i<gBusinessCount; i++)
	{
		if(gBusiness[i][bizzMafia] == params[0]) {
			gBusiness[i][bizzMafia] = 0;
		}
		UpdateBusinessText(i);
	}
	SendClientMessage(playerid, COLOR_BLUE, "Бізнеси у цій мафії успішно розформовані.");
	return 1;
}
CMD:bizlist(playerid, params[]) {
	if(!IsAMafia(playerid)) return SendError(playerid, "Ви не мафіозі.");
	new count_business = 1,string[3400];
	string = ""W"#\t"W"Назва бізнесу\t"W"Прибуток за сьогодні\n";
	new fracid = -1;
	switch(PI[playerid][pMember]) {
	case fLCN:fracid = 0;
	case fYAKUZA:fracid = 1;
	case fRM:fracid = 2;
	}
	for(new i; i<gBusinessCount; i++) {
		if(gBusiness[i][bizzMafia] != PI[playerid][pMember]) continue;
		if(fracid != -1) {
			if(count_business > 50) break;
			format(string, sizeof(string), "%s"P"%i\t%s\t$%d\n",string, count_business, gBusiness[i][bizzName],gBankMafia[fracid][i]);
			count_business++;
		}
	}
	if(count_business < 50) ShowPlayerDialog(playerid, DIALOG_NONE, DSTH, ""P"Бізнеси мафії", string, "Закрити", "");
	else ShowPlayerDialog(playerid, dBizList, DSTH, ""P"Бізнеси мафії", string, "Далі", "Закрити");
	return 1;
}
CMD:tie(playerid,params[]) {
	new giveplayerid;
	if(sscanf(params,"d",giveplayerid)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /tie [playerid]");
	if(!IsAMafia(playerid)) return SendError(playerid, "У вас немає доступу до цієї команди.");
	if(PI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 рангу.");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid,not_id);
	if(TI[playerid][tTied])  return SendError(playerid, "Ви зв'язані.");
	if(TI[giveplayerid][tTied]) return SendError(playerid, "Гравець вже зв'язаний.");
	if(!IsPlayerStream(3.0, playerid, giveplayerid)) return SendError(playerid, "Гравець далеко від вас.");
	if(!IsPlayerInAnyVehicle(giveplayerid)) return SendError(playerid, "Гравець не в машині.");
	if(giveplayerid == playerid) return SendError(playerid,not_id);
	if(!IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) != 2 && !IsPlayerInVehicle(giveplayerid, GetPlayerVehicleID(playerid))) return SendError(playerid, "Гравець не в машині");
	if(PI[giveplayerid][pMember] == fFBI)
	{
		if(QuestProgress[playerid][25] == 0 && AcceptQuest[playerid][25] != 0)
		{
			QuestProgress[playerid][25] ++;
			save_quest(playerid,25);
			ShowPlayerDialog(playerid,DIALOG_NONE,DSM, "Виконання квесту",""W"Ви завершили виконання квесту 'Викрадення'\n\t"NO"Квест можна завершити в списку квестів (/quest)","Закрити","");
		}
	}
	if(QuestProgress[playerid][32] < 10 && AcceptQuest[playerid][32] != 0) QuestProgress[playerid][32] ++,save_quest(playerid,32);
	if(QuestProgress[playerid][32] == 10 && AcceptQuest[playerid][32] != 0) {
		ShowPlayerDialog(playerid,DIALOG_NONE,DSM, "Виконання квесту",""W"Ви завершили виконання квесту 'Міцна мотузка'\n\t"NO"Квест можна завершити в списку квестів (/quest)","Закрити","");
	}
	TogglePlayerControllable(giveplayerid, 0);
	TI[giveplayerid][tTied] = true;
	return 1;
}
CMD:untie(playerid,params[]) {
	new giveplayerid;
	if(sscanf(params,"d",giveplayerid)) return SendClientMessage(playerid, CWHITE, "Використайте: /untie [playerid]");
	else if(!IsPlayerConnected(giveplayerid)) return SendError(playerid,not_id);
	else if(!IsPlayerStream(5.0, playerid, giveplayerid)) return SendError(playerid, "Гравець далеко від вас.");
	else if(TI[playerid][tTied])  return SendError(playerid, "Ви зв'язані.");
	else if(!TI[giveplayerid][tTied]) return SendError(playerid, "Гравець не зв'язаний.");
	else if(giveplayerid == playerid)  return SendError(playerid,not_id);
	new string[128];
	format(string, sizeof(string), "%s розв'язав %s.", player_name[playerid],player_name[giveplayerid]);
	SendStreamMessage(30.0, playerid, string, 0xE75480FF);
	TogglePlayerControllable(giveplayerid, 1);
	TI[giveplayerid][tTied] = false;
	return 1;
}
CMD:giveradio(playerid,params[]) {
	new giveplayerid;
	if(!IsAMafia(playerid)) return SendError(playerid, "Ви не мафіозі.");
	if(PI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 рангу.");
	else if(sscanf(params,"d",giveplayerid))return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /giveradio [playerid]");
	else if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	else if (!IsPlayerStream(5.0, playerid, giveplayerid)) return SendError(playerid, "Гравець далеко від вас.");
	else if(giveplayerid == playerid) return 1;
	else if(!GetPVarInt(giveplayerid,"takeradio")) return SendError(playerid, "У гравця не відбирали рацію.");
	new string[128];
	format(string, sizeof(string), "%s повернув вам рацію.", player_name[playerid]);
	SendClientMessage(giveplayerid, 0x6ab1ffaa, string);
	DeletePVar(giveplayerid,"takeradio");
	format(string, sizeof(string), "%s повернув рацію %s.", player_name[playerid],player_name[giveplayerid]);
	SendStreamMessage(30.0, playerid, string, 0xE75480FF);
	return 1;
}
CMD:takeradio(playerid,params[]) {
	new giveplayerid;
	if(!IsAMafia(playerid)) return SendError(playerid, "Ви не мафіозі.");
	if(PI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 рангу.");
	if(sscanf(params,"d",giveplayerid)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /takeradio [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(GetPVarInt(giveplayerid,"takeradio")) return SendError(playerid, "У гравця немає рації.");
	if(!IsPlayerStream(5.0, playerid, giveplayerid)) return SendError(playerid, "Гравець далеко від вас.");
	else if(!TI[giveplayerid][tTied]) return SendError(playerid, "Гравець не зв'язаний.");
	if(giveplayerid == playerid) return SendError(playerid, not_id);
	new string[128];
	format(string, sizeof(string), "%s забрав у вас рацію.", player_name[playerid]);
	SendClientMessage(giveplayerid, 0x6ab1ffaa, string);
	SetPVarInt(giveplayerid,"takeradio", true);
	format(string, sizeof(string), "%s забрав рацію у %s.", player_name[playerid],player_name[giveplayerid]);
	SendStreamMessage(30.0, playerid, string, 0xE75480FF);
	return 1;
}
CMD:bag(playerid,params[]) {
	if(!IsAMafia(playerid)) return SendError(playerid, "Ви не мафіозі.");
	if(PI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 рангу.");
	if(sscanf(params,"i",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /bag [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, not_id);
	if(playerid == params[0]) return SendError(playerid, not_id);
	if(GetPlayerDistanceToPlayer(playerid, params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Гравець дуже далеко");
	if(p_mh[params[0]]==PlayerText:-1) {
		p_mh[params[0]]=CreatePlayerTextDraw(params[0],0.000000,0.000000,"|");
		PlayerTextDrawBackgroundColor(params[0],p_mh[params[0]], 255);
		PlayerTextDrawFont(params[0],p_mh[params[0]], 1);
		PlayerTextDrawLetterSize(params[0],p_mh[params[0]], 0.500000, 49.799957);
		PlayerTextDrawColor(params[0],p_mh[params[0]], -1);
		PlayerTextDrawSetOutline(params[0],p_mh[params[0]], 0);
		PlayerTextDrawSetProportional(params[0],p_mh[params[0]], 1);
		PlayerTextDrawSetShadow(params[0],p_mh[params[0]], 1);
		PlayerTextDrawUseBox(params[0],p_mh[params[0]], 1);
		PlayerTextDrawBoxColor(params[0],p_mh[params[0]], 255);
		PlayerTextDrawTextSize(params[0],p_mh[params[0]],640.000000,0.000000);
		PlayerTextDrawShow(params[0],p_mh[params[0]]);
		SendOK(playerid,"Щоб зняти мішок, введіть "P"/bag"W" ще раз.");
	}
	else {
		PlayerTextDrawHide(params[0],p_mh[params[0]]);
		PlayerTextDrawDestroy(params[0],p_mh[params[0]]);
	}
	return 1;
}
CMD:givephone(playerid,params[]) {
	new giveplayerid;
	if(!IsAMafia(playerid)) return SendError(playerid, "Ви не мафіозі.");
	if(PI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 рангу.");
	else if(sscanf(params,"d",giveplayerid))return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /givephone [playerid]");
	else if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	else if(GetPlayerDistanceToPlayer(playerid, giveplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(giveplayerid)) return SendError(playerid, "Гравець дуже далеко.");
	else if(giveplayerid == playerid) return SendError(playerid, "Не можна повернути телефон самому собі.");
	else if(!GetPVarInt(giveplayerid,"takephone")) return SendError(playerid, "У гравця не відбирали телефон.");
	new string[128];
	format(string, sizeof(string), "%s повернув вам телефон.", player_name[playerid]);
	SendClientMessage(giveplayerid, 0x6ab1ffaa, string);
	DeletePVar(giveplayerid,"takephone");
	format(string, sizeof(string), "%s повернув телефон %s.", player_name[playerid],player_name[giveplayerid]);
	SendStreamMessage(30.0, playerid, string, 0xE75480FF);
	return 1;
}
CMD:takephone(playerid,params[]) {
	new giveplayerid;
	if(!IsAMafia(playerid)) return SendError(playerid, "Ви не мафіозі.");
	if(PI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 рангу.");
	if(sscanf(params,"d",giveplayerid))return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /takephone [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(GetPVarInt(giveplayerid,"takephone") || !PI[giveplayerid][pPhone]) return SendError(playerid, "У гравця немає телефону.");
	else if(GetPlayerDistanceToPlayer(playerid, giveplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(giveplayerid)) return SendError(playerid, "Гравець дуже далеко.");
	else if(!TI[giveplayerid][tTied]) return SendError(playerid, "Гравець не зв'язаний.");
	if(giveplayerid == playerid) return SendError(playerid, not_id);
	new string[128];
	format(string, sizeof(string), "%s забрав у вас телефон.", player_name[playerid]);
	SendClientMessage(giveplayerid, 0x6ab1ffaa, string);
	SetPVarInt(giveplayerid,"takephone", true);
	format(string, sizeof(string), "%s забрав телефон у %s.", player_name[playerid],player_name[giveplayerid]);
	SendStreamMessage(30.0, playerid, string, 0xE75480FF);
	return 1;
}
CMD:gag(playerid,params[]) {
	new giveplayerid;
	if(sscanf(params,"d",giveplayerid)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /gag [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(giveplayerid == playerid) return SendError(playerid, not_id);
	if(!TI[giveplayerid][tTied]) return SendError(playerid, "Гравець не зв'язаний.");
	if(TI[playerid][tTied]) return SendError(playerid, "Ви зв'язані.");
	if(GetPlayerDistanceToPlayer(playerid, giveplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(giveplayerid)) return SendError(playerid, "Гравець дуже далеко.");
	new string[128];
	if(TI[giveplayerid][tGag]) {
		TI[giveplayerid][tGag] = false;
		TI[giveplayerid][tGagTime] = 0;
		format(string, sizeof(string), "%s витягнув кляп з рота гравця %s.", player_name[playerid],player_name[giveplayerid]);
		SendStreamMessage(30.0, playerid, string, 0xE75480FF);
	}
	else {
		if(!IsAMafia(playerid)) return SendError(playerid, "У вас немає доступу до цієї команди.");
		if(PI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 рангу.");
		TI[giveplayerid][tGag] = true;
		TI[giveplayerid][tGagTime] = 600;
		format(string, sizeof(string), "%s вставив кляп в рот гравцю %s.", player_name[playerid],player_name[giveplayerid]);
		SendStreamMessage(30.0, playerid, string, 0xE75480FF);
	}
	return 1;
}
alias:zone("gmap");
CMD:zone(playerid) {
	if(!IsAGang(playerid)) return SendError(playerid, "У вас немає доступу до цієї функції.");
	new total = 0,string[128];
	for(new i = 0; i < TOTALGZ; i++) {
		if(GZInfo[i][gFrakVlad] == PI[playerid][pMember]) total++;
	}
	format(string,sizeof(string),"Території під контролем: "P"%d.",total);
	SendOK(playerid,string);
	return 1;
}
CMD:gangtop(playerid) {
	if(!IsAGang(playerid)) return SendError(playerid, "У вас немає доступу до цієї функції.");
	ShowPlayerDialog(playerid,D_GANGTOP,DST, ""P"GANG TOP", ""P"1."W" За територіями\n"P"2."W" За графіті\n"P"3."W" Поточний рейтинг банди", "Обрати", "Закрити");
	return 1;
}
CMD:dipinfo(playerid) {
	if(!IsAGang(playerid)) return SendError(playerid, "У вас немає доступу до цієї функції.");
	dialog_diplom(playerid,false);
	return 1;
}
CMD:givekey(playerid, params[]) {
	if(!PI[playerid][pMember]) return SendError(playerid, "У вас немає доступу до цієї функції.");
	new giveplayerid;
	if(sscanf(params,"d",giveplayerid)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /givekey [playerid]");
	if(playerid == giveplayerid) return SendError(playerid, "Ви вказали свій ID.");
	if(IsAGang(playerid)) if(PI[playerid][pRank] < 5) return SendError(playerid, "Доступно з 3 рангу.");
	if(GetPlayerDistanceToPlayer(playerid, giveplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(giveplayerid)) return SendError(playerid, "Гравець дуже далеко.");
	if(TI[giveplayerid][tEnter][PI[playerid][pMember]]) {
		TI[giveplayerid][tEnter][PI[playerid][pMember]] = false;
		SendOK(giveplayerid,"У вас забрали перепустку.");
		return 1;
	}
	if(!TI[giveplayerid][tEnter][PI[playerid][pMember]]) {
		TI[giveplayerid][tEnter][PI[playerid][pMember]] = true;
		SendOK(giveplayerid,"Вам видали перепустку.");
		return 1;
	}
	return 1;
}
CMD:air(playerid) {
	if(!IsAGang(playerid) && !IsAMafia(playerid)) return SendError(playerid,"Ви не знаходитеся в банді чи мафії.");
	if(!LastAirDrop[airTime]) return SendError(playerid,"В данний момент не проходить захоплення AirDrop.");
	EnableGPSForPlayer(playerid,LastAirDrop[airPos][0],LastAirDrop[airPos][1],LastAirDrop[airPos][2]);
	SendInfo(playerid, "Місце розташування AirDrop позначено у вашому GPS.");
	return 1;
}
CMD:gpay(playerid, params[]) {
	if(!IsAGang(playerid) || !PI[playerid][pLeader]) return SendError(playerid, "У вас немає доступу до цієї функції.");
	if(sscanf(params, "d", params[0])) return SendError(playerid,"Використайте: /gpay [amount]");
	if(params[0] < 1 || params[0] > 100000) return SendError(playerid, "Від $1 і до $100.000.");
	new num = 0;
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(PI[i][pMember] != PI[playerid][pMember] || playerid == i) continue;
		num++;
	}
	if(num == 0) return SendError(playerid, "В організації нікого немає.");
	new string[128];
	format(string, sizeof(string), "\n\n"W"Ви дійсно хочете видати премію в розмірі "GREEN"$%d"W" членам вашої банди?\n\n", params[0]*num);
	ShowPlayerDialog(playerid, D_GANG_PAY, DSM, ""P"Видача премії", string, "Видати", "Скасувати");
	SetPVarInt(playerid, "prem_gang_money", params[0]);
	return 1 ;
}
CMD:endcapture(playerid)
{
	if(PI[playerid][pAdmin] < 4 || dostup[playerid] == 0) return 1;
	for (new i = 0; i < TOTALGZ; i++)
	{
		if(GZInfo[i][gTime] < 1) continue;
		new string[250];
		GZInfo[i][gNapad] = PI[playerid][pMember];
				
		capture_kd[GZInfo[i][gFrakVlad]] = 0;
		capture_kd[GZInfo[i][gNapad]] = 0;
		
		capture_war[PI[playerid][pMember]] = GZInfo[i][gFrakVlad];
		GZInfo[i][gTime] = 1;
		
		CountOnZone[GZInfo[i][gNapad]] = 0;
		CountOnZone[GZInfo[i][gFrakVlad]] = 0;
		format(string, 112, "Капт між %s і %s було зупинено адміністратором %s.",GFrac(PI[playerid][pMember]),GFrac(GZInfo[i][gFrakVlad]),player_name[playerid]);
		SendClientMessageToAll(COLOR_LIGHTRED, string);
		GangZoneFlashForAll(GZInfo[i][gID], GetGangColor(GZInfo[i][gNapad]));
		GZInfo[i][ZoneOnBattle] = 0;
		break;
	}
	return 1;
}
CMD:capture(playerid) {
	if(!IsAGang(playerid)) return SendError(playerid, "У вас немає доступу до цієї функції.");
	if(PI[playerid][pRank] < 5) return SendError(playerid, "Доступно з 5 рангу.");
	if(tmphour < 10 || tmphour > 23) return SendError(playerid, "Використовувати команду можна тільки з 10:00 до 23:00");
	if(tmpminute != 0) return SendError(playerid, "Почати захопленя теріторії можна на початку наступної години.");
	if(capture_kd[PI[playerid][pMember]] != 0) return SendError(playerid,"Ваша банда воює зараз або вже воювала за останню годину.");
	if(!IsPlayerInBandOnline(PI[playerid][pMember])) return SendError(playerid, "У вашій банді повинно бути не менше двох гравців.");
	new gang1 = -1;
	switch(PI[playerid][pMember]) {
	case fBALLAS: gang1 = MOROZ_BALLAS;
	case fVAGOS: gang1 = MOROZ_VAGOS;
	case fGROVE: gang1 = MOROZ_GROVE;
	case fAZTEC: gang1 = MOROZ_AZTECAS;
	case fRIFA: gang1 = MOROZ_RIFA;
	}
	if(gang1 != -1) {
		if(fracmoroz[gang1] > unix) {
			SendError(playerid, "Ваша банда заморожена.");
			return 1;
		}
	}
	for (new i = 0; i < TOTALGZ; i++)
	{
		if (PlayerToKvadrat(playerid, GZInfo[i][gCoords][0], GZInfo[i][gCoords][1], GZInfo[i][gCoords][2], GZInfo[i][gCoords][3]) && GZInfo[i][gFrakVlad] != PI[playerid][pMember] && GZInfo[i][ZoneOnBattle] == 0 && capture_kd[GZInfo[i][gFrakVlad]] == 0)
		{
			new string[250];
			if(PI[playerid][pMember] == GZInfo[i][gFrakVlad]) return SendError(playerid, "Ви не можете захоплювати свою територію.");
			if(i == 85 && black_prods[9] > unix) return SendError(playerid, "У цей момент війна за чорний ринок недоступна.");
			if(capture_kd[GZInfo[i][gFrakVlad]] == 1) return SendError(playerid,"Нападаюча банда воює зараз або вже воювала за останню годину.");
			if(f_diplomacy[PI[playerid][pMember] - 15][GZInfo[i][gFrakVlad] - 15] == dip_status_alliance) return SendError(playerid, "У вас з цією бандою союз.");
			if(f_diplomacy[PI[playerid][pMember] - 15][GZInfo[i][gFrakVlad] - 15] == dip_status_neutral) return SendError(playerid, "У вас з цією бандою нейтралітет.");
			if(!IsPlayerInBandOnline(GZInfo[i][gFrakVlad])) return SendError(playerid, "Члени банди, на яку Ви збираєтесь напасти, офлайн.");
			new gang = -1;
			switch(GZInfo[i][gFrakVlad]) {
			case fBALLAS: gang = MOROZ_BALLAS;
			case fVAGOS: gang = MOROZ_VAGOS;
			case fGROVE: gang = MOROZ_GROVE;
			case fAZTEC: gang = MOROZ_AZTECAS;
			case fRIFA: gang = MOROZ_RIFA;
			}
			if(gang != -1) {
				if(fracmoroz[gang] > unix) {
					SendError(playerid, "Банду яку ви хочете захопити - неможливо.");
					SendError(playerid, "Вона заморожена адміністрацією, чекайте на сповіщення в чаті, коли мороз буде знятий.");
					return 1;
				}
			}
			GZInfo[i][gNapad] = PI[playerid][pMember];
			
			capture_kd[GZInfo[i][gFrakVlad]] = 1;
			capture_kd[GZInfo[i][gNapad]] = 1;
			
			capture_war[PI[playerid][pMember]] = GZInfo[i][gFrakVlad];
			GZInfo[i][gTime] = 60*15;
			
			CountOnZone[GZInfo[i][gNapad]] = 0;
			CountOnZone[GZInfo[i][gFrakVlad]] = 0;
			format(string, 112, "%s(%s) почав захоплення терріторії банди %s.",GFrac(PI[playerid][pMember]),player_name[playerid],GFrac(GZInfo[i][gFrakVlad]));
			SendBand(COLOR_LIGHTRED,string);
			format(string, 144, "[A] Почався капт між бандами %s і %s.",GFrac(PI[playerid][pMember]),GFrac(GZInfo[i][gFrakVlad]));
			AdmMSG(COLOR_YELLOW, string);
			GangZoneFlashForAll(GZInfo[i][gID], GetGangColor(GZInfo[i][gNapad]));
			GZInfo[i][ZoneOnBattle] = 1;
			if(QuestProgress[playerid][22] < 5 && AcceptQuest[playerid][22] != 0) QuestProgress[playerid][22] ++,save_quest(playerid,22);
			if(QuestProgress[playerid][22] == 5 && AcceptQuest[playerid][22] != 0) {
				ShowPlayerDialog(playerid,DIALOG_NONE,DSM, "Виконання квесту",""W"Ви закінчили виконання квесту 'Завойовник'\n\t"NO"Квест можна завершити в списку квестів (/quest)","Закрити","");
			}
			break;
		}
	}
	return 1;
}
CMD:famsklad(playerid, params[]) {
	new fam = PI[playerid][pFamily]-1;
	if(!PI[playerid][pFamily]) return SendError(playerid, "Ви не є членом сім'ї.");
	if(!GetString(gFamily[fam][famOwner],player_name[playerid])) return SendError(playerid, "У вас немає доступу до цієї команди.");
	new str[9];
	if(gFamily[fam][famskladSt] == 0) gFamily[fam][famskladSt] = 1,str = "закрив";
	else gFamily[fam][famskladSt] = 0,str = "відкрив";
	static const f_str[] = "%s[%d] %s збереження сім'ї.";
	new string[sizeof(f_str) +1 + (-2 + MAX_PLAYER_NAME) + (-2 + 4) + (-2 + 9)];
	format(string,sizeof(string),f_str,player_name[playerid],playerid,str);
	FamMSG(fam+1,string);
	UpdateFamily(fam+1,"sklad_status",gFamily[fam][famskladSt]); 
	return 1;
}
CMD:warelock(playerid, params[]) {
	if((!IsAGang(playerid) && !IsAMafia(playerid) && !IsABikers(playerid)) || PI[playerid][pRank] < FI[PI[playerid][pMember]][fInviteRang]) return SendError(playerid, "У вас немає доступу до цієї команди.");
	new str[9];
	if(FI[PI[playerid][pMember]][fSklad] == 0) FI[PI[playerid][pMember]][fSklad] = 1,str = "відкрив";
	else FI[PI[playerid][pMember]][fSklad] = 0,str = "закрив";
	static const f_str[] = "[F] %s[%d] %s склад.";
	new string[sizeof(f_str) +1 + (-2 + MAX_PLAYER_NAME) + (-2 + 4) + (-2 + 9)];
	format(string,sizeof(string),f_str,player_name[playerid],playerid,str);
	SendFamilyMessage(PI[playerid][pMember],0x6ab1ffaaff,string);
	UpdateFraction(PI[playerid][pMember],"Sklad",FI[PI[playerid][pMember]][fSklad]);
	return 1;
}
CMD:sellgun(playerid,params[]) {
	new gunname[22];
	if(!IsAGang(playerid)) return SendError(playerid, "Ви не бандит.");
	if(PI[playerid][pJailTime]) return SendError(playerid, "Не можна використовувати у в'язниці.");
	if(TI[playerid][tDuel] != -1) return SendError(playerid, "Не можна використовувати на дуелях.");
	if(sscanf(params,"s[18]ddu",gunname,params[0],params[1],params[2])) {
		SendClientMessage(playerid, COLOR_WHITE,"Введіть: /sellgun [weaponname] [ammo] [price] [playerid]");
		SendClientMessage(playerid, COLOR_WHITE,"Введіть: /gunlist - Назва зброї і витрата матеріалів.");
		return 1;
	}
	if(!IsPlayerConnected(params[2])) return SendError(playerid, not_id);
	if(params[1] > 50000 || params[1] < 4) return SendError(playerid,"Неправильна вартість/патронів");
	if(params[0] <= 0 || params[0] > 10000) return SendError(playerid,"За раз можна робити до 10000 патронів");
	if(strcmp(gunname,"sdpistol", true) == 0) SetPVarInt(params[2],"gunid",23), SetPVarInt(params[2],"sell_gunmats",1);
	else if(strcmp(gunname,"deagle", true) == 0) SetPVarInt(params[2],"gunid",24), SetPVarInt(params[2],"sell_gunmats",3);
	else if(strcmp(gunname,"shotgun", true) == 0) SetPVarInt(params[2],"gunid",25), SetPVarInt(params[2],"sell_gunmats",3);
	else if(strcmp(gunname,"smg", true) == 0) SetPVarInt(params[2],"gunid",29), SetPVarInt(params[2],"sell_gunmats",2);
	else if(strcmp(gunname,"ak47", true) == 0) SetPVarInt(params[2],"gunid",30), SetPVarInt(params[2],"sell_gunmats",3);
	else if(strcmp(gunname,"m4", true) == 0) SetPVarInt(params[2],"gunid",31), SetPVarInt(params[2],"sell_gunmats",3);
	else if(strcmp(gunname,"rifle", true) == 0) SetPVarInt(params[2],"gunid",33), SetPVarInt(params[2],"sell_gunmats",5);
	else return SendError(playerid,"Невідома зброя, використайте /gunlist");
	if(PI[playerid][pMats] < (GetPVarInt(playerid,"sell_gunmats")*params[0])) return SendError(playerid,"У вас недостатньо матеріалів!");
	IDGZ[playerid] = GetIDGZ(playerid);
	if(IDGZ[playerid] == -1) return SendError(playerid, "Продавати зброю можна тільки в гетто");
	if(playerid == params[2])
	{
		GivePlayerWeapon(playerid,GetPVarInt(params[2],"gunid"),params[0]);
		PI[playerid][pMats] -= (GetPVarInt(playerid,"sell_gunmats")*params[0]);
		UpdatePlayerData(playerid,"pMats",PI[playerid][pMats]);
		return 1;
	}
	if(!ProxDetectorS(5.0, playerid, params[2])) return SendError(playerid, "Гравець повинен бути поруч з вами");
	SetPVarInt(playerid,"gunoffee",params[2]);
	SetPVarInt(params[2],"gunoffee",params[2]);
	SetPVarInt(params[2],"gunoffer",playerid);
	SetPVarInt(params[2],"gunprice",params[1]);
	SetPVarInt(params[2],"gunammo",params[0]);
	SetPVarInt(params[2],"sell_gunmats",GetPVarInt(params[2],"sell_gunmats")*params[0]);
	
	new string[512];
	format(string, sizeof(string), "Ви запропонували "P"%s"W" купити %s [%d] за "ORANGE"$%d",player_name[params[2]],gunname,params[0],params[1]);
	SendUse(playerid, string);
	format(string, sizeof(string), ""P"%s"W" запропонував Вам купити %s [%d] за "ORANGE"$%d",player_name[playerid],gunname,params[0],params[1]);
	SendUse(params[2], string);
	SendClientMessage(params[2],COLOR_BLUE,"Натисніть "YES"Y "BLUE"щоб погодитися "NO"N "BLUE"для відмови");
	return 1;
}
CMD:gunlist(playerid)
{
	if(!IsAGang(playerid)) return SendError(playerid, "Ви не бандит");
	ShowPlayerDialog(playerid,DIALOG_NONE,DSTH,"Збір зброї","Зброя\tВитрата матеріалів\nSdpistol\t1\nDeagle\t3\nShotgun\t3\nSMG\t2\nAK-47\t3\nM4A1\t3\nRifle\t5","Закрити","");
	return 1;
}
CMD:makegun(playerid) {
	if(!IsAMafia(playerid)) return SendError(playerid, "Ви не мафіозі");
	if(!PI[playerid][pMats]) return SendError(playerid, "У вас немає матеріалів");
	if(PI[playerid][pJailTime]) return SendError(playerid, "Не можна використовувати у в'язниці");
	if(TI[playerid][tDuel] != -1) return SendError(playerid, "Не можна використовувати на дуелях");
	new string[512];
	string = "Зброя\tБоєприпасів"W"\n";
	for(new i = 0; i < 7; i++) {
		format(string,sizeof(string),"%s%s\t%i\n",string,MakeGunData[i][mgunname],MakeGunData[i][mgunamount]);
	}
	ShowPlayerDialog(playerid,D_MAKEGUN,DSTH,"Збір зброї",string,"Обрати","Закрити");
	return 1;
}
CMD:bmarket(playerid) {
	if(!IsAGang(playerid) || PI[playerid][pRank] < FI[PI[playerid][pMember]][fInviteRang]) return SendError(playerid, "У вас немає доступу до цієї команди.");
	if(black_prods[0] != PI[playerid][pMember]) return SendError(playerid, "Чорний ринок контролює інша банда.");
	static const f_str[] = "Найменування\tЦіна\tСклад\n\
							Наркотики\t%d\t%d\n\
							Матеріали\t%d\t%d\n\
							Бронежилет\t%d\t%d\n\
							Військова форма\t%d\t%d\n";
	new string[sizeof(f_str) +2 + (-2 + 5) + (-2 + 5) + (-2 + 5) + (-2 + 5) + (-2 + 5) + (-2 + 5) + (-2 + 5) + (-2 + 5)];
	format(string,sizeof(string),f_str,black_prods[5],black_prods[1],black_prods[6],black_prods[2],black_prods[7],black_prods[3],black_prods[8],black_prods[4]);
	ShowPlayerDialog(playerid,D_BLACK_MARKET,DSTH,"Чорний ринок",string,"Обрати","Скасувати");
	return 1;
}
CMD:fmute(playerid, params[]) {
	if(PI[playerid][pRank] < FI[PI[playerid][pMember]][fInviteRang]) return SendError(playerid, "У вас немає доступу до цієї команди.");
	new id, time, reason[100], string[150];
	if(sscanf(params,"dds[100]", id, time, reason)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /fmute [playerid] [time] [reason]");
	if(IsAIP(reason)) return 1;
	if(time < 1 || time > 60) return SendError(playerid, "Видати заглушку не можна менш, ніж на 1 хвилину, та більше ніж, на 60 хвилин");
	if(PI[id][pMember] != PI[playerid][pMember]) return SendError(playerid, "Цей гравець не знаходиться в вашій організації");
	if(PI[id][pLeader] > 0) return SendError(playerid, "Ви не можете видати заглушку лідеру.");
	if(PI[id][pFmute]) return SendError(playerid, "У цього гравця вже є заглушка.");
	format(string,sizeof(string),"%s заглушив(ла) гравця %s на %d хвилин. Причина: %s.",player_name[playerid],player_name[id],time,reason);
	SendFamilyMessage(PI[playerid][pMember],COLOR_LIGHTRED, string);
	PI[id][pFmute] = time*60;
	UpdatePlayerData(id,"fmute",PI[id][pFmute]);
	return 1;
}
CMD:funmute(playerid, params[]) {
	if(PI[playerid][pRank] < FI[PI[playerid][pMember]][fInviteRang]) return SendError(playerid, "У вас немає доступу до цієї команди.");
	new id, string[150];
	if(sscanf(params,"d", id)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /funmute [playerid]");
	if(PI[id][pMember] != PI[playerid][pMember]) return SendError(playerid, "Цей гравець не знаходиться в вашій організації.");
	if(!PI[id][pFmute]) return SendError(playerid, "У цього гравця немає заглушки.");
	format(string,sizeof(string),"%s розглушив(ла) гравця %s.",player_name[playerid],player_name[id]);
	SendFamilyMessage(PI[playerid][pMember],COLOR_LIGHTRED, string);
	PI[id][pFmute] = 0;
	UpdatePlayerData(id,"fmute",PI[id][pFmute]);
	return 1;
}
CMD:sellzone(playerid,params[]) {
	if(!PI[playerid][pLeader]) return 1;
	IDGZ[playerid] = GetIDGZ(playerid);
	new giveplayerid;
	if(IDGZ[playerid] != -1) {
		new i = IDGZ[playerid];
		if(PI[playerid][pLeader] != GZInfo[i][gFrakVlad]) return SendError(playerid, "Ви не на своїй території.");
		else if(sscanf(params,"dd",giveplayerid,params[1])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /sellzone [playerid] [price]");
		else if(params[1] < 10000 || params[1] > 100000) return SendError(playerid, "Вартість повинна бути від $10.000 до $100.000.");
		else if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
		else if(!IsPlayerStream(5.0, playerid, giveplayerid)) return SendError(playerid, "Ви далеко від цього гравця.");
		else if(giveplayerid == playerid) return SendError(playerid, "Це й так ваша територія.");
		if(i == 97 || i == 93 || i == 41 || i == 0 || i == 24) return SendError(playerid, "Не можна продати спавн банди.");
		if(!PI[giveplayerid][pLeader]) return SendError(playerid, "Продаж територій доступний тільки лідерам банд.");
		new string[325];
		format(string, sizeof(string), "Ви запропонували "P"%s"W" купити територію за "ORANGE"$%d"W".",player_name[giveplayerid],params[1]);
		SendUse(playerid, string);
		format(string, sizeof(string), ""P"%s"W" запропонував вам купити територію за "ORANGE"$%d"W".",player_name[playerid],params[1]);
		SendUse(giveplayerid, string);
		SendClientMessage(giveplayerid,COLOR_BLUE,"Натисніть "YES"Y "BLUE"щоб погодитися, або "NO"N "BLUE"для відмови.");
		SetPVarInt(giveplayerid,"ZoneOffer", playerid + 1);
		SetPVarInt(giveplayerid,"ZonePrice", params[1]);
		SetPVarInt(giveplayerid,"sellzone", PI[playerid][pMember]);
	}
	return 1;
}
stock TextFind(const text[],const findtext[]) return strfind(text, findtext) != -1;
stock ValidChar(mailchar) {
	if((mailchar >= 'A' && mailchar <= 'Z') || (mailchar >= 'a' && mailchar <= 'z')
			|| (mailchar >= '0' && mailchar <= '9') || (mailchar == '-') || (mailchar == '_')
			|| (mailchar == '@') || (mailchar == '.')) return 1;
	return 0;
}
stock IsValidEmail(const email[]) {
	new bool:Succes = true;
	new bool:Good;
	for(new i; i < strlen(email); i++) {
		if(email[i] == '@') {
			if(!Good) Good = true;
			else {
				Good = false;
				break;
			}
		}
		if(!ValidChar(email[i])) Succes = false;
	}
	if(!Good) Succes = false;
	if(!TextFind(email,".ru") && !TextFind(email,".com") && !TextFind(email,".ua") && !TextFind(email,".su")) Succes = false;
	if(!TextFind(email,"@")) Succes = false;
	return Succes;
}
CB: OnPlayerDonateCheck(playerid, name[]) {
	new rows;
	cache_get_row_count(rows);
	if(!rows) return SendError(playerid, "Гравця не знайдено.");
	new credits;
	cache_get_value_int(0, "donatemoney", credits);
	SetPVarInt(playerid, "check_credits", credits);
	SetPVarString(playerid, "check_name", name);
	new query[256];
	mysql_format(connects, query, sizeof(query),"SELECT * FROM freekassa_payments WHERE account = '%s' AND status = 1 ORDER BY dateComplete DESC LIMIT 0,20;", name);
	mysql_tquery(connects, query, "unitpay_callback", "dd", playerid, 1);
	return 1;
}
CB: unitpay_callback(playerid, type) {
	switch(type) {
	case 0: {
			new rows;
			cache_get_row_count(rows);
			if(!rows) return SendError(playerid, "Історія поповнень відсутня.");
			new sum, datetime[30], str[1000];
			for(new i; i < rows; i++) {
				cache_get_value_index_int(i, 3, sum);
				cache_get_value_index(i, 6, datetime, 30);
				format(str, sizeof(str), "%s%s - %i %s\n", str, datetime, sum, (sum==1)?("UAH"):(sum<5)?("UAH"):("UAH"));
			}
			new string[1024];
			format(string, sizeof(string), "\
				"W"Стан рахунку:\t\t"GREEN"%i UAH\n\
				{3399FF}20 останніх поповнень"W"\n\n\
				%s\n\
				"ORANGE"Поповнити рахунок можна на "P"chiliad-rp.com",
			PI[playerid][pRouble], str);
			ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Інформація про поповнення", string, "Закрити", "");
		}
	case 1: {
			new rows;
			cache_get_row_count(rows);
			new name[MAX_PLAYER_NAME];
			GetPVarString(playerid,"check_name",name,MAX_PLAYER_NAME);
			DeletePVar(playerid,"check_name");
			if(!rows) {
				new string[512];
				format(string, sizeof(string), "\
					"W"Нік:\t\t\t\t%s\n\
					"W"Стан рахунку:\t\t"GREEN"%i UAH\n\
					{AFAFAF}Історія поповнень відсутня\n",
				name, GetPVarInt(playerid, "check_credits"));
				ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Інформація про поповнення", string, "Закрити", "");
				DeletePVar(playerid, "check_credits");
				return 1;
			}
			new sum, datetime[30], str[1000];
			for(new i; i < rows; i++) {
				cache_get_value_index_int(i, 3, sum);
				cache_get_value_index(i, 6, datetime, 30);
				format(str, sizeof(str), "%s%s - %i %s\n", str, datetime, sum, (sum==1)?("UAH"):(sum<5)?("UAH"):("UAH"));
			}
			new string[1024];
			format(string, sizeof(string), "\
				"W"Нік:\t\t\t\t%s\n\
				"W"Стан рахунку:\t\t"GREEN"%i UAH\n\
				{3399FF}20 останніх поповнень"W"\n\n\
				%s",
			name, GetPVarInt(playerid, "check_credits"), str);
			ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Інформація про поповнення", string, "Закрити", "");
			DeletePVar(playerid, "check_credits");
		}
	}
	return 1;
}
CB: load_online_today(playerid) {
	new rows;
	cache_get_row_count(rows);
	if(!rows) {
		gOnlinePlayer[playerid][0] = 0;
		gOnlinePlayerAFK[playerid][0] = 0;
	}
	else {
		cache_get_value_index_int(0,3,gOnlinePlayer[playerid][0]);
		cache_get_value_index_int(0,4,gOnlinePlayerAFK[playerid][0]);
	}
	return 1;
}
CB: load_online_yesterday(playerid) {
	new rows;
	cache_get_row_count(rows);
	if(!rows) {
		gOnlinePlayer[playerid][1] = 0;
		gOnlinePlayerAFK[playerid][1] = 0;
	}
	else {
		cache_get_value_index_int(0,3,gOnlinePlayer[playerid][1]);
		cache_get_value_index_int(0,4,gOnlinePlayerAFK[playerid][1]);
	}
	return 1;
}
CMD:quest(playerid) {
	ShowPlayerDialog(playerid,D_MENU_QUEST,DSL,""P"Завдання",""P"1."W" Активні завдання\n"P"2."W" Початкові квести для новачків\n"P"3."W" Щоденні квести\n"P"4."W" Організаційні квести","Обрати","Скасувати");
