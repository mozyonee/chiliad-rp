					ShowPlayerDialog(playerid,D_BANK_OPLATA_HOUSE,DSI, ""P"Оплата будинку",string,"Оплатити","Скасувати");
				}
			case 5: {
					if(!PI[playerid][pBusiness]) return SendError(playerid, "У Вас немає бізнесу");
					new bizz = PI[playerid][pBusiness]-1,oplata, day;
					oplata = floatround(gBusiness[bizz][bizzSellPrice]*0.1/100);
					day = (gBusiness[bizz][bizzDay]-gettime())/86400;
					static const f_str[] = "\n\n"W"Бізнес:"P" %s\n\n"W"Введіть кількість днів, на яку ви хочете продовжити оренду бізнесу:\nПримітка: "ORANGE"1"W" день = "GREEN"$%d"W" | Оплачено на "P"%d"W" днів\n\n";
					new string[sizeof(f_str) +1 + (-2 + 30)];
					format(string,sizeof(string),f_str,gBusiness[bizz][bizzName], oplata, day);
					ShowPlayerDialog(playerid,D_BANK_OPLATA_BIZZ,DSI, ""P"Оплата бізнесу",string,"Оплатити","Скасувати");
				}
			case 6: {
					if(!GetPlayerVehicles(playerid)) return SendError(playerid, "У Вас немає будинку на колесах!");
					new day = (PlayerTrailer[playerVehicleID[playerid]][carDay]-gettime())/86400;
					static const f_str[] = "\n\n"W"Введіть кількість днів, на яку ви хочете продовжити оренду будинку на колесах:\nПримітка: "ORANGE"1"W" день = "GREEN"5000"W" | Оплачено на "P"%d"W" днеднів\n\n";
					new string[sizeof(f_str) +1 + (-2 + 17)];
					format(string,sizeof(string),f_str,day);
					ShowPlayerDialog(playerid,D_BANK_OPLATA_DNK,DSI, ""P"Оплата будинку на колесах",string,"Оплатити","Скасувати");
				}
			case 7: GetTickets(playerid);
			}
		}
	case dProdGet: {
			if (!response) return 1;
			if (GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
			new price = strval(inputtext) / 10;
			if (strval(inputtext) < 1000 || strval(inputtext) > 2000)
			{
				if (GetVehicleModel(GetPlayerVehicleID(playerid)) != 403)
				{
					return ShowPlayerDialog(playerid, dProdGet, DSI, ""P"Купівля бензину", "\n\n"W"Введіть кількість літрів для купівлі:\nПримітка: "ORANGE"10"W" літр = "GREEN"$1\n\n"NO"*"G" Від 1000 до 2000\n\n", "Купити", "Скасувати");
				}
				else return ShowPlayerDialog(playerid, dProdGet, DSI, ""P"Купівля продуктів", "\n\n"W"Введіть кількість продуктів для купівлі:\nПримітка: "ORANGE"10"W" продукт = "GREEN"$1\n\n"NO"*"G" Від 1000 до 2000\n\n", "Купити", "Скасувати");
			}
			if (GetPVarInt(playerid, "count_prod") + strval(inputtext) > 2000)
			{
				if (GetVehicleModel(GetPlayerVehicleID(playerid)) != 403)
				{
					return ShowPlayerDialog(playerid, dProdGet, DSI, ""P"Купівля бензину", "\n\n"W"Введіть кількість літрів для купівлі:\nПримітка: "ORANGE"10"W" литр = "GREEN"$1\n\n"NO"*"G" У Ваш автомобіль стільки не влізе. Максимум 2000\n\n", "Купити", "Скасувати");
				}
				else return ShowPlayerDialog(playerid, dProdGet, DSI, ""P"Купівля продуктів", "\n\n"W"Введіть кількість продуктів для купівлі:\nПримітка: "ORANGE"10"W" продукт = "GREEN"$1\n\n"NO"*"G" У Ваш автомобіль стільки не влізе. Максимум 2000\n\n", "Купити", "Скасувати");
			}
			if (GetPlayerMoneyEx(playerid) < price) return SendError(playerid, "Недостатньо коштів");
			GiveMoney(playerid, -price, "покупка продуктів(розвізник)");
			new string[128];
			if (GetVehicleModel(GetPlayerVehicleID(playerid)) != 403)
			{
				format(string, sizeof(string), "Ви придбали: "P"%d"W" од. продуктів за "ORANGE"$%d"W". Очікуйте завантаження продуктів в автомобіль", strval(inputtext), price);
				SendUse(playerid, string);
				SetTimerEx("LoadProd", 250, false, "i", playerid);
			}
			else
			{
				format(string, sizeof(string), "Ви придбали: "P"%d"W" л. бензину за "ORANGE"$%d"W". Цистерна з бензином вже готова для транспортування", strval(inputtext), price);
				SendUse(playerid, string);
				SetTimerEx("LoadProd", 250, false, "i", playerid);
			}
			SetPVarInt(playerid, "count_prod2", strval(inputtext));
			return 1;
		}
	case dProdSell: {
			if (!response) return 1;
			new bizid = GetPVarInt(playerid, "prod_id") - 1;
			new prod = GetPVarInt(playerid, "count_prod");
			new price = strval(inputtext);
			new string[286], str[10];
			switch (GetVehicleModel(GetPlayerVehicleID(playerid)))
			{
			case 456: str = "продуктів";
			case 403: str = "палива";
			}
			if (price < 1 || price > 2000)
			{
				format(string, sizeof(string), ""W"Бізнес: "P"%s\n\n\
				"W"Необхідно %s: "O"%d\n\
				"W"Доступно для розвантаження: "O"%d\n\
				"W"Введіть к-сть %s для продажу:\n\n\
				"NO"*"G" Від 1 од до 2000 од",
				gBusiness[bizid][bizzName], str, gBusiness[bizid][bizzProdOrder], prod, str);
				return ShowPlayerDialog(playerid, dProdSell, DSI, ""P"Доставка", string, "Продати", "Скасувати");
			}
			if (gBusiness[bizid][bizzProdOrder] < price)
			{
				format(string, sizeof(string), ""W"Бізнес: "P"%s\n\n\
				"W"Необхідно %s: "O"%d\n\
				"W"Доступно для розвантаження: "O"%d\n\
				"W"Введіть к-сть %s для продажу:\n\n\
				"NO"*"G" Власник бізнесу не замовляв стільки %s"
				, gBusiness[bizid][bizzName], str, gBusiness[bizid][bizzProdOrder], prod, str, str);
				return ShowPlayerDialog(playerid, dProdSell, DSI, ""P"Доставка", string, "Продати", "Скасувати");
			}
			if (prod < price)
			{
				format(string, sizeof(string), ""W"Бізнес: "P"%s\n\n\
				"W"Необхідно %s: "O"%d\n\
				"W"Доступно для розвантаження: "O"%d\n\
				"W"Введіть к-сть %s для продажу:\n\n\
				"NO"*"G" У Вашій машині немає стільки %s"
				, gBusiness[bizid][bizzName], str, gBusiness[bizid][bizzProdOrder], prod, gBusiness[bizid][bizzProdOrder], str, str);
				return ShowPlayerDialog(playerid, dProdSell, DSI, ""P"Доставка", string, "Продати", "Скасувати");
			}
			GiveMoney(playerid,gBusiness[bizid][bizzProdOrderPrice] * price, "оплата розвізнику");
			gBusiness[bizid][bizzProdOrder] -= price;
			gBusiness[bizid][bizzProduct] += price;
			format(string, sizeof(string), ""W"Бізнес: "P"%s\n\n\
				"W"Продуктів доставлено: "O"%d\n\
				"W"Необхідно продуктів: "O"%d\n\
				"W"Зароблено: "GREEN"$%d",
			gBusiness[bizid][bizzName], price, gBusiness[bizid][bizzProdOrder],gBusiness[bizid][bizzProdOrderPrice] * price
			);
			ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Доставлено", string, "Закрити", "");
			if (gBusiness[bizid][bizzProdOrder] == 0) gBusiness[bizid][bizzProdOrderPrice] = 0;
			SaveBusiness(bizid);
			DeletePVar(playerid, "prod_id");
			SetPVarInt(playerid, "count_prod", GetPVarInt(playerid, "count_prod") - price);
			format(string, sizeof(string), "Завантажено: "GREEN"%d/2000\n"W"Бізнес: "GREEN"Відсутній", GetPVarInt(playerid, "count_prod"));
			UpdateDynamic3DTextLabelText(gPlayerProdText[playerid], -1, string);
			UpdateBusinessText(bizid);
			if (gPlayerProdCP[playerid] != -1) DestroyDynamicCP(gPlayerProdCP[playerid]);
			return 1;
		}
	case D_EAT_BURGER: {
			if(!response) return 1;
			switch(listitem) {
			case 0:
				{
					if(GetPVarInt(playerid,"burger_job")) {
						A_DestroyVehicle(GetPVarInt(playerid,"burger_vehid"));
						DeletePVar(playerid,"burger_job");
						DeletePVar(playerid,"burger_vehid");
						DeletePVar(playerid,"check_pizza");
						A_SetPlayerSkin(playerid,PI[playerid][pSkin]);
						SendClientMessage(playerid,COLOR_WHITE,"Ви звільнилися з роботи.");
						return 1;
					}
					A_SetPlayerSkin(playerid, 155);
					SetPVarInt(playerid,"burger_job",1);
					SendClientMessage(playerid,COLOR_WHITE,"Ви влаштувалися на роботу кур'єра. Щоб розпочати роботу, візьмість доступне замовлення.");
				}
			case 1: {
					if(!GetPVarInt(playerid,"burger_job")) return SendError(playerid,"Ви не працюєте кур'єром.");
					if(GetPVarInt(playerid,"burger_vehid") != 0) return SendError(playerid,"Ви вже орендували мопед.");
					new car = A_CreateVehicle(462, 782.1208,-1630.2461,12.9637,270.2442, 6, 15, -1, VEHICLE_TYPE_PLAYER);
					SetPVarInt(playerid,"burger_vehid",car);
					PutPlayerInVehicle(playerid, car, 0);
					SendClientMessage(playerid,COLOR_WHITE,"Ви орендували транспорт. Щоб відкрити чи закрити мопед, введіть "P"/lock"W".");
				}
			}
		}
	case D_VACANCY: {
			if (!response) return 1;
			new vacancies = 0;
			for (new i = 0; i < 14; i++)
			{
				if (VacancyInfo[i][VacancyStatus]) vacancies++;
			}
			if (PI[playerid][pMember] && PI[playerid][pRank] >= FI[PI[playerid][pMember]][fInviteRang])
			{
				if (VacancyInfo[vacancies][VacancyFraction] == PI[playerid][pMember] && VacancyInfo[vacancies][VacancyStatus] == true) return SendError(playerid, "Вакансія вашої організації вже додана. Спочатку видаліть стару.");
				else if (listitem == 0 && vacancies == 0) return ShowPlayerDialog(playerid, D_VACANCY_2, DSI, ""P"Додати вакансію", "\n\n"W"Вкажіть критерії для прийому у вашу органзацію:\n\n", "Прийняти", "Скасувати");
				else if (listitem == vacancies && vacancies != 14) return ShowPlayerDialog(playerid, D_VACANCY_2, DSI, ""P"Додати вакансію", "\n\n"W"Вкажіть критерії для прийому у вашу органзацію:\n\n", "Прийняти", "Скасувати");
			}
			if (vacancies == 0) return SendError(playerid, "Зараз немає доступних вакансій.");
			if (listitem == vacancies + 1) pc_cmd_vacancy(playerid);
			new items = 0;
			for (new i = 0; i < 14; i++)
			{
				if (VacancyInfo[i][VacancyStatus] == true) items++;
				if (items - 1 == listitem)
				{
					new string[63 + 28 + 100];
					format(string, sizeof(string), ""W"Додав: "P"%s\n"W"Організація: "P"%s\n"W"Критерії: "P"%s\n",VacancyInfo[i][VacancyCreator], FI[VacancyInfo[i][VacancyFraction]][fName], VacancyInfo[i][VacancyText]);
					if (VacancyInfo[i][VacancyFraction] != PI[playerid][pLeader]) return ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Вакансія", string, "Закрити", "");
					return ShowPlayerDialog(playerid, D_VACANCY_3, DSM, ""P"Вакансія", string, "Видалити", "Скасувати");
				}
			}
		}
	case D_VACANCY_2: {
			if (!response) return 1;
			new text[120];
			if (sscanf(inputtext, "s[110]", text) || strlen(inputtext) > 110) return ShowPlayerDialog(playerid, D_VACANCY_2, DSI, ""P"Додати вакансію", "\n\n"W"Вкажіть критерії для прийому у вашу органзацію:\n\n"NO"*"G" Не більше 120 символів", "Прийняти", "Скасувати");
			for (new i = 0; i < 14; i++)
			{
				if (VacancyInfo[i][VacancyStatus] == false)
				{
					VacancyInfo[i][VacancyText] = text;
					VacancyInfo[i][VacancyFraction] = PI[playerid][pMember];
					VacancyInfo[i][VacancyStatus] = true;
					strmid(VacancyInfo[i][VacancyCreator], player_name[playerid], 0, 24);
					SendOK(playerid, "Вакансія успішно додана.");
					return pc_cmd_vacancy(playerid);
				}
			}
			return pc_cmd_vacancy(playerid);
		}
	case D_VACANCY_3: {
			if (!response) return pc_cmd_vacancy(playerid);
			for (new i = 0; i < 14; i++)
			{
				if (VacancyInfo[i][VacancyFraction] == PI[playerid] [pLeader])
				{
					VacancyInfo[i][VacancyStatus] = false;
					strmid(VacancyInfo[i][VacancyCreator], "-", 0, 24);
					return SendOK(playerid, "Вакансія успішно видалена.");
				}
			}
		}
	case D_MENU_QUEST: {
			if(!response) return 1;
			switch(listitem) {
			case 0: {
					new num = 0;
					STRING_GLOBAL[0] = EOS;
					for(new i ; i < MAX_QUESTS;i++)
					{
						if(AcceptQuest[playerid][i] != 0 && QuestProgress[playerid][i]!=100) {
							if(QuestProgress[playerid][i]<QI[i][LastProgress]) format(STRING_GLOBAL,sizeof(STRING_GLOBAL),"%s\n"W"%s [%d/%d]\n",STRING_GLOBAL,QI[i][QuestName],QuestProgress[playerid][i],QI[i][LastProgress]);
							else if(QuestProgress[playerid][i]==100) format(STRING_GLOBAL,sizeof(STRING_GLOBAL),"%s\n"W"%s ["NO"Виконано"W"]\n",STRING_GLOBAL,QI[i][QuestName]);
							else format(STRING_GLOBAL,sizeof(STRING_GLOBAL),"%s\n"W"%s ["P"Можна завершити"W"]\n",STRING_GLOBAL,QI[i][QuestName]);
