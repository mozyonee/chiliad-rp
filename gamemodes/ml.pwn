	new string[sizeof(f_str)];
	format(string,sizeof(string),"%s",f_str);
	if(sscanf(params,"i",id)) {
		ShowPlayerDialog(playerid,D_ANIM,DSL, ""P"Список анімацій", string, "Обрати", "Скасувати");
