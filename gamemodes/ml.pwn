					slot_car = i;
					break;
				}
				if(slot_car == -1) return SendError(playerid, "У вас немає вільних місць під транспорт.");
				if(PI[playerid][pCash] < car_cena) {
					SendError(playerid, "У вас недостатньо грошей готівкою.");
