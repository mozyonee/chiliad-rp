					SendInfo(playerid, "Робочий день завершено.");
					SetPlayerColor(playerid, TEAM_HIT_COLOR);
					start_work[playerid] = 0;
					A_SetPlayerSkin(playerid,PI[playerid][pSkin]);
					SetArmour(playerid, 0);
