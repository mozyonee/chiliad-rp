CB: bl_callback_3(playerid, names[]) {
	new rows, sql_string[128];
	cache_get_row_count(rows);
	if(!rows) return SendError(playerid, "Гравець не знаходиться в чорном списку сім'ї.");
	mysql_format(connects, sql_string, sizeof(sql_string),"DELETE FROM `family_blacklist` WHERE `bl_name` = '%s'",names);
	mysql_tquery(connects, sql_string,"","");
	SendOK(playerid,"Ви винесли гравця з ЧС.");
	return 1;
}
CB: bl_callback_1(playerid, names[]) {
	new rows, sql_string[128];
	cache_get_row_count(rows);
	if(!rows) return SendError(playerid, "Гравець не знаходиться в чорном списку організації.");
	
	mysql_format(connects, sql_string, sizeof(sql_string),"DELETE FROM `fractions_blacklist` WHERE `bl_name` = '%s'",names);
	mysql_tquery(connects, sql_string,"","");
	
	SendOK(playerid,"Ви винесли гравця з ЧС.");
	return 1;
}
CB: bl_callback_family(playerid, targetid)
{
	new rows, sql_string[200];
	cache_get_row_count(rows);
	new fam = PI[playerid][pFamily] - 1;
	if(rows) return SendError(playerid, "Гравець вже знаходиться у чорном списку сім'ї.");
	mysql_format(connects, sql_string, sizeof(sql_string),"INSERT INTO `family_blacklist` (`bl_id`,`bl_family`,`bl_name`,`bl_reason`) VALUES ('%d','%d','%s','%s')",PI[targetid][pID], PI[playerid][pFamily], player_name[targetid], bl_reason[playerid]);
	mysql_tquery(connects, sql_string);
	format(sql_string, sizeof(sql_string), "%s заніс вас в чорний список сім'ї %s. Причина: %s", player_name[playerid], gFamily[PI[playerid][pFamily]-1][famName], bl_reason[playerid]);
	SendClientMessage(targetid, COLOR_LIGHTRED, sql_string) ;
	
	PI[targetid][pFamily] = 0;
	UpdatePlayerData(targetid,"family",0);
	PI[targetid][pFamRank] = 0;
	UpdatePlayerData(targetid,"pFamRank",0);
	
	format(sql_string, sizeof(sql_string), "%s заніс %s в чорний список %s. Причина: %s", player_name[playerid], player_name[targetid], gFamily[PI[playerid][pFamily]-1][famName], bl_reason[playerid]);
	FamMSG(fam+1,sql_string);
	return 1;
}
CB: bl_callback(playerid, targetid)
{
	new rows, sql_string[200];
	cache_get_row_count(rows);
	if(rows) return SendError(playerid, "Гравець вже знаходиться у чорному списку організації.");
	
	mysql_format(connects, sql_string, sizeof(sql_string),"INSERT INTO `fractions_blacklist` (`bl_id`,`bl_fraction`,`bl_name`,`bl_reason`) VALUES ('%d','%d','%s','%s')",PI[targetid][pID], PI[playerid][pMember], player_name[targetid], bl_reason[playerid]);
	mysql_tquery(connects, sql_string);
	
	format(sql_string, sizeof(sql_string), "%s заніс вас в чорний список %s. Причина: %s", player_name[playerid], FI[PI[playerid][pMember]][fName], bl_reason[playerid]);
	SendClientMessage(targetid, COLOR_LIGHTRED, sql_string) ;
	format(sql_string, sizeof(sql_string), "%s заніс %s у чорний список %s. Причина: %s", player_name[playerid], player_name[targetid], FI[PI[playerid][pMember]][fName], bl_reason[playerid]);
	SendFamilyMessage(PI[playerid][pMember], COLOR_LIGHTRED, sql_string);
	add_jobinfo(targetid,"звільнення + чс");
	PI[targetid][pAdvert] = 0;
	UpdatePlayerData(targetid,"Advert", 0);
	PI[targetid][pMember] = 0;
	PI[targetid][pRank] = 0;
	PI[targetid][pFracSkin] = 0;
	PI[targetid][pLeader] = 0;
	PI[targetid][pMedHeal] = 0;
	UpdatePlayerData(targetid,"MedHeal",0);
	SetPlayerColor(targetid, TEAM_HIT_COLOR);
	if(PI[targetid][pHouse] > 0) PI[targetid][pSpawn] = 1;
	else PI[targetid][pSpawn] = 0;
	UpdatePlayerData(targetid,"pModel",PI[targetid][pFracSkin]);
	UpdatePlayerData(targetid,"pMember",PI[targetid][pMember]);
	UpdatePlayerData(targetid,"pLeader",PI[targetid][pLeader]);
	UpdatePlayerData(targetid,"spawn",PI[targetid][pSpawn]);
	UpdatePlayerData(targetid,"pRank",PI[targetid][pRank]);
	skin_player(targetid);
	WriteLog(LOG_UVAL,player_name[playerid],player_name[targetid],"звільнення + чс");
	return 1;
}
CB: namestore_callback(playerid) {
	new rows;
	cache_get_row_count(rows);
	if(!rows) return SendError(playerid, "Цей гравець не зареєстрований на сервері.");
	new db_increment;
	cache_get_value_int(0,"pID",db_increment);
	new query[110];
	mysql_format(connects, query, sizeof(query),"SELECT * FROM `nickname_history` WHERE `nh_owner` = '%d'", db_increment);
	mysql_tquery(connects, query, "_namestore_callback", "i", playerid);
	return 1 ;
}
CB: _namestore_callback(playerid) {
	new rows;
	cache_get_row_count(rows);
	if(!rows) return SendError(playerid, "Історія зміни нікнейму цього гравця пуста.");
	
	new string[1024];
	strcat(string, ""P"# Старий нік\t"P"Новий нік\t"P"Дата зміни\n"W"");
	for(new j = 0; j < rows; j ++) {
		new oldname[MAX_PLAYER_NAME],
		newname[MAX_PLAYER_NAME],
		dates[20],
		str[68];
		
		cache_get_value(j,"nh_oldname",oldname, MAX_PLAYER_NAME);
		cache_get_value(j,"nh_newname",newname, MAX_PLAYER_NAME);
		cache_get_value(j,"nh_date",dates, 20);
		format(str, sizeof(str), "%d. %s\t%s\t%s\n",j+1, oldname, newname, dates);
		strcat(string, str);
	}	
	ShowPlayerDialog(playerid, DIALOG_NONE, DSTH, ""P"Іторія зміни нікнейму", string, "Закрити", "");
	return 1 ;
}
CMD:donate(playerid) {
	new head[100];
	format(head,sizeof(head),""P"Донат. Ваш баланс: %d UAH",PI[playerid][pRouble]);
	ShowPlayerDialog(playerid, D_DONATE, DSTH, head, ""W"Опис\t"W"Вартість\nВнутрішньоігрова валюта\t(1 UAH = $2.000)\nЗміна ігрового нікнейму\t20 UAH\nПреміум-акаунт (на 2 тижня)\t200 UAH\nПреміум-акаунт (на 4 тижня)\t350 UAH\nПреміум-акаунт (на 3 тижня)\t700 UAH\nАнулювати варн\t50 UAH\nЕлітний номер телефона\t250 UAH\nПідвищити навички бойових мистецтв\t200 UAH\nПідвищити навички володіння зброєю\t300 UAH\nІгрові комплекти\nУнікальний скін\t250 UAH\nКомплект лицензій\t70 UAH\nУнікальні аксесуари\nКейси\tВід 30 UAH\nРулетка\t150 UAH\nОновити баланс", "Обрати", "Закрити");
	return 1;
}
CMD:label(playerid) {
	if(GetPVarInt(playerid,"hrieltor")) {
		new houseid = GetPVarInt(playerid,"hrieltor")-1;
		EnableGPSForPlayer(playerid,gHouses[houseid][houseX], gHouses[houseid][houseY], gHouses[houseid][houseZ]);
		SendUse(playerid,"Ви встановили мітку на вашій карті.");
		SendUse(playerid,"Для відключення мітки введіть: "W"/gps.");
	}
	else if(GetPVarInt(playerid,"bizzrielor")) {
		new bizzid = GetPVarInt(playerid,"bizzrielor")-1;
		EnableGPSForPlayer(playerid,gBusiness[bizzid][bizzX], gBusiness[bizzid][bizzY], gBusiness[bizzid][bizzZ]);
		SendUse(playerid,"Ви встановили мітку на вашій карті.");
		SendUse(playerid,"Для відключення мітки введіть: "W"/gps.");
	}
	return 1;
}
CMD:gps(playerid){
	if(GetPlayerInterior(playerid) > 0) return SendError(playerid, "Не можна використовувати у приміщенні.");
	if(GetPVarInt(playerid,"route")) return SendError(playerid, "Спочатку закінчіть роботу водія автобуса.");
	if(GetPVarInt(playerid,"WaitExam")) return SendError(playerid, "Неможливо під час здачі екзамена.");
	if(GetPVarInt(playerid,"check_job_cleaner")) return SendError(playerid, "Неможливо під час работи мийщика доріг.");
	if(GetPVarInt(playerid,"RaceCP")) return SendError(playerid, "Неможливо використовувати в цей момент.");
	if(gpss[playerid]) DisablePlayerRaceCheckpoint(playerid),gpss[playerid] = 0;
	static const f_str[] = ""CS"1."W" Громадські місця\n\
							"CS"2."W" Роботи\n\
							"CS"3."W" Оренда транспортного засобу\n\
							"CS"4."W" Органзації\n\
							"CS"5."W" Автосалони і тюнінги\n\
							"CS"6."W" Бізнеси\n\
							"CS"7."W" Багатоквартирні будинки\n\
							"CS"8."W" Центральний ринок\n\
							"CS"9."W" Сімейний центр\n\
							"CS"10."W" Розваги\n\
							"CS"11."W" АЗС\n\
							"CS"12."W" Різне";
	
	new string[sizeof(f_str)];
	format(string,sizeof(string),"%s",f_str);
	ShowPlayerDialog(playerid, D_GPS, DSL, ""CS"GPS", string, "Обрати", "Скасувати");
	return 1;
}
