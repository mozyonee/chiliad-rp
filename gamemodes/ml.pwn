				format(string,sizeof(string),""W"Вартість входа "GREEN"$%d",gBusiness[businessid][bizzEnter]);
				ShowPlayerDialog(playerid,D_BIZZ_ENTERS,DSM, ""P"Бізнес",string,"Увійти","Скасувати");
				return 1;
			}
