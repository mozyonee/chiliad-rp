CMD:buyfueling(playerid) {
	new i = GetNearestTrunckFuel(playerid);
	if(i == -1) return SendError(playerid, "Ви повинні бути на АЗС.");
	SetPVarInt(playerid,"bfillingid",i);
	new string[128];
	if(!gBusiness[i][bizzOwnerID]) {
		format(string,sizeof(string),""W"Ця АЗС продається за "ORANGE"$%d",gBusiness[i][bizzSellPrice]);
		ShowPlayerDialog(playerid,D_BIZZ_BUY_FILL,DSM, ""P"Бізнес",string,"Купити","Скасувати");
	}
	else SendError(playerid, "Ця АЗС вже куплена кимось.");
	return 1;
}
CMD:p(playerid) {
	if(TI[playerid][tPhoneOnline]) return SendError(playerid, "Ваш телефон вимкнено.");
	if(TI[playerid][tPhoneCalled] != INVALID_PLAYER_ID && TI[playerid][tPhoneCaller] != INVALID_PLAYER_ID && TI[playerid][tPhone] == false) {
		new id = TI[playerid][tPhoneCaller];
		if(TI[playerid][tPhoneCalled] != playerid) {
			TI[playerid][tPhoneCalled] = INVALID_PLAYER_ID;
			TI[playerid][tPhoneCaller] = INVALID_PLAYER_ID;
			PhoneStatus(playerid,false);
			return SendOK(playerid,"Телефон абонента поза зоною досяжності.");
		}
		SendOK(id,"Гравець відповів на ваш дзвінок.");
		TI[playerid][tPhone] = true;
		TI[id][tPhone] = true;
		PhoneStatus(playerid,true);
	}
	return 1;
}
CMD:h(playerid) {
	for(new i; i<sizeof(calls_ether); i++) {
		if(calls_ether[i] == playerid) {
			SendOK(playerid,"Ви поклали трубку.");
			TI[calls_ether[i]][tPhoneNews] = true;
			calls_ether[i] = INVALID_PLAYER_ID;
			SendOK(calls_news[i],"Гравець поклав трубку.");
			PhoneStatus(playerid,false);
			return 1;
		}
	}
	if(TI[playerid][tPhoneCalled] != INVALID_PLAYER_ID && TI[playerid][tPhoneCaller] != INVALID_PLAYER_ID) {
		new id;
		if(TI[playerid][tPhoneCaller] == playerid) id = TI[playerid][tPhoneCalled];
		else if(TI[playerid][tPhoneCalled] == playerid) id = TI[playerid][tPhoneCaller];
		TI[playerid][tPhoneCalled] = INVALID_PLAYER_ID;
		TI[playerid][tPhoneCaller] = INVALID_PLAYER_ID;
		TI[id][tPhoneCalled] = INVALID_PLAYER_ID;
		TI[id][tPhoneCaller] = INVALID_PLAYER_ID;
		SendOK(playerid,"Ви поклали трубку.");
		SendOK(id,"Гравець поклав трубку.");
		if(TI[playerid][tPhone] == true) PhoneStatus(playerid,false);
		if(TI[id][tPhone] == true) PhoneStatus(id,false);
		TI[playerid][tPhone] = false;
		TI[id][tPhone] = false;
	}
	return 1;
}
CMD:sms(playerid, params[]) {
	if(!PI[playerid][pPhone]) return SendError(playerid, "У вас немає мобільного телефона.");
	if(sscanf(params,"ds[128]",params[0],params[1])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /sms [playerid/number] [text]");
	if(PI[playerid][pMobile] < 5) return SendError(playerid, "Недостатньо коштів на рахунку телефона.");
	if(GetPVarInt(playerid,"takephone")) return SendError(playerid, "У вас немає телефона.");
	if(TI[playerid][tGag]) return SendError(playerid, "У вас кляп.");
	if(PI[playerid][pMute]) return SendError(playerid, "У вас бан чата.");
	new bool:isnumber = false,string[156];
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(params[0] == PI[i][pPhone])
		{
			if(params[0] == PI[playerid][pPhone]) return SendError(playerid, "Абонент поза зоною досяжності.");
			if(TI[i][tPhoneOnline]) return SendError(playerid, "Абонент вимкнув телефон.");
			format(string, sizeof(string), "SMS: %s. Відправник: %s(%i) [т. %i]",params[1], player_name[i],i,PI[i][pPhone]);
			SendClientMessage(playerid, COLOR_YELLOW, string);
			format(string, sizeof(string), "SMS: %s. Відправник: %s(%i) [т. %i]",params[1],player_name[playerid],playerid, PI[playerid][pPhone]);
			SendClientMessage(i, COLOR_YELLOW, string);
			SetPlayerChatBubble(playerid, "відправив SMS", COLOR_PURPLE, 10.0, 3000);
			foreach(new x:Player) {
				if(GetPVarInt(x, "BigEarSMS") != 1) continue;
				format(string, 120, "[A] SMS: %s | Відправив %s(%i) гравцю %s(%d).", params[1],player_name[playerid],playerid,player_name[i],i);
				SendClientMessage(x, COLOR_GREY, string);
			}
			PlayerPlaySound(i, 1052, 0.0, 0.0, 0.0);
			PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
			PI[playerid][pMobile] -= 5,
			UpdatePlayerData(playerid,"pMobile",PI[playerid][pMobile]);
			isnumber = true;
			break;
		}
		else if(params[0] == i)
		{
			if(params[0] == playerid) return SendError(playerid, "Абонент поза зоною досяжності.");
			if(TI[i][tPhoneOnline]) return SendError(playerid, "Абонент вимкнув телефон.");
			format(string, sizeof(string), "SMS: %s. Отримувач: %s(%i) [т. %i]",params[1], player_name[i],i,PI[i][pPhone]);
			SendClientMessage(playerid, COLOR_YELLOW, string);
			format(string, sizeof(string), "SMS: %s. Відправник: %s(%i) [т. %i]",params[1],player_name[playerid],playerid, PI[playerid][pPhone]);
			SendClientMessage(i, COLOR_YELLOW, string);
			SetPlayerChatBubble(playerid, "відправив SMS", COLOR_PURPLE, 10.0, 3000);
			foreach(new x:Player) {
				if(GetPVarInt(x, "BigEarSMS") != 1) continue;
				format(string, 120, "[A] SMS: %s | Відправив %s(%i) гравцю %s(%d).", params[1],player_name[playerid],playerid,player_name[i],i);
				SendClientMessage(x, COLOR_GREY, string);
			}
			PlayerPlaySound(i, 1052, 0.0, 0.0, 0.0);
			PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
			PI[playerid][pMobile] -= 5,
			UpdatePlayerData(playerid,"pMobile",PI[playerid][pMobile]);
			isnumber = true;
			break;
		}
	}
	if(!isnumber) return SendError(playerid, "Абонент поза зоною досяжності.");
	return 1;
}
alias:call("c");
CMD:call(playerid,params[]) {
	if(PI[playerid][pPhone] == 0) return SendError(playerid, "У вас немає мобільного телефона.");
	if(TI[playerid][tPhone] == true) return SendError(playerid, "Ви вже розмовляєте по телефону.");
	else if(GetPVarInt(playerid,"takephone")) return SendError(playerid, "У вас немає телефона.");
	if(PI[playerid][pMute]) return SendError(playerid, "У вас бан чата.");
	if(TI[playerid][tGag]) return SendError(playerid, "У вас кляп.");
	new number;
	if(sscanf(params,"i",number)) {
		SendClientMessage(playerid,COLOR_GREEN,"Використайте: /call [number]");
		SendClientMessage(playerid,COLOR_GREEN,"Довідка: Служба порятунку - 911; Таксопарк - 222; ЗМІ - 554.");
		return 1;
	}
	if(number == PI[playerid][pPhone]) return SendError(playerid, "Абонент поза зоною досяжності.");
	switch(number) {
		case 911: return ShowPlayerDialog(playerid, D_CALL_SERVICES, DSL, ""P"Оберіть сервіс", ""P"1."W" Поліція\n"P"2."W" Екстрена медична допомога\n"P"3."W" Механік", "Вибір", "Скасувати");
		case 222: {
			new ids = 0;
			for(new x = GetVehiclePoolSize()+1; --x != 0;)
			{
				if(!IsValidVehicle(x)) continue;
				if(!IsVehicleOccupied(x)) continue;
				if(VehicleInfo[x][vJob] != 8) continue;
				ids++;
				ShowPlayerDialog(playerid,D_TAXI_CALL,DSM,""P"Диспетчер: Таксі",""W"Ви дійсно бажаєте викликати таксі на ваше поточне місце розташування?\n\n"G"","Викликати","Скасувати");
			}
			if(ids == 0) return SendError(playerid, "Диспетчер: Наразі немає вільних таксистів.");
			return 1;
		}
		case 554: {
			if(PI[playerid][pMobile] <= 9) return SendError(playerid, "Недостатньо коштів на рахунку телефона.");
			if(calls_news[0] == INVALID_PLAYER_ID) return SendError(playerid, "Прийом дзінків відключено.");
			if(calls_ether[0] != INVALID_PLAYER_ID) return SendError(playerid, "Лінія зайнята.");
			if(PI[playerid][pMember] == fLSNEWS) return SendError(playerid, "Ви не можете дзвонити у свою студію.");
			
			SendClientMessage(playerid,CGOLD,"Ви у прямому ефірі.");
			SendOK(calls_news[0],"Гравець дозвонився у прямий ефір.");
			SendOK(calls_news[0],"Щоб закінчити розмову, введіть "P"/skip"W".");
			SetPlayerSpecialAction(playerid,SPECIAL_ACTION_USECELLPHONE);
			PhoneStatus(playerid,true);
			calls_ether[0] = playerid;
			PI[playerid][pSettings][2] = fLSNEWS;
			TI[playerid][tPhoneNews] = true;
		}
		default: {
			if(PI[playerid][pMobile] <= 9) return SendError(playerid, "Недостатньо коштів на рахунку телефона.");
			new bool:isnumber = false ;
			foreach(new i:Player) {
				if(!TI[i][tLogin]) continue;
				if(PI[i][pPhone] == number) {
					if(SERIU[i][sID] != INVALID_PLAYER_ID) return SendError(playerid, "Абонент поза зоною досяжності.");
					if(!PI[i][pPhone]) return SendError(playerid, "Абонент немає телефону.");
					if(TI[i][tPhoneOnline]) return SendError(playerid, "Абонент вимкнув телефон.");
					if(TI[i][tPhone]) return SendError(playerid, "Абонент скинув дзвінок.");
					TI[playerid][tPhoneCaller] = playerid;
					TI[playerid][tPhoneCalled] = i;
					TI[i][tPhoneCaller] = playerid;
					TI[i][tPhoneCalled] = i;
					new string[128];
					format(string,sizeof(string),"Вихідний виклик: "GREEN"[т. %d]"W". Щоб скасувати, введіть "NO"/h"W".",PI[i][pPhone]);
					SendClientMessage(playerid,-1,string);
					
					format(string,sizeof(string),"Вхідний виклик: "GREEN"[т. %d].",PI[playerid][pPhone]);
					SendClientMessage(i,-1,string);
					SendClientMessage(i,-1,"Введіть "YES"/p "W"щоб прийняти виклик, або "NO"/h "W"для відмови.");
					
					PhoneStatus(playerid,true);
					if(PI[playerid][pMobile] > 10) PI[playerid][pMobile] -= 10;
					UpdatePlayerData(playerid,"pMobile",PI[playerid][pMobile]);
					isnumber = true;
					break;
				}
			}
			if(!isnumber) return SendError(playerid, "Абонент поза зоною досяжності.");
		}
	}
	return 1;
}
CMD:togphone(playerid) {
	if(PI[playerid][pPhone] == 0) return SendError(playerid, "У вас немає мобільного телефона.");
	if(!TI[playerid][tPhoneOnline]) TI[playerid][tPhoneOnline] = true,SendOK(playerid, "Телефон вимкнено.");
	else if(TI[playerid][tPhoneOnline]) TI[playerid][tPhoneOnline] = false,SendOK(playerid, "Телефон ввімкнено.");
	return 1;
}
CMD:book(playerid) {
	if(!PI[playerid][pBook]) return SendError(playerid, "У вас немає телефонної книги.");
	new string[1512],str[128],status[25];
	strcat(string,"Номер\tІм'я\tСтан\n");
	for(new i; i < 25; i ++) {
		new id = GetPlayerID(pPhoneName[playerid][i]);
		if(IsPlayerConnected(id)) status = "{33AA33}Online";
		else status = "{AA3333}Offline";
		if(PI[playerid][pPhoneNumber][i] == 0) strcat(string,"--\t--\t--\n");
		else format(str, sizeof(str), "%d\t%s\t%s\n", PI[playerid][pPhoneNumber][i],pPhoneName[playerid][i],status),strcat(string,str);
	}
	ShowPlayerDialog(playerid, D_BOOK, DSTH, "Телефонна книга", string, "Обрати", "Скасувати");
	return 1;
}
CMD:healme(playerid) {
	if(!GetInvent(playerid, 1)) return SendError(playerid, "У вас немає аптечки");
	if(TI[playerid][tDuel] != -1) return SendError(playerid, "Не можна використовувати на дуелях.");
	if(GetPVarInt(playerid,"anti_sbiv_time") > unix) return 1;
	new Float:health;
	GetPlayerHealth(playerid,health);
	if(health + 60.0 < 160.0) health += 60.0;
	else health = 160.0;
	SetHealth(playerid, health);
	
	if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT || GetPlayerState(playerid) == PLAYER_STATE_DRIVER || GetPlayerState(playerid) == PLAYER_STATE_PASSENGER)
	{
		PlayerHealFix[playerid] = 1;
		PlayerHealExFix[playerid] = unix + 3;
	}
	
	new slot = ClickInv[playerid];
	if(slot != -1) RefreshInv(playerid, slot);
	else DeleteItem(playerid, 1, 1);
	
	SetPlayerChatBubble(playerid,"+60 HP",COLOR_YELLOW,20.0,10000);
	ApplyAnimation(playerid,"ped","gum_eat",4.0,0,0,0,0,0,1);
	SetPVarInt(playerid, "anti_sbiv_time", unix+7);
	return 1;
}
CMD:frmask(playerid) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	if(IsPlayerAttachedObjectSlotUsed(playerid, 2)) RemovePlayerAttachedObject(playerid, 2);
	if(GPVI(playerid,"FRMask_Use"))
	{
	    SendClientMessage(playerid, 0x0099FFAA, "Ви зняли маску.");
	    SetPlayerColor(playerid,gFractionSpawn[PI[playerid][pMember]][fracColor]);
	    DPV(playerid, "FRMask_Use");
	}
	else
	{
	    SendClientMessage(playerid,0x0099FFAA, "Ваше місцерозташування на карті приховано.");
	    if(!IsPlayerInAnyVehicle(playerid)) ApplyAnimation(playerid, "SHOP", "ROB_Shifty", 4.0, 0, 0, 0, 0, 0);
	    SetPlayerColor(playerid, 0x7a766700);
	    SPVI(playerid, "FRMask_Use", 1);
		SetPlayerAttachedObject(playerid, 2, 19801, 2, 0.074000, 0.000000, 0.008000, -5.899976, 84.600082, -174.099639, 1.282001, 1.419013, 1.189006);
		SetPlayerChatBubble(playerid, "одягнув маску.", COLOR_ORANGE, 30.0, 10000);
	}
	return 1;
}
CMD:mask(playerid) {
	if(GetPVarInt(playerid,"anti_sbiv_time") > unix) return 1;
	if(!GetInvent(playerid, 120)) return SendError(playerid, "У вас недостатньо масок.");
	if(TI[playerid][tMaskTime]) return SendError(playerid, "Ви вже одягнули маску.");
	if(TI[playerid][tDuel] != -1) return SendError(playerid, "Не можна використовувати на дуелях.");
	SetPlayerColor(playerid, 0x7a766700);
	
	SendOK(playerid, "Ви одягнули маску. Ваше місцерозташування приховано на 10 хвилин.");
	GameTextForPlayer(playerid, "~b~Invisible on", 5000, 3);
	SetPVarInt(playerid, "anti_sbiv_time", unix+7);
	SetPVarInt(playerid, "masks", 10);
	
	new slot = ClickInv[playerid];
	if(slot != -1) RefreshInv(playerid, slot);
	else DeleteItem(playerid, 120, 1);
	ApplyAnimation(playerid, "shop","ROB_Shifty",4.0,0,0,0,0,0,1);
	SetPlayerAttachedObject(playerid, 8, 19801, 2, 0.064999, 0.028999, 0.000000, 0.000000, 80.300003, 178.900009, 1.330000, 1.25, 1.125000);
	TI[playerid][tMaskTime] = 10;
	SetPlayerChatBubble(playerid, "одягнув маску.", COLOR_ORANGE, 30.0, 10000);
	//NickName(playerid);
	return 1;
}
CMD:maskoff(playerid) {
	if(!TI[playerid][tMaskTime]) return SendError(playerid, "Ви не в масці.");
	if(PI[playerid][pMember] && start_work[playerid]) SetPlayerColor(playerid,gFractionSpawn[PI[playerid][pMember]][fracColor]);
	else SetPlayerColor(playerid,0xFFFFFF11);
	if(TI[playerid][tMasked]) SetPlayerColor(playerid,gFractionSpawn[TI[playerid][tMasked]][fracColor]);
	RemovePlayerAttachedObject(playerid, 8);
	SendOK(playerid,"Ви зняли маску.");
	TI[playerid][tMaskTime] = 0;
	//NickName(playerid);
	return 1;
}
CMD:unmask(playerid,params[]) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /unmask [playerid]");
	if(TI[params[0]][tMaskTime] <= 0) return SendError(playerid, "Гравець немає маски.");
	SetPlayerColor(params[0],gFractionSpawn[PI[params[0]][pMember]][fracColor]);
	TI[params[0]][tMaskTime] = 0;
	RemovePlayerAttachedObject(params[0], 8);
	//NickName(params[0]);
	return 1;
}
CMD:flowers(playerid, params[]) {
	if(sscanf(params, "i", params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /flowers [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(GetPlayerDistanceToPlayer(playerid,params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Ви далеко один від одного");
	if(GetPlayerWeapon(playerid) != 14) return SendError(playerid, "У вас немає квітів.");
	if(params[0] == playerid)  return  SendError(playerid, "Ви вказали свій ID.");
	new weapons[13][2];
	for(new S = 0; S<13; S++) GetPlayerWeaponData(playerid, S, weapons[S][0], weapons[S][1]) ;
	ResetPlayerWeapons(playerid);
	for(new S = 0; S<13 ; S++) if(weapons[S][0] != 14 && weapons[S][0] != 0) GivePlayerWeapon (playerid,weapons[S][0],weapons[S][1]);
	GivePlayerWeapon(params[0], 14, 1);
	new string[128];
	format(string, sizeof(string), "подарував квіти %s", player_name[params[0]]);
	MeAction(playerid, string);
	ApplyAnimation(playerid, "INT_SHOP", "shop_pay", 4.1, 0, 0, 0, 0,0,1);
	return 1;
}
CB: RemovePlayerAttachedObjectDelay(playerid,slot) {
	RemovePlayerAttachedObject(playerid,slot);
}
CMD:loadweste(playerid) {
	new vehicleid = GetPlayerVehicleID(playerid);
	if(PI[playerid][pJob] != 6) return SendError(playerid, "Ви не працюєте чистильником каналізацій.");
	if(!GetPVarInt(playerid,"start_job_mower")) return SendError(playerid, "Ви не орендували робочий автомобіль.");
	if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Ви не в автомобілі.");
	if(vehicleid != GetPVarInt(playerid,"veh_id_cleaner")) return SendError(playerid, "Ви не в своєму орендованому транспорті.");
	new Float:x, Float:y, Float:z, Float:a;
	new string[45];
	GetVehiclePos(vehicleid,x,y,z);
	GetVehicleZAngle(vehicleid,a);
	x = x - (-3.5*floatsin(a,degrees));
	y = y - 3.5*floatcos(a,degrees);
	VG[vehicleid][vgPickup] = CreateDynamicPickup(19133,1,x,y,z);
	VG[vehicleid][vgArea] = CreateDynamicSphere(x,y,z,1.0);
	format(string,sizeof(string),"Завантаження сміття: "O"%i/15",VG[vehicleid][vgAmount][0]);
	VG[vehicleid][vgText] = CreateDynamic3DTextLabel(string,COLOR_WHITE,x,y,z+0.5,20.0);
	VG[vehicleid][vgWeste] = 1;
	RemovePlayerFromVehicleAC(playerid);
	return 1;
}
CMD:sewerage(playerid) { 
	if(PI[playerid][pJob] != 6) return SendError(playerid, "Ви не працюєте чистильником каналізацій.");
	if(!GetPVarInt(playerid,"start_job_mower")) return SendError(playerid, "Ви не орендували робочий автомобіль.");
	new string[800], str[400];
	format(string,sizeof(string),""W"Номер каналзації\t"W"Сміття в каналізації\t"W"Статус\n");
	for(new i=0; i <10; i++)
	{
		if(Sewer[i][seTime] > gettime()) format(str,sizeof(str),"Утилізація (%02d:%02d хв.)",(Sewer[i][seTime]-gettime())/60,(Sewer[i][seTime]-gettime())%60);
		else format(str,sizeof(str),"Забруднена");
		format(string,sizeof(string),"%sКаналізація #%i\t%d/15\t%s\n",string,i+1,Sewer[i][seAmmout],str);
	}
	strcat(string,"\n{F0BF39}Почати завантаження транспорту\n{F0BF39}Місце утилізації сміття");
	ShowPlayerDialog(playerid, D_JOB_KANAL, DSTH,""P"Каналізації",string,"Обрати","Закрити");
	return 1;
}
CMD:free(playerid, params[]) {
	if (PI[playerid][pMember] != fWHITEHOUSE || !start_work[playerid]) return 1;
	if (PI[playerid][pRank] < 3) return SendError(playerid, "Ви не адвокат.");
	if (sscanf(params, "dd", params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /free [playerid] [prive]");
	if (!IsPlayerConnected(params[0]) || params[0] == playerid) return SendError(playerid, not_id);
	if (!PI[params[0]][pJailTime]) return SendError(playerid, "Гравець не потребує ваших послуг.");
	if (params[1] < 500 || params[1] > 10000) return SendError(playerid, "Від $500 до $10.000.");
	if (!IsPlayerStream(10.0, playerid, params[0])) return SendError(playerid, "Ви далеко від гравця.");
	if (GetPVarInt(params[0], "FreePrice")) return SendError(playerid, "У гравця вже є пропозиція адвокатських послуг.");
	if (PI[params[0]][pJail] == 5) return SendError(playerid, "Ця людина в ДеМоргані.");
	new string[144];
	format(string, sizeof(string), "Ви запропонували "P"%s"W" випустити його за "P"$%d"W".", player_name[params[0]], params[1]);
	SendUse(playerid, string);
	format(string, sizeof(string), "З урахуванням податку державі, ви отримаєте: "P"$%d"W".", floatround(params[1] / 100 * 15));
	SendUse(playerid, string);
	format(string, sizeof(string), "Адвокат "P"%s"W" пропонує вам скористатися його послугами за "P"$%d"W".", player_name[playerid], params[1]);
	SendUse(params[0], string);
	SPD(params[0], D_FREE, DSL, ""P"Оплата послуг адвоката", "1. Готівка\n2. Банк", "Оплатити", "Скасувати");
	SetPVarInt(params[0], "FreeOffer", playerid + 1);
	SetPVarInt(params[0], "FreePrice", params[1]);
	return 1;
}
CMD:svrnt(playerid) {
	if(PI[playerid][pAdmin] < 4 || dostup[playerid] == 0) return 1;
	new string[512];
	GetNetworkStats(string, sizeof string);
	ShowPlayerDialog(playerid, DIALOG_NONE, DIALOG_STYLE_MSGBOX, !"Server Network Stats", string, !"x", !"");
	return 1;
}
CMD:egmenu(playerid,const params[]) {
	new g = PlayerEgg[playerid];
	if(PlayerEgg[playerid] == -1) return SendError(playerid, "Ви не займали курник.");
	if(!PlayerToPoint(1.0,playerid,Egg[g][gX],Egg[g][gY],Egg[g][gZ])) return 1;
	ShowPlayerDialog(playerid,D_FARM_EGG,DSL,""P"Курник",""P"1."W" Зібрати знесені яйця\n"P"2."W" Погодувати курей\n"P"3."W" Звільнити курник", "Далі", "Закрити");
	return 1;
}
CMD:setspawn(playerid) {
	ShowPlayerDialog(playerid, D_SPAWN, DSL, ""P"Вибір спавна", ""P"1."W" Вокзал\n"P"2."W" У будинку чи квартирі\n"P"3."W" На базі організації\n"P"4."W" У будинку сім'ї\n"P"5."W" У будинку на колесах", "Обрати", "Скасувати");
	return 1;
}
CMD:jobskill(playerid) {
	ShowPlayerDialog(playerid,DIALOG_JOB_PROGRESS,DSL, ""P"Навики персонажа",""P"1."W" Будівельник\n"P"2."W" Мийник доріг\n"P"3."W" Рибак\n"P"4."W" Інкасатор\n"P"5."W" Чистильник каналізацій\n"P"6."W" Водій автобуса\n"P"7."W" Розвізник їжі\n"P"8."W" Механік\n"P"9."W" Розвізник піци\n"P"10."W" Отримання аксессуарів", "Обрати", "Закрити");
	return 1;
}
CMD:sellbusiness(playerid,params[]) {
	if(PI[playerid][pBusiness] < 1) return SendError(playerid, "У вас немає бізнесу.");
	new bizid = PI[playerid][pBusiness]-1;
	if(sscanf(params, "dd",params[0],params[1])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /sellbusiness [playerid] [price]");
	if(PI[playerid][pBusiness] == -1) return SendError(playerid, "У вас немає бізнесу.");
	if(!PlayerToPoint(3,playerid,gBusiness[bizid][bizzX], gBusiness[bizid][bizzY], gBusiness[bizid][bizzZ])) return SendError(playerid, "Необхідно знаходитись поруч зі своїм бізнесом.");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(PI[params[0]][pBusiness]) return SendError(playerid, "У гравця вже є бізнес");
	if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
	new price,price2;
	price = gBusiness[bizid][bizzSellPrice];
	price2 = gBusiness[bizid][bizzSellPrice]*20;
	if(params[1] < price || params[1] > price2) {
		static const f_str[] = "Вартість за бізнес не може бути менше $%d і більше $%d.";
		new string[sizeof(f_str) +1 + (-2 + 7) + (-2 + 10)];
		format(string,sizeof(string),f_str,price,price2);
		SendError(playerid,string);
		return 1;
	}
	if(GetPlayerDistanceToPlayer(playerid,params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Ви далеко один від одного");
	new businessid = -1;
	for(new i;i<gBusinessCount;i++) {
		if(GetString(player_name[playerid],gBusiness[i][bizzOwner])) {businessid = i; break;}
	}
	if(businessid == -1) return SendError(playerid, "Бізнес не знайдено.");
	SetPVarInt(params[0],"bizzProdaet",playerid + 1);
	SetPVarInt(playerid,"bizzPokupaet",params[0] + 1);
	SetPVarInt(params[0],"bizzCena",params[1]);
	new string[144];
	format(string, sizeof(string), ""P"%s "W"запропонував(а) Вам купити його бізнес за "P"$%i"W".", player_name[playerid], params[1]);
	SendUse(params[0], string);
	SendClientMessage(params[0],COLOR_BLUE,"Натисніть "YES"Y "BLUE"щоб погодитися, або "NO"N "BLUE"для відмови.");
	SendOK(params[0],"Для перегляду доходів бізнесу, введіть "P"/binfo"W".");
	format(string, sizeof(string), "Ви запропонували "P"%s "W"купити ваш бізнес за "P"$%i"W".", player_name[params[0]], params[1]);
	SendUse(playerid, string);
	return 1;
}
CMD:binfo(playerid,params[]) {
	if(!GetPVarInt(playerid,"bizzProdaet")) return SendError(playerid, "Вам не пропонували купити бізнес.");
	new bizz = PI[GetPVarInt(playerid,"bizzProdaet")-1][pBusiness]-1;
	new query[156];
	mysql_format(connects, query, sizeof(query),"SELECT * FROM `business_stats` WHERE `bizz` = '%i'", bizz);
	mysql_tquery(connects, query, "bizz_stats", "ii", playerid,bizz);
	return 1;
}
CMD:sellsim(playerid,params[]) {
	if(!PI[playerid][pPhone]) return SendError(playerid, "У вас немає SIM-карти.");
	new numbet_str[7];
	format(numbet_str,sizeof(numbet_str),"%d",PI[playerid][pPhone]);
	if(strlen(numbet_str) < 6) return SendError(playerid, "Цей номер не можна продати.");
	if(sscanf(params, "dd",params[0],params[1])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /sellsim [playerid] [price]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(playerid == params[0]) return SendError(playerid,not_id);
	if(!ProxDetectorS(3.0, playerid,params[0])) return SendError(playerid, "Ви далеко один від одного.");
	if(params[1] < 1 || params[1] > 1000000) return SendError(playerid, "Вартість не може бути менше $1 і більше $1.000.000.");
	if(PlayerToPoint(30.0,playerid,2080.7615, 1710.6829, 1113.5668)) return SendError(playerid, "Заборонена продажа SIM-карти в казино.");
	if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
	new string[144];
	format(string, sizeof(string), ""P"%s "W"запропонував вам купити SIM-карту за "P"$%i"W".", player_name[playerid], params[1]);
	SendUse(params[0], string);
	SendClientMessage(params[0],COLOR_BLUE,"Натисніть "YES"Y "BLUE"щоб погодитися, або "NO"N "BLUE"для відмови.");
	format(string, sizeof(string), "Ви запропонували "P"%s "W"купити SIM-карту за "P"$%i"W".", player_name[params[0]], params[1]);
	SendUse(playerid, string);
	SetPVarInt(params[0], "sim_id_sell", playerid + 1); 
	SetPVarInt(params[0], "sim_summ", params[1]);
	return 1;
}
alias:usedrugs("drugs");
CMD:usedrugs(playerid, params[])
{
	if (TI[playerid][tDuel] != -1) return 1;
	if (GetPVarInt(playerid, "anti_sbiv_time") > unix) return 1;
	new drugs = PI[playerid][pDrugs];
	if (drugs <= 0) return SendError(playerid, "У вас немає наркотиків.");
	if (TI[playerid][tDuel] != -1) return SendError(playerid,"Не можна використовувати на дуелях.");
	if(TI[playerid][tDM] != 0) return SendError(playerid,"Не можна використовувати на DM зонах.");
	new Float: PlayerHP;
	GetPlayerHealth(playerid, PlayerHP);
	if (sscanf(params, "i", params[0]))
	{
		if (PI[playerid][pAddiction] < 2000)
		{
			if (drugs >= 5) params[0] = 5;
			if (drugs > 0 && drugs < 5) params[0] = drugs;
		}
		else if (PI[playerid][pAddiction] < 5000)
		{
			if (drugs >= 10) params[0] = 10;
			if (drugs > 0 && drugs < 10) params[0] = drugs;
		}
		else if (PI[playerid][pAddiction] > 5000)
		{
			if (drugs >= 20) params[0] = 20;
			if (drugs > 0 && drugs < 20) params[0] = drugs;
		}
	}
	if (drugs < params[0]) return SendError(playerid,"У вас немає стільки наркотиків.");
	if (params[0] < 1) return SendError(playerid,"Значення не може бути менше 1.");
	if (PI[playerid][pAddiction] < 2000 && params[0] > 5) return SendError(playerid,"Ви не можете прийняти більше 5 грам наркотиків.");
	if (PI[playerid][pAddiction] < 5000 && params[0] > 10) return SendError(playerid,"Ви не можете прийняти більше 10 грам наркотиків.");
	else if (params[0] > 10) return SendError(playerid,"Ви не можете прийняти більше 10 грам наркотиків.");
	new ReasonHeal = 10;
	if (PI[playerid][pAddiction] < 2000 && (PlayerHP + (ReasonHeal * params[0])) > 120)
	{
		if (GetPVarInt(playerid, "DrugsTime") < gettime())
		{
			SendOK(playerid, "Рівень здоров'я поповнено до 120.");
			SetPlayerHealth(playerid, 120);
			SetPVarInt(playerid, "DrugsTime", gettime() + 30);
		}
		else SendClientMessage(playerid, COLOR_WHITE, "Здоров'я можна поповнювати не частіше, ніж раз в 30 секунд.");
	}
	else if (PI[playerid][pAddiction] < 5000 && (PlayerHP + (ReasonHeal * params[0])) > 140)
	{
		if (GetPVarInt(playerid, "DrugsTime") < gettime())
		{
			SendOK(playerid, "Рівень здоров'я поповнено до 140.");
			SetPlayerHealth(playerid, 140);
			SetPVarInt(playerid, "DrugsTime", gettime() + 30);
		}
		else SendClientMessage(playerid, COLOR_WHITE, "Здоров'я можна поповнювати не частіше, ніж раз в 30 секунд.");
	}
	else if (PI[playerid][pAddiction] > 5000 && (PlayerHP + (ReasonHeal * params[0])) > 160)
	{
		if (GetPVarInt(playerid, "DrugsTime") < gettime())
		{
			SendOK(playerid, "Рівень здоров'я поповнено до 160.");
			SetPlayerHealth(playerid, 160);
			SetPVarInt(playerid, "DrugsTime", gettime() + 30);
		}
		else SendClientMessage(playerid, COLOR_WHITE, "Здоров'я можна поповнювати не частіше, ніж раз в 30 секунд.");
	}
	else
	{
		if (GetPVarInt(playerid, "DrugsTime") < gettime())
		{
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Рівень здоров'я поповнено до %.0f.", (PlayerHP + (ReasonHeal * params[0])));
			SendClientMessage(playerid, 0xFFFFFFFF, STRING_GLOBAL);
			SetPlayerHealth(playerid, (PlayerHP + (ReasonHeal * params[0])));
			SetPVarInt(playerid, "DrugsTime", gettime() + 30);
		}
		else SendClientMessage(playerid, COLOR_WHITE, "Здоров'я можна поповнювати не частіше, ніж раз в 30 секунд.");
		if (PI[playerid][pAddiction] < 2000)
		{
			UsingDrugs[playerid] = 10;
			SetPlayerTime(playerid, 17, 0);
			SetPlayerWeather(playerid, -68);
			SetPlayerDrunkLevel(playerid, 3000);
		}
	}
	if (IsPlayerInAnyVehicle(playerid)) ApplyAnimation(playerid, "FOOD", "EAT_Burger", 4.1, 0, 0, 0, 0, 0, 1);
	else ApplyAnimation(playerid, "SMOKING", "M_smk_drag", 4.1, 0, 0, 0, 0, 0, 1);
	SetPVarInt(playerid, "anti_sbiv_time", unix + 3);
	PI[playerid][pAddiction] += (5 * params[0]);
	UpdatePlayerData(playerid,"pAddiction",PI[playerid][pAddiction]);
	
	PI[playerid][pDrugs] -= params[0];
	UpdatePlayerData(playerid,"pDrugs",PI[playerid][pDrugs]);
	PI[playerid][pStartLomka] = 0;
	
	if(PI[playerid][pNarcoLomka] == 1)
	{
		PI[playerid][pNarcoLomka] = 0;
		UpdatePlayerData(playerid,"lomka",PI[playerid][pNarcoLomka]);
	}
	return 0x1;
}
CMD:selldrugs(playerid, params[]) {
	if(!IsAGang(playerid) && !IsAMafia(playerid)) return SendError(playerid, "Доступно тільки бандам та мафіям.");
	new id,drugs,price;
	if(sscanf(params,"ddd",id,drugs,price)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /selldrugs [playerid] [amount] [price]");
	if(!IsPlayerConnected(id) || playerid == id) return SendError(playerid,not_id);
	if(GetPlayerDistanceToPlayer(playerid,id) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(id)) return SendError(playerid, "Ви далеко один від одного.");
	if(drugs > 50 || drugs < 1) return SendError(playerid, "Можна продавати від 1 до 50 грам.");
	if(drugs > PI[playerid][pDrugs]) return SendError(playerid, "У вас недостатньо наркотиків.");
	if(price > 5000 || price < 1) return SendError(playerid, "Вартість повинна бути від 1 до 5.000$");
	if(price > GetPlayerMoneyEx(id)) return SendError(playerid, "У гравця недостатньо грошей.");
	if(PlayerToPoint(15.5,playerid,2080.7615, 1710.6829, 1113.5668)) return SendError(playerid, "Продаж наркотиків в казино заборонений.");
	if(active_accept(id)) return SendError(playerid, "У гравця вже є активна пропозиція.");
	if(GetInvSet(id) >= 40) return SendError(playerid, "В інвентарі у гравця недостатньо місця.");
	
	SetPVarInt(playerid,"drugoffee",id);
	SetPVarInt(id,"drugoffee",id);
	SetPVarInt(id,"drugoffer",playerid);
	SetPVarInt(id,"drugprice",price);
	SetPVarInt(id,"drugvalue",drugs);
	new string[170];
	format(string, sizeof(string), "Ви запропонували "P"%s"W" купити "W"%d"W" грам наркотиків за "P"$%d"W".",player_name[id],drugs,price);
	SendUse(playerid, string);
	format(string, sizeof(string), ""P"%s"W" запропонував вам купити "W"%d"W" грам наркотиків за "P"$%d"W".",player_name[playerid],drugs,price);
	SendUse(id, string);
	SendClientMessage(id,COLOR_BLUE,"Натисніть "YES"Y "BLUE"щоб погодитися, або "NO"N "BLUE"для відмови.");
	return 1;
}
CMD:pay(playerid, params[]) {
	if(sscanf(params, "ud", params[0],params[1])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /pay [playerid] [amount]");
	if(PI[playerid][pLevel] < 2) return SendError(playerid, "Передача грошей доступна з 2 рівня.");
	if(IsPlayerInRangeOfPoint(playerid,50,2072.4404,1710.0946,1113.7882)) return SendError(playerid, "Не можна передавати гроші в казино.");
	if(params[1] < 1 || params[1] > 50000) return SendError(playerid, "Не можна передавати менше $1 і більше $50.000.");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(params[0] == INVALID_PLAYER_ID) return SendError(playerid,not_id);
	if(playerid == params[0]) return SendError(playerid,not_id);
	if(!ProxDetectorS(5.0, playerid, params[0])) return SendError(playerid, "Ви дуже далеко.");
	if(SERIU[params[0]][sID] != INVALID_PLAYER_ID) return SendError(playerid, "Гравець дуже далеко.");
	if(PI[playerid][pCash] < params[1]) return SendError(playerid, "У вас недостатньо грошей.");
	if(RingInfo[0][rgPlayer][0] == playerid) return 1;
	if(RingInfo[0][rgPlayer][1] == playerid) return 1;
	//if(GetPVarInt(playerid,"pay_timer") > unix) return SendError(playerid, "не можна передавать Гроші чаще чем 1 раз в 30 секунд");
	//SetPVarInt(playerid, "pay_timer", unix+30);
	new string[128];
	format(string,64,"Отримання за допомогою /pay від %s",player_name[playerid]);
	GiveMoney(params[0], params[1], string);
	string = "";
	format(string,64,"Передача за допомогою /pay %s",player_name[params[0]]);
	GiveMoney(playerid, -params[1], string);
	format(string, sizeof(string), "Ви передали %s[%i] $%i.",player_name[params[0]],params[0],params[1]);
	PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
	SendClientMessage(playerid, COLOR_GRAD1, string);
	format(string, sizeof(string), "Ви отримали $%i від %s[%i].",params[1],player_name[playerid], playerid);
	SendClientMessage(params[0], COLOR_GRAD1, string);
	PlayerPlaySound(params[0], 1052, 0.0, 0.0, 0.0);
	ApplyAnimation(playerid, "INT_SHOP", "shop_pay", 4.1, 0, 0, 0, 0,0,1);
	return 1;
}
CMD:number(playerid, params[]) {
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /number [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	new string[156];
	format(string, sizeof(string), "Власник: %s. Телефон: "ORANGE"%i",player_name[params[0]],PI[params[0]][pPhone]);
	SendClientMessage(playerid, COLOR_WHITE, string);
	return 1;
}
CMD:gnews(playerid, params[]) {
	new count_player_row = GetPVarInt(playerid,"count_row");
	new max_rows = GetPVarInt(playerid, "max_rows");
	new get_goverment_text[170];
	new set_pvar_string[170];
	if(!IsACop(playerid) && !IsAArm(playerid) && !IsANews(playerid) && !IsAMedic(playerid) && PI[playerid][pMember] != fINSTRUCTORS && PI[playerid][pMember] != fWHITEHOUSE) return 1;
	else if(PI[playerid][pRank] < FI[PI[playerid][pMember]][fInviteRang]) return SendError(playerid, "Вам недоступна ця команда.");
	else if(!start_work[playerid]) return SendError(playerid, "Вам необхідно розпочати робочий день.");
	else if(PI[playerid][pMute] > 0) return SendError(playerid, "У Вас бан чата.");
	if(GetSVarInt("gnews_timer") > unix) {
		new year, month, day, hour, minute, second;
		timestamp_to_date(GetSVarInt("gnews_timer") - unix, year, month, day, hour, minute, second);
		new string[128];
		format(string,sizeof(string),"До подачі державних новин залишилось: "W"%02d:%02d.", minute, second);
		SendError(playerid, string);
		return 1;
	}
	new string[262];
	if(!max_rows) {
		if(sscanf(params,"i",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /gnews [кількість рядків]");
		if(params[0] < 1 || params[0] > 4) return SendError(playerid, "Від 1 до 4 рядків");
		SetPVarInt(playerid,"max_rows", params[0] + 1);
		SetPVarInt(playerid, "count_row", 1);
		format(string, sizeof(string), "Ви вибрали для державних новин %d рядків. "G"Використайте: /gnews [текст рядка 1]", params[0]);
		SendClientMessage(playerid, 0x489191C8, string);
	}
	else {
		if(max_rows == count_player_row) {
			if(!isnull(params)) {
				DeletePVar(playerid,"max_rows");
				DeletePVar(playerid,"count_row");
				SendOK(playerid,"Державні новини успішно скинуті.");
				return 1;
			}
			for(new i = 1; i < max_rows; i++) {
				format(set_pvar_string, 15, "gnews%d", i);
				GetPVarString(playerid, set_pvar_string, get_goverment_text, 170);
				format(string, sizeof(string), "Держ. новини %s[%d]: %s | %s", player_name[playerid],playerid, FI[PI[playerid][pMember]][fName], get_goverment_text);
				SendClientMessageToAll(0x4466CCFF, string);
			}
			format(string, sizeof(string), "[A] %s %s[%d] використав /gnews.", FI[PI[playerid][pMember]][fName], player_name[playerid], playerid);
			AdmMSG(COLOR_YELLOW, string);
			SetSVarInt("gnews_timer", gettime() + 60*10);
			DeletePVar(playerid,"max_rows");
			DeletePVar(playerid,"count_row");
			return 1;
		}
		format(string, 64, "/gnews [текст рядка %d]",count_player_row);
		if (isnull(params)) return SendError(playerid, string);
		if(strlen(params) > 160) return SendError(playerid, "Не можна використовувати більше 160 символів.");
		format(set_pvar_string, 15, "gnews%d", count_player_row);
		SetPVarString(playerid, set_pvar_string, params);
		if(count_player_row + 1 == max_rows) {
			format(string, sizeof(string), "Рядок %d : %s", count_player_row, params);
			SendClientMessage(playerid,0xD6D6D6C8, string);
			SendOK(playerid, "Використайте команду /gnews ще раз, щоб опублікувати новини.");
			SendOK(playerid, "У випадку помилки, використайте: /gnews 0.");
		}
		else {
			format(string, sizeof(string), "Рядок %d: %s. "G"Для продовження введіть: /gnews [текст рядка %d]", count_player_row, params, count_player_row + 1);
			SendClientMessage(playerid, 0xD6D6D6C8, string);
		}
		SetPVarInt(playerid,"count_row", count_player_row + 1);
	}
	return 1;
}
CMD:trunk(playerid) {
	if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Не можна використовувати в автомобілі.");
	new Float:x,Float:y,Float:z,Float:a;
	if(idaofcar[playerid] != -1) {
		GetVehicleShiftPos(idaofcar[playerid],1,x,y,z,2.0);
		if(IsPlayerInRangeOfPoint(playerid,2,x,y,z)) {
			static const f_str[] = ""W"Найменування\t"W"Кількість\n\
				"W"Багажник:\t%s\n\
				"W"Каністри:\t"P"%d/2\n\
				"W"Наркотики:\t"P"%d/200\n\
				"W"Матеріали:\t"P"%d/1000\n\
				"W"Deagle:\t"P"%d/50\n\
				"W"AK47:\t"P"%d/50\n\
				"W"M4:\t"P"%d/50\n\
				"W"Shotgun:\t"P"%d/50";
			new string[sizeof(f_str) +20];
			new oper[30];
			if(TrunkInfo[idaofcar[playerid]][tOpen] == 0) oper = "{C62929}Зачинений"W"";
			else oper = "{56A736}Відчинений"W"";
			format(string,sizeof(string), f_str,oper,TrunkInfo[idaofcar[playerid]][tKanistra],TrunkInfo[idaofcar[playerid]][tNarko],
			TrunkInfo[idaofcar[playerid]][tMats],TrunkInfo[idaofcar[playerid]][tGun][0],TrunkInfo[idaofcar[playerid]][tGun][1],TrunkInfo[idaofcar[playerid]][tGun][2],TrunkInfo[idaofcar[playerid]][tGun][3]);
			return ShowPlayerDialog(playerid,D_TRUNK_LIST,DSTH,"Багажник",string,"Прийняти","Скасувати");
		}
		else trunk_close(playerid);
	}
	for(new c = GetVehiclePoolSize()+1; --c != 0;) {
		if(!IsValidVehicle(c)) continue;
		if(IsABike(c) || IsAVelik(c) || IsABoat(c)) continue;
		GetVehicleShiftPos(c,1,x,y,z,2.0);
		if(IsPlayerInRangeOfPoint(playerid,2,x,y,z)) {
			if(!TrunkInfo[c][tOpen] && c != house_car[playerid][0] && c != house_car[playerid][1]) return SendError(playerid, "багажник закрыт");
			GetVehicleParamsEx(c, engine, lights, alarm, doors, bonnet, boot, objective);
			new Float:pos_y,Float:pos_z;
			GetPlayerPos(playerid,pos_y,pos_y,pos_z);
			GetVehicleZAngle(c, a);
			if(boot != VEHICLE_PARAMS_ON) {
				AnimationTrunk(playerid,Float:x,Float:y,Float:z,Float:a,Float:pos_y,Float:pos_z);
				SetVehicleParamsEx(c, engine, lights, alarm, doors, bonnet, VEHICLE_PARAMS_ON, objective);
			}
			else AnimationTrunk(playerid,Float:x,Float:y,Float:z,Float:a,Float:pos_y,Float:pos_z);
			idaofcar[playerid]=c;
			static const f_str[] = "Найменування\tКількість\n\
				"W"Багажник:\t%s\n\
				"W"Каністри:\t"P"%d/2\n\
				"W"Наркотики:\t"P"%d/200\n\
				"W"Матеріали:\t"P"%d/1000\n\
				"W"Deagle:\t"P"%d/50\n\
				"W"AK47:\t"P"%d/50\n\
				"W"M4:\t"P"%d/50\n\
				"W"Shotgun:\t"P"%d/50";
			new string[sizeof(f_str) +20];
			new oper[30];
			if(TrunkInfo[c][tOpen] == 0) oper = "{C62929}Зачинений"W"";
			else oper = "{56A736}Відчинений"W"";
			format(string,sizeof(string), f_str,oper,TrunkInfo[c][tKanistra],TrunkInfo[c][tNarko],
			TrunkInfo[c][tMats],TrunkInfo[c][tGun][0],TrunkInfo[c][tGun][1],TrunkInfo[c][tGun][2],TrunkInfo[c][tGun][3]);
			ShowPlayerDialog(playerid,D_TRUNK_LIST,DSTH,"Багажник",string,"Прийняти","Скасувати");
			break;
		}
	}
	return 1;
}
CMD:slimit(playerid,params[]) {
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "Ви повинні бути за кермом т/з.");
	if(sscanf(params,"d",params[0])) {
		if(TI[playerid][tSLimit]) {
			TI[playerid][tSLimit] = 0;
			SendOK(playerid,"Обмеження швидкості знято.");
		}
		else SendClientMessage(playerid, COLOR_WHITE,"Використайте: /slimit [speed]");
		return 1;
	}
	if(params[0] < 10 || params[0] > 150) return SendError(playerid, "Від 10 до 150.");
	TI[playerid][tSLimit] = params[0];
	SendOK(playerid,"Обмеження швидкості встановлено.");
	return 1;
}
alias:engine("en");
CMD:engine(playerid, const params[]) {
	new carid = GetPlayerVehicleID(playerid);
	if(IsAVelik(carid)) return 0;
	if(carid == INVALID_VEHICLE_ID) return 1;
	if(thef_car[playerid] == carid && GetPVarInt(playerid,"theft") > 0) return 0;
	if(GetPVarInt(playerid,"tank_vfuel")) return 1;
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 1;
	new Float:Health;
	GetVehicleHealth(carid,Health);
	GetVehicleParamsEx(carid,engine,lights,alarm,doors,bonnet,boot,objective);
	/*if(VehicleInfo[carid][vFuel] <= 0.5 && !IsAPlane(carid) && !IsABoat(carid) && !IsABike(carid) && !IsAVelik(carid) && Health <= 320) {
		SendError(playerid, "Не вдалось завести двигун");
		return 1;
	}*/
	if(Health <= 320) 
	{
		SendError(playerid, "Автомобіль зламався, викличте автомеханіка.");
		return 1;
	}
	if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) ToggleEngine(GetPlayerVehicleID(playerid),playerid);
	return 1;
}

CMD:hi(playerid,params[]) {
	if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Не можна використовувати в машині.");
	if(sscanf(params, "u", params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /hi [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, not_id);
	if(SERIU[params[0]][sID] != INVALID_PLAYER_ID) return SendError(playerid, "Гравець дуже далеко.");
	if(!IsPlayerStream(2.0, playerid, params[0])) return SendError(playerid, "Гравець далеко від вас.");
	if(params[0] == playerid)  return  SendError(playerid, "Ви вказали свій ID.");
	if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
	new string[144];
	format(string, sizeof(string), ""P"%s "W"запропонував вам потиснути руку.", player_name[playerid]);
	SendUse(params[0], string);
	SendClientMessage(params[0],COLOR_BLUE,"Натисніть "YES"Y "BLUE"щоб погодитися, або "NO"N "BLUE"для відмови.");
	format(string, sizeof(string), "Ви запропонували "P"%s "W"потиснути руку.", player_name[params[0]]);
	SendUse(playerid, string);
	SetPVarInt(params[0],"hi", playerid+1);
	return 1;
}
CMD:sellic(playerid, params[]) {
	if(PI[playerid][pMember] != fINSTRUCTORS) return SendError(playerid, "Ви не є працівником автошколи.");
	if(!PlayerToPoint(30.0,playerid,4.0519,-81.3692,1026.4091) && GetPlayerInterior(playerid) != 3) return SendError(playerid, "Ви повинні знаходитися в автошколі");
	if(PI[playerid][pRank] < 2) return SendError(playerid, "Доступно з 2 рангу.");
	if(sscanf(params,"di",params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /sellic [playerid] [price (500-20000)");
	if(params[1] < 500 || params[1] > 20000) return SendError(playerid, "Вартість повинна бути від $500 і до $15.000.");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(playerid == params[0]) return SendError(playerid, "Ви вказали свій ID.");
	if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
	if(PI[params[0]][pCash] < params[1]) return SendError(playerid, "У гравця недостатньо грошей.");
	if(GetPlayerDistanceToPlayer(playerid, params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Гравець дуже далеко");
	new abz[46];
	format(abz,sizeof(abz),""P"Видача ліцензії за"W" %i",params[1]);
	ShowPlayerDialog(playerid,D_LICENSE_GIVE,DSL,abz,"1. Ліцензія на наземний транспорт\n2. Ліцензія на повітряний транспорт\n3. Ліцензія на водний транспорт","Обрати","Закрити");
	SetPVarInt(playerid,"lic", params[0] + 1);
	SetPVarInt(playerid,"lic_cash",params[1]);
	return 1;
}
CMD:givelic(playerid, params[]) {
	if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return 1;
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /givelic [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	lic[params[0]][0] =
	lic[params[0]][1] =
	lic[params[0]][2] =
	lic[params[0]][3] = 1;
	UpdateLicenses(params[0]);
	SendOK(params[0],"Ліцензії отримано.");
	SendOK(playerid,"Ліцензії видано.");
	return 1;
}
alias:pts("carpass");
CMD:pts(playerid,params[]) {
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /pts [playerid]");
	if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Ви не в машині.");
	if(SERIU[params[0]][sID] != INVALID_PLAYER_ID) return SendError(playerid, "Гравець дуже далеко.");
	if(GetPlayerVehicleID(playerid) != house_car[playerid][0] && GetPlayerVehicleID(playerid) != house_car[playerid][1]) return SendError(playerid, "Ви не за кермом свого т/з.");
	if(GetPlayerDistanceToPlayer(playerid, params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Гравець дуже далеко.");
	if(params[0] == playerid) CarPass(playerid,params[0]);
	else {
		if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
		new string[144];
		format(string, sizeof(string), ""P"%s "W"хоче показати вам документи на транспорт.", player_name[playerid]);
		SendUse(params[0], string);
		SendClientMessage(params[0],COLOR_BLUE,"Натисніть "YES"Y "BLUE"щоб погодитися, або "NO"N "BLUE"для відмови.");
		format(string, sizeof(string), "Ви запропонували "P"%s "W"показати документи на транспорт.", player_name[params[0]]);
		SendUse(playerid, string);
		SetPVarInt(params[0],"pts", playerid + 1);
	}
	return 1;
}
CMD:lic(playerid,params[]) {
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /lic [playerid]");
	if(SERIU[params[0]][sID] != INVALID_PLAYER_ID) return SendError(playerid, "Гравець дуже далеко.");
	if(GetPlayerDistanceToPlayer(playerid, params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Гравець дуже далеко.");
	if(params[0] == playerid) ShowLic(playerid,params[0]);
	else {
		if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
		new string[144];
		format(string, sizeof(string), ""P"%s "W"хоче показати Вам свої ліцензії.", player_name[playerid]);
		SendUse(params[0], string);
		SendClientMessage(params[0],COLOR_BLUE,"Натисніть "YES"Y "BLUE"щоб погодитися, або "NO"N "BLUE"для відмови.");
		format(string, sizeof(string), "Ви запропонували "P"%s "W"показати ваші ліцензії.", player_name[params[0]]);
		SendUse(playerid, string);
		SetPVarInt(params[0],"lices", playerid + 1);
	}
	return 1;
}
CMD:pass(playerid, params[]) {
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /pass [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(SERIU[params[0]][sID] != INVALID_PLAYER_ID) return SendError(playerid, "Гравець дуже далеко.");
	if(GetPlayerDistanceToPlayer(playerid, params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Гравець дуже далеко");
	if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
	if(playerid == params[0]) return ShowPass(playerid,playerid);
	new string[144];
	format(string, sizeof(string), ""P"%s "W"хоче показати вам паспорт.", player_name[playerid]);
	SendUse(params[0], string);
	SendClientMessage(params[0],COLOR_BLUE,"Натисніть "YES"Y "BLUE"щоб погодитися, або "NO"N "BLUE"для відмови.");
	format(string, sizeof(string), "Ви запропонували "P"%s "W"показати ваш паспорт.", player_name[params[0]]);
	SendUse(playerid, string);
	SetPVarInt(params[0],"pass", playerid + 1);
	return 1;
}
CMD:fakepass(playerid, params[]) {
	if(PI[playerid][pMember] != fFBI || !start_work[playerid]) return SendError(playerid, "Ви не агент FBI");
	if(!TI[playerid][tMasked]) return SendError(playerid, "На Вас немає маскувальної форми");
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /fakepass [id гравця]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(SERIU[params[0]][sID] != INVALID_PLAYER_ID) return SendError(playerid, "Гравець дуже далеко");
	if(GetPlayerDistanceToPlayer(playerid, params[0]) > 5.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Гравець дуже далеко");
	if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
	new string[512];
	for(new i = 1; i <= FI[TI[playerid][tMasked]][fMaxRang]; i++) {
		format(string,sizeof(string),"%s%s (%i)\n",string,GetRankName(TI[playerid][tMasked],i),i);
		ShowPlayerDialog(playerid,D_FAKEPASS,DSL,""P"Оберіть ранг",string,"Обрати","Закрити");
	}
	SetPVarInt(playerid,"fpass2", params[0]);
	return 1;
}
alias:suspect("su");
CMD:suspect(playerid, params[]) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	if(PI[playerid][pRank] < 2) return SendError(playerid, "Доступно со 2 рангу.");
	if(sscanf(params,"i",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /su [ID гравця]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(PI[params[0]][pJailTime]) return SendError(playerid, "Цей гравець у в'язниці.");
	if(PI[params[0]][pSearch] >= 6) return SendError(playerid, "У цього гравця вже 6 рівень розшуку.");
	if(IsACop(params[0])) return SendError(playerid, "Ви не можете подавати у розшук законників.");
	if(TI[playerid][tTied]) return SendError(playerid, "Ви зв'язані.");
	new string[1000]; 
	strcat(string, ""W"");
	for(new i=0; i<14; i++) {
		format(string,sizeof(string),"%s%s\n",string,suspect_player[i][suspect_name_folder]);
	}
	ShowPlayerDialog(playerid,D_SU,DSL,""P"Злочин",string,"Обрати","Закрити");
	SetPVarInt(playerid,"su_player",params[0]);
	return 1;
}
CMD:clear(playerid, params[]) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	if(IsAPD(playerid)) if(PI[playerid][pRank] < 6) return SendError(playerid, "Доступно з 6 рангу.");
	if(PI[playerid][pMember] == fFBI) if(PI[playerid][pRank] < 4) return SendError(playerid, "Доступно з 4 рангу.");
	if(PI[playerid][pRank] < 6) return SendError(playerid, "Доступно з 6 рангу.");
	if(sscanf(params,"i",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /clear [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(params[0] == INVALID_PLAYER_ID) return SendError(playerid,not_id);
	if(!PI[params[0]][pSearch]) return SendError(playerid, "Гравець не знаходиться у розшуку.");
	new string[128];
	format(string,sizeof(string),"Ви зняли розшук з %s.", player_name[params[0]]);
	SendClientMessage(playerid, CDEPARTMENT, string);
	format(string,sizeof(string), "%s %s зняв з Вас розшук.", GetRankName(PI[playerid][pMember],PI[playerid][pRank]),player_name[playerid]);
	SendClientMessage(params[0], CDEPARTMENT, string);
	PI[params[0]][pSearch] = 0;
	SetPlayerWantedLevel(params[0], 0);
	UpdatePlayerData(params[0],"pSearch",PI[params[0]][pSearch]);
	return 1;
}
CMD:tipster(playerid,params[]) {
	if(PI[playerid][pMember] != fFBI) return SendError(playerid, "Доступно тільки ФБР.");
	if(PI[playerid][pRank] < 5 && PI[playerid][pMember] == fFBI) return SendError(playerid, "Доступно з 5 рангу.");
	if(!GetPVarInt(playerid,"tipster")) return SendError(playerid, "У вас немає жучка. Подойдите до багажника автомобіля і натисніть "GREEN"ALT"W".");
	new param[40],string[200];
	if(sscanf(params, "s[32]S()[64]", param, params)) {
		SendClientMessage(playerid, COLOR_WHITE,"Використайте: /tipster [action (SET/REMOVE/LISTEN)]");
		return 1;
	}
	else if(!strcmp(param, "set",true)) {
		new giveplayerid;
		if(sscanf(params, "i", giveplayerid)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /tipster set [playerid]");
		if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
		if(!PI[giveplayerid][pMember]) return SendError(playerid, "Гравець не знаходиться в організації.");
		new Float:X, Float:Y, Float:Z;
		GetPlayerPos(giveplayerid,X,Y,Z);
		if(!PlayerToPoint(10.0,playerid,X,Y,Z)) return SendError(playerid, "Гравець не поруч з вами.");
		SetPVarInt(playerid,"tipster_set", giveplayerid + 1);
		format(string,sizeof(string),"Ви поставили жучок на "P"%s"W". Використайте "P"/tipster listen"W" для прослушки.",player_name[giveplayerid]);
		SendOK(playerid,string);
	}
	else if(!strcmp(param, "listen",true)) {
		if(!GetPVarInt(playerid,"tipster_set")) return SendError(playerid, "Спочатку встановіть на гравця жучок за допомогою "P"/tipster set"W".");
		new giveplayerid = GetPVarInt(playerid,"tipster_set")-1;
		format(string,sizeof(string), "Ви почали прослушку за гравцем "P"%s"W".",player_name[giveplayerid]);
		SendOK(playerid,string);
		SetPVarInt(playerid,"tipster_listen", PI[giveplayerid][pMember]);
		DeletePVar(playerid,"tipster_set");
	}
	else if(!strcmp(param, "remove",true)) {
		if(GetPVarInt(playerid,"tipster_set"))		DeletePVar(playerid,"tipster_set");
		if(GetPVarInt(playerid,"tipster_listen"))	DeletePVar(playerid,"tipster_listen");
		if(GetPVarInt(playerid,"tipster"))			DeletePVar(playerid,"tipster");
		SendOK(playerid, "Ви деактивували жучок");
	}
	return 1;
}
CMD:push(playerid, params[]) {
	if((!IsACop(playerid) || !start_work[playerid]) && !IsAMafia(playerid)) return SendError(playerid, "У вас немає доступу до цієї команди");
	if(sscanf(params, "u",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /push [playerid]");
	if(!IsPlayerConnected(params[0]) || params[0] == playerid) return SendError(playerid,not_id);
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "Ви повинні бути за кермом автомобиля");
	if(!IsPlayerStream(5.0, playerid,params[0])) return SendError(playerid, "Гравець не поруч з Вами");
	if(!IsAMafia(playerid)) if((!TI[params[0]][tCuffed]) && IsACop(playerid)) return SendError(playerid, "Гравець без наручників");
	if(GetPlayerVehicleID(playerid) == GetPlayerVehicleID(params[0])) return SendError(playerid, "Гравець вже в т/з");
	t_PutPlayerInVehicle(params[0], GetPlayerVehicleID(playerid), GetVehicleFreeSeat(GetPlayerVehicleID(playerid)));
	SetPlayerArmedWeapon(params[0],0);
	if(TI[params[0]][tCuffed] && GotoInfo[playerid][gtID] == params[0]) {
		CheckPlayerGoCuff(params[0]);
		CheckPlayerGoCuff(params[0]);
		//return 1;
	}
	new string[64];
	format(string,sizeof(string), "%s затащил вас в автомобіль",player_name[playerid]);
	SendOK(params[0],string);
	format(string,sizeof(string), "Ви затащили в автомобіль %s",player_name[params[0]]);
	SendOK(playerid,string);
	
	TogglePlayerControllable(params[0], false);
	return 1;
}
CMD:udjur(playerid, params[]) {
	if(!IsANews(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки працівникам радіоцентру.");
	if(PI[playerid][pRank] < 2) return SendError(playerid, "Доступно з 2 рангу.");
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /udjur [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, not_id);
	if(params[0] == playerid) return SendError(playerid, "Ви вказали свій ID");
	
	if(GetPlayerDistanceToPlayer(playerid, params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Гравець дуже далеко");
	if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
	
	new string[144];
	
	format(string, sizeof(string), ""P"%s "W"хоче показати вам посвідчення журналіста.", player_name[playerid]);
	SendUse(params[0], string);
	SendClientMessage(params[0],COLOR_BLUE,"Натисніть "YES"Y "BLUE"щоб погодитися, або "NO"N "BLUE"для відмови.");
	format(string, sizeof(string), "Ви запропонували "P"%s "W"показати ваше посвідчення журналіста.", player_name[params[0]]);
	SendUse(playerid, string);
	
	SetPVarInt(params[0],"udjur", playerid + 1);
	return 1;
}
CMD:ud(playerid, params[]) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	if(PI[playerid][pRank] < 2) return SendError(playerid, "Доступно з 2 ранга.");
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /ud [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, not_id);
	if(params[0] == playerid) return SendError(playerid, "Ви вказали свій ID.");
	
	if(GetPlayerDistanceToPlayer(playerid, params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Гравець дуже далеко");
	if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
	
	new string[144];
	
	format(string, sizeof(string), ""P"%s "W"хоче показати вам посвідчення.", player_name[playerid]);
	SendUse(params[0], string);
	SendClientMessage(params[0],COLOR_BLUE,"Натисніть "YES"Y "BLUE"щоб погодитися, або "NO"N "BLUE"для відмови.");
	format(string, sizeof(string), "Ви запропонували "P"%s "W"показати ваше посвідчення.", player_name[params[0]]);
	SendUse(playerid, string);
	
	SetPVarInt(params[0],"uds", playerid + 1);
	return 1;
}
CMD:gotome(playerid, params[]) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	if(PI[params[0]][pJail]) return SendError(playerid, "Гравець сидить у в'язниці.");
	new id, string[150];
	if(sscanf(params,"d",id)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /gotome [playerid]");
	if(!IsPlayerConnected(id)) return SendError(playerid, not_id);
	if(TI[id][tCuffed] && GotoInfo[playerid][gtID] == id) {
		format(string,sizeof(string),"%s перестав тягнути за собою гравця %s.",player_name[playerid], player_name[id]);
		ProxDetector(25,playerid,string,COLOR_PURPLE);
		TogglePlayerControllable(id, TI[id][tCuffed]);
		CheckPlayerGoCuff(id);
		CheckPlayerGoCuff(playerid);
		return 1;
	}
	if(!ProxDetectorS(2.0, playerid, id)) return SendError(playerid, "Гравець далеко від вас.");
	if(GotoInfo[playerid][gtID] != INVALID_PLAYER_ID) return SendError(playerid, "Ви вже ведете когось за собою.");
	if(GotoInfo[id][gtGoID] != INVALID_PLAYER_ID) return SendError(playerid, "Цього гравця вже веде хтось за собою.");
	if(!TI[id][tCuffed]) return SendError(playerid, "Гравець не в наручниках.");
	CheckPlayerGoCuff(playerid);
	CheckPlayerGoCuff(id);
	GotoInfo[playerid][gtID] = id;
	GotoInfo[id][gtGoID] = playerid;
	GotoInfo[id][gtState] = GetPlayerState(playerid);
	GetPlayerPos(id, GotoInfo[id][gtX], GotoInfo[id][gtY], GotoInfo[id][gtZ]);
	format(string, sizeof(string), "%s потягнув гравця %s за собой.", player_name[playerid], player_name[id]);
	ProxDetector(25.0, playerid, string, COLOR_PURPLE);
	TogglePlayerControllable(id, true);
	return 1;
}
CMD:fences(playerid, const params[]) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	if(PI[playerid][pRank] < 7) return SendError(playerid, "Доступно з 7 рангу.");
	if(GetPlayerVirtualWorld(playerid) != 0 || GetPlayerInterior(playerid)!=0) return SendError(playerid, "Заборонено використовувати в приміщенні.");
	ShowPlayerDialog(playerid,D_OBJ,DSL,""P"Огородження",""P"1."W" Огородження\n"P"2."W" Дорожні знаки\n"P"3."W" Інше\n"P"4."W" Прибрати найближче загородження","Обрати","Скасувати");
	return 1;
}
CMD:fvig(playerid,params[]) {
	new string[350];
	if(sscanf(params,"us[128]",params[0], params[1])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /fvig [playerid] [reason]");
	if(PI[playerid][pMember] != fWHITEHOUSE) return SendError(playerid, "Ви не працівник уряду.");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, not_id);
	if(PI[playerid][pRank] < 6) return SendError(playerid, "Доступно з 8 рангу.");
	if(PI[params[0]][pRank] >= 7) return SendError(playerid, "Не можна понизити гравця з 7 рангом.");
	if(!IsACop(params[0]) && !IsAArm(params[0]) && !IsAMedic(params[0]) && !IsANews(params[0])) return SendError(playerid, "Гравець не є членом державної організації.");
	PI[params[0]][pfWarn] ++;
	UpdatePlayerData(params[0],"fwarn",PI[params[0]][pfWarn]);
	FracLog(LOGS_FWARN,player_name[playerid],player_name[params[0]],params[1]);
	if(PI[params[0]][pfWarn] >= 3) {
		if(start_work[params[0]]) {
			SendInfo(params[0],"Робочий день завершено.");
			start_work[params[0]] = 0;
			UpdatePlayerData(params[0],"FracDuty",start_work[params[0]]);
		}
		add_jobinfo(params[0],params[1]);
		PI[params[0]][pRank] = 0;
		PI[params[0]][pMember] = 0;
		PI[params[0]][pJob] = 0;
		PI[params[0]][pFracSkin] = 0;
		SetPlayerColor(params[0],0xFFFFFF11);
		skin_player(params[0]);
		PI[params[0]][pfWarn] = 0;
		UpdatePlayerData(params[0],"pMember",PI[params[0]][pMember]);
		UpdatePlayerData(params[0],"pJob",PI[params[0]][pJob]);
		UpdatePlayerData(params[0],"fwarn",0);
		UpdatePlayerData(params[0],"pModel",PI[params[0]][pFracSkin]);
		format(string, sizeof(string), "[R] %s видав догану і звільнив гравця %s(%s) (3/3). Причина: %s.",player_name[playerid],player_name[params[0]],FI[PI[params[0]][pMember]][fName],params[1]);
		SendFamilyMessage(PI[playerid][pMember], 0x31cf63FF, string);
		FracLog(LOGS_UNINVITE,player_name[playerid],player_name[params[0]],params[1]);
		return 1;
	}
	format(string, sizeof(string), "[R] %s видав догану гравцю %s(%s) (%i/3). Причина: %s.",player_name[playerid],player_name[params[0]],FI[PI[params[0]][pMember]][fName],PI[params[0]][pfWarn],params[1]);
	SendFamilyMessage(PI[playerid][pMember],0x31cf63FF, string);
	return 1;
}
CMD:mark(playerid, params[]) {
	if (!IsACop(playerid))
	return SendError(playerid, "У вас немає доступу до цієї команди.");
	if (GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
	return SendError(playerid, "Ви повинні знаходитись за кермом організаційного транспортк.");
	new vehicleid = GetPlayerVehicleID(playerid), mark[42];
	if (PI[playerid][pMember] != VehicleInfo[vehicleid][vTeam])
	return 1;
	if (VehicleInfo[vehicleid][vMarked]) {
		if (VehicleInfo[vehicleid][vNumberAttached]) {
			DestroyDynamic3DTextLabel(VehicleInfo[vehicleid][vNumberTextID]);
			VehicleInfo[vehicleid][vNumberTextID] = Text3D:-1;
			VehicleInfo[vehicleid][vNumberAttached] = 0;
		}
		SendOK(playerid, "Маркування цього т/з було прибране.");
		VehicleInfo[vehicleid][vMarked] = 0;
	} else {
		if (sscanf(params, "s[42]", mark) || !(3 <= strlen(mark) <= 40))
		return SendClientMessage(playerid,COLOR_WHITE, "Введіть: /mark [text]");
		SetVehicleNumberText(vehicleid, mark);
		SendOK(playerid, "Ви змінили маркування т/з, використайте повторно /mark, щоб прибрати.");
		VehicleInfo[vehicleid][vMarked] = 1;
		strmid(VehicleInfo[vehicleid][vMarkText], mark, 0, strlen(mark), 42);
		strmid(VehicleInfo[vehicleid][vMarkOwner], player_name[playerid], 0, strlen(player_name[playerid]), MAX_PLAYER_NAME + 2);
		Streamer_Update(playerid, STREAMER_TYPE_3D_TEXT_LABEL);
	}
	return 1;
}
CMD:marklist(playerid) {
	if (!IsACop(playerid))
	return SendError(playerid, "У вас немає доступу до цієї команди.");
	new idx = 0, string[300], string_2[300];
	format(STRING_GLOBAL, sizeof (STRING_GLOBAL), " \n"G"Назва моделі т/з - Маркування - Ким встановлена\n");
	for (new vehicleid = GetVehiclePoolSize() + 1; --vehicleid != 0;) {
		if (!VehicleInfo[vehicleid][vMarked])
		continue;
		if (PI[playerid][pMember] != VehicleInfo[vehicleid][vTeam])
		continue;
		format(string, sizeof (string), "\
			"P"%i. "W"%s "G"[ID: %i]\t"P"[%s]\t"G"%s\n",
		idx + 1, gTransport[GetVehicleModel(vehicleid) - 400][trName],
		vehicleid, VehicleInfo[vehicleid][vMarkText],
		VehicleInfo[vehicleid][vMarkOwner]
		);
		strcat(string_2, string);
		idx++;
	}
	if (idx == 0) {
		SendError(playerid, "Жодного замаркованого т/з не знайдено.");
	} else {
		format(string, sizeof (string), " \
			\n"G"Всього замарковано т/з: %i.", idx
		);
		strcat(string_2, string);
		ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Список маркованих т/з", string_2, "Закрити", "");
	}
	return 1;
}
CMD:alc(playerid) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	ShowPlayerDialog(playerid, D_ALCATRZ, DSL, ""P"Алькатрас", ""P"1."W" Місце розташування в'язниці\n"P"2."W" Список втікачів з в'язниці\n"P"3."W" Місце розташування 'Накращого друга'\n"P"4."W" Кінцева точка в'язнів", "Обрати", "Закрити");
	return 1;
}
CMD:accept(playerid)
{
    if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	SendOK(playerid, "Місце розташування зборойового складу відправлене вам на GPS.");
	return SetPlayerCheckpoint(playerid, 74.1751,-214.7039,1.4446, 5.0);
}
CMD:cuff(playerid,params[]) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /cuff [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(PI[params[0]][pJail]) return SendError(playerid, "Гравець вже сидить у в'язниці.");
	if(IsACop(params[0])) return SendError(playerid, "Ви не можете надягнути наручники на законника.");
	if(TI[params[0]][tCuffed]) return SendError(playerid, "На цього гравця вже вдягнуті наручники.");
	if(!IsPlayerStream(2.0, playerid, params[0])) return SendError(playerid, "Гравець не поруч з вами.");
	if(TI[playerid][tTied]) return SendError(playerid, "Ви зв'язані.");
	SetPlayerAttachedObject(params[0], 0, 19418, 6, -0.011000, 0.028000, -0.022000, -15.600012, -33.699977, -81.700035, 0.891999, 1.000000, 1.168000);
	SetPlayerSpecialAction(params[0],SPECIAL_ACTION_CUFFED);
	TI[params[0]][tCuffed] = 2;
	SendOK(playerid,"Щоб потягнути гравця за собою, використайте команду: /gotome [playerid]");
	return 1;
}
CMD:uncuff(playerid,params[]) {
	if(IsACop(playerid) && start_work[playerid] || PI[playerid][pAdmin] >= 2 && dostup[playerid] == 1) {
		if(sscanf(params,"d",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /uncuff [playerid]");
		if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
		if(!IsPlayerStream(5.0, playerid, params[0])) return SendError(playerid, "Поруч з вами нікого немає.");
		if(params[0] == playerid) return SendError(playerid, "Ви не можете зняти наручники з самого себе.");
		if(TI[params[0]][tCuffed]) {
			if(PI[playerid][pAdmin]) SendOK(params[0],"Адміністратор зняв з вас наручники.");
			SetPlayerSpecialAction(params[0],SPECIAL_ACTION_NONE);
			RemovePlayerAttachedObject(params[0],0); 
			TogglePlayerControllable(params[0], true);
			TI[params[0]][tCuffed] = 0;
			if(GotoInfo[playerid][gtID] == params[0]) {
				CheckPlayerGoCuff(params[0]);
				CheckPlayerGoCuff(playerid);
			}
		}
	}
	else return SendError(playerid, "Доступно тільки правоохоронним органам.");
	return 1;
}
CMD:tazer(playerid) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	new string[256];
	if(GetPVarInt(playerid,"tazershoottime") > unix) {
		format(string,sizeof(string),"Дочекайтесь перезарядки тазера. (%d секунд)",GetPVarInt(playerid,"tazershoottime") - unix);
		SendOK(playerid,string);
		return 1;
	}
	if(TI[playerid][tTazers][0] > 0) return SendError(playerid, "Зброю вже заряджено.");
	for(new i; i <= 11; i++) {
		new gunid, ammo, storeslot = -1;
		GetPlayerWeaponData(playerid,i,gunid,ammo);
		switch(gunid) {
		case 24 : storeslot = 1;
		case 25 : storeslot = 1;
		}
		if(!gunid || !ammo || storeslot == -1) continue;
		new gunname[32];
		GetWeaponName(gunid,gunname,32);
		format(string,sizeof(string),"%s\n%s [%d]",string,gunname,ammo);
	}
	if(!strlen(string)) return SendError(playerid, "У вас немає зброї.");
	ShowPlayerDialog(playerid,D_TAZER,DSL,""P"Зброя",string,"Зарядити","Скасувати");
	return 1;
}
alias:megaphone("m","meg");
CMD:megaphone(playerid,params[]) {
	if((!IsACop(playerid) || !start_work[playerid]) && (!PI[playerid][pAdmin] || dostup[playerid] == 0)) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	if(PI[playerid][pMute]) return SendError(playerid, "У вас бан чата.");
	if(sscanf(params, "s[128]",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /m [text]");
	new veh = GetPlayerVehicleID(playerid);
	if(VehicleInfo[veh][vTeam] != fLSPD && VehicleInfo[veh][vTeam] != fRCSO  && VehicleInfo[veh][vTeam] != fFBI && PI[playerid][pAdmin] == 0) return SendError(playerid, "Ви не у поліцейському авто.");
	new string[220];
	if(PI[playerid][pAdmin] >= 1 || dostup[playerid] != 0) {
		format(string,sizeof(string),"[Адміністратор] %s(%d): %s",player_name[playerid],playerid,params[0]);
		SendStreamMessage(100.0, playerid, string,COLOR_YELLOW);
	}
	else {
		format(string,sizeof(string),"[Рупор] %s %s(%d): %s",GetRankName(PI[playerid][pMember],PI[playerid][pRank]),player_name[playerid],playerid,params[0]);
		SendStreamMessage(80.0, playerid, string,COLOR_YELLOW);
	}
	return 1;
}
CMD:look(playerid,params[]) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	if(IsAPD(playerid)) if(PI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 рангу.");
	if(PI[playerid][pMember] == fFBI) if(PI[playerid][pRank] < 2) return SendError(playerid, "Доступно з 2 рангу.");
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /look [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(!IsPlayerStream(3.0, playerid, params[0])) return SendError(playerid, "Гравець не поруч з вами.");
	if(params[0] == playerid) return SendError(playerid,not_id);
	new text1[20], text2[20],string[128];
	if(GetInvent(params[0], 2) > 0) { text1 = "| Наркотики"; } else { text1 = "| Пуста кишеня"; }
	if(GetInvent(params[0], 453) > 0) { text2 = "| Матеріали"; } else { text2 = "| Пуста кишеня"; }
	format(string, sizeof(string), ":::: Речі %s ::::", player_name[params[0]]);
	SendClientMessage(playerid, COLOR_WHITE, string);
	SendClientMessage(playerid, COLOR_WHITE, text1);
	SendClientMessage(playerid, COLOR_WHITE, text2);
	return 1;
}
CMD:arrest(playerid,params[]) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	if(!PlayerToPoint(10.0, playerid, 191.2486,-145.1439,1020.2169) && !PlayerToPoint(5.0, playerid,-40.2691,-176.8227,1026.9872)) return SendError(playerid, "Ви далеко від поліцейського департамента або в'язниці.");
	new suspect;
	if(sscanf(params,"i",suspect)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /arrest [playerid]");
	if(suspect == playerid) return SendError(playerid, "Ви вказали свій ID.");
	if(!IsPlayerConnected(suspect)) return SendError(playerid,not_id);
	if(!IsPlayerStream(4.0, playerid, suspect)) return SendError(playerid, "Гравець не поруч з вами.");
	if(PI[suspect][pSearch] < 1) return SendError(playerid, "Гравець не у розшуку.");
	new search, turma;
	if(PI[suspect][pSearch] <= 5) search = 600;
	else search = 750;
	if(TI[suspect][tCuffed] && GotoInfo[playerid][gtID] == suspect) {
		TogglePlayerControllable(suspect, TI[suspect][tCuffed]);
		CheckPlayerGoCuff(suspect);
		CheckPlayerGoCuff(suspect);
		//return 1;
	}
	new string[128];
	format(string, sizeof(string), "Ви посадили у в'язницю %s на %d секунд.", player_name[suspect], (PI[suspect][pSearch] * search));
	SendClientMessage(playerid, 0x6ab1ffaa, string);
	format(string, sizeof(string), "Вас посадив у в'язницю %s на %d секунд.", player_name[playerid], (PI[suspect][pSearch] * search));
	SendClientMessage(suspect, CBADINFO, string);
	format(string, sizeof(string), "%s %s(%d) арештував злочинця %s(%d).", GetRankName(PI[playerid][pMember],PI[playerid][pRank]),player_name[playerid],playerid, player_name[suspect],suspect);
	SendPDMessage(COLOR_MINJUST, string);
	
	if(QuestProgress[playerid][36] < 20 && AcceptQuest[playerid][36] != 0) QuestProgress[playerid][36] ++,save_quest(playerid,36);
	if(QuestProgress[playerid][36] == 20 && AcceptQuest[playerid][36] != 0) {
		ShowPlayerDialog(playerid,DIALOG_NONE,DSM, "Виконання квесту",""W"Ви закінчили виконання квесту 'Перший арешт'\n\t"NO"Квест можна завершити в списку квестів (/quest)","Закрити","");
	}
	if(PI[suspect][pSearch] >= 4)
	{
		if(QuestProgress[playerid][38] == 0 && AcceptQuest[playerid][38] != 0)
		{
			QuestProgress[playerid][38] ++;
			save_quest(playerid,38);
			ShowPlayerDialog(playerid,DIALOG_NONE,DSM, "Виконання квесту",""W"Ви закінчили виконання квесту 'Арешт ОЗП'\n\t"NO"Квест можна завершити в списку квестів (/quest)","Закрити","");
		}
	}
	
	ResetPlayerWeapons(suspect);
	SetPlayerSpecialAction(suspect,SPECIAL_ACTION_NONE);
	RemovePlayerAttachedObject(suspect,0);
	TogglePlayerControllable(suspect, true);
	TI[suspect][tCuffed] = 0;
	turma = PI[suspect][pSearch] * search;
	arrest(suspect, turma);
	PlayerSpawn(suspect);
	if(GetPVarInt(playerid, "Buk") == 1 || GetPVarInt(playerid, "Ready") == 1) RobLeave(playerid);
	return 1;
}
CMD:ticket(playerid, params[]) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам");
	if(sscanf(params, "uds[128]",params[0],params[1],params[2])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /ticket [playerid] [price] [reason]");
	if(PI[playerid][pMember] == fFBI) if(PI[playerid][pRank] < 4) return SendError(playerid, "Доступно з 4 рангу.");
	if(PI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 рангу.");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(params[1] < 1 || params[1] > 10000) return SendError(playerid, "Сума штрафу не повинна привищувати $10.000.");
	if(!IsPlayerStream(4.0, playerid, params[0])) return SendError(playerid, "Гравець не поруч з вами.");
	if(params[0] == playerid) return SendError(playerid,not_id);
	new day, month, year;
	getdate(year,month,day);
	new query[300];
	mysql_format(connects,query,sizeof(query), "INSERT INTO `"TABLE_TICKETS"` (`name`, `give_name`, `total`, `reason`, `date`) VALUES ('%s', '%s', '%i','%s','%02i/%02i/%02i')",player_name[params[0]],player_name[playerid],params[1],params[2],day,month,year);
	mysql_tquery(connects,query,"","");
	
	if(QuestProgress[playerid][34] < 10 && AcceptQuest[playerid][34] != 0) QuestProgress[playerid][34] ++,save_quest(playerid,34);
	if(QuestProgress[playerid][34] == 10 && AcceptQuest[playerid][34] != 0) {
		ShowPlayerDialog(playerid,DIALOG_NONE,DSM, "Виконання квесту",""W"Ви закінчили виконання квесту 'Виписати штраф'\n\t"NO"Квест можна завершити в списку квестів (/quest)","Закрити","");
	}
	
	new string[156];
	format(string,sizeof(string),"Ви виписали штраф у розмірі "ORANGE"$%i"W" %s. Причина: %s.",params[1],player_name[params[0]],params[2]);
	SendUse(playerid,string);
	format(string,sizeof(string),"Офіцер "P"%s"W" виписав вам штраф у розмірі "ORANGE"$%i."W" Причина: %s.",player_name[playerid],params[1],params[2]);
	SendUse(params[0],string);
	return SendOK(params[0], "Оплатити штрафи ви можете у банку.");
}
CMD:take(playerid,params[]) {
	if(!IsACop(playerid)) return SendError(playerid, "У вас немає доступу до цієї команди.");
	if(!start_work[playerid]) return SendError(playerid, "Вам необхідно розпочати робочий день.");
	if(PI[playerid][pRank] < 4) return SendError(playerid, "Доступно з 4 рангу.");
	if(TI[playerid][tTied]) return SendError(playerid, "Ви зв'язані.");
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /take [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(params[0] == playerid) return SendError(playerid,not_id);
	if(!IsPlayerStream(5.0, playerid, params[0])) return SendError(playerid, "Гравець не поруч з вами.");
	if(PI[playerid][pMember] == fINSTRUCTORS) ShowPlayerDialog(playerid,D_TAKE, DSL,""P"Вилучити", "Водійські права\nЛіцензія пілота\nЛіцензія на водний транспорт\nЛіцензія на зброю", "Обрати", "Закрити");
	else ShowPlayerDialog(playerid,D_TAKE, DSL,""P"Вилучити", "Водійські права\nЛіцензія пілота\nЛіцензія на водний транспорта\nЛіцензія на зброю\nНаркотики\nМатеріали", "Обрати", "Закрити");
	SetPVarInt(playerid,"takelic", params[0]);
	return 1;
}
CMD:vhack(playerid) {
	if(!IsAGang(playerid) && !IsAMafia(playerid) && !IsACop(playerid)) return SendError(playerid, "Ви не бандит чи мафіозі.");
	if(!PlayerToPoint(3.0,playerid,2719.1243,-2503.9795,13.4942) && !PlayerToPoint(3.0,playerid,2718.5977,-2405.0637,13.4643)) return SendError(playerid, "Ви не поруч з воротами нац. гвардії.");
	if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Ви не повинні знаходитися в автомобілі.");
	if(!GetInvent(playerid, 122)) return SendError(playerid, "У Вас немає відмичок для зламу воріт.");
	DeleteItem(playerid, 122, 1);
	JobTempProcess[playerid] = 23;
	TI[playerid][tProcess][0] = 0;
	TI[playerid][tProcess][1] = 10;
	PlayerTextDrawColor(playerid, YandNsysTDPlayer[playerid][1], -1);
	for(new YN = 0;YN < 3;YN++) {
		TextDrawShowForPlayer(playerid, YandNsysTD[YN]);
		if(YN < 2) PlayerTextDrawShow(playerid,YandNsysTDPlayer[playerid][YN]);
	}
	RandomYareNforJOBS(playerid);
	return 1;
}
CMD:hack(playerid, params[]) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	if(PI[playerid][pMember] == fFBI) if(PI[playerid][pRank] < 4) return SendError(playerid, "Доступно з 4 рангу.");
	if(PI[playerid][pRank] < 2) return SendError(playerid, "Доступно з 2 рангу.");
	new idx = -1;
	new Float:playerPos[3], Float:vehiclePos[3];
	GetPlayerPos(playerid, playerPos[0], playerPos[1], playerPos[2]);
	foreach(new player_vehicleid: playerVehicles)
	{
		GetVehiclePos(PlayerTrailer[player_vehicleid][carVehicle], vehiclePos[0], vehiclePos[1], vehiclePos[2]);
		GetVehicleParamsEx(PlayerTrailer[player_vehicleid][carVehicle],engine,lights,alarm,doors,bonnet,boot,objective);
		if(IsPlayerInRangeOfPoint(playerid, 3.0, vehiclePos[0], vehiclePos[1], vehiclePos[2]))
		{
			SetPlayerPosAC(playerid, -675.6675,1727.0975,1376.6718, player_vehicleid, 2);
			SetPlayerFacingAngle(playerid, 268.6703);
			SetCameraBehindPlayer(playerid);
			SetPlayerVirtualWorld(playerid, player_vehicleid);
			SetPlayerInterior(playerid, 2);
			new freezeSeconds = 0;
			switch (GetPlayerPing(playerid)) {
			case 0 .. 49: freezeSeconds = 2;
			case 50 .. 199: freezeSeconds = 3;
			case 200 .. 499: freezeSeconds = 4;
			default: freezeSeconds = 5;
			}
			FreezePlayerForTime(playerid, freezeSeconds);
			return 1;
		}
	}
	for(new i = 0; i < gHouseCount; i ++) {
		if(IsPlayerInRangeOfPoint(playerid, 3.0, gHouses[i][houseX], gHouses[i][houseY], gHouses[i][houseZ])) {
			idx = i;
			break;
		}
	}
	if(idx == -1) return SendError(playerid, "Ви повинні знаходитись поруч із будинком.");
	SetPlayerPosAC(playerid,hinterior_info[gHouses[idx][houseHint]][h_pos_exit][0],hinterior_info[gHouses[idx][houseHint]][h_pos_exit][1],hinterior_info[gHouses[idx][houseHint]][h_pos_exit][2],idx+1,hinterior_info[gHouses[idx][houseHint]][h_interior]);
	SetPlayerFacingAngle(playerid,hinterior_info[gHouses[idx][houseHint]][h_pos_exit][3]);
	TI[playerid][tInHouse] = true;
	return 1;
}
CMD:spikes(playerid) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	if(PI[playerid][pMember] == fFBI) if(PI[playerid][pRank] < 4) return SendError(playerid, "Доступно з 4 рангу.");
	if(PI[playerid][pRank] < 2) return SendError(playerid, "Доступно з 2 ранга.");
	new veh = GetPlayerVehicleID(playerid);
	if(GetVehicleModel(veh) != 490 && GetVehicleModel(veh) != 560 && GetVehicleModel(veh) != 596 && GetVehicleModel(veh) != 597 && GetVehicleModel(veh) != 598 && GetVehicleModel(veh) != 599) return SendError(playerid, "Недоступно у цьому автомобілі");
	if(GetPlayerVirtualWorld(playerid) != 0) return 1;
	if(GetPlayerInterior(playerid) != 0) return 1;
	new Float: X, Float: Y, Float: Z, Float: ANGLE;
	GetPlayerPos(playerid, X, Y, Z);
	GetPlayerFacingAngle(playerid, ANGLE);
	new string[128];
	if(!GetPVarInt(playerid,"block")) {
		if(ObjectShip[playerid] == 0x7F800000) {
			if(IsValidDynamicObject(ObjectShip[playerid])) DestroyDynamicObject(ObjectShip[playerid]);
			GetVehiclePos(veh, X, Y, Z);
			GetVehicleZAngle(veh, ANGLE);
			X -= (5.0 * floatsin(-ANGLE, degrees));
			Y -= (5.0 * floatcos(-ANGLE, degrees));
			Z -= 0.8;
			ObjectShip[playerid] = CreateDynamicObject(2899, X, Y, Z, 0, 0, ANGLE - 90.0);
			SetPVarInt(playerid,"Ships",CreateDynamicSphere(X, Y, Z, 3.5, -1, -1, -1));
			string = "";
			format(string,sizeof(string),"Встановив шипи: %s(%i)",player_name[playerid],playerid);
			ShipText[playerid] = CreateDynamic3DTextLabel(string,-1,X,Y,Z,5.0,INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, 0, 0);
			//ShipText[playerid] =  CreateDynamic3DTextLabel(string, -1, X,Y,Z, 5.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, 1, 0, 0, -1, 15.0,-1,0);
		}
		SetPVarInt(playerid,"block", true);
		SendOK(playerid, "Ви встановили шипи новітньої технології. Вони мають радіокерований інтерфейс.");
		SendOK(playerid, "Цей інтерфейс дає можливість деактивувати шипи на пристойній відстані від них. (/spikes)");
	}
	else {
		DestroyDynamic3DTextLabelEx(ShipText[playerid]);
		if(ObjectShip[playerid] != 0x7F800000) {
			DestroyDynamicObject(ObjectShip[playerid]);
			ObjectShip[playerid] = 0x7F800000;
		}
		DestroyDynamicArea(GetPVarInt(playerid,"Ships"));
		DeletePVar(playerid,"block");
		DeletePVar(playerid,"Ships");
		SendOK(playerid, "Шипи деактивовані.");
	}
	return 1;
}
CMD:patrul(playerid) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	new veh = GetPlayerVehicleID(playerid);
	if(VehicleInfo[veh][vTeam] != fLSPD && VehicleInfo[veh][vTeam] != fRCSO && VehicleInfo[veh][vTeam] != fFBI) return SendError(playerid, "Ви не у поліцейському транспорті.");
	if(GetPVarInt(playerid, "Patrul") == 1) {
		DeletePVar(playerid, "Patrul");
		KillTimer(time_wanted[playerid]);
		DisablePlayerCheckpoint(playerid);
		SendOK(playerid,"Ви закінчили патрулювання.");
		return 1;
	}
	new total_player_online = 0;
	tick_wanted{total_player_online} = 0;
	static const dialog_put_fmt[] = "%s\t%i\n";
	const string_length =
	sizeof(dialog_put_fmt) + 1 +
	(- 2 + MAX_PLAYER_NAME) + // Им'я гравця
	(- 2 + 1);  // Уровень розшуку
	goto skip_array_init;
	new onestring[(string_length * 30) / 4],
	tempstring[string_length];
	skip_array_init:
	new Float:pos[3];
	GetPlayerPos(playerid,pos[0],pos[1],pos[2]);
	onestring = !""W"Ім'я гравця\t"W"Рівень розшуку\n";
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(PI[i][pSearch] > 0) {
			if(!IsPlayerInRangeOfPoint(i, 200.0, pos[0],pos[1],pos[2])) continue;
			format(tempstring, sizeof(tempstring), dialog_put_fmt, player_name[i], PI[i][pSearch]);
			strcat(onestring, tempstring);
			tick_wanted{total_player_online} = i;
			total_player_online = total_player_online + 1;
			if(!total_player_online) return SendError(playerid, "Злочинців у радіусі 200 метрів не виявлено.");
			ShowPlayerDialog(playerid,D_OBC_WANTED,DSTH,"Бортовий комп'ютер",onestring,"Обрати","Скасувати");
		}
	}
	return 1;
}
CMD:obc(playerid) {
	if(!IsACop(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки правоохоронним органам.");
	if(GetPVarInt(playerid, "Patrul") == 1) {
		DeletePVar(playerid, "Patrul");
		KillTimer(time_wanted[playerid]);
		DisablePlayerCheckpoint(playerid);
		SendOK(playerid,"Ви закінчили патрулювання.");
		return 1;
	}
	new veh = GetPlayerVehicleID(playerid);
	if(VehicleInfo[veh][vTeam] != fLSPD && VehicleInfo[veh][vTeam] != fRCSO  && VehicleInfo[veh][vTeam] != fFBI) return SendError(playerid, "Ви не у поліцейському транспорті.");
	ShowPlayerDialog(playerid, D_OBC_LIST,DSL, ""P"Бортовий комп'ютер", ""P"1."W" Список розшукуваних\n"P"2."W" База даних\n"P"3."W" Вхідні виклики", "Обрати", "Закрити");
	return 1;
}
CMD:scan(playerid,params[]) {
	if(PI[playerid][pMember] != fFBI || !start_work[playerid]) return SendError(playerid, "Доступно тільки працівникам ФБР.");
	if(PI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 ранга.");
	if(!PlayerToPoint(3.0,playerid,1491.3950,278.6347,1019.8281) &&
			!PlayerToPoint(3.0,playerid,1494.4558,281.5873,1020.7458)) return SendError(playerid, "Необхідно знаходитись на робочому місці.");
	new giveplayerid;
	if(isnull(params) || strlen(params) > 25) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /scan [playername]");
	sscanf(params, "u", giveplayerid);
	if(giveplayerid == INVALID_PLAYER_ID) return SendError(playerid, "Цей гравець офлайн.");
	ShowPass(giveplayerid,playerid);
	return 1;
}
CMD:hbject(playerid, params[]) {
	if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return 1;
	new giveplayerid, slot = -1, objectid = -1, bone = -1, Float:oX, Float:oY, Float:oZ, Float:rX, Float:rY, Float:rZ, Float:sX, Float:sY, Float:sZ;
	if(sscanf(params, "udddfffffffff", giveplayerid, slot, objectid, bone, oX, oY, oZ, rX, rY, rZ, sX, sY, sZ)) 
	return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /hbject [playerid] [slot (0-9)] [objectid] [1-18]  [x][y][z]  [rx][ry][rz] [sx][sy][sz]");
	
	if(giveplayerid == INVALID_PLAYER_ID) return SendError(playerid, not_id);
	if(!IsPlayerAttachedObjectSlotUsed(giveplayerid, slot)) return SetPlayerAttachedObject(giveplayerid, slot, objectid, bone, oX, oY, oZ, rX, rY, rZ, sX, sY, sZ);
	else {
		RemovePlayerAttachedObject(giveplayerid, slot), 
		SendOK(playerid, "Слот видалено.");
	}
	return 1;
}
CMD:hbjectedit(playerid, params[]) {
	if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return 1;
	new slot_id;
	if(sscanf(params, "d", slot_id)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /hbedit [slot]");
	if(IsPlayerAttachedObjectSlotUsed(playerid, slot_id)) EditAttachedObject(playerid, slot_id);
	return 1;
}
alias:hbjectedit("hbedit");
CMD:getobjectpos(playerid, params[]) {
	if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return 1;
	new Float:x1,Float:y1,Float:z1,string[128],slot;
	if(sscanf(params, "d",slot)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /getobjectpos [lot]");
	GetObjectPos(SlotObject[slot],x1,y1,z1);
	format(string, sizeof(string), "GetDynamicObjectPos %f,%f,%f",x1,y1,z1);
	SendClientMessage(playerid,-1,string);
	return 1;
}
CMD:cobj(playerid, params[]) {
	if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return 1;
	new float:x1,float:y1,float:z1,float:rx1,float:ry1,float:rz1;
	if(sscanf(params, "ddp<,>ffffff", params[0],params[1],x1,y1,z1,rx1,ry1,rz1)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /cobj [slot] [objectid] [x][y][z] [rX][rY][rZ]");
	if(SlotCObject[params[0]] != 0) return 1;
	if(params[0] >= 499) return 1;
	SlotCObject[params[0]] = CreateDynamicObject(params[1],Float:x1,Float:y1,Float:z1,Float:rx1,Float:ry1,Float:rz1);
	new string[128];
	format(string,sizeof(string),"Об'єкт створено. (ID: "ORANGE"%d"W", слот: "ORANGE"%d)",params[1],params[0]);
	SendOK(playerid,string);
	return 1;
}
CMD:dcobject(playerid, params[]) {
	if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return 1;
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /dcobject [slot]");
	if(SlotCObject[params[0]] != 0) {
		DestroyDynamicObject(SlotCObject[params[0]]);
		SlotCObject[params[0]] = 0;
		new string[128];
		format(string,sizeof(string),"Об'єкт знищено. (Слот: "ORANGE"%d)",params[0]);
		SendOK(playerid,string);
	}
	else SendError(playerid, "Слот не знайден.");
	return 1;
}
CMD:obj(playerid, params[]) {
	if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return 1;
	if(!PI[playerid][giveObj]) return SendError(playerid,"У вас немає доступу до цієї команди.");
	if(sscanf(params, "dd", params[0],params[1])) return SendInfo(playerid,"Використайте: /obj [slot] [objectid]");
	if(SlotObject[params[0]] != 0) return 1;
	if(params[0] >= 99) return 1;
	new Float:x1,Float:y1,Float:z1;
	GetPlayerPos(playerid,x1,y1,z1);
	SlotObject[params[0]] = CreateDynamicObject(params[1],x1,y1,z1,0.00,0.00,0.00);
	new string[128];
	format(string,sizeof(string),"Об'єкт створено. "P"(ID: %d, slot: %d)",params[1],params[0]);
	SendOK(playerid,string);
	return 1;
}
CMD:dobject(playerid, params[]) {
	if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return 1;
	if(sscanf(params, "d", params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /dobject [slot]");
	if(SlotObject[params[0]] != 0) {
		DestroyDynamicObject(SlotObject[params[0]]);
		SlotObject[params[0]] = 0;
		new string[128];
		format(string,sizeof(string),"Об'єкт знищено. (Слот: "ORANGE"%d)",params[0]);
		SendOK(playerid,string);
	}
	else SendError(playerid, "Слот не знайдено.");
	return 1;
}
CMD:eobject(playerid, params[]) {
	if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return 1;
	if(sscanf(params, "d", params[0])) { SelectObject(playerid); } else {
		if(SlotObject[params[0]] != 0) {
			EditObject(playerid,SlotObject[params[0]]);
		}
	}
	return 1;
}
stock CheckPlayerDistanceToVehicle(Float:radi, playerid, vehicleid) {
	if(!IsPlayerConnected(playerid)) return 0;
	new Float:PX,Float:PY,Float:PZ,Float:X,Float:Y,Float:Z;
	GetPlayerPos(playerid,PX,PY,PZ);
	GetVehiclePos(vehicleid, X,Y,Z);
	new Float:Distance = (X-PX)*(X-PX)+(Y-PY)*(Y-PY)+(Z-PZ)*(Z-PZ);
	if(Distance <= radi*radi) return 1;
	return 0;
}
CMD:divorce(playerid) {
	if(strlen(PI[playerid][pMarried]) < 10) return SendError(playerid, "Ви не одружені/заміжні.");
	SendOK(playerid, "Ви розлучились.");
	new query[156];
	mysql_format(connects, query, sizeof(query),"UPDATE `accounts` SET `pMarried` = '-' WHERE `pID` = '%d' LIMIT 1",PI[playerid][pID]);
	mysql_pquery(connects, query, "", "");
	strmid(PI[playerid][pMarried], "-", 0, 10);
	return 1;
}
CMD:propose(playerid,params[]) {
	if(strlen(PI[playerid][pMarried]) > 10) return SendError(playerid, "Ви не одружені або заміжні.");
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /propose [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, not_id);
	if(strlen(PI[params[0]][pMarried]) > 10) return SendError(playerid, "Гравець вже знаходиться у шлюбі.");
	if (!IsPlayerStream(8.0, playerid, params[0])) return SendError(playerid, "Гравець далеко від вас.");
	if(params[0] == playerid) return SendError(playerid,not_id);
	if(!PlayerToPoint(10.0, playerid, 2233.2588,-1333.1310,23.9815)) return SendError(playerid, "Ви не біля церкви.");
	new string[144];
	format(string, sizeof(string), "Ви запропонували вийти заміж чи одружитися "W"%s.", player_name[params[0]]);
	SendOK(playerid, string);
	format(string, sizeof(string), ""ORANGE"%s"W" пропонує вам руку і сердце\n\n"YELLOW"Ви хочете прийняти пропозицію?", player_name[playerid]);
	SPD(params[0],D_MARRIED,DSM, ""P"Свадьба",string,"Так","Ні");
	SetPVarInt(params[0],"ProposeOffer",playerid+1);
	return 1;
}
CMD:wbook(playerid, params[]) {
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /wbook [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(SERIU[params[0]][sID] != INVALID_PLAYER_ID) return SendError(playerid, "Гравець дуже далеко.");
	if(GetPlayerDistanceToPlayer(playerid, params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Гравець дуже далеко");
	if(params[0] == playerid) ShowWBook(playerid,params[0]);
	else {
		if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
		
		new string[144];
		
		format(string, sizeof(string), ""P"%s "W"хоче показати вам свою трудову книжку.", player_name[playerid]);
		SendUse(params[0], string);
		SendClientMessage(params[0],COLOR_BLUE,"Натисніть "YES"Y "BLUE"щоб погодитися, або "NO"N "BLUE"для відмови.");
		format(string, sizeof(string), "Ви запропонували "P"%s "W"показати вашу трудову книжку.", player_name[params[0]]);
		SendUse(playerid, string);
		
		SetPVarInt(params[0],"wbook", playerid + 1);
	}
	return 1 ;
}
CMD:medcard(playerid,params[]) {
	if(!PI[playerid][pMedCard]) return SendError(playerid, "У вас немає медичної карти. Отримати її можна в лікарні м. ЛС.");
	if(sscanf(params,"d",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /medcard [id гравця]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, not_id);
	if(GetPlayerDistanceToPlayer(playerid, params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Гравець дуже далеко.");
	if(params[0] == playerid) ShowMedcard(playerid, playerid);
	else {
		if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
		new string[144];
		format(string, sizeof(string), ""P"%s "G"хоче показати вам медичну карту.", player_name[playerid]);
		SendUse(params[0], string);
		SendClientMessage(params[0],COLOR_BLUE,"Натисніть "YES"Y "BLUE"щоб погодитися, або "NO"N "BLUE"для відмови.");
		format(string, sizeof(string), "Ви запропонували "P"%s "G"показати вашу медичну карту.", player_name[params[0]]);
		SendUse(playerid, string);
		SetPVarInt(params[0],"medcard", playerid + 1);
	}
	return 1;
}
CMD:medics(playerid) {
	if(!IsAMedic(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки органам охорони здоров'я.");
	if(PI[playerid][pRank] < 2) return SendError(playerid, "Доступно тільки з 2 рангу.");
	new Float:pos[3];
	GetPlayerPos(playerid,pos[0],pos[1],pos[2]); 
	new bool:callers = false;
	new string[700],str[30];
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(!GetPVarInt(i,"call_medics")) continue;
		if(!IsPlayerInRangeOfPoint(i, 1000.0, pos[0],pos[1],pos[2])) continue;
		format(string,sizeof(string),"%s\n",player_name[i]),strcat(string,str);
		callers = true;
	}
	if(!callers) return SendError(playerid, "Виклики не надходили.");
	ShowPlayerDialog(playerid,D_MEDICS,DSL,""P"Надійшовші виклики",string,"Обрати","Скасувати");
	return 1;
}
CMD:cure(playerid, params[]) {
	if(!IsAMedic(playerid) || !start_work[playerid]) return SendError(playerid, "Доступно тільки органам охорони здоров'я.");
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendInfo(playerid, "Використайте: /cure [playerid]");
	if(giveplayerid == INVALID_PLAYER_ID || giveplayerid == playerid) return SendError(playerid, not_id);
	if(deathphase[giveplayerid] != 1) return SendError(playerid, "Гравень не в стадії.");
	ApplyAnimation(playerid, "BOMBER", "BOM_Plant", 4.1, 0, 1, 1, 1, 0, 0);
	SetTimerEx("CureDeathPlayer", 2670, 0, "ii", playerid, giveplayerid);
	return 1;
}
CMD:clist(playerid) {
	if(PI[playerid][pMember] == 0) return SendError(playerid, "Ви не є членом фракції.");
	if(IsAGang(playerid)) return SendError(playerid, "У банді заборонено вимикати колір нікнейму.");
	if(GetPVarInt(playerid,"color_no") == 0) SetPlayerColor(playerid,0xFFFFFF11), SendOK(playerid,"Ви вимкнули колір нікнейму."), SetPVarInt(playerid,"color_no",1);
	else SetPlayerColor(playerid,gFractionSpawn[PI[playerid][pMember]][fracColor]), SendOK(playerid,"Ви ввімкнули колір нікнейму."), DeletePVar(playerid,"color_no");
	return 1;
}
CMD:tow(playerid, params[]) {
	if(PI[playerid][pJob] != 2) return SendError(playerid, "Ви не працюєте механіком.");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || GetPlayerVehicleID(playerid) != TI[playerid][tArendaCar]) return SendError(playerid, "Ви повинні бути за кермом свого буксира");
	new giveplayerid;
	if(sscanf(params,"u", giveplayerid)) return	SendClientMessage(playerid, COLOR_WHITE,"Використайте: /tow [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid,not_id);
	if(playerid == giveplayerid) return SendError(playerid, "Ви вказали свій ID.");
	if(active_accept(giveplayerid)) return SendError(playerid, "У гравця вже є активна пропозиція.");
	if(!IsPlayerInAnyVehicle(giveplayerid)) return SendError(playerid, "Гравець повинен знаходитися в т/з.");
	if(GetPlayerDistanceToPlayer(playerid,giveplayerid) > 10.0 ||GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(giveplayerid)) return SendError(playerid, "Ви далеко один від одного");
	SetPVarInt(playerid,"towoffer",playerid);
	SetPVarInt(playerid,"towoffee",giveplayerid);
	SetPVarInt(giveplayerid,"towoffer",playerid);
	SetPVarInt(giveplayerid,"towoffee",giveplayerid);
	new string[156];
	format(string,sizeof(string),"Ви запропонували "P"%s"W" відбуксувати транспортний засіб.",player_name[giveplayerid]);
	SendOK(playerid,string);
	format(string,sizeof(string),""W"Механік "P"%s"W" пропонує відбуксувати Ваш транспортний засіб\n\nДля буксування натисніть "YELLOW"'Прийняти'",player_name[playerid]);
	SPD(giveplayerid,D_TOW,DSM, ""P"Буксування",string,"Прийняти","Скасувати");
	return 1;
}
CMD:untow(playerid, params[]) {
	if(GetPVarInt(playerid,"towvid")) {
		new vehicleid = GetPVarInt(playerid,"towvid");
		new trailer = GetPVarInt(playerid,"towactvid");
		SetPVarInt(playerid,"towvid",0);
		SetPVarInt(playerid,"towactvid",0);
		if(GetVehicleTrailer(vehicleid) == trailer)  {
			DetachTrailerFromVehicle(vehicleid);
			SendOK(playerid,"Ваша машина була від'єднана від авто механіка.");
			return 1;
		}
	}
	if(PI[playerid][pJob] != 2) return SendError(playerid, "Ви не працюєте механіком.");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || GetPlayerVehicleID(playerid) != TI[playerid][tArendaCar]) return SendError(playerid, "Ви повинні бути за кермом свого буксира.");
	new vehicleid = GetPlayerVehicleID(playerid);
	new trailer = GetVehicleTrailer(vehicleid);
	if(!trailer) return SendError(playerid, "Ви не буксуєте авто.");
	DetachTrailerFromVehicle(vehicleid);
	SendOK(playerid,"Ви від'єднали авто.");
	return 1;
}
stock GetNearestTrunckEat(playerid) {
	for(new i = 0;i<gBusinessCount;i++) {
		if(gBusiness[i][bizzType] != 1) continue;
		if(PlayerToPoint(10.0,playerid,gBusiness[i][bizzX],gBusiness[i][bizzY],gBusiness[i][bizzZ])) return i;
	}
	return -1;
}
CMD:bhd(playerid) {
	if(PI[playerid][pJob] != 4) return SendError(playerid, "Ви не працюєте розвізником їжі.");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || GetPlayerVehicleID(playerid) != TI[playerid][tArendaCar]) return SendError(playerid, "Ви повинні бути за кермом свого автомобиля для розвезення їжі");
	new i = GetNearestTrunckEat(playerid);
	if(i==-1) return 1;
	new string[156];
	format(string, sizeof(string), "\n\n"W"Вартість "P"1"W" хот-дога: "GREEN"$%d\nВведіть кількість хот-догов, яку Ви хочете закупити:\n\n",gBusiness[i][bizzPrice]*50);
	ShowPlayerDialog(playerid,dEContract,DSI, ""P"Покупка хот-догов",string,"Купити","Скасувати");
	SetPVarInt(playerid,"e_biz",i);
	return 1;
}
CMD:shd(playerid,params[]) {
	if(PI[playerid][pJob] != 4) return SendError(playerid, "Ви не працюєте розвізником їжі.");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || GetPlayerVehicleID(playerid) != TI[playerid][tArendaCar]) return SendError(playerid, "Ви повинні бути за кермом свого автомобиля для розвезення їжі");
	if(sscanf(params,"ii",params[0],params[1])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /shd [playerid] [price]");
	if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
	if(params[1] < 50 || params[1] > 3000) return SendError(playerid, "Вартість не може бути більше $3.000 і менше $50.");
	if(GetPVarInt(playerid,"eatcolvo") < 1) return SendError(playerid, "В автомобилі закінчились хот-доги.");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(!IsPlayerStream(10.0, playerid, params[0])) return SendError(playerid, "Гравець далеко від вас.");
	if(PI[params[0]][pSatiety] == 100) return SendError(playerid, "Гравець не голодний.");
	if(playerid == params[0]) return SendError(playerid, "Ви вказали свій ID.");
	new string[170];
	format(string, sizeof(string), "Ви запропонували "P"%s"W" купити хот-дог за "P"$%d.",player_name[params[0]],params[1]);
	SendUse(playerid, string);
	format(string, sizeof(string), ""P"Продавець хот-догів "W"%s"P" запропонував купити вам хот-дог за "P"$%d\n\nВи погоджуєтеся?",player_name[playerid],params[1]);
	SPD(params[0],dEHotDog,DSM, ""P"Покупка хот-дога",string,"Так","Ні");
	SetPVarInt(playerid,"id_hotdog",params[0] + 1);
	SetPVarInt(playerid,"price_hotdog", params[1]);
	SetPVarInt(params[0],"id_hotdog",playerid + 1);
	return 1;
}
CMD:contract(playerid) {
	if(PI[playerid][pJob] != 2) return SendError(playerid, "Ви не працюєте механіком.");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || GetPlayerVehicleID(playerid) != TI[playerid][tArendaCar]) return SendError(playerid, "Ви повинні бути за кермом свого буксира.");
	new i = GetNearestTrunckFuel(playerid);
	if(i==-1) return 1;
	new string[156];
	format(string, sizeof(string), "\n\n"W"Вартість "P"1"W" літру: "GREEN"$%d\nВкажіть кількість бензину, яку хочете закупити:\n\n",gBusiness[i][bizzPrice]);
	ShowPlayerDialog(playerid,dFContract,DSI, ""P"Купівля палива",string,"Купити","Скасувати");
	SetPVarInt(playerid,"f_biz",i);
	return 1;
}
CMD:refill(playerid,params[]) {
	if(PI[playerid][pJob] != 2) return SendError(playerid, "Ви не працюєте механіком.");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || GetPlayerVehicleID(playerid) != TI[playerid][tArendaCar]) return SendError(playerid, "Ви повинні бути за кермом свого буксира.");
	if(sscanf(params,"iii",params[0],params[1],params[2])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /refill [playerid] [litres] [price]");
	if(params[2] < 50 || params[2] > 3000) return SendError(playerid, "Вартість не може бути больше $3.000 і менше $50.");
	if(GetPVarInt(playerid,"toplivo") < params[2]) return SendError(playerid, "У вас немає стільки палива.");
	if(params[1] < 1 || params[1] > 300) return SendError(playerid, "Значення має бути від 1л до 300л.");
	if(!IsPlayerConnected(params[0]) && params[0] == playerid) return SendError(playerid,not_id);
	if(playerid == params[0]) return SendError(playerid, "Ви вказали свій ID.");
	if(!IsPlayerStream(10.0, playerid, params[0])) return SendError(playerid, "Гравець далеко від вас.");
	if(GetPlayerState(params[0]) != PLAYER_STATE_DRIVER) return SendError(playerid, "Гравець повинен бути в машині.");
	if(VehicleInfo[GetPlayerVehicleID(params[0])][vFuel]+params[1] > gTransport[GetVehicleModel(GetPlayerVehicleID(params[0])) - 400][trTank]) return SendError(playerid, "В машині, яку ви хочете заправити, заповнений бак.");
	new string[170];
	format(string, sizeof(string), "Ви запропонували "P"%s"W" заправити його т/з на "W"%d"G" літрів за "P"$%d.",player_name[params[0]],params[1],params[2]);
	SendUse(playerid, string);
	format(string, sizeof(string), ""P"Механік "P"%s"W" запропонував заправити ваше т/з на "P"%d"W" літрів за "P"$%d.\n\nВи погоджуєтеся?",player_name[playerid],params[1],params[2]);
	SPD(params[0],dRefill,DSM, ""P"Заправка",string,"Так","Ні");
	SetPVarInt(playerid,"id_refill",params[0] + 1);
	SetPVarInt(playerid,"price_refill", params[2]);
	SetPVarInt(playerid,"litres_refill", params[1]);
	SetPVarInt(params[0],"id_refill",playerid + 1);
	return 1;
}
cmd:remp(playerid) {
	if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Не можна використовувати в т/з.");
	new Float:X,Float:Y,Float:Z;
	new vehicleid = GetPlayerVehicleID(playerid);
	new car = GetNearestVehicle(playerid);
	GetVehiclePos(car, X, Y, Z);
	if(IsPlayerInRangeOfPoint(playerid,4,X, Y, Z)) {
		new str[50];
		format(str, sizeof(str),"Огляд %s", gTransport[GetVehicleModel(car)-400][trName]);
		SetPVarInt(playerid,"MechOsmotrVEHID",car);
		SetPVarInt(playerid,"JOBOSMOTR",0);
		new Float:vhealth;
		GetVehicleHealth(car, vhealth);
		new panels_job,doors_job,lights_job,tires_job;
		GetVehicleDamageStatus(car,panels_job,doors_job,lights_job,tires_job);
		
		static const f_str[] = "# Найменування\tСтан\n"P"1."W" Двері\t%s\n"P"2."W" Кузов\t%s\n"P"3."W" Фари\t%s\n"P"4."W" Колеса\t%s\n"P"5."W" Двигун\t%s\n"P"6."W" Акумулятор\t%s\n";
		new string[sizeof(f_str) +128];
		
		format(string,sizeof(string),f_str,!doors_job?(""GREEN"Ідеальне"):(""NO"Потребує ремонту"),!panels_job?(""GREEN"Ідеальне"):(""NO"Потребує ремонту"),!lights_job?(""GREEN"Ідеальне"):(""NO"Потребує ремонту"),!tires_job?(""GREEN"Ідеальне"):(""NO"Потребує ремонту"),vhealth >= 1000?(""GREEN"Ідеальне"):(""NO"Потребує ремонту"),VehicleInfo[vehicleid][vAkum] < 40.0?(""NO"Потребує заміни"):(""GREEN"Ідеальне"));
		ShowPlayerDialog(playerid,D_REPAIR_LIST,DSTH,str,string,"Оглянути","Скасувати");
		return 1;
	}
	else return SendError(playerid, "Ви далеко від т/з.");
}
CMD:repair(playerid, params[]) {
	if(PI[playerid][pJob] != 2) return SendError(playerid, "Ви не працюєте механіком.");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || GetPlayerVehicleID(playerid) != TI[playerid][tArendaCar]) return SendError(playerid, "Ви повинні бути за кермом свого буксира.");
	new price,giveplayerid;
	if(sscanf(params,"ud",giveplayerid,price)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /repair [playerid] [amount]");
	if(price < 100 || price > 1000) return SendError(playerid, "Вартість не повинна бути нижче $100 і вище $1.000.");
	if(!IsPlayerConnected(giveplayerid) && giveplayerid == playerid) return SendError(playerid,not_id);
	if(GetPlayerState(giveplayerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "Гравець повинен бути за кермом автомобиля.");
	if(GetPlayerDistanceToPlayer(playerid,giveplayerid) > 10.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(giveplayerid)) return SendError(playerid, "Ви далеко один від одного.");
	if(GetPVarInt(giveplayerid,"repairprice") > 0) return SendError(playerid, "У гравця вже є активна пропозиція.");
	SetPVarInt(playerid,"repairoffee",giveplayerid);
	SetPVarInt(giveplayerid,"repairoffer",playerid);
	SetPVarInt(giveplayerid,"repairoffee",giveplayerid);
	SetPVarInt(giveplayerid,"repairprice",price);
	new string[142];
	format(string, sizeof(string), "Ви запропонували "P"%s"W" відремонтувати його т/з за "P"$%d.",player_name[giveplayerid],price);
	SendUse(playerid, string);
	format(string, sizeof(string), "Механік "P"%s"W" запропонував відремонтувати ваше т/з за "P"$%d.",player_name[playerid],price);
	SendUse(giveplayerid, string);
	SendClientMessage(giveplayerid,COLOR_BLUE,"Натисніть "YES"Y "BLUE"щоб погодитися, або "NO"N "BLUE"для відмови.");
	return 1;
}
CMD:repairs(playerid) {
	if(PI[playerid][pJob] != 2) return SendError(playerid, "Ви не працюєте механіком.");
	new veh = GetPlayerVehicleID(playerid);
	if(VehicleInfo[veh][vJob] != 2) return SendError(playerid, "Ви не в автомобілі механіка.");
	new Float:pos[3];
	GetPlayerPos(playerid,pos[0],pos[1],pos[2]); 
	new bool:callers = false;
	new string[700],str[30];
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(!GetPVarInt(i,"call_mechanics")) continue;
		if(!IsPlayerInRangeOfPoint(i, 1000.0, pos[0],pos[1],pos[2])) continue;
		format(string,sizeof(string),"%s\n",player_name[i]),strcat(string,str);
		callers = true;
	}
	if(!callers) return SendError(playerid, "Виклики не надходили.");
	ShowPlayerDialog(playerid,D_REPAIRS,DSL,""P"Вхідні виклики",string,"Обрати","Скасувати");
	return 1;
}
CMD:offgettime(playerid, const params[])  {
	new input[50];
	if(PI[playerid][pAdmin] < 3 || dostup[playerid] == 0) return 1;
	if(sscanf(params,"p< >s[24]",params)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /offgettime [нік]");
	mysql_escape_string(params, input);
	new rows;
	new query[250], string[550],header[64];
	new b_date[15], online[15], afk[15];
	format(header, sizeof(header),""P"Офлайн статистика: %s",input);
	format(string, sizeof(string),""ORANGE"Дата\t"ORANGE"Онлайн за день\t"ORANGE"AFK за день\n");
	format(string, sizeof(string),"%s"ORANGE"Рік-Місяць-Число\t"ORANGE"ГГ:ХХ:СС\t"ORANGE"ГГ:ХХ:СС\n",string);
	mysql_format(connects, query, sizeof(query), "SELECT `date`, SEC_TO_TIME(`online_sec`-`afk_sec`) as online, SEC_TO_TIME(`afk_sec`) as afk FROM `online_player` WHERE `accountid` = (SELECT `pID` FROM `accounts` WHERE `Name` LIKE '%e') ORDER BY `id` DESC LIMIT 7",input);
	new Cache:result = mysql_query(connects, query);
	cache_get_row_count(rows);
	if(rows) {
		for(new i = 0; i < rows; i++){
			cache_get_value_name(i, "date",b_date,sizeof(b_date));
			cache_get_value_name(i, "online",online,sizeof(online));
			cache_get_value_name(i, "afk",afk,sizeof(afk));
			format(string, sizeof(string),"%s"W"%s\t"W"%s\t"W"%s\n",string,b_date,online,afk);
		}
		ShowPlayerDialog(playerid, DIALOG_NONE, DSTH, header,string, "Закрити", "");
	}
	else SendError(playerid, "Такого акаунта не існує.");
	cache_delete(result);
	return 1;
}
CMD:leaders(playerid) {
	new countleader = 0;
	new string[1650];
	new leader[25];
	format(string, sizeof(string),""W"Фракція\t"W"Лідер\t"W"Номер\t"W"Статус\n");
	//format(string, sizeof(string),"%s"ORANGE"Заместители організацій - /subleaders\n",string);
	for(new i = 1;i < MAX_FRACTIONS;i ++) {
		if(!strcmp(FI[i][fLeader],"None",true)) strmid(leader,"Відсутній", 0, strlen("Відсутній"), 25);
		else strmid(leader,"Відсутній", 0, strlen("Відсутній"), 25);
		new idFrac = GetCheckID(FI[i][fLeader]);
		if(!GetString(FI[i][fName],"Зачинено"))
		{
			if(idFrac != INVALID_PLAYER_ID)
			{
				format(string, sizeof(string),"%s"W"%s\t"W"%s[%d]%s\t"W"т. %d\t"GREEN"Онлайн\n",string,FI[i][fName],player_name[idFrac],idFrac,TI[idFrac][tAFK]>=3?("{ffa800}[AFK]"):(""),PI[idFrac][pPhone]);
				countleader++;
			}
			else
			{
				if(!strcmp(FI[i][fLeader],"None",true)) format(string, sizeof(string),"%s"W"%s\t"ORANGE"Відсутній лідер\n",string,FI[i][fName]);
				else format(string, sizeof(string),"%s"W"%s\t"W"%s\t"W"-\t"NO"офлайн\n",string,FI[i][fName],FI[i][fLeader]);
			}
		}
	}
	format(string, sizeof(string), "%s\n"ORANGE"В мережі %i лідерів", string,countleader);
	ShowPlayerDialog(playerid, DIALOG_NONE, DSTH, ""P"Лідери організацій",string, "Закрити", "");
	return 1;
}
CMD:subleaders(playerid) {
	new countleader = 0;
	new string[1650];
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(PI[i][pMember] == 0) continue;
		if(PI[i][pLeader] != 0) continue; 
		if(PI[i][pRank] < FI[PI[i][pMember]][fMaxRang]-1) continue;
		if(PI[i][pAdmin]) continue;
		format(string, sizeof(string), "%s"G"%s [%d] - [т. %d] - %s %s\n", string, player_name[i], i,PI[i][pPhone], FI[PI[i][pMember]][fName],TI[i][tAFK]>=3?("{ffa800}[AFK]"):(""));
		countleader++;
	}
	if(countleader > 0) {
		format(string, sizeof(string), "%s\n"ORANGE"В мережі %i заступників", string,countleader);
		ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Заступники організацій",string, "Закрити", "");
	}
	else ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Заступники організацій",""W"Немає заступників у мережі", "Закрити", "");
	return 1;
}
CMD:fwarn(playerid, params[]) {
	if(!PI[playerid][pMember]) return 1;
	new string[156];
	if(PI[playerid][pRank] < FI[PI[playerid][pMember]][fUninviteRang]) {
		format(string,sizeof(string),"Ця функція доступна з %i рангу.", FI[PI[playerid][pMember]][fUninviteRang]);
		SendError(playerid,string);
		return 1;
	}
	if(sscanf(params, "ds[128]",params[0],params[1])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /fwarn [playerid] [причина]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(PI[params[0]][pMember] != PI[playerid][pMember] || PI[playerid][pRank] <= PI[params[0]][pRank]) return SendError(playerid, "Гравець не в вашій організації або вище за вас рангом.");
	if(IsAIP(params[1])) return 1;
	PI[params[0]][pfWarn] ++;
	UpdatePlayerData(params[0],"fwarn",PI[params[0]][pfWarn]);
	FracLog(LOGS_FWARN,player_name[playerid],player_name[params[0]],params[1]);
	if(PI[params[0]][pfWarn]>=3) {
		if(start_work[params[0]]) {
			SendInfo(params[0],"Робочий день завершено.");
			start_work[params[0]] = 0;
			UpdatePlayerData(params[0],"FracDuty",start_work[params[0]]);
		}
		add_jobinfo(params[0],params[1]);
		PI[params[0]][pRank] = 0;
		PI[params[0]][pMember] = 0;
		PI[params[0]][pJob] = 0;
		PI[params[0]][pFracSkin] = 0;
		SetPlayerColor(params[0],0xFFFFFF11);
		skin_player(params[0]);
		PI[params[0]][pfWarn] = 0;
		UpdatePlayerData(params[0],"pMember",PI[params[0]][pMember]);
		UpdatePlayerData(params[0],"pJob",PI[params[0]][pJob]);
		UpdatePlayerData(params[0],"fwarn",0);
		UpdatePlayerData(params[0],"pModel",PI[params[0]][pFracSkin]);
		format(string, sizeof(string), "[F] %s видав догану і звільнив гравця %s (3/3). Причина: %s.",player_name[playerid],player_name[params[0]],params[1]);
		SendFamilyMessage(PI[playerid][pMember],COLOR_LIGHTRED,string);
		FracLog(LOGS_UNINVITE,player_name[playerid],player_name[params[0]],params[1]);
		return 1;
	}
	format(string, sizeof(string), "[F] %s видав догану гравцю %s (%i/3). Причина: %s.",player_name[playerid],player_name[params[0]],PI[params[0]][pfWarn],params[1]);
	SendFamilyMessage(PI[playerid][pMember],COLOR_LIGHTRED,string);
	return 1;
}
CMD:funwarn(playerid, params[]) {
	if(!PI[playerid][pMember]) return 1;
	new string[156];
	if(PI[playerid][pRank] < FI[PI[playerid][pMember]][fUninviteRang]) {
		format(string,sizeof(string),"Ця функція доступна з %i рангу.", FI[PI[playerid][pMember]][fUninviteRang]);
		SendError(playerid,string);
		return 1;
	}
	if(sscanf(params, "ds[128]",params[0],params[1])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /funwarn [playerid] [reason]");
	if(!PI[params[0]][pfWarn]) return SendError(playerid, "У цього гравця немає доган.");
	if(PI[params[0]][pMember] != PI[playerid][pMember] || PI[playerid][pRank] <= PI[params[0]][pRank]) return SendError(playerid, "Гравець не в вашій організації або вище за вас рангом.");
	PI[params[0]][pfWarn]--;
	UpdatePlayerData(params[0],"fwarn",PI[params[0]][pfWarn]);
	format(string, sizeof(string), "[F] %s зняв догану гравцю %s. Причина: %s.",player_name[playerid],player_name[params[0]],params[1]);
	SendFamilyMessage(PI[playerid][pMember],COLOR_LIGHTRED,string);
	FracLog(LOGS_FUNWARN,player_name[playerid],player_name[params[0]],params[1]);
	return 1;
}
CMD:members(playerid) {
	if(!PI[playerid][pMember]) return SendError(playerid, "Ви не перебуваєте в організації.");
	new ids = 0;
	new string[3000],str[128];
	strcat(str,"ID\tРанг\tТелефон\tДогани\tІм'я"W"\n\n");
	strcat(string,str);
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(PI[i][pMember] != PI[playerid][pMember])continue;
		if(PI[i][pRank] < 1 || PI[i][pMember] < 1) continue;
		if(PI[i][pAdmin]) continue;
		format(str, sizeof(str), "%d\t%d\t%d\t\t%d/3\t\t%s %s %s\n",i,PI[i][pRank],PI[i][pPhone],PI[i][pfWarn],player_name[i],(start_work[i]) ? ("[На роботі]") : ("[Не на роботі]"),(TI[i][tAFK] > 3) ? (""P"[AFK]"W""):(""));
		strcat(string,str);
		ids++;
	}
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, ""P"Члены організації онлайн", string, "Закрити", "");
	new strr[128];
	format(strr,sizeof(strr),"Всього гравців в організації: "ORANGE"%d",ids);
	SendOK(playerid,strr);
	return 1;
}
CMD:invite(playerid, params[]) {
	if(!PI[playerid][pMember]) return SendError(playerid, "Ви не є членом будь-якої організації.");
	if(!start_work[playerid]) return SendError(playerid, "Необхідно розпочати робочий день.");
	new string[128];
	if(PI[playerid][pRank] < FI[PI[playerid][pMember]][fInviteRang]) {
		format(string,sizeof(string),"Ця функція доступна з %i рангу.", FI[PI[playerid][pMember]][fInviteRang]);
		SendError(playerid,string);
		return 1;
	}
	if(sscanf(params,"d",params[0])) return	SendClientMessage(playerid, COLOR_WHITE,"Використайте: /invite [playerid]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return SendError(playerid,not_id);
	if(PI[params[0]][pMember] > 0) return SendError(playerid, "Гравець є членом вашої організації.");
	if(PI[params[0]][pWarns] >= 1) return SendError(playerid, "У гравця є активне попередження.");
	if(IsBLName(PI[params[0]][pID],PI[playerid][pMember])) return SendError(playerid, "Гравець в ЧС вашої організації.");
	if(!IsPlayerStream(7.0, playerid, params[0])) return SendError(playerid, "Ви далеко від гравця.");
	if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
	switch(PI[playerid][pMember]) {
	case fLSPD,fRCSO: {
			if(PI[params[0]][pLevel] < invite_frac[0]) {
				format(string,sizeof(string),"У гравця повинен бути %i рівень.", invite_frac[0]);
				SendError(playerid,string);
				return 1;
			}
		}
	case fFBI: {
			if(PI[params[0]][pLevel] < invite_frac[1]) {
				format(string,sizeof(string),"У гравця повинен бути %i рівень.", invite_frac[1]);
				SendError(playerid,string);
				return 1;
			}
		}
	case fARMYLS: {
			if(PI[params[0]][pLevel] < invite_frac[2]) {
				format(string,sizeof(string),"У гравця повинен бути %i рівень.", invite_frac[2]);
				SendError(playerid,string);
				return 1;
			}
		}
	case fMEDICLS,fMEDICSF,fMEDICLV: {
			if(PI[params[0]][pLevel] < invite_frac[3]) {
				format(string,sizeof(string),"У гравця повинен бути %i рівень.", invite_frac[3]);
				SendError(playerid,string);
				return 1;
			}
		}
	case fLSNEWS,fSFNEWS,fLVNEWS: {
			if(PI[params[0]][pLevel] < invite_frac[4]) {
				format(string,sizeof(string),"У гравця повинен бути %i рівень.", invite_frac[4]);
				SendError(playerid,string);
				return 1;
			}
		}
	case fLCN,fYAKUZA,fRM,fBikers,fBikersTwo: {
			if(PI[params[0]][pLevel] < invite_frac[5]) {
				format(string,sizeof(string),"У гравця повинен бути %i рівень.", invite_frac[5]);
				SendError(playerid,string);
				return 1;
			}
		}
	case fBALLAS,fVAGOS,fGROVE,fAZTEC,fRIFA: {
			if(PI[params[0]][pLevel] < invite_frac[6]) {
				format(string,sizeof(string),"У гравця повинен бути %i рівень.", invite_frac[6]);
				SendError(playerid,string);
				return 1;
			}
		}
	case fWHITEHOUSE: {
			if(PI[params[0]][pLevel] < invite_frac[7]) {
				format(string,sizeof(string),"У гравця повинен бути %i рівень.", invite_frac[7]);
				SendError(playerid,string);
				return 1;
			}
		}
	}
	new mes[400];
	for(new i; i < 14;i++) {
		new skinid = gFractionSkin[PI[playerid][pMember]][i];
		if(!skinid) break;
		if(skinid == PI[params[0]][pFracSkin]) {
			if(!i) format(mes,sizeof(mes),""P"Скін %d [%d]",i+1,skinid);
			else format(mes,sizeof(mes),"%s\n"P"Скін %d [%d]",mes,i+1,skinid);
		}
		else {
			if(!i) format(mes,sizeof(mes),"Скін %d [%d]",i+1,skinid);
			else format(mes,sizeof(mes),"%s\nСкін %d [%d]",mes,i+1,skinid);
		}
	}
	ShowPlayerDialog(playerid,dInviteSkin,DSL,player_name[params[0]],mes,"Прийняти","");
	SetPVarInt(playerid,"invkot",params[0]);
	return 1;
}
CMD:uninvite(playerid, params[]) {
	if(!PI[playerid][pMember]) return SendError(playerid, "Ви не перебуваєте в організації.");
	if(!start_work[playerid]) return SendError(playerid, "Необхідно розпочати робочий день.");
	new string[156];
	if(PI[playerid][pRank] < FI[PI[playerid][pMember]][fUninviteRang]) {
		format(string,sizeof(string),"Ця функція доступна з %i рангу.", FI[PI[playerid][pMember]][fUninviteRang]);
		SendError(playerid,string);
		return 1;
	}
	if(sscanf(params, "ds[128]",params[0],params[1])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /uninvite [playerid] [причина]");
	if(params[0] == playerid) return SendError(playerid,not_id);
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return SendError(playerid,not_id);
	if(IsAIP(params[1])) return 1;
	if(PI[params[0]][pLeader] >= 1) return SendError(playerid, "Ви не можете звільнити лідера.");
	if(PI[playerid][pLeader] <= 0 && PI[playerid][pRank] <= PI[params[0]][pRank]) return SendError(playerid, "Ваш ранг недостатній.");
	if(PI[params[0]][pMember] == 0) return SendError(playerid, "Гравець не є членом вашої організації.");
	if(PI[params[0]][pMember] == PI[playerid][pLeader] || PI[params[0]][pMember] == PI[playerid][pMember]) {
		if(PI[params[0]][pMember] > 0) {
			format(string, sizeof(string),""P"%s"W" звільнив вас з організації. Причина: %s.", player_name[playerid],params[1]);
			SendUse(params[0],string);
			format(string, sizeof(string),""P"%s"W" звільнений з організації. Причина: %s.", player_name[params[0]],params[1]);
			SendUse(playerid, string);
			if(start_work[params[0]]) {
				SendInfo(params[0],"Робочий день завершено.");
				start_work[params[0]] = 0;
				UpdatePlayerData(params[0],"FracDuty",start_work[params[0]]);
			}
			if(IsAGang(params[0]) && GetPVarInt(params[0], "ppkz")) EndCapt(params[0]);
			if(GetPlayerState(params[0]) == PLAYER_STATE_DRIVER) RemovePlayerFromVehicleAC(params[0]);
			add_jobinfo(params[0],params[1]);
			PI[params[0]][pRank] = 0;
			PI[params[0]][pMember] = 0;
			PI[params[0]][pJob] = 0;
			PI[params[0]][pFracSkin] = 0;
			PI[params[0]][pZahvat] = 0;
			SetPlayerColor(params[0],0xFFFFFF11);
			skin_player(params[0]);
			SetArmour(params[0], 0);
			ResetPlayerWeapons(params[0]);
			
			UpdatePlayerData(params[0],"pModel",PI[params[0]][pFracSkin]);
			UpdatePlayerData(params[0],"pMember",PI[params[0]][pMember]);
			UpdatePlayerData(params[0],"pRank",PI[params[0]][pRank]);
			UpdatePlayerData(params[0],"pJob",PI[params[0]][pJob]);
			UpdatePlayerData(params[0],"zahvat",PI[params[0]][pZahvat]);
			
			PI[params[0]][pAdvert] = 0;
			UpdatePlayerData(params[0],"Advert", 0);
			
			FracLog(LOGS_INVITE,player_name[playerid],player_name[params[0]],params[1]);
		}
	}
	return 1;
}
CMD:leave(playerid) {
	if(PI[playerid][pLeader]) return SendError(playerid, "Лідеру заборонено виходити з фракції.");
	if(!PI[playerid][pPremium]) return SendError(playerid, "У вас немає преміум-акаунта.");
	if(!PI[playerid][pMember]) return SendError(playerid, "Ви не перебуваєте в організації.");
	if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Не можна використовувати в машині.");
	ShowPlayerDialog(playerid,D_LEAVE,DSM, ""P"Звільнення", "\n\n"W"Ви дійсно хочете покинути організацію за власним бажанням?\n\n", "Покинути", "Скасувати");
	return 1;
}
CMD:truck(playerid) {
	if(!IsATK(playerid)) return SendError(playerid, "Ви не працівник транспортной компанії");
	ShowPlayerDialog(playerid,D_TK_TRUCK,DSTH,""P"Меню замовлень",""W"Назва\t"W"Груз\t"W"Вартість\n"G"- Завантажитися на складі\n"P"1."W" Лісопильня\tІнструменти\t"GREEN"$15.000\n"P"2."W" Ферма\tДобрива\t"GREEN"$11.000\n"P"3."W" Будівництво\tБудматеріали\t"GREEN"$12.000\n\
"P"4."W" Завод з виготовлення зброї\tМатеріали\t"GREEN"$11.500\n"P"5."W" Montgomery\tПродукти\t"GREEN"$12.500\n"P"6."W" Palomino Creek\tПродукти\t"GREEN"$12.200","Обрати","Скасувати");
	return 1;
}
alias:tr("trs");
CMD:tr(playerid, params[]) {
	if(!IsATK(playerid)) return 1;
	if(PI[playerid][pMute] > 0) return SendError(playerid, "У вас бан чата.");
	new string[144];
	if(isnull(params) || strlen(params) > 100) return SendClientMessage(playerid,COLOR_WHITE,"Введіть: /tr [text]");
	format(string, sizeof(string), "[TRUCK] [%s] %s: %s",tk_class[PI[playerid][bizz_status]-1],player_name[playerid],params);
	BizzMSG(PI[playerid][bizz_work],COLOR_YELLOW,string);
	return 1;
}
CMD:trspcar(playerid) {
	if(!IsATK(playerid)) return SendError(playerid, "Ви не працівник транспортной компанії.");
	if(PI[playerid][bizz_status] < 2) return SendError(playerid, "Ця функція доступна тільки керівнику транспортної компанії.");
	new string[128];
	for(new i = GetVehiclePoolSize()+1; --i != 0;)  {
		if(VehicleInfo[i][vBizz] != PI[playerid][bizz_work]) continue;
		if(IsVehicleOccupied(i)) continue;
		LinkVehicleToInterior(i, 0);
		SetVehicleVirtualWorld(i, 0);
		SetVehicleToRespawn(i);
	}
	format(string, sizeof(string), "[TRUCK] [%s] %s заспавнив незайняті вантажівки.",tk_class[PI[playerid][bizz_status]-1],player_name[playerid]);
	BizzMSG(PI[playerid][bizz_work],COLOR_YELLOW,string);
	return 1;
}
stock invitetrS(playerid)
{   
    if(PI[playerid][bizz_work] == 61) return SendError(playerid, "Ви вже працюєте в транспортной компанії.");
	if(PI[playerid][pLevel] < 2) return SendError(playerid, "У Вас недостатній рівень для цієї роботи. Необхідно мати 2 рівень.");
	if(GetPVarInt(playerid, "tk_id")) return SendError(playerid, "У вас вже є активна пропозиція.");
	ShowPlayerDialog(playerid, D_ACCEPTS_TS, DSM,"Працевлаштування","Ви дійсно хочете влаштуватися у транспортну компанію?","Так","Ні");
	return 1;
}
CMD:uninviteleave(playerid) return PI[playerid][bizz_work] = 0;
CMD:trinvite(playerid, params[]) {
	if(!IsATK(playerid)) return SendError(playerid, "Ви не працівник транспортной компанії.");
	if(PI[playerid][bizz_status] < 2) return SendError(playerid, "Ця функція доступна тільки керівнику транспортної компанії.");
	new taxi = PI[playerid][bizz_work];
	if(sscanf(params,"d",params[0])) return	SendClientMessage(playerid, COLOR_WHITE, "Введіть: /trinvite [playerid]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return SendError(playerid, not_id);
	if(params[0] == playerid) return SendError(playerid, not_id);
	if(!IsPlayerStream(7.0, playerid, params[0])) return SendError(playerid, "Ви далеко від гравця.");
	if(PI[params[0]][pLevel] < 2) return SendError(playerid, "У гравця недостатній рівень для цієї роботи. Необхідно мати 2 рівень.");
	if(IsPlayerInAnyVehicle(params[0])) return SendError(playerid, "Гравець в машині.");
	if(PI[params[0]][bizz_work] == 61) return SendError(playerid, "Цей гравець вже працює в транспортной компанії");
	if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
	new mes[128];
	format(mes,sizeof(mes),"Ви запропонували "P"%s"W" вступити в транспортну компанію.",player_name[params[0]]);
	SendUse(playerid,mes);
	format(mes,sizeof(mes),""P"%s"W" хоче влаштувати вас в транспортну компанію.",player_name[playerid]);
	SendUse(params[0],mes);
	SendClientMessage(params[0],COLOR_BLUE,"Натисніть "YES"Y "BLUE"щоб погодитися, або "NO"N "BLUE"для відмови.");
	SetPVarInt(params[0], "tk_id", taxi);
	return 1;
}
CMD:taxi(playerid,params[]) {
	if(PI[playerid][pJob] != 8) return SendError(playerid, "Ви не водій таксі.");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || GetPlayerVehicleID(playerid) != GetPVarInt(playerid,"veh_id_taxi")) return SendError(playerid, "Ви повинні бути за кермом такси.");
	if(sscanf(params,"u",params[0])) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /taxi [playerid]");
	if(params[0] == playerid) return SendError(playerid, "Ви не можете запросити місце призначення в самого себе.");
	if(!IsPlayerConnected(params[0])) return SendError(playerid,not_id);
	if(GetPlayerState(params[0]) != PLAYER_STATE_PASSENGER || GetPlayerVehicleID(params[0]) != GetPlayerVehicleID(playerid)) return SendError(playerid, "Гравець повинен сидіти на пасажирському місці у вашому таксі.");
	new mes[128];
	format(mes,sizeof(mes),"Гравцю %s відправлено запит на отримання даних про місце призначення.",player_name[params[0]]);
	SendClientMessage(playerid,0x3399FFFF,mes);
	format(mes,sizeof(mes),"Водій такси "P"%s"W" запросив дані про місце призначення.",player_name[playerid]);
	SendClientMessage(params[0],0x3399FFFF,mes);
	SendClientMessage(params[0],0x3399FFFF,"Відкрийте карту і поставте правою кнопкою миші мітку туди, куди хочете відправитися.");
	SetPVarInt(params[0],"selectpoint",1);
	SetPVarInt(params[0],"taxidriver",playerid);
	return 1;
}
CMD:fare(playerid, params[])
{
	new tar[15], string[200], slog[36];
	new veh = GetPlayerVehicleID(playerid);
	if(PI[playerid][pJob] != 8) return SendError(playerid, "Ви не водій таксі.");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || GetPlayerVehicleID(playerid) != GetPVarInt(playerid,"veh_id_taxi")) return SendError(playerid, "Ви повинні бути за кермом таксі.");
	if(!VehicleInfo[veh][vTarif]) format(tar,15,"Не встановлений");
	else format(tar,15,"%d$",VehicleInfo[veh][vTarif]);
	if(!VehicleInfo[veh][vSlog]) format(slog,36,"Не встановлений");
	else format(slog,36,"%s",VehicleInfo[veh][vSlog]);
	format(string,150,""P"1."W"Змінити тариф\t%s\n"P"2."W" Змінити слоган\t%s",tar, slog);
	ShowPlayerDialog(playerid,D_TAXI_FARE,DST,""P"TAXI",string,"Обрати","Скасувати");
	return 1;
}
CMD:untaxi(playerid,params[]) {
	if(PI[playerid][pJob] != 8) return SendError(playerid, "Ви не водій таксі.");
	RemovePlayerMapIcon(playerid,iconTaxi);
	SendOK(playerid,"Мітка прибрана з карти.");
	return 1;
}
CMD:bl(playerid) {
	if(!PI[playerid][pMember]) return 1;
	if(PI[playerid][pRank] < FI[PI[playerid][pMember]][fInviteRang]) {
		new string[128];
		format(string, sizeof(string), "Доступно з %d рангу.", FI[PI[playerid][pMember]][fInviteRang]);
		SendError(playerid, string);
		return 1 ;
	}
	ShowPlayerDialog(playerid,D_BL,DSL,""P"Чорний список", ""P"1."W" Внести в ЧС\n"P"2."W" Винести з ЧС\n"P"3."W" Очистити повний список ЧС\n"P"4."W" Список занесених в ЧС", "Обрати", "Закрити");
	return 1;
}
CMD:offmembers(playerid) {
	if(!PI[playerid][pLeader]) return 1;
	ShowPlayerDialog(playerid, d_offmembers_selection, DSL, ""P"Члени організації", ""P"1."W" Всі члени організації офлайн\n"P"2."W" Фільтр по рангу", "Обрати", "Скасувати");
	return 1;
}
