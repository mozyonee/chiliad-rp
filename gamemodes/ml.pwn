			UpdateFraction(fWHITEHOUSE,"Bank",FI[fWHITEHOUSE][fBank]);
			FI[fWHITEHOUSE][fBankCash] += salary;
			UpdateFraction(fWHITEHOUSE,"BankCash",FI[fWHITEHOUSE][fBankCash]);
			static const f_string[] = "Ви зняли з казни штата "GREEN"$%d"W".";
