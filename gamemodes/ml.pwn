	case fGROVE: namegang = "Grove Street";
	case fAZTEC: namegang = "Varrios Los Aztecas";
	case fBALLAS: namegang = "East Side Ballas";
	case fRIFA: namegang = "Rifa";
	case fVAGOS: namegang = "Los Santos Vagos";
	}
	return namegang;
}
