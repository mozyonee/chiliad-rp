	case D_DUEL_ENTER_PSW: {
			if(!response) return 1;
			if(DI[GetPVarInt(playerid, "duel_number")][duel_owner_id] == INVALID_PLAYER_ID) return SendError(playerid, "Вибране лобі недоступне");
			if(DI[GetPVarInt(playerid, "duel_number")][duel_start] == true) return SendError(playerid, "Вибране лобі недоступне");
			if(strval(inputtext) != DI[GetPVarInt(playerid, "duel_number")][duel_password]) {
				ShowPlayerDialog(playerid,D_DUEL_ENTER_PSW,DSI,""P"Лобі | вхід","\n\n"W"Для входу в лобі введіть пароль:\n"NO"*"G" Невірний пароль\n\n","Увійти","Скасувати");
				return 1;
			}
			duel_enter(playerid,GetPVarInt(playerid, "duel_number"));
		}
	case D_DUEL_1: {
			if(!response) {
				duel_delete(TI[playerid][tDuel],true);
				return 1;
			}
			if(listitem != 9) {
				if(DI[TI[playerid][tDuel]][duel_create] == true) return SendError(playerid, "Заборонено змінювати після створення лобі");
			}
			switch(listitem) {
			case 0: {
					DI[TI[playerid][tDuel]][duel_type] = (DI[TI[playerid][tDuel]][duel_type] == 0) ? 1 : (DI[TI[playerid][tDuel]][duel_type] == 1) ? 2 : 0;
					duel_message(playerid,TI[playerid][tDuel]);
				}
			case 1: {
					DI[TI[playerid][tDuel]][duel_raund] = (DI[TI[playerid][tDuel]][duel_raund] == 1) ? 3 : (DI[TI[playerid][tDuel]][duel_raund] == 3) ? 5 : (DI[TI[playerid][tDuel]][duel_raund] == 5) ? 11 : 1;
					duel_message(playerid,TI[playerid][tDuel]);
				}
			case 2: {
					ShowPlayerDialog(playerid,D_DUEL_MONEY,DSI, ""P"Взнос","\n\n"W"Введіть суму внеску:\n\n\
																Мінімальний внесок: "ORANGE"$1000\n\
																"W"Максимальний внесок: "ORANGE"$50000","Змінити","Скасувати");
				}
			case 3: {
					DI[TI[playerid][tDuel]][duel_gun] = (DI[TI[playerid][tDuel]][duel_gun] == 0) ? 1 : (DI[TI[playerid][tDuel]][duel_gun] == 1) ? 2 : (DI[TI[playerid][tDuel]][duel_gun] == 2) ? 3 : (DI[TI[playerid][tDuel]][duel_gun] == 3) ? 4 : 0;
					duel_message(playerid,TI[playerid][tDuel]);
				}
			case 4: {
					DI[TI[playerid][tDuel]][duel_gun_2] = (DI[TI[playerid][tDuel]][duel_gun_2] == 0) ? 1 : (DI[TI[playerid][tDuel]][duel_gun_2] == 1) ? 2 : (DI[TI[playerid][tDuel]][duel_gun_2] == 2) ? 3 : (DI[TI[playerid][tDuel]][duel_gun_2] == 3) ? 4 : (DI[TI[playerid][tDuel]][duel_gun_2] == 4) ? 5 : 0;
					duel_message(playerid,TI[playerid][tDuel]);
				}
			case 5: {
					DI[TI[playerid][tDuel]][duel_map] = (DI[TI[playerid][tDuel]][duel_map] == 0) ? 1 : (DI[TI[playerid][tDuel]][duel_map] == 1) ? 2 : 0;
					duel_message(playerid,TI[playerid][tDuel]);
				}
			case 6: {
					ShowPlayerDialog(playerid,D_DUEL_HEALTH,DSI, ""P"Здоровье","\n\n"W"Введіть Стан здоров'я на дуелі:\n\n\
																Мінімальний Стан: "P"10\n\
																"W"Максимальний Стан: "P"200","Змінити","Скасувати");
				}
			case 7: {
					ShowPlayerDialog(playerid,D_DUEL_ARMOUR,DSI, ""P"Броня","\n\n"W"Введіть Стан броні на дуелі:\n\n\
																Мінімальний Стан: "P"0\n\
																"W"Максимальний Стан: "P"100","Змінити","Скасувати");
				}
			case 8: {
					ShowPlayerDialog(playerid,D_DUEL_PASSWORD,DSI, ""P"Пароль","\n\n"W"Введіть пароль для входу до лобі:\n\n\
																Пароль повинен складатися з 4 цифр:","Змінити","Скасувати");
				}
			case 9: {
					if(DI[TI[playerid][tDuel]][duel_create] == false)
					{
						if(DI[TI[playerid][tDuel]][duel_type] == 2 && DI[TI[playerid][tDuel]][duel_map] != 2) return SendError(playerid, "Для гри в режимі 3х3 використовується лише карта #3");
						if(GetPlayerMoneyEx(playerid) < DI[TI[playerid][tDuel]][duel_money]) {
							SendError(playerid, "У вас недостатньо коштів для внеску.");
							new id = TI[playerid][tDuel];
							DI[id][duel_owner_id] = DI[id][duel_id][0] = DI[id][duel_id][1] = DI[id][duel_id][2] = DI[id][duel_id][3] = DI[id][duel_id][4] = DI[id][duel_id][5] = INVALID_PLAYER_ID;
							DI[id][duel_gun] = DI[id][duel_gun_2] = 0;
							DI[id][duel_money] = 1000;
							DI[id][duel_raund] = 1;
							DI[id][duel_type] = 0;
							DI[id][duel_map] = 0;
							DI[id][duel_health] = 100;
							DI[id][duel_armour] = 0;
							DI[id][duel_start] = false;
							DI[id][duel_create] = false;
							DI[id][duel_point_1] = DI[id][duel_point_2] = 0;
							TI[playerid][tDuel] = -1;
							return 1;
						}
						GiveMoney(playerid,-DI[TI[playerid][tDuel]][duel_money],"внесок дуель");
						DI[TI[playerid][tDuel]][duel_owner_id] = playerid;
						DI[TI[playerid][tDuel]][duel_id][0] = playerid;
						DI[TI[playerid][tDuel]][duel_create] = true;
						TI[playerid][tDuelLobby] = 0;
						if(DI[TI[playerid][tDuel]][duel_type] == 1) SendOK(playerid,"Ви посіли місце #1 у команді #1.");
						else if(DI[TI[playerid][tDuel]][duel_type] == 2) SendOK(playerid,"Ви посіли місце #1 у команді #1.");
						SendOK(playerid,"Лобі успішно створено.");
					}
					else {
						DI[TI[playerid][tDuel]][duel_create] = false;
						SendOK(playerid,"Лобі успішно видалено.");
						duel_delete(TI[playerid][tDuel],false);
					}
				}
			}
