						cache_delete(result);
					}
					else ShowPlayerDialog(playerid,D_MAIL_CONTROL,DSI, ""P"E-Mail",""W"Вкажіть вашу "GREEN"пошту"W"\n\nВкажіть Ваш реальнийй "P"E-Mail"W". З його допомогою ви зможете відновити пароль","Далі","Назад");
