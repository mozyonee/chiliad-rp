			if(bint < 0 || bint >= BINT_COUNT) return 1;
			TI[playerid][tTPpick] = true;
			SetPlayerPosAC(playerid,gBints[bint][bintX],gBints[bint][bintY],gBints[bint][bintZ],businessid+1,gBints[bint][bintInterior]);
	
