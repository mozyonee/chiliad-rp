	SetPlayerSkills(params[0]);
	return 1;
}
CMD:givemoney(playerid, params[]) {
	if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return 1;
	if(!PI[playerid][giveMoney]) return SendClientMessage(playerid,-1,""cError"У вас немає доступу до цієї команди.");
	new id,money,string[50], str[400];
	if(sscanf(params,"ud",id,money)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /givemoney [plyeridid/playername] [amount]");
	if(!IsPlayerConnected(id)) return false;
	format(str,sizeof(str),"%s видав %s.",player_name[playerid],player_name[id]);
	GiveMoney(id,money,str);
	format(string,sizeof(string),"Ви дали гравцю %s $%d.",player_name[id],money);
	SendClientMessage(playerid,-1,string);
	return 1;
}
CMD:givedonate(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || dostup[playerid] == 0) return 1;
	if(!PI[playerid][giveDonate]) return SendClientMessage(playerid,-1,""cError"У вас немає доступу до цій команди.");
	if(GetString(player_name[playerid], "Xavier_Blackwood") || GetString(player_name[playerid], "Brian_Randall") || GetString(player_name[playerid], "Jacob_Gerkens") || GetString(player_name[playerid], "Rick_Slay"))
	{
		new id,money,string[150];
		if(sscanf(params,"ud",id,money)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /givedonate [plyeridid/playername] [amount]");
		if(!IsPlayerConnected(id)) return false;
		new str[350];
		format(str,sizeof(str),"Aдміністратор %s видав %s донат.",player_name[playerid],player_name[id]);
		GiveDonate(id, money, str);
		format(string,sizeof(string),"Ви дали донат %s %d UAH.",player_name[id],money);
		SendClientMessage(playerid,-1,string);
	}
	return 1;
}
CMD:setacc(playerid, params[]) {
	if(PI[playerid][pAdmin] < 7 || dostup[playerid] == 0) return 1;
	new stat,amount,giveplayerid;
	if(sscanf(params, "udd",giveplayerid,stat,amount)) {
		SendClientMessage(playerid, COLOR_WHITE,"Використайте: /setacc [playerid] [number] [amount]");
		SendClientMessage(playerid, COLOR_GRAD4, "[1] Рівень | [2] Законослухняність | [3] Матеріали");
		SendClientMessage(playerid, COLOR_GRAD2, "[4] Exp | [5] Робота гравця | [6] Рахунок мобільного");
		SendClientMessage(playerid, COLOR_GRAD2, "[7] Наркотики | [8] | Наркозалежність");
		return 1;
	}
	if(!IsPlayerConnected(giveplayerid)) return 1;
	if(giveplayerid == INVALID_PLAYER_ID) return 1;
	switch (stat) {
	case 1: {
			PI[giveplayerid][pLevel] = amount;
			DollahScoreUpdate(giveplayerid);
			UpdatePlayerData(giveplayerid,"pLevel",amount);
		}
	case 2: PI[giveplayerid][pZakonp] = amount,UpdatePlayerData(giveplayerid,"pZakonp",amount);
		//	case 3: PI[giveplayerid][pMats] = amount,UpdatePlayerData(giveplayerid,"pMats",amount);
	case 4: PI[giveplayerid][pExp] = amount,UpdatePlayerData(playerid,"pExp",PI[playerid][pExp]);
	case 5: PI[giveplayerid][pJob] = amount,UpdatePlayerData(giveplayerid,"pJob",amount);
	case 6: PI[giveplayerid][pMobile] = amount,UpdatePlayerData(giveplayerid,"pMobile",amount);
	case 8: PI[giveplayerid][pAddiction] = amount;
	}
	SendOK(playerid, "Успішно змінений");
	return 1;
}
CMD:setstat(playerid, params[]) {
	if(PI[playerid][pAdmin] < 6 || dostup[playerid] == 0) return 1;
	new stat,amount,giveplayerid;
	if(sscanf(params, "udd",giveplayerid,stat,amount)) {
		SendClientMessage(playerid, COLOR_WHITE,"Використайте: /setstat [playerid] [number] [amount]");
		SendClientMessage(playerid, COLOR_GRAD4, "[1] Рівень | [2] Законослухняність | [3] Матеріали");
		SendClientMessage(playerid, COLOR_GRAD3, "[4] Фішки | [5] Exp");
		SendClientMessage(playerid, COLOR_GRAD2, "[6] VIP | [7] Робота гравця | [8] Гроші в банку");
		SendClientMessage(playerid, COLOR_GRAD2, "[9] Рахунок мобільного | [10] Гроші | [11] Наркотики");
		SendClientMessage(playerid, COLOR_GRAD2, "[12] Донат рахунок [13] Наркозалежність [14] Аптечки");
		SendClientMessage(playerid, COLOR_GRAD2, "[15] Голод");
		return 1;
	}
	if(!IsPlayerConnected(giveplayerid)) return 1;
	if(giveplayerid == INVALID_PLAYER_ID) return 1;
	switch (stat)
	{
	case 1: {
			PI[giveplayerid][pLevel] = amount;
			DollahScoreUpdate(giveplayerid);
			UpdatePlayerData(giveplayerid,"pLevel",amount);
		}
	case 2: PI[giveplayerid][pZakonp] = amount,UpdatePlayerData(giveplayerid,"pZakonp",amount);
	case 3: {
			PI[giveplayerid][pMats] = amount;
			UpdatePlayerData(giveplayerid,"pMats",PI[giveplayerid][pMats]);
		}
	case 4: {
			PI[giveplayerid][pCasinoChips] = amount;
			UpdatePlayerData(playerid,"casino_chips",PI[giveplayerid][pCasinoChips]);
		}
	case 5: PI[giveplayerid][pExp] = amount,UpdatePlayerData(playerid,"pExp",PI[playerid][pExp]);
	case 6: {
			PI[giveplayerid][pPremium] = gettime()+(amount*24*60*60);
			UpdatePlayerData(giveplayerid,"premium",PI[giveplayerid][pPremium]);
		}
	case 7: PI[giveplayerid][pJob] = amount,UpdatePlayerData(giveplayerid,"pJob",amount);
	case 8: PI[giveplayerid][pBank] = amount,UpdatePlayerData(giveplayerid,"pBank",amount);
	case 9: PI[giveplayerid][pMobile] = amount,UpdatePlayerData(giveplayerid,"pMobile",amount);
	case 10: PI[giveplayerid][pCash] = amount,UpdatePlayerData(giveplayerid,"pCash",amount);
	case 11: {
			PI[giveplayerid][pDrugs] = amount;
			UpdatePlayerData(giveplayerid,"pDrugs",PI[giveplayerid][pDrugs]);
		}
	case 12: {
			new str[350];
			format(str,sizeof(str),"A - %s, видав %s",player_name[playerid],player_name[playerid]);
			GiveDonate(giveplayerid, amount, str);
		}
	case 13: PI[giveplayerid][pAddiction] = amount;
	case 14: {
			if(GetInvSet(giveplayerid) >= 40) return SendError(playerid, "В інвентарі гравця недостатньо місця.");
			AddItem(giveplayerid, 1, amount);
		}
	case 15: SetFullness(giveplayerid, amount);
	}
	SendOK(playerid, "Успішно змінений.");
	return 1;
}
alias:captstats("cstats");
CMD:captstats(playerid) {
	if(!IsAGang(playerid)) return 1;
	if(!GhettoInfo[playerid][GhettoGUI]) {
		if(TI[playerid][tAttack] == 0) return SendError(playerid, "Наразі війна за територію не йде.");
		ghetto_ShowGUI(playerid);
	}
	else ghetto_HideGUI(playerid);
	return 1;
}
CMD:gives(playerid,params[]) {
	new giveplayerid;
	if(PI[playerid][pAdmin] < 6 || dostup[playerid] == 0) return 1;
	if(sscanf(params, "u",giveplayerid)) return SendClientMessage(playerid, COLOR_WHITE,"Використайте: /gives [id гравця]");
	SendClientMessage(giveplayerid,COLOR_ORANGE,"Адміністратор видав вам всі скілли, наркотики та матеріали.");
	
	PI[giveplayerid][pDrugs] += 25000;
	UpdatePlayerData(giveplayerid,"pDrugs",PI[giveplayerid][pDrugs]);
	
	PI[giveplayerid][pMats] += 100000;
	UpdatePlayerData(giveplayerid,"pMats",PI[giveplayerid][pMats]);
	
	PI[giveplayerid][pGunSkill][0] = 100;
	PI[giveplayerid][pGunSkill][1] = 100;
	PI[giveplayerid][pGunSkill][2] = 100;
	PI[giveplayerid][pGunSkill][3] = 100;
	PI[giveplayerid][pGunSkill][4] = 100;
	PI[giveplayerid][pGunSkill][5] = 100;
	save_skill(giveplayerid);
	SetPlayerSkills(giveplayerid);
	
	SendOK(playerid, "Видано успішно.");
	return 1;
}
CMD:setmats(playerid,params[]) {
	if(PI[playerid][pAdmin] < 5 || dostup[playerid] == 0) return 1;
	new amount,giveplayerid;
	if(sscanf(params, "dd",giveplayerid,amount)) SendClientMessage(playerid, COLOR_WHITE,"Використайте: /setstat [playerid] [amount]"),
	SendClientMessage(playerid, COLOR_WHITE,"Використайте: 1. Поліція м. ЛС; 2. Angels MC; 3. Bandidos MC; 4. ФБР; 5. Нац. Гвардія."),
	SendClientMessage(playerid, COLOR_WHITE,"Використайте: 7. Ballas; 8. Vagos; 9. Grove; 10. Aztecas; 11. Rifa."),
	SendClientMessage(playerid, COLOR_WHITE,"Використайте: 12. Коза Ностра; 13. Якудза; 14. Медельїнський картель."),
	SendClientMessage(playerid, COLOR_WHITE,"Використайте: 15. Завод з виготовлення зброї; 16. Лісопильня; 17. Шерифи о. Ред.");
	switch(giveplayerid) {
	case 1: FI[fLSPD][fMats] = amount,UpdateFraction(fLSPD,"Mats",FI[fLSPD][fMats]);
	case 2: FI[fBikers][fMats] = amount,UpdateFraction(fBikers,"Mats",FI[fBikers][fMats]);
	case 3: FI[fBikersTwo][fMats] = amount,UpdateFraction(fBikersTwo,"Mats",FI[fBikersTwo][fMats]);
	case 4: FI[fFBI][fMats] = amount,UpdateFraction(fFBI,"Mats",FI[fFBI][fMats]);
	case 5: FI[fARMYLS][fMats] = amount,UpdateFraction(fARMYLS,"Mats",FI[fARMYLS][fMats]);
	case 7: FI[fBALLAS][fMats] = amount,UpdateFraction(fBALLAS,"Mats",FI[fBALLAS][fMats]);
	case 8: FI[fVAGOS][fMats] = amount,UpdateFraction(fVAGOS,"Mats",FI[fVAGOS][fMats]);
	case 9: FI[fGROVE][fMats] = amount,UpdateFraction(fGROVE,"Mats",FI[fGROVE][fMats]);
	case 10: FI[fAZTEC][fMats] = amount,UpdateFraction(fAZTEC,"Mats",FI[fAZTEC][fMats]);
	case 11: FI[fRIFA][fMats] = amount,UpdateFraction(fRIFA,"Mats",FI[fRIFA][fMats]);
	case 12: FI[fLCN][fMats] = amount,UpdateFraction(fLCN,"Mats",FI[fLCN][fMats]);
	case 13: FI[fYAKUZA][fMats] = amount,UpdateFraction(fYAKUZA,"Mats",FI[fYAKUZA][fMats]);
	case 14: FI[fRM][fMats] = amount,UpdateFraction(fRM,"Mats",FI[fRM][fMats]);
	case 15: zavodsklad = amount,UpdateOtherData("gun_mats",zavodsklad);
	case 16: woodsklad = amount,UpdateOtherData("woodsklad",woodsklad);
	case 17: FI[fRCSO][fMats] = amount,UpdateFraction(fRCSO,"Mats",FI[fRCSO][fMats]);
		
	default: SendError(playerid, "Сталася помилка.");
	}
	if(giveplayerid != 0) SendOK(playerid,"Ви успішно поповнили склад.");
	return 1;
}
CMD:getip(playerid, params[]) {
	if (PI[playerid][pAdmin] < 7 || dostup[playerid] == 0) return 1;
	if (sscanf(params, "d", params[0])) return SendClientMessage(playerid,COLOR_WHITE, "Введіть: /getip [playerid]");
	if (params[0] == INVALID_PLAYER_ID) return SendError(playerid, "Цей гравець не авторизований.");
	if (IsPlayerConnected(params[0]) == 0) return SendError(playerid, "Цей гравець не авторизований.");
	new ip[17];
	GetPlayerIp(params[0], ip, 16);
	new string[250];
	format(string, sizeof(string), "Niсk: %s. R-IP: %s. L-IP: %s. IP: %s.", player_name[params[0]], PI[params[0]][pIpReg], player_ip[params[0]], ip);
	SendClientMessage(playerid, 0x6BB3FFAA, string);
	return 1;
}
CMD:newobj(playerid)
{
    if(PI[playerid][pAdmin] < 6 || dostup[playerid] == 0) return 1;
	if(!PI[playerid][giveObj]) return SendError(playerid,"У вас немає доступу до цієї команди.");
    ShowPlayerDialog(playerid, 1288, DSL, "{C70000}Bauld Mapping", ""P"1."W" Створити об'єкт\n"P"2."W" Редагувати об'єкт\n"P"3."W" Обрати об'єкт", "Обрати", "Скасувати");
    return 1;
}
