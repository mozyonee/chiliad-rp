	case D_JOB_KANAL_1: {
			if(!response) return RemovePlayerFromVehicleAC(playerid);
			if(PI[playerid][pCash] < 500) {
				SendError(playerid, "У вас недостатньо грошей для оренди цього авто.");
				RemovePlayerFromVehicleAC(playerid);
