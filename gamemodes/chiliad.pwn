		ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Інвентар.", str, "Закрити", "");
	} */
	else if(playertextid == nInventory_TD[playerid][13]) {
		if(GetPVarInt(playerid, "inv")) {
