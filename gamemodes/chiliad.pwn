	if(PI[playerid][pAdmin] < 7 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	// Profiler_Dump();
	return 1;
}
CMD:kick(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new text[130], string[356], giveplayerid;
	if(sscanf(params, "us[128]", giveplayerid,text)) return SendError(playerid, "Використайте: /kick [playerid] [reason]");
	if(PlayerAdminFix[playerid] > gettime()) return SendError(playerid, "Можна раз в 10 секунд.");
	PlayerAdminFix[playerid] = gettime() + 10;
	if(isAdminStatus(CI[giveplayerid][cName])) return 1;
	if(!IsPlayerConnected(giveplayerid) || giveplayerid == playerid) return SendError(playerid, not_id);
	if(IsAIP(text)) return 1;
	if(strlen(text) > 30) return SendError(playerid, "Не більше 30 символів.");
	if(!TI[giveplayerid][tLogin]) return SendError(playerid, "Гравець не авторизований на сервері.");
	format(string, 128, "Адміністратор %s кікнув %s. Причина: %s.", CI[playerid][cName], CI[giveplayerid][cName],text);
	SendAdminActionMessage(COLOR_LIGHTRED, string);
	WriteLog(LOG_KICK, CI[playerid][cName], CI[giveplayerid][cName],text);
	gAdmin[playerid][ADMIN_KICK] ++;
	new hour, minute;
	new year, month,day;
	getdate(year, month, day);
	gettime(hour, minute);
	static const f_str[] = "\
			"W"Увага! Ви були "NO"кікнути"W" з серверу.\n\n\
			"W"Кікнув: "NO"%s\n\
			"W"Дата: "P"%i-%i-%i %02d:%02d\n\
			"W"Причина: "P"%s\n\n\
			"W"Якщо ви вважаєте, що це була помилка, зробіть скріншот(F8) цього вікна,\n\
			інакше ваша скарга не буде прийнята.";
	format(string, sizeof(string), f_str, CI[playerid][cName], day, month, year,hour, minute, text);
	new str[MAX_PLAYER_NAME + 1];
	format(str, sizeof(str), P"%s.", CI[giveplayerid][cName]);
	SPD(giveplayerid, DIALOG_NONE, DSM, str, string, "Закрити", "");
	KickEx(giveplayerid);
	return 1;
}
CMD:giveitem(playerid, params[]) {
	if(PI[playerid][pAdmin] < 5 || GetPVarInt(playerid, "adminaccess") != 1) return SendError(playerid, "Недоступно.");
	new itemtarget, itemid, itemamount;
	if(sscanf(params, "uii", itemtarget, itemid, itemamount)) return SendError(playerid, "Використайте: /giveitem [playerid] [item] [amount]");
	AddItem(itemtarget, itemid, itemamount);
	return 1;
}
CMD:pm(playerid, params[]) {
	new targetid, text[128], string[256];
	if(sscanf(params, "us[128]", targetid, text)) return SendError(playerid, "Використайте: /pm [playerid] [text]");
	if(!IsPlayerConnected(targetid) || targetid == INVALID_PLAYER_ID || targetid == playerid) return SendError(playerid, not_id);
	if(strlen(text) > 128) return SendError(playerid, "Не більше 128 символів.");
	format(string, sizeof(string), "(( PM до %s[%i]: %s ))", CI[targetid][cName], targetid, text);
	SendClientMessage(playerid, COLOR_YELLOW, string);
	format(string, sizeof(string), "(( PM від %s[%i]: %s ))", CI[playerid][cName], playerid, text);
	SendClientMessage(targetid, COLOR_YELLOW, string);
	return 1;
}
CMD:ans(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new text[130], string[144], giveplayerid;
	if(sscanf(params, "us[128]", giveplayerid, text)) return SendError(playerid, "Використайте: /ans [playerid] [text]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(strlen(text) > 150) return SendError(playerid, "Не більше 128 символів.");
	if(IsAIP(text)) return 1;
	if(giveplayerid == playerid) return SendError(playerid, "Не можна відповісти самому собі.");
	format(string, sizeof(string), "Адміністратор %s відповів: "W"%s", CI[playerid][cName], text);
	SendClientMessage(giveplayerid, COLOR_LIGHTRED, string);
	format(string, sizeof(string), "Адміністратор %s[%i] відповів %s[%i]: "W"%s", CI[playerid][cName], playerid, CI[giveplayerid][cName], giveplayerid,text);
	SendAdminMessage(COLOR_LIGHTRED, string);
	PlayerPlaySound(giveplayerid, 4203, 0.0, 0.0, 0.0);
	return 1;
}
CMD:reps(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(!rep_system) return SendError(playerid, "Тимчасово недоступно, використовуйте /ans.");
	for(new i;i<MAX_REPORTS;i++) {
		if(PlayerReport[i] != -1) {
			if(ReportSlot[i] == 1) continue;
			new string[400];
			format(string, sizeof(string), W"Скарга від %s[%i]\n\n"G"%s\n", CI[PlayerReport[i]][cName], PlayerReport[i], TextReport[i]);
			ShowPlayerDialog(playerid, D_REPORT_1, DSI, P"Репорт.", string, "Прийняти", "Скасувати");
			ReportID[playerid] = i;
			ReportSlot[i] = 1;
			return 1;
		}
	}
	SendError(playerid, "Репортів немає.");
	return 1;
}
CMD:mute(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new time, text[33], string[144], giveplayerid;
	if(sscanf(params, "uds[32]", giveplayerid,time,text)) return SendError(playerid, "Використайте: /mute [playerid] [minutes] [reason]");
	if(PlayerAdminFix[playerid] > gettime()) return SendError(playerid, "Можна раз в 10 секунд.");
	PlayerAdminFix[playerid] = gettime() + 10;
	if(isAdminStatus(CI[giveplayerid][cName])) return 1;
	if(!IsPlayerConnected(giveplayerid) || giveplayerid == playerid) return SendError(playerid, not_id);
	if(CI[giveplayerid][pMute]) return SendError(playerid, "У гравця вже є блокування чату.");
	if(IsAIP(text))return 1;
	if(strlen(text) > 30) return SendError(playerid, "Причина повинна бути менше 30 символів.");
	if(!(1 <= time <= 300)) return SendError(playerid, "Видати бан чату можна максимум на 300 хвилин.");
	CI[giveplayerid][pMute] = time*60;
	UpdateCharacterData(giveplayerid, "mute", CI[giveplayerid][pMute]);
	format(string, sizeof(string), "Адміністратор %s заблокував чат %s на %i хв. Причина: %s.", CI[playerid][cName], CI[giveplayerid][cName], time, text);
	SendAdminActionMessage(COLOR_LIGHTRED, string);
	SendInfo(giveplayerid, "Щоб переглянути скільки часу залишилося до зняття бана чату, введіть "P"/time"W".");
	gAdmin[playerid][ADMIN_MUTE] ++;
	WriteLog(LOG_MUTE, CI[playerid][cName], CI[giveplayerid][cName],text);
	return 1;
}
CMD:offunmute(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new string[220], giveplayerid;
	if(isnull(params) || strlen(params) > 25) return SendError(playerid, "Використайте: /offunmute [playername]");
	sscanf(params, "u", giveplayerid);
	if(giveplayerid != INVALID_PLAYER_ID) return SendError(playerid, "Цей гравець онлайн.");
	new query[128];
	mysql_format(connects, query, sizeof(query), "SELECT `mute` FROM "TABLE_CHARACTERS" WHERE `Name` = '%s' LIMIT 1", params);
	new mute = 0;
	new Cache:result = mysql_query(connects, string);
	new rows = cache_num_rows();
	if(rows > 0) {
		cache_get_value_int(0, "mute", mute);
		if(mute == 0) {
			SendError(playerid, "У цього гравця немає бана чату");
			cache_delete(result);
			return 1;
		}
		mysql_format(connects, query, sizeof(query), "UPDATE "TABLE_CHARACTERS" SET `mute` = '0' WHERE `Name` = '%s' LIMIT 1", params);
		mysql_pquery(connects, query);
		new str[128];
		format(str, sizeof(str), "[A] %s[%i] зняв бан чату в офлайн гравцю %s.", CI[playerid][cName], playerid, params);
		AdmMSG(0xAFAFAFAA, str);
	}
	cache_delete(result);
	return 1;
}
CMD:unmute(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new string[144], giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendError(playerid, "Використайте: /unmute [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(!CI[giveplayerid][pMute]) return SendError(playerid, "У гравця немає бана чату.");
	CI[giveplayerid][pMute] = 0;
	UpdateCharacterData(giveplayerid, "mute", 0);
	format(string, sizeof(string), "Адміністратор %s зняв бан чату у %s.", CI[playerid][cName], CI[giveplayerid][cName]);
	SendAdminActionMessage(COLOR_LIGHTRED, string);
	WriteLog(LOG_UNMUTE, CI[playerid][cName], CI[giveplayerid][cName], "зняв бан чату.");
	return 1;
}
CMD:offmute(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new name[MAX_PLAYER_NAME],time,reason[31], giveplayerid;
	if(sscanf(params, "s[20]is[30]",name,time, reason)) return SendError(playerid, "Використайте: /offmute [playername] [minutes] [reason]");
	if(strlen(reason) > 30) return SendError(playerid, "Причина повинна бути меньше 30 символів.");
	sscanf(name, "u", giveplayerid);
	if(giveplayerid != INVALID_PLAYER_ID) return SendError(playerid, "Цей гравець онлайн.");
	if(time > 300 || time < 5) return SendError(playerid, "Від 5 до 300 хвилин.");
	if(GetPVarInt(playerid, "ban")>gettime()) return SendError(playerid, "Можна раз в 10 секунд.");
	SetPVarInt(playerid, "ban", gettime() + 10);
	new query[128];
	mysql_format(connects, query, sizeof(query), "SELECT * FROM "TABLE_CHARACTERS" WHERE BINARY `Name` = '%s' LIMIT 1",name);
	new Cache:result = mysql_query(connects, query);
	new rows = cache_num_rows();
	if(rows == 0) return SendError(playerid, "Цей гравець не знайдений.");
	new query_str[128];
	mysql_format(connects, query_str, sizeof(query_str), "UPDATE "TABLE_CHARACTERS" SET mute = %i WHERE BINARY Name = '%s'",time*60,name);
	mysql_tquery(connects,query_str);
	cache_delete(result);
	new string[144];
	format(string, sizeof(string), "[A] %s[%i] видав мут без зайвого шуму гравцю %s на %i хвилин. Причина: %s.", CI[playerid][cName], playerid,name,time, reason);
	AdmMSG(0xAFAFAFAA, string);
	gAdmin[playerid][ADMIN_MUTE] ++;
	WriteLog(LOG_MUTE, CI[playerid][cName],name, reason);
	return 1;
}
CMD:weap(playerid,params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return	SendError(playerid, "Використайте: /weap [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	new Gun[13], Ammos[13], string[700];
	for(new i = 0; i < 13; i++) {
		GetPlayerWeaponData(giveplayerid, i, Gun[i], Ammos[i]);
		format(string, sizeof(string), "%s"W"Slot: %i\t Weaponid: %i\t Ammo: %i\n", string, i, Gun[i], Ammos[i]);
		if(i == 12) format(string, sizeof(string), "%s\n", string);
	}
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, CI[giveplayerid][cName], string, "Weapon", "");
	return 1;
}
CMD:cweap(playerid, params[]) {
	if(PI[playerid][pAdmin] < 2 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new id;
	if(sscanf(params, "u", id)) return SendError(playerid, "Використайте: /cweap [playerid]");
	new string[150];
	ResetPlayerWeapons(id);
	format(string, sizeof(string), "Ви відібрали зброю у гравця %s[%i].", CI[id][cName], id);
	SendClientMessage(playerid,COLOR_LIGHTBLUE, string);
	return 1;
}
CMD:fspcar(playerid) {
	if(!CI[playerid][pMember]) return SendError(playerid, "Ви не перебуваєте в організації.");
	new string[128];
	if(CI[playerid][pRank] < FI[CI[playerid][pMember]][sRank]) {
		format(string, 128, "Доступно з %i рангу.", FI[CI[playerid][pMember]][sRank]);
		SendError(playerid, string);
		return 1;
	}
	for(new i = GetVehiclePoolSize() + 1; --i != 0;) {
		if(!IsValidVehicle(i)) continue;
		if(VehicleInfo[i][vTeam] != CI[playerid][pMember]) continue;
		if(IsVehicleOccupied(i)) continue;
		SetVehicleToRespawn(i);
	}
	format(string, sizeof(string), "[F] %s %s заспавнив незайняті машини.", GetRankName(CI[playerid][pMember], CI[playerid][pRank]), CI[playerid][cName], playerid);
	SendFactionMessage(CI[playerid][pMember],COLOR_LIGHTRED, string);
	return 1;
}
CMD:admins(playerid) {
	if(PI[playerid][pAdmin] < 1 && !CI[playerid][pPremium]) return 1;
	new countleader = 0;
	new string[2000], str[156];
	string = "ID\tНік\tПосада\tРівень\n";
	new a_str[64];
	foreach(new i:Player) {
		if(!IsPlayerConnected(i) || (!TI[i][tLogin]) || (PI[i][pAdmin] <= 0)) continue;
		if(ahMenu[i][0]) continue;
		if(CI[i][pPrefix_i]) format(PI[i][pAdmin], 64, CI[i][pPrefix_s]);
		format(a_str, sizeof(a_str), "\t%s\t%i", PI[i][pAdmin], PI[i][pAdmin]);
		if(ahMenu[i][1]) format(a_str, 64, " ");
		format(str, sizeof(str), W"%i\t%s%s%s\n", i, CI[i][cName], a_str, TI[i][tAFK] >= 3 ? ("{ffa800} [AFK]") : ("")), strcat(string, str);
		countleader++;
	}
	if(countleader > 0) {
		ShowPlayerDialog(playerid, DIALOG_NONE, DSTH, P"Адміністрація", string, "Закрити", "");
		new str_adm[128];
		format(str_adm, sizeof(str_adm), "В мережі "P"%i"W" адміністраторів.", countleader);
		SendOK(playerid,str_adm);
	} else ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Адміністрація.", W"Немає адміністраторів у мережі.", "Закрити", "");
	return 1;
}
CMD:afklist(playerid) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new count = 0;
	new string[3000];
	foreach(new i : Player) {
		if(!TI[i][tLogin]) continue;
		if(TI[i][tAFK] < 3) continue;
		new str[128];
		format(str, sizeof(str), W"%s[%i]. %i LVL. "NO"AFK: %i.\n", CI[i][cName], i, CI[i][pLevel], TI[i][tAFK]);
		strcat (string, str);
		count++;
	}
	if(count == 0) return SendError(playerid, "Немає гравців в AFK.");
	else ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Гравці в AFK", string, "Закрити", "");
	return 1;
}
CMD:jail(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new time,text[31], string[144], giveplayerid;
	if(sscanf(params, "uds[30]", giveplayerid,time,text)) return SendError(playerid, "Використайте: /jail [playerid] [minutes] [reason]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(CI[giveplayerid][pJailTime]) return SendError(playerid, "Гравець у в'язниці.");
	if(time > 300 || time < 1) return SendError(playerid, "Від 1 до 300 хвилин.");
	if(strlen(text) > 30) return SendError(playerid, "Причина повинна бути менше 30 символів.");
	if(IsAIP(text))return 1;
	format(string, sizeof(string), "Ви посадили %s у в'язницю.", CI[giveplayerid][cName]);
	SendClientMessage(playerid, COLOR_LIGHTRED, string);
	format(string, sizeof(string), "Адміністратор %s посадив в ДеМорган %s на %i хвилин. Причина: %s.", CI[playerid][cName], CI[giveplayerid][cName],time,text);
	SendAdminActionMessage(COLOR_LIGHTRED, string);
	ResetPlayerWeapons(giveplayerid);
	CI[giveplayerid][pJail] = 3;
	CI[giveplayerid][pJailTime] = time*60;
	UpdateCharacterData(giveplayerid, "pJailTime", CI[giveplayerid][pJailTime]);
	UpdateCharacterData(giveplayerid, "pJail", 3);

	start_work[giveplayerid] = 0;
	GameTextForPlayer(giveplayerid, "~w~YOU IN ~R~JAIL", 5000, 4);
	format(string, sizeof(string), "Ви були посажені у в'язницю адміністратором %s на %i хвилин. Причина: %s.", CI[playerid][cName], time, text);
	SendOK(giveplayerid, string);
	SendInfo(giveplayerid, "Щоб переглянути скільки залишилось часу до виходу на свободу, введіть "P"/time"W".");
	PlayerSpawn(giveplayerid);
	if(giveplayerid != playerid) gAdmin[playerid][ADMIN_JAIL] ++;
	WriteLog(LOG_JAIL, CI[playerid][cName], CI[giveplayerid][cName],text);
	return 1;
}
CMD:offunjail(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new string[220], giveplayerid;
	if(isnull(params) || strlen(params) > 25) return SendError(playerid, "Використайте: /offunjail [playername]");
	sscanf(params, "u", giveplayerid);
	if(giveplayerid != INVALID_PLAYER_ID) return SendError(playerid, "Цей гравець онлайн.");
	mysql_format(connects, string, sizeof(string), "SELECT `pJailTime` FROM "TABLE_CHARACTERS" WHERE `Name` = '%s' LIMIT 1", giveplayerid);
	new jail = 0;
	new Cache:result = mysql_query(connects, string);
	new rows = cache_num_rows();
	if(rows == 0) return SendError(playerid, "Цього гравця не знайдено.");
	cache_get_value_int(0, "pJailTime", jail);
	if(jail == 0) {
		SendError(playerid, "Цей гравець не знаходитися в КПЗ.");
		cache_delete(result);
		return 1;
	}
	new query[350];
	mysql_format(connects, query, sizeof(query), "UPDATE "TABLE_CHARACTERS" SET `pJailTime` = '0',`pJail` = '0' WHERE `Name` = '%s' LIMIT 1", params);
	mysql_pquery(connects, query);
	new str[128];
	format(str, sizeof(str), "[A] %s[%i] дістав з КПЗ в офлайн гравця %s.", CI[playerid][cName], playerid, params);
	AdmMSG(0xAFAFAFAA, str);

	SendOK(playerid, "Ви дістали гравця з КПЗ.");
	cache_delete(result);
	return 1;
}
CMD:offjail(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new name[MAX_PLAYER_NAME],time,reason[31], giveplayerid;
	if(sscanf(params, "s[20]is[30]",name,time, reason)) return SendError(playerid, "Використайте: /offjail [playername] [minutes] [reason]");
	if(strlen(reason) > 30) return SendError(playerid, "Причина повинна бути менше 30 символів.");
	sscanf(name, "u", giveplayerid);
	if(giveplayerid != INVALID_PLAYER_ID) return SendError(playerid, "Цей гравець онлайн.");
	if(time > 300 || time < 5) return SendError(playerid, "Від 5 до 300 хвилин.");
	new query[128];
	mysql_format(connects, query, sizeof(query), "SELECT * FROM "TABLE_CHARACTERS" WHERE BINARY `Name` = '%s' LIMIT 1", name);
	new Cache:result = mysql_query(connects, query);
	new rows = cache_num_rows();
	if(rows == 0) return SendError(playerid, "Цього гравця не знайдено.");
	new query_str[350];
	mysql_format(connects, query_str, sizeof(query_str), "UPDATE  "TABLE_CHARACTERS" SET pJail = '3',pJailTime = %i WHERE BINARY Name = '%s'",time*60,name);
	mysql_tquery(connects,query_str);
	cache_delete(result);
	new string[128];
	format(string, sizeof(string), "Ви посадили %s у в'язницю на %i хвилин.",name,time);
	SendClientMessage(playerid, COLOR_LIGHTRED, string);
	format(string, sizeof(string), "Адміністратор %s посадив в ДеМорган %s на %i хвилин. Причина: %s.", CI[playerid][cName],name,time, reason);
	SendAdminActionMessage(COLOR_LIGHTRED, string);
	gAdmin[playerid][ADMIN_JAIL] ++;
	WriteLog(LOG_JAIL, CI[playerid][cName],name, reason);
	return 1;
}
CMD:unjail(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendError(playerid, "Використайте: /unjail [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(!CI[giveplayerid][pJailTime] && CI[giveplayerid][pJail] == 0) return SendError(playerid, "Гравець не у в'язниці.");
	new string[128];
	format(string, sizeof(string), "Ви звільнили %s.", CI[giveplayerid][cName]);
	SendClientMessage(playerid, 0x09B000AA, string);
	format(string, sizeof(string), "[A] %s[%i] випустив гравця %s[%i] з в'язниці.", CI[playerid][cName], playerid, CI[giveplayerid][cName], giveplayerid);
	AdmMSG(CADMIN_INFO, string);
	format(string, sizeof(string), "Адміністратор %s[%i] випустив вас на свободу.", CI[playerid][cName], playerid);
	SendOK(giveplayerid, string);
	CI[giveplayerid][pJailTime] = 0;
	CI[giveplayerid][pJail] = 0;
	UpdateCharacterData(giveplayerid, "pJailTime", 0);
	UpdateCharacterData(giveplayerid, "pJail", 0);
	PlayerSpawn(giveplayerid);
	WriteLog(LOG_UNJAIL, CI[playerid][cName], CI[giveplayerid][cName], "випустив з в'язниці");
	return 1;
}
CMD:prisoners(playerid, const params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new string[(57+MAX_PLAYER_NAME-4+3+ 11+ 1)*30];
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(!CI[i][pJailTime]) continue;
		format(string, sizeof(string), "%s"ORANGE"%s."W" ID: "P"%i."W" Час: "GREEN"%i\n", string, CI[i][cName], i, CI[i][pJailTime]);
	}
	if(isnull(string)) SendError(playerid, "Ув'язнених немає.");
	else ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Список ув'язнених.", string, "Закрити", "");
	return 1;
}
CMD:aad(playerid, params[]) {
	if(PI[playerid][pAdmin] < 2 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(isnull(params) || strlen(params) > 100) return SendError(playerid, "Використайте: /aad [повідомлення]");
	if(GetPVarInt(playerid, "aad") > gettime() && PI[playerid][pAdmin] < 4) {
		SendError(playerid, "Можна раз в 15 секунд.");
		return false;
	}
	SetPVarInt(playerid, "aad", gettime() + 15);
	new string[144];
	format(string, sizeof(string), "Адміністратор %s: %s", CI[playerid][cName], params);
	SendClientMessageToAll(0xFFCD00AA, string);
	return 1;
}
alias:aad("msg")
CMD:gettime(playerid, params[]) {
	if(PI[playerid][pAdmin] < 2 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendError(playerid, "Використайте: /gettime [ид гравця]");
	new string[800];
	if(CI[giveplayerid][pMute] > 0) {
		format(string, 128, "Залишилось мовчати "P"%i"W" секунд.", CI[giveplayerid][pMute]);
		SendOK(playerid, string);
	}
	if(CI[giveplayerid][pJailTime] > 0) {
		format(string, 128, "Залишилось сидіти "P"%i"W" секунд.", CI[giveplayerid][pJailTime]);
		SendOK(playerid, string);
	}
	new hour, minuite, second, year, month, day, saturday = 1310155200, w = gettime(), day_week;
	gettime(hour, minuite, second);
	getdate(year, month, day);
	while(w - saturday > 60 * 60 * 24) {
		w -= 60 * 60 * 24;
		day_week ++;
	}
	while(day_week >= 7) day_week -= 7;
	static const Names_Months[12][12] = {"січня", "лютого", "березня", "квітня", "травня", "червня", "липня", "серпня", "вересня", "жовтня", "листопада", "грудня"};
	static const Names_Days[7][12] = {"Субота", "Неділя", "Понеділок", "Вівторок", "Середа", "Четвер", "П'ятниця"};
	format(string, sizeof(string), "\
		"W"Поточний час: "P"%02d:%02d\n\
		"W"Сьогоднішня дата: "P"%s, %i %s %04d год\n\n\
		"W"Час в грі за час:\t\t"P"%i хв\n\
		"W"Час в грі за сьогодні:\t"P"%s\n\
		"W"Час в грі за вчора:\t"P"%s\n\
		"W"AFK за сьогодні:\t\t"P"%s\n\
		"W"AFK за вчора:\t\t\t"P"%s\n\n\
		"W"Відредагованих оголошень за сьогодні: "P"%i",
	hour, minuite,
	Names_Days[day_week], day, Names_Months[month-1], year,
	CI[giveplayerid][pPlayTime][0],
	ConvertsCmdTime(gOnlinePlayer[giveplayerid][0]),
	ConvertsCmdTime(gOnlinePlayer[giveplayerid][1]),
	ConvertsCmdTime(gOnlinePlayerAFK[giveplayerid][0]),
	ConvertsCmdTime(gOnlinePlayerAFK[giveplayerid][1]));
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Точний час", string, "Закрити", "");
	return 1;
}
CMD:alock(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	PlayerPlaySound(playerid, 24600, 0.0, 0.0, 0.0);

	GetVehicleParamsEx(GetNearestVehicle(playerid),engine,lights,alarm,doors,bonnet,boot,objective);
	ToggleDoors(GetNearestVehicle(playerid), playerid);
	return 1;
}
