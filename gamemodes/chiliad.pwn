				case 2: car_shop[playerid] = CreateVehicle(salon_econom[0][0], 45.0986, -14.8016, 1225.3112, 89.6199, 1, 1, -1);
				case 3: car_shop[playerid] = CreateVehicle(salon_sred[0][0], 45.0986, -14.8016, 1225.3112, 89.6199, 1, 1, -1);
