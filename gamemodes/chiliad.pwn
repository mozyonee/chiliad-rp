					format(header, sizeof(header), P"|"W" Керування %s. Спавн.", vehicle_name[fFleet[fid][vid][fleetModel] - 400]);
					ShowPlayerDialog(playerid, D_FACTION_EDIT_FLEET_SPAWN, DST, header, content, "Обрати", "Назад");
