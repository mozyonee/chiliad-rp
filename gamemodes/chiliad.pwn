CB:check_ip_ban(playerid) {
	new rows, reason[35];
	cache_get_row_count(rows);
	if(rows) {
		cache_get_value_name(0, "reason", reason, 30);
		if(strlen(reason) == 0) {
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Ваша IP адреса заблокований. Причина: Невідомо", reason);
			SendError(playerid, STRING_GLOBAL);
			KickEx(playerid);
		} else {
			STRING_GLOBAL[0] = EOS;
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Ваша IP адреса заблокований. Причина: %s", reason);
			SendError(playerid, STRING_GLOBAL);
		}
		KickEx(playerid);
	} else {
		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "SELECT * FROM `"TABLE_BAN"` WHERE `Name` = '%e' LIMIT 1", CI[playerid][cName]);
		mysql_tquery(connects, MYSQL_GLOBAL, "check_banned", "i", playerid);
	}
	return 1;
}
CB:offwarn(playerid, const Nick[], const Reason[]) {
	new rows;
	cache_get_row_count(rows);
	if(!rows) return SendError(playerid, "Акаунт не знайдено.");
	new query[300];
	new count_warns;
	cache_get_value_int(0, "pWarns", count_warns);
	if((count_warns + 1) < 3) {
		format(query, sizeof(query), "UPDATE "TABLE_CHARACTERS" SET `pWarns` = %i, `warntime` = %i, `pLeader` = '0', `pMember` = '0', `pRank` = '0' WHERE `Name` = '%s' LIMIT 1", count_warns + 1, gettime() + 7 * 86400, Nick);
		mysql_pquery(connects, query);
		WriteLog(LOG_WARN, CI[playerid][cName], Nick, Reason);
		gAdmin[playerid][ADMIN_WARN] ++;
		new string[128];
		format(string, sizeof(string), "Адміністратор %s видав попередження гравцю %s [%i/3]. Причина: %s.", CI[playerid][cName], Nick, (count_warns + 1), Reason);
		SendAdminActionMessage(COLOR_LIGHTRED, string);
	} else {
		if(IsBannedName(Nick)) return SendError(playerid, "Цей гравець вже заблокований.");
		new string[144];
		BanName(Nick, CI[playerid][cName], (10 * 86400), Reason);
		format(string, sizeof(string), "Адміністратор %s заблокував (3 попередження) %s на %i днів в офлайні. Причина: %s.", CI[playerid][cName], Nick, 10, Reason);
		SendAdminActionMessage(COLOR_LIGHTRED, string);
	}
	WriteLog(LOG_WARN, CI[playerid][cName], Nick, "offline видав варн");
	off_add_jobinfo(Nick, "Недієспроможний");
	return 1;
}
