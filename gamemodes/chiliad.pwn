				if(IsPlayerInDynamicArea(playerid, InfoDice[c][dice_area])) {
					if(InfoDice[c][dice_game_start] == true) return SendError(playerid, "Дана партія вже грається.");
					if(Casino_Flag[playerid][casino_crup] == 1) {
