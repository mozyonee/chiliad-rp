		case D_FARM_EGG: {
				if(!response) return 1;
				switch(listitem) {
				case 0: {
						new g = PlayerEgg[playerid];
						if(!IsPlayerInRangeOfPoint(playerid, 1.0, Egg[g][gX],Egg[g][gY],Egg[g][gZ])) return 1;
						if(Egg[PlayerEgg[playerid]][gCount] <= 0) return SendError(playerid, "Кури ще не знесли яйця.");
						JobTempProcess[playerid] = 17;
						TI[playerid][tProcess][0] = 0;
						TI[playerid][tProcess][1] = 10;
						PlayerTextDrawColor(playerid, YandNsysTDPlayer[playerid][1], -1);
						for(new YN = 0;YN < 3;YN++) {
							TextDrawShowForPlayer(playerid, YandNsysTD[YN]);
							if(YN < 2) PlayerTextDrawShow(playerid,YandNsysTDPlayer[playerid][YN]);
						}
						RandomYareNforJOBS(playerid);
					}
				case 1: {
						if(!PlayerKorm[playerid]) {
							SendError(playerid, "Ви не взяли корм.");
							EnableGPSForPlayer(playerid, -86.4977, -0.3041, 3.1172);
							return 1;
						}
						new g = PlayerEgg[playerid];
						if(Egg[g][gKorm] >= 10) {
							SendError(playerid, "Кури ситі.");
							RemovePlayerAttachedObject(playerid, 8);
							PlayerKorm[playerid] = 0;
							return 1;
						}
						if(CI[playerid][pFamily]) {
							gFamily[CI[playerid][pFamily]-1][famTalon] += 1;
							UpdateFamily(CI[playerid][pFamily], "talon", gFamily[CI[playerid][pFamily]-1][famTalon]);
							CI[playerid][pFamTalon] += 1, UpdateCharacterData(playerid, "talon_fam", CI[playerid][pFamTalon]);
						}
						Egg[g][gKorm] += 1;
						Egg[g][gTime] = gettime()+60;
						SendOK(playerid, "Ви нагодували курей.");
						EggUpdate(playerid);
						RemovePlayerAttachedObject(playerid, 8);
						PlayerKorm[playerid] = 0;
					}
				case 2: {
						SendOK(playerid, "Догляд за курами завершено.");
						EndEgg(playerid);
					}
				}
			}
