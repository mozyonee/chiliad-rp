			EnableGPSForPlayer(playerid, TI[playerid][tUcar][0], TI[playerid][tUcar][1], TI[playerid][tUcar][2]);
			VehicleInfo[car][vFuel] = 75;
			VehicleInfo[car][vFuel] = 75;
