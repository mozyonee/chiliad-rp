			ShowPlayerDialog(playerid, DIALOG_NONE,DST, P"Доходи.", string, "Закрити", "");
		}
	case 7: {
			if(CI[playerid][bizz_status] != 3) return SendError(playerid, "Функція доступна тільки керівнику транспортної компанії.");
