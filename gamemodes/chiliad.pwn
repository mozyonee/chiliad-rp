			actor[1] = CreateActor(109, 2303.6292, -1993.4894, 13.5696, 265.9584); // Бот зброї
			actor[2] = CreateActor(108, 2304.7039, -1997.4758, 13.5545, 236.9311); // Бот матеріалів
