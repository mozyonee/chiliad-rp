		case D_CONTAINER_3: {
				if(!response) return DeletePVar(playerid, "list_predm");
				new id = GetPVarInt(playerid, "list_predm");
				switch(listitem) {
				case 0: {
						if(CountInfo[playerid][cont_type][id] == 1) {
							if(GetItemAmount(playerid, 0) <= 0) return SendError(playerid, "В інвентарі недостатньо місця.");
							AddItem(playerid, CountInfo[playerid][cont_model][id], 1);
						}
						if(CountInfo[playerid][cont_type][id] == 2) {
							if(CI[playerid][pPremium]) return SendError(playerid, "На вашому акаунті вже є активний преміум.");
							CI[playerid][pPremium] = gettime() +(1*CountInfo[playerid][cont_model][id]*60*60);
							UpdateCharacterData(playerid, "premium", CI[playerid][pPremium]);
						}
						if(CountInfo[playerid][cont_type][id] == 3) {
							if(GetItemAmount(playerid, 0) <= 0) return SendError(playerid, "В інвентарі недостатньо місця.");
							AddItem(playerid, skin_undress[CountInfo[playerid][cont_model][id]][0], 1);
						}
						if(CountInfo[playerid][cont_type][id] == 4) GiveMoney(playerid, 100000, "гроші з контейнера");
						if(CountInfo[playerid][cont_type][id] == 5) {
							CI[playerid][pCases][1] += 1;
							UpdateCharacterData(playerid, "case_2", CI[playerid][pCases][1]);
						}
						if(CountInfo[playerid][cont_type][id] == 6) {
							CI[playerid][pExp] += CountInfo[playerid][cont_model][id];
							UpdateExp(playerid);
						}
						if(CountInfo[playerid][cont_type][id] == 7) {
							GiveDonate(playerid, CountInfo[playerid][cont_model][id], "донат з контейнера");
						}
						if(CountInfo[playerid][cont_type][id] == 8) GiveMoney(playerid, 200000, "гроші з контейнера");

						SendOK(playerid, "Предмет використано.");
						MYSQL_GLOBAL[0] = EOS;
						mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "DELETE FROM `priz` WHERE `id` = %i",CountInfo[playerid][cont_id][GetPVarInt(playerid, "list_predm")]);
						mysql_tquery(connects, MYSQL_GLOBAL, "", "");
						DeletePVar(playerid, "list_predm");
					}
				case 1: {
						SendOK(playerid, "Предмет продано.");
						GiveMoney(playerid,CountInfo[playerid][cont_cash][GetPVarInt(playerid, "list_predm")], "продаж предмету з контейнера");
