stock SendDead(ids,whoids, killerid, playerid, reason) {
	foreach(new m:Player) { 
		if(reason == 0) return 1;
		if(!TI[m][tLogin]) continue;
		if(CI[m][pMember] == ids || CI[m][pMember] == whoids) SendDeathMessageToPlayer(m, killerid, playerid, reason);
	}
	return 1;
}
stock DollahScoreUpdate(playerid) return SetPlayerScore(playerid, CI[playerid][pLevel]);

stock IsState(playerid) {
	if(!IsPlayerConnected(playerid)) return 0;
	switch(FI[CI[playerid][pMember]][fType]) {
		case fGOVERNMENT, fENFORCEMENT, fMEDIC: return 1;
	}
	return 0;
}
stock IsCrime(playerid) {
    if(!IsPlayerConnected(playerid)) return 0;
	switch(FI[CI[playerid][pMember]][fType]) {
		case fGANG, fMAFIA: return 1;
	}
	return 0;
}
stock IsCivil(playerid) {
    if(!IsPlayerConnected(playerid)) return 0;
	switch(FI[CI[playerid][pMember]][fType]) {
		case fMEDIA, fCIVIL: return 1;
	}
	return 0;
}
stock IsAGovernment(playerid) {
	if(!IsPlayerConnected(playerid)) return 0;
	if(FI[CI[playerid][pMember]][fType] == fGOVERNMENT) return 1;
	return 0;
}
stock IsAnEnforcement(playerid) {
	if(!IsPlayerConnected(playerid)) return 0;
	if(FI[CI[playerid][pMember]][fType] == fENFORCEMENT) return 1;
	return 0;
}
stock IsAMedic(playerid) {
	if(!IsPlayerConnected(playerid)) return 0;
	if(FI[CI[playerid][pMember]][fType] == fMEDIC) return 1;
	return 0;
}
stock IsAMafia(playerid) {
	if(!IsPlayerConnected(playerid)) return 0;
	if(FI[CI[playerid][pMember]][fType] == fMAFIA) return 1;
	return 0;
}
stock IsAGang(playerid) {
	if(!IsPlayerConnected(playerid)) return 0;
	if(FI[CI[playerid][pMember]][fType] == fGANG) return 1;
	return 0;
}
stock IsAMedia(playerid) {
	if(!IsPlayerConnected(playerid)) return 0;
	if(FI[CI[playerid][pMember]][fType] == fMEDIA) return 1;
	return 0;
}
stock IsACivil(playerid) {
	if(!IsPlayerConnected(playerid)) return 0;
	if(FI[CI[playerid][pMember]][fType] == fCIVIL) return 1;
	return 0;
}

