						PlayerTextDrawBackgroundColor(playerid, nInventorySlots_TD[playerid][ClickInv[playerid]], 0x222222ff);
						PlayerTextDrawShow(playerid, nInventorySlots_TD[playerid][ClickInv[playerid]]);
