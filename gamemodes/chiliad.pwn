							STRING_GLOBAL[0] = EOS;
							format(STRING_GLOBAL, sizeof(STRING_GLOBAL), W"Клас контейнера:{F9C7A1} %s\n"W"Початкова ставка:{F9C7A1} %i UAH"W"\nОстання ставка:{F9C7A1} %i UAH"W"\n\n"W"\
