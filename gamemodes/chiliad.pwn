							static const f_str[] = "\n\n"W"Ви справді хочете хочете почати роботу "P"збирача курячих яєць?\n"W"Вартість за 1 яйце сягає "GREEN"$%i\n\n";
							new string[sizeof(f_str) + 1 + (-2 + 6)];
