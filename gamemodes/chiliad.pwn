}
stock PayDay() {
	condition_of_roads_ = random(3);
	new bool:newday, day = GetDayNumber(), h, m, s;
	if(gCurDay != day)	{gCurDay = day; newday = true;}

	gettime(h, m, s);
	weeklast = weekcurrent;
	weekcurrent = load_week();

	if(weeklast != weekcurrent) {
		foreach(new i: Player) {
			if(!TI[i][tLogin]) continue;
			if(PI[i][pAdmin] > 0 && GetPVarInt(i, "adminaccess") == 1 || gAdmin[i][7] == 1) {
				static const Names_Days[7][22] = {"online_monday", "online_tuesday", "online_wednesday", "online_thursday", "online_friday", "online_saturday", "online_sunday"};
				new string[450];
				mysql_format(connects, string, sizeof (string), "UPDATE "TABLE_ADMINS" SET `%s` = %i, `kick` = %i, `ban` = %i, `mute` = %i, `pm` = %i, `warn` = %i, `jail` = %i,`vig`=%i,`blockadmin`=%i,`rep`=%i,online_status = '0' WHERE `Name` = '%s' LIMIT 1", Names_Days[weeklast], gAdminTime[i], gAdmin[i][0], gAdmin[i][1], gAdmin[i][2], gAdmin[i][3], gAdmin[i][4], gAdmin[i][5], gAdmin[i][6], gAdmin[i][7], gAdmin[i][8], CI[i][cName]);
				mysql_pquery(connects, string, "", "");

				printf("[Log] Admin %s has changes his time: %i.", CI[i][cName], gAdminTime[i]);
				gAdminTime[i] = 0;
			}
		}
	}
	if(newday) {
		new saturday = 1310155200, w = gettime(), day_week;
		while(w - saturday > 60 * 60 * 24) {
			w -= 60 * 60 * 24;
			day_week ++;
		}
		while(day_week >= 7) day_week -= 7;
		for (new i = 1; i < MAX_FACTIONS; i ++) {
			FI[i][fBank] = 0;
			mysql_pquery(connects, "UPDATE "TABLE_FACTIONS" SET `Bank` = '0'", "", "");
		}
		mysql_tquery(connects, "DELETE FROM `questsprogress` WHERE `day` > 0", "", "");
		foreach(new i:Player) {
			if(!CI[i][bizz_lcash]) continue;
			CI[i][bizz_lcash] = 0;
		}
		mysql_pquery(connects, "UPDATE "TABLE_CHARACTERS" SET `bizz_lcash` = '0'", "", "");
	}
	new string[120];
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(!GetPlayerInterior(i)) SetPlayerTime(i, tmphour, tmpminute);
		else SetPlayerTime(i, 12, 00);
		if(CI[i][pMember] && start_work[i]) CI[i][pSalary] += fSalary[CI[i][pMember]][CI[i][pRank]];
		SendClientMessage(i, COLOR_GREY, "----------[ Банківський чек ]----------");
		CI[i][pExp] += 3 * PayDayX;
		if(CI[i][pBoost]) format(string, sizeof(string), "Заробітня плата: "GREEN"$%i"W".", CI[i][pSalary]*2);
		else format(string, sizeof(string), "Заробітня плата: "GREEN"$%i"W".", CI[i][pSalary]);
		SendClientMessage(i, -1, string);
		if(CI[i][pBoost]) CI[i][pBank] += CI[i][pSalary] * 2;
		else CI[i][pBank] += CI[i][pSalary];
		CI[i][pSalary] = 0;
		UpdateCharacterData(i, "salary", CI[i][pSalary]);
		if(CI[i][pLevel] <= 3 && Nalog[1]) {
			format(string, sizeof(string), "Допомога від уряду: "GREEN"$%i"W".", Nalog[2]);
			SendClientMessage(i, -1, string);
			CI[i][pBank] += Nalog[2];
			for(new n = 1; n < MAX_FACTIONS; n++) {
				if(FI[n][fType] == fGOVERNMENT) {
					FI[n][fBank] -= Nalog[2];
					UpdateFaction(n, "Bank", FI[n][fBank]);
				}
			}
		}
		SendClientMessage(i, COLOR_GREY, "--------------------------------------------------");
		if(CI[i][pExp]+ 1 >= (CI[i][pLevel])*6) {
			CI[i][pLevel] += 1;
			CI[i][pExp] = 0;
			UpdateCharacterData(i, "pLevel", CI[i][pLevel]);
			DollahScoreUpdate(i);
			SendInfo(i, "Вітаємо, ваш рівень підвищено.");
		}
		if(QuestProgress[i][14] < 5 && AcceptQuest[i][14] != 0) QuestProgress[i][14] ++,save_quest(i, 14);
		if(QuestProgress[i][14] == 5 && AcceptQuest[i][14] != 0) {
			SPD(i, DIALOG_NONE, DSM, P"Виконання квесту.", W"Ви закінчили виконання квесту 'Щаслива година'\n\t"NO"Квест можна завершити в Лукаса", "Закрити", "");
			NextStapQI(i, 14);
		}
		if(QuestProgress[i][52] < 3 && AcceptQuest[i][52] != 0) QuestProgress[i][52] ++,save_quest(i, 52);
		if(QuestProgress[i][52] == 3 && AcceptQuest[i][52] != 0) {
			SPD(i, DIALOG_NONE, DSM, P"Виконання квесту.", W"Ви завершили виконання щоденного квесту\n\t"NO"Квест можна завершити в "P"/quest.", "Закрити", "");
		}
		if(IsAnEnforcement(i)) {
			if(QuestProgress[i][39] < 36 && AcceptQuest[i][39] != 0) QuestProgress[i][39] ++,save_quest(i, 39);
			if(QuestProgress[i][39] == 36 && AcceptQuest[i][39] != 0) {
				SPD(i, DIALOG_NONE, DSM, P"Виконання квесту.", W"Ви закінчили виконання квесту 'Активний працівник'\n\t"NO"Квест можна завершити в списку квестів (/quest)", "Закрити", "");
			}
		}
		if(CI[i][pMember] > 0) {
			if(QuestProgress[i][12] < 30 && AcceptQuest[i][12] != 0) QuestProgress[i][12] ++,save_quest(i, 12);
			if(QuestProgress[i][12] == 30 && AcceptQuest[i][12] != 0) {
				SPD(i, DIALOG_NONE, DSM, P"Виконання квесту.", W"Ви закінчили виконання квесту 'Кращий працівник'\n\t"NO"Квест можна завершити в Лукаса", "Закрити", "");
				NextStapQI(i, 12);
			}
		}
		if(IsAnEnforcement(i)) {
			if(QuestProgress[i][11] < 3 && AcceptQuest[i][11] != 0) QuestProgress[i][11] ++,save_quest(i, 11);
			if(QuestProgress[i][11] == 3 && AcceptQuest[i][11] != 0) {
				SPD(i, DIALOG_NONE, DSM, P"Виконання квесту.", W"Ви закінчили виконання квесту 'Служба в гвардії'\n\t"NO"Квест можна завершити в Лукаса", "Закрити", "");
				NextStapQI(i, 11);
			}
		}
		if(IsAMafia(i)) {
			if(QuestProgress[i][33] < 10 && AcceptQuest[i][33] != 0) QuestProgress[i][33] ++,save_quest(i, 33);
			if(QuestProgress[i][33] == 10 && AcceptQuest[i][33] != 0) {
				SPD(i, DIALOG_NONE, DSM, P"Виконання квесту.", W"Ви закінчили виконання квесту 'Активний мафіозі'\n\t"NO"Квест можна завершити в списку квестів (/quest)", "Закрити", "");
			}
		}
		if(QuestProgress[i][61] < 5 && AcceptQuest[i][61] != 0) QuestProgress[i][61] ++,save_quest(i, 61);
        if(QuestProgress[i][61] == 5 && AcceptQuest[i][61] != 0)
	    {
	       SPD(i, DIALOG_NONE, DSM, P"Завдання.", W"Ви пройшли квестову лінію Гелловіну!\n\nЗавершіть квест у мерії, щоб забрати головний подарунок!", "Закрити", "");
	    }
		CI[i][pPlayTime][0] = 0;
		CI[i][pZakonp]++;
		UpdateCharacterData(i, "pExp", CI[i][pExp]);
		UpdateCharacterData(i, "pZakonp", CI[i][pZakonp]);

		if(CI[i][pLevel] >= 3 && CI[i][pMPromo]) {
			new str[128];
			format(str, sizeof(str), "Вам було зараховано "GREEN"$%i"W" за введений раніше промокод.", CI[i][pMPromo]);
			SendOK(i, str);
			GiveMoney(i, CI[i][pMPromo], "промокод");
			CI[i][pMPromo] = 0;
			UpdateCharacterData(i, "pMPromo", 0);
		}
		if(CI[i][pZakonp] > 100) CI[i][pZakonp] = 100;
		if(CI[i][pSearch] >= 1) {
			CI[i][pSearch] --;
			if(CI[i][pSearch] < 0) CI[i][pSearch] = 0;
			SetPlayerWantedLevel(i, CI[i][pSearch]);
			UpdateCharacterData(i, "pSearch", CI[i][pSearch]);
		}
		if(CI[i][pLevel] >= 4 && !CI[i][pDrugInv]) {
			CI[i][pDrugInv] = 1;
			UpdateCharacterData(i, "drunginv", 1);
			new query[128];
			mysql_format(connects, query, sizeof(query), "SELECT pFriend FROM "TABLE_CHARACTERS" WHERE cID = %i", CI[i][cID]);
			mysql_tquery(connects, query, "reg_friend", "i",i);
		}
		if(CI[i][pFamily]) {
			if(CI[i][pPremium]) reputation_family(CI[i][pFamily]-1, 1);
			gFamily[CI[i][pFamily]-1][famTalon] += 1;
			UpdateFamily(CI[i][pFamily], "talon", gFamily[CI[i][pFamily]-1][famTalon]);
			CI[i][pFamTalon] += 1, UpdateCharacterData(i, "talon_fam", CI[i][pFamTalon]);
		}
		UpdateCharacterData(i, "pBank", CI[i][pBank]);
		if(CI[i][pCredit]) {
			new str[150];
			format(str, sizeof(str), "У вас кредит на суму: "GREEN"$%i"W".", CI[i][pCredit]);
			SendInfo(i, str);
		}
		UpdateFaction(CI[i][pMember], "Bank", FI[CI[i][pMember]][fBank]);
	}
	pay_realty();
	if(bank_vzlom[3] > 0) bank_vzlom[3]--;
	if(h == 18) SetTimer("LottoInf2", 1000 * 20, false);
	else SetTimer("LottoInf", 1000 * 60 * 5, false);
	return 1;
}
stock split(const strsrc[], strdest[][], delimiter) {
	new i, li;
	new aNum;
	new len;
	while(i <= strlen(strsrc)) {
		if(strsrc[i] == delimiter || i == strlen(strsrc)) {
			len = strmid(strdest[aNum], strsrc, li, i, 128);
			strdest[aNum][len] = 0;
			li = i+ 1;
			aNum++;
		}
		i++;
	}
	return 1;
}
stock AdmMSG(color,const str[]) {
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(GetPVarInt(i, "adminaccess") != 1) continue;
		if(!CI[i][pAdmMSG]) continue;
		SendClientMessage(i, color, str);
	}
}
stock SendDeptMessage(color, const string[]) {
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(!start_work[i]) continue;
		if(!CI[i][pSettings][1]) continue;
		if(IsState(i)) SendClientMessage(i, color, string);
	}
	return 1;
}
stock SendPDMessage(color, const string[]) {
    foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(!start_work[i]) continue;
		if(!CI[i][pSettings][1]) continue;
		if(IsAnEnforcement(i)) SendClientMessage(i, color, string);
	}
	return 1;
}
stock SendMCMessage(color, const string[]) {
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(!start_work[i]) continue;
		if(!CI[i][pSettings][1]) continue;
		if(IsAMedic(i)) SendClientMessage(i, color, string);
	}
	return 1;
}
stock MarkerGos(playerid, Float:x, Float:y, Float:z) {
	foreach(new i:Player) {
		if(IsState(i)) SetPlayerCheckpoint(playerid, x, y, z, 5.0);
	}
}
stock SendRadioMessage(playerid, const text[], channel, slot) {
	new string[256];
	format(string, sizeof(string), "[CH: %i, S: %i] %s: %s", channel, slot, CI[playerid][cName], text);
	SendSpyMessage(CI[playerid][pMember], 0xFFFFCCFF, string);
	foreach(new i:Player) {
		if(TI[i][tLogin] && CI[i][pSettings][1]) {
			if(channel == CI[i][cRadioChannel] && slot == 0) SendClientMessage(i, 0xFFFFCCFF, string);
			else if(channel == CI[i][cRadioChannel] && slot == CI[i][cRadioSlot]) SendClientMessage(i, 0xFFFFCCFF, string);
		}
		if(GetPVarInt(i, "admin_tipster") == CI[playerid][pMember]) SendClientMessage(i, 0xFFFFCCFF, string);
	}
}
stock SendFactionMessage(family, color, const str[]) {
	foreach(new i:Player) if(TI[i][tLogin] && CI[i][pSettings][1] && CI[i][pMember] == family) SendClientMessage(i, color, str);
}
stock SendAdminMessage(color, const str[]) {
	foreach(new i:Player) {
		if(TI[i][tLogin] && !PI[i][pAdmin] || GetPVarInt(i, "adminaccess") != 1) continue;
		SendClientMessage(i, color, str);
	}
}
stock FamMSG(fam, const str[]) {
	foreach(new i:Player) {
		if(TI[i][tLogin] && CI[i][pFamily] != fam) continue;
		SendClientMessage(i, FamilyColorG[gFamily[fam-1][famColor]], str);
	}
}
CMD:mycollab(playerid) {
	ShowPlayerDialog(playerid, D_MYCOLLAB, DSL, P"Статистика співпраці.", "Інформація про мій промокод.\nМої реферали.", "Обрати", "Закрити");
}

alias:mycollab("mypromo", "promo")
stock IsText(const name[], const name2[]) {
	if(!strcmp(name, name2, true)) return 1;
	return 0;
}
CMD:referals(playerid) {
	new string[1024], Name[24], Level,query[156];
	mysql_format(connects, query, sizeof(query), "SELECT `Name`, `pLevel` FROM "TABLE_CHARACTERS" WHERE `pFriend` = '%s' ORDER BY `pLevel` DESC LIMIT 10", CI[playerid][cName]);
	new Cache:result = mysql_query(connects, query);
	new rows;
	string[0] = 0; FirstReferal[playerid] = 0;
	cache_get_row_count(rows);
	if(rows) {
		for(new i; i < rows; i ++) {
			cache_get_value_name(i, "Name", Name, MAX_PLAYER_NAME);
			cache_get_value_name_int(i, "pLevel",Level);
			if(Level < 4) format(string, sizeof(string), "%s"ORANGE"%i."W" %s - "NO"%i LEVEL\n", string, i+ 1, Name, Level);
			else format(string, sizeof(string), "%s"ORANGE"%i."W" %s - "GREEN"%i LEVEL\n", string, i+ 1, Name, Level);
		}
		if(!ShowPlayerDialog(playerid, D_REFERALS, 0, "Запрошені", string, "Далі", "Назад")) SendError(playerid, "Недоступно, спробуйте повторити.");
	} else SendError(playerid, "Вас ніхто не вказував, як запросившого на сервер.");
	cache_delete(result);
	return 1;
}
CMD:bankhack(playerid) {
	if(!IsPlayerInRangeOfPoint(playerid, 2.5, -1146.6504, 28.7822, 1169.5699)) return SendError(playerid, "Ви не поруч зі сховищем банку.");
	if(!TI[playerid][tCodeBank]) return SendError(playerid, "Ви не отримали код у Каренa.");
	if(bank_vzlom[3]) {
		new string[80];
		format(string, sizeof(string), "Банк можна буде пограбувати через %i год.",bank_vzlom[3]);
		SendError(playerid, string);
		return 1;
	}
	new Float:X, Float:Y, Float:Z, count = 0;
	GetPlayerPos(playerid, X, Y, Z);
	foreach(new i:Player) {
		if(!TI[i][tLogin] || CI[i][pMember] != CI[playerid][pMember]) continue;
		if(IsPlayerInRangeOfPoint(i, 8.0, X, Y, Z) && GetPlayerVirtualWorld(i) == GetPlayerVirtualWorld(playerid)) count++;
	}
	if(count < 3) return SendError(playerid, "З вами повинно знаходитися щонайменш 3 людини для пограбування банку.");
	for(new it = 0; it < 24; it++) TextDrawShowForPlayer(playerid, hack_magaz_TD[it]);
	for(new i = 0; i < 13; i++) PlayerTextDrawShow(playerid, hack_numbers[playerid][i]);
	SelectTextDraw(playerid, 0x0080FFFF);

	new rand;
	rand = random(10);
	PlayerTextDrawColor(playerid, hack_numbers[playerid][rand], 0xfC40E26ff);
	PlayerTextDrawShow(playerid, hack_numbers[playerid][rand]);

	SetPVarInt(playerid, "ExpectedSelectionTD", rand);
	SetPVarInt(playerid, "bank_rob", 1);
	progress_rob[playerid] = 0;
	bank_vzlom[2] = CI[playerid][pMember];

	PlayerTextDrawTextSize(playerid, hack_numbers[playerid][12], progress_rob[playerid]*96.4701/10, 10.0000);
	PlayerTextDrawShow(playerid, hack_numbers[playerid][12]);
	return 1;
}
CMD:fixcar(playerid) {
	if(!CI[playerid][pHouse] && !CI[playerid][pRoom] && !CI[playerid][pTempKey]) return SendError(playerid, "Ви не маєте будинку чи квартири.");
	new string[144];
	format(string, sizeof(string), W"1. Транспорт #1 "P"[%s]"W" - "GREEN"$500\n"W"2. Транспорт #2 "P"[%s]"W" - "GREEN"$500", gTransport[CarsInfo[playerid][carModel][0]-400][trName], gTransport[CarsInfo[playerid][carModel][1]-400][trName]);
	ShowPlayerDialog(playerid, D_FIXCAR, DSL, P"Доставити транспорт", string, "Обрати", "Закрити");
	return 1;
}
