	PlayerTextDrawLetterSize(playerid,CaptPlayer[playerid][4], 0.1489, 0.7662);
	PlayerTextDrawAlignment(playerid,CaptPlayer[playerid][4], 2);
	PlayerTextDrawColor(playerid,CaptPlayer[playerid][4], -1);
	PlayerTextDrawBackgroundColor(playerid,CaptPlayer[playerid][4], 255);
	PlayerTextDrawFont(playerid,CaptPlayer[playerid][4], 2);
	PlayerTextDrawSetProportional(playerid,CaptPlayer[playerid][4], 1);
	PlayerTextDrawSetShadow(playerid,CaptPlayer[playerid][4], 0);

	CaptPlayer[playerid][5] = CreatePlayerTextDraw(playerid, 60.3333, 216.9630, "CAPTURE"); // пусто
	PlayerTextDrawLetterSize(playerid, CaptPlayer[playerid][5], 0.1556, 0.8865);
	PlayerTextDrawAlignment(playerid, CaptPlayer[playerid][5], 2);
	PlayerTextDrawColor(playerid, CaptPlayer[playerid][5], -1);
	PlayerTextDrawBackgroundColor(playerid, CaptPlayer[playerid][5], 255);
	PlayerTextDrawFont(playerid, CaptPlayer[playerid][5], 2);
	PlayerTextDrawSetProportional(playerid, CaptPlayer[playerid][5], 1);
	PlayerTextDrawSetShadow(playerid, CaptPlayer[playerid][5], 0);
}
stock sell_bizztaxi(bizz) {
	new query[128],querydel[174],names[25],rows;
	mysql_format(connects, query, sizeof(query), "SELECT * FROM "TABLE_CHARACTERS" WHERE bizz_work = %i", bizz);
	new Cache:result = mysql_query(connects, query);
	cache_get_row_count(rows);
	if(rows) {
		for(new i; i < rows; i ++) {
			cache_get_value_name(i, "Name", names, MAX_PLAYER_NAME);
			new id = GetPlayerID(names);
			if(IsPlayerConnected(id)) {
				if(GetPlayerState(id) == PLAYER_STATE_DRIVER && VehicleInfo[GetPlayerVehicleID(id)][vBizz] == CI[id][bizz_work]) RemovePlayerFromVehicleAC(id);
				CI[id][bizz_work] = 0;
				CI[id][bizz_status] = 0;
			}
			format(querydel, sizeof(querydel), "UPDATE "TABLE_CHARACTERS" SET `bizz_work` = '0',`bizz_status` = '0' WHERE `Name` = '%s'",names);
			mysql_tquery(connects, querydel, "", "");
		}
	}
	cache_delete(result);
	UpdateBusinessText(bizz);
}
stock dialog_mk(playerid, bizz, listitem) {
	switch(listitem) {
		case 0:{
			if(CI[playerid][bizz_status] != 3) return SendError(playerid, "Доступ є тільки у керівника мікрозайму.");
			new bizid = CI[playerid][pBusiness]-1;
			new status[20], atext[64];	
			strmid(atext, FI[gBusiness[bizid][bizzMafia]][fName], 0, sizeof(atext));
			if(gBusiness[bizid][bizzStatus]) strcat(status, GREEN"Працює");
			else strcat(status, ""NO"Не працює");
			new day = (gBusiness[bizid][bizzDay]-gettime())/86400;
			new string[650];
			format(string, sizeof(string), W"Назва: "P"%s"W"\n\
								Державна ціна: "GREEN"$%i"W"\n\
								Каса: "GREEN"$%i"W"\n\
								Зароблено за добу: "GREEN"$%i"W"\n\
								Відвідувачів: "P"%i"W"\n\
								Оренда бізнесу: "P"%i"W"\n\
								Дах: "P"%s\n\
								Стан: "P"%s"W, gBusiness[bizid][bizzName],
			gBusiness[bizid][bizzSellPrice], gBusiness[bizid][bizzBank], gBusiness[bizid][bizzBankDay], gBusiness[bizid][bizzVisitors],day, atext, status);
			ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Бізнес.", string, "Закрити", "");
		}
		case 1: {
			if(!CI[playerid][pCredit]) {
				if(CI[playerid][pLevel] < 5) return SendError(playerid, "Ваш рівень повинен бути не менше 5.");
				if(!CI[playerid][pHouse]) return SendError(playerid, "Ви не маєте будинку або квартири.");
				if(!CI[playerid][pMember]) return SendError(playerid, "Ви не перебуваєте в організації.");
				switch(CI[playerid][pLevel]) {
					case 5..9: return ShowPlayerDialog(playerid, D_CREDIT_BUY, DSI, "Взяти кредит", W"Введіть суму, яку, хочете взяти в кредит:\n\
					Сума повинна бути, не менше ніж "GREEN"$50.000"W" і не більше ніж "GREEN"$500.000", "Далі", "Скасувати");
					case 10..1000: return ShowPlayerDialog(playerid, D_CREDIT_BUY, DSI, "Взяти кредит", W"Введіть суму, яку, хочете взяти в кредит:\n\
					Сума повинна бути, не менше ніж "GREEN"$500.000"W" і не більше ніж "GREEN"$1.000.000", "Далі", "Скасувати");

				}
			} else{
				new str[150];
				format(str, sizeof(str), W"Заборгованість: "GREEN"%i\n\
				"W"Введіть суму, яку ви хочете погасити:", CI[playerid][pCredit]);
				return ShowPlayerDialog(playerid, D_CREDIT_TAKE, DSI, "Погасити кредит.", str, "Далі", "Скасувати");
			}

		}
		case 2: {
			if(CI[playerid][bizz_status] != 3) return SendError(playerid, "Доступ тільки у керівника цього бізнесу.");
			static const f_str[] = ""W"Стан рахунку: "GREEN"$%i\n"P"1."W" Зняти гроші\n"P"2."W" Покласти гроші";
			new string[sizeof(f_str) + 1 + (-2 + 10)];
			format(string, sizeof(string), f_str, gBusiness[CI[playerid][pBusiness] - 1][bizzBank]);
			ShowPlayerDialog(playerid, D_BIZZ_BANK, DSL, P"Керування касою", string, "Далі", "Назад");
		}
		case 3:{
			if(CI[playerid][bizz_status] != 3) return SendError(playerid, "Доступ тільки у керівника цього бізнесу.");
			new string[200];
			format(string, sizeof(string), W"Ви хочете продати мікрозайм державі за "GREEN"$%i?\n\n"G"Для продажу мікрозайму гравцю введіть: /sellbusiness [playerid] [amount]", floatround(gBusiness[bizz-1][bizzSellPrice]/100*80));
			ShowPlayerDialog(playerid, D_BIZZ_SELL, DSM, P"Бізнес", string, "Продати", "Скасувати");
		}
	}
	return 1;
}
