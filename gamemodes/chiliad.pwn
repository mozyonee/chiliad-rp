				if(CI[playerid][bizz_work] == 5 || CI[playerid][bizz_work] == 6 || CI[playerid][bizz_work] == 7) return SendError(playerid, "Ви вже працюєте в транспортній компанії.");
				CI[playerid][bizz_work] = bizz;
