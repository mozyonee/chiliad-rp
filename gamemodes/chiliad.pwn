								InfoDice[c][dice_gamer][i] = playerid;
								check_played = true;
								break;
							}
						}
						if(!check_played) return SendError(playerid, "Максимум гравців: 5.");
					}
					Casino_Flag[playerid][select_casino_table] = c;
					ShowCasino_TD(playerid, Casino_Flag[playerid][select_casino_table]);
					UpdateTextCasino(c);
