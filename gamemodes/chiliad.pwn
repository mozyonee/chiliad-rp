			mysql_tquery(connects, query, "", "");
		}
	case 10: {
			new query[256];
			mysql_format(connects, query, sizeof(query), "UPDATE `economy` SET salary_rcso = '%s' LIMIT 1", data);
			mysql_tquery(connects, query, "", "");
