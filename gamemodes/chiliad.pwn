CB:characters_panel(playerid) {
	new cstage, rows, query[512], name[MAX_PLAYER_NAME], status[32], negative[16], header[150], content[450] = "Ім'я\tСтатус\n";

	mysql_format(connects, query, sizeof(query), "SELECT `Name`, `cStage` FROM "TABLE_CHARACTERS" WHERE `cOwner` = '%s'", PI[playerid][pName]);
	mysql_query(connects, query);
	cache_get_row_count(rows);
	if(rows) {
		for(new i; i < rows; i++) {	
			cache_get_value_name_int(i, "cStage", cstage);
			cache_get_value_name(i, "Name", name);
			if(cstage == 2) status = R"Мертвий";
			else status = GREEN"Доступний";
			if(strcmp(name, PI[playerid][pName])) format(content, sizeof(content), "%s%s\t%s"W"\n", content, name, status);
		}
	}
	strcat(content, P"-"W" Створити персонажа.\n");

	mysql_format(connects, query, sizeof(query), "SELECT `rank` FROM `admin` WHERE `Name` = '%s' LIMIT 1", PI[playerid][pName]);
	mysql_query(connects, query);
	cache_get_row_count(rows);
	if(rows) cache_get_value_name_int(0, "rank", PI[playerid][pAdmin]);
	else PI[playerid][pAdmin] = 0;

	if(PI[playerid][pAdmin] > 0 && GetPVarInt(playerid, "adminaccess") == 0) strcat(content, P"-"W" Увійти як адміністратор.");

	negative = TI[playerid][tStarted] ? "Назад" : "Вийти";

	format(header, sizeof(header), P"|"W" Керування %s.", PI[playerid][pName]);
	ShowPlayerDialog(playerid, D_CHAR_LIST, DSTH, header, content, "Обрати", negative);
	return 1;
}
CB:account_authorization(playerid) {
	new content[450];
	format(content, sizeof(content), W"Вітаємо на "P"Chiliad RP"W"!\n\n\
		Акаунт %s "GREEN"зареєстровано"W" на нашому сервері.\nВведіть пароль для авторизації:\n\n", PI[playerid][pName]);
	ShowPlayerDialog(playerid, D_LOGIN, DSP, P"|"W" Авторизація.", content, "Далі", "Вийти");
	return 1;
}
CB:account_registration(playerid) {
	new content[450];
	format(content, sizeof(content), W"Вітаємо на "P"Chiliad RP"W"!\n\n\
		Акаунт %s "R"не зареєстровано"W" на нашому сервері.\nВведіть пароль для реєстрації:\n\n\
		"G"* Довжина паролю повинна бути від 6 до 30 символів.\n* Пароль повинен містити у собі букви та цифри.\n* Пароль чутливий до регістру.\n\n", player_name[playerid]);
	ShowPlayerDialog(playerid, D_REG, DSI, P"|"W" Реєстрація.", content, "Далі", "Вийти");
	return 1;
}
