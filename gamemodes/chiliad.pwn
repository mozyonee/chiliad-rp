		SetPlayerFacingAngle(TI[playerid][tFight], 89.1145);
		if(RingInfo[r][rgStart] == 0) return 1;
		GiveMoney(TI[playerid][tFight],(RingInfo[r][rgPrice]), "победа поединок");
