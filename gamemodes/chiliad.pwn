CB:clothes_timer(playerid) {
	if(IsPlayerAttachedObjectSlotUsed(playerid, 8)) RemovePlayerAttachedObject(playerid, 8);
	TI[playerid][tClothesWork][1] = 2;
	ClearAnimations(playerid);
	ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 1, 1, 1, 1, 1, 1);
	if(!IsPlayerAttachedObjectSlotUsed(playerid, 8)) SetPlayerAttachedObject(playerid, 8, 2386, 5, 0.100000, 0.100000, 0.200000, 100.0, 170.0, 100.0, 1.0, 1.0, 1.0);
	EnableGPSForPlayer(playerid, 3627.6726, -733.5646, 20.2793);
	return 1;
}
stock SaveSpawnData(playerid) {
	new
	houseid = TI[playerid][tSelectHouse],
	businessid = TI[playerid][tSelectedBusinessID];
	CI[playerid][pSpawnTPPick] = 1;
	if(
			TI[playerid][tDuel] != -1 || player_to_game[playerid] ||
			player_to_race_lv[playerid] || TI[playerid][tDM] || CI[playerid][pJailTime] > 0
			) {
		CI[playerid][pSpawnPos][0] = 0.0;
		CI[playerid][pSpawnPos][1] = 0.0;
		CI[playerid][pSpawnPos][2] = 0.0;
		CI[playerid][pSpawnPos][3] = 0.0;
		CI[playerid][pSpawnInterior] = 0;
		CI[playerid][pSpawnWorld] = 0;
		CI[playerid][pSpawnTPPick] = 0;
	}
	if(houseid && (0 <= houseid < sizeof(gHouses))) {
		new houseint = gHouses[houseid][houseHint];
		if(0 <= houseint < sizeof (hinterior_info) &&
				IsPlayerInRangeOfPoint(playerid, 50.0,
					hinterior_info[houseint][h_pos_exit][0],
					hinterior_info[houseint][h_pos_exit][1],
					hinterior_info[houseint][h_pos_exit][2]
					)
				) {
			CI[playerid][pSpawnPos][0] = gHouses[houseid][houseX];
			CI[playerid][pSpawnPos][1] = gHouses[houseid][houseY];
			CI[playerid][pSpawnPos][2] = gHouses[houseid][houseZ];
			CI[playerid][pSpawnPos][3] = 0.0;
			CI[playerid][pSpawnInterior] = 0;
			CI[playerid][pSpawnWorld] = 0;
		}
	} else if(GetPVarInt(playerid, "buy_interior")) {
		houseid = CI[playerid][pHouse] - 1;
		if(0 <= houseid < sizeof (gHouses)) {
			CI[playerid][pSpawnPos][0] = gHouses[houseid][houseX];
			CI[playerid][pSpawnPos][1] = gHouses[houseid][houseY];
			CI[playerid][pSpawnPos][2] = gHouses[houseid][houseZ];
			CI[playerid][pSpawnPos][3] = 0.0;
			CI[playerid][pSpawnInterior] = 0;
			CI[playerid][pSpawnWorld] = 0;
		}
	} else if(businessid && (0 <= businessid < sizeof (gBusiness))) {
		new businessint = gBusiness[businessid][bizzBint] - 1;
		if(0 <= businessint < sizeof (gBints) &&
				IsPlayerInRangeOfPoint(playerid, 50.0,
					gBints[businessint][bintX],
					gBints[businessint][bintY],
					gBints[businessint][bintZ]
					)
				) {
			CI[playerid][pSpawnPos][0] = gBusiness[businessid][bizzX];
			CI[playerid][pSpawnPos][1] = gBusiness[businessid][bizzY];
			CI[playerid][pSpawnPos][2] = gBusiness[businessid][bizzZ];
			CI[playerid][pSpawnPos][3] = 0.0;
			CI[playerid][pSpawnInterior] = 0;
			CI[playerid][pSpawnWorld] = 0;
		}
	} else if(GetPVarInt(playerid, "buy_accses")) {
		CI[playerid][pSpawnPos][0] = GetPVarFloat(playerid, "posx");
		CI[playerid][pSpawnPos][1] = GetPVarFloat(playerid, "posy");
		CI[playerid][pSpawnPos][2] = GetPVarFloat(playerid, "posz");
		CI[playerid][pSpawnPos][3] = GetPVarFloat(playerid, "posa");
		CI[playerid][pSpawnWorld] = GetPVarInt(playerid, "interior");
		CI[playerid][pSpawnInterior]  = GetPVarInt(playerid, "vw");
	} else {
		GetPlayerPos(playerid, CI[playerid][pSpawnPos][0], CI[playerid][pSpawnPos][1], CI[playerid][pSpawnPos][2]);
		GetPlayerFacingAngle(playerid, CI[playerid][pSpawnPos][3]);
		CI[playerid][pSpawnInterior] = GetPlayerInterior(playerid);
		CI[playerid][pSpawnWorld] = GetPlayerVirtualWorld(playerid);
		CI[playerid][pSpawnTPPick] = 0;
	}
	switch (GetPlayerState(playerid)) {
	case PLAYER_STATE_SPECTATING, PLAYER_STATE_NONE: CI[playerid][pSpawnTime] = 0;
	default: CI[playerid][pSpawnTime] = (gettime() + 600);
	}
	new string[450];
	mysql_format(connects, string, sizeof(string), "UPDATE "TABLE_CHARACTERS" SET spawnData='%.2f,%.2f,%.2f,%.2f,%i,%i,%i', spawnTPPick=%i WHERE `cID`=%i",
	CI[playerid][pSpawnPos][0], CI[playerid][pSpawnPos][1], CI[playerid][pSpawnPos][2],
	CI[playerid][pSpawnPos][3], CI[playerid][pSpawnWorld], CI[playerid][pSpawnInterior],
	CI[playerid][pSpawnTime], CI[playerid][pSpawnTPPick], CI[playerid][cID]
	);
	mysql_pquery(connects, string, "", "");
}
CMD:ylist(playerid) {
    if(PI[playerid][pAdmin] < 6 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
    new name[44],rows, count, string[750];
	new Cache:result = mysql_query(connects, "SELECT `Name`,`youtube` FROM "TABLE_CHARACTERS" WHERE `youtube` = 1 LIMIT 50");
    cache_get_row_count(rows);
    if(rows) {
       static const f_str[] = "%i. %s\n";
       new str[sizeof(f_str) + 1 + (-2 + MAX_PLAYER_NAME) + (-2 + 7)];
       for(new i; i < rows; i ++)
       {
	       cache_get_value_name(i, "Name", name, 44);
           count++;
	       format(str, sizeof(str), f_str, count, name);
           strcat(string, str);
       }
       ShowPlayerDialog(playerid, DIALOG_NONE, DSL, P"Список ютуберів", string, "Закрити", "");
    }
    cache_delete(result);
    if(count == 0) return ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Список ютуберів", W"Список ютуберів відсутній", "Закрити", "");
 	return 1;
}
CB:make_youtube(playerid, name[], level) {
   	new rows;
	cache_get_row_count(rows);
	if(!rows) return SendError(playerid, "Гравець не знайдений в базі данних.");

	new query[200];
	format(query, sizeof(query), "UPDATE "TABLE_CHARACTERS" SET `youtube` = %i WHERE `Name` = '%s' LIMIT 1",level, name);
	mysql_tquery(connects, query, "", "");

	new str[120];
	if(level == 1) format(str, sizeof(str), "Ви видали "P"%s"W" ютуберську адмінку.", name);
	else format(str, sizeof(str), "Ви забрали у "P"%s"W" ютуберську адмінку.", name);
	SendOK(playerid, str);

	if(GetPlayerID(name) != INVALID_PLAYER_ID) {
	   str[0] = EOS;
	   if(level == 1) format(str, sizeof(str), "Адміністратор %s видав вам ютуберську адмінку. Для перегляду команд, введіть "P"/yhelp"W".", CI[playerid][cName]);
	   else format(str, sizeof(str), "Адміністратор %s забрав у вас ютуберську адмінку.", CI[playerid][cName]);
	   SendOK(GetPlayerID(name), str);
	   CI[GetPlayerID(name)][pYoutube] = level;
	}
	return 1;
}
