	case 5: {
			new query[156];
			mysql_format(connects, query, sizeof(query), "SELECT * FROM `business_stats` WHERE `bizz` = %i", CI[playerid][bizz_work]-1);
			mysql_tquery(connects, query, "bizz_stats", "ii", playerid, CI[playerid][bizz_work]-1);
		}
	case 6: {
			new string[128];
