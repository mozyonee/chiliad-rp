			}
		case D_JOB_CLEAR_3: {
				if(response) return ShowPlayerDialog(playerid, D_JOB_CLEAR_2, DSL, P"Вибір маршруту.", P"1."W" Лос-Сантос #1\n"P"2."W" Лос-Сантос #2", "Обрати", "Скасувати");
				SetVehicleToRespawn(TI[playerid][tArendaCar]);
			}

	}
	#if defined _hacker_inc
	if(hacker_OnDialogResponse(playerid, dialogid, response, listitem, inputtext)) return 1;
	#endif
	while(strfind(inputtext, "%s", true) != -1) {
		strdel(inputtext,strfind(inputtext, "%s", true), strfind(inputtext, "%s", true) + 2);
	}
	return 1;
}
public OnPlayerEnterDynamicCP(playerid, checkpointid) {
	if(SERIU[playerid][sID] != INVALID_PLAYER_ID) return 1;
	if(checkpointid == gPlayerProdCP[playerid] && GetPVarInt(playerid, "prod_id") && GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
		if(GetVehicleModel(GetPlayerVehicleID(playerid)) == 403 && !GetVehicleTrailer(GetPlayerVehicleID(playerid))) return SendError(playerid, "У вас немає цистерни з паливом.");
		new string[286];
		new bizid = GetPVarInt(playerid, "prod_id") - 1;
		format(string, sizeof(string), W"Бізнес: "P"%s\n\n\
					"W"Необхідно продуктів: "O"%i\n\
					"W"Доступно для розвантаження: "O"%i\n\
					"W"Введіть кількість продуктів для продажу:"
		, gBusiness[bizid][bizzName], gBusiness[bizid][bizzProdOrder], GetPVarInt(playerid, "count_prod"));
		return ShowPlayerDialog(playerid, dProdSell, DSI, P"Доставка.", string, "Продати", "Скасувати");
	}
	if(checkpointid == EggSklad[playerid]) {
		new money = 2*SALARY_EGG;
		TI[playerid][tJobSalary] += money;
		new string[102];
		format(string, sizeof(string), W"Ви принесли "P"2"W" яйця. Всього принесено "P"%i шт.", EggCount[playerid]);
		SendInfo(playerid, string);
		new s_[24];
		format(s_, sizeof(s_), "Money:_$%i", TI[playerid][tJobSalary]);
		PlayerTextDrawSetString(playerid, work_td[playerid][2],s_);
		format(s_, sizeof(s_), "Collected:_%deggs",EggCount[playerid]);
		PlayerTextDrawSetString(playerid, work_td[playerid][3],s_);
		DestroyDynamicCP(EggSklad[playerid]);
	}
	return 1;
}
public OnPlayerLeaveDynamicCP(playerid, checkpointid) {
	return 1;
}
public OnPlayerEnterDynamicArea(playerid, areaid) {
	if(!TI[playerid][tLogin] || !TI[playerid][tStarted]) return 1;
	if(SERIU[playerid][sID] != INVALID_PLAYER_ID) return 1;
	for(new i; i < MAX_STREAMS; i++) {
		if(areaid == Streams[i][sStream]) PlayAudioStreamForPlayer(playerid, Streams[i][sLink]);
	}
	if(GetPVarInt(playerid, "ChangingSkin")) {
		A_SetPlayerSkin(playerid, GetPVarInt(playerid, "curskin"));
		cancel_skin(playerid);
	}
	new pstate = GetPlayerState(playerid);
	/* if(areaid >= TeleportPickup[0] && areaid <= TeleportPickup[sizeof(gTeleportsToD) -1] && pstate == PLAYER_STATE_ONFOOT) {
		new tp = areaid - TeleportPickup[0];
		switch(tp) {
		case 3: {
				if(CI[playerid][pHospital]) return SendError(playerid, "Ви не пройшли повний курс лікування.");
				TI[playerid][tHeal] = false;
			}
		case 4: {
				if(CI[playerid][pHospital]) return SendError(playerid, "Ви не пройшли повний курс лікування.");
				TI[playerid][tHeal] = false;
			}
		case 10: FreezePlayerForTime(playerid, 3);
		case 11: ShowPlayerDialog(playerid, D_NEWS_EXI, DSL, P"Вихід", P"1."W" На вулицю\n"P"2."W" На дах", "Обрати", "Закрити");
		case 43: SetPlayerWeather(playerid, 27);
		case 28: FreezePlayerForTime(playerid, 2);
		case 34: {
				new freezeSeconds = 0;
				switch (GetPlayerPing(playerid)) {
				case 0 .. 49: freezeSeconds = 2;
				case 50 .. 199: freezeSeconds = 3;
				case 200 .. 499: freezeSeconds = 4;
				default: freezeSeconds = 5;
				}
				FreezePlayerForTime(playerid, freezeSeconds);
			}
		case 36: {
				new freezeSeconds = 0;
				switch (GetPlayerPing(playerid)) {
				case 0 .. 49: freezeSeconds = 2;
				case 50 .. 199: freezeSeconds = 3;
				case 200 .. 499: freezeSeconds = 4;
				default: freezeSeconds = 5;
				}
				FreezePlayerForTime(playerid, freezeSeconds);
			}
		case 38: {
				new freezeSeconds = 0;
				switch (GetPlayerPing(playerid)) {
				case 0 .. 49: freezeSeconds = 2;
				case 50 .. 199: freezeSeconds = 3;
				case 200 .. 499: freezeSeconds = 4;
				default: freezeSeconds = 5;
				}
				FreezePlayerForTime(playerid, freezeSeconds);
			}
		case 40: {
				new freezeSeconds = 0;
				switch (GetPlayerPing(playerid)) {
				case 0 .. 49: freezeSeconds = 2;
				case 50 .. 199: freezeSeconds = 3;
				case 200 .. 499: freezeSeconds = 4;
				default: freezeSeconds = 5;
				}
				FreezePlayerForTime(playerid, freezeSeconds);
			}
		case 42: {
				new freezeSeconds = 0;
				switch (GetPlayerPing(playerid)) {
				case 0 .. 49: freezeSeconds = 2;
				case 50 .. 199: freezeSeconds = 3;
				case 200 .. 499: freezeSeconds = 4;
				default: freezeSeconds = 5;
				}
				FreezePlayerForTime(playerid, freezeSeconds);
			}
		case 46: FreezePlayerForTime(playerid, 2);
		case 47: if(player_to_race_lv[playerid] || player_to_game[playerid]) return SendError(playerid, "Участнику ігрових заходів заборонено покидати приміщення.");
		case 53: {
				if(GetPVarInt(playerid, "gun_weap")) return SendError(playerid, "Ви не закінчили тренування.");
				TI[playerid][tTir] = false;
			}
		case 77: FreezePlayerForTime(playerid, 2);
		case 76: {
				FreezePlayerForTime(playerid, 2);
				TI[playerid][tSelectedBusinessID] = 1;
			}
		case 90: Enter_WareHouse(playerid);
		case 92: Enter_WareHouse(playerid);
		case 94: Enter_WareHouse(playerid);
		}
		FreezePlayerForTime(playerid, 3);
		SetPlayerFacingAngle(playerid, gTeleportsToD[tp][tpExitPos_A]);
		SetPlayerPosAC(playerid, gTeleportsToD[tp][tpExitPos_X], gTeleportsToD[tp][tpExitPos_Y], gTeleportsToD[tp][tpExitPos_Z], gTeleportsToD[tp][tpExitWorld], gTeleportsToD[tp][tpExitInt]);
		SetCameraBehindPlayer(playerid);
		return 1;
	}
	if(areaid >= gPickID[0] && areaid <= gPickID[PICKUPS_COUNT-1] && pstate == PLAYER_STATE_ONFOOT) { // ПІКАПИ
		new pick = areaid - gPickID[0];
		switch(pick) {
		case 0: {
				if(CI[playerid][pJob] != 8) return SendError(playerid, "Ви не влаштовувались на роботу інкасатора.");
				if(!GetPVarInt(playerid, "inc_start")) {
					ShowPlayerDialog(playerid, D_JOB_INC, DSM, P"Робота інкасатора.", W"Ви дійсно хочете розпочати роботу?", "Так", "Ні");
				} else ShowPlayerDialog(playerid, D_JOB_INC, DSM, P"Робота інкасатора.", W"Ви хочете завершити робочий день?", "Так", "Ні");
			}
