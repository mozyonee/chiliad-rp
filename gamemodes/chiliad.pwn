				}
				format(string, sizeof(string), "Ви випустили "P"%s"W" за "GREEN"$%i"W"."G" Спосіб оплати: "W"%s.", CI[playerid][cName], percent, (listitem == 0) ? ("готівка") : ("банк. рахунок"));
				SendOK(id, string);
				CI[playerid][pJailTime] = 0;
				CI[playerid][pJail] = 0;
