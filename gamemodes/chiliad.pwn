CMD:yskin(playerid, params[]) {
	if(CI[playerid][pYoutube] == 0) return 1;
	new skin;
	if(sscanf(params, "i", skin)) return SendError(playerid, "Використайте: /tskin [skinid]");
	if(skin == 74 || skin > 311 || skin < 1) return SendError(playerid, "Неправильний ID скіна.");
	A_SetPlayerSkin(playerid, skin);
	SendOK(playerid, "Ви змінили собі скін.");
	return 1;
}
CMD:setyt(playerid, params[]) {
   if(PI[playerid][pAdmin] < 5 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
   new name[24], string[350];
   if(sscanf(params, "s[24]i",name, params[0])) return SendError(playerid, "Використайте: /setyt [playername] [1 - give, 0 - take]");
   mysql_format(connects, string, sizeof(string), "SELECT * FROM "TABLE_CHARACTERS" WHERE `Name` = '%s'", name);
   mysql_pquery(connects, string, "make_youtube", "dsd", playerid, name, params[0]);
   return 1;
}
CMD:spec(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Заборонено починати стеження з транспорту.");
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendError(playerid, "Використайте: /sp(ec) [playerid]");
	if(giveplayerid == INVALID_PLAYER_ID || giveplayerid == playerid) return SendError(playerid, not_id);
	if(!TI[giveplayerid][tLogin]) return SendError(playerid, "Гравець не авторизований.");
	if(SERIU[playerid][sID] == INVALID_PLAYER_ID) {
		// if(TI[playerid][tSpectate]==true) SpecPl(playerid, false);
		TI[playerid][preOrg] = CI[playerid][pMember];
		TI[playerid][preOrgg] = CI[playerid][pRank];
		GetPlayerPos(playerid, TI[playerid][Admin_X], TI[playerid][Admin_Y], TI[playerid][Admin_Z]);
		avir[playerid] = GetPlayerVirtualWorld(playerid);
		aint[playerid] = GetPlayerInterior(playerid);
		// TogglePlayerControllable(playerid, true);
		PlayerTextDrawShow(playerid, RECON[playerid]);
	}
	start_work[playerid] = true;
	CI[playerid][pMember] = CI[giveplayerid][pMember];
	CI[playerid][pRank] = 1;
	TI[playerid][pOldSkin] = GetPlayerSkin(playerid);
	SpecPlayer(playerid, giveplayerid);
	ShowMenuForPlayer(specmenu, playerid);
	return 1;
}
alias:spec("sp")
CMD:specoff(playerid) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	Lastspec[playerid]=SERIU[playerid][sID];
	if(GetPlayerState(playerid) == PLAYER_STATE_SPECTATING) SpecPl(playerid, false);
	HideMenuForPlayer(specmenu, playerid);
	SettingSpawn(playerid);
	SetHealth(playerid, 100);
	if(GetPVarInt(playerid, "ppkz")) EndCapt(playerid);
	return 1;
}
alias:specoff("spoff")
CMD:getskills(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendError(playerid, "Використайте: /getskills [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	new strname[56];
	format(strname, sizeof(strname), "{ffcf00}Навички володіння зброєю гравця %s.", CI[giveplayerid][cName]);
	new strkill[1006];
	new points[6];
	points[0] = 100 - CI[giveplayerid][pGunSkill][0];
	points[1] = 100 - CI[giveplayerid][pGunSkill][1];
	points[2] = 100 - CI[giveplayerid][pGunSkill][2];
	points[3] = 100 - CI[giveplayerid][pGunSkill][3];
	points[4] = 100 - CI[giveplayerid][pGunSkill][4];
	points[5] = 100 - CI[giveplayerid][pGunSkill][5];
	format(strkill, 1000, W"SD-Pistol:\t"P"%s "W"%i/100%%\nDesert Eagle:\t"P"%s "W"%i/100%%\nShotgun:\t"P"%s "W"%i/100%%\nMP5\t\t"P"%s "W"%i/100%%\nAK47:\t\t"P"%s "W"%i/100%%\nM4:\t\t"P"%s "W"%i/100%%",
	ToDevelopSkills(CI[giveplayerid][pGunSkill][0],points[0]), CI[giveplayerid][pGunSkill][0],
	ToDevelopSkills(CI[giveplayerid][pGunSkill][1],points[1]), CI[giveplayerid][pGunSkill][1],
	ToDevelopSkills(CI[giveplayerid][pGunSkill][2],points[2]), CI[giveplayerid][pGunSkill][2],
	ToDevelopSkills(CI[giveplayerid][pGunSkill][3],points[3]), CI[giveplayerid][pGunSkill][3],
	ToDevelopSkills(CI[giveplayerid][pGunSkill][4],points[4]), CI[giveplayerid][pGunSkill][4],
	ToDevelopSkills(CI[giveplayerid][pGunSkill][5],points[5]), CI[giveplayerid][pGunSkill][5]);
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, strname, strkill, "Закрити", "");
	return 1;
}
// 2 рівень.
CMD:aimcheck(playerid) {
	if(PI[playerid][pAdmin] < 2 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(SERIU[playerid][sID] == INVALID_PLAYER_ID) return SendError(playerid, "Ви ні за ким не слідкуєте.");
	new targetid = GetPlayerTargetPlayer(SERIU[playerid][sID]);
	if(targetid != INVALID_PLAYER_ID && GetPlayerState(targetid) == 1 && TI[targetid][tAFK] < 3)  {
		new Float:x[2], Float:y[2], Float:z[2], Float:a;
		GetPlayerPos(SERIU[playerid][sID], x[0], y[0], z[0]);
		GetPlayerFacingAngle(SERIU[playerid][sID], a);
		GetXYInFrontOfPoint(x[0], y[0], a, -3.0);
		new Float:aimhp;
		GetPlayerHealth(targetid, aimhp);
		SetPVarFloat(targetid, "aimtest", aimhp);
		GetPlayerPos(targetid, x[1], y[1], z[1]);
		SetPlayerPosAC(targetid, x[0], y[0], z[0], TI[targetid][tVirtualWorld], TI[targetid][tInterior]);
		SetHealth(targetid, 300);
		SendClientMessage(targetid,COLOR_YELLOW, "Не хвилюйтесь, це звичайна перевірка на аім.");
		SetTimerEx("onPTMCheck", 500, false, "iifffi", SERIU[playerid][sID], targetid, x[1], y[1], z[1], playerid);
		new string[128];
		format(string, sizeof string, "[A] %s[%i] перевіряє гравця %s[%i] на аім.", CI[playerid][cName], playerid, CI[SERIU[playerid][sID]][cName], SERIU[playerid][sID]);
		SendAdminMessage(COLOR_GREY, string);
	} else SendError(playerid, "Гравець ні в кого не цілиться.");
	return 1;
}
CMD:get(playerid,params[]) {
	if(PI[playerid][pAdmin] < 2 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(isnull(params) || strlen(params) > 23)  return SendError(playerid, "Використайте: /get [playername]");
	new query[256];
	mysql_format(connects, query, sizeof(query), "SELECT `cID`, `Name`, `pCash`, `pLevel`, `donatemoney` FROM "TABLE_CHARACTERS" WHERE `Name` = '%s' LIMIT 1", params);
	mysql_tquery(connects, query, "get_info_player", "i", playerid);
	return 1;
}
CMD:spcar(playerid, params[]) {
	if(PI[playerid][pAdmin] < 2 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	SetVehicleToRespawn(GetPlayerVehicleID(playerid));
	return 1;
}
CMD:gotocar(playerid, params[]) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(sscanf(params, "d",params[0])) return SendError(playerid, "Використайте: /gotocar [playerid]");
	new Float: x, Float:y, Float:z;
	GetVehiclePos(params[0], x, y, z);
	SetPlayerPosAC(playerid, x, y, z, GetVehicleVirtualWorld(params[0]), 0);
	return 1;
}
CMD:getherecar(playerid, params[]) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new id, string[150], Float:X, Float:Z, Float:Y;
	if(sscanf(params, "d", id)) return SendError(playerid, "Використайте: /getherecar [playerid]");
	GetPlayerPos(playerid, X, Y, Z);
	SetVehicleVirtualWorld(id, GetPlayerVirtualWorld(playerid));
	SetVehiclePos(id, X-4, Y, Z+ 1);
	format(string, sizeof(string), "Ви телепортували до себе авто. (ID: %i)", id);
	SendOK(playerid, string);
	return 1;
}
CMD:goto(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendError(playerid, "Використайте: /goto [playerid]");
	if(!IsPlayerConnected(giveplayerid) || playerid == giveplayerid) return SendError(playerid, not_id);
	if(!TI[giveplayerid][tLogin]) return SendError(playerid, "Гравець не авторизований на сервері.");
	new Float:X, Float:Y, Float:Z, Float:A;
	switch(GetPlayerState(giveplayerid)) {
		case PLAYER_STATE_DRIVER, PLAYER_STATE_PASSENGER: {
			GetVehiclePos(GetPlayerVehicleID(giveplayerid), X, Y, Z);
			GetVehicleZAngle(GetPlayerVehicleID(giveplayerid), A);
			}
		case PLAYER_STATE_ONFOOT: {
			GetPlayerPos(giveplayerid, X, Y, Z);
			GetPlayerFacingAngle(giveplayerid, A);
			}
		default: return SendError(playerid, "Гравець не заспавнився.");
	}
	switch(GetPlayerState(playerid)) {
		case PLAYER_STATE_ONFOOT, PLAYER_STATE_PASSENGER: {
			SetPlayerPosAC(playerid,X,Y+ 1.5,Z, GetPlayerVirtualWorld(giveplayerid), GetPlayerInterior(giveplayerid));
			SetPlayerFacingAngle(playerid,A);
			}
		case PLAYER_STATE_DRIVER: {
			new vehicleid = GetPlayerVehicleID(playerid);
			SetVehiclePos(vehicleid, X, Y+ 1.5, Z);
			SetVehicleZAngle(vehicleid, A);
			LinkVehicleToInterior(vehicleid, GetPlayerInterior(giveplayerid));
			SetVehicleVirtualWorld(vehicleid, GetPlayerVirtualWorld(giveplayerid));
			}
		default: return 1;
	}
	if(TI[giveplayerid][tSelectedBusinessID]) TI[playerid][tSelectedBusinessID] = TI[giveplayerid][tSelectedBusinessID];
	if(TI[giveplayerid][tSelectHouse]) TI[playerid][tSelectHouse] = TI[giveplayerid][tSelectHouse];
	return 1;
}
CMD:fix(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 && GetPVarInt(playerid, "adminaccess") != 1 && CI[playerid][pYoutube] == 0) return 1;
	SetHealth(playerid, 100);
	SetFullness(playerid, 100);
	if(IsPlayerInAnyVehicle(playerid)) {
		SetVehicleHealth(GetPlayerVehicleID(playerid), 1000.0);
		RepairVehicle(GetPlayerVehicleID(playerid));
		return 1;
	}
	return 1;
}
CMD:spawn(playerid, const params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	PlayerSpawn(playerid);
	return 1;
}
alias:spawn("sp")
CMD:fv(playerid, const params[]) {
	if(PI[playerid][pAdmin] < 2 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(IsPlayerInAnyVehicle(playerid)) {
		SetVehicleHealth(GetPlayerVehicleID(playerid), 1000.0);
		RepairVehicle(GetPlayerVehicleID(playerid));
		return 1;
	} else {
		if(sscanf(params, "u", giveplayerid)) return SendError(playerid, "Використайте: /fv [playerid]");
		if(GetPlayerState(giveplayerid) != 2) return SendError(playerid, "Цей гравець не в автомобілі.");
		SetVehicleHealth(GetPlayerVehicleID(giveplayerid), 1000.0);
		RepairVehicle(GetPlayerVehicleID(giveplayerid));
		return 1;
	}
}
CMD:atipster(playerid,params[]) {
	if(PI[playerid][pAdmin] < 2 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new fraction_member;
	if(sscanf(params, "i", fraction_member)) return SendError(playerid, "Використайте: /atipster [fractionid]");
	if(!(1 <= fraction_member < MAX_FACTIONS)) return SendError(playerid, "Використайте: /atipster [fractionid]");
	if(GetPVarInt(playerid, "admin_tipster")) {
		SendOK(playerid, "Ви вимкнули прослуховування.");
		DeletePVar(playerid, "admin_tipster");
	} else {
		SetPVarInt(playerid, "admin_tipster", fraction_member);
		new string[70];
		format(string, sizeof(string), "Ви почали прослуховувати фракцію %s.", FI[fraction_member][fName]);
		SendOK(playerid, string);
		SendOK(playerid, "Використайте /tipster ще раз, щоб вимкнути прослушку.");
	}
	return 1;
}
CMD:astats(playerid, params[]) {
	if(PI[playerid][pAdmin] < 2 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendError(playerid, "Використайте: /astats [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	ShowStats(playerid, giveplayerid);
	return 1;
}
// 3 рівень.
CMD:tskin(playerid, params[]) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1 || CI[playerid][pYoutube] == 0) return 1;
	new skin, giveplayerid;
	if(sscanf(params, "ud", giveplayerid,skin)) return SendError(playerid, "Використайте: /tskin [playerid] [skinid]");
	if(skin == 74 || skin > 311 || skin < 1) return SendError(playerid, "Неправильний ID скіна.");
	A_SetPlayerSkin(giveplayerid, skin);
	new str[128];
	format(str, sizeof(str), "Адміністратор %s видав вам тимчасовий скін.", CI[playerid][cName]);
	SendOK(giveplayerid, str);
	return 1;
}
CMD:skin(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new skin;
	if(sscanf(params, "d",skin)) return SendError(playerid, "Використайте: /skin [skinid]");
	//if(skin == 74 || skin > 311 || skin < 1) return SendError(playerid, "Неправильний ID скіна.");
	CI[playerid][cSkin] = skin;
	A_SetPlayerSkin(playerid, CI[playerid][cSkin]);
