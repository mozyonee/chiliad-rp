					"O"Примітка:"W"\n\
					\tВартість "P"1"W" матеріалу: "GREEN"$%i"W"\n\
					\tДоступно матеріалів на складі: "P"%i"W"";
					new string[sizeof(f_str) + 1 + (-2 +5) + (-2 +5) + (-2 +5)];
					format(string, sizeof(string), f_str, black_prods[6], black_prods[2]);
					ShowPlayerDialog(playerid, D_MARKET_GUN, DSI, P"Купівля матеріалів", string, "Купити", "Скасувати");
					return 1;
				}
				if(black_prods[2] < strval(inputtext)) return SendError(playerid, "На складі закінчився товар.");
				if(GetPlayerMoneyEx(playerid) < black_prods[6]*strval(inputtext)) return SendError(playerid, "У вас недостатньо грошей.");
				if(GetItemAmount(playerid, 0) <= 0) return SendError(playerid, "В інвентарі недостатньо місця.");
				GiveMoney(playerid, -black_prods[6]*strval(inputtext), "купівля матів ЧР");
				black_prods[2] -= strval(inputtext);
				SaveMarket();
				FI[black_prods[0]][fBank] += black_prods[6]*strval(inputtext);
				new string[128];
				format(string, sizeof(string), "Ви придбали "P"%i "W"матеріалів за "GREEN"$%i.",strval(inputtext), black_prods[6]*strval(inputtext));
				SendOK(playerid, string);

				CI[playerid][pMats] += strval(inputtext);
				UpdateCharacterData(playerid, "pMats", CI[playerid][pMats]);
			}
		case D_JOB: {
				if(!response) return 1;
				if(start_work[playerid]) return SendError(playerid, "Необхідно завершити робочий день в організації.");
				if(CI[playerid][pJob] == listitem+ 1) return SendError(playerid, "Ви вже влаштовані на цю роботу.");
				switch(listitem) {
					case 0: {
							//if(CI[playerid][pLevel] < 2) return SendError(playerid, "Доступно з 2 рівня.");
							CI[playerid][pJob] = 1;
						}
					case 1: {
							//if(CI[playerid][pLevel] < 3) return SendError(playerid, "Доступно з 3 рівня.");
							CI[playerid][pJob] = 2;
						}
					case 2: {
							//if(CI[playerid][pLevel] < 2) return SendError(playerid, "Доступно з 2 рівня.");
							CI[playerid][pJob] = 3;
						}
					case 3: {
							//if(CI[playerid][pLevel] < 3) return SendError(playerid, "Доступно з 3 рівня.");
							CI[playerid][pJob] = 4;
						}
					case 4: {
							//if(CI[playerid][pLevel] < 4) return SendError(playerid, "Доступно з 4 рівня.");
							CI[playerid][pJob] = 5;
						}
					case 5: {
							//if(CI[playerid][pLevel] < 3) return SendError(playerid, "Доступно з 3 рівня.");
							CI[playerid][pJob] = 6;
						}
					case 6: {
							//if(CI[playerid][pLevel] < 2) return SendError(playerid, "Доступно з 2 рівня.");
							CI[playerid][pJob] = 7;
						}
					case 7: {
							//if(CI[playerid][pLevel] < 2) return SendError(playerid, "Доступно з 2 рівня.");
							if(IsAGang(playerid)) return SendError(playerid, "Ви знаходитеся в банді. Вам не можна тут працювати.");
							CI[playerid][pJob] = 8;
						}
					case 8: {
							if(!CI[playerid][pJob]) return SendError(playerid, "Ви не влаштовані на роботу.");
							CI[playerid][pJob] = 0;
							SendOK(playerid, "Ви звільнилися з роботи.");
							UpdateCharacterData(playerid, "pJob", CI[playerid][pJob]);
							return 1;
						}
				}
				UpdateCharacterData(playerid, "pJob", CI[playerid][pJob]);
				new jtext[56], string[128];
				switch(CI[playerid][pJob]) {
				case 1: jtext = "Водієм автобуса";
				case 2: jtext = "Механіком";
				case 3: jtext = "Розвізником продуктів та палива";
				case 4: jtext = "Розвізником їжі";
				case 5: jtext = "Мийником доріг";
				case 6: jtext = "Чистильником каналізацій";
				case 7: jtext  = "Таксистом";
				case 8: jtext  = "Інкасатором"; }
				format(string, sizeof(string), "Ви працевлаштувалися %s.", jtext);
				SendOK(playerid, string);
				SendHint(playerid, "Для перегляду доступних команд, введіть "P"/menu"W". (Команди сервера > По роботі)");
			}
		case D_FARM: {
