stock accs_close(playerid) {
	new Float:x, Float:y, Float:z, Float:x2, Float:y2, Float:z2;
	GetPlayerCameraPos(playerid, x, y, z);
	InterpolateCameraPos(playerid, x, y, z, 212.5107 + (2.5 * floatsin(-89.8527, degrees)), -41.5253 + (2.5 * floatcos(-89.8527, degrees)), 1002.0234, 1200);
	GetPlayerCameraFrontVector(playerid,x2,y2,z2);
	InterpolateCameraLookAt(playerid,x + x2,y + y2,z + z2, 212.5107, -41.5253, 1002.0234, 1200);
	buyacces(playerid);
	return 1;
}
public OnQueryError(errorid, const error[], const callback[], const query[], MySQL:handle) {
	print ("[OnQueryError] SQL ERROR. QUERY:");
	return print (query);
}
stock reputation_family(family,point) {
	gFamily[family][famPoint] += point;
	if(gFamily[family][famPoint] < 0) gFamily[family][famPoint] = 0;
	UpdateFamily(family+ 1, "point", gFamily[family][famPoint]);
}
stock t_PutPlayerInVehicle(playerid, carid, seat) {
	return PutPlayerInVehicle(playerid, carid, seat);
}
stock SetPlayerPosAC(playerid, Float:x, Float:y, Float:z, world, interior, setUP = false) {
	if(playerid != INVALID_PLAYER_ID) {
		if(!setUP) {
			if(TI[playerid][tVirtualWorld] != world) {
				TI[playerid][tVirtualWorld] = world;
				SetPlayerVirtualWorld(playerid, world);
			}
			if(TI[playerid][tInterior] != interior) {
				TI[playerid][tInterior] = interior;
				SetPlayerInterior(playerid, interior);
			}
		} else {
			SetPlayerVirtualWorld(playerid, world);
			SetPlayerInterior(playerid, interior);
		}
		SetPlayerPos(playerid, x,y,z);
		// NickName(playerid);
	}
	return 1;
}
stock auto_news(slot, playerid) {
	format(gAdvert[slot][adSender], 24, "%s", CI[playerid][cName]);
	gAdvert[slot][adID] = playerid;
	gAdvert[slot][adPhone] = CI[playerid][pPhone];
	gAdvert[slot][adBusy] = true;
	gAdvert[slot][adTime] = gAdvertTime;
	gAdvertTime += 30;
	SetString(gAdvert[slot][adCheker], "Chiliad Bot");

	gAdvert[slot][adCheking] = false;
	gAdvert[slot][adCheked] = true;
	SendOK(playerid, "Оголошення подано до редакції. Очікуйте публікацію.");
}
stock SpeedVehicle(playerid) {
	new Float:ST[4];
	if(IsPlayerInAnyVehicle(playerid))
	GetVehicleVelocity(GetPlayerVehicleID(playerid),ST[0],ST[1],ST[2]);
	else GetPlayerVelocity(playerid,ST[0],ST[1],ST[2]);
	ST[3] = floatsqroot(floatpower(floatabs(ST[0]), 2.0) + floatpower(floatabs(ST[1]), 2.0) + floatpower(floatabs(ST[2]), 2.0)) * 100.3;
	return floatround(ST[3]);
}
stock Float:GetSpeed(Float:x = 0.0, Float:y = 0.0, Float:z = 0.0) {             // Швидкість.
	return floatsqroot((x * x) + (y * y) + (z * z)) * 100.0;
}
stock SearchIndex(index, ...) {                                                 // Пошук потрібного значення.
	for(new id = (numargs() - 1); id >= 1; --id) {
		if(index == getarg(id)) {
			return 1;
		}
	}
	return false;
}
CB:StartDrawing(playerid) {
	new keys,updown,leftright;
	GetPlayerKeys(playerid,keys,updown,leftright);
	if(keys != 4) {
		GraffitiFailed(playerid);
		KillTimer(graf_timer[playerid]);
		return 1;
	}
	GameTextForPlayer(playerid, "~g~START PAINT", 1000, 5);
	SetPVarInt(playerid, "SettingGraffiti", 1);
	graf_timer[playerid] = SetTimerEx("graffity", 8000, 0, "i", playerid);
	return 1;
}
GraffitiDone(playerid) {
	if(!GetPVarInt(playerid, "SettingGraffiti")) return 1;
	new keys,updown,leftright;
	GetPlayerKeys(playerid,keys,updown,leftright);
	if(keys != 4) {
		GraffitiFailed(playerid);
		KillTimer(graf_timer[playerid]);
		return 1;
	}
	new obj;
	switch(CI[playerid][pMember]) {
	case 0: obj = 18666;
	case 20: obj = 18659;
	case 21: obj = 18661;
	case 22: obj = 18663;
	case 18: obj = 18664;
	case 19: obj = 18665; // Вагос.
	}
	DestroyDynamicObject(GrafInfo[GetPVarInt(playerid, "Grafity")][gObject]);
	GrafInfo[GetPVarInt(playerid, "Grafity")][gObject] = CreateDynamicObject(obj, GrafInfo[GetPVarInt(playerid, "Grafity")][gr_x][0], GrafInfo[GetPVarInt(playerid, "Grafity")][gr_x][1], GrafInfo[GetPVarInt(playerid, "Grafity")][gr_x][2], GrafInfo[GetPVarInt(playerid, "Grafity")][gr_x][3], GrafInfo[GetPVarInt(playerid, "Grafity")][gr_x][4], GrafInfo[GetPVarInt(playerid, "Grafity")][gr_x][5]);
	GrafInfo[GetPVarInt(playerid, "Grafity")][gFrak] = CI[playerid][pMember];
	if(GetPVarInt(playerid, "SettingGraffiti") == 1) DeletePVar(playerid, "SettingGraffiti");
	GameTextForPlayer(playerid, "~g~GOOD", 1000, 5);
	Streamer_Update(playerid);
	new query[128];
	mysql_format(connects, query, sizeof(query), "UPDATE `graffity` SET `gGang` = %i WHERE `gID` = %i", CI[playerid][pMember], GetPVarInt(playerid, "Grafity"));
	return mysql_tquery(connects, query);
}
GraffitiFailed(playerid) {
	if(GetPVarInt(playerid, "SettingGraffiti") == 1) {
		DeletePVar(playerid, "SettingGraffiti");
	}
	return GameTextForPlayer(playerid, "~r~FAILED", 1000, 5);
}
CB:graffity(playerid) {
	return GraffitiDone(playerid);
}
public OnPlayerShootDynamicObject(playerid, weaponid, objectid, Float:x, Float:y, Float:z) {
	new fare = 0;
	if(CI[playerid][pMember] == fARMYLS && IsPlayerInRangeOfPoint(playerid, 10.0, 2737.7830, -2555.4817, 13.6425) && BULLET_HIT_TYPE_OBJECT) {
		fare = 1;
	} else {
		if(IsPlayerInRangeOfPoint(playerid, 15.0, 341.7520, -170.7615, 987.6703) && BULLET_HIT_TYPE_OBJECT && GetPVarInt(playerid, "gun_weap"))
		fare = 1;
	}
	if(fare) {
		switch(weaponid) {
		case 23: {
				SetPVarInt(playerid, "SkillSD", GetPVarInt(playerid, "SkillSD") + 1);
				if(GetPVarInt(playerid, "SkillSD") >= Ammo_SDPISTOL && CI[playerid][pGunSkill][0] < 100) {
					CI[playerid][pGunSkill][0] += 1;
					SetPVarInt(playerid, "SkillSD", 0);
					texdraw_skill(playerid, 0);
					SetPlayerSkills(playerid);
					skill_gun[playerid] = 1;
				}
			}
		case 24: {
				SetPVarInt(playerid, "SkillD", GetPVarInt(playerid, "SkillD") + 1);
				if(GetPVarInt(playerid, "SkillD") >= Ammo_DEAGLE && CI[playerid][pGunSkill][1] < 100) {
					CI[playerid][pGunSkill][1] += 1;
					SetPVarInt(playerid, "SkillD", 0);
					texdraw_skill(playerid, 1);
					SetPlayerSkills(playerid);
					skill_gun[playerid] = 1;
				}
			}
		case 25: {
				SetPVarInt(playerid, "SkillShot", GetPVarInt(playerid, "SkillShot") + 1);
				if(GetPVarInt(playerid, "SkillShot") >= Ammo_SHOTGUN && CI[playerid][pGunSkill][2] < 100) {
					CI[playerid][pGunSkill][2]+=1;
					SetPVarInt(playerid, "SkillShot", 0);
					skill_gun[playerid] = 1;
				}
			}
		case 29: {
				SetPVarInt(playerid, "SkillMP5", GetPVarInt(playerid, "SkillMP5") + 1);
				if(GetPVarInt(playerid, "SkillMP5") >= Ammo_MP5 && CI[playerid][pGunSkill][3] < 100) {
					CI[playerid][pGunSkill][3]+=1;
					SetPVarInt(playerid, "SkillMP5", 0);
					texdraw_skill(playerid, 3);
					SetPlayerSkills(playerid);
					skill_gun[playerid] = 1;
				}
			}
		case 30: {
				SetPVarInt(playerid, "SkillAk47", GetPVarInt(playerid, "SkillAk47") + 1);
				if(GetPVarInt(playerid, "SkillAk47") >= Ammo_AK47 && CI[playerid][pGunSkill][4] < 100) {
					CI[playerid][pGunSkill][4] += 1;
					SetPVarInt(playerid, "SkillAk47", 0);
					texdraw_skill(playerid, 4);
					SetPlayerSkills(playerid);
					skill_gun[playerid] = 1;
				}
			}
		case 31: {
				SetPVarInt(playerid, "SkillM4", GetPVarInt(playerid, "SkillM4") + 1);
				if(GetPVarInt(playerid, "SkillM4") >= Ammo_M4A1 && CI[playerid][pGunSkill][5] < 100) {
					CI[playerid][pGunSkill][5] += 1;
					SetPVarInt(playerid, "SkillM4", 0);
					texdraw_skill(playerid, 5);
					SetPlayerSkills(playerid);
					skill_gun[playerid] = 1;
				}
			}
		}
	}
	return 1;
}
stock leave_robhouse(playerid) {
	if(rob_veh[playerid] != INVALID_VEHICLE_ID) {
		new vehicleid = rob_veh[playerid];
		if(IsValid3DTextLabel(VG[vehicleid][vgText])) DestroyDynamic3DTextLabelEx(VG[vehicleid][vgText]);
		DestroyDynamicPickup(VG[vehicleid][vgPickup]);
		VG[vehicleid][vgPickup] = 0;
		DestroyDynamicArea(VG[vehicleid][vgArea]);
		VG[vehicleid][vgArea] = 0;
		A_DestroyVehicle(rob_veh[playerid]);
		rob_veh[playerid] = INVALID_VEHICLE_ID;
		DeletePVar(playerid, "load_rob");
	}
}
stock SetHealth(playerid, Float:heal) {
	CI[playerid][pHP] = heal;
	SetPlayerHealth(playerid, heal);
	return 1;
}
stock SetArmour(playerid, Float:Armour) {
	TI[playerid][tArmour] = Armour;
	return SetPlayerArmour(playerid, Armour);
}
stock EggUpdate(playerid) {
	new g = PlayerEgg[playerid];
	new string[150];
	format(string, sizeof(string), P"Курник\n\n"W"Доглядає:"P" %s\n"W"Курячий корм:"P" [%i/10]\n"W"Знесено яєць:"P" [%i/20]", CI[playerid][cName],Egg[g][gKorm],Egg[g][gCount]);
	UpdateDynamic3DTextLabelText(Egg[g][gText], -1, string);
}
stock EndEgg(playerid) {
	if(GetPVarInt(playerid, "egg_start") == 1 && PlayerEgg[playerid] != -1) {
		new g = PlayerEgg[playerid];
		strmid(Egg[g][gName], "None", 0, strlen("None"), 6);
		new string[250];
		format(string, sizeof(string), P"Курник\n\n"W"Доглядає:"P" %s\n"W"Курячий корм:"P" [%i/10]\n"W"Знесено яєць:"P" [%i/20]\n\n"W"Почати догляд"P" [ALT]",Egg[g][gName],Egg[g][gKorm],Egg[g][gCount]);
		UpdateDynamic3DTextLabelText(Egg[g][gText], -1, string);
		PlayerKorm[playerid] = 0;
		EggCount[playerid] = 0;
		PlayerEgg[playerid] = -1;
		if(IsPlayerAttachedObjectSlotUsed(playerid, 8)) RemovePlayerAttachedObject(playerid, 8);
		if(EggSklad[playerid]) DestroyDynamicCP(EggSklad[playerid]);

	}
}
stock key_activate(playerid) {
	if(TI[playerid][tDiceID] != INVALID_PLAYER_ID) {
		new id = TI[playerid][tDiceID];
		new ids = TI[id][tDiceIDs];
		new money = TI[playerid][tDiceMoney];
		if(money >= 100) {
			if(QuestProgress[id][26] == 0 && AcceptQuest[id][26] != 0) {
				QuestProgress[id][26] ++;
				save_quest(id, 26);
				SPD(id, DIALOG_NONE, DSM, P"Виконання квесту.", W"Ви завершили виконання квесту 'Азарт'\n\t"NO"Квест можна завершити в списку квестів (/quest)", "Закрити", "");
			}
		}
		TI[playerid][tDiceID] = TI[id][tDiceIDs] = INVALID_PLAYER_ID;
		TI[playerid][tDiceMoney] = 0;
		TI[playerid][tDiceClosed] = TI[id][tDiceClosed] = false;
		if(ids != playerid) return SendError(playerid, "Гравець покинув гру.");
		if(!TI[id][tLogin]) return SendError(playerid, "Гравець, який хотів з вами грати, офлайн.");
		else if(CI[playerid][pCasinoChips] < money) {
			SendError(playerid, "У вас недостатньо фішок.");
			SendOK(id, "У гравця недостатньо фішок.");
			return 1;
		} else if(CI[id][pCasinoChips] < money) {
			SendOK(playerid, "У гравця недостатньо фішок.");
			SendClientMessage(id,COLOR_GREY, "У вас недостатньо фішок.");
			return 1;
		}
		if(!IsPlayerInRangeOfPoint(playerid, 2.0, 295.3712, -112.4607, 1036.6692) && !IsPlayerInRangeOfPoint(playerid, 2.0, 300.7174, -112.3977, 1036.6692)) {
			SendError(playerid, "Ви не біля столу для гри 1x1");
			SendOK(id, "Гравець відмовився від вашої пропозиції.");
			return 1;
		}
		new dice = random(6) + 1;
		new dice1 = random(6) + 1;
		new string[128];
		format(string, sizeof(string), "%s і %s кинули кості. Результат: {CC9900}%i:%i", CI[id][cName], CI[playerid][cName], dice, dice1);
		ProxDetector(15.0, playerid, string, 0x44b2ffff);
		SetTimerEx("DiceOff", 5000, false, "ii", playerid, id);
		TI[id][tKubik] = 1;
		TI[playerid][tKubik] = 1;
		TI[playerid][tDiceTime] = TI[id][tDiceTime] = gettime()+ 10;
		format(string, sizeof(string), "Випало: %i", dice1);
		SetPlayerChatBubble(playerid, string,COLOR_ORANGE, 30.0, 10000);
		format(string, sizeof(string), "Випало: %i", dice);
		SetPlayerChatBubble(id, string,TEAM_GROVE_COLOR, 30.0, 10000);
		ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 1, 1, 1, 1, 1, 1);
		SetPlayerAttachedObject(playerid, 1, 1851, 1, 0.062400, 0.453750, 0.0, 0.0, 94.689310, 0.0);
		ApplyAnimation(id, "CARRY", "crry_prtial", 4.0, 1, 1, 1, 1, 1, 1);
		SetPlayerAttachedObject(id, 1, 1851, 1, 0.062400, 0.453750, 0.0, 0.0, 94.689310, 0.0);
		if(dice > dice1) {
			format(string, sizeof(string), "Вітаємо, ви виграли. Виграш складає: "GREEN"$%i"W".", money);
			SendClientMessage(id, CGOLD, string);
			SendOK(playerid, "На жаль, ви програли.");

			CI[id][pCasinoChips] += money;
			UpdateCharacterData(id, "casino_chips", CI[id][pCasinoChips]);

			CI[playerid][pCasinoChips] -= money;
			UpdateCharacterData(playerid, "casino_chips", CI[playerid][pCasinoChips]);
		}
		if(dice < dice1) {
			format(string, sizeof(string), "Вітаємо, ви виграли. Виграш складає "GREEN"$%i"W".", money);
			SendClientMessage(playerid, CGOLD, string);
			SendOK(id, "На жаль, ви програли.");

			CI[playerid][pCasinoChips] += money;
			UpdateCharacterData(playerid, "casino_chips", CI[playerid][pCasinoChips]);

			CI[id][pCasinoChips] -= money;
			UpdateCharacterData(id, "casino_chips", CI[id][pCasinoChips]);

		} else if(dice == dice1) {
			SendOK(playerid, "Гра завершилася нічиєю.");
			SendOK(id, "Гра завершилася нічиєю.");
		}
	} else if(GetPVarInt(playerid, "give_inv")) {
		new acter = GetPVarInt(playerid, "give_inv") -1;
		new invent = GetPVarInt(playerid, "pl_inv");
		new ammout = GetPVarInt(playerid, "pl_count");
		new slot = GetPVarInt(acter, "pl_slot");
		new cash = GetPVarInt(playerid, "pl_money");
		if(acter >= 0) {
			if(IsPlayerConnected(playerid) && IsPlayerConnected(acter)) {
				if(!ProxDetectorS(5.0, playerid, acter)) {
					SendError(playerid, "Ви дуже далеко від гравця");
					SendClientMessage(acter, COLOR_GREY, "Ви дуже далеко від гравця");
					DeletePVar(playerid, "give_inv");
					DeletePVar(playerid, "invent");
					DeletePVar(playerid, "ammout");
					return 1;
				}
				if(GetItemAmount(playerid, 0) <= 0) {
					SendClientMessage(acter, COLOR_GREY, "В інвентарі у гравця недостатньо місця.");
					SendError(playerid, "У вашому інвентарі недостатньо місця.");
					DeletePVar(playerid, "give_inv");
					DeletePVar(playerid, "invent");
					DeletePVar(playerid, "ammout");
					return 1;
				}
				if(GetInvent(acter, invent) < ammout) {
					SendError(playerid, "У гравця недостатньо предметів для передачі");
					SendClientMessage(acter, COLOR_GREY, "У вас недостатньо предметів для передачі");
					DeletePVar(playerid, "give_inv");
					DeletePVar(playerid, "invent");
					DeletePVar(playerid, "ammout");
					return 1;
				}
				if(CI[playerid][pCash] < cash) {
					SendClientMessage(acter, COLOR_GREY, "У гравця недостатньо грошей.");
					SendError(playerid, "У вас недостатньо грошей.");
					DeletePVar(playerid, "give_inv");
					DeletePVar(playerid, "invent");
					DeletePVar(playerid, "ammout");
					return 1;
				}
				CI[acter][pInventoryAmount][slot] -= ammout;
				if(CI[acter][pInventoryAmount][slot] <= 0) {
					CI[acter][pInventoryAmount][slot] = 0;
					CI[acter][pInventory][slot] = 0;
				}
				SaveInventory(acter);

				PlayerTextDrawBackgroundColor(acter, nInventorySlots_TD[playerid][slot], 0x222222ff);
				InvUpdate(acter, slot, CI[acter][pInventory][slot]);

				AddItem(playerid, invent, ammout);

				CI[acter][pActiveTrade][slot] = 0;

				ClickInv[acter] = -1;

				GiveMoney(acter,cash, "продаж предмету");
				GiveMoney(playerid, -cash, "покупка предмета");

				new str[250], string[450];
				format(str, sizeof(str), "%s передав %s [%s] за $%i", CI[playerid][cName], CI[acter][cName], ItemsInfo[invent][ItemName], cash);

				mysql_format(connects, string, sizeof(string), "INSERT INTO `invent_log` (`Name`,`item`,`amount`) VALUES ('%s','%s',%i)", CI[playerid][cName], str,ammout);
				mysql_tquery(connects, string, "", "");

				SendOK(acter, "Ви передали гравцю предмет з інвентаря");
				DeletePVar(acter, "activ_trade");
				DeletePVar(playerid, "give_inv");
				DeletePVar(playerid, "invent");
				DeletePVar(playerid, "pl_count");
			}
		}
		return 1;
	} else if(GetPVarInt(playerid, "pts")) {
		new acter = GetPVarInt(playerid, "pts") -1;
		DeletePVar(playerid, "pts");
		if(acter >= 0 &&IsPlayerConnected(playerid) && IsPlayerConnected(acter)) CarPass(acter, playerid);
	} else if(GetPVarInt(playerid, "lices")) {
		new acter = GetPVarInt(playerid, "lices") -1;
		DeletePVar(playerid, "lices");
		if(acter >= 0 && IsPlayerConnected(playerid) && IsPlayerConnected(acter)) ShowLic(acter, playerid);
	} else if(GetPVarInt(playerid, "skillss")) {
		new acter = GetPVarInt(playerid, "skillss") -1;
		DeletePVar(playerid, "skillss");
		if(acter >= 0 && IsPlayerConnected(playerid) && IsPlayerConnected(acter)) ShowSkill(acter, playerid);
	} else if(GetPVarInt(playerid, "wbook")) {
		new acter = GetPVarInt(playerid, "wbook") -1;
		DeletePVar(playerid, "wbook");
		if(acter >= 0 && IsPlayerConnected(playerid) && IsPlayerConnected(acter)) ShowWBook(acter, playerid);
	} else if(GetPVarInt(playerid, "uds")) {
		new acter = GetPVarInt(playerid, "uds") -1;
		DeletePVar(playerid, "uds");
		if(acter >= 0 &&IsPlayerConnected(playerid) && IsPlayerConnected(acter)) ShowUd(acter, playerid);
	} else if(GetPVarInt(playerid, "lic_")) {
		new acter = GetPVarInt(playerid, "lic_") -1;
		new cash = GetPVarInt(playerid, "lic_cash");
		DeletePVar(playerid, "lic_");
		if(acter >= 0 && IsPlayerConnected(playerid) && IsPlayerConnected(acter)) {

				SendOK(playerid, "Вітаємо з придбанням нової ліцензії.");
				SendOK(acter, "Ліцензію продано.");

				GiveMoney(playerid, -cash, "покупка лицензии");
				GiveMoney(acter,cash, "Продаж лицензии");

				if(QuestProgress[playerid][3] == 0 && AcceptQuest[playerid][3] != 0) {
					QuestProgress[playerid][3] ++;
					ShowPlayerDialog(playerid, DIALOG_NONE, DSM, "Виконання квесту.", W"Ви завершили виконання квесту 'Водійські права'\n\t"NO"Квест можна завершити в Лукаса", "Закрити", "");
					NextStapQI(playerid, 3);
				}

				for(new i = 1; i < MAX_FACTIONS; i++) {
					if(FI[i][fType] == fCIVIL) {
						FI[i][fBank] += cash;
						UpdateFaction(i, "Bank", FI[i][fBank]);
					}
				}

				lic[playerid][GetPVarInt(playerid, "lic_type")] = 1;
				UpdateLicenses(playerid);
				DeletePVar(playerid, "lic_cash");
				DeletePVar(playerid, "lic_");
		}
	} else if(GetPVarInt(playerid, "pass")) {
		new acter = GetPVarInt(playerid, "pass") -1;
		DeletePVar(playerid, "pass");
		if(acter >= 0 && IsPlayerConnected(playerid) && IsPlayerConnected(acter)) ShowPass(acter, playerid);
	} else if(GetPVarInt(playerid, "fpass")) {
		new acter = GetPVarInt(playerid, "fpass") -1;
		DeletePVar(playerid, "fpass");
		if(acter >= 0 && IsPlayerConnected(playerid) && IsPlayerConnected(acter)) ShowFPass(acter, playerid);
	} else if(GetPVarInt(playerid, "medcard")) {
		new acter = GetPVarInt(playerid, "medcard") -1;
		DeletePVar(playerid, "medcard");
		if(acter >= 0 && IsPlayerConnected(playerid) && IsPlayerConnected(acter)) ShowMedcard(acter, playerid);
	} else if(GetPVarInt(playerid, "selectpoint") == 2) {
		new driverid = GetPVarInt(playerid, "taxidriver");
		if(GetPlayerState(playerid) != PLAYER_STATE_PASSENGER) {
			SetPVarInt(playerid, "selectpoint", 0);
			SetPVarInt(playerid, "taxidriver", 0);
			RemovePlayerMapIcon(playerid,iconTaxi);
		}
		new Float:x, Float:y;
		x = GetPVarFloat(playerid, "selectpointX");
		y = GetPVarFloat(playerid, "selectpointY");
		SetPlayerMapIcon(driverid,iconTaxi,x,y, 0.0, 0,COLOR_YELLOW, 1);
		SetPVarFloat(playerid, "selectpointX",x);
		SetPVarFloat(playerid, "selectpointY",y);
		SetPVarInt(playerid, "selectpoint", 0);
		SetPVarInt(driverid, "selectpoint", 0);
		SendOK(playerid, "Дані про місце прзначення відправлені таксисту.");
		SendHint(driverid, "Пасажир встановив мітку на карті. Щоб прибрати мітку, введіть "P"/untaxi"W".");
	} else if(GetPVarInt(playerid, "fam_owner")) {
		new fam = GetPVarInt(playerid, "family");
		new own = GetPVarInt(playerid, "fam_owner") -1;
		CI[own][pFamily] = 0;
		UpdateCharacterData(own, "family", 0);
		CI[own][pFamRank] = 0;
		UpdateCharacterData(own, "pFamRank", 0);
		SendOK(own, "Ви передали свою сім'ю.");
		DeletePVar(playerid, "fam_owner");
		DeletePVar(playerid, "fmily");
		SendOK(playerid, "Ви тепер власник сім'ї. Щоб керувати сім'єю, введіть "P" /fmenu"W".");
		CI[playerid][pFamily] = fam+ 1;
		UpdateCharacterData(playerid, "family",fam+ 1);
		CI[playerid][pFamRank] = 8;
		UpdateCharacterData(playerid, "pFamRank", 8);
		strmid(gFamily[fam][famOwner], CI[playerid][cName], 0,strlen(CI[playerid][cName]), MAX_PLAYER_NAME);
		new query[200];
		mysql_format(connects, query, sizeof(query), "UPDATE `family` SET `owner` = '%s' WHERE `id` = %i LIMIT 1", CI[playerid][cName], fam+ 1);
		mysql_tquery(connects, query, "", "");
		new string[120];
		format(string, sizeof(string), "[FAMILY] "W"%s{%s} новий власник сім'ї.", CI[playerid][cName],FamilyColor[gFamily[CI[playerid][pFamily]-1][famColor]]);
		FamMSG(CI[playerid][pFamily], string);
	} else if(GetPVarInt(playerid, "family_invite")) {
		new fam = GetPVarInt(playerid, "family_invite") -1;
		DeletePVar(playerid, "family_invite");
		if(CI[fam][pFamily]) {
			new string[128];
			CI[playerid][pFamily] = CI[fam][pFamily];
			UpdateCharacterData(playerid, "family", CI[playerid][pFamily]);
			CI[playerid][pFamRank] = 1;
			UpdateCharacterData(playerid, "pFamRank", 1);

			CI[playerid][pFamTalon] = 0;
			UpdateCharacterData(playerid, "talon_fam", CI[playerid][pFamTalon]);
			format(string, sizeof(string), "[FAMILY] "W"%s{%s} вступив у сім'ю.", CI[playerid][cName],FamilyColor[gFamily[CI[playerid][pFamily]-1][famColor]]);
			FamMSG(CI[playerid][pFamily], string);
		}
		if(CI[playerid][pFamily]) {
			if(fam_lable[playerid] == Text3D:-1) {
				new string[50];
				if(gFamily[CI[playerid][pFamily]-1][famType]) format(string, sizeof(string), "[$] {%s}%s",FamilyColor[gFamily[CI[playerid][pFamily]-1][famColor]], gFamily[CI[playerid][pFamily]-1][famName]);
				else format(string, sizeof(string), "{%s}%s",FamilyColor[gFamily[CI[playerid][pFamily]-1][famColor]], gFamily[CI[playerid][pFamily]-1][famName]);
				fam_lable[playerid] = CreateDynamic3DTextLabel(string, -1, 0.0, 0.0, 0.025, 5.0, playerid, INVALID_VEHICLE_ID, 1);
			}
		}
	} else if(GetPVarInt(playerid, "fight_offer")) {
		new i = GetPVarInt(playerid, "fight_offer") -1;
		if(CI[i][pCash] < GetPVarInt(playerid, "fight_price") || CI[playerid][pCash] < GetPVarInt(playerid, "fight_price")) {
			SendError(playerid, "У гравця або у вас недостатньо коштів.");
			DeletePVar(playerid, "fight_offer");
			DeletePVar(playerid, "fight_price");
			return 1;
		}
		if(!ProxDetectorS(5.0, playerid, i)) {
			SendError(playerid, "Гравець дуже далеко від вас.");
			DeletePVar(playerid, "fight_offer");
			DeletePVar(playerid, "fight_price");
			return 1;
		}
		if(!TI[playerid][tGym] || !TI[i][tGym]) {
			SendError(playerid, "Ви або гравець не в спортзалі.");
			DeletePVar(playerid, "fight_offer");
			DeletePVar(playerid, "fight_price");
			return 1;
		}
		if(RingInfo[0][rgStart] == 1) return SendError(playerid, "Ринг зайнято, очікуйте завершення бою.");
		RingInfo[0][rgPlayer][0] = i;
		RingInfo[0][rgPlayer][1] = playerid;
		RingInfo[0][rgStart] = 1;
		RingInfo[0][rgPrice] = GetPVarInt(playerid, "fight_price");
		RingInfo[0][rgLoad][0] = 1;
		new bussid = TI[playerid][tSelectedBusinessID];
		bizz_pay(bussid, GetPVarInt(playerid, "fight_price")/100*30);
		GiveMoney(playerid, -GetPVarInt(playerid, "fight_price"), "запис на бій");
		GiveMoney(i, -GetPVarInt(playerid, "fight_price"), "запис на бій");
		new string[156];
		format(string, sizeof(string), G"Ви записалися на бій. Суперник "P"%s"W". Ставка: "GREEN"$%i"W".", CI[i][cName], GetPVarInt(playerid, "fight_price"));
		SendOK(playerid, string);
		format(string, sizeof(string), P"%s"W" прийняв вашу пропозицію. Ставка: "GREEN"$%i"W".", CI[playerid][cName], GetPVarInt(playerid, "fight_price"));
		SendOK(i, string);
		TI[RingInfo[0][rgPlayer][0]][tFight] = RingInfo[0][rgPlayer][1];
		TI[RingInfo[0][rgPlayer][1]][tFight] = RingInfo[0][rgPlayer][0];
		DeletePVar(playerid, "fight_offer");
		DeletePVar(playerid, "fight_price");
		SetPVarInt(playerid, "fight_start", 1);
		SetPVarInt(i, "fight_start", 1);
		return 1;
	} else if(GetPVarInt(playerid, "inviter")) {

		new inviter = GetPVarInt(playerid, "inviter"), string[128];
		DeletePVar(playerid, "inviter");
		if(!IsPlayerConnected(inviter)) return SendError(playerid, "Гравець, що запросив вас у організацію, офлайн.");
		CI[playerid][pMember] = CI[inviter][pMember];
		CI[playerid][pFracSkin] = FI[CI[inviter][pMember]][fSkins][1];
		CI[playerid][cRadioChannel] = FI[CI[playerid][pMember]][fRadio];
		CI[playerid][pJob] = 0;
		CI[playerid][pRank] = 1;
		CI[playerid][pSpawn] = 2;
		CI[playerid][pfWarn] = 0;
		CI[playerid][pFmute] = 0;
		UpdateCharacterData(playerid, "pModel", CI[playerid][pFracSkin]);
		UpdateCharacterData(playerid, "pMember", CI[playerid][pMember]);
		UpdateCharacterData(playerid, "pRank", CI[playerid][pRank]);
		UpdateCharacterData(playerid, "pJob", CI[playerid][pJob]);
		UpdateCharacterData(playerid, "FracDuty", start_work[playerid]);
		UpdateCharacterData(playerid, "fwarn", 0);
		UpdateCharacterData(playerid, "spawn", CI[playerid][pSpawn]);
		UpdateCharacterData(playerid, "fmute", CI[playerid][pFmute]);
		UpdateCharacterData(playerid, "cRadioChannel", FI[CI[playerid][pMember]][fRadio]);
		SetPlayerColor(playerid, FI[CI[playerid][pMember]][fColor]);
		format(string, sizeof(string), P"%s"W" був прийнятий у вашу організацію.", CI[playerid][cName]);
		SendOK(inviter, string);
		format(string, sizeof(string), "Ви були прийняті у фракцію "P"%s"W".", FI[CI[playerid][pMember]][fName]);
		SendOK(playerid, string);
		A_SetPlayerSkin(playerid, CI[playerid][pFracSkin]);
		add_datefrac(playerid);
		FracLog(LOGS_INVITE, CI[inviter][cName], CI[playerid][cName], "invite");
	} else if(HealOffer[playerid] != INVALID_PLAYER_ID) {
		if(!IsPlayerConnected(HealOffer[playerid])) return SendError(playerid, "Гравець, що запропонував вам лікування, офлайн."),HealOffer[playerid] = INVALID_PLAYER_ID;
		if(CI[playerid][pCash] < HealPrice[playerid]) {
			SendError(playerid, "У вас немає стільки грошей.");
			static const f_str[] = "У %s недостатньо коштів для лікування.";
			new string[sizeof(f_str) + 1 + (-2 + MAX_PLAYER_NAME)];
			format(string, sizeof(string), f_str, CI[playerid][cName]);
			SendOK(HealOffer[playerid], string);
			HealOffer[playerid] = INVALID_PLAYER_ID;
			return 1;
		}
		SetHealth(playerid, 100);
		new string_1[64];
		format(string_1, sizeof(string_1), "Лікар "P"%s"W" вилікував вас за "GREEN"$%i.", CI[HealOffer[playerid]][cName],HealPrice[playerid]);
		SendOK(playerid, string_1);

		CI[HealOffer[playerid]][pMedHeal] += 1;
		UpdateCharacterData(HealOffer[playerid], "MedHeal", CI[HealOffer[playerid]][pMedHeal]);
