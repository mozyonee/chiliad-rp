					format(string, sizeof(string), P"[Диспетчер]"W" %s "P"%s"W" прийняв виклик. "P"(Пожежа у районі %s)", GetRankName(CI[playerid][pMember], CI[playerid][pRank]), CI[playerid][cName], FireAreaName);
					SendInfo(i, string);
				}
