		format(string, sizeof(string), "Money:_$%i", TI[playerid][tJobSalary]);
		PlayerTextDrawSetString(playerid, work_td[playerid][2], string);
		format(string, sizeof(string), "Created:_%i", TI[playerid][jJobGunCreated]);
		PlayerTextDrawSetString(playerid, work_td[playerid][3], string);
		if(CI[playerid][pFamily]) {
			gFamily[CI[playerid][pFamily]-1][famTalon] += 1;
			UpdateFamily(CI[playerid][pFamily], "talon", gFamily[CI[playerid][pFamily]-1][famTalon]);
			CI[playerid][pFamTalon] += 1, UpdateCharacterData(playerid, "talon_fam", CI[playerid][pFamTalon]);
		}

		zavodsklad += 500;
		if(IsPlayerAttachedObjectSlotUsed(playerid, 8)) RemovePlayerAttachedObject(playerid, 8);
		TI[playerid][tJobGun][2] = 0;
		SetPVarInt(playerid, "pOff9", gettime() + 20);
		TI[playerid][tJobGun][1] = 1;
	}
	if(areaid >= sad_area[0] && areaid <= sad_area[119-1] && pstate == PLAYER_STATE_ONFOOT) {
		if(!TI[playerid][tJobSad][0]) return 1;
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) return 1;
		new id = areaid - sad_area[0];
		if(SI[id][sad_temp] != 0 && !GetString(SI[id][sad_fermer], CI[playerid][cName])) return SendError(playerid, "Ви не доглядаєте за цим деревом.");
		if(SI[id][sad_temp] == 0 || SI[id][sad_temp] == 4) {
			if(SI[id][sad_temp] == 0) {
				if(GetPVarInt(playerid, "sad_uxod") == 1) return SendError(playerid, "Ви вже доглядаєте за деревом.");
				if(!GetPVarInt(playerid, "bailer")) return SendError(playerid, "У вас немає лійки в руках.");
				if(GetPVarInt(playerid, "bailer_3")) return SendError(playerid, "Ви не можете полити дерево з ящиком яблук в руках.");
				JobTempProcess[playerid] = 1;
				SI[id][sad_temp] = 1;
				SetString(SI[id][sad_fermer], CI[playerid][cName]);
				new string[70];
				format(string, sizeof(string), "Дерево\nСтадія - сохне\nФермер - %s",SI[id][sad_fermer]);
				UpdateDynamic3DTextLabelText(SI[id][sad_3dtext], -1, string);
			}
			if(SI[id][sad_temp] == 4 && GetString(SI[id][sad_fermer], CI[playerid][cName])) {
				if(!GetPVarInt(playerid, "bailer_2")) return SendError(playerid, "У вас немає ящика для збирання яблук в руках.");
				JobTempProcess[playerid] = 2;
				if(SI[id][sad_temp] == 4) {
					if(GetPVarInt(playerid, "bailer_4")) return 1;
					SetPVarInt(playerid, "bailer_4", 1);
				}
			}
			TI[playerid][tJobSad][1] = id+ 1;
			TI[playerid][tProcess][0] = 0;
			TI[playerid][tProcess][1] = 10;
			PlayerTextDrawColor(playerid, YandNsysTDPlayer[playerid][1], -1);
			for(new YN = 0;YN < 3;YN++) {
				TextDrawShowForPlayer(playerid, YandNsysTD[YN]);
				if(YN < 2) PlayerTextDrawShow(playerid,YandNsysTDPlayer[playerid][YN]);
			}
			RandomYareNforJOBS(playerid);
		} else SendError(playerid, "Очікуйте стадії збирання яблук.");
	}
	if(areaid >= gAreas[arTurma][0] && areaid <= gAreas[arTurma][6] && TI[playerid][tClothesWork][0] == 1 && TI[playerid][tClothesWork][1] == 1) {
		JobTempProcess[playerid] = 24;
		TI[playerid][tProcess][0] = 0;
		TI[playerid][tProcess][1] = 10;
		PlayerTextDrawColor(playerid, YandNsysTDPlayer[playerid][1], -1);
		for (new YN = 0; YN < 3; YN++) {
			TextDrawShowForPlayer(playerid, YandNsysTD[YN]);
			if(YN < 2) PlayerTextDrawShow(playerid, YandNsysTDPlayer[playerid][YN]);
		}
		RandomYareNforJOBS(playerid);
	}
	if(areaid >= gAreas[arSkladTurm]) {
