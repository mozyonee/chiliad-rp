CMD:vereget(playerid) {
	if(PI[playerid][pAdmin] < 3) return SendError(playerid, "    А");
	for(new i = 0; i < 24; i++) capture_kd[i] = 0;
	return 1;
}

CB:CureStage(playerid) {
	SetHealth(playerid, 50);
	CI[playerid][cStage] = 0;
	KillTimer(CI[playerid][cDeathTimer]);
	DestroyDynamicArea(CI[playerid][cDeathArea]);
	ShowPlayerDialog(playerid, -1, 0, " ", " ", " ", " ");
	Update3DTextLabelText(CI[playerid][cDeathLabel], 0xFF6347AA, "");
	if(IsPlayerInAnyVehicle(playerid)) {
		new curVeh = GetPlayerVehicleID(playerid);
		new curSeat = GetPlayerVehicleSeat(playerid);
		ClearAnimations(playerid, 1);
		PutPlayerInVehicle(playerid, curVeh, curSeat);
	} else ClearAnimations(playerid, 1);

	new query[128];
	mysql_format(connects, query, sizeof(query), "UPDATE "TABLE_CHARACTERS" SET `cStage` = '0' WHERE `cID` = %i LIMIT 1", CI[playerid][cID]);
	mysql_query(connects, query);
	return 1;
}

CB:DeathStageTimer(playerid) {
	SetPVarInt(playerid, "anti_sbiv_time", GetPVarInt(playerid, "anti_sbiv_time") + 1);
	if(CI[playerid][cStage] != 1 && CI[playerid][cStage] != 2) return KillTimer(CI[playerid][cDeathTimer]), DestroyDynamicArea(CI[playerid][cDeathArea]);
	if(CI[playerid][cDeathTimerSec] < 1) return SendError(playerid, "Ваш персонаж помер, оскільки медики не приїхали вчасно."), SetHealth(playerid, 0);
	if(IsPlayerInAnyVehicle(playerid) && GetPlayerAnimationIndex(playerid) != 1019) ApplyAnimation(playerid, "ped", "CAR_dead_RHS", 4.1, 0, 1, 1, 1, -1, 0);
	if(!IsPlayerInAnyVehicle(playerid) && GetPlayerAnimationIndex(playerid) != 1701) ApplyAnimation(playerid, "WUZI", "CS_Dead_Guy", 4.1, 0, 1, 1, 1, -1, 0);
	if(TI[playerid][tAFK] > 0) return 1;
	new string[16];
	valstr(string, CI[playerid][cDeathTimerSec]);
	GameTextForPlayer(playerid, string, 1000, 4);
	CI[playerid][cDeathTimerSec]--;
	return 1;
}

