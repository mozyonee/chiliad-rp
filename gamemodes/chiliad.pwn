			new str[250];
			format(str, 128, "Приженіть Джеку %s, що відмічений на карті червоним маркером.", vehicle_name[model-400]);
			SendInfo(playerid, str);
			SendInfo(playerid, "Використайте: /theft для зламу та заведення двигуна транспорта.");
