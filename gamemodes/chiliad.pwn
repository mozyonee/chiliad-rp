stock AddPame(playerid) {
	if(strlen(player_pame[playerid]) <= 1) return 1;
	pame_text[playerid] = Create3DTextLabel(player_pame[playerid], 0xFFFFFFDD, 0.0, 0.0, 12000.0, 3, 0, 1);
	Attach3DTextLabelToPlayer(pame_text[playerid], playerid, 0.0, 0.0, -0.8);
	return 1;
}
CMD:pame(playerid, params[]) {
	if(sscanf(params, "s[64]",params[0])) return SendClientMessage(playerid, COLOR_WHITE, "Введіть: /pame [description]");
    if(pame_text[playerid] != Text3D:-1) return SendError(playerid, "У вас вже встановлений опис. Для видалення використайте: /dellpame");
	new string[128], query[155];
	format(string, sizeof(string), "Ви створили опис персонажа: %s.", params[0]);
    SendOK(playerid, string);
	format(player_pame[playerid], 64, "%s", params[0]);
	mysql_format(connects, query, sizeof(query), "UPDATE "TABLE_CHARACTERS" SET `cPame` = '%s' WHERE `cID` = %i LIMIT 1",player_pame[playerid], CI[playerid][cID]);
	mysql_tquery(connects, query, "", "");
	AddPame(playerid);
    return 1;
} 
CMD:dellpame(playerid, params[]) {
    if(pame_text[playerid] == Text3D:-1) return SendError(playerid, "Ви не створювали опис персонажу. Використайте: /pame [description]"); // Чи є опис у гравця.
	new query[155];
	format(player_pame[playerid], 64, "");
	mysql_format(connects, query, sizeof(query), "UPDATE "TABLE_CHARACTERS" SET `cPame` = '' WHERE `cID` = %i LIMIT 1",player_pame[playerid], CI[playerid][cID]);
	mysql_tquery(connects, query, "", "");
    SendOK(playerid, "Ви видалили опис свого персонажу.");
    Delete3DTextLabel(pame_text[playerid]);
    pame_text[playerid] = Text3D:-1;
    return 1;
} 
CMD:aedit(playerid) {
	if(PI[playerid][pAdmin] < 7 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	ShowPlayerDialog(playerid, 5736, DSL, P"Керування оновленнями.", P"1."W" Керування акторами.\n"P"2."W" Керування сервером.", "Обрати", "Скасувати");
	return 1;
}
CMD:prefix(playerid,params[]) {
    if(PI[playerid][pAdmin] < 7 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
    if(sscanf(params, "d", params[0])) {
        SendClientMessage(playerid, COLOR_WHITE, "Введіть: /prefix [playerid]");
        return 1;
    }
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "Неправильний ID.");
	if(!PI[params[0]][pAdmin]) return 1;
    if(CI[params[0]][pPrefix_i]) return SendError(playerid, "У гравця вже є префікс. Щоб видалити його, введіть "P"/delprefix"W".");
    SetPVarInt(playerid, "EditingPlayerPrefix",params[0]);
    ShowPlayerDialog(playerid, 2095, DSI, P"Створення префікса для гравця.", W"Введіть префікс, якийви хочете видати гравцю.\nВрахуйте, щови можете використовувати HEX колір в {}", "Зберегти", "Закрити");
    return 1;
}
stock UpdatePrefixAuto(playerid) {
    if(PI[playerid][pAdmin]) return 1;
    if(!CI[playerid][pPrefix_i]) return 1;
    CI[playerid][pPrefix_i] = 0;
    SavePrefix(playerid);
    return 1;
}
stock SavePrefix(i) {
	new string[128];
    mysql_format(connects, string, 128, "UPDATE "TABLE_CHARACTERS" SET `pPrefix_s` = '%s', `pPrefix_i` = %i WHERE `ID` = %i LIMIT 1", CI[i][pPrefix_s], CI[i][pPrefix_i], CI[i][cID]);
    mysql_tquery(connects, string);
    return 1;
}
stock SetPrefix(playerid,byid,prefixtext[]) {
    if(!IsPlayerConnected(byid)) return 1;
    if(!IsPlayerConnected(playerid)) return 1;
    set_string(CI[playerid][pPrefix_s],prefixtext);
    CI[playerid][pPrefix_i] = 1;
    FSAM(-1, "{AFAFAF}[A] Адміністратор %s[%i] видав префікс %s[%i] [%s{AFAFAF}]", CI[byid][cName], byid, CI[playerid][cName], playerid,prefixtext);
    SavePrefix(playerid);
    return 1;
}
CMD:delprefix(playerid,params[]) {
    if(PI[playerid][pAdmin] < 7 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
    if(sscanf(params, "d", params[0])) {
        SendClientMessage(playerid, COLOR_WHITE, "Введіть: /delprefix [playerid]");
        return 1;
    }
    if(!IsPlayerConnected(params[0])) return SendError(playerid, "Неправильний ID.");
	if(!PI[params[0]][pAdmin]) return 1;
    if(!CI[params[0]][pPrefix_i]) return SendError(playerid, "У гравця немає префікса. Щоб створити префікс, введіть "P"/prefix"W".");
    CI[params[0]][pPrefix_i] = 0;
    SavePrefix(params[0]);
    FSAM(-1, "{AFAFAF}[A] Адміністратор %s[%i] забрав префікс у %s[%i]", CI[playerid][cName], playerid, CI[params[0]][cName], params[0]);
    return 1;
}
CMD:makeadmin(playerid, params[]) {
	if(PI[playerid][pAdmin] < 6 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new targetid, lvl;
	if(sscanf(params, "ii", targetid, lvl)) return SendError(playerid, "Використайте: /makeadmin [playerid] [lvl]");
	if(!IsPlayerConnected(targetid) || playerid == targetid) return SendError(playerid, not_id);
	if(!(0 <= lvl <= 7)) return SendError(playerid, "Рівень повинен бути від 0 до 7.");
	new query[128];
	mysql_format(connects, query, sizeof(query), "SELECT * FROM `admin` WHERE `Name` = '%s' LIMIT 1", PI[targetid][pName]);
	mysql_pquery(connects, query, "Moderator", "iii", playerid, targetid, lvl);
	return 1;
}
CMD:last(playerid, params[]) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return SendError(playerid, "У вас немає доступу до цієї функції.");
	if(isnull(params) || strlen(params) > 25) return SendError(playerid, "Використайте: /last [playername]");
	new query[128];
	mysql_format(connects, query, sizeof(query), "SELECT * FROM "TABLE_CHARACTERS" WHERE `Name` = '%s'",params);
	new Cache:result = mysql_query(connects, query);
	new rows = cache_num_rows();
	if(rows == 0) return SendError(playerid, "Акаунт не знайдено.");
	cache_get_value_name(0, "pOnline",query, 30);
	static const f_str[] = "Нік: %s. Останній вхід: %s.";
	new string[sizeof(f_str) + 1 + (-2 + MAX_PLAYER_NAME) + (-2 + 9)];
	format(string, sizeof(string), f_str, params, query);
	SendInfo(playerid, string);
	cache_delete(result);
	return 1;
}
CMD:factions(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new content[1024];
	for(new i = 1; i < MAX_FACTIONS; i++) {
		if(FI[i][fName]) format(content, sizeof(content), "%s"P"%i."W" %s.\n", content, i, FI[i][fName]);
	}
	strcat(content, P"-"W" Створити організацію.");
	return ShowPlayerDialog(playerid, D_FACTIONS_LIST, DSL, P"|"W" Керування організаціями.", content, "Обрати", "Скасувати");
}

CMD:infoips(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(isnull(params) || strlen(params) > 19) return SendError(playerid, "Використайте: /infoips [IP]");
	new query[256];
	mysql_format(connects, query, sizeof(query), "SELECT HIGH_PRIORITY * FROM "TABLE_CHARACTERS" WHERE `pvIp` LIKE '%s%s%sі'", "%", params, "%");
	new Cache:result = mysql_query(connects, query);
	new rows = cache_num_rows();
	if(rows == 0) return SendError(playerid, "IP адресу не знайдено.");
	new tmpas[16], regip[16], mname[32], level;
	for(new i = 0; i < rows; i++) {
		cache_get_value_name(i, "pName", mname, MAX_PLAYER_NAME);
		cache_get_value_name(i, "pLastIP", tmpas, 16);
		cache_get_value_name(i, "pRegIP", regip, 16);
		cache_get_value_name_int(i, "pLevel", level);
		static const f_str[] = "%s. LAST-IP: %s. REG-IP: %s. LVL: %i";
		new string[sizeof(f_str) + 1 + (-2 + MAX_PLAYER_NAME) + (-2 + 16) + (-2 + 16) + (-2 + 4)];
		format(string, sizeof(string), f_str, mname, tmpas, regip, level);
		SendOK(playerid, string);
	}
	cache_delete(result);
	return 1;
}
CMD:mutelist(playerid, const params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new countmute = 0, string[1024], str[128];
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(CI[i][pMute] > 0) {
			format(str, sizeof(str), P"%i. "P"%s"W". ID: "P"%i"W". Секунд: "P"%i\n",countmute+ 1, CI[i][cName],i, CI[i][pMute]),strcat(string, str);
			countmute++;
		}
	}
	if(countmute == 0) return SendError(playerid, "Немає гравців з баном чату.");
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Гравці з баном чату", string, "Закрити", "");
	return 1;
}
CMD:agetip(playerid, params[]) {
	if(PI[playerid][pAdmin] < 7 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(isnull(params) || strlen(params) > 25) return SendError(playerid, "Використайте: /agetip [playername]");
	new QUERY[128];
	mysql_format(connects, QUERY, sizeof(QUERY), "SELECT * FROM "TABLE_CHARACTERS" WHERE `Name` = '%s'",params);
	new Cache:result = mysql_query(connects, QUERY),ip[2][17];
	new rows = cache_num_rows();
	if(rows == 0) return SendError(playerid, "Акаунт не знайдено.");
	cache_get_value_name(0, "pLastIP", ip[0], 16);
	cache_get_value_name(0, "pRegIP", ip[1], 16);
	static const f_str[] = "Нік: %s. IP: %s. IP при реєстрації: %s.";
	new string[sizeof(f_str) + 1 + (-2 + MAX_PLAYER_NAME) + (-2 + 17) + (-2 + 17)];
	format(string, sizeof(string), f_str,params,ip[0],ip[1]);
	SendInfo(playerid, string);
	cache_delete(result);
	return 1;
}
CMD:captfreeze(playerid,params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new gang_id, time, string[128], band[16];
	if(sscanf(params, "ii", gang_id, time)) {
		SendClientMessage(playerid, COLOR_WHITE, "/captfreeze [playerid] [hours]");
		SendClientMessage(playerid, COLOR_WHITE, "1 - Ballas; 2 - Los Santos Vagos; 3 - Grove Street Families;");
		SendClientMessage(playerid, COLOR_WHITE, "4 - San Fierro Rifa;  5 - Varrios Los Aztecas; 6 - Сицилійська мафія;");
		SendClientMessage(playerid, COLOR_WHITE, "7 - Тріада; 8 - Російська мафія.");
		return 1;
	}
	if(gang_id < 1 || gang_id > 8 || time < 0) {
		SendClientMessage(playerid, COLOR_WHITE, "/captfreeze [playerid] [hours]");
		SendClientMessage(playerid, COLOR_WHITE, "1 - Ballas; 2 - Los Santos Vagos; 3 - Grove Street Families;");
		SendClientMessage(playerid, COLOR_WHITE, "4 - San Fierro Rifa; 5 - Varrios Los Aztecas; 6 - Сицилійська мафія;");
		SendClientMessage(playerid, COLOR_WHITE, "7 - Тріада; 8 - Російська мафія.");
		return 1;
	}
	switch(gang_id) {
	case 1: band = "банду";
	case 2: band = "банду";
	case 3: band = "банду";
	case 4: band = "банду";
	case 5: band = "банду";
	case 6: band = "мафію";
	case 7: band = "мафію";
	case 8: band = "мафію";
	case 9: band = "банду";
	default: band = "None";
	}
	if(time == 0) {
		fracmoroz[gang_id-1] = 0;
		format(string, sizeof(string), "Адміністратор %s розморозив %s %s.", CI[playerid][cName],band,fracmorozName[gang_id-1]);
	} else {
		fracmoroz[gang_id-1] = gettime()+(3600*time);
		format(string, sizeof(string), "Адміністратор %s заморозив %s %s на %i годин.", CI[playerid][cName],band,fracmorozName[gang_id-1],time);
	}
	SendAdminActionMessage(COLOR_LIGHTRED, string);
	UpdateMorozed();
	return 1;
}
CMD:apanel(playerid, const params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new string[1612];
	switch(PI[playerid][pAdmin]) {
	case 1: format(string, sizeof(string), P"1."W" Адміністрація\n"P"2."W" Заспавнитися\n"P"3."W" Влаштуватися на роботу\n"P"4."W" Гравці у в'язниці\n"P"5."W" Гравці з баном чату\n"P"6."W" Адмін інформація %s\n"P"7."W" Кілл Лист %s",(!CI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!CI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
	case 2: format(string, sizeof(string), P"1."W" Адміністрація\n"P"2."W" Заспавнитися\n"P"3."W" Влаштуватися на роботу\n"P"4."W" Гравці у в'язниці\n"P"5."W" Гравці з баном чату\n"P"6."W" Адмін інформація %s\n"P"7."W" Кілл Лист %s\n"P"8."W" Онлайн організацій\n"P"9."W" Відремонтувати автомобіль",(!CI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!CI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
	case 3: format(string, sizeof(string), P"1."W" Адміністрація\n"P"2."W" Заспавнитися\n"P"3."W" Влаштуватися на роботу\n"P"4."W" Гравці у в'язниці\n"P"5."W" Гравці з баном чату\n"P"6."W" Адмін інформація %s\n"P"7."W" Кілл Лист %s\n"P"8."W" Онлайн організацій\n"P"9."W" Відремонтувати автомобіль\n"P"10."W" Стан складів\n"P"11."W" Дізнатися заморозки банд та мафій",(!CI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!CI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
	case 4: format(string, sizeof(string), P"1."W" Адміністрація\n"P"2."W" Заспавнитися\n"P"3."W" Влаштуватися на роботу\n"P"4."W" Гравці у в'язниці\n"P"5."W" Гравці з баном чату\n"P"6."W" Адмін інформація %s\n"P"7."W" Кілл Лист %s\n"P"8."W" Онлайн організацій\n"P"9."W" Відремонтувати автомобіль\n"P"10."W" Стан складів\n"P"11."W" Дізнатися заморозки банд та мафій\n"P"12."W" Бан лист\n"P"13."W" Можливо зламані\n"P"14."W" Білборди\n",(!CI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!CI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
	case 5: format(string, sizeof(string), P"1."W" Адміністрація\n"P"2."W" Заспавнитися\n"P"3."W" Влаштуватися на роботу\n"P"4."W" Гравці у в'язниці\n"P"5."W" Гравці з баном чату\n"P"6."W" Адмін інформація %s\n"P"7."W" Кілл Лист %s\n"P"8."W" Онлайн організацій\n"P"9."W" Відремонтувати автомобіль\n"P"10."W" Стан складів\n"P"11."W" Дізнатися заморозки банд та мафій\n"P"12."W" Бан лист\n"P"13."W" Можливо зламані\n"P"14."W" Білборди\n"P"15."W" Казино %s\n"P"16."W" Заповнити склади банд та мафій",(!CI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!CI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!casino) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
	case 6, 7: format(string, sizeof(string), P"1."W" Адміністрація\n"P"2."W" Заспавнитися\n"P"3."W" Влаштуватися на роботу\n"P"4."W" Гравці у в'язниці\n"P"5."W" Гравці з баном чату\n"P"6."W" Адмін інформація %s\n"P"7."W" Кілл Лист %s\n"P"8."W" Онлайн організацій\n"P"9."W" Відремонтувати автомобіль\n"P"10."W" Стан складів\n"P"11."W" Дізнатися заморозки банд та мафій\n"P"12."W" Бан лист\n"P"13."W" Можливо зламані\n"P"14."W" Білборди\n"P"15."W" Казино %s\n"P"16."W" Заповнити склади банд та мафій\n"P"17."W" Промокоди\n"P"18."W" Поповнити продукти в бізнесі\n"P"19."W" Банкомати",(!CI[playerid][pAdmMSG]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!CI[playerid][pAdmKL]) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"),(!casino) ? ("{FF182D}[OFF]") : ("{33AA33}[ON]"));
	}
	ShowPlayerDialog(playerid, D_ADMIN_PANEL, DSL, P"Адмін панель.", string, "Обрати", "Скасувати");
	return 1;
}
CMD:ainfo(playerid,params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new string[512];
	format(string, sizeof(string), W"Кіків: "P"\t\t%i\n"W"Банів: "P"\t\t%i\n"W"Мутів: "P"\t\t%i\n"W"Репутація: "P"\t\t%i\n"W"Варнів: "P"\t\t%i\n"W"Джайлів: "P"\t\t%i\n\n"W"Онлайн за поточний день:"P"\t%s", gAdmin[playerid][0], gAdmin[playerid][1], gAdmin[playerid][2], gAdmin[playerid][3], gAdmin[playerid][4], gAdmin[playerid][5],ConvertsCmdTime(gAdminTime[playerid]));
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, CI[playerid][cName], string, "Закрити", "");
	return 1;
}
CMD:admstats(playerid,params[]) {
	if(PI[playerid][pAdmin] < 5 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	ShowPlayerDialog(playerid, D_ADMIN_TIME, DSI, P"Статистика адміністратора.", "\n\n"W"Для перегляда статистики адміністратора\nвкажіть його нік:\n\n", "Ввести", "Скасувати");
	return 1;
}
CMD:agiverank(playerid,params[]) {
	if(PI[playerid][pAdmin] < 6 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new rankid, giveplayerid;
	if(sscanf(params, "ui", giveplayerid, rankid)) return SendError(playerid, "Використайте: /agiverank [playerid] [rank]");
	if(giveplayerid == INVALID_PLAYER_ID) return SendError(playerid, not_id);
	if(!CI[giveplayerid][pMember]) return SendError(playerid, "Гравець не є членом організації.");
	if(rankid > (FI[CI[giveplayerid][pMember]][lRank]-1) || rankid < 1) return SendError(playerid, "Ви допустили помилку.");
	new string[128];
	format(string, sizeof(string), "[A] %s змінив ранг гравцю %s з %i на %i.", CI[playerid][cName], CI[giveplayerid][cName], CI[giveplayerid][pRank], rankid);
	AdmMSG(0xAFAFAFAA, string);
	format(string, sizeof(string), "Адміністратор "P"%s"W" змінив вам ранг на "P"%i"W".", CI[playerid][cName], rankid);
	SendHint(giveplayerid, string);
	CI[giveplayerid][pRank] = rankid;
	UpdateCharacterData(giveplayerid, "pRank", rankid);
	return 1;
}
CMD:setbizmafia(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new mafiaid;
	if(sscanf(params, "d", mafiaid)) return SendError(playerid, "Використайте: /setbizmafia [factionid]");
	if(FI[mafiaid][fType] != fMAFIA) return 1;
	for(new b; b < gBusinessCount; b++) {
		if(!IsPlayerInRangeOfPoint(playerid, 4.0, gBusiness[b][bizzX], gBusiness[b][bizzY], gBusiness[b][bizzZ])) continue;
		gBusiness[b][bizzMafia] = mafiaid;
		new string[128];
		format(string, sizeof(string), "[A] %s змінив контроль бізнесу %s - %s", CI[playerid][cName], gBusiness[b][bizzName], FI[mafiaid][fName]);
		AdmMSG(0xAFAFAFAA, string);
		UpdateBusinessText(b);
		UpdateBusinessData(b+ 1, "mafia", gBusiness[b][bizzMafia]);
		break;
	}
	return 1;
}
CMD:gspawn(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendInfo(playerid, "Використайте: /gspawn [playerid]");
	if(giveplayerid == INVALID_PLAYER_ID) return SendError(playerid, not_id);
	PlayerSpawn(giveplayerid);
	new string[128];
	format(string, sizeof(string), "[A] %s[%i] заспавнив гравця %s[%i].", CI[playerid][cName], playerid, CI[giveplayerid][cName], giveplayerid);
	AdmMSG(0xAFAFAFAA, string);
	format(string, sizeof(string), "Вас заспавнив адміністратор %s.", CI[playerid][cName]);
	SendOK(giveplayerid, string);
	return 1;
}

CMD:acure(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendInfo(playerid, "Використайте: /acure [playerid]");
	if(giveplayerid == INVALID_PLAYER_ID) return SendError(playerid, not_id);
	if(CI[giveplayerid][cStage] != 1 && CI[giveplayerid][cStage] != 2) return SendError(playerid, "Гравець не в стадії.");
	CureStage(giveplayerid);
	new string[128];
	format(string, sizeof(string), "Адміністратор "P"%s"W" підняв вас зі стадії.", CI[playerid][cName]);
	SendOK(giveplayerid, string);
	return 1;
}

CMD:setmykill(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(sscanf(params, "ud", params[0], params[1])) return SendError(playerid, "Використайте: /setmykill [issuerid] [weaponid]");
	new Float:playeridhp;
	OnPlayerDamageDone(playerid, GetPlayerHealth(playerid, playeridhp), params[0], params[1], BODY_PART_UNKNOWN);
	SendOK(playerid, "Ви вбили себе.");
	return 1;
}
CMD:inet(playerid, params[]) {
	new stats[100], stringstats[70], string[60], giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendError(playerid, "Використайте: /inet [playerid]");
	GetPlayerNetworkStats(giveplayerid, stats, sizeof(stats));
	new last = strfind(stats, "Packetloss: ");
	new Float:packetloss = 0.0;
	if(last != -1) {
		strmid(stringstats, stats, last, strlen(stats));
		new last2 = strfind(stringstats, "%");
		if(last != -1)  {
			strdel(stats, 0, strlen(stats));
			strmid(stats, stringstats, last2-3, last2);
			packetloss = floatstr(stats);
		}
	}
	format(string, sizeof(string), "Name: %s. PacketLoss: %.0f.", CI[giveplayerid][cName],packetloss);
	SendClientMessage(playerid, 0x6BB3FFAA, string);
	return 1;
}
CMD:timestat(playerid) {
	if(PI[playerid][pAdmin] < 6 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new str[600];
	format(str, sizeof(str), "Останній час прокрутки Timer_Unix: (%i ms). пік: (%i ms).\n", time_grandtimer, time_grandtimer_max);
	format(str, sizeof(str), "%sОстанній час прокрутки OnPlayerUpdate: (%i ms). пік: (%i ms).\nОстанній час прокурутки \"newkeys\": (%i ms). пік: (%i ms).\nОСтанній час прокрутки \"second_timer\": (%i ms). пік: (%i ms).\nОСтанній час прокрутки \"PAYDAY\": (%i ms). пік: (%i ms).\nОСтанній час прокрутки \"Minute Timer\": (%i ms). пік: (%i ms).", str, time_update,time_update_max,time_newkeys,time_newkeys_max,time_second,time_second_max,timer_payday,timer_paydaymax, minute_update, minute_update_max);
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Нагрузка на мод", str, "Закрити", "");
	return 1;
}
CMD:poscar(playerid, params[]) {
	if(PI[playerid][pAdmin] < 7 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(sscanf(params, "d",params[0])) return SendError(playerid, "Використайте: /poscar [house]");
	new carid = GetPlayerVehicleID(playerid);
	if(GetVehicleModel(carid) != 560) return SendError(playerid, "Сядьте в султан.");

	new Float: lwx, Float:lwy, Float:lwz, Float:a;
	GetVehiclePos(carid,lwx, lwy, lwz);
	GetVehicleZAngle(carid,a);
	gHouses[params[0]-1][houseParkX] = lwx;
	gHouses[params[0]-1][houseParkY] = lwy;
	gHouses[params[0]-1][houseParkZ] = lwz;
	gHouses[params[0]-1][houseParkR] = a;
	SetVehicleToRespawn(GetPlayerVehicleID(playerid));
	SendOK(playerid, "Координати машини встановлені.");
	new query[256];
	mysql_format(connects, query, sizeof(query), "UPDATE `houses` SET `parkx` = '%.2f',`parky` = '%.2f',`parkz` = '%.2f',`parkr` = '%.2f' WHERE id = %i", gHouses[params[0]-1][houseParkX], gHouses[params[0]-1][houseParkY], gHouses[params[0]-1][houseParkZ], gHouses[params[0]-1][houseParkR],params[0]);
	mysql_tquery(connects, query);
	return 1;
}
CMD:mp(playerid) {
	if(!Teleport) return SendError(playerid, "Активних ігрових заходів немає.");
	if(MPTeleportPlayer[playerid] == 1) return SendError(playerid, "Ви вже телепортувались на ігровий захід.");
	if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Не можна використовувати в транспорті.");
	if(CI[playerid][pJailTime] >= 1) return SendError(playerid, "Ви у в'язниці.");
	if(CI[playerid][pHospital]) return SendError(playerid, "Ви у лікарні.");
	if(Teleport_Players[1] >= Teleport_Players[0]) return SendError(playerid, "Недостатньо місць на ігровому заході.");

	SetPlayerPosAC(playerid, TeleportFloat[0], TeleportFloat[1]+ 2, TeleportFloat[2],TeleportInfo[1],TeleportInfo[0]);
	Teleport_Players[1]++;

	SendClientMessage(playerid, COLOR_WHITE, "Ви телепортувались на ігровий захід.");

	MPTeleportPlayer[playerid] = 1;
	return 1;
}
CMD:gomp(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 && GetPVarInt(playerid, "adminaccess") != 1 && CI[playerid][pYoutube] == 0) return 1;
	if(!Teleport) ShowPlayerDialog(playerid, D_MP, DSL, P"Ігровий захід", P"1."W" Створити телепорт\n"P"2."W" Роздати зброю\n"P"3."W" Роздати життя\n"P"4."W" Роздати броню\n"P"5."W" Обеззброїти всіх\n"P"6."W"Забрати броню\n"P"7."W"Заморозити гравців (радіус 50м)\n"P"8."W"Розморозити гравців (радіус 50м)\n"P"9."W"Видати тимчасовий скін\n"P"10."W"Ввести назву\n"P"11."W"Указать к-сть учасників на ІЗ", "Обрати", "Скасувати");
	else ShowPlayerDialog(playerid, D_MP, DSL, P"Ігровий захід", P"1."W"Видалити телепорт\n"P"2."W" Роздати зброю\n"P"3."W" Роздати життя\n"P"4."W" Роздати броню\n"P"5."W" Обеззброїти всіх\n"P"6."W"Забрати броню\n"P"7."W"Заморозити гравців (радіус 50м)\n"P"8."W"Розморозити гравців (радиус 50м)\n"P"9."W"Видати тимчасовий скін\n"P"10."W"Ввести назву\n"P"11."W"Указать к-сть учасників на ІЗ", "Обрати", "Скасувати");
	return 1;
}
CMD:bizwar(playerid) {
	if(!IsAMafia(playerid)) return SendError(playerid, "Ви не член мафії.");
	if(CI[playerid][pRank] < 9) return SendError(playerid, "Вам недоступна ця команда.");
	if(BizWarTime[0] > 0 || BizWarTime[1] > 0) return SendError(playerid, "Війна за бізнес вже триває.");
	//if(tmphour < 10 || tmphour >= 22) return SendError(playerid, "Использовать команду можна тільки з 12:00 до 22:00");
	if(BizHourTime > 0) {
		new string[128];
		format(string, sizeof(string), "Таймер до наступного захоплення {AFAFAF}[%i хв]", BizHourTime);
		SendError(playerid, string);
		return 1;
	}
	for(new h; h < gBusinessCount; h++) {
		if(!IsPlayerInRangeOfPoint(playerid, 3, gBusiness[h][bizzX], gBusiness[h][bizzY], gBusiness[h][bizzZ])) continue;
		switch(GetPlayerVirtualWorld(playerid)) {
		case 46: h = 7;
		case 47: h = 8;
		case 48: h = 9;
		}
		if(gBusiness[h][bizzMafia] == CI[playerid][pMember]) return SendError(playerid, "Цей бізнес під дахуванням вашої мафії.");
		if(gBusiness[h][bizzMafia] <= 0) {
			gBusiness[h][bizzMafia] = CI[playerid][pMember];
			UpdateBusinessData(h+ 1, "mafia", gBusiness[h][bizzMafia]);
			UpdateBusinessText(h);
			SendOK(playerid, "Бізнес взято під кришування вашої мафії.");
			return 1;
		} else {
			new string[156];
			format(string, sizeof(string), W"Цей бізнес "GREEN"%s"W" належить {%06x}%s\n\n"P"\tВи погоджуєтеся розпочати захоплення бізнесу?", gBusiness[h][bizzName], FI[gBusiness[h][bizzMafia]][fColor] >>> 8, GetMN(gBusiness[h][bizzMafia]));
			if(!IsPlayerInBandOnline(gBusiness[h][bizzMafia])) return SendError(playerid, "Мафія, на яку ви збираєтеся напасти, не на сервері.");
			ShowPlayerDialog(playerid, D_BIZWAR, DSM, P"Атака бізнесу", string, "Так", "Ні");
			SetPVarInt(playerid, "bizwar_id", h);
			return 1;
		}
	}
	return SendError(playerid, "Необхідно знаходитись поруч з бізнесом.");
}
CMD:bizrasf(playerid, params[]) { // Розформування бізнесів.
	if(PI[playerid][pAdmin] < 6 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(sscanf(params, "i",params[0])) {
		SendError(playerid, "Використайте: /bizrasf [mafiaid]");
		SendHint(playerid, "15 - Сицилійська мафія; 16 - Тріада; 17 - Російська мафія.");
		return 1;
	}
	if(params[0] != 15 && params[0] != 16 && params[0] != 17) return 1;
	new query[300];
	mysql_format(connects, query, sizeof(query), "UPDATE `business` SET `mafia` = '0' WHERE `mafia` = %i",params[0]);
	mysql_tquery(connects, query, "", "");
	for(new i; i<gBusinessCount; i++) {
		if(gBusiness[i][bizzMafia] == params[0]) {
			gBusiness[i][bizzMafia] = 0;
		}
		UpdateBusinessText(i);
	}
	SendOK(playerid, "Бізнеси у цій мафії успішно розформовані.");
	return 1;
}
CMD:bizlist(playerid, params[]) {
	if(!IsAMafia(playerid)) return SendError(playerid, "Ви не мафіозі.");
	new count_business = 1, string[3400];
	string = ""W"#\t"W"Назва бізнесу\t"W"Прибуток за сьогодні\n";
	new factionid = CI[playerid][pMember];
	for(new i; i<gBusinessCount; i++) {
		if(gBusiness[i][bizzMafia] != CI[playerid][pMember]) continue;
		if(factionid) {
			if(count_business > 50) break;
			format(string, sizeof(string), "%s"P"%i\t%s\t$%i\n", string, count_business, gBusiness[i][bizzName], gBankMafia[factionid][i]);
			count_business++;
		}
	}
	if(count_business < 50) ShowPlayerDialog(playerid, DIALOG_NONE, DSTH, P"Бізнеси мафії", string, "Закрити", "");
	else ShowPlayerDialog(playerid, dBizList, DSTH, P"Бізнеси мафії", string, "Далі", "Закрити");
	return 1;
}
CMD:tie(playerid,params[]) {
	new giveplayerid;
	if(sscanf(params, "d", giveplayerid)) return SendError(playerid, "Використайте: /tie [playerid]");
	if(!IsAMafia(playerid)) return SendError(playerid, "У вас немає доступу до цієї команди.");
	if(CI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 рангу.");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(TI[playerid][tTied])  return SendError(playerid, "Ви зв'язані.");
	if(TI[giveplayerid][tTied]) return SendError(playerid, "Гравець вже зв'язаний.");
	if(!IsPlayerStream(3.0, playerid, giveplayerid)) return SendError(playerid, "Гравець далеко від вас.");
	if(!IsPlayerInAnyVehicle(giveplayerid)) return SendError(playerid, "Гравець не в машині.");
	if(giveplayerid == playerid) return SendError(playerid, not_id);
	if(!IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) != 2 && !IsPlayerInVehicle(giveplayerid, GetPlayerVehicleID(playerid))) return SendError(playerid, "Гравець не в машині");
	if(QuestProgress[playerid][32] < 10 && AcceptQuest[playerid][32] != 0) QuestProgress[playerid][32] ++,save_quest(playerid, 32);
	if(QuestProgress[playerid][32] == 10 && AcceptQuest[playerid][32] != 0) {
		ShowPlayerDialog(playerid, DIALOG_NONE, DSM, "Виконання квесту.", W"Ви завершили виконання квесту 'Міцна мотузка'\n\t"NO"Квест можна завершити в списку квестів (/quest)", "Закрити", "");
	}
	TogglePlayerControllable(giveplayerid, 0);
	TI[giveplayerid][tTied] = true;
	return 1;
}
CMD:untie(playerid,params[]) {
	new giveplayerid;
	if(sscanf(params, "d", giveplayerid)) return SendClientMessage(playerid, CWHITE, "Використайте: /untie [playerid]");
	else if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	else if(!IsPlayerStream(5.0, playerid, giveplayerid)) return SendError(playerid, "Гравець далеко від вас.");
	else if(TI[playerid][tTied])  return SendError(playerid, "Ви зв'язані.");
	else if(!TI[giveplayerid][tTied]) return SendError(playerid, "Гравець не зв'язаний.");
	else if(giveplayerid == playerid)  return SendError(playerid, not_id);
	new string[128];
	format(string, sizeof(string), "%s розв'язав %s.", CI[playerid][cName], CI[giveplayerid][cName]);
	SendStreamMessage(30.0, playerid, string, 0xE75480FF);
	TogglePlayerControllable(giveplayerid, 1);
	TI[giveplayerid][tTied] = false;
	return 1;
}
CMD:giveradio(playerid,params[]) {
	new giveplayerid;
	if(!IsAMafia(playerid)) return SendError(playerid, "Ви не мафіозі.");
	if(CI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 рангу.");
	else if(sscanf(params, "d", giveplayerid))return SendError(playerid, "Використайте: /giveradio [playerid]");
	else if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	else if(!IsPlayerStream(5.0, playerid, giveplayerid)) return SendError(playerid, "Гравець далеко від вас.");
	else if(giveplayerid == playerid) return 1;
	else if(!GetPVarInt(giveplayerid, "takeradio")) return SendError(playerid, "У гравця не відбирали рацію.");
	new string[128];
	format(string, sizeof(string), "%s повернув вам рацію.", CI[playerid][cName]);
	SendClientMessage(giveplayerid, 0x6ab1ffaa, string);
	DeletePVar(giveplayerid, "takeradio");
	format(string, sizeof(string), "%s повернув рацію %s.", CI[playerid][cName], CI[giveplayerid][cName]);
	SendStreamMessage(30.0, playerid, string, 0xE75480FF);
	return 1;
}
CMD:takeradio(playerid,params[]) {
	new giveplayerid;
	if(!IsAMafia(playerid)) return SendError(playerid, "Ви не мафіозі.");
	if(CI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 рангу.");
	if(sscanf(params, "d", giveplayerid)) return SendError(playerid, "Використайте: /takeradio [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(GetPVarInt(giveplayerid, "takeradio")) return SendError(playerid, "У гравця немає рації.");
	if(!IsPlayerStream(5.0, playerid, giveplayerid)) return SendError(playerid, "Гравець далеко від вас.");
	else if(!TI[giveplayerid][tTied]) return SendError(playerid, "Гравець не зв'язаний.");
	if(giveplayerid == playerid) return SendError(playerid, not_id);
	new string[128];
	format(string, sizeof(string), "%s забрав у вас рацію.", CI[playerid][cName]);
	SendClientMessage(giveplayerid, 0x6ab1ffaa, string);
	SetPVarInt(giveplayerid, "takeradio", true);
	format(string, sizeof(string), "%s забрав рацію у %s.", CI[playerid][cName], CI[giveplayerid][cName]);
	SendStreamMessage(30.0, playerid, string, 0xE75480FF);
	return 1;
}
CMD:bag(playerid,params[]) {
	if(!IsAMafia(playerid)) return SendError(playerid, "Ви не мафіозі.");
	if(CI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 рангу.");
	if(sscanf(params, "i",params[0])) return SendError(playerid, "Використайте: /bag [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, not_id);
	if(playerid == params[0]) return SendError(playerid, not_id);
	if(GetPlayerDistanceToPlayer(playerid, params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Гравець дуже далеко.");
	if(p_mh[params[0]]==PlayerText:-1) {
		p_mh[params[0]]=CreatePlayerTextDraw(params[0], 0.0, 0.0, "|");
		PlayerTextDrawBackgroundColor(params[0],p_mh[params[0]], 255);
		PlayerTextDrawFont(params[0],p_mh[params[0]], 1);
		PlayerTextDrawLetterSize(params[0],p_mh[params[0]], 0.500000, 49.799957);
		PlayerTextDrawColor(params[0],p_mh[params[0]], -1);
		PlayerTextDrawSetOutline(params[0],p_mh[params[0]], 0);
		PlayerTextDrawSetProportional(params[0],p_mh[params[0]], 1);
		PlayerTextDrawSetShadow(params[0],p_mh[params[0]], 1);
		PlayerTextDrawUseBox(params[0],p_mh[params[0]], 1);
		PlayerTextDrawBoxColor(params[0],p_mh[params[0]], 255);
		PlayerTextDrawTextSize(params[0],p_mh[params[0]], 640.0, 0.0);
		PlayerTextDrawShow(params[0],p_mh[params[0]]);
		SendOK(playerid, "Щоб зняти мішок, введіть "P"/bag"W" ще раз.");
	} else {
		PlayerTextDrawHide(params[0],p_mh[params[0]]);
		PlayerTextDrawDestroy(params[0],p_mh[params[0]]);
	}
	return 1;
}
CMD:givephone(playerid,params[]) {
	new giveplayerid;
	if(!IsAMafia(playerid)) return SendError(playerid, "Ви не мафіозі.");
	if(CI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 рангу.");
	else if(sscanf(params, "d", giveplayerid))return SendError(playerid, "Використайте: /givephone [playerid]");
	else if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	else if(GetPlayerDistanceToPlayer(playerid, giveplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(giveplayerid)) return SendError(playerid, "Гравець дуже далеко.");
	else if(giveplayerid == playerid) return SendError(playerid, "Не можна повернути телефон самому собі.");
	else if(!GetPVarInt(giveplayerid, "takephone")) return SendError(playerid, "У гравця не відбирали телефон.");
	new string[128];
	format(string, sizeof(string), "%s повернув вам телефон.", CI[playerid][cName]);
	SendClientMessage(giveplayerid, 0x6ab1ffaa, string);
	DeletePVar(giveplayerid, "takephone");
	format(string, sizeof(string), "%s повернув телефон %s.", CI[playerid][cName], CI[giveplayerid][cName]);
	SendStreamMessage(30.0, playerid, string, 0xE75480FF);
	return 1;
}
CMD:takephone(playerid,params[]) {
	new giveplayerid;
	if(!IsAMafia(playerid)) return SendError(playerid, "Ви не мафіозі.");
	if(CI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 рангу.");
	if(sscanf(params, "d", giveplayerid))return SendError(playerid, "Використайте: /takephone [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(GetPVarInt(giveplayerid, "takephone") || !CI[giveplayerid][pPhone]) return SendError(playerid, "У гравця немає телефону.");
	else if(GetPlayerDistanceToPlayer(playerid, giveplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(giveplayerid)) return SendError(playerid, "Гравець дуже далеко.");
	else if(!TI[giveplayerid][tTied]) return SendError(playerid, "Гравець не зв'язаний.");
	if(giveplayerid == playerid) return SendError(playerid, not_id);
	new string[128];
	format(string, sizeof(string), "%s забрав у вас телефон.", CI[playerid][cName]);
	SendClientMessage(giveplayerid, 0x6ab1ffaa, string);
	SetPVarInt(giveplayerid, "takephone", true);
	format(string, sizeof(string), "%s забрав телефон у %s.", CI[playerid][cName], CI[giveplayerid][cName]);
	SendStreamMessage(30.0, playerid, string, 0xE75480FF);
	return 1;
}
CMD:gag(playerid,params[]) {
	new giveplayerid;
	if(sscanf(params, "d", giveplayerid)) return SendError(playerid, "Використайте: /gag [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(giveplayerid == playerid) return SendError(playerid, not_id);
	if(!TI[giveplayerid][tTied]) return SendError(playerid, "Гравець не зв'язаний.");
	if(TI[playerid][tTied]) return SendError(playerid, "Ви зв'язані.");
	if(GetPlayerDistanceToPlayer(playerid, giveplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(giveplayerid)) return SendError(playerid, "Гравець дуже далеко.");
	new string[128];
	if(TI[giveplayerid][tGag]) {
		TI[giveplayerid][tGag] = false;
		TI[giveplayerid][tGagTime] = 0;
		format(string, sizeof(string), "%s витягнув кляп з рота гравця %s.", CI[playerid][cName], CI[giveplayerid][cName]);
		SendStreamMessage(30.0, playerid, string, 0xE75480FF);
	} else {
		if(!IsAMafia(playerid)) return SendError(playerid, "У вас немає доступу до цієї команди.");
		if(CI[playerid][pRank] < 3) return SendError(playerid, "Доступно з 3 рангу.");
		TI[giveplayerid][tGag] = true;
		TI[giveplayerid][tGagTime] = 600;
		format(string, sizeof(string), "%s вставив кляп в рот гравцю %s.", CI[playerid][cName], CI[giveplayerid][cName]);
		SendStreamMessage(30.0, playerid, string, 0xE75480FF);
	}
	return 1;
}
CMD:zone(playerid) {
	if(!IsAGang(playerid)) return SendError(playerid, "У вас немає доступу до цієї функції.");
	new total = 0, string[128];
	for(new i = 0; i < TOTALGZ; i++) {
		if(GZInfo[i][gFrakVlad] == CI[playerid][pMember]) total++;
	}
	format(string, sizeof(string), "Території під контролем: "P"%i.",total);
	SendOK(playerid, string);
	return 1;
}
alias:zone("gmap")
CMD:dipinfo(playerid) {
	if(!IsAGang(playerid)) return SendError(playerid, "У вас немає доступу до цієї функції.");
	dialog_diplom(playerid,false);
	return 1;
}
CMD:givekey(playerid, params[]) {
	if(!CI[playerid][pMember]) return SendError(playerid, "У вас немає доступу до цієї функції.");
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendError(playerid, "Використайте: /givekey [playerid]");
	if(playerid == giveplayerid) return SendError(playerid, not_id);
	if(IsAGang(playerid)) if(CI[playerid][pRank] < 5) return SendError(playerid, "Доступно з 3 рангу.");
	if(GetPlayerDistanceToPlayer(playerid, giveplayerid) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(giveplayerid)) return SendError(playerid, "Гравець дуже далеко.");
	if(TI[giveplayerid][tEnter][CI[playerid][pMember]]) {
		TI[giveplayerid][tEnter][CI[playerid][pMember]] = false;
		SendOK(giveplayerid, "У вас забрали перепустку.");
		return 1;
	}
	if(!TI[giveplayerid][tEnter][CI[playerid][pMember]]) {
		TI[giveplayerid][tEnter][CI[playerid][pMember]] = true;
		SendOK(giveplayerid, "Вам видали перепустку.");
		return 1;
	}
	return 1;
}
CMD:air(playerid) {
	if(!IsAGang(playerid) && !IsAMafia(playerid)) return SendError(playerid, "Ви не знаходитеся в банді чи мафії.");
	if(!LastAirDrop[airTime]) return SendError(playerid, "В данний момент не проходить захоплення AirDrop.");
	EnableGPSForPlayer(playerid,LastAirDrop[airPos][0],LastAirDrop[airPos][1],LastAirDrop[airPos][2]);
	SendInfo(playerid, "Місце розташування AirDrop позначено у вашому GPS.");
	return 1;
}
CMD:gpay(playerid, params[]) {
	if(!IsAGang(playerid) || !CI[playerid][pLeader]) return SendError(playerid, "У вас немає доступу до цієї функції.");
	if(sscanf(params, "d", params[0])) return SendError(playerid, "Використайте: /gpay [amount]");
	if(params[0] < 1 || params[0] > 100000) return SendError(playerid, "Від $1 і до $100.000.");
	new num = 0;
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(CI[i][pMember] != CI[playerid][pMember] || playerid == i) continue;
		num++;
	}
	if(num == 0) return SendError(playerid, "В організації нікого немає.");
	new string[128];
	format(string, sizeof(string), "\n\n"W"Ви дійсно хочете видати премію в розмірі "GREEN"$%i"W" членам вашої банди?\n\n", params[0]*num);
	ShowPlayerDialog(playerid, D_GANG_PAY, DSM, P"Видача премії", string, "Видати", "Скасувати");
	SetPVarInt(playerid, "prem_gang_money", params[0]);
	return 1;
}
CMD:endcapture(playerid) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	for (new i = 0; i < TOTALGZ; i++) {
		if(GZInfo[i][gTime] < 1) continue;
		new string[250];
		GZInfo[i][gNapad] = CI[playerid][pMember];

		capture_kd[GZInfo[i][gFrakVlad]] = 0;
		capture_kd[GZInfo[i][gNapad]] = 0;

		capture_war[CI[playerid][pMember]] = GZInfo[i][gFrakVlad];
		GZInfo[i][gTime] = 1;

		CountOnZone[GZInfo[i][gNapad]] = 0;
		CountOnZone[GZInfo[i][gFrakVlad]] = 0;
		format(string, 112, "Капт між %s і %s було зупинено адміністратором %s.", GFrac(CI[playerid][pMember]), GFrac(GZInfo[i][gFrakVlad]), CI[playerid][cName]);
		SendClientMessageToAll(COLOR_LIGHTRED, string);
		GangZoneFlashForAll(GZInfo[i][gID], GetGangColor(GZInfo[i][gNapad]));
		GZInfo[i][ZoneOnBattle] = 0;
		break;
	}
	return 1;
}
CMD:capture(playerid) {
	if(!IsAGang(playerid)) return SendError(playerid, "У вас немає доступу до цієї функції.");
	if(CI[playerid][pRank] < 5) return SendError(playerid, "Доступно з 5 рангу.");
	if(tmphour < 10 || tmphour > 23) return SendError(playerid, "Використовувати команду можна тільки з 10:00 до 23:00");
	if(tmpminute != 0) return SendError(playerid, "Почати захопленя теріторії можна на початку наступної години.");
	if(capture_kd[CI[playerid][pMember]] != 0) return SendError(playerid, "Ваша банда воює зараз або вже воювала за останню годину.");
	if(!IsPlayerInBandOnline(CI[playerid][pMember])) return SendError(playerid, "У вашій банді повинно бути не менше двох гравців.");

	for (new i = 0; i < TOTALGZ; i++) {
		if(PlayerToKvadrat(playerid, GZInfo[i][gCoords][0], GZInfo[i][gCoords][1], GZInfo[i][gCoords][2], GZInfo[i][gCoords][3]) && GZInfo[i][gFrakVlad] != CI[playerid][pMember] && GZInfo[i][ZoneOnBattle] == 0 && capture_kd[GZInfo[i][gFrakVlad]] == 0) {
			new string[250];
			if(CI[playerid][pMember] == GZInfo[i][gFrakVlad]) return SendError(playerid, "Ви не можете захоплювати свою територію.");
			if(i == 85 && black_prods[9] > gettime()) return SendError(playerid, "У цей момент війна за чорний ринок недоступна.");
			if(capture_kd[GZInfo[i][gFrakVlad]] == 1) return SendError(playerid, "Нападаюча банда воює зараз або вже воювала за останню годину.");
			if(f_diplomacy[CI[playerid][pMember] - 15][GZInfo[i][gFrakVlad] - 15] == dip_status_alliance) return SendError(playerid, "У вас з цією бандою союз.");
			if(f_diplomacy[CI[playerid][pMember] - 15][GZInfo[i][gFrakVlad] - 15] == dip_status_neutral) return SendError(playerid, "У вас з цією бандою нейтралітет.");
			if(!IsPlayerInBandOnline(GZInfo[i][gFrakVlad])) return SendError(playerid, "Члени банди, на яку ви збираєтесь напасти, офлайн.");
	
			GZInfo[i][gNapad] = CI[playerid][pMember];

			capture_kd[GZInfo[i][gFrakVlad]] = 1;
			capture_kd[GZInfo[i][gNapad]] = 1;

			capture_war[CI[playerid][pMember]] = GZInfo[i][gFrakVlad];
			GZInfo[i][gTime] = 60 * 15;

			CountOnZone[GZInfo[i][gNapad]] = 0;
			CountOnZone[GZInfo[i][gFrakVlad]] = 0;
			format(string, 112, "%s(%s) почав захоплення терріторії банди %s.", GFrac(CI[playerid][pMember]), CI[playerid][cName], GFrac(GZInfo[i][gFrakVlad]));
			SendBand(COLOR_LIGHTRED, string);
			format(string, 144, "[A] Почався капт між бандами %s і %s.", GFrac(CI[playerid][pMember]), GFrac(GZInfo[i][gFrakVlad]));
			AdmMSG(COLOR_YELLOW, string);
			GangZoneFlashForAll(GZInfo[i][gID], GetGangColor(GZInfo[i][gNapad]));
			GZInfo[i][ZoneOnBattle] = 1;
			if(QuestProgress[playerid][22] < 5 && AcceptQuest[playerid][22] != 0) QuestProgress[playerid][22] ++,save_quest(playerid, 22);
			if(QuestProgress[playerid][22] == 5 && AcceptQuest[playerid][22] != 0) {
				ShowPlayerDialog(playerid, DIALOG_NONE, DSM, "Виконання квесту.", W"Ви закінчили виконання квесту 'Завойовник'\n\t"NO"Квест можна завершити в списку квестів (/quest)", "Закрити", "");
			}
			break;
		}
	}
	return 1;
}
CMD:famsklad(playerid, params[]) {
	new fam = CI[playerid][pFamily]-1;
	if(!CI[playerid][pFamily]) return SendError(playerid, "Ви не є членом сім'ї.");
	if(!GetString(gFamily[fam][famOwner], CI[playerid][cName])) return SendError(playerid, "У вас немає доступу до цієї команди.");
	new str[9];
	if(gFamily[fam][famskladSt] == 0) gFamily[fam][famskladSt] = 1, str = "закрив";
	else gFamily[fam][famskladSt] = 0, str = "відкрив";
	static const f_str[] = "%s[%i] %s збереження сім'ї.";
	new string[sizeof(f_str) + 1 + (-2 + MAX_PLAYER_NAME) + (-2 + 4) + (-2 + 9)];
	format(string, sizeof(string), f_str, CI[playerid][cName], playerid, str);
	FamMSG(fam+ 1, string);
	UpdateFamily(fam+ 1, "sklad_status", gFamily[fam][famskladSt]);
	return 1;
}
CMD:sellgun(playerid,params[]) {
	new gunname[22];
	if(!IsAGang(playerid)) return SendError(playerid, "Ви не бандит.");
	if(CI[playerid][pJailTime]) return SendError(playerid, "Не можна використовувати у в'язниці.");
	if(TI[playerid][tDuel] != -1) return SendError(playerid, "Не можна використовувати на дуелях.");
	if(sscanf(params, "s[18]ddu", gunname,params[0],params[1],params[2])) {
		SendClientMessage(playerid, COLOR_WHITE, "Введіть: /sellgun [weaponname] [ammo] [price] [playerid]");
		SendClientMessage(playerid, COLOR_WHITE, "Введіть: /gunlist - Назва зброї і витрата матеріалів.");
		return 1;
	}
	if(!IsPlayerConnected(params[2])) return SendError(playerid, not_id);
	if(params[1] > 50000 || params[1] < 4) return SendError(playerid, "Неправильна вартість/патронів");
	if(params[0] <= 0 || params[0] > 10000) return SendError(playerid, "За раз можна робити до 10000 патронів");
	if(strcmp(gunname, "sdpistol", true) == 0) SetPVarInt(params[2], "gunid", 23), SetPVarInt(params[2], "sell_gunmats", 1);
	else if(strcmp(gunname, "deagle", true) == 0) SetPVarInt(params[2], "gunid", 24), SetPVarInt(params[2], "sell_gunmats", 3);
	else if(strcmp(gunname, "shotgun", true) == 0) SetPVarInt(params[2], "gunid", 25), SetPVarInt(params[2], "sell_gunmats", 3);
	else if(strcmp(gunname, "smg", true) == 0) SetPVarInt(params[2], "gunid", 29), SetPVarInt(params[2], "sell_gunmats", 2);
	else if(strcmp(gunname, "ak47", true) == 0) SetPVarInt(params[2], "gunid", 30), SetPVarInt(params[2], "sell_gunmats", 3);
	else if(strcmp(gunname, "m4", true) == 0) SetPVarInt(params[2], "gunid", 31), SetPVarInt(params[2], "sell_gunmats", 3);
	else if(strcmp(gunname, "rifle", true) == 0) SetPVarInt(params[2], "gunid", 33), SetPVarInt(params[2], "sell_gunmats", 5);
	else return SendError(playerid, "Використайте: /gunlist");
	if(CI[playerid][pMats] < (GetPVarInt(playerid, "sell_gunmats")*params[0])) return SendError(playerid, "У вас недостатньо матеріалів.");
	IDGZ[playerid] = GetIDGZ(playerid);
	if(IDGZ[playerid] == -1) return SendError(playerid, "Продавати зброю можна тільки в гетто.");
	if(playerid == params[2]) {
		GivePlayerWeapon(playerid, GetPVarInt(params[2], "gunid"),params[0]);
		CI[playerid][pMats] -= (GetPVarInt(playerid, "sell_gunmats")*params[0]);
		UpdateCharacterData(playerid, "pMats", CI[playerid][pMats]);
		return 1;
	}
	if(!ProxDetectorS(5.0, playerid, params[2])) return SendError(playerid, "Гравець повинен бути поруч з вами.");
	SetPVarInt(playerid, "gunoffee",params[2]);
	SetPVarInt(params[2], "gunoffee",params[2]);
	SetPVarInt(params[2], "gunoffer", playerid);
	SetPVarInt(params[2], "gunprice",params[1]);
	SetPVarInt(params[2], "gunammo",params[0]);
	SetPVarInt(params[2], "sell_gunmats", GetPVarInt(params[2], "sell_gunmats")*params[0]);

	new string[512];
	format(string, sizeof(string), "Ви запропонували "P"%s"W" купити %s [%i] за "GREEN"$%i"W".", CI[params[2]][cName], gunname, params[0], params[1]);
	SendOK(playerid, string);
	format(string, sizeof(string), P"%s"W" запропонував вам купити %s [%i] за "GREEN"$%i"W".", CI[playerid][cName], gunname, params[0], params[1]);
	SendHint(params[2], string);
	SendHint(params[2], "Натисніть "YES"Y"BLUE" щоб погодитися, "NO"N"BLUE" для відмови.");
	return 1;
}
CMD:gunlist(playerid) {
	if(!IsAGang(playerid)) return SendError(playerid, "Ви не бандит");
	ShowPlayerDialog(playerid, DIALOG_NONE, DSTH, "Збір зброї", "Зброя\tВитрата матеріалів\nSdpistol\t1\nDeagle\t3\nShotgun\t3\nSMG\t2\nAK-47\t3\nM4A1\t3\nRifle\t5", "Закрити", "");
	return 1;
}
CMD:makegun(playerid) {
	if(!IsAMafia(playerid)) return SendError(playerid, "Ви не мафіозі");
	if(!CI[playerid][pMats]) return SendError(playerid, "У вас немає матеріалів");
	if(CI[playerid][pJailTime]) return SendError(playerid, "Не можна використовувати у в'язниці");
	if(TI[playerid][tDuel] != -1) return SendError(playerid, "Не можна використовувати на дуелях");
	new string[512];
	string = "Зброя\tБоєприпасів"W"\n";
	for(new i = 0; i < 7; i++) {
		format(string, sizeof(string), "%s%s\t%i\n", string, MakeGunData[i][mgunname], MakeGunData[i][mgunamount]);
	}
	ShowPlayerDialog(playerid, D_MAKEGUN, DSTH, "Збір зброї", string, "Обрати", "Закрити");
	return 1;
}
CMD:bmarket(playerid) {
	if(!IsAGang(playerid) || CI[playerid][pRank] < FI[CI[playerid][pMember]][sRank]) return SendError(playerid, "У вас немає доступу до цієї команди.");
	if(black_prods[0] != CI[playerid][pMember]) return SendError(playerid, "Чорний ринок контролює інша банда.");
	static const f_str[] = "Найменування\tЦіна\tСклад\n\
							Наркотики\t%i\t%i\n\
							Матеріали\t%i\t%i\n\
							Бронежилет\t%i\t%i\n\
							Військова форма\t%i\t%i\n";
	new string[sizeof(f_str) + 2 + (-2 + 5) + (-2 + 5) + (-2 + 5) + (-2 + 5) + (-2 + 5) + (-2 + 5) + (-2 + 5) + (-2 + 5)];
	format(string, sizeof(string), f_str, black_prods[5], black_prods[1], black_prods[6], black_prods[2], black_prods[7], black_prods[3], black_prods[8], black_prods[4]);
	ShowPlayerDialog(playerid, D_BLACK_MARKET, DSTH, "Чорний ринок.", string, "Обрати", "Скасувати");
	return 1;
}
CMD:fmute(playerid, params[]) {
	if(CI[playerid][pRank] < FI[CI[playerid][pMember]][sRank]) return SendError(playerid, "У вас немає доступу до цієї команди.");
	new id, time, reason[100], string[150];
	if(sscanf(params, "dds[100]", id, time, reason)) return SendError(playerid, "Використайте: /fmute [playerid] [time] [reason]");
	if(IsAIP(reason)) return 1;
	if(time < 1 || time > 60) return SendError(playerid, "Видати заглушку не можна менш, ніж на 1 хвилину, та більше ніж, на 60 хвилин.");
	if(CI[id][pMember] != CI[playerid][pMember]) return SendError(playerid, "Цей гравець не знаходиться в вашій організації.");
	if(CI[id][pLeader] > 0) return SendError(playerid, "Ви не можете видати заглушку лідеру.");
	if(CI[id][pFmute]) return SendError(playerid, "У цього гравця вже є заглушка.");
	format(string, sizeof(string), "%s заглушив гравця %s на %i хвилин. Причина: %s.", CI[playerid][cName], CI[id][cName], time, reason);
	SendFactionMessage(CI[playerid][pMember], COLOR_LIGHTRED, string);
	CI[id][pFmute] = time*60;
	UpdateCharacterData(id, "fmute", CI[id][pFmute]);
	return 1;
}
CMD:funmute(playerid, params[]) {
	if(CI[playerid][pRank] < FI[CI[playerid][pMember]][sRank]) return SendError(playerid, "У вас немає доступу до цієї команди.");
	new id, string[150];
	if(sscanf(params, "d", id)) return SendError(playerid, "Використайте: /funmute [playerid]");
	if(CI[id][pMember] != CI[playerid][pMember]) return SendError(playerid, "Цей гравець не знаходиться в вашій організації.");
	if(!CI[id][pFmute]) return SendError(playerid, "У цього гравця немає заглушки.");
	format(string, sizeof(string), "%s розглушив гравця %s.", CI[playerid][cName], CI[id][cName]);
	SendFactionMessage(CI[playerid][pMember], COLOR_LIGHTRED, string);
	CI[id][pFmute] = 0;
	UpdateCharacterData(id, "fmute", CI[id][pFmute]);
	return 1;
}
CMD:sellzone(playerid,params[]) {
	if(!CI[playerid][pLeader]) return 1;
	IDGZ[playerid] = GetIDGZ(playerid);
	new giveplayerid;
	if(IDGZ[playerid] != -1) {
		new i = IDGZ[playerid];
		if(CI[playerid][pLeader] != GZInfo[i][gFrakVlad]) return SendError(playerid, "Ви не на своїй території.");
		else if(sscanf(params, "dd", giveplayerid,params[1])) return SendError(playerid, "Використайте: /sellzone [playerid] [price]");
		else if(params[1] < 10000 || params[1] > 100000) return SendError(playerid, "Вартість повинна бути від "GREEN"$10.000"W" до "GREEN"$100.000"W".");
		else if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
		else if(!IsPlayerStream(5.0, playerid, giveplayerid)) return SendError(playerid, "Ви далеко від цього гравця.");
		else if(giveplayerid == playerid) return SendError(playerid, "Це й так ваша територія.");
		if(i == 97 || i == 93 || i == 41 || i == 0 || i == 24) return SendError(playerid, "Не можна продати спавн банди.");
		if(!CI[giveplayerid][pLeader]) return SendError(playerid, "Продаж територій доступний тільки лідерам банд.");
		new string[325];
		format(string, sizeof(string), "Ви запропонували "P"%s"W" купити територію за "ORANGE"$%i"W".", CI[giveplayerid][cName],params[1]);
		SendOK(playerid, string);
		format(string, sizeof(string), P"%s"W" запропонував вам купити територію за "ORANGE"$%i"W".", CI[playerid][cName],params[1]);
		SendHint(giveplayerid, string);
		SendHint(giveplayerid, "Натисніть "YES"Y"W" щоб погодитися, або "NO"N"W" для відмови.");
		SetPVarInt(giveplayerid, "ZoneOffer", playerid + 1);
		SetPVarInt(giveplayerid, "ZonePrice", params[1]);
		SetPVarInt(giveplayerid, "sellzone", CI[playerid][pMember]);
	}
	return 1;
}
stock TextFind(const text[],const findtext[]) return strfind(text, findtext) != -1;
stock ValidChar(mailchar) {
	if((mailchar >= 'A' && mailchar <= 'Z') || (mailchar >= 'a' && mailchar <= 'z')
			|| (mailchar >= '0' && mailchar <= '9') || (mailchar == '-') || (mailchar == '_')
			|| (mailchar == '@') || (mailchar == '.')) return 1;
	return 0;
}
stock IsValidEmail(const email[]) {
	new bool:Succes = true;
	new bool:Good;
	for(new i; i < strlen(email); i++) {
		if(email[i] == '@') {
			if(!Good) Good = true;
			else {
				Good = false;
				break;
			}
		}
		if(!ValidChar(email[i])) Succes = false;
	}
	if(!Good) Succes = false;
	if(!TextFind(email, ".ru") && !TextFind(email, ".com") && !TextFind(email, ".ua") && !TextFind(email, ".su")) Succes = false;
	if(!TextFind(email, "@")) Succes = false;
	return Succes;
}
CB:OnPlayerDonateCheck(playerid, name[]) {
	new rows;
	cache_get_row_count(rows);
	if(!rows) return SendError(playerid, "Гравця не знайдено.");
	new credits;
	cache_get_value_int(0, "donatemoney", credits);
	SetPVarInt(playerid, "check_credits", credits);
	SetPVarString(playerid, "check_name", name);
	new query[256];
	mysql_format(connects, query, sizeof(query), "SELECT * FROM freekassa_payments WHERE account = '%s' AND status = 1 ORDER BY dateComplete DESC LIMIT 0, 20;", name);
	mysql_tquery(connects, query, "unitpay_callback", "dd", playerid, 1);
	return 1;
}
CB:unitpay_callback(playerid, type) {
	switch(type) {
	case 0: {
			new rows;
			cache_get_row_count(rows);
			if(!rows) return SendError(playerid, "Історія поповнень відсутня.");
			new sum, datetime[30], str[1000];
			for(new i; i < rows; i++) {
				cache_get_value_index_int(i, 3, sum);
				cache_get_value_index(i, 6, datetime, 30);
				format(str, sizeof(str), "%s%s - %i %s\n", str, datetime, sum, (sum==1)?("UAH"):(sum<5)?("UAH"):("UAH"));
			}
			new string[1024];
			format(string, sizeof(string), "\
				"W"Стан рахунку:\t\t"GREEN"%i UAH\n\
				{3399FF}20 останніх поповнень"W"\n\n\
				%s\n\
				"ORANGE"Поповнити рахунок можна на "P"chiliad-rp.com",
			CI[playerid][pDonate], str);
			ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Інформація про поповнення.", string, "Закрити", "");
		}
	case 1: {
			new rows;
			cache_get_row_count(rows);
			new name[MAX_PLAYER_NAME];
			GetPVarString(playerid, "check_name",name, MAX_PLAYER_NAME);
			DeletePVar(playerid, "check_name");
			if(!rows) {
				new string[512];
				format(string, sizeof(string), "\
					"W"Нік:\t\t\t\t%s\n\
					"W"Стан рахунку:\t\t"GREEN"%i UAH\n\
					{AFAFAF}Історія поповнень відсутня\n",
				name, GetPVarInt(playerid, "check_credits"));
				ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Інформація про поповнення", string, "Закрити", "");
				DeletePVar(playerid, "check_credits");
				return 1;
			}
			new sum, datetime[30], str[1000];
			for(new i; i < rows; i++) {
				cache_get_value_index_int(i, 3, sum);
				cache_get_value_index(i, 6, datetime, 30);
				format(str, sizeof(str), "%s%s - %i %s\n", str, datetime, sum, (sum==1)?("UAH"):(sum<5)?("UAH"):("UAH"));
			}
			new string[1024];
			format(string, sizeof(string), "\
				"W"Нік:\t\t\t\t%s\n\
				"W"Стан рахунку:\t\t"GREEN"%i UAH\n\
				{3399FF}20 останніх поповнень"W"\n\n\
				%s",
			name, GetPVarInt(playerid, "check_credits"), str);
			ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Інформація про поповнення", string, "Закрити", "");
			DeletePVar(playerid, "check_credits");
		}
	}
	return 1;
}
