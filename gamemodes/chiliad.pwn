stock GetVehicleID () {
	new veh_id = AddStaticVehicleEx (400, -100, -100, -100, 0, 0, 0, 0);
	DestroyVehicle (veh_id);
	return veh_id;
}
stock duel_delete(id,bool:end) {
	if(id != -1) {
		foreach(new i:Player) {
			if(!TI[i][tLogin]) continue;
			if(TI[i][tDuel] != id) continue;
			if(end == false) {
				SendOK(i, "Лобі видалено, всі члени лоббі розпущені.");
				GiveMoney(i, DI[id][duel_money], "повернення внеску за дуель");
			}
			TI[i][tDuel] = -1;
			TI[i][tDuelLobby] = -1;
		}
		DI[id][duel_owner_id] = DI[id][duel_id][0] = DI[id][duel_id][1] = DI[id][duel_id][2] = DI[id][duel_id][3] = DI[id][duel_id][4] = DI[id][duel_id][5] = INVALID_PLAYER_ID;
		DI[id][duel_gun] = DI[id][duel_gun_2] = 0;
		DI[id][duel_money] = 1000;
		DI[id][duel_raund] = 1;
		DI[id][duel_type] = 0;
		DI[id][duel_map] = 0;
		DI[id][duel_health] = 100;
		DI[id][duel_armour] = 0;
		DI[id][duel_start] = false;
		DI[id][duel_create] = false;
		DI[id][duel_password] = 0;
		DI[id][duel_point_1] = DI[id][duel_point_2] = DI[id][duel_vw] = 0;
	}
}
stock duel_enter(playerid, id) {
	static const f_str[] = ""W"Найменування\t"W"Значення\n\
						"P"1."W" Творець\t%s\n\
						"P"2."W" Тип\t%s\n\
						"P"3."W" Раунди\t%i\n\
						"P"4."W" Внесок\t$%i\n\
						"P"5."W" Зброя\t%s\n\
						"P"6."W" Дод. зброя\t%s\n\
						"P"7."W" Карта\t%s\n\
						"P"8."W" Здоров'я\t%i\n\
						"P"9."W" Броня\t%i";
	new string[sizeof(f_str) + 100];
	new duel_types[3][7] = {"1 VS 1", "2 VS 2", "3 VS 3"};
	new duel_guns[5][13] = {"Desert Eagle", "Shotgun", "MP5", "AK-47", "M4"};
	new duel_guns_2[6][13] = {"Не обрано", "Desert Eagle", "Shotgun", "MP5", "AK-47", "M4"};
	new duel_maps[3][11] = {"Карта #1", "Карта #2", "Карта #3"};
	format(string, sizeof(string), f_str, CI[DI[id][duel_owner_id]][cName], duel_types[DI[id][duel_type]], DI[id][duel_raund], DI[id][duel_money], duel_guns[DI[id][duel_gun]], duel_guns_2[DI[id][duel_gun_2]], duel_maps[DI[id][duel_map]], DI[id][duel_health], DI[id][duel_armour]);
	return ShowPlayerDialog(playerid, D_DUEL_3, DSTH, P"Інформація про дуелі", string, "Увійти", "Скасувати");
}
stock duel_lobby_2(playerid, id) {
	new string[256],name[30],name_2[30],name_3[30],name_4[30];
	if(DI[id][duel_id][0] != INVALID_PLAYER_ID) format(name, sizeof(name), "1. %s\n", CI[DI[id][duel_id][0]][cName]);
	else format(name, sizeof(name), "1. ----\n");
	if(DI[id][duel_id][1] != INVALID_PLAYER_ID) format(name_2, sizeof(name_2), "2. %s\n", CI[DI[id][duel_id][1]][cName]);
	else format(name_2, sizeof(name_2), "2. ----\n");
	if(DI[id][duel_id][2] != INVALID_PLAYER_ID) format(name_3, sizeof(name_3), "1. %s\n", CI[DI[id][duel_id][2]][cName]);
	else format(name_3, sizeof(name_3), "1. ----\n");
	if(DI[id][duel_id][3] != INVALID_PLAYER_ID) format(name_4, sizeof(name_4), "2. %s\n", CI[DI[id][duel_id][3]][cName]);
	else format(name_4, sizeof(name_4), "2. ----\n");
	format(string, sizeof(string), "%s\n%s\n \n%s\n%s",name,name_2,name_3,name_4);
	ShowPlayerDialog(playerid, D_DUEL_4, DSL, P"Лобі", string, "Обрати", "Покинути");
	return 1;
}
stock duel_lobby_3(playerid, id) {
	new string[256],name[30],name_2[30],name_3[30],name_4[30],name_5[30],name_6[30];
	if(DI[id][duel_id][0] != INVALID_PLAYER_ID) format(name, sizeof(name), "1. %s\n", CI[DI[id][duel_id][0]][cName]);
	else format(name, sizeof(name), "1. ----\n");
	if(DI[id][duel_id][1] != INVALID_PLAYER_ID) format(name_2, sizeof(name_2), "2. %s\n", CI[DI[id][duel_id][1]][cName]);
