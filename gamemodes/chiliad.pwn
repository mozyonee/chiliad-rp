CMD:gethere(playerid,params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendError(playerid, "Використайте: /gethere [playerid].");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	new player_state = GetPlayerState(giveplayerid);
	if(!(1 <= player_state <= 3)) return SendError(playerid, "Гравець не вступив у гру.");
	if(PI[playerid][pAdmin] < PI[giveplayerid][pAdmin]) return SendError(playerid, "Його не можна телепортувати.");
	if(playerid == giveplayerid) return SendError(playerid, not_id);
	if(CI[giveplayerid][pJailTime] > 0) return SendError(playerid, "Гравець у в'язниці.");
	if(!TI[giveplayerid][tLogin]) return SendError(playerid, "Гравець не авторизований на сервері.");
	new Float:X, Float:Y, Float:Z, Float:A, vehicleid = GetPlayerVehicleID(giveplayerid), interior = GetPlayerInterior(playerid), virtualworld = GetPlayerVirtualWorld(playerid);
	GetPlayerPos(playerid, X, Y, Z);
	GetPlayerFacingAngle(playerid, A);
	switch(GetPlayerState(giveplayerid)) {
		case PLAYER_STATE_ONFOOT: {
			SetPlayerPosAC(giveplayerid, X,Y+ 2,Z, virtualworld, interior);
			SetPlayerFacingAngle(giveplayerid, A);
			}
		case PLAYER_STATE_DRIVER: {
			LinkVehicleToInterior(vehicleid, interior);
			SetVehicleVirtualWorld(vehicleid, virtualworld);
			SetVehiclePos(vehicleid, X, Y+ 2, Z);
			SetVehicleZAngle(vehicleid, A);
			}
		case PLAYER_STATE_PASSENGER: {
			RemovePlayerFromVehicleAC(giveplayerid);
			SetPlayerPosAC(giveplayerid, X, Y+ 2, Z, virtualworld, interior);
			SetPlayerFacingAngle(giveplayerid, A);
			}
	}
	new string[128];
	format(string, sizeof(string), "Ви були телепортовані адміністратором %s.", CI[playerid][cName], giveplayerid);
	SendOK(giveplayerid, string);
	format(string, sizeof(string), "Ви телепортували гравця %s до себе.", CI[giveplayerid][cName], giveplayerid);
	SendOK(playerid, string);
	return 1;
}
CMD:spcars(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "d", giveplayerid)) return SendError(playerid, "Використайте: /spcars [seconds]");
	if(giveplayerid < 5 || giveplayerid > 30) return SendError(playerid, "Від 5 до 30 секунд.");
	new string[64];
	format(string, sizeof(string), "Автомобілі будуть заспавнені через %i секунд.", giveplayerid);
	SendOK(playerid, string);
	SendClientMessageToAll(COLOR_RED, string);
	SetTimerEx("SpcarsAvto", giveplayerid * 1000, false, "i", playerid);
	return 1;
}
CMD:setnick(playerid,params[]) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "i", giveplayerid)) return SendError(playerid, "Використайте: /setnick [playerid]");
	new playerName[MAX_PLAYER_NAME + 1];
	GetPVarString(giveplayerid, "WantNickChange", playerName, MAX_PLAYER_NAME);
	if(!strlen(playerName)) return SendError(playerid, "Гравець не подавав завку на зміну нікнейму.");
	WriteLog(LOG_CHANGENAME, CI[playerid][cName], CI[giveplayerid][cName], playerName);
	if(GetPVarInt(giveplayerid, "changename_fix")) return 1;
	ChangeName(giveplayerid);
	new string[128];
	format(string, sizeof(string), "[A] %s[%i] дозволив зміну нікнейму гравцю %s[%i].", CI[playerid][cName], playerid, CI[giveplayerid][cName], giveplayerid);
	AdmMSG(0xAFAFAFAA, string);
	return 1;
}
CMD:freeze(playerid, params[]) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return	SendError(playerid, "Використайте: /freeze [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(PI[giveplayerid][pAdmin] > PI[playerid][pAdmin]) return SendError(playerid, "Не можна заморозити старшого за вас адміністратора.");
	TogglePlayerControllable(giveplayerid, 0);
	new string[128];
	format(string, sizeof(string), "[A] Адміністратор %s[%i] заморозив гравця %s[%i].", CI[playerid][cName], playerid, CI[giveplayerid][cName], giveplayerid);
	AdmMSG(0xAFAFAFAA, string);
	return 1;
}
CMD:unfreeze(playerid, params[]) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return	SendError(playerid, "Використайте: /unfreeze [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(PI[giveplayerid][pAdmin] > PI[playerid][pAdmin]) return SendError(playerid, "Не можна заморозити старшого за вас адміністратора.");
	TogglePlayerControllable(giveplayerid, 1);
	new string[128];
	format(string, sizeof(string), "[A] %s[%i] розморозив %s[%i].", CI[playerid][cName], playerid, CI[giveplayerid][cName], giveplayerid);
	AdmMSG(0xAFAFAFAA, string);
	return 1;
}
CMD:slap(playerid,params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendError(playerid, "Використайте: /slap [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	new Float:slx, 
	Float:sly, 
	Float:slz;
	GetPlayerPos(giveplayerid, slx, sly, slz);
	SetPlayerPosAC(giveplayerid, slx, sly, slz+5, TI[giveplayerid][tVirtualWorld], TI[giveplayerid][tInterior]);
	PlayerPlaySound(giveplayerid, 1130, slx, sly, slz+5);
	return 1;
}
CMD:markt(playerid) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new Float: MarkX, Float: MarkY, Float: MarkZ;
	GetPlayerPos(playerid, MarkX, MarkY, MarkZ);
	SetPVarFloat(playerid, "MarkX", MarkX);
	SetPVarFloat(playerid, "MarkY", MarkY);
	SetPVarFloat(playerid, "MarkZ", MarkZ);
	SetPVarInt(playerid, "MarkInt", GetPlayerInterior(playerid));
	SetPVarInt(playerid, "MarkVW", GetPlayerVirtualWorld(playerid));
	SendOK(playerid, "Позиція для телепорта збережена.");
	return 1;
}
CMD:gotomark(playerid) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(GetPlayerState(playerid) == 2) {
		new tmpcar = GetPlayerVehicleID(playerid);
		SetVehiclePos(tmpcar, GetPVarFloat(playerid, "MarkX"), GetPVarFloat(playerid, "MarkY"), GetPVarFloat(playerid, "MarkZ"));
	} else SetPlayerPosAC(playerid, GetPVarFloat(playerid, "MarkX"), GetPVarFloat(playerid, "MarkY"), GetPVarFloat(playerid, "MarkZ"), GetPVarInt(playerid, "MarkVW"), GetPVarInt(playerid, "MarkInt"));
	SendOK(playerid, "Ви телепортувались на збережену раніше позицію.");
	return 1;
}
CMD:satiety(playerid) {
	new str[150];
	format(str, sizeof(str), W"Ситність:\t"P"%i", CI[playerid][pSatiety]);
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Інформація", str, "Закрити", "");
}
CMD:hunger(playerid, params[]) {
	if(PI[playerid][pAdmin] < 2 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new hp, giveplayerid;
	if(sscanf(params, "ud", giveplayerid,hp)) return SendError(playerid, "Використайте: /hunger [playerid] [satiety]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(hp >= 101) return SendError(playerid, "Не можна давати більше 100 одиниць ситності.");
	CI[giveplayerid][pSatiety] = hp;
	UpdateCharacterData(giveplayerid, "pSatiety", CI[giveplayerid][pSatiety]);
	SetFullness(giveplayerid, CI[giveplayerid][pSatiety]);
	new string[128];
	format(string, sizeof(string), "[A] %s[%i] встановив %i відсотків ситності гравцю %s[%i].", CI[playerid][cName], playerid, hp, CI[giveplayerid][cName], giveplayerid);
	AdmMSG(0xAFAFAFAA, string);
	return 1;
}
CMD:sethp(playerid, params[]) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new hp, giveplayerid;
	if(sscanf(params, "ud", giveplayerid,hp)) return SendError(playerid, "Використайте: /sethp [playerid] [HP]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(hp < 0 || hp > 1000) return SendError(playerid, "Не можна давати менше 0 HP і більше 1000 HP.");
	SetHealth(giveplayerid, hp);
	CI[giveplayerid][pHP] = hp;
	return 1;
}
CMD:setarm(playerid, params[]) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new hp, giveplayerid;
	if(sscanf(params, "ud", giveplayerid, hp)) return SendError(playerid, "Використайте: /setarm [playerid] [armour]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(hp >= 101) return SendError(playerid, "Не можна давати більше 100 відсотків броні.");
	SetArmour(giveplayerid, hp);
	new string[128];
	format(string, sizeof(string), "[A] %s[%i] встановив %i відсотків броні гравцю %s[%i].", CI[playerid][cName], playerid, hp, CI[giveplayerid][cName], giveplayerid);
	AdmMSG(0xAFAFAFAA, string);
	return 1;
}
CMD:offstats(playerid, params[]) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new text = strlen(params);
	if(!text) return SendError(playerid, "Використайте: /offstats [playername]");
	if(text < 3 || text > 24) return SendError(playerid, "Від 3 до 24 символів.");
	new query[128];
	mysql_format(connects, query, sizeof(query), "SELECT * FROM "TABLE_CHARACTERS" WHERE `Name` = '%s' LIMIT 1", params);
	mysql_tquery(connects, query, "AGetStats", "is", playerid, params);
	return 1;
}
CMD:getid(playerid, params[]) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "d", giveplayerid)) return SendError(playerid, "Використайте: /getid [playerid]");
	new query[128];
	mysql_format(connects, query, sizeof(query), "SELECT * FROM "TABLE_CHARACTERS" WHERE `cID` = %i LIMIT 1", giveplayerid);
	mysql_tquery(connects, query, "AGetID", "ii", playerid, giveplayerid);
	return 1;
}
// 4.
CMD:awarehouse(playerid, const params[]) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new string[1024];
	for(new i = 1; i < MAX_FACTIONS; i++) {
		format(string, sizeof(string), "%s:\t\t\t%i\n", FI[i][fName], FI[i][fMaterials]);
	}
	format(string, sizeof(string), "Завод з виготовлення зброї:\t\t\t%i\n", zavodsklad);
	format(string, sizeof(string), "Лісопильня:\t\t\t%i\n", woodsklad);
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Стан складів.", string, "Закрити", "");
	return 1;
}
// 4 рівень.
CMD:skick(playerid,params[]) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new string[144], giveplayerid;
	if(sscanf(params, "u", giveplayerid)) return SendError(playerid, "Використайте: /skick [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	format(string, sizeof(string), "[A] %s[%i] кікнув без зайвого шуму гравця %s[%i].", CI[playerid][cName], playerid, CI[giveplayerid][cName], giveplayerid);
	AdmMSG(CADMIN_INFO, string);
	KickEx(giveplayerid);
	WriteLog(LOG_SKICK, CI[playerid][cName], CI[giveplayerid][cName], "SKick");
	return 1;
}
CMD:rban(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new ban_ip[16], ban_reason_ip [32];
	if(sscanf (params, "s[16]s[32]", ban_ip, ban_reason_ip)) return SendError(playerid, "Використайте: /rban [playerip] [reason]");
	if(strfind (ban_ip, "*.*", true) != -1) return SendError(playerid, "Ви ввели неправильний IP.");
	new null;
	for (new i = 0; i < strlen(ban_ip[0]); i++) {
		if(strfind(ban_ip[i], ".", true) == 0) null++;
	}
	if(null != 3) return SendError(playerid, "Неправильний IP. Приклад: 127.0.0. (Повинні бути присутніми 3 точки)");
	MYSQL_GLOBAL[0] = EOS;
	mysql_format(connects, MYSQL_GLOBAL, sizeof(MYSQL_GLOBAL), "INSERT INTO `banip` (`IP`, `admin`,`reason`) VALUES ('%s','%e','%e')", ban_ip, CI[playerid][cName], ban_reason_ip);
	mysql_tquery(connects, MYSQL_GLOBAL, "", "");
	new string[200];
	format(string, sizeof(string), "[A] %s[%i] заблокував IP %s. Причина: %s.", CI[playerid][cName], playerid, ban_ip, ban_reason_ip);
	SendAdminMessage(CADMIN_INFO, string);
	format(string, sizeof(string), "Блокування IP. Причина: %s.", ban_reason_ip);
	WriteLog(LOG_BANIP, CI[playerid][cName], ban_ip, string);
	return 1;
}
alias:rban("ipban")
CMD:unrban(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(isnull(params) || strlen(params) > 18) return SendError(playerid, "Використайте: /unrban [playerip]");
	new null;
	for (new i = 0; i < strlen(params[0]); i++) {
		if(strfind(params[i], ".", true) == 0) null++;
	}
	if(null != 3) return SendError(playerid, "Неправильний IP.");
	MYSQL_GLOBAL[0] = EOS;
	mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "DELETE FROM `banip` WHERE `IP` = '%s'", params);
	mysql_tquery(connects, MYSQL_GLOBAL, "", "");
	new string[128];
	format(string, sizeof(string), "[A] %s[%i] розблокував IP %s.", CI[playerid][cName], playerid, params);
	SendAdminMessage(CADMIN_INFO, string);
	WriteLog(LOG_UNBANIP, CI[playerid][cName], params, "розблокування IP");
	return 1;
}
CMD:offban(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new name[25], text[130], string[128], day, giveplayerid;
	if(sscanf(params, "p< >s[24]ds[128]", name, day, text)) return SendError(playerid, "Використайте: /offban [playername] [days] [reason]");
	if(day > 30 || 1 > day) return SendError(playerid, "Від 1 до 30 днів.");
	sscanf(name, "u", giveplayerid);
	if(giveplayerid != INVALID_PLAYER_ID) return SendError(playerid, "Цей гравець онлайн.");
	if(strlen(text) > 30) return SendError(playerid, "Не більше 30 символів.");
	if(!IsBannedNameReg(name)) return SendError(playerid, "Цей гравець не зареєстрований на сервері.");
	BanName(name, CI[playerid][cName], day, text);
	format(string, sizeof(string), "Адміністратор %s[%i] заблокував %s на %i днів в офлайні. Причина: %s.", CI[playerid][cName], playerid, name, day, text);
	SendAdminActionMessage(COLOR_LIGHTRED, string);
	gAdmin[playerid][ADMIN_BAN] ++;
	WriteLog(LOG_BAN, CI[playerid][cName], name, text);
	return 1;
}
CMD:ioffban(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new name[25], text[130], string[128], giveplayerid;
	if(sscanf(params, "p< >s[24]s[128]", name, text)) return SendError(playerid, "Використайте: /ioffban [playername] [reason]");
	if(!IsBannedNameReg(name)) return SendError(playerid, "Цей гравець не зареєстрований на сервері.");
	sscanf(name, "u", giveplayerid);
	if(giveplayerid != INVALID_PLAYER_ID) return SendError(playerid, "Цей гравець онлайн.");
	if(strlen(text) > 30) return SendError(playerid, "Не більше 30 символів.");
	BanName(name, CI[playerid][cName], 1000, text);
	format(string, sizeof(string), "Адміністратор %s[%i] заблокував %s в офлайні. Причина: %s.", CI[playerid][cName], playerid, name, text);
	SendAdminActionMessage(COLOR_LIGHTRED, string);
	gAdmin[playerid][ADMIN_BAN] ++;
	WriteLog(LOG_BAN, CI[playerid][cName], name, text);
	return 1;
}
CMD:offwarn(playerid, params[]) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new name[MAX_PLAYER_NAME], text[130], giveplayerid;
	if(sscanf(params, "s[24]s[64]", name, text)) return SendError(playerid, "Використайте: /offwarn [playername] [reason]");
	sscanf(name, "u", giveplayerid);
	if(giveplayerid != INVALID_PLAYER_ID) return SendError(playerid, "Цей гравець онлайн.");
	if(strlen(text) > 30) return SendError(playerid, "Не більше 30 символів.");
	MYSQL_GLOBAL[0] = EOS;
	mysql_format(connects, MYSQL_GLOBAL, sizeof (MYSQL_GLOBAL), "SELECT * FROM "TABLE_CHARACTERS" WHERE `Name` = '%e'", name);
	mysql_tquery(connects, MYSQL_GLOBAL, "offwarn", "dss", playerid, name, text);
	return 1;
}
CMD:unban(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new string[220];
	if(isnull(params) || strlen(params) > 25) return SendError(playerid, "Використайте: /unban [playername]");
	if(!IsBannedName(params)) return  SendError(playerid, "Цей гравець не заблокований.");
	mysql_escape_string(params, UnbanName[playerid], 27);
	new NAME_ADMIN[24], NAME_PLAYER[24], BAN_REASON[32], UNBAN_DATA[27];
	mysql_format(connects, string, sizeof(string), "SELECT * FROM `ban` WHERE BINARY `Name` = '%s' LIMIT 1", UnbanName[playerid]);
	new Cache:result = mysql_query(connects, string);
	new rows = cache_num_rows();
	if(rows) {
		cache_get_value_index(0, 2,NAME_PLAYER, 24);
		cache_get_value_index(0, 1,NAME_ADMIN, 24);
		cache_get_value_index(0, 3,BAN_REASON, 37);
		cache_get_value_index(0, 5,UNBAN_DATA, 27);
		format(string, sizeof(string), "\
			"W"Заблокований:\t"NO"%s\n\
			"W"Заблокував:\t"ORANGE"%s\n\
			"W"Причина:\t\t"ORANGE"%s\n\
			"W"Розблокування:\t"ORANGE"%s",
		NAME_PLAYER,NAME_ADMIN, BAN_REASON, UNBAN_DATA);
		ShowPlayerDialog(playerid, D_UNBAN, DSM, P"Інформація про заблокованого", string, "Розблокувати", "Скасувати");
	}
	cache_delete(result);
	return 1;
}
CMD:setfuel(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Ви не в машині.");
	new giveplayerid;
	if(sscanf(params, "d", giveplayerid)) return SendError(playerid, "Використайте: /setfuel [litres]");
	if(!(10 <= giveplayerid <= 150)) return SendError(playerid, "Від 10 до 150 літрів.");
	new vehid = GetPlayerVehicleID(playerid);
	new string[128];
	format(string, sizeof(string), "Ви встановили транспорту %i літрів палива.", giveplayerid);
	SendOK(playerid, string);
	VehicleInfo[vehid][vFuel] = giveplayerid;
	return 1;
}
CMD:fin(playerid,params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new i = 0;
	for(new b; b < gBusinessCount; b++) {
		if(IsPlayerInRangeOfPoint(playerid, 10.0, gBusiness[b][bizzX], gBusiness[b][bizzY], gBusiness[b][bizzZ])) {
			new query[156];
			mysql_format(connects, query, sizeof(query), "SELECT * FROM `business_stats` WHERE `bizz` = %i", b);
			mysql_tquery(connects, query, "bizz_stats", "ii", playerid, b);
			i = 1;
		}
	}
	if(i == 0) SendError(playerid, "Ви не поруч з бізнесом.");
	return 1;
}
CMD:veh(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new car, color1, color2;
	if(!sscanf(params, "iii", car, color1, color2)) {
		if(car < 400 || car > 611) return SendError(playerid, "ID транспорта від 400 до 611.");
		if(color1 && color2 && !(0 <= color1 <= 256 || 0 <= color2 <= 256)) return SendError(playerid, "ID кольору транспорта від 0 до 256.");
	} else if(!sscanf(params, "i", car)) {
		if(car < 400 || car > 611) return SendError(playerid, "ID транспорта від 400 до 611.");
		color1 = random(256);
		color2 = random(256);
	} else return SendError(playerid, "Використайте: /veh [vehid] [color] [color]");
	for(new i = GetVehiclePoolSize() + 1; --i != 0;) if(VehicleInfo[i][vType] != VEHICLE_TYPE_ADMIN) continue;
	
	new Float:X, Float:Y, Float:Z, Float:A;
	GetPlayerPos(playerid, X, Y, Z);
	GetPlayerFacingAngle(playerid, A);
	new vehicleid = A_CreateVehicle(car, X, Y, Z, A, color1, color2, -1, VEHICLE_TYPE_ADMIN);
	SetVehicleParamsEx(vehicleid, false, false, false, false, false, false, false);
	SetVehicleNumberPlate(vehicleid, "ADMIN");
	LinkVehicleToInterior(vehicleid, GetPlayerInterior(playerid));
	SetVehicleVirtualWorld(vehicleid, GetPlayerVirtualWorld(playerid));
	VehicleInfo[vehicleid][veX] = X;
	VehicleInfo[vehicleid][veY] = Y;
	VehicleInfo[vehicleid][veZ] = Z;
	VehicleInfo[vehicleid][vFuel] = gTransport[GetVehicleModel(vehicleid) -400][trTank];
	VehicleInfo[vehicleid][vAkum] = 100;
	PutPlayerInVehicle(playerid, vehicleid, 0);

	new string[90];
	format(string, sizeof(string), "[A] %s[%i] створив транспорт. (ID: %i)", PI[playerid][pName], playerid, vehicleid);
	AdmMSG(0xAFAFAFAA, string);
	SendHint(playerid, "Щоб видалити транспорт, введіть "P"/delveh"W" або "P"/alldelveh"W".");
	return 1;
}
CMD:plveh(playerid, params[]) {
	if(PI[playerid][pAdmin] < 2 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid, car, color1, color2;
	if(sscanf(params, "uiii", giveplayerid, car) && sscanf(params, "uiii", giveplayerid, car, color1, color2)) return SendError(playerid, "Використайте: /plveh [playerid] [vehid] [color] [color]");
	if(car < 400 || car > 611) return SendError(playerid, "ID транспорту повинен бути від 400 до 611.");
	if(color1 && color2 && (color1 < 0 || color1 > 255 || color2 < 0 || color2 > 255)) return SendError(playerid, "ID кольору повинен бути від 0 до 255.");
	else {
		color1 = 400 + random(211);
		color2 = 400 + random(211);
	}
	for(new i = GetVehiclePoolSize() + 1; --i != 0;) if(VehicleInfo[i][vType] != VEHICLE_TYPE_ADMIN) continue;

	new Float:X, Float:Y, Float:Z, Float:A;
	GetPlayerPos(giveplayerid, X, Y, Z);
	GetPlayerFacingAngle(giveplayerid, A);
	new vehicleid = A_CreateVehicle(car, X, Y, Z, A, color1, color2, -1, VEHICLE_TYPE_ADMIN);
	SetVehicleParamsEx(vehicleid, false, false, false, false, false, false, false);
	SetVehicleNumberPlate(vehicleid, "ADMIN");
	LinkVehicleToInterior(vehicleid, GetPlayerInterior(giveplayerid));
	VehicleInfo[vehicleid][veX] = X;
	VehicleInfo[vehicleid][veY] = Y;
	VehicleInfo[vehicleid][veZ] = Z;
	VehicleInfo[vehicleid][vFuel] = 100.0;
	VehicleInfo[vehicleid][vAkum] = 100;
	t_PutPlayerInVehicle(giveplayerid, vehicleid, 0);
	return 1;
}
CMD:delveh(playerid) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new vehicleid = GetPlayerVehicleID(playerid);
	if(VehicleInfo[vehicleid][vType] != VEHICLE_TYPE_ADMIN) return SendError(playerid, "Цей транспорт не можна видалити.");
	A_DestroyVehicle(vehicleid);
	new string[90];
	format(string, sizeof(string), "[A] %s[%i] видалив транспорт. (ID: %i)", PI[playerid][pName], playerid, vehicleid);
	AdmMSG(0xAFAFAFAA, string);
	SendOK(playerid, "Транспорт видалено.");
	return 1;
}
CMD:alldelveh(playerid) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	for(new i = GetVehiclePoolSize() + 1; --i != 0;) {
		if(VehicleInfo[i][vType] != VEHICLE_TYPE_ADMIN) continue;
		A_DestroyVehicle(i);
	}
	new string[128];
	format(string, sizeof(string), "[A] %s[%i] видалив весь створений транспорт.", PI[playerid][pName], playerid);
	AdmMSG(0xAFAFAFAA, string);
	SendOK(playerid, "Весь адмін-транспорт видалено.");
	return 1;
}
CMD:dellic(playerid) {
	for(new i; i <= 2; i++) {
		lic[playerid][i] = 0;
		SendOK(playerid, "Наявні ліцензії було скинуто.");
	}
	return 1;
}
CMD:templeader(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(sscanf(params, "i",params[0])) return SendError(playerid, "Використайте: /templeader [fractionid]");
	if(params[0] < 0 || params[0] > 19) return SendError(playerid, "Діапазон ID фракцій від 1 до 19.");
	if(params[0] == 0) {
		CI[playerid][pLeader] = params[0];
		CI[playerid][pMember] = params[0];
		CI[playerid][pRank] = 0;
		return SendInfo(playerid, "Ви вийшли з-під фракції.");
	} else {
		new string[128];
		format(string, sizeof(string), "Ви вступили у фракцію %s.", FI[params[0]][fName]);
		SendInfo(playerid, string);
		CI[playerid][pLeader] = params[0];
		CI[playerid][pMember] = params[0];
		CI[playerid][pRank] = FI[params[0]][lRank];
		UpdateCharacterData(playerid, "pMember", CI[playerid][pMember]);
		UpdateCharacterData(playerid, "pLeader", CI[playerid][pLeader]);
		UpdateCharacterData(playerid, "pRank", CI[playerid][pRank]);
		start_work[playerid] = 1;
		if(CI[playerid][pfWarn] > 0) CI[playerid][pfWarn] = 0;
		UpdateCharacterData(playerid, "fwarn", CI[playerid][pfWarn]);
		UpdateCharacterData(playerid, "FracDuty",start_work[playerid]);
		SendInfo(playerid, "Щоб вийти зі фракції, введіть "P"/templeader 0"W".");
		GiveDiscordRoleForPlayer(playerid);
	}
	return 1;
}
CMD:unwarn(playerid, params[]) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "d", giveplayerid)) return SendError(playerid, "Використайте: /unwarn [playerid]");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(CI[giveplayerid][pWarns] == 0) return SendError(playerid, "У гравця немає попереджень.");
	CI[giveplayerid][pWarns]--;
	UpdateCharacterData(giveplayerid, "pWarns", CI[giveplayerid][pWarns]);
	new string[92];
	format(string, sizeof(string), "[A] %s[%i] зняв попередження гравцю %s[%i].", CI[playerid][cName], playerid, CI[giveplayerid][cName], giveplayerid);
	AdmMSG(0xAFAFAFAA, string);
	format(string, sizeof(string), "Адміністратор %s зняв вам попередження.", CI[playerid][cName]);
	SendClientMessage(giveplayerid, CGOLD, string);

	WriteLog(LOG_UNWARN, CI[playerid][cName], CI[giveplayerid][cName], "зняв варн");
	return 1;
}
CMD:offunwarn(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new string[220], giveplayerid;
	if(isnull(params) || strlen(params) > 25) return SendError(playerid, "Використайте: /offunwarn [playerid]");
	sscanf(params, "u", giveplayerid);
	if(giveplayerid != INVALID_PLAYER_ID) return SendError(playerid, "Цей гравець онлайн.");
	mysql_format(connects, string, sizeof(string), "SELECT `pWarns` FROM "TABLE_CHARACTERS" WHERE `Name` = '%s' LIMIT 1", params);
	new warns = 0;
	new Cache: result = mysql_query(connects, string);
	new rows = cache_num_rows();
	if(rows > 0) {
		cache_get_value_int(0, "pWarns", warns);
		if(warns == 0) {
			SendError(playerid, "Варни відсутні.");
			if(cache_is_valid(result)) cache_delete(result);
			return 1;
		}
		MYSQL_GLOBAL[0] = EOS;
		mysql_format(connects, MYSQL_GLOBAL, sizeof MYSQL_GLOBAL, "UPDATE "TABLE_CHARACTERS" SET `pWarns` = %i WHERE `Name` = '%s' LIMIT 1", warns - 1, params);
		mysql_pquery(connects, MYSQL_GLOBAL);
		new str[128];
		format(str, sizeof(str), "[A] %s[%i] зняв попередження в офлайн гравцю %s.", CI[playerid][cName], playerid, params);
		AdmMSG(0xAFAFAFAA, str);

		WriteLog(LOG_WARN, CI[playerid][cName], params, "зняв варн");

		SendOK(playerid, "Ви зняли попередження.");
	}
	if(cache_is_valid(result)) cache_delete(result);
	return 1;
}
CMD:weather(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "d", giveplayerid)) return SendError(playerid, "Використайте: /weather [playerid]");
	new string[128];
	format(string, sizeof(string), "[A] %s змінив ID погоди на %i.", CI[playerid][cName], giveplayerid);
	AdmMSG(0xAFAFAFAA, string);
	SetWeather(giveplayerid);
	return 1;
}
CMD:settime(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "d", giveplayerid)) return SendError(playerid, "Використайте: /weather [playerid]");
	new string[128];
	format(string, sizeof(string), "[A] %s змінив ID погоди на %i.", CI[playerid][cName], giveplayerid);
	AdmMSG(0xAFAFAFAA, string);
	SetWorldTime(giveplayerid);
	return 1;
}
CMD:auninvite(playerid, params[]) {
	if(PI[playerid][pAdmin] < 2 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new reason[64], giveplayerid;
	if(sscanf(params, "is[128]", giveplayerid, reason)) return SendError(playerid, "Використайте: /auninvite [playerid] [reason]");
	if(strlen(reason) > 40) return SendError(playerid, "Не більше 40 символів.");
	if(giveplayerid == INVALID_PLAYER_ID) return SendError(playerid, not_id);
	if(!CI[giveplayerid][pMember]) return SendError(playerid, "Гравець не знаходиться в організації.");
	if(!strcmp(FI[CI[giveplayerid][pMember]][fLeader], CI[giveplayerid][cName], false)) return SendError(playerid, "Лідера можна зняти тільки через /factions.");
	new string[128];
	format(string, sizeof(string), "Адміністратор %s звільнив вас з організації. Причина: %s.", CI[playerid][cName], reason);
	SendError(giveplayerid, string);
	format(string, sizeof(string), "[A] %s[%i] вигнав гравця %s[%i] з фракції.", CI[playerid][cName], playerid, CI[giveplayerid][cName], giveplayerid);
	AdmMSG(0xAFAFAFAA, string);
	SetArmour(giveplayerid, 0);
	ResetPlayerWeapons(giveplayerid);
	if(start_work[giveplayerid]) {
		SendInfo(giveplayerid, "Робочий день завершено.");
		start_work[giveplayerid] = 0;
		UpdateCharacterData(giveplayerid, "FracDuty", 0);
	}
	add_jobinfo(giveplayerid, reason);

	if(IsAGang(giveplayerid) && GetPVarInt(giveplayerid, "ppkz")) EndCapt(giveplayerid);

	CI[giveplayerid][pAdvert] = 0;
	UpdateCharacterData(giveplayerid, "Advert", 0);

	CI[giveplayerid][pMember] = 0;
	CI[giveplayerid][pRank] = 0;
	CI[giveplayerid][pFracSkin] = 0;
	CI[giveplayerid][pLeader] = 0;
	CI[giveplayerid][pMedHeal] = 0;
	CI[giveplayerid][pZahvat] = 0;
	CI[giveplayerid][cRadioChannel] = 0;

	UpdateCharacterData(giveplayerid, "MedHeal", 0);
	SetPlayerColor(giveplayerid, TEAM_HIT_COLOR);
	if(CI[giveplayerid][pHouse] > 0) CI[giveplayerid][pSpawn] = 1;
	else CI[giveplayerid][pSpawn] = 0;
	UpdateCharacterData(giveplayerid, "cRadioChannel", 0);
	UpdateCharacterData(giveplayerid, "pModel", CI[giveplayerid][pFracSkin]);
	UpdateCharacterData(giveplayerid, "pMember", CI[giveplayerid][pMember]);
	UpdateCharacterData(giveplayerid, "pLeader", CI[giveplayerid][pLeader]);
	UpdateCharacterData(giveplayerid, "spawn", CI[giveplayerid][pSpawn]);
	UpdateCharacterData(giveplayerid, "pRank", CI[giveplayerid][pRank]);
	UpdateCharacterData(giveplayerid, "zahvat", CI[giveplayerid][pZahvat]);

	skin_player(giveplayerid);
	WriteLog(LOG_UVAL, CI[playerid][cName], CI[giveplayerid][cName], reason);
	//NickName(playerid);
	return 1;
}
CMD:ears(playerid) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	static const command_message[][] = {
		"Слухати SMS - ON",
		"Слухати SMS - OFF"
	};
	SendError(playerid, command_message[GetPVarInt(playerid, "BigEarSMS")]);
	SetPVarInt(playerid, "BigEarSMS", !GetPVarInt(playerid, "BigEarSMS"));
	return 1;
}
CMD:hpall(playerid,params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "d", giveplayerid)) return SendError(playerid, "Використайте: /hpall [radius]");
	if(giveplayerid < 5 || giveplayerid > 15) return SendError(playerid, "Радіус від 5 до 15 метрів.");
	new Float:pos[3];
	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(IsPlayerInRangeOfPoint(i, params[0], pos[0], pos[1], pos[2])) {
			SetHealth(i, 100);
			SendOK(i, "Адміністратор поновив вам здоров'я.");
		}
	}
	SendOK(playerid, "Всім гравцям у вказанному радіусі було поновлено здоров'я.");
	return 1;
}
CMD:spall(playerid,params[]) {
	if(PI[playerid][pAdmin] < 7 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "d", giveplayerid)) return SendError(playerid, "Використайте: /spall [radius]");
	if(giveplayerid < 5 || giveplayerid > 15) return SendError(playerid, "Радіус від 5 до 15 метрів.");
	new Float:pos[3];
	GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(IsPlayerInRangeOfPoint(i, params[0], pos[0], pos[1], pos[2])) {
			PlayerSpawn(i);
		}
	}
	SendOK(playerid, "Всі гравці у вказанному радіусі були заспавнені.");
	return 1;
}
CMD:sban(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new day,text[130], string[415], giveplayerid;
	if(sscanf(params, "uds[128]", giveplayerid,day,text)) return SendError(playerid, "Використайте: /sban [playerid] [days] [reason]");
	if(PlayerAdminFix[playerid] > gettime()) return SendError(playerid, "Можна раз в 10 секунд.");
	PlayerAdminFix[playerid] = gettime() + 10;
	if(isAdminStatus(CI[giveplayerid][cName])) return 1;
	if(!IsPlayerConnected(giveplayerid) || giveplayerid == playerid) return SendError(playerid, not_id);
	if(strlen(text)>30) return SendError(playerid, "Не більше 30 символів.");
	if(IsAIP(text)) return 1;
	if(day > 30 || 1 > day) return SendError(playerid, "Від 1 до 30 днів.");
	format(string, 144, "[A] %s[%i] тихо заблокував гравця %s на %i днів. Причина: %s.", CI[playerid][cName], playerid, CI[giveplayerid][cName],day,text);
	AdmMSG(CADMIN_INFO, string);
	new ip[17];
	GetPlayerIp(giveplayerid,ip, sizeof(ip));
	format(string, sizeof(string), "Name: %s. R-IP: %s. L-IP: %s. IP: %s.", CI[giveplayerid][cName],PI[giveplayerid][pRegIP],player_ip[giveplayerid],ip);
	AdmMSG(CADMIN_INFO, string);
	BanName(CI[giveplayerid][cName], CI[playerid][cName], day, text);
	WriteLog(LOG_SBAN, CI[playerid][cName], CI[giveplayerid][cName],text);
	gAdmin[playerid][ADMIN_BAN] ++;
	new hour, minute;
	new year, month,days;
	getdate(year, month, days);
	gettime(hour, minute);
	string = "";
	static const f_str[] = "\
			"W"Увага! Ваш акаунт був "NO"заблокований"W"\n\n\
			"W"Заблокував: "NO"%s\n\
			"W"Дні: "P"%i\n\
			"W"Дата: "P"%i-%i-%i %02d:%02d\n\
			"W"Причина: "P"%s\n\n\
			"W"Якщо ви вважаєте, що відбулась помилка, зробіть скріншот (F8) цього вікна,\n\
			інакше ваша скарга не буде прийнята.";
	format(string, sizeof(string), f_str, CI[playerid][cName], day,days, month, year,hour, minute, text);
	new str[MAX_PLAYER_NAME+ 1];
	format(str, sizeof(str), P"%s.", CI[giveplayerid][cName]);
	SPD(giveplayerid, DIALOG_NONE, DSM, str, string, "Закрити", "");
	KickEx(giveplayerid);
	return 1;
}
CMD:gun(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new gun,ammo, giveplayerid;
	if(sscanf(params, "udd", giveplayerid, gun,ammo)) return SendError(playerid, "Використайте: /gun [playerid] [weaponid] [ammo]");
	if(ammo < 1 || ammo > 9999) return SendError(playerid, "Не можна менше 1 чи більше 9999 патронів.");
	if(!IsPlayerConnected(giveplayerid)) return SendError(playerid, not_id);
	if(gun < 0 || gun > 46) return SendError(playerid, "ID зброї має бути від 0 до 46.");
	GivePlayerWeapon(giveplayerid, gun,ammo);

	static const f_str[] = "Зброю було видано гравцю %s.";
	new string[sizeof(f_str) + 1 + (-2 + MAX_PLAYER_NAME)];
	format(string, sizeof(string), f_str, CI[giveplayerid][cName]);
	SendOK(playerid, string);
	WriteLog(LOG_GUN, CI[playerid][cName], CI[giveplayerid][cName], "видача зброї");
	return 1;
}
alias:gun("givegun")

CMD:caudio(playerid, params[]) {
	if(PI[playerid][pAdmin] <= 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	for(new i; i < MAX_STREAMS; i++) {
		if(Streams[i][sStream]) continue;
		if(!(1 <= params[0] <= 300) || sscanf(params, "fs[128]", Streams[i][sRadius], Streams[i][sLink])) return SendError(playerid, "Використайте: /caudio [radius 1-300] [link 1-128]");
		new Float:X, Float:Y, Float:Z, string[128];
		GetPlayerPos(playerid, X, Y, Z);
		Streams[i][sStream] = CreateDynamicSphere(X, Y, Z, Streams[i][sRadius]);
		format(string, sizeof(string), "Ви створити аудіопотік #%i.", i + 1);
		SendOK(playerid, string);
		break;
	}
	return 1;
}	
CMD:daudio(playerid, params[]) {
	if(PI[playerid][pAdmin] <= 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new id, string[128];
	if(!(1 <= params[0] <= 50) || sscanf(params, "i", id)) return SendError(playerid, "Використайте: /daudio [streamid 1-50]");
	foreach(new i:Player) {
		if(IsPlayerInDynamicArea(i, Streams[id - 1][sStream])) StopAudioStreamForPlayer(i);
	}
	Streams[id - 1][sStream] = 0;
	Streams[id - 1][sRadius] = 0;
	strmid(Streams[id - 1][sLink], "", 0, 2);
	format(string, sizeof(string), "Ви видалили аудіопотік #%i.", id);
	SendOK(playerid, string);
	return 1;
}
// 5 рівень.
CMD:enter(playerid) {
	new Float:x, Float:y, Float:z;
	new car = GetNearestVehicle(playerid);
	GetVehiclePos(car, x, y, z);
	GetVehicleParamsEx(car,engine,lights,alarm,doors,bonnet,boot,objective);
	if(IsPlayerInRangeOfPoint(playerid, 4.5, x, y, z) && doors == 0) {
		if(GetVehicleModel(car) == 454) {
			SetPlayerPosAC(playerid, 1150.9573, -551.8545, 1122.1689, car, 2);
			SetPlayerFacingAngle(playerid, 88.9087);
			SetPlayerInterior(playerid, 2);
			SetPlayerVirtualWorld(playerid, car);
			FreezePlayerForTime(playerid, 3);
			SetCameraBehindPlayer(playerid);
			TI[playerid][tBoatEnter] = car;
			SetPVarFloat(playerid, "ex_cord_x",x);
			SetPVarFloat(playerid, "ex_cord_y",y);
			SetPVarFloat(playerid, "ex_cord_z",z);
		}
	}
	return 1;
}
CMD:kdd(playerid) {
	if(TI[playerid][tDM] == 0) return 1;
	new string[450], number = 0;
	format(string, sizeof(string), W"# Нік\t"W"Вбиств\t"W"Смертей\n");
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(number > 15) continue;
		if(TI[i][tDM] == TI[playerid][tDM]) {
			number++;
			if(playerid == i) format(string, sizeof(string), "%s{71CC71}%i. %s\t%i\t%i\n", string,number, CI[i][cName], TI[i][tDM_k], TI[i][tDM_d]);
			else format(string, sizeof(string), "%s%i. %s\t%i\t%i\n", string,number, CI[i][cName], TI[i][tDM_k], TI[i][tDM_d]);
		}
	}
	ShowPlayerDialog(playerid, DIALOG_NONE, DSTH, P"Статистика", string, "Закрити", "");
	return 1;
}
CMD:hexit(playerid) {
	if(hellow[playerid] == 0) return 1;

	SetPlayerPosAC(playerid, 1511.8196, -1663.4633, 13.3226, 0, 0);
	SetPlayerFacingAngle(playerid, 90.6334);
	ResetPlayerWeapons(playerid);
	SetCameraBehindPlayer(playerid);

	SetPlayerVirtualWorld(playerid, 0);
	SetPlayerInterior(playerid, 0);

	new freezeSeconds = 0;
	switch (GetPlayerPing(playerid)) {
	case 0 .. 49: freezeSeconds = 2;
	case 50 .. 199: freezeSeconds = 3;
	case 200 .. 499: freezeSeconds = 4;
	default: freezeSeconds = 5;
	}
	FreezePlayerForTime(playerid, freezeSeconds);

	PlayerTextDrawHide(playerid, DmArenaTextDraw[playerid]);

	hellow[playerid] = 0;
	return 1;
}
CMD:exitdm(playerid) {
	if(TI[playerid][tDM] == 0) return 1;
	SetPlayerPosAC(playerid, -1143.6364, -283.7115, 1128.3345, 2, 2);
	SetPlayerFacingAngle(playerid, 179.6827);
	FreezePlayerForTime(playerid, 2);
	ResetPlayerWeapons(playerid);
	players_dm[TI[playerid][tDM]-1]--;
	TI[playerid][tDM] = 0;
	PlayerTextDrawHide(playerid, DmArenaTextDraw[playerid]);
	SetCameraBehindPlayer(playerid);
	return 1;
}
CMD:endtune(playerid) {
	if(IsPlayerInRangeOfPoint(playerid, 15.0, -2463.8516, 2513.8286, 1014.7252)) {
		SetVehiclePos(GetPlayerVehicleID(playerid), 882.1031, -1339.8259, 13.3671);
		SetVehicleZAngle(GetPlayerVehicleID(playerid), 0.7275);
		exit_garage(GetPlayerVehicleID(playerid), 0);
	}
	return 1;
}
CMD:selltr(playerid, const params[]) {
	if(!GetPlayerVehicles(playerid)) return SendError(playerid, "Ви не маєте будинку на колесах.");
	if(!params[0]) {
		new string[156];
		format(string, sizeof(string), W"Ви хочете продати будинок на колесах за "ORANGE"$%i?\n\n"G"Для продажу будинку гравцю введіть: /selltr [playerid] [price]",TRAILER_SELL/100*50);
		ShowPlayerDialog(playerid, D_TRAILER_SELL, DSM, P"Продаж будинку", string, "Так", "Ні");
		return 1;
	}
	if(sscanf(params, "dd",params[0],params[1])) return SendError(playerid, "Використайте: /selltr [playerid] [price]");
	if(params[1] < 1 || params[1] > 5000000) return SendError(playerid, "Сума не може бути меньше $1 Не більше $5.000.000.");
	if(!IsPlayerConnected(params[0]) || playerid == params[0]) return SendError(playerid, not_id);
	if(GetPlayerDistanceToPlayer(playerid,params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Ви далеко один від одного.");
	if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
	if(GetPlayerVehicles(params[0])) return SendError(playerid, "У гравця вже є будинок на колесах.");
	new string[144];
	format(string, sizeof(string), "Ви запропонували "P"%s"W" купити ваш будинок на колесах за "GREEN"$%i.", CI[params[0]][cName], params[1]);
	SendOK(playerid, string);
	format(string, sizeof(string), P"%s"W" запропонував вам купити його будинок на колесах за "GREEN"$%i", CI[playerid][cName], params[1]);
	SendHint(params[0], string);
	SendHint(params[0], "Натисніть "YES"Y"W" щоб погодитися, або "NO"N"W" для відмови.");
	SetPVarInt(params[0], "hCarSeller", playerid + 1);
	SetPVarInt(playerid, "hCarBuyer",params[0] + 1);
	SetPVarInt(params[0], "hCarPrices",params[1]);
	GetPlayerVehicles(playerid);
	return 1;
}
CMD:trgps(playerid) {
	if(!GetPlayerVehicles(playerid)) return SendError(playerid, "Ви не маєте будинку на колесах.");
	if(GetPlayerInterior(playerid) > 0) return SendError(playerid, "Не можна використовувати у приміщенні.");
	if(GetPVarInt(playerid, "route")) return SendError(playerid, "Спочатку закінчіть роботу водія автобуса.");
	if(GetPVarInt(playerid, "WaitExam")) return SendError(playerid, "Неможливо під час сдачи экзамена.");
	if(GetPVarInt(playerid, "check_job_cleaner")) return SendError(playerid, "Неможливо під час работи мийщика доріг.");
	if(GetPVarInt(playerid, "RaceCP")) return SendError(playerid, "Неможливо використовувати в цей момент.");
	new
	player_vehicle_id = playerVehicleID[playerid],
	vehicleid = PlayerTrailer[player_vehicle_id][carVehicle];
	new Float:vehiclePos[3];
	GetVehiclePos(vehicleid, vehiclePos[0], vehiclePos[1], vehiclePos[2]);
	SendOK(playerid, "Місце розташування вашого трейлера успішно позначено у вашому GPS.");
	EnableGPSForPlayer(playerid, vehiclePos[0], vehiclePos[1], vehiclePos[2]);
	return 1;
}
CMD:trpark(playerid) {
	ParkPlayerVehicle(playerid);
	return 1;
}
alias:trpark("park")
CMD:trdate(playerid) {
	if(!GetPlayerVehicles(playerid)) return SendError(playerid, "Ви не маєте будинку на колесах.");
	new day = (PlayerTrailer[playerVehicleID[playerid]][carDay]-gettime())/86400, str[120];
	format(str, sizeof(str), W"Будинок на колесах оплачений на"P" %i днів\n\n"G"* Не забувайте оплачувати будинок на колесах у банку.", day);
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Оплата будинку на колесах", str, "Закрити", "");
	return 1;
}
CMD:bonus(playerid) {
	if(CI[playerid][pLevel] < 2) return SendError(playerid, "Використання промокоду доступне з 2 рівня.");
	ShowPlayerDialog(playerid, D_FAKE_PROMO, DSI, P"Ввести промокод", W"Введіть нижче діючий промокод:", "Прийняти", "Закрити");
	return 1;
}
CMD:createbonus(playerid) {
	if(PI[playerid][pAdmin] < 7 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	PlayerPromoText[playerid][0] = EOS;
	PlayerPromoDonate[playerid] = 0;
	PlayerPromoMoney[playerid] = 0;
	PlayerPromoCount[playerid] = 0;
	ShowPlayerDialog(playerid, D_FAKE_PROMO_CREATE, DSI, P"Створення бонус-коду", "Введіть бонус-код, який ви хочете створити", "Прийняти", "Скасувати");
	return 1;
}
CMD:endtrade(playerid) {
	if(CI[playerid][pPalatka] == 0) return 1;
	EndTrade(playerid);
	return 1;
}
CMD:gzcolor(playerid, params[]) {
	if(PI[playerid][pAdmin] < 4 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new giveplayerid;
	if(sscanf(params, "d", giveplayerid)) return SendError(playerid, "Використайте: /gzcolor [gang]");
	if(FI[giveplayerid][fType] != fGANG) return SendError(playerid, "Банда неправильно вказана.");
	for(new i = 0; i < TOTALGZ; i++) {
		if(PlayerToKvadrat(playerid, GZInfo[i][gCoords][0], GZInfo[i][gCoords][1], GZInfo[i][gCoords][2], GZInfo[i][gCoords][3])) {
			new str[250];
			mysql_format(connects, str, sizeof(str), "INSERT INTO `log_zone` (`Name`, `band_old`,`band_new`) VALUES ('%s',%i,%i)", CI[playerid][cName], GZInfo[i][gFrakVlad], giveplayerid);
			mysql_pquery(connects, str, "", "");

			new msg[350];
			format(msg, sizeof(msg), "[A] %s[%i] передав територію %s банді %s.", CI[playerid][cName], playerid, FI[GZInfo[i][gFrakVlad]][fName], FI[giveplayerid][fName]);
			AdmMSG(0xAFAFAFAA, msg);
			GZInfo[i][gFrakVlad] = giveplayerid;
			if(i == 13) {
				black_prods[0] = giveplayerid;
				black_prods[9] = gettime() + 60*60*72;
				SaveMarket();
				check_terrs();
			}
			GangZoneStopFlashForAll(GZInfo[i][gZone]);
			GangZoneHideForAll(GZInfo[i][gZone]);
			GangZoneShowForAll(GZInfo[i][gZone], GetGangZoneColor(i));

			new query[128];
			mysql_format(connects, query, sizeof(query), "UPDATE `"TABLE_GANGZONE"` SET `gang_owner` = %i WHERE `id` = %i", GZInfo[i][gFrakVlad], GZInfo[i][gID]);
			mysql_tquery(connects, query, "", "");
			return 1;
		}
	}
	return 1;
}
CMD:getdonate(playerid, params[]) {
	if(PI[playerid][pAdmin] < 6 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(isnull(params) || strlen(params) > 25) return SendError(playerid, "Використайте: /getdonate [нік]");
	new query[156];
	mysql_format(connects, query, sizeof(query), "SELECT donatemoney FROM "TABLE_CHARACTERS" WHERE Name = '%s'", params);
	mysql_tquery(connects, query, "OnPlayerDonateCheck", "is", playerid, params);
	return 1;
}
CMD:respv(playerid, params[]) {
	if(PI[playerid][pAdmin] < 3 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new Float: position[3], Float:rad;
	if(sscanf(params, "f", rad)) return SendError(playerid, "Використайте: /respv [radius]");
	if(rad > 100 || rad < 2) return SendError(playerid, "Радіус від 2 до 100");
	GetPlayerPos(playerid, position[0], position[1], position[2]);
	for(new i = GetVehiclePoolSize() + 1; --i != 0;) {
		GetVehiclePos(i,position[0],position[1],position[2]);
		if(IsPlayerInRangeOfPoint(playerid,rad,position[0],position[1],position[2])) SetVehicleToRespawn(i);
	}
	SendOK(playerid, "Автомобілі у вибраному радусі заспавнено.");
	return 1;
}
