										if(status == 2) return SendError(playerid, "Неможливо застосувати на керуючому.");
									}
									static const f_str[] = "\t%s\n\
															"P"1. "W"Змінити доступ:\n\
															\t%s- Водій\n\
															\t%s- Керуючий\n\
															"P"2. "NO"Звільнити";
									new str[sizeof(f_str) + 1 + (-2 + MAX_PLAYER_NAME) + (-2 + 40)];
									format(str, sizeof(str), f_str,names,(status == 1) ? (""P"") : (""W""),(status == 2) ? (""P"") : (""W""));
									ShowPlayerDialog(playerid, D_BIZZ_TK_MEM_2, DSL, P"працівник", str, "Далі", "Закрити");
								}
							} else SendError(playerid, "працівника не знайдено.");
							cache_delete(result);
							return 1;
						}
					}
				}
