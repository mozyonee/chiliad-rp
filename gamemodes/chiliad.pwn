stock ShowGetGun(playerid) {
	if(!CI[playerid][pMember]) return 1;
	new string[512];
	new id_str_set_gun[64];
	new team;
	if(GetPlayerInterior(playerid) == 6 && FI[CI[playerid][pMember]][fType] == fENFORCEMENT) team = CI[playerid][pMember];
	switch(GetPlayerVirtualWorld(playerid)) {
		case 6, 31, 43: {
			team = CI[playerid][pMember];
		}
	}
	if(!team) return 1;
	string = ""W"";
	for(new i = 0; i < 12; i++) {
		if(FW[i][team][fwGunID] == 0 || FW[i][team][fwGunAmmo] == 0) continue;
		if(FW[i][team][fwArmor] == 1) {
			format(id_str_set_gun, sizeof(id_str_set_gun), P"%i."W" Бронежилет\n", i + 1);
			strcat(string,id_str_set_gun);
			continue;
		}
		format(string, sizeof(string), "%s"P"%i."W" %s\t%i\n", string, i + 1, FW[i][team][fwName], FW[i][team][fwGunAmmo]);
	}
	ShowPlayerDialog(playerid, dGiveGunTD, DST, P"Зброя.", string, "Обрати", "Скасувати");
	return 1;
}
CB:AttachTrailerToVehicleEx(trailerid,vehicleid) AttachTrailerToVehicle(trailerid,vehicleid);
CB:UnCallisionForPlayer(playerid) DisableRemoteVehicleCollisions(playerid, false);
CB:OnServerRestarting() {
	SendClientMessageToAll(COLOR_REDD, "Chiliad Role Play. Restart...");
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		//save_car(i, 0), save_car(i, 1);
		SetPlayerInterior(i, 0);
		SetPlayerVirtualWorld(i, 0);
		InterpolateCameraPos(i, 1178.088012, 1204.779541, 105.671997, 2501.051269, 1285.838867, 118.900398, 5000);
		InterpolateCameraLookAt(i, 1175.603149, 1201.194458, 103.228073, 2496.586669, 1285.855346, 116.649597, 5000);
		KickEx(i);
	}
	SendRconCommand("gmx");
	printf("Auto Restart - Reloading...");
	return 1;
}
CB:promo_check(playerid, code[]) {
	new rows;
	cache_get_row_count(rows);
	if(!rows) return SendError(playerid, "Вказаний промокод не знайдено.");
	new code_money, code_skils, code_lics, used_count;
	cache_get_value_index_int(0, 1, code_money);
	cache_get_value_index_int(0, 2, code_skils);
	cache_get_value_index_int(0, 3, code_lics);
	cache_get_value_index_int(0, 5, used_count);
	SetPVarInt(playerid, "code_money_", code_money);
	SetPVarInt(playerid, "code_skills_", code_skils);
	SetPVarInt(playerid, "code_lics_", code_lics);
	SetPVarInt(playerid, "used_count_", used_count);
	new query[200];
	mysql_format(connects, query, sizeof(query), "SELECT * FROM "TABLE_PROMOCODE_USED" WHERE idacca = %i", CI[playerid][cID]);
	mysql_tquery(connects, query, "promo_check2", "ds", playerid, code);
	return 1;
}
CB:promo_check2(playerid, code[]) {
	new rows;
	cache_get_row_count(rows);
	if(rows) {
		SendError(playerid, "Ви вже використали промокод.");
		DeletePVar(playerid, "code_money_");
		DeletePVar(playerid, "code_skills_");
		DeletePVar(playerid, "code_lics_");
		DeletePVar(playerid, "used_count_");
		return 1;
	}
	new query[300];
	mysql_format(connects, query, sizeof(query), "INSERT INTO "TABLE_PROMOCODE_USED" (idacca,code) VALUE (%i,'%s')", CI[playerid][cID], code);
	mysql_tquery(connects, query, "", "");
	new code_money, used_count,code_skills, code_lics;
	code_money = GetPVarInt(playerid, "code_money_");
	code_skills = GetPVarInt(playerid, "code_skills_");
	code_lics = GetPVarInt(playerid, "code_lics_");
	used_count = GetPVarInt(playerid, "used_count_");
	SendClientMessage(playerid, 0xfF1CF46ff, "Ви активували промокод.");
	if(code_skills != 6) {
		new str2[6][13] = {"SD-Pistol", "Deagle", "Shotgun", "MP5", "AK-47", "M4"};
		new stri[200];
		format(stri, sizeof(stri), "Ви отримали повний скілл на зброю "P"%s"W".",str2[code_skills]);
		SendOK(playerid,stri);
		CI[playerid][pGunSkill][code_skills] = 100;
		save_skill(playerid);
	}
	if(code_lics != 4) {
		new str3[4][25] = {"Водіння", "Польоти", "Водний транспорт", "Зброю"};
		new stri[200];
		format(stri, sizeof(stri), "Ви отримали ліцензію на "P"%s"W".",str3[code_lics]);
		SendOK(playerid,stri);
		lic[playerid][code_lics] = 1;
		UpdateLicenses(playerid);
	}

	if(CI[playerid][pLevel] < 3) {
		CI[playerid][pMPromo] = code_money;
		UpdateCharacterData(playerid, "pMPromo", code_money);
		new str[250];
		format(str, sizeof(str), "Досягнувши 3 рівня, ви отримаєте "GREEN"$%i"W".", code_money);
		SendClientMessage(playerid, COLOR_WHITE, str);
	} else {
		GiveMoney(playerid, code_money, "промокод");
		new str[250];
		format(str, sizeof(str), "Ви отримали{AFD848} $%i"W" за активацію промокоду", code_money);
		SendClientMessage(playerid, COLOR_WHITE, str);
	}
	used_count ++;
	STRING_GLOBAL[0] = EOS;
	format(STRING_GLOBAL, 120, "UPDATE "TABLE_PROMOCODE" SET used_count = %i WHERE code = '%s'", used_count, code);
	mysql_tquery(connects, STRING_GLOBAL, "", "");
	DeletePVar(playerid, "code_money_");
	DeletePVar(playerid, "used_count_");
	return 1;
}
CB:promo_create(playerid, code[], player[]) {
	new rows;
	cache_get_row_count(rows);
	if(rows >= 150) return SendError(playerid, "Досягнуто ліміт промокодів (150 шт.)");
	new load_code[32], free_slot = -1;
	for(new i; i < rows; i++) {
		cache_get_value_index(i, 0, load_code, 32);
		if(!strcmp(load_code, code, false)) {
			free_slot = i;
			break;
		}
	}
	if(free_slot != -1) {
		SendError(playerid, "Вказаний промокод вже є в списку.");
		DeletePVar(playerid, "promoname");
		DeletePVar(playerid, "promoskills");
		DeletePVar(playerid, "promolic");
		DeletePVar(playerid, "promomoney");
		return 0;
	}
	new promodays = GetPVarInt(playerid, "promoskills");
	new promoplayers = GetPVarInt(playerid, "promolic");
	new promomoney = GetPVarInt(playerid, "promomoney");

	new query[350];
	mysql_format(connects, query, sizeof(query), "INSERT INTO "TABLE_PROMOCODE" (`code`, `money`, `skills`, `lics`, `data`, `Name`) VALUES ('%s', %i, %i, %i, %i, '%s')", code, promomoney, promodays, promoplayers, gettime() +promodays, player);
	mysql_tquery(connects, query, "", "");
	new str2[7][13] = {"SD-Pistol", "Deagle", "Shotgun", "MP5", "AK-47", "M4", "Не видавати"};
	new str3[5][20] = {"Водійські права", "Польоти", "Водний транспорт", "Зброя", "Не видавати"};
	new string[356];
	format(string, sizeof(string), W"Промокод "P"%s"W" успішно створено.\n\
		Кількість грошей: "GREEN"$%i"W"\n\
		Навички володіння зброєю: "P"%s"W"\n\
		Ліцензія: "P"%s",
	code, promomoney, str2[promodays], str3[promoplayers]);
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, "Промокод створено", string, "Закрити", "");
	DeletePVar(playerid, "promoname");
	DeletePVar(playerid, "promolic");
	DeletePVar(playerid, "promoskills");
	DeletePVar(playerid, "promomoney");
	return 1;
}
CB:punish_history(playerid) {
	new rows;
	cache_get_row_count(rows);
	if(!rows) return SendError(playerid, "Покарань не знайдено.");
	new name[32], givename[32], reason[150], datetime[40];
	new string[2500];
	strcat(string, P"Видав\t\t"P"Причина\t\t"P"Дата\n");
	for(new i; i < rows; i++) {
		cache_get_value_index(i, 1, name, 32);
