CMD:todo(playerid,params[]) {
	if(CI[playerid][pMute] > 0) return SendError(playerid, "У вас бан чата.");
	new Text_[129], Deistvie_[129];
	if(sscanf(params, "p<*>s[128]s[128]", Text_,Deistvie_)) return SendError(playerid, "Використайте: /todo [text]*[action]");
	new string[156];
	format(string, sizeof(string), "\""W"%s{E75480}\", - сказав %s, %s",Text_, CI[playerid][cName],Deistvie_);
	SendStreamMessage(15.0, playerid, string, 0xE75480FF);
	return 1;
}
CMD:an(playerid, params[]) {
	if(CI[playerid][pMute] > 0) return SendError(playerid, "У вас бан чату.");
	new mes[128];
	if(isnull(params) || strlen(params) > 100) return SendError(playerid, "Використайте: /n [text]");
	format(mes, sizeof(mes), "(( %s[%i]: %s ))", CI[playerid][cName], playerid, params);
	SetPlayerChatBubble(playerid, mes, 0xcecf9cFF, 15.0, 7000);
	return 1;
}
alias:an("ab")
CMD:n(playerid, params[]) {
	if(CI[playerid][pMute] > 0) return SendError(playerid, "У вас бан чату.");
	new mes[128];
	if(isnull(params) || strlen(params) > 100) return SendError(playerid, "Використайте: /n [text]");
	format(mes, sizeof(mes), "(( %s[%i]: %s ))", CI[playerid][cName], playerid, params);
	new len = strlen(mes), i_len = len / MAX_CHARS_PER_LINE;
	if(len % MAX_CHARS_PER_LINE) i_len ++;
	new line[MAX_CHARS_PER_LINE + 5], _:index;
	while(index < i_len) {
		strmid(line, mes, (index * MAX_CHARS_PER_LINE), (index * MAX_CHARS_PER_LINE) + MAX_CHARS_PER_LINE);
		if(i_len > 1) {
			if(!index) format(line, sizeof(line), "%s ...", line);
			else if(index > 0 && (index + 1) < i_len) format(line, sizeof(line), "... %s ...", line);
			else format(line, sizeof(line), "... %s", line);
		}
		ProxDetector(15.0, playerid, line, 0xcecf9cFF);
		index++;
	}
	// ProxDetector(15.0, playerid, mes, 0xcecf9cFF);
	return 1;
}
alias:n("b")
CMD:stats(playerid, params[]) {
	return ShowStats(playerid, playerid);
}
CMD:fight(playerid, params[]) {
	if(!TI[playerid][tGym]) return SendError(playerid, "Необхідно перевдягнутися у спортивну форму.");
	if(RingInfo[0][rgStart] == 1) return SendError(playerid, "Ринг зайнят, необхідно зачекати.");
	if(sscanf(params, "ui",params[0],params[1])) return SendError(playerid, "Використайте: /fight [playerid] [bet]");
	if(params[0] == playerid) return SendError(playerid, not_id);
	if(!TI[params[0]][tGym]) return SendError(playerid, "Гравець повинен знаходитись в спортзалі і бути одягненим в спортивну форму.");
	if(params[1] < 1000 || params[1] > 10000) return SendError(playerid, "Ставка не повинна бути менше "GREEN"$1.000"W" і більше "GREEN"$10.000"W".");
	if(CI[playerid][pCash] < params[1]) return SendError(playerid, "У вас недостатньо коштів.");
	if(CI[params[0]][pCash] < params[1]) return SendError(playerid, "У гравця недостатньо коштів.");
	new string[144];
	format(string, sizeof(string), "Ви запропонували "P"%s"W" взяти участь в бою. Ставка: "GREEN"$%i"W".", CI[params[0]][cName], params[1]);
	SendOK(playerid, string);
	format(string, sizeof(string), P"%s"W" запропонував вам взяти участь в бою. Ставка: "GREEN"$%i"W".", CI[playerid][cName], params[1]);
	SendHint(params[0], string);
	SendHint(params[0], "Натисніть "YES"Y"BLUE" щоб погодитися "NO"N"BLUE" для відмови.");
	SetPVarInt(params[0], "fight_offer", playerid + 1), SetPVarInt(params[0], "fight_price", params[1]);
	return 1;
}
CMD:showskill(playerid, params[]) {
	if(sscanf(params, "u", params[0])) return SendError(playerid, "Використайте: /showskill [playerid]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, not_id);
	if(SERIU[params[0]][sID] != INVALID_PLAYER_ID) return SendError(playerid, "Гравець дуже далеко.");
	if(GetPlayerDistanceToPlayer(playerid, params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Гравець дуже далеко.");
	if(params[0] == playerid) ShowSkill(playerid, params[0]);
	else {
		if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
		new string[144];
		format(string, sizeof(string), "Ви запропонували "P"%s"W" показати ваші навики володіння зброєю.", CI[params[0]][cName]);
		SendOK(playerid, string);
		format(string, sizeof(string), P"%s"W" хоче показати вам свої навички володіння зброєю.", CI[playerid][cName]);
		SendHint(params[0], string);
		SendHint(params[0], "Натисніть "YES"Y"W" щоб погодитися, або "NO"N"W" для відмови.");
		SetPVarInt(params[0], "skillss", playerid + 1);
	}
	return 1;
}
CMD:wanted(playerid, params[]) {
	if(!IsAnEnforcement(playerid)) return SendError(playerid, "Ви не є працівником правоохоронних органів");
	new string[400], num = 0;
	foreach(new i: Player) {
		if(CI[i][pSearch]) {
			if(num == 30) break;
			format(string, sizeof(string), "%s"W"%s(%i) - %i-й рівень розшуку\n", string, CI[i][cName], i, CI[i][pSearch]);
			num++;
		}
	}
	if(num == 0) format(string, sizeof(string), W"Список розшукуваних відсутній.");
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Список розшукуваних", string, "Закрити", "");
	return 1;
}
CMD:find(playerid, params[]) {
	if(!IsAnEnforcement(playerid)) return 1;
	if(sscanf(params, "d",params[0])) return SendError(playerid, "Використайте: /find [playerid]");
	if(params[0] == playerid) return 1;
	if(TI[params[0]][tMaskTime]) return SendError(playerid, "Гравець у масці, неможливо знайти місце розташування.");
	if(CI[params[0]][pSearch] == 0) return SendError(playerid, "Ви не можете розшукувати гравця, який не є злочинцем.");
	if(GetPlayerInterior(params[0]) > 0) return SendClientMessage(playerid, COLOR_WHITE, "Гравець знаходиться у якійсь будівлі.");
	if(!IsPlayerConnected(params[0])) return 0;
	new Float:POS[3];
	GetPlayerPos(params[0], POS[0], POS[1], POS[2]);
	EnableGPSForPlayer(playerid, POS[0], POS[1], POS[2]);
	return 1;
}
CMD:fam(playerid,params[]) {
	if(!CI[playerid][pFamily]) return SendError(playerid, "Ви не є членом сім'ї.");
	if(sscanf(params, "s[128]",params[0])) return SendError(playerid, "Використайте: /fam [text]");
	if(CI[playerid][pMute] > 0) return SendError(playerid, "У вас бан чату.");
	new fam = CI[playerid][pFamily] - 1, string[128];
	format(string, sizeof(string), "%s %s[%i]: %s", GetFamName(fam, CI[playerid][pFamRank]), CI[playerid][cName], playerid,params[0]);
	FamMSG(fam+ 1, string);
	return 1;
}
CMD:finvite(playerid,params[]) {
	if(!CI[playerid][pFamily]) return SendError(playerid, "Ви не є членом сім'ї.");
	new string[144];
	if(CI[playerid][pFamRank] < gFamily[CI[playerid][pFamily]-1][famInvRang]) {
		format(string, sizeof(string), "Ця функція доступна з %i рангу.", gFamily[CI[playerid][pFamily]-1][famInvRang]);
		SendError(playerid, string);
		return 1;
	}
	if(sscanf(params, "i",params[0])) return SendError(playerid, "Використайте: /finvite [playerid]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return SendError(playerid, not_id);
	if(CI[params[0]][pFamily]) return SendError(playerid, "Гравець є членом сім'ї.");
	if(!ProxDetectorS(3.0, playerid,params[0])) return SendError(playerid, "Ви далеко один від одного.");
	if(fam_members(CI[playerid][pFamily]) > 250) return SendError(playerid, "У сім'ї недостатньо місця.");
	if(IsBLName_fam(CI[params[0]][cID], CI[playerid][pFamily])) return SendError(playerid, "Гравець знаходиться у ЧС вашої сім'ї.");
	format(string, sizeof(string), "Ви запропонували "P"%s "W"вступити у вашу сім'ю.", CI[params[0]][cName]);
	SendOK(playerid, string);
	format(string, sizeof(string), P"%s"W" запропонував вам вступити у сім'ю "P"%s.", CI[playerid][cName], gFamily[CI[playerid][pFamily]-1][famName]);
	SendHint(params[0], string);
	SendHint(params[0], "Натисніть "YES"Y "BLUE"щоб погодитися, або"NO"N "BLUE"для відмови.");
	SetPVarInt(params[0], "family_invite", playerid + 1);
	return 1;
}
CMD:funinvite(playerid,params[]) {
	if(!CI[playerid][pFamily]) return SendError(playerid, "Ви не є членом сім'ї.");
	new string[144];
	if(CI[playerid][pFamRank] < gFamily[CI[playerid][pFamily]-1][famUninvRang]) {
		format(string, sizeof(string), "Ця функція доступна з %i рангу.", gFamily[CI[playerid][pFamily]-1][famUninvRang]);
		SendError(playerid, string);
		return 1;
	}
	if(sscanf(params, "i",params[0])) return SendError(playerid, "Використайте: /funinvite [playerid]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return SendError(playerid, not_id);
	if(CI[params[0]][pFamily] != CI[playerid][pFamily]) return SendError(playerid, "Гравець не є членом вашої сім'ї.");
	if(params[0] == playerid) return SendError(playerid, not_id);
	if(CI[playerid][pFamRank] <= CI[params[0]][pFamRank]) return SendError(playerid, "Ваш ранг недостатній.");
	//if(!ProxDetectorS(3.0, playerid,params[0])) return SendError(playerid, "Ви далеко один від одного");
	new fam = CI[playerid][pFamily]-1;
	format(string, 128, W"%s{%s} вигнав вас з сім'ї "W"%s.", CI[playerid][cName],FamilyColor[gFamily[fam][famColor]], gFamily[fam][famName]);
	SendClientMessage(params[0],FamilyColorG[gFamily[fam][famColor]], string);
	CI[params[0]][pFamily] = 0;
	UpdateCharacterData(params[0], "family", 0);
	CI[params[0]][pFamRank] = 0;
	UpdateCharacterData(params[0], "pFamRank", 0);
	format(string, 128, W"%s{%s} вигнав "W"%s{%s} з сім'ї.", CI[playerid][cName],FamilyColor[gFamily[fam][famColor]], CI[params[0]][cName],FamilyColor[gFamily[fam][famColor]]);
	FamMSG(fam+ 1, string);
	return 1;
}
CMD:foffuninvite(playerid,params[]) {
	if(!CI[playerid][pFamily]) return SendError(playerid, "Ви не є членом сім'ї.");
	new string[144],query[144], giveplayerid[24];
	if(CI[playerid][pFamRank] < gFamily[CI[playerid][pFamily]-1][famUninvRang]) {
		format(string, sizeof(string), "Ця функція доступна з %i рангу.", gFamily[CI[playerid][pFamily]-1][famUninvRang]);
		SendError(playerid, string);
		return 1;
	}
	if(sscanf(params, "s[24]", giveplayerid)) return SendError(playerid, "Використайте: /foffuninvite [playername]");
	if(IsPlayerConnected(GetPlayerID(giveplayerid))) return SendError(playerid, "Цей гравець онлайн.");
	new member,rank;
	mysql_format(connects, query, sizeof(query), "SELECT * FROM "TABLE_CHARACTERS" WHERE BINARY `Name` = '%s' LIMIT 1", giveplayerid);
	new Cache:result = mysql_query(connects, query);
	new rows = cache_num_rows();
	if(rows == 0) return SendError(playerid, "Цей гравець не є членом вашої сім'ї.");
	cache_get_value_int(0, "family", member);
	cache_get_value_int(0, "pFamRank",rank);
	if(CI[playerid][pFamily] == member) {
		new query_str[128];
		mysql_format(connects, query_str, sizeof(query_str), "UPDATE "TABLE_CHARACTERS" SET family = '0',pFamRank = '0' WHERE BINARY Name = '%s'", giveplayerid);
		mysql_tquery(connects,query_str);
	} else SendError(playerid, "Цей гравець не є членом вашої сім'ї.");
	cache_delete(result);
	format(string, 128, W"%s{%s} вигнав "W"%s{%s} з сім'ї.", CI[playerid][cName],FamilyColor[gFamily[CI[playerid][pFamily]-1][famColor]],params,FamilyColor[gFamily[CI[playerid][pFamily]-1][famColor]]);
	FamMSG(CI[playerid][pFamily], string);
	return 1;
}
CMD:frang(playerid, params[]) {
	if(!CI[playerid][pFamily]) return SendError(playerid, "Ви не є членом сім'ї.");
	new string[512];
	if(CI[playerid][pFamRank] < gFamily[CI[playerid][pFamily]-1][famGiveRang]) {
		format(string, sizeof(string), "Ця функція доступна з %i рангу.", gFamily[CI[playerid][pFamily]-1][famGiveRang]);
		SendError(playerid, string);
		return 1;
	}
	if(sscanf(params, "i",params[0])) return SendError(playerid, "Використайте: /frang [playerid]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return SendError(playerid, not_id);
	if(CI[params[0]][pFamRank] >= 8) return SendError(playerid, not_id);
	if(CI[playerid][pFamily] != CI[params[0]][pFamily]) return SendError(playerid, "Гравець не є членом вашої сім'ї.");
	if(CI[playerid][pFamRank] <= CI[params[0]][pFamRank]) return SendError(playerid, "Ваш ранг недостатній.");
	if(CI[playerid][pFamRank] == 8) {
		for(new i = 1; i <= 8; i++) {
			if(i>= CI[playerid][pFamRank]) break;
			format(string, sizeof(string), "%s%s%s (%i)\n", string,(CI[params[0]][pFamRank] == i) ? (""P"") : (""), GetFamName(CI[playerid][pFamily]-1,i),i);
			ShowPlayerDialog(playerid, D_FAM_RANK, DSL, P"Оберіть ранг", string, "Обрати", "Закрити");
		}
		SetPVarInt(playerid, "id_fgiverank",params[0]);
	} else if(CI[playerid][pFamRank] == 8-(8-CI[playerid][pFamRank])) {
		for(new i = 1; i <= 8; i++) {
			if(i>= CI[playerid][pFamRank]) break;
			format(string, sizeof(string), "%s%s%s (%i)\n", string,(CI[params[0]][pFamRank] == i) ? (""P"") : (""), GetFamName(CI[playerid][pFamily]-1,i),i);
			ShowPlayerDialog(playerid, D_FAM_RANK, DSL, P"Оберіть ранг", string, "Обрати", "Закрити");
		}
		SetPVarInt(playerid, "id_fgiverank",params[0]);
	}
	return 1;
}
CMD:fmembers(playerid) { 
	if(!CI[playerid][pFamily]) return SendError(playerid, "Ви не є членом сім'ї.");
	new string[700], str[700];
	strcat(str, W"Ім'я:\t"W"Рівень:\t"W"Ранг:\n");
	strcat(string, str);
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(CI[playerid][pFamily] == CI[i][pFamily]) {
			format(str, sizeof(str), P"%i."W" %s\t%i\t%s\n",i, CI[i][cName], CI[i][pLevel], GetFamName(CI[playerid][pFamily]-1, CI[i][pFamRank]));
			strcat(string, str);
		}
	}
	ShowPlayerDialog(playerid, D_FAMILY_INFO, DSTH, P"Члени сім'ї онлайн", string, "Назад", "");
	return 1;
}
CMD:famspcar(playerid) {
	if(CI[playerid][pFamRank] < gFamily[CI[playerid][pFamily]-1][famSpawnCar]) {
		new string[76];
		format(string, sizeof(string), "Ця функція доступна з %i рангу.", gFamily[CI[playerid][pFamily]-1][famSpawnCar]);
		SendError(playerid, string);
		return 1;
	}
	new fam = CI[playerid][pFamily]-1;
	for(new i = 0; i < 5; i++) {
		if(!IsValidVehicle(CarFamily[fam][i][LoadCar])) continue;
		if(CarFamily[fam][i][LoadCar] == INVALID_VEHICLE_ID) continue;
		if(IsVehicleOccupied(CarFamily[fam][i][LoadCar])) continue;
		SetVehicleToRespawn(CarFamily[fam][i][LoadCar]);
	}
	new string[128];
	format(string, sizeof(string), "%s %s[%i] заспавнив незайнятий транспорт.", GetFamName(fam, CI[playerid][pFamRank]), CI[playerid][cName], playerid);
	FamMSG(fam+ 1, string);
	return 1;
}
forward LoadSettings();
public LoadSettings() {
    new time = GetTickCount();
    new rows = cache_num_rows();
	new string[128];
    if(!rows) return print("[Error] Settings weren't found in DB.");
    cache_get_value_name(0, "ServerName", BDserverName);
    format(string, sizeof(string), "hostname %s", BDserverName);
    SendRconCommand(string);
    cache_get_value_name(0, "ServerPassword", BDserverPassword);
	cache_get_value_name_int(0, "DonateX", DonateX);
	cache_get_value_name_int(0, "PayDayX", PayDayX);
    if(strlen(BDserverPassword) != 0) {
        format(string, sizeof(string), "password %s", BDserverPassword);
        SendRconCommand(string);
    }
    printf("[Success] Settings successfully loaded. (%i ms.)", GetTickCount() - time);
	return 1;
}
forward LoadMapping();
public LoadMapping() {
	new stringer[144];
    new time = GetTickCount();
    new rows = cache_num_rows();
    if(!rows) return print("[Error] Maps weren't found in DB.");
    new obje, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz,objectid,bdid;
    for(new i = 0; i < rows; i++) {
        cache_get_value_name_int(i, "id", bdid);
        cache_get_value_name_float(i, "x", x);
        cache_get_value_name_float(i, "y", y);
        cache_get_value_name_float(i, "z", z);
        cache_get_value_name_float(i, "rx", rx);
        cache_get_value_name_float(i, "ry", ry);
        cache_get_value_name_float(i, "rz", rz);
        cache_get_value_name_int(i, "objectid", objectid);
        obje = CreateDynamicObject(objectid, x, y, z, rx, ry, rz, -1, -1, -1, 300.0);
        mysql_format(connects, stringer, 144, "UPDATE `bmap` SET `ingameid` = %i WHERE `id` = %i LIMIT 1", obje,bdid);
        mysql_tquery(connects, stringer);
    }
    printf("[Success] Maps successfully loaded. (%i ms.)", GetTickCount() - time);
    return 1;
}
CMD:fampark(playerid) {
	if(!CI[playerid][pFamily]) return SendError(playerid, "Ви не є членом сім'ї.");
	new fam = CI[playerid][pFamily]-1;
	if(strcmp(gFamily[fam][famOwner], CI[playerid][cName],true)) return SendError(playerid, "Доступно лише власнику сім'ї.");
	if(!gFamily[fam][famHouse]) return SendError(playerid, "У вашої сім'ї немає будинку.");
	if(!IsPlayerInRangeOfPoint(playerid, 30.0, gHouses[gFamily[fam][famHouse]-1][houseX], gHouses[gFamily[fam][famHouse]-1][houseY], gHouses[gFamily[fam][famHouse]-1][houseZ])) {
		SendError(playerid, "Ви повинні бути поруч з сімейним будинком.");
		return 1;
	}
	new id = -1;
	new Float:check_pos[3];
	for(new i = 0; i < 5; i++) {
		if(CarFamily[fam][i][LoadCar] == INVALID_VEHICLE_ID) continue;
		GetVehiclePos(CarFamily[fam][i][LoadCar], check_pos[0], check_pos[1], check_pos[2]);
		if(IsPlayerInRangeOfPoint(playerid, 2.5,check_pos[0],check_pos[1],check_pos[2])) {
			if(GetPlayerVehicleID(playerid) != CarFamily[fam][i][LoadCar]) return SendError(playerid, "Ви повинні знаходитися у сімейному транспорті.");
			SendClientMessage(playerid, COLOR_ORANGE, "Транспорт успішно припарковано.");
			save_fcar(fam, i);
			return 1;
		}
	}
	if(id == -1) return SendError(playerid, "Ви повинні знаходитися у сімейному транспорті.");
	return 1;
}
CMD:fmenu(playerid) {
	if(!CI[playerid][pFamily]) return SendError(playerid, "Ви не є членом сім'ї.");
	family_dialog(playerid);
	return 1;
}
CMD:radio(playerid) {
	new string[128];
	format(string, sizeof(string), "Канал\t%i\nПідканал\t%i", CI[playerid][cRadioChannel], CI[playerid][cRadioSlot]);
	ShowPlayerDialog(playerid, D_RADIO_SETTINGS, DST, P"|"W" Рація.", string, "Обрати", "Закрити");
	return 1;
}
CMD:ad(playerid, params[]) {
	if(!CI[playerid][pPhone]) return SendError(playerid, "У вас немає телефону або SIM-карти.");
	if(gAdvertCount >= MAX_ADVERT_COUNT) return SendError(playerid, "На жаль, черга на оголошення зайнята, спробуйте пізніше.");
	if(GetPVarInt(playerid, #pAdvertTime) > gettime()) return SendError(playerid, "Не можна посилати більше одного оголошення в хвилину.");
	if(isnull(params) || strlen(params) > 90) return SendError(playerid, "Використайте: /ad [text]");
	SetPVarString(playerid, "advert",params);
	new price = strlen(params) * advertise_price;
	SetPVarInt(playerid, "ad_price",price);

	static const f_str[] = ""W"Вартість оголошення: "GREEN"$%i\n"W"Ви дійсно хочете відправити оголошення?";
	new string[sizeof(f_str) + 1 + (-2 + 6)];

	format(string, sizeof(string), f_str, price);
	ShowPlayerDialog(playerid, D_ADVERT_START, DSM, P"Оголошення.", string, "Так", "Ні");
	return 1;
}
CMD:audience(playerid, params[]) {
	new radioall = 0, points[3], string[900], ratingLS = 0, procLS = 0;
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(CI[i][pSettings][2] == CI[playerid][pMember]) ratingLS++, radioall++;
	}
	if(!radioall) return SendError(playerid, "Ніхто не подключений до радіостанції.");
	procLS = 100 / radioall * ratingLS;
	points[0] = 100 - procLS;
	format(string, sizeof(string), W"%s:\t["P"%s"W"] %i%% ("P"%i"W") людей.", FI[CI[playerid][pMember]][fName], ToDevelopSkills(procLS, points[0]), procLS, ratingLS);
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Рейтинг слухачів.", string, "Закрити", "");
	return 1;
}
CMD:edit(playerid) {
	if(!IsAMedia(playerid) || !start_work[playerid]) return SendError(playerid, "Ви не працівник новинного видання.");
	if(!start_work[playerid]) return SendError(playerid, "Необхідно розпочати робочий день.");
	if(CI[playerid][pMute] > 0) return SendError(playerid, "У вас бан чата.");
	if(CI[playerid][pRank] < 2) return SendError(playerid, "Доступно з 2 рангу.");
	new veh = GetPlayerVehicleID(playerid);
	if(!IsPlayerInRangeOfPoint(playerid, 10.0, 2823.2854, 1067.2120, 1052.5973) && !IsPlayerInRangeOfPoint(playerid, 10.0, 2842.2258, 1068.7367, 1052.5673) && FI[VehicleInfo[veh][vTeam]][fType] == fMEDIA) return SendError(playerid, "Необхідно знаходитись на робочому місці у службовому автомобілі.");
	ShowAdvertList(playerid);
	return 1;
}
CMD:adv(playerid) {
	if(!IsAMedia(playerid) || !start_work[playerid]) return SendError(playerid, "Ви не працівник новинного видання.");
	if(!start_work[playerid]) return SendError(playerid, "Необхідно розпочати робочий день.");
	new str[150];
	format(str, sizeof(str), W"Всього відредаговано оголошень:"O" %i", CI[playerid][pAdvert]);
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, " ", str, "Закрити", "");
	return 1;
}
CMD:top(playerid) {
	ShowPlayerDialog(playerid, D_TOP_PLAYERS, DSL, P"Рейтинг працівників.", P"1."W" Найактивніші гравці\n"P"2."W" Найбагатші гравці", "Обрати", "Закрити");
}
CMD:topmed(playerid) {
	if(!IsAMedic(playerid) || !start_work[playerid]) return SendError(playerid, "Ви не є лікарем.");
	new query[128], string[200], name[24], MedHeal = 0;
	mysql_format(connects, query, sizeof(query), "SELECT `Name`, `MedHeal` FROM "TABLE_CHARACTERS" WHERE `pMember` = %i ORDER BY `MedHeal ` DESC LIMIT 5", CI[playerid][pMember]);
	new Cache:result = mysql_query(connects, query);
	new rows;
	cache_get_row_count(rows);
	if(!rows) return ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Рейтинг працівників.", W"Список працівників пустий", "Закрити", "");
	if(rows) {
		for(new i; i < rows; i ++) {
			cache_get_value_name(i, "Name", name, MAX_PLAYER_NAME);
			cache_get_value_name_int(i, "MedHeal", MedHeal);
			if(MedHeal > 0) format(string, sizeof(string), "%s%i. %s ["P"%i"W" виліковано]\n", string, i + 1, name, MedHeal);
		}
		cache_delete(result);
		ShowPlayerDialog(playerid, DIALOG_NONE, DSL, P"Рейтинг працівників.", string, "Закрити", "");
	}
	return 1;
}
CMD:topnews(playerid) {
	if(!IsAMedia(playerid) || !start_work[playerid]) return SendError(playerid, "Ви не є працівником новинного видання.");
	new query[128], string[400], name[24], advert;
	mysql_format(connects, query, sizeof(query), "SELECT `Name`, `Advert` FROM "TABLE_CHARACTERS" WHERE `pMember` = %i ORDER BY `Advert` DESC LIMIT 10", CI[playerid][pMember]);
	new Cache:result = mysql_query(connects, query);
	new rows, count = 0;
	cache_get_row_count(rows);
	if(rows) {
		for(new i; i < rows; i ++) {
			cache_get_value_name(i, "Name", name, MAX_PLAYER_NAME);
			cache_get_value_name_int(i, "Advert",advert);
			if(advert > 0) count++, format(string, sizeof(string), "%s%i. %s ["P"%i"W" оголошення]\n", string, i + 1, name, advert);
		}
		cache_delete(result);
		ShowPlayerDialog(playerid, DIALOG_NONE, DSL, P"Рейтинг працівників.", string, "Закрити", "");
	}
	if(!count) return ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Рейтинг працівників.", W"Список співробітників пустий", "Закрити", "");
	return 1;
}
CMD:ether(playerid) {
	if(!IsAMedia(playerid) || !start_work[playerid]) return SendError(playerid, "Ви не працівник новинного видання.");
	if(CI[playerid][pRank] < 5) return SendError(playerid, "Доступно з 5 рангу.");
	new veh = GetPlayerVehicleID(playerid);
	if(FI[VehicleInfo[veh][vTeam]][fType] == fMEDIA) {
		if(!TI[playerid][tEther]) {
			TI[playerid][tEther] = true;
			SendOK(playerid, "Ви у прямому ефіру.");
			CI[playerid][pSettings][2] = CI[playerid][pMember];
			save_settings(playerid);
		} else {
			TI[playerid][tEther] = false;
			SendOK(playerid, "Ви вийшли з прямого ефіру.");
		}
	} else if(IsPlayerInRangeOfPoint(playerid, 10.0, 2823.2854, 1067.2120, 1052.5973)) {
		new str[10];
		switch(TI[playerid][tEther]) {
		case 0: str = "Почати";
		case 1: str = "Завершити";
		}
		new string[128];
		format(string, sizeof(string), P"1."W" %s прямий ефір\n"P"2."W" Прийом дзвінків", str);
		ShowPlayerDialog(playerid, D_NEWS, DSL, P"Меню ефіру", string, "Далі", "Скасувати");
	} else SendError(playerid, "Ви не в офісі або службовому автомобілі.");
	return 1;
}
CMD:skip(playerid) {
	if(!IsAMedia(playerid) || !start_work[playerid]) return SendError(playerid, "Ви не працівник новинного видання.");
	if(calls_ether[0] == INVALID_PLAYER_ID) return SendError(playerid, "Нікого немає на лінії.");
	SendError(calls_ether[0], "Ви були від'єднані ведучим.");
	PhoneStatus(calls_ether[0], false);
	TI[calls_ether[0]][tPhoneNews] = true;
	calls_ether[0] = INVALID_PLAYER_ID;
	SendError(playerid, "Гравець від'єднаний.");
	return 1;
}
stock buyacces(playerid) {
	new string[512];
	format(string, sizeof(string), "%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s",acces_name_all[0],acces_name_all[1],acces_name_all[2],acces_name_all[3],acces_name_all[4],acces_name_all[5],acces_name_all[6],acces_name_all[7],acces_name_all[8],acces_name_all[9],acces_name_all[10],acces_name_all[11]);
	ShowPlayerDialog(playerid, D_BUYACS, DSL, P"Купівля аксесуарів", string, "Обрати", "Скасувати");
	return 1;
}
CMD:sellfish(playerid) {
	if(!IsPlayerInRangeOfPoint(playerid, 7.0, -396.4070, -413.7928, 16.0442)) return SendError(playerid, "Ви не біля склада для продажу риби.");
	if(!CI[playerid][pFish]) return SendError(playerid, "У вас немає риби.");
	new string[128];
	format(string, sizeof(string), "Ви успішно продали "P"%.1f"W" кг. риби за "GREEN"$%i.", CI[playerid][pFish], floatround(CI[playerid][pFish])*150);
	SendOK(playerid, string);
	fish_sklad += CI[playerid][pFish];
	GiveMoney(playerid, floatround(CI[playerid][pFish])*150, "Продаж риби");
	CI[playerid][pFish] = 0;
	new query[200];
	mysql_format(connects, query, sizeof(query), "UPDATE "TABLE_CHARACTERS" SET `pfish`= '0' WHERE `Name` = '%s' LIMIT 1", CI[playerid][cName]);
	mysql_tquery(connects, query);
	return 1;
}
CMD:fish(playerid) {
	if(!GetPVarInt(playerid, "fish_place")) return 1;
	new place = GetPVarInt(playerid, "fish_place") -1;
	if(!PlayerToKvadrat(playerid, fish_place[place][0], fish_place[place][1], fish_place[place][2], fish_place[place][3])) return SendError(playerid, "Ви не в точці для ловлі риби.");
	if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Не можна ловити рибу за кермом човна.");
	if(fishing[playerid] == true) return SendError(playerid, "Ви вже ловите рибу.");
	if(CI[playerid][pRod] == 0) return SendError(playerid, "У вас немає вудочки.");
	if(CI[playerid][pRopes] == 0) return SendError(playerid, "У вас немає снастей для вудочки.");
	if(CI[playerid][pWorms] == 0) return SendError(playerid, "У вас немає наживки на вудочку.");
	SetPlayerArmedWeapon(playerid, 0);
	if(!IsPlayerAttachedObjectSlotUsed(playerid, 7)) SetPlayerAttachedObject(playerid, 7, 18632, 6, 0.079376, 0.037070, 0.007706, 181.482910, 0.0, 0.0, 1.0, 1.0, 1.0);
	TogglePlayerControllable(playerid, false);
	ApplyAnimation(playerid, "SWORD", "SWORD_3", 4.1, 0, 1, 1, 1, 0, 1);
	fishing[playerid] = true;
	static const f_str[] = "Доступно червів: %i.";
	new string[sizeof(f_str) + 1 + (-2 + 4)];
	format(string, sizeof(string), f_str, CI[playerid][pWorms]);
	SendOK(playerid, string);
	JobTempProcess[playerid] = 7;
	TI[playerid][tProcess][0] = 0;
	TI[playerid][tProcess][1] = 10;
	PlayerTextDrawColor(playerid, YandNsysTDPlayer[playerid][1], -1);
	for(new YN = 0;YN < 3;YN++) {
		TextDrawShowForPlayer(playerid, YandNsysTD[YN]);
		if(YN < 2) PlayerTextDrawShow(playerid,YandNsysTDPlayer[playerid][YN]);
	}
	RandomYareNforJOBS(playerid);
	return 1;
}
CMD:search(playerid) {
	if(!PlayerToKvadrat(playerid, -809, -2057.5, -706, -1873.5)) return SendError(playerid, "Ви не в зоні для пошуку!");
	if(fishing[playerid] == true) return SendError(playerid, "Ви вже шукаєте предмети.");
	if(CI[playerid][pMag] == 0) return SendError(playerid, "У вас немає магніту.");
	if(CI[playerid][pRope] == 0) return SendError(playerid, "У вас немає мотузки");
	SetPlayerArmedWeapon(playerid, 0);
	//if(!IsPlayerAttachedObjectSlotUsed(playerid, 7)) SetPlayerAttachedObject(playerid, 7, 18632, 6, 0.079376, 0.037070, 0.007706, 181.482910, 0.0, 0.0, 1.0, 1.0, 1.0);
	TogglePlayerControllable(playerid, false);
	ApplyAnimation(playerid, "SWORD", "SWORD_3", 4.1, 0, 1, 1, 1, 0, 1);
	Poisk[playerid] = true;
	JobTempProcess[playerid] = 10;
	TI[playerid][tProcess][0] = 0;
	TI[playerid][tProcess][1] = 10;
	PlayerTextDrawColor(playerid, YandNsysTDPlayer[playerid][1], -1);
	for(new YN = 0;YN < 3;YN++) {
		TextDrawShowForPlayer(playerid, YandNsysTD[YN]);
		if(YN < 2) PlayerTextDrawShow(playerid,YandNsysTDPlayer[playerid][YN]);
	}
	RandomYareNforJOBS(playerid);
	return 1;
}
CB:poisk_player(playerid) {
	new rand_fish = random(80);
	TogglePlayerControllable(playerid, true);
	ClearAnims(playerid);
	Poisk[playerid] = false;
	switch(rand_fish) {
		case 0..10: AddItem(playerid, 464, 1); // Цвяхи
		case 11..19: AddItem(playerid, 465, 1); // метал
		case 20..28: AddItem(playerid, 466, 1); // метал.ящик
		case 29..35: AddItem(playerid, 467, 1); // Ящик з патронівами
		case 36..42: AddItem(playerid, 468, 1); // Ножик
		case 43..48: AddItem(playerid, 469, 1); // Військова гвинтівка
		case 49..53: AddItem(playerid, 470, 1); // Японський меч
		case 54..57: AddItem(playerid, 471, 1); // Боєголовка
		case 58..60: AddItem(playerid, 472, 1); // Кейс
		case 61..62: AddItem(playerid, 473, 1); // Старинна монета
		case 63..70: {
			SendError(playerid, "Магніт відірвався.");
			CI[playerid][pMag] --;
			UpdateCharacterData(playerid, "pMag", CI[playerid][pMag]);
		}
		case 71..80: {
				SendError(playerid, "Мотузка порвалась.");
				CI[playerid][pRope] --;
				UpdateCharacterData(playerid, "pRope", CI[playerid][pRope]);
		}
		default: SendError(playerid, "Ви нічого не витягли.");
	}
	return 1;
}
CB:fish_player(playerid) {
	new rand_fish = random(sizeof(fishName) + 3);
	new string[150];
	TogglePlayerControllable(playerid, true);
	RemovePlayerAttachedObject(playerid, 7);
	ClearAnims(playerid);
	fishing[playerid] = false;
	switch(rand_fish) {
	case 0..7: {
			if(CI[playerid][pExpJob][2] < 800) {
				CI[playerid][pExpJob][2] += 1;
				if(CI[playerid][pExpJob][2] == 800) {
					CI[playerid][pAcsJob][2] = 1;
					SendOK(playerid, "Ви отримали новий аксесуар за досягнення. (/mn > Навички персонажу > Отримання аксесуарів)");
					save_acsjob(playerid);
				}
				save_jskill(playerid);
			}
			if(QuestProgress[playerid][46] < 10 && AcceptQuest[playerid][46] != 0) QuestProgress[playerid][46] ++,save_quest(playerid, 46);
			if(QuestProgress[playerid][46] == 10 && AcceptQuest[playerid][46] != 0) {
				ShowPlayerDialog(playerid, DIALOG_NONE, DSM, "Виконання квесту.", W"Ви завершили виконання щоденного квесту\n\t"NO"Квест можна завершити в "P"/quest"NO".", "Закрити", "");
			}
			new str[12];
			format(str, sizeof(str), "%i.%i",Random(1, 5), Random(1, 98+ 1));
			new Float:fish_massa = floatstr(str);
			CI[playerid][pFish] += fish_massa;
			format(string, sizeof(string), "Ви спіймали рибу - "P"%s"W" вагою у "P"%.1f"G" кг", fishName[rand_fish], fish_massa);
			SendOK(playerid, string);
			new query[200];
			mysql_format(connects, query, sizeof(query), "UPDATE "TABLE_CHARACTERS" SET `pfish`= '%f' WHERE `Name` = '%s' LIMIT 1", CI[playerid][pFish], CI[playerid][cName]);
			mysql_tquery(connects, query);
			CI[playerid][pWorms] --;
			UpdateCharacterData(playerid, "pWorms", CI[playerid][pWorms]);
		}
	case 8..9: {
			SendOK(playerid, "Риба зірвалася");
			CI[playerid][pWorms] --;
			UpdateCharacterData(playerid, "pWorms", CI[playerid][pWorms]);
		}
	default: SendOK(playerid, "Ви нічого не спіймали. Наживка залишилась цілою.");
	}
	return 1;
}
stock GetNearestTrunckFuel(playerid) {
	for(new i = 0;i<gBusinessCount;i++) {
		if(gBusiness[i][bizzType] != 7) continue;
		if(IsPlayerInRangeOfPoint(playerid, 10.0, gBusiness[i][bizzX], gBusiness[i][bizzY], gBusiness[i][bizzZ])) return i;
	}
	return -1;
}
CMD:fill(playerid) {
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return SendError(playerid, "Ви не за кермом.");
	new i = GetNearestTrunckFuel(playerid);
	if(i == -1) return 1;
	new vehicleid = GetPlayerVehicleID(playerid);
	new modelid = GetVehicleModel(vehicleid) - 400;
	if(!gTransport[modelid][trFuelable]) return SendError(playerid, "Ваше транспорт не має бензобаку.");
	GetVehicleParamsEx(vehicleid, engine, lights, alarm, doors, bonnet, boot, objective);
	if(GetEngineStat(vehicleid)) return SendError(playerid, "Перш ніж заправитись, заглушіть двигун.");
	if(GetPVarInt(playerid, "tank_vfuel")) return SendError(playerid, "Ви вже заправляете автомобіль.");
	if(gBusiness[i][bizzProduct] <= 0) return SendError(playerid, "На заправці немає палива.");
	static const f_str[] = "\n"W"Вкажіть, на скільки літрів ви хочете заправити ваш транспорт:\n\nДоступно літрів в баці: "P"%.0f"W"\nМісткість бака: "P"%i"W"\nМожна заправити на: "P"%.0fл"W"\nВартість 1л: "GREEN"$%i\n";
	new string[sizeof(f_str) + 1 + 30];
	format(string, sizeof(string), f_str, VehicleInfo[vehicleid][vFuel], gTransport[modelid][trTank], gTransport[modelid][trTank]-VehicleInfo[vehicleid][vFuel], gBusiness[i][bizzPrice]);
	ShowPlayerDialog(playerid, D_FUEL, DSI, P"Заправка.", string, "Заправить", "Скасувати");
	SetPVarInt(playerid, "azs_id",i);
	return 1;
}
CMD:buyfuel(playerid) {
	if(GetInvent(playerid, 454) + 1 >= 50) return SendError(playerid, "Ваш інвентар повний, звільніть місце");
	new i = GetNearestTrunckFuel(playerid);
	if(i == -1) return SendError(playerid, "Ви повинні бути на АЗС.");
	static const f_str[] = ""W"Ви збираєтеся купити канистру вартістю: "GREEN"$%i"W"\nЗ її допомогою ви можете заправити свій транспорт на "P"10 літрів"W"\n\n\
						Ви дійсно хочете купити каністру?";
	new string[sizeof(f_str) + 1 + (-2 + 5)];
	format(string, sizeof(string), f_str, gBusiness[i][bizzPrice]*10);
	ShowPlayerDialog(playerid, D_BUY_FUEL, DSM, P"Купівля каністри.", string, "Так", "Ні");
	return 1;
}
CMD:fillcar(playerid) {
	if(!IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Необхідно знаходитись у транспорт.");
	new car = GetPlayerVehicleID(playerid);
	if(!GetInvent(playerid, 454)) return SendError(playerid, "У вас немає каністри з бензином.");
	if(GetEngineStat(car)) return SendError(playerid, "Перш ніж заправитися, заглушіть двигун.");
	if(VehicleInfo[car][vFuel]+ 10 > gTransport[GetVehicleModel(car) - 400][trTank]) return SendError(playerid, "В автомобілі, яку ви хочете заправити, достатньо палива.");
	SendOK(playerid, "Ви дозаправили свій автомобіль 10 літрами бензину.");
	VehicleInfo[car][vFuel] += 10;
	DeleteItem(playerid, 454, 1);
	return 1;
}
CMD:buyint(playerid) {
	if(!CI[playerid][pHouse]) return SendError(playerid, "Ви не маєте будинку.");
	if(GetPVarInt(playerid, "buy_interior") > 0) {
		new string[128];
		format(string, sizeof(string), "\n\n"W"Ви дійсно хочете придбати цей інтер'єр за "GREEN"$%i?\n\n", 150000);
		return ShowPlayerDialog(playerid, D_HOUSE_BUYINT_2, DSM, P"Купівля інтер'єра", string, "Купити", "Скасувати");
	}
	return 1;
}
CMD:hhealme(playerid) {
	new hint = gHouses[CI[playerid][pHouse]-1][houseHint];
	new Float:x, Float:y, Float:z;
	x = hinterior_info[hint][h_pos_exit][0];
	y = hinterior_info[hint][h_pos_exit][1];
	z = hinterior_info[hint][h_pos_exit][2];
	if(!IsPlayerInRangeOfPoint(playerid, 30.0, x, y, z) && GetPlayerVirtualWorld(playerid) != CI[playerid][pHouse]) return SendError(playerid, "Необхідно знаходитись у своєму будинку.");
	new houseid = CI[playerid][pHouse]-1;
	if(!gHouses[houseid][houseHealth]) return SendError(playerid, "У сейфі будинку немає аптечок.");
	new Float:health;
	GetPlayerHealth(playerid, health);
	if(health + 60 < 160) health += 60.0;
	else health = 160;
	SetHealth(playerid, health);
	SetPlayerChatBubble(playerid, "+60 HP", COLOR_YELLOW, 20.0, 10000);
	ApplyAnimation(playerid, "ped", "gum_eat", 4.0, 0, 0, 0, 0, 0, 1);
	gHouses[houseid][houseHealth] -= 1;
	new query[128];
	mysql_format(connects, query, sizeof(query), "UPDATE `houses` SET `medkit` = %i WHERE id = %i", gHouses[houseid][houseHealth],houseid+ 1);
	mysql_tquery(connects, query);
	new string[60];
	format(string, sizeof(string), "Доступно аптечок у будинку: %i", gHouses[houseid][houseHealth]);
	SendOK(playerid, string);
	return 1;
}
CMD:safe(playerid) {
	if(CI[playerid][pFamily]) {
		new fam = CI[playerid][pFamily]-1;
		if(gFamily[fam][famHouse]) {
			if(gHouses[gFamily[fam][famHouse]-1][houseFamily] == gFamily[fam][famHouse]) {
				if(gFamily[CI[playerid][pFamily]-1][famSklad] > CI[playerid][pFamRank]) return SendError(playerid, "Ваш ранг недостатній");
				new houseid = TI[playerid][tSelectHouse];
				new mes[1024];
				format(mes, sizeof(mes), P"1."W" Наркотики "P"[%i г.]\n"P"2."W" Аптечки "P"[%i шт.]\n"P"3."W" Гроші "P"[$%i]\n"P"4."W" Sniper Rifle "P"[%i пт.]\n"P"5."W" Country Rifle "P"[%i пт.]\n"P"6."W" M4 "P"[%i пт.]\n"P"7."W" AK-47 "P"[%i пт.]\n"P"8."W" MP5 "P"[%i пт.]\n"P"9."W" Shotgun "P"[%i пт.]\n"P"10."W" Desert Eagle "P"[%i пт.]\n"P"11."W" SD Pistol "P"[%i пт.]\n"P"12."W" Baseball Bat "P"[%i шт.]", gHouses[houseid][houseDrugs], gHouses[houseid][houseHealth], gHouses[houseid][houseSafeMoney], gHouses[houseid][houseGun][0], gHouses[houseid][houseGun][1], gHouses[houseid][houseGun][2], gHouses[houseid][houseGun][3], gHouses[houseid][houseGun][4], gHouses[houseid][houseGun][5], gHouses[houseid][houseGun][6], gHouses[houseid][houseGun][7], gHouses[houseid][houseGun][8]);
				ShowPlayerDialog(playerid,dSafeAction, DSL, "Сейф", mes, "Далі", "Скасувати");
				return 1;
			}
		}
	}
	if(!CI[playerid][pHouse]) return 1;
	new hint = gHouses[CI[playerid][pHouse]-1][houseHint];
	new Float:x, Float:y, Float:z;
	x = hinterior_info[hint][h_pos_exit][0];
	y = hinterior_info[hint][h_pos_exit][1];
	z = hinterior_info[hint][h_pos_exit][2];
	if(!IsPlayerInRangeOfPoint(playerid, 30.0, x, y, z) && GetPlayerVirtualWorld(playerid) != CI[playerid][pHouse]) return SendError(playerid, "Необхідно знаходитися у своєму будинку");
	new houseid = CI[playerid][pHouse]-1;
	new mes[1024];
	format(mes, sizeof(mes), P"1."W" Наркотики "P"[%i г.]\n"P"2."W" Аптечки "P"[%i шт.]\n"P"3."W" Гроші "P"[$%i]\n"P"4."W" Sniper Rifle "P"[%i пт.]\n"P"5."W" Country Rifle "P"[%i пт.]\n"P"6."W" M4 "P"[%i пт.]\n"P"7."W" AK-47 "P"[%i пт.]\n"P"8."W" MP5 "P"[%i пт.]\n"P"9."W" Shotgun "P"[%i пт.]\n"P"10."W" Desert Eagle "P"[%i пт.]\n"P"11."W" SD Pistol "P"[%i пт.]\n"P"12."W" Baseball Bat "P"[%i шт.]", gHouses[houseid][houseDrugs], gHouses[houseid][houseHealth], gHouses[houseid][houseSafeMoney], gHouses[houseid][houseGun][0], gHouses[houseid][houseGun][1], gHouses[houseid][houseGun][2], gHouses[houseid][houseGun][3], gHouses[houseid][houseGun][4], gHouses[houseid][houseGun][5], gHouses[houseid][houseGun][6], gHouses[houseid][houseGun][7], gHouses[houseid][houseGun][8]);
	ShowPlayerDialog(playerid,dSafeAction, DSL, "Сейф", mes, "Далі", "Скасувати");
	return 1;
}
CMD:hgps(playerid) {
	if(!CI[playerid][pHouse]) return SendError(playerid, "Ви не маєте будинку.");
	if(GetPlayerInterior(playerid) > 0) return SendError(playerid, "Не можна скористатись функцією у приміщенні.");
	if(GetPVarInt(playerid, "route")) return SendError(playerid, "Спочатку завершіть роботу водія автобуса.");
	if(GetPVarInt(playerid, "WaitExam")) return SendError(playerid, "Неможливо під час здачі екзамену.");
	if(GetPVarInt(playerid, "check_job_cleaner")) return SendError(playerid, "Неможливо скористатись функцією, працюючи мийщиком доріг.");
	if(GetPVarInt(playerid, "RaceCP")) return SendError(playerid, "Неможливо скористатись функцією у цей момент.");
	new houseid = CI[playerid][pHouse]-1;
	EnableGPSForPlayer(playerid, gHouses[houseid][houseX], gHouses[houseid][houseY], gHouses[houseid][houseZ]);
	SendOK(playerid, "Місцезнаходження вашого будинку відмічено в GPS.");
	return 1;
}
CMD:house(playerid) {
	if(CI[playerid][pTempKey] > 0) {
		ShowPlayerDialog(playerid, dRentMenu, DSL, P"Панель жильця", "Виселитися з будинку\nДоставити транспорт", "Обрати", "Закрити");
		return 1;
	}
	if(!CI[playerid][pHouse]) return SendError(playerid, "Ви не маєте будинку.");
	new hint = gHouses[CI[playerid][pHouse]][houseHint];
	new Float:x, Float:y, Float:z;
	x = hinterior_info[hint][h_pos_exit][0];
	y = hinterior_info[hint][h_pos_exit][1];
	z = hinterior_info[hint][h_pos_exit][2];
	if(!IsPlayerInRangeOfPoint(playerid, 30.0, x, y, z) && GetPlayerVirtualWorld(playerid) != CI[playerid][pHouse]) return SendError(playerid, "Ви повинні знаходитися у своєму будинку.");
	SetPVarInt(playerid, "Hpanel:HId", CI[playerid][pHouse]-1);

	new status[24];
	if(!gHouses[CI[playerid][pHouse]-1][houseClose]) status = "Закрити";
	else status = "Відкрити";
	static const f_str[] = ""P"1."W" %s будинок.\n"P"2."W" Інформація про будинок.\n"P"3."W" Покращення.\n"P"4."W" Жильці.\n"P"5."W" Сейф.\n"P"6."W" Продати домашній транспорт.\n"P"7."W" Купівля інтер'єру.\n"P"8."W" Продати будинок.";
	new string[sizeof(f_str) + 1 + (-2 + 24)];
	format(string, sizeof(string), f_str,status);
	return ShowPlayerDialog(playerid, D_HOUSE_MENU, 2, P"Керування будинком.", string, "Обрати", "Скасувати");
}
alias:house("home")
CMD:exit(playerid) {
	if(TI[playerid][tInHouse]) {
		new houseid = TI[playerid][tSelectHouse];
		new hint = gHouses[houseid][houseHint];
		new Float:x, Float:y, Float:z;
		x = hinterior_info[hint][h_pos_exit][0];
		y = hinterior_info[hint][h_pos_exit][1];
		z = hinterior_info[hint][h_pos_exit][2];
		if(IsPlayerInRangeOfPoint(playerid, 2.0, x, y, z)) {
			if(gHouses[houseid][houseImprove][2]) {
				ShowPlayerDialog(playerid, D_HOUSE_EXIT, DSL, P"Вихід", P"1."W" На вулицю\n"P"2."W" В гараж", "Обрати", "Скасувати");
			}
			if(gHouses[houseid][houseImprove][3]) {
				ShowPlayerDialog(playerid, D_HOUSE_EXIT, DSL, P"Вихід", P"1."W" На вулицю\n"P"2."W" В гараж\n"P"3."W" В підвал", "Обрати", "Скасувати");
			}
			if(gHouses[houseid][houseImprove][2] == 0) {
				switch(houseid) {
				case 425..434: FreezePlayerForTime(playerid, 2);
				}
				TI[playerid][tTPpick] = true;
				SetPlayerPosAC(playerid, gHouses[houseid][houseX], gHouses[houseid][houseY], gHouses[houseid][houseZ], 0, 0);
				SetPlayerFacingAngle(playerid, gHouses[houseid][houseR]);
				TI[playerid][tInHouse] = false;
				TI[playerid][tSelectHouse] = 0;
				SetCameraBehindPlayer(playerid);
			}
		}
	}
	return 1;
}
CMD:sellhouse(playerid,const params[]) {
	if(!CI[playerid][pHouse]) return SendError(playerid, "Ви не маєте будинку.");
	if(CI[playerid][pCredit]) return SendError(playerid, "Продаж транспорт заборонений, поки у вас є непогашені кредити.");
	new houseid = CI[playerid][pHouse]-1;
	if(!gHouses[houseid][houseOwner]) return SendError(playerid, "Ви не власник будинку.");
	if(!GetString(CI[playerid][cName], gHouses[houseid][houseOwner])) return SendError(playerid, "Ви не власник будинку.");
	if(!IsPlayerInRangeOfPoint(playerid, 4.0, gHouses[houseid][houseX], gHouses[houseid][houseY], gHouses[houseid][houseZ])) return SendError(playerid, "Необхідно знаходитись поруч зі своїм будинком.");
	if(!params[0]) {
		new procent = floatround(( gHouses[houseid][housePrice]/100)* Nalog[0]);
		new sum = (gHouses[houseid][housePrice]-procent);
		new string[156];
		format(string, sizeof(string), W"Ви хочете продати будинок державі за "ORANGE"$%i?\n\n"G"Для продажу будинку гравцю введіть: /sellhouse [playerid] [price]",sum);
		ShowPlayerDialog(playerid, D_HOUSE_SELL, DSM, P"Продаж будинку", string, "Так", "Ні");
		return 1;
	}
	if(sscanf(params, "dd",params[0],params[1])) return SendError(playerid, "Використайте: /sellhouse [playerid] [price]");
	new price,price2;
	price = gHouses[houseid][housePrice];
	price2 = gHouses[houseid][housePrice]*10;
	if(params[1] < price || params[1] > price2) {
		static const f_str[] = "Вартість за будинок не може бути менше $%i і більше $%i.";
		new string[sizeof(f_str) + 1 + (-2 + 7) + (-2 + 10)];
		format(string, sizeof(string), f_str,price,price2);
		SendError(playerid, string);
		return 1;
	}
	if(!IsPlayerConnected(params[0]) || playerid == params[0]) return SendError(playerid, not_id);
	if(GetPlayerDistanceToPlayer(playerid,params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Ви далеко один від одного.");
	if(CI[params[0]][pHouse]) return SendError(playerid, "У гравця вже є дім.");
	if(CI[params[0]][pRoom]) return SendError(playerid, "У гравця вже є квартира.");
	if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
	new string[144];
	format(string, sizeof(string), P"%s"W" запропонував вам купити його будинок за "GREEN"$%i.", CI[playerid][cName], params[1]);
	SendHint(params[0], string);
	SendHint(params[0], "Натисніть "YES"Y"W" щоб погодитися, або "NO"N"W" для відмови.");
	format(string, sizeof(string), "Ви запропонували "P"%s"W" купити ваш будинок за "GREEN"$%i.", CI[params[0]][cName], params[1]);
	SendOK(playerid, string);
	SetPVarInt(params[0], "houseSeller", playerid + 1);
	SetPVarInt(playerid, "houseBuyer",params[0] + 1);
	SetPVarInt(params[0], "housePrices",params[1]);
	SetPVarInt(params[0], "houseIDs",houseid);
	return 1;
}
CMD:ml(playerid) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	SetPlayerPosAC(playerid, 1726.5120, -1643.1844, 20.2256, 18, 18);
	SetPlayerFacingAngle(playerid, 178.6821);
	SetPlayerInterior(playerid, 18);
	SetPlayerVirtualWorld(playerid, 18);
	SetCameraBehindPlayer(playerid);
	return 1;
}
