					case 0: {
							static const f_str[] = "\n\n"W"Ви справді хочете почати роботу в "P"яблуневому саду?\n"W"Вартість збору яблук з 1 дерева сягає "GREEN"$%i\n\n";
							new string[sizeof(f_str) + 1 + (-2 + 6)];
