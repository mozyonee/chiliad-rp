public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ) {
	if(hittype > 4) return 0;
	if(
			(hittype == BULLET_HIT_TYPE_PLAYER && ! IsPlayerConnected(hitid)) ||
			(hittype == BULLET_HIT_TYPE_VEHICLE && !IsValidVehicle(hitid)) ||
			(hittype == BULLET_HIT_TYPE_OBJECT && !IsValidVehicle(hitid)) ||
			(hittype == BULLET_HIT_TYPE_PLAYER_OBJECT && !IsValidPlayerObject(playerid, hitid))
			) return 0;
	if(hittype == BULLET_HIT_TYPE_PLAYER && hitid != 0xFFFF) {
		static
		Float: fOriginX, Float: fOriginY, Float: fOriginZ,
		Float: fHitPosX, Float: fHitPosY, Float: fHitPosZ;
		GetPlayerLastShotVectors(playerid, fOriginX, fOriginY, fOriginZ, fHitPosX, fHitPosY, fHitPosZ);

		new string[90], Float: PosIgnore, Float: PosPlayerZ;
		GetPlayerPos(playerid, PosIgnore, PosIgnore, PosPlayerZ);
		if(fOriginZ == fHitPosZ) {
			if(PlayerWarningTimeSilent[playerid][0] < gettime()) {
				format(string, sizeof(string), "<< Warning >> %s[%i]: підозра на Silent Aim", CI[playerid][cName], playerid);
				SendAdminMessage(0xFF0000FF, string);
				PlayerWarningTimeSilent[playerid][0] = gettime() + 5;
				return 0;
			}
		}
		new Float:ReasonCheat = floatsub(PosPlayerZ, fHitPosZ);
		if(floatabs(ReasonCheat) < 0.03) {
			if(++PlayerWarningSilent[playerid] >= 3) {
				if(PlayerWarningTimeSilent[playerid][1] < gettime()) {
					format(string, sizeof(string), "<< Warning >> %s[%i]: підозра на Silent Aim v12+", CI[playerid][cName], playerid);
					SendAdminMessage(0xFF0000FF, string);
					PlayerWarningTimeSilent[playerid][1] = gettime() + 5;
					return 0;
				}
			}
		} else PlayerWarningSilent[playerid] = 0;
	}
	return 1;
}
public OnPlayerInteriorChange(playerid, newinteriorid, oldinteriorid) {
	if(newinteriorid == 0) {
		Streamer_VisibleItems(STREAMER_TYPE_OBJECT, 900, playerid);
		SetPlayerTime(playerid, tmphour, tmpminute);
	} else {
		SetPlayerTime(playerid, 12, 00);
		Streamer_VisibleItems(STREAMER_TYPE_OBJECT, 990, playerid);
	}
	return 1;
}
public OnPlayerCommandReceived(playerid, cmd[], params[], flags) {
	if(TI[playerid][tDialog]) {
		SendError(playerid, "Заборонено використовувати команди при відкритому діалозі.");
		return 0;
	}
	if(!TI[playerid][tLogin]) {
		SendError(playerid, "Необхідно авторизуватися.");
		return 0;
	}
	if(GetTickCount() -GetPVarInt(playerid, "AntiFlood") < 500) {
		if(CountFloodForPlayer[playerid] >= 2) return 0;
		CountFloodForPlayer[playerid]++;
		SendError(playerid, "Не флудіть.");
		return 0;
	}
	SetPVarInt(playerid, "AntiFlood", GetTickCount());
	return TI[playerid][tLogin];
}
public OnPlayerCommandPerformed(playerid, cmd[], params[], result, flags) {
  if(result == -1)
  {
        return SendError(playerid, "Ви ввели неіснуючу команду. (/mn - Команди сервера)");
  }
  return 1;
}
public OnPlayerConnect(playerid) {
	RemoveBuildings(playerid);
	EnablePlayerCameraTarget(playerid, 1);
	Streamer_VisibleItems(STREAMER_TYPE_OBJECT, 990, playerid);
	player_target_object[playerid] = INVALID_OBJECT_ID;
	new str[56];
	GetPlayerVersion(playerid, str, sizeof(str));
	format(str, sizeof(str), "Version: %s", str);
	SendInfo(playerid, str);
	new ip[2][16];
	GetPlayerIp(playerid, ip[0], 16);
	if(playerid == 65535) return KickEx(playerid);
	GetPlayerName(playerid, fPlayer[playerid][nname], MAX_PLAYER_NAME);
	GetPlayerIp(playerid, fPlayer[playerid][fip], 32);
   
   	SetPVarInt(playerid, "fire_object", 0);
   	PhoneShow[playerid] = false;
	PhoneLocked[playerid] = 0;
   	gPlayerBusObject[playerid] = INVALID_OBJECT_ID;
   	call_timer[playerid] = 0;
	CI[playerid][cID] = 0;
	ahMenu[playerid][0] = ahMenu[playerid][1] = ahMenu[playerid][2] = ahMenu[playerid][3] = 0;
	CI[playerid][pPalatka] = 0;

	CI[playerid][pMetal] = 0;
	CI[playerid][pCloth] = 0;
	CI[playerid][pStone] = 0;
	CI[playerid][pDress] = 0;

	CI[playerid][pEkills] = 0;

	TI[playerid][tPobeg] = 0;
	TI[playerid][tPobeg_Z] = 0;

	MPTeleportPlayer[playerid] = 0;

	CI[playerid][pYoutube] = 0;
	gPlayerProdText[playerid]    = Text3D: -1;
	gPlayerProdCP[playerid] = -1;
	Trailer_job[playerid] = INVALID_VEHICLE_ID;
	PlayerBuyProdFix[playerid] = 0;

	CI[playerid][pNarcoLomka] = 0;
	CI[playerid][pStartLomka] = 0;

    hellow[playerid] = 0;

	TI[playerid][tDM_k] = 0;
	TI[playerid][tDM_d] = 0;

	player_to_game[playerid] = 0;
	player_to_race_lv[playerid] = 0;

	TI[playerid][tStarted] = false;

	TI[playerid][tClothesWork][0] = 0;
	TI[playerid][tClothesWork][1] = 0;

	TI[playerid][tYoutubcar] = INVALID_VEHICLE_ID;

	TI[playerid][tCheatsDetectsTime] = 0;
	TI[playerid][tCheatsDetects] = 0;

	CI[playerid][pCases][0] =
	CI[playerid][pCases][1] =
	CI[playerid][pCases][2] = 0;

	TI[playerid][tAttack] = 0;
	TI[playerid][tDefend] = 0;

	CI[playerid][bizz_work] = 0;
	CI[playerid][bizz_status] = 0;
	CI[playerid][bizz_cash] = 0;
	CI[playerid][bizz_lcash] = 0;
	CI[playerid][pZahvat] = 0;
	CI[playerid][pDrugs] = 0;
	CI[playerid][pMats] = 0;

	CI[playerid][pJail] = 0;
	CI[playerid][pJailTime] = 0;
	TI[playerid][tJobTaxiRadius] = 500;
	TI[playerid][tJobTaxiFare] = 0;
	PlayerWarningSilent[playerid] = 0;
	for (new j = 0; j < 2; j ++) {
		payment_ptd [ playerid ] [ j ] = PlayerText:-1;
	}

	PlayerWarningSilent[playerid] = 0;

	TI[playerid][tDM] = 0;
	textdraw_bank(playerid);
	new gpciStr[64];
	gpci(playerid, gpciStr);
	if(!strcmp(gpciStr, MOBILE_AUTH_KEY)) TI[playerid][tMobile] = 1;
	else TI[playerid][tMobile] = 0;
	GetPlayerName(playerid, player_name[playerid], MAX_PLAYER_NAME);
	TI[playerid][tLoginTime] = 180;
	// for(new l = 0; l < 2; l++)
	// TextDrawShowForPlayer(playerid, logo334_TD[l]); // Показ логотипа.
	for(new i = 0; i < 4; i++) TextDrawShowForPlayer(playerid, logo_TD[i]);
	PlayerSecondTimer[playerid] = SetTimerEx("player_timer", 1000, false, "i", playerid);

	static const f_check_ip_ban[] = "\
	SELECT * FROM `"TABLE_BANIP"` WHERE `IP` = '%s' LIMIT 1";
	new str_check_ip_ban[sizeof(f_check_ip_ban) + (-2 + 16)];
	format(str_check_ip_ban, sizeof(str_check_ip_ban), f_check_ip_ban, ip[0]);
	mysql_tquery(connects, str_check_ip_ban, "check_ip_ban", "i", playerid);
	// NickName(playerid);
	return 1;
}
stock IsVehicleOccupiedEx(vehicleid) {
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(GetPlayerState(i) == PLAYER_STATE_DRIVER && GetPlayerVehicleID(i) == vehicleid) return 1;
	}
	return 0;
}
public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger) {
	new arend_id = INVALID_PLAYER_ID;
	if(VehicleInfo[vehicleid][vLocked] && !ispassenger) {
		ClearAnimations(playerid);
		FreezePlayerForTime(playerid, 2);
	}
	if(vehicleid == VehicleWareHouse[0] && CountMaterialVehicleWH > 0) {
        GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
		if(engine == 1 && TimerEndWeaponBool == false) {
			SendError(playerid, "Ви маєте 10 хвилин, щоб розвантажити вантажівку на вашому складі.");
			TimerEndWeapon = 60*10;
			TimerEndWeaponBool = true;
		}
	}
	if(VehicleInfo[vehicleid][vBizz] > 0) {
		if(IsVehicleOccupiedEx(vehicleid) && VehicleInfo[vehicleid][vBizz] > 0 && !ispassenger) return ClearAnimations(playerid);
		if(VehicleInfo[vehicleid][vBizz] == 61) if(VehicleInfo[vehicleid][vBizz] != CI[playerid][bizz_work] && !ispassenger) return SendError(playerid, "Ви не працюєте у транспортній компанії"),ClearAnimations(playerid);
	}
	if(VehicleInfo[vehicleid][vType] == VEHICLE_TYPE_FAMILY && !ispassenger) {
		if(VehicleInfo[vehicleid][vFamily] != CI[playerid][pFamily]) {
			SendError(playerid, "Вам недоступний цей транспорт.");
			ClearAnimations(playerid, 1);
		}
	}
	if(PI[playerid][pAdmin] < 1) {
		if(PlayerHealFix[playerid] != 0) {
			if(PlayerHealExFix[playerid] > gettime()) {
				ClearAnimations(playerid);
			}
		}
	}
	if(VehicleInfo[vehicleid][vBizz] && !ispassenger) {
		for(new i = 0; i < 20; i++) {
			if(vehicleid == FuncBizz[VehicleInfo[vehicleid][vBizz]][funcbCars][i]) FuncBizz[VehicleInfo[vehicleid][vBizz]][funcbCarID][i] = playerid;
		}
	}
	if(GetArendCarID(vehicleid, arend_id) != -1) {
		new string[200];
		if(arend_id == INVALID_PLAYER_ID || !IsPlayerConnected(arend_id)) {
			if(!ispassenger) {
				new rc = GetArendCarID(vehicleid);
				format(string, sizeof(string), "Модель: "P"%s"W"\nВартість: "GREEN"$%i"W"\n\nДля оренди транспорту натисніть "P"'Оренда'", gTransport[GetVehicleModel(vehicleid) -400][trName], ArendInfo[rc][aCost]);
				ShowPlayerDialog(playerid, dRentCar, DSM, P"Транспорт для оренди.", string, "Оренда", "Скасувати");
				SetPVarInt(playerid, "rent_carid", vehicleid);
				ClearAnimations(playerid, 1);
			} else ClearAnimations(playerid, 1);
		} else if(arend_id != playerid) {
			SendError(playerid, "Цей транспорт вже орендують.");
			if(!ispassenger) ClearAnimations(playerid, 1);
		}
	}
	if(VehicleInfo[vehicleid][vRobHouse]) {
		if(vehicleid != rob_veh[playerid]) ClearAnimations(playerid, 1);
	}
	SetPlayerArmedWeapon(playerid, 0);
	return 1;
}
CB:PlayerSpawn(playerid) {
	if(IsPlayerNPC(playerid)) return 1;
	TogglePlayerControllable(playerid, 1);
	if(IsPlayerInAnyVehicle(playerid)) {
		new Float:X, Float:Y, Float:Z;
		GetPlayerPos(playerid, X, Y, Z);
		SetPlayerPosAC(playerid, X, Y, Z, TI[playerid][tVirtualWorld], TI[playerid][tInterior]);

		SetTimerEx("PlayerSpawn", 250, false, "i", playerid);
		return 1;
	}
	if(TI[playerid][tSpectate] == true) SpecPl(playerid, false);
	else SpawnPlayer(playerid);
	RobLeave(playerid);
	return 1;
}
stock AllMapping(playerid) {
    pTemp[playerid][var_unit_1] = 0;
    pTemp[playerid][var_unit_2] = 0;
    pTemp[playerid][var_unit_3] = 0;
    format(pTemp[playerid][var_unit_4], 24, "");
    pTemp[playerid][var_unit_5] = 0;
    unit_mapping(playerid);
    return 1;
}
forward unit_mapping_2(playerid);
public unit_mapping_2(playerid) {
	new stringer[500];
    new rows = cache_num_rows();
    if(rows) {
        new tmp = 0;
        new name[32],bdobj, string[80];
        stringer = "{FFFFFF}ObjectID\t{FFFFFF}Встановлено адміністратором\n";
        for(new i = pTemp[playerid][var_unit_1]*15; i < rows; i++) {
            cache_get_value_name(i, "name", name, MAX_PLAYER_NAME);
            cache_get_value_name_int(i, "id", bdobj);
            tmp++;
            format(string, sizeof(string), "{FFFFFF}%i\t%s\n",bdobj,name);
            strcat(stringer, string);
        } if(tmp > 0) {
            strcat(stringer, "Наступна сторінка\n");
            if(pTemp[playerid][var_unit_1] > 0) strcat(stringer, "Попередня сторінка\n");
            format(string, sizeof(string), "{FF6F00}Динамічний мапінг, сторінка: %i", pTemp[playerid][var_unit_1]+ 1);
            ShowPlayerDialog(playerid, 1230, DSTH, "{C70000}Bauld Mapping", stringer, "Обрати", "Закрити");
        } else{
            if(pTemp[playerid][var_unit_1] > 0) {
                pTemp[playerid][var_unit_1]--;
                unit_mapping(playerid);
            }
            SendError(playerid, "На наступній сторінці нічого не знайдено");
        }
    } else {
        if(pTemp[playerid][var_unit_1] > 0) {
            pTemp[playerid][var_unit_1]--;
            unit_mapping(playerid);
        }
        SendError(playerid, "Список мапінгу чистий.");
    }
    return 1;
}
stock unit_mapping(playerid) {
	new stringer[128];
    mysql_format(connects, stringer, 128, "SELECT * FROM `bmap` LIMIT %i", pTemp[playerid][var_unit_1]*15+ 15);
    mysql_pquery(connects, stringer, "unit_mapping_2", "i", playerid);
    return 1;
}
public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[]) {
	PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
	ShowPlayerDialog(playerid, -1, 0, " ", " ", " ", " ");
	TI[playerid][tDialog] = false;
	/* new bool:olddialog = true;
		if(dialogid != OldDialogID[playerid]) olddialog = false;
		new text_length = strlen(inputtext);
		for(new i = 0; i < text_length; i ++) {
			if(inputtext[i] == '{') {
				inputtext[i] = ' ';
			}
			if(inputtext[i] == '}') {
				inputtext[i] = ' ';
			}
			if(inputtext[i] == '%') {
				inputtext[i] = ' ';
			}
		}
		if(!olddialog) {
			SendClientMessage(playerid, COLOR_WHITE, "old dialog = false");
			return 1;
		}
		OldDialogID[playerid] = INVALID_DIALOG_ID; */
	for(new guard_iterator = strlen(inputtext) - 1; guard_iterator > -1; --guard_iterator) {
		if(inputtext[guard_iterator]=='%') inputtext[guard_iterator]='#';
	}
	switch(dialogid) {
		case 2095: {
			if(!response) return DPV(playerid, "EditingPlayerPrefix");
			if(strlen(inputtext) <= 2) return SendError(playerid, "Недостатньо символів."), DPV(playerid, "EditingPlayerPrefix");
			if(strlen(inputtext) >= 38) return SendError(playerid, "Забагато символів."), DPV(playerid, "EditingPlayerPrefix");
			SetPrefix(GetPVarInt(playerid, "EditingPlayerPrefix"), playerid, inputtext);
			return DPV(playerid, "EditingPlayerPrefix");
			}
		/* case D_DEATH_STAGE: {
				KillTimer(deathtimer[playerid][2]);
				if(response) {
					if(deathtimer[playerid][3] == 0) {
						if(GetPlayerVirtualWorld(playerid) != 0) return SendError(playerid, "Ви не можете зробити виклик у приміщенні.");
						new deathphasetimerstr[32];
						format(deathphasetimerstr, sizeof(deathphasetimerstr), "%i", deathtimer[playerid][1]);
						GameTextForPlayer(playerid, deathphasetimerstr, 1000, 4);
						deathtimer[playerid][0] = SetTimerEx("DeathPhaseeTimer", 1000, true, "i", playerid);
						new bool:online = false;
						foreach(new i:Player) {
							if(!TI[i][tLogin]) continue;
							if(!IsAMedic(i) && !start_work[playerid]) continue;
							if(!IsPlayerInRangeOfPoint(i, 7000.0, deathpos[playerid][2], deathpos[playerid][3], deathpos[playerid][4])) continue;
							online = true;
						}
						if(!online) return SendClientMessage(playerid, COLOR_WHITE, P"Диспетчер:"W" Наразі немає вільних медиків.");
						SendClientMessage(playerid, COLOR_WHITE, P"Диспетчер:"W" Ваш виклик прийнято, очікуйте на місці.");
						new string[220];
						format(string, sizeof(string), P"Диспетчер:"W" Надійшов новий виклик від %s.", CI[playerid][cName]);
						SendMCMessage(COLOR_WHITE, string);
						SetPVarInt(playerid, "call_medics", 1);
					} else if(deathtimer[playerid][3] == 1) {
						deathphase[playerid] = 0;
						deathtimer[playerid][1] = 20;
						deathtimer[playerid][3] = 0;
						KillTimer(deathtimer[playerid][0]);
						KillTimer(deathtimer[playerid][2]);
						Delete3DTextLabel(deathlabel[playerid]);
						TogglePlayerDynamicArea(playerid, deatharea[playerid], false);
						OnPlayerDeath(playerid, INVALID_PLAYER_ID, 255);
						SetPlayerHospital(playerid);
					} else {
						new deathphasetimerstr[32];
						format(deathphasetimerstr, sizeof(deathphasetimerstr), "%i", deathtimer[playerid][1]);
						GameTextForPlayer(playerid, deathphasetimerstr, 1000, 4);
						deathtimer[playerid][0] = SetTimerEx("DeathPhaseTimer", 1000, true, "i", playerid);
					}
				}
			} */
		case D_INTERACTION: {
			if(!response) return 1;
			new header[64], content[128], targetid = GetPVarInt(playerid, "InteractedPlayer");
			switch(listitem) {
				case 0: {
					format(header, sizeof(header), P"|"W" Взаємодія з %s. Цивільна.", CI[targetid][cName]);
					ShowPlayerDialog(playerid, D_INTERACTION_CIVIL, DSL, header, P"1."W" Написати повідомлення.\n"P"2."W" Показати документи.\n"P"3."W" Передати гроші.\n"P"4."W" Потиснути руку.\n"P"5."W" Поцілувати.", "Обрати", "Назад");
				}
				case 1: {		
					format(header, sizeof(header), P"|"W" Взаємодія з %s. Фракційна.", CI[targetid][cName]);
					ShowPlayerDialog(playerid, D_INTERACTION_FACTION, DSL, header, content, "Обрати", "Назад");
				}
				case 2: {
					format(header, sizeof(header), P"|"W" Взаємодія з %s. Адміністративна.", CI[targetid][cName]);
					strmid(content, P"1."W" Слідкувати.\n"P"2."W" Телепортувати до себе.\n"P"3."W" Телепортуватися до гравця.\n"P"4."W" Видати мут.\n"P"5."W" Видати деморган.", 0, 128);
					if(PI[playerid][pAdmin] >= 2 && GetPVarInt(playerid, "adminaccess") == 1) strcat(content, "\n"P"6."W" Видати варн.");
					if(PI[playerid][pAdmin] >= 3 && GetPVarInt(playerid, "adminaccess") == 1) strcat(content, "\n"P"7."W" Видати бан.");
					ShowPlayerDialog(playerid, D_INTERACTION_ADMIN, DSL, header, content, "Обрати", "Назад");
				}
			}
			}
		case D_INTERACTION_CIVIL: {
			if(!response) return 1;
			new header[64], content[256], targetstr[4], targetid = GetPVarInt(playerid, "InteractedPlayer");
			valstr(targetstr, targetid);
			switch(listitem) {
				case 0: {
					format(header, sizeof(header), P"|"W" Взаємодія з %s. Повідомлення.", CI[targetid][cName]);
					ShowPlayerDialog(playerid, D_INTERACTION_CIVIL_MESSAGE, DSI, header, W"Введіть текст повідомлення, який ви хочете відправити гравцю.\nМінімальна довжина - "P"1"W" символ, максимальна - "P"128"W".", "Готово", "Назад");
				}
				case 1: {
					new count = 1;
					format(content, sizeof(content), P"%i."W" ID карта.", count);
					if(CI[playerid][pMember] > 0 && !IsCrime(playerid)) {
						count++;
						format(content, sizeof(content), "%s\n"P"%i."W" Робоче посвідчення.", content, count);
					}
					if(lic[playerid][0] || lic[playerid][1] || lic[playerid][2] || lic[playerid][3]) {
						count++;
						format(content, sizeof(content), "%s\n"P"%i."W" Пакет ліцензій.", content, count);
					}
					if(CI[playerid][pMedCard]) {
						count++;
						format(content, sizeof(content), "%s\n"P"%i."W" Медична карта.", content, count);
					}
					if(house_car[playerid][0] || house_car[playerid][1]) {
						count++;
						format(content, sizeof(content), "%s\n"P"%i."W" Реєстраційна карта транспорту.", content, count);
					}
					format(content, sizeof(content), "%s\n"P"%i."W" Довідка з тиру.", content, count + 1);
					
					format(header, sizeof(header), P"|"W" Взаємодія з %s. Документи.", CI[targetid][cName]);
					ShowPlayerDialog(playerid, D_INTERACTION_CIVIL_DOCUMENTS, DSL, header, content, "Готово", "Назад");
				}
				case 2: {
					format(header, sizeof(header), P"|"W" Взаємодія з %s. Гроші.", CI[targetid][cName]);
					ShowPlayerDialog(playerid, D_INTERACTION_CIVIL_MONEY, DSI, header, W"Введіть кількість грошей, яку хочете передати гравцю.\nМінімальна кількість - "GREEN"$1"W", максимальна - "GREEN"$50.000"W".", "Готово", "Назад");
				}
				case 3: pc_cmd_hi(playerid, targetstr);
				case 4: pc_cmd_kiss(playerid, targetstr);
			}
			}
		case D_INTERACTION_CIVIL_MESSAGE: {
			new string[256], header[64], targetid = GetPVarInt(playerid, "InteractedPlayer");
			if(!response) {
				format(header, sizeof(header), P"|"W" Взаємодія з %s. Цивільна.", CI[targetid][cName]);
				return ShowPlayerDialog(playerid, D_INTERACTION_CIVIL, DSL, header, P"1."W" Написати повідомлення.\n"P"2."W" Показати документи.\n"P"3."W" Передати гроші.\n"P"4."W" Потиснути руку.\n"P"5."W" Поцілувати.", "Обрати", "Назад");
			}
			if(!(1 <= strlen(inputtext) <= 128)) {
				format(header, sizeof(header), P"|"W" Взаємодія з %s. Повідомлення.", CI[targetid][cName]);
				return ShowPlayerDialog(playerid, D_INTERACTION_CIVIL_MESSAGE, DSI, header, W"Введіть текст повідомлення, який ви хочете відправити гравцю.\nМінімальна довжина - "P"1"W" символ, максимальна - "P"128"W".", "Готово", "Назад");
			}
			format(string, sizeof(string), "%i %s", targetid, inputtext);
			pc_cmd_pm(playerid, string);
			}
		case D_INTERACTION_CIVIL_DOCUMENTS: {
			new header[64], targetstr[4], targetid = GetPVarInt(playerid, "InteractedPlayer");
			valstr(targetstr, targetid);
			if(!response) {
				format(header, sizeof(header), P"|"W" Взаємодія з %s. Цивільна.", CI[targetid][cName]);
				return ShowPlayerDialog(playerid, D_INTERACTION_CIVIL, DSL, header, P"1."W" Написати повідомлення.\n"P"2."W" Показати документи.\n"P"3."W" Передати гроші.\n"P"4."W" Потиснути руку.\n"P"5."W" Поцілувати.", "Обрати", "Назад");
			}
			if(strfind(inputtext, "ID карта") != -1) return pc_cmd_showid(playerid, targetstr);
			if(strfind(inputtext, "Робоче посвідчення") != -1) return pc_cmd_showbadge(playerid, targetstr);
			if(strfind(inputtext, "Пакет ліцензій") != -1) return pc_cmd_showlic(playerid, targetstr);
			if(strfind(inputtext, "Медична карта") != -1) return pc_cmd_showmc(playerid, targetstr);
			if(strfind(inputtext, "Реєстраційна карта транспорту") != -1) return pc_cmd_showplate(playerid, targetstr);
			if(strfind(inputtext, "Довідка з тиру") != -1) return pc_cmd_showskill(playerid, targetstr);
			}
		case D_INTERACTION_CIVIL_MONEY: {
			new string[256], header[64], targetid = GetPVarInt(playerid, "InteractedPlayer"), amount;
			if(!response) {
				format(header, sizeof(header), P"|"W" Взаємодія з %s. Цивільна.", CI[targetid][cName]);
				return ShowPlayerDialog(playerid, D_INTERACTION_CIVIL, DSL, header, P"1."W" Написати повідомлення.\n"P"2."W" Показати документи.\n"P"3."W" Передати гроші.\n"P"4."W" Потиснути руку.\n"P"5."W" Поцілувати.", "Обрати", "Назад");
			}
			if(sscanf(inputtext, "i", amount) || !(1 <= strval(inputtext) <= 50000)) {
				format(header, sizeof(header), P"|"W" Взаємодія з %s. Гроші.", CI[targetid][cName]);
				return ShowPlayerDialog(playerid, D_INTERACTION_CIVIL_MONEY, DSI, header, W"Введіть кількість грошей, яку хочете передати гравцю.\nМінімальна кількість - "GREEN"$1"W", максимальна - "GREEN"$50.000"W".", "Готово", "Назад");
			}
			format(string, sizeof(string), "%i %i", targetid, amount);
			pc_cmd_pay(playerid, string);
			}
		case D_INTERACTION_ADMIN: {
			new header[64], targetstr[4], targetid = GetPVarInt(playerid, "InteractedPlayer");
			valstr(targetstr, targetid);
			switch(listitem) {
				case 0: pc_cmd_spec(playerid, targetstr);
				case 1: pc_cmd_gethere(playerid, targetstr);
				case 2: pc_cmd_goto(playerid, targetstr);
				case 3: {
					format(header, sizeof(header), P"|"W" Взаємодія з %s. Видати мут. Час.", CI[targetid][cName]);
					ShowPlayerDialog(playerid, D_INTERACTION_ADMIN_MUTE_TIME, DSI, header, W"Оберіть час, на який ви хочете замутити гравця.\nМінімальна тривалість - "P"1"W" хвилина, максимальна - "P"300"W".", "Обрати", "Назад");
				}
				case 4: {
					format(header, sizeof(header), P"|"W" Взаємодія з %s. Видати деморган. Час.", CI[targetid][cName]);
					ShowPlayerDialog(playerid, D_INTERACTION_ADMIN_JAIL_TIME, DSI, header, W"Оберіть час, на який ви хочете посадити гравця в деморган.\nМінімальна тривалість - "P"1"W" хвилина, максимальна - "P"300"W".", "Обрати", "Назад");
				}
				case 5: {
					format(header, sizeof(header), P"|"W" Взаємодія з %s. Видати варн. Причина.", CI[targetid][cName]);
					ShowPlayerDialog(playerid, D_INTERACTION_ADMIN_WARN, DSI, header, W"Оберіть причину, за якою ви хочете заварнити гравця.\nМінімальна довжина - "P"1"W" символ, максимальна - "P"30"W".", "Обрати", "Назад");
				}
				case 6: {
					format(header, sizeof(header), P"|"W" Взаємодія з %s. Видати бан. Час.", CI[targetid][cName]);
					ShowPlayerDialog(playerid, D_INTERACTION_ADMIN_BAN_TIME, DSI, header, W"Оберіть час, на який ви хочете забанити гравця.\nМінімальна тривалість - "P"1"W" день, максимальна - "P"30"W".", "Обрати", "Назад");
				}
			}
			}
		case D_INTERACTION_ADMIN_MUTE_TIME: {
			new time, header[64], string[128], targetid = GetPVarInt(playerid, "InteractedPlayer");
			if(!response) {
