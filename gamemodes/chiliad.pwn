					if(bint < 0 || bint >= BINT_COUNT) return 1;
					if(businessid == 57) {
						if(!casino) return SendError(playerid, "Вхід в казино тимчасово закритий.");
					}
					TI[playerid][tTPpick] = true;
					SetPlayerInterior(playerid, gBints[bint][bintInterior]);
