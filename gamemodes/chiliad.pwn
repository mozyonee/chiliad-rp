CMD:getworld(playerid) {
	new str[150];
	format(str, sizeof(str), "VirtualWolrd: %i. Interior: %i. Car VirtualWolrd: %i.", GetPlayerVirtualWorld(playerid), GetPlayerInterior(playerid), GetVehicleVirtualWorld(GetPlayerVehicleID(playerid)));
