						foreach(new i:Player) {
							if(!TI[i][tLogin]) continue;
							if(CI[i][pSearch] > 0) {
								if(!IsPlayerInRangeOfPoint(i, 200.0, pos[0],pos[1],pos[2])) continue;
								format(tempstring, sizeof(tempstring), dialog_put_fmt, CI[i][cName], CI[i][pSearch]);
