				} else ShowPlayerDialog(playerid,dCodeChange1, DSI, P"Захисний ключ.", "\n\n"W"Введіть ваш старий ключ безпеки:\n\n"NO"*"G" Ключ введено неправильно\n\n", "Ввести", "Назад");
