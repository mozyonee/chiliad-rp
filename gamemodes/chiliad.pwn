CB:GetMarket(playerid) {
	new rows;
	cache_get_row_count(rows);
	STRING_GLOBAL[0] = EOS;
	if(!rows) return SendError(playerid, "У продажу немає доступних товарів.");
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), W"Назва товару\t"W"Кількість\t"W"Вартість\n");
	if(rows) {
		for(new i; i < rows; i ++) {
			cache_get_value_name_int(i, "id", market_id[playerid][i]);
			cache_get_value_name_int(i, "item", market_item[playerid][i]);
			cache_get_value_name_int(i, "ammout", market_ammout[playerid][i]);
			cache_get_value_name_int(i, "cash", market_cash[playerid][i]);
			format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%s%s\t%i\t"GREEN"$%i"W"\n", STRING_GLOBAL,ItemsInfo[market_item[playerid][i]][ItemName], market_ammout[playerid][i], market_cash[playerid][i]);
		}
	}
	if(CI[playerid][pPalatka] == Market[GetPVarInt(playerid, "p_id")][m_id]) ShowPlayerDialog(playerid, D_MARKET_PLAYER_3, DSTH, P"Мої товари", STRING_GLOBAL, "Забрати", "Скасувати");
	else ShowPlayerDialog(playerid, D_MARKET_PLAYER_3, DSTH, P"Товари у продажу", STRING_GLOBAL, "Купити", "Скасувати");
	return 1;
}
CB:GetPrizes(playerid) {
	new rows, type, prize,cash;
	cache_get_row_count(rows);
	STRING_GLOBAL[0] = EOS;
	if(!rows) return SendError(playerid, "У вас немає призів.");
	format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "Назва\tПродаж на ринку\n");
	if(rows) {
		for(new i; i < rows; i ++) {
			cache_get_value_name_int(i, "id", CountInfo[playerid][cont_id][i]);
			cache_get_value_name_int(i, "type", type);
			cache_get_value_name_int(i, "prize", prize);
			cache_get_value_name_int(i, "cash", cash);

			CountInfo[playerid][cont_model][i] = prize;
			CountInfo[playerid][cont_cash][i] = cash;
			CountInfo[playerid][cont_type][i] = type;

			switch(type) {
			case 1: format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%sАксесуар '%s'\t$%i\n", STRING_GLOBAL,ItemsInfo[prize][ItemName],cash);
			case 2: format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%sПреміум-акаунт на %i годин\t$%i\n", STRING_GLOBAL,prize,cash);
			case 3: format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%sОдяг # %i\t$%i\n", STRING_GLOBAL,prize,cash);
			case 4: format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%sГроші ($100.000)\t$%i\n", STRING_GLOBAL,cash);
			case 5: format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%sGOLD кейс\t$%i\n", STRING_GLOBAL,cash);
			case 6: format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%sEXP (3 шт.)\t$%i\n", STRING_GLOBAL,cash);
			case 7: format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%sUAH (2 шт.)\t$%i\n", STRING_GLOBAL,cash);
			case 8: format(STRING_GLOBAL, sizeof(STRING_GLOBAL), "%sГроші ($200.000)\t$%i\n", STRING_GLOBAL,cash);
			}
		}
	}
	ShowPlayerDialog(playerid, D_CONTAINER_2, DSTH, P"Призи з контейнера", STRING_GLOBAL, "Обрати", "Скасувати");
	return 1;
}
