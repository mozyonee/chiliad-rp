CB:CureDeathPlayer(playerid, targetid) {
	ClearAnimations(playerid, 1);
	CureStage(targetid);
	new string[128];
	format(string, sizeof(string), "Медик "P"%s[%i]"W" підняв вас зі стадії.", CI[playerid][cName], playerid);
