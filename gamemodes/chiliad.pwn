				case 1: ShowPlayerDialog(playerid, D_OBC_BD_NUMBER, DSI, P"База даних.", "\n\n"W"Введіть держ. номер автомобиля:\n"G"Примітка: X XXX XX - формат номера\n\n", "Обрати", "Скасувати");
