new QI[MAX_QUESTS][QuestInfo] = {
	{"", "", 70},
	{"Втрачений багаж", "Ваші речі зі станції забрав невідомий чоловік.\nВін попросив організувати з вами зустріч\n\n"P"Завдання:"W"\n\n - Зустрітися з Карлом та забрати валізу з речима.\n\nВинагорода:"GREEN" $1.000", 1},
	{"Перші гроші", "Для комфортного життя та освоєння у штаті, необхідні гроші\nна кишенкові витрати\n\n"P"Завдання:"W"\n\n - Отримати на будівництві 30 досвіду роботи (/jobskill)\n(/gps > Роботи > Будівництво)\n\nВинагорода:"GREEN" $10.000 + 1 EXP", 30},
	{"Водійське посвідчення", "Тобі вже варто навчитися їздити за кермом автомобіля\n\n"P"Завдання:"W"\n\n - Отримати посвідчення водія в автошколі\n(/gps > Громадські місця > Автошкола)\n\nВинагорода:"GREEN" $6.000", 1},
	{"Шопінг", "Настав час змінити свій імідж, придбати новий одяг.\n\n"P"Завдання:"W"\n\n - Купити новий одяг у магазині одягу\n\nВинагорода:"P" 5.000$ + 1 EXP", 1},
	{"Телефон", "Щоб підтримувати спілкування з друзями, необхідно придбати\nмобільний телефон\n\n"P"Завдання:"W"\n\n - Купити мобільний телефон в 24/7\n\nВинагорода:"P" $1.000", 1},
	{"Перша машина", "Час задуматися про вільне пересування на власному\nтранспорті.\n\n"P"Завдання:"W"\n\n - Купити будь-який автомобіль в Автосалоні (/gps > Автосалони)\nВинагорода:"GREEN" $16.000", 1},
	{"Розваги", "Після серйозної роботи, потрібно добре відпочити.\n\n"P"Завдання:"W"\n\n - Відвідати 2 будь-яких заходи\n\nВинагорода:"P" $5.000", 2},
	{"Таксист", "Отримайте додатковий навик керування автомобілем,\nперевозячи пасажирів у різні точки міста\n\n"P"Завдання:"W"\n\n - Перевезти 20 клієнтов на таксі\n(/gps > Роботи > Оренда таксі)\n\nВинагорода:"GREEN" $7.000", 20},
	{"Друзі в ділі", "Щоб завершити це завдання, вам необхідно запросити своїх\nдрузів на сервер (/referals)\n\n"P"Завдання:"W"\n\n - Запитити 5 друзів за реферальною системою (/referals)\n\nВинагорода:"GREEN" $50.000", 5},
	{"Водій автобуса", "Влаштуйтеся в центрі зайнятості на роботу водія\nавтобуса\n\n"P"Завдання:"W"\n\n - Проїхати 10 будь-яких маршрутів на автобусі\n\nВинагорода:"P" $20.000", 10},
	{"Служба в гвардії", "Час служити батьківщині\n\n"P"Завдання:"W"\n\n - Вступити в Національну гвардію і відслужити 3 години\n\nВинагорода:"P" $30.000", 3},
	{"Кращий працівнік", "Опануйте собі в організації, яка вам цікава\n\n"P"Завдання:"W"\n\n - Відіграти у будь-якій організації 30 годин\n\nВинагорода:"P" $25.000", 30},
	{"Мій дім", "Вам необхідно знайти постійне місце проживання\n\n"P"Завдання:"W"\n\n - Купити будинок будь-якого класу\n\nВинагорода:"P" $10.000", 1},
	{"Щасливий час", "Покажи свою максимальну активність, на яку ти здатен\n\n"P"Завдання:"W"\n\n - Відіграти на сервері 5 годин\n\nВинагорода:"P" $20.000", 5},
	// Gang
	{"Перша гонка", "Знайдіть собі відповідного суперніка, для участі в гонках.\n\n"P"Завдання:"W"\n\n - Перемогти 5 раз в гонках (/srace)\n\nВинагорода:"GREEN" $3.000", 5},
	{"Військова форма", "Знайдіть військового в гетто та зніміть з нього його форму.\nУ формі дозволено прокрадатися на військову базу.\n\n"P"Завдання:"W"\n\n - Вбити військового у формі в гетто\n\nВинагорода:"GREEN" $5.000", 1},
	{"Автовикрадення", "Їдьте до Джека за завданням\n(/gps > Нелегальні організації > Автовикрадення)\n\n"P"Завдання:"W"\n\n - Викрасти 10 будь-який автомобілів\n\nВинагорода:"GREEN" $15.000", 10},
	{"Війна за територію", "Захистіть свою територію від нападніків\n\n"P"Завдання:"W"\n\n - Вбити 50 противніків під час капту\n\nВинагорода:"GREEN" $25.000 + 2 EXP", 50},
	{"Пограбування будинків", "Зробіть пограбування будь-яких будинків\n(/gps > Нелегальні організації > Пограбування будинків)\n\n"P"Завдання:"W"\n\n - Пограбувати 4 будинки (винести 24 одиниці побутової техніки)\n\nВинагорода:"GREEN" 8.000$ + 1 EXP", 24},
	{"Постачання патронівів", "Викрадіть матеріали з Національної гвардії та поповніть загальний склад\n\n"P"Завдання:"W"\n\n - Викрасти 50 ящиків з боєприпасами зі складу Національї гвардії\n\nВинагорода:"GREEN" $10.000 + 1 EXP", 50},
	{"Наркоторговець", "Продайте на своїй території кілька грам наркотиків\n\n"P"Завдання:"W"\n\n - Продати наркотики 10-м людям\n\nВинагорода:"GREEN" $5.000", 10},
	{"Завойовнік", "Захопіть територію ворожої банди (/capture)\nЗахоплення можливе з "NO"5"W" рангу\n\n"P"Завдання:"W"\n\n - Захопити 5 разів чужу територію\n\nВинагорода:"GREEN" $12.000 + 3 EXP", 5},
	{"Найкращий стрілець", "Займіть вершину ТОП списку капта. Вбивайте всіх противніків,\nщо зустрічаються вам на шляху\n\n"P"Завдання:"W"\n\n - Зайняти 2 рази перше місце у ТОП капта\n\nВинагорода:"GREEN" $30.000 + 2 EXP", 2},
	{"Просунутий боєць", "Вам необхідно взяти участь у боях на ринзі. Для цього\nвідправляйтеся у спорт зал\n(/gps > Громадські місця > Спорт зал)\n\n"P"Завдання:"W"\n\n - ВГрути 10 боїв на ринзі\n\nВинагорода:"GREEN" $20.000 + 1 EXP", 10},
	// Mafia
	{"Викрадення", "Виконайте відповідальне завдання. Наслідком може\nбути великий термін у в'язниці\n\n"P"Завдання:"W"\n\n - Викрасти агента Федерального бюро розслідувань (/tie)\n\nВинагорода:"GREEN" $25.000 + 2 EXP", 1},
	{"Азарт", "Попробуйте сробити крупную ставку в костях\n\n"P"Завдання:"W"\n\n - Зіграти в кісттки на 100 фішок (/dice)\n\nВинагорода:"GREEN" $2.000 + 1 EXP", 1},
	{"Спорядження матеріалами", "Викрадіть матеріали з Нац. гвардії і поповніть загальний склад\n\n"P"Завдання:"W"\n\n - Викрасти 50 ящиків боєприпасів з Нац. гвардії\n\nВинагорода:"GREEN" $10.000 + 1 EXP", 50},
	{"Початок захоплення", "Розпочніть війну за будь-який бізнес (/bizwar)\n\n"P"Завдання:"W"\n\n - Розпочати 5 війн за бізнес\n\nВинагорода:"GREEN" $6.000", 5},
	{"Кращий загарбник", "Увійдіть в ТОП гравців на стрілі. Вбивайте всіх противників,\nякі зустрічаються вам на шляху\n\n"P"Завдання:"W"\n\n - Увійти 2 рази в ТОП на стрілі\n\nВинагорода:"GREEN" $30.000 + 2 EXP", 2},
	{"Війна за бізнес", "Захистіть свій бізнес від мафії-нападника\n\n"P"Завдання:"W"\n\n - Вбити 50 противників під час стріли\n\nВинагорода:"GREEN" $15.000 + 2 EXP", 50},
	{"Адвокат", "Скористуйтеся послугами адвоката у в'язниці\n\n"P"Завдання:"W"\n\n - Скористуватися услугами адвоката\n\nВинагорода:"GREEN" $4.000", 1},
	{"Міцна мотузка", "Викрадайте людей і вимагайте за них викуп!\n\n"P"Завдання:"W"\n\n - Викрасти і зв'язати 10 людей (/tie)\n\nВинагорода:"GREEN" $12.000", 10},
	{"Активний мафіозі", "Проявляйте свою активність в грі, беріть участь в захопленнях\n\n"P"Завдання:"W"\n\n - Відіграти за мафіозі 10 годин\n\nВинагорода:"GREEN" $25.000 + 3 EXP", 10},

	// Police/PD
	{"Виписати штраф", "Випишіть штраф людям, що порушують закони штату\n\n"P"Завдання:"W"\n\n - Виписати штраф 10-ом порушникам (/ticket)\n\nВинагорода:"GREEN" $15.000", 10},
	{"Патрулювання", "Розпочніть патрулювання вулиць від злочинців\n\n"P"Завдання:"W"\n\n - Вислідкувати 10 злочинців (/patrul)\n\nВинагорода:"GREEN" $10.000", 10},
	{"Перший арест", "Розпочніть заарештовувати злочинців, що порушують закони штату\n\n"P"Завдання:"W"\n\n - Заарештувати 20 злочинців (/arrest)\n\nВинагорода:"GREEN" $20.000 + 2 EXP", 20},
	{"Екстрений виклик", "Приймайте вхідні виклики від громадян штату\n\n"P"Завдання:"W"\n\n - Прийняти 10 викликів (/mdc)\n\nВинагорода:"GREEN" $8.000 + 1 EXP", 10},
	{"Заарештувати ОНЗ", "Спіймайте та заарештуйте Особливо Небезпечного Злочинця (від 4 рівня розшуку)\n\n"P"Завдання:"W"\n\n - Заарештувати злочинця з 4+ рівнем розшуку\n\nВинагорода:"GREEN" $5.000", 1},
	{"Активна робота", "Починайте активно наводити порядок в штаті! Патрулювати,\nзаарештовувати злочинців і багато іншого.\n\n"P"Завдання:"W"\n\n - Пробути в організації 36 годин\n\nВинагорода:"GREEN" $30.000 + 4 EXP", 36},
	// Щоденні завдання
	{"Взяти участь в 5 системних ігрових заходах", "Вибрано завдання:"P" Взяти участь в 5 системних заходах (/gps > Розваги > Центр розваг)"W"\n\nВи хочете взятись за виконання?", 5, "5 UAH"},
	{"Випити в барі", "Вибрано завдання:"P" Випити в барі"W"\n\nВи хочете взятись за виконання?", 1, "$8.000"},
	{"Перекусити в закусочній", "Вибрано завдання:"P" Перекусити в закусочній"W"\n\nВи хочете взятись за виконання?", 1, "1 EXP"},
	{"Придбати товар 24/7", "Вибрано завдання:"P" Придбати товар 24/7"W"\n\nВи хочете взятись за виконання?", 1, "1 EXP"},
	{"Заправити транспортний засіб", "Вибрано завдання:"P" Заправити транспортний засіб на АЗС"W"\n\nВи хочете взятись за виконання?", 1, "1 EXP"},
	{"Взяти участь в 5-ти дуелях", "Вибрано завдання:"P" Взяти участь в 5-ти дуелях 1x1"W"\n\nВи хочете взятись за виконання?", 5, "5 UAH"},
	{"Спіймати 10 рибин", "Вибрано завдання:"P" Спіймати 10 рибин на рибалці"W"\n\nВи хочете взятись за виконання?", 10, "12.000$"},
	{"Відвідати будь-яку DM зону", "Вибрано завдання:"P" Відвідати будь-яку DM зону"W"\n\nВи хочете взятись за виконання?", 1, "7.500$ + 5 UAH"},
	{"Виготовити 10 одиниць зброї", "Вибрано завдання:"P" Виготовити 10 одиниць зброї заводі з виготовлення зброї"W"\n\nВи хочете взятись за виконання?", 10, "9.500$"},
	{"Зрубати 10 дерев", "Вибрано завдання:"P" Зрубати 10 дерев на лесопилке"W"\n\nВи хочете взятись за виконання?", 10, "9.500$"},
	{"Завантажити 10 мішків з грошима", "Вибрано завдання:"P" Завантажити 10 мішків з грошима на роботі інкасатора"W"\n\nВи хочете взятись за виконання?", 10, "8.500$"},
	{"Зібрати 5 пакетів зі сміттям", "Вибрано завдання:"P" Зібрати 5 пакетів зі сміттям на чистильщике каналзаций"W"\n\nВи хочете взятись за виконання?", 5, "8.500$"},
	{"Відіграти 3 години", "Вибрано завдання:"P" Отыграть на сервері 3 години"W"\n\nВи хочете взятись за виконання?", 3, "GOLD кейс"},
	{"Проїхати 5 кіл мийником доріг", "Вибрано завдання:"P" Проїхати 5 кіл мийником доріг"W"\n\nВи хочете взятись за виконання?", 5, "7.000$"},
	{"Продати 10 хот-догів", "Вибрано завдання:"P" Продати 10 хот-догів (/shd)"W"\n\nВи хочете взятись за виконання?", 10, "7.000$"},
	{"Зремонтувати 5 автомобілів", "Вибрано завдання:"P" Зремонтувати 5 автомобілів (/repair)"W"\n\nВи хочете взятись за виконання?", 5, "7.000$"},
	{"Зібрати 10 яблук", "Вибрано завдання:"P" Зібрати на фермі 10 яблук"W"\n\nВи хочете взятись за виконання?", 10, "7.000$"},

