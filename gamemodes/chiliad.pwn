				}
			}
			}
		case dATMList: {
			if(!response) return ShowPlayerDialog(playerid, dATMAdmin, DSL, "Банкомати.", P"1. "W"Список банкоматів\n"P"2. "W"Створити банкомат", "Обрати", "Назад");
