					SetPVarFloat(playerid, "posx", pos[0]);
					SetPVarFloat(playerid, "posy", pos[1]);
					SetPVarFloat(playerid, "posz", pos[2]);
					SetPVarFloat(playerid, "posa", pos[3]);
