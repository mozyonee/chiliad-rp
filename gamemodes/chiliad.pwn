					case 24, 25: if(strfind(inputtext, gun_text) != -1) storeslot ++;
					}
					if(!gunid || !ammo || storeslot == -1) continue;
					if(storeslot != -1) {
						format(string, sizeof(string), P"%s"W" заряджено паралізуючими патронами. (2 шт.)", gun_text);
