		PlayerTextDrawHide(playerid,ColorTDPl[playerid][2]);
		PlayerTextDrawColor(playerid,ColorTDPl[playerid][2],RGBArray[PrimaryColor[playerid]]);
		PlayerTextDrawShow(playerid,ColorTDPl[playerid][2]);
