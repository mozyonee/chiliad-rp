CMD:subleaders(playerid) {
	new countleader = 0;
	new string[1650];
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(CI[i][pMember] == 0) continue;
		if(CI[i][pLeader] != 0) continue;
		if(CI[i][pRank] < FI[CI[i][pMember]][lRank]-1) continue;
		if(PI[i][pAdmin]) continue;
		format(string, sizeof(string), "%s"G"%s [%i] - [т. %i] - %s %s\n", string, CI[i][cName], i, CI[i][pPhone], FI[CI[i][pMember]][fName], TI[i][tAFK]>=3?("{ffa800}[AFK]"):(""));
		countleader++;
	}
	if(countleader > 0) {
		format(string, sizeof(string), "%s\n"ORANGE"В мережі %i заступників", string,countleader);
		ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Заступники організацій.", string, "Закрити", "");
	} else ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Заступники організацій.", W"Немає заступників у мережі", "Закрити", "");
	return 1;
}
CMD:fwarn(playerid, params[]) {
	if(!CI[playerid][pMember]) return 1;
	new string[156];
	if(CI[playerid][pRank] < FI[CI[playerid][pMember]][sRank]) {
		format(string, sizeof(string), "Ця функція доступна з %i рангу.", FI[CI[playerid][pMember]][sRank]);
		SendError(playerid, string);
		return 1;
	}
	if(sscanf(params, "ds[128]",params[0],params[1])) return SendError(playerid, "Використайте: /fwarn [playerid] [причина]");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, not_id);
	if(CI[params[0]][pMember] != CI[playerid][pMember] || CI[playerid][pRank] <= CI[params[0]][pRank]) return SendError(playerid, "Гравець не в вашій організації або вище за вас рангом.");
	if(IsAIP(params[1])) return 1;
	CI[params[0]][pfWarn] ++;
	UpdateCharacterData(params[0], "fwarn", CI[params[0]][pfWarn]);
	FracLog(LOGS_FWARN, CI[playerid][cName], CI[params[0]][cName], params[1]);
	if(CI[params[0]][pfWarn]>=3) {
		if(start_work[params[0]]) {
			SendInfo(params[0], "Робочий день завершено.");
			start_work[params[0]] = 0;
			UpdateCharacterData(params[0], "FracDuty", start_work[params[0]]);
		}
		add_jobinfo(params[0], params[1]);
		CI[params[0]][pRank] = 0;
		CI[params[0]][pMember] = 0;
		CI[params[0]][pJob] = 0;
		CI[params[0]][pFracSkin] = 0;
		SetPlayerColor(params[0], 0xFFFFFF11);
		skin_player(params[0]);
		CI[params[0]][pfWarn] = 0;
		UpdateCharacterData(params[0], "pMember", CI[params[0]][pMember]);
		UpdateCharacterData(params[0], "pJob", CI[params[0]][pJob]);
		UpdateCharacterData(params[0], "fwarn", 0);
		UpdateCharacterData(params[0], "pModel", CI[params[0]][pFracSkin]);
		format(string, sizeof(string), "[F] %s видав догану і звільнив гравця %s (3/3). Причина: %s.", CI[playerid][cName], CI[params[0]][cName], params[1]);
		SendFactionMessage(CI[playerid][pMember], COLOR_LIGHTRED, string);
		FracLog(LOGS_UNINVITE, CI[playerid][cName], CI[params[0]][cName], params[1]);
		return 1;
	}
	format(string, sizeof(string), "[F] %s видав догану гравцю %s (%i/3). Причина: %s.", CI[playerid][cName], CI[params[0]][cName], CI[params[0]][pfWarn], params[1]);
	SendFactionMessage(CI[playerid][pMember], COLOR_LIGHTRED, string);
	return 1;
}
CMD:funwarn(playerid, params[]) {
	if(!CI[playerid][pMember]) return 1;
	new string[156];
	if(CI[playerid][pRank] < FI[CI[playerid][pMember]][sRank]) {
		format(string, sizeof(string), "Ця функція доступна з %i рангу.", FI[CI[playerid][pMember]][sRank]);
		SendError(playerid, string);
		return 1;
	}
	if(sscanf(params, "ds[128]",params[0],params[1])) return SendError(playerid, "Використайте: /funwarn [playerid] [reason]");
	if(!CI[params[0]][pfWarn]) return SendError(playerid, "У цього гравця немає доган.");
	if(CI[params[0]][pMember] != CI[playerid][pMember] || CI[playerid][pRank] <= CI[params[0]][pRank]) return SendError(playerid, "Гравець не в вашій організації або вище за вас рангом.");
	CI[params[0]][pfWarn]--;
	UpdateCharacterData(params[0], "fwarn", CI[params[0]][pfWarn]);
	format(string, sizeof(string), "[F] %s зняв догану гравцю %s. Причина: %s.", CI[playerid][cName], CI[params[0]][cName], params[1]);
	SendFactionMessage(CI[playerid][pMember], COLOR_LIGHTRED, string);
	FracLog(LOGS_FUNWARN, CI[playerid][cName], CI[params[0]][cName], params[1]);
	return 1;
}
CMD:members(playerid) {
	if(!CI[playerid][pMember]) return SendError(playerid, "Ви не перебуваєте в організації.");
	new ids = 0;
	new string[3000], str[128];
	strcat(str, "ID\tРанг\tТелефон\tДогани\tІм'я"W"\n\n");
	strcat(string, str);
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(CI[i][pMember] != CI[playerid][pMember])continue;
		if(CI[i][pRank] < 1 || CI[i][pMember] < 1) continue;
		if(PI[i][pAdmin]) continue;
		format(str, sizeof(str), "%i\t%i\t%i\t\t%i/3\t\t%s %s %s\n",i, CI[i][pRank], CI[i][pPhone], CI[i][pfWarn], CI[i][cName],(start_work[i]) ? ("[На роботі]") : ("[Не на роботі]"),(TI[i][tAFK] > 3) ? (""P"[AFK]"W""):(""));
		strcat(string, str);
		ids++;
	}
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Члени організації онлайн.", string, "Закрити", "");
	new strr[128];
	format(strr, sizeof(strr), "Всього гравців в організації: "P"%i"W".",ids);
	SendOK(playerid,strr);
	return 1;
}
CMD:invite(playerid, params[]) {
	if(!CI[playerid][pMember]) return SendError(playerid, "Ви не є членом будь-якої організації.");
	if(!start_work[playerid]) return SendError(playerid, "Необхідно розпочати робочий день.");
	new string[128];
	if(CI[playerid][pRank] < FI[CI[playerid][pMember]][sRank]) {
		format(string, sizeof(string), "Ця функція доступна з %i рангу.", FI[CI[playerid][pMember]][sRank]);
		return SendError(playerid, string);
	}
	if(sscanf(params, "i", params[0])) return SendError(playerid, "Використайте: /invite [playerid]");
	if(!TI[params[0]][tStarted] || params[0] == INVALID_PLAYER_ID || params[0] == playerid) return SendError(playerid, not_id);
	if(CI[params[0]][pMember] > 0) return SendError(playerid, "Гравець є членом вашої організації.");
	if(CI[params[0]][pWarns] >= 1) return SendError(playerid, "У гравця є активне попередження.");
	if(IsBLName(CI[params[0]][cID], CI[playerid][pMember])) return SendError(playerid, "Гравець в ЧС вашої організації.");
	if(!IsPlayerStream(7.0, playerid, params[0])) return SendError(playerid, "Ви далеко від гравця.");
	if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
	
	format(string, sizeof(string), P"%s"W" запропонував вам вступити в організацію "P"%s"W".", CI[playerid][cName], FI[CI[playerid][pMember]][fName]);
	SendOK(params[0], string);
	SendHint(params[0], "Натисніть "YES"Y"W" щоб погодитися, або "NO"N"W" для відмови.");
	format(string, sizeof(string), "Ви запропонували "P"%s"W" вступити в організацію "P"%s"W".", CI[params[0]][cName], FI[CI[playerid][pMember]][fName]);
	SendOK(playerid, string);

	SetPVarInt(params[0], "inviter", playerid);
	return 1;
}
CMD:uninvite(playerid, params[]) {
	if(!CI[playerid][pMember]) return SendError(playerid, "Ви не перебуваєте в організації.");
	if(!start_work[playerid]) return SendError(playerid, "Необхідно розпочати робочий день.");
	new string[156];
	if(CI[playerid][pRank] < FI[CI[playerid][pMember]][sRank]) {
		format(string, sizeof(string), "Ця функція доступна з %i рангу.", FI[CI[playerid][pMember]][sRank]);
		return SendError(playerid, string);
	}
	if(sscanf(params, "ds[128]",params[0],params[1])) return SendError(playerid, "Використайте: /uninvite [playerid] [причина]");
	if(params[0] == playerid) return SendError(playerid, not_id);
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return SendError(playerid, not_id);
	if(IsAIP(params[1])) return 1;
	if(CI[params[0]][pLeader] >= 1) return SendError(playerid, "Ви не можете звільнити лідера.");
	if(CI[playerid][pLeader] <= 0 && CI[playerid][pRank] <= CI[params[0]][pRank]) return SendError(playerid, "Ваш ранг недостатній.");
	if(CI[params[0]][pMember] == 0) return SendError(playerid, "Гравець не є членом вашої організації.");
	if(CI[params[0]][pMember] == CI[playerid][pLeader] || CI[params[0]][pMember] == CI[playerid][pMember]) {
		if(CI[params[0]][pMember] > 0) {
			format(string, sizeof(string), P"%s"W" звільнив вас з організації. Причина: %s.", CI[playerid][cName], params[1]);
			SendError(params[0], string);
			format(string, sizeof(string), P"%s"W" звільнений з організації. Причина: %s.", CI[params[0]][cName], params[1]);
			SendOK(playerid, string);
			if(start_work[params[0]]) {
				SendInfo(params[0], "Робочий день завершено.");
				start_work[params[0]] = 0;
				UpdateCharacterData(params[0], "FracDuty", start_work[params[0]]);
			}
			if(IsAGang(params[0]) && GetPVarInt(params[0], "ppkz")) EndCapt(params[0]);
			if(GetPlayerState(params[0]) == PLAYER_STATE_DRIVER) RemovePlayerFromVehicleAC(params[0]);
			add_jobinfo(params[0], params[1]);
			CI[params[0]][pRank] = 0;
			CI[params[0]][pMember] = 0;
			CI[params[0]][pJob] = 0;
			CI[params[0]][pFracSkin] = 0;
			CI[params[0]][pZahvat] = 0;
			CI[params[0]][cRadioChannel] = 0;
			SetPlayerColor(params[0], 0xFFFFFF11);
			skin_player(params[0]);
			SetArmour(params[0], 0);
			ResetPlayerWeapons(params[0]);

			UpdateCharacterData(params[0], "cRadioChannel", 0);
			UpdateCharacterData(params[0], "pModel", CI[params[0]][pFracSkin]);
			UpdateCharacterData(params[0], "pMember", CI[params[0]][pMember]);
			UpdateCharacterData(params[0], "pRank", CI[params[0]][pRank]);
			UpdateCharacterData(params[0], "pJob", CI[params[0]][pJob]);
			UpdateCharacterData(params[0], "zahvat", CI[params[0]][pZahvat]);

			CI[params[0]][pAdvert] = 0;
			UpdateCharacterData(params[0], "Advert", 0);

			FracLog(LOGS_INVITE, CI[playerid][cName], CI[params[0]][cName],params[1]);
		}
	}
	return 1;
}
CMD:leave(playerid) {
	if(CI[playerid][pLeader]) return SendError(playerid, "Лідеру заборонено виходити з фракції.");
	if(!CI[playerid][pPremium]) return SendError(playerid, "У вас немає преміум-акаунта.");
	if(!CI[playerid][pMember]) return SendError(playerid, "Ви не перебуваєте в організації.");
	if(IsPlayerInAnyVehicle(playerid)) return SendError(playerid, "Не можна використовувати в машині.");
	ShowPlayerDialog(playerid, D_LEAVE, DSM, P"Звільнення.", "\n\n"W"Ви дійсно хочете покинути організацію за власним бажанням?\n\n", "Покинути", "Скасувати");
	return 1;
}
CMD:truck(playerid) {
	if(!IsATK(playerid)) return SendError(playerid, "Ви не працівник транспортной компанії");
	ShowPlayerDialog(playerid, D_TK_TRUCK, DSTH, P"Меню замовлень", W"Назва\t"W"Груз\t"W"Вартість\n"G"- Завантажитися на складі\n"P"1."W" Лісопильня\tІнструменти\t"GREEN"$15.000\n"P"2."W" Ферма\tДобрива\t"GREEN"$11.000\n"P"3."W" Будівництво\tБудматеріали\t"GREEN"$12.000\n\
"P"4."W" Завод з виготовлення зброї\tМатеріали\t"GREEN"$11.500\n"P"5."W" Montgomery\tПродукти\t"GREEN"$12.500\n"P"6."W" Palomino Creek\tПродукти\t"GREEN"$12.200", "Обрати", "Скасувати");
	return 1;
}
CMD:tr(playerid, params[]) {
	if(!IsATK(playerid)) return 1;
	if(CI[playerid][pMute] > 0) return SendError(playerid, "У вас бан чата.");
	new string[144];
	if(isnull(params) || strlen(params) > 100) return SendClientMessage(playerid, COLOR_WHITE, "Введіть: /tr [text]");
	format(string, sizeof(string), "[TRUCK] [%s] %s: %s",tk_class[CI[playerid][bizz_status]-1], CI[playerid][cName],params);
	BizzMSG(CI[playerid][bizz_work],COLOR_YELLOW, string);
	return 1;
}
alias:tr("trs")
CMD:trspcar(playerid) {
	if(!IsATK(playerid)) return SendError(playerid, "Ви не працівник транспортной компанії.");
	if(CI[playerid][bizz_status] < 2) return SendError(playerid, "Ця функція доступна тільки керівнику транспортної компанії.");
	new string[128];
	for(new i = GetVehiclePoolSize() + 1; --i != 0;)  {
		if(VehicleInfo[i][vBizz] != CI[playerid][bizz_work]) continue;
		if(IsVehicleOccupied(i)) continue;
		LinkVehicleToInterior(i, 0);
		SetVehicleVirtualWorld(i, 0);
		SetVehicleToRespawn(i);
	}
	format(string, sizeof(string), "[TRUCK] [%s] %s заспавнив незайняті вантажівки.", tk_class[CI[playerid][bizz_status]-1], CI[playerid][cName]);
	BizzMSG(CI[playerid][bizz_work],COLOR_YELLOW, string);
	return 1;
}
stock invitetrS(playerid) {   
    if(CI[playerid][bizz_work] == 61) return SendError(playerid, "Ви вже працюєте в транспортной компанії.");
	if(CI[playerid][pLevel] < 2) return SendError(playerid, "У вас недостатній рівень для цієї роботи. Необхідно мати 2 рівень.");
	if(GetPVarInt(playerid, "tk_id")) return SendError(playerid, "У вас вже є активна пропозиція.");
	ShowPlayerDialog(playerid, D_ACCEPTS_TS, DSM, "Працевлаштування.", "Ви дійсно хочете влаштуватися у транспортну компанію?", "Так", "Ні");
	return 1;
}
CMD:uninviteleave(playerid) return CI[playerid][bizz_work] = 0;
CMD:trinvite(playerid, params[]) {
	if(!IsATK(playerid)) return SendError(playerid, "Ви не працівник транспортной компанії.");
	if(CI[playerid][bizz_status] < 2) return SendError(playerid, "Ця функція доступна тільки керівнику транспортної компанії.");
	new taxi = CI[playerid][bizz_work];
	if(sscanf(params, "d", params[0])) return SendError(playerid, "Введіть: /trinvite [playerid]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return SendError(playerid, not_id);
	if(params[0] == playerid) return SendError(playerid, not_id);
	if(!IsPlayerStream(7.0, playerid, params[0])) return SendError(playerid, "Ви далеко від гравця.");
	if(CI[params[0]][pLevel] < 2) return SendError(playerid, "У гравця недостатній рівень для цієї роботи. Необхідно мати 2 рівень.");
	if(IsPlayerInAnyVehicle(params[0])) return SendError(playerid, "Гравець в машині.");
	if(CI[params[0]][bizz_work] == 61) return SendError(playerid, "Цей гравець вже працює в транспортной компанії");
	if(active_accept(params[0])) return SendError(playerid, "У гравця вже є активна пропозиція.");
	new mes[128];
	format(mes, sizeof(mes), "Ви запропонували "P"%s"W" вступити в транспортну компанію.", CI[params[0]][cName]);
	SendOK(playerid, mes);
	format(mes, sizeof(mes), P"%s"W" хоче влаштувати вас в транспортну компанію.", CI[playerid][cName]);
	SendHint(params[0], mes);
	SendHint(params[0], "Натисніть "YES"Y"W" щоб погодитися, або "NO"N"W" для відмови.");
	SetPVarInt(params[0], "tk_id", taxi);
	return 1;
}
CMD:taxi(playerid,params[]) {
	if(CI[playerid][pJob] != 7) return SendError(playerid, "Ви не водій таксі.");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || GetPlayerVehicleID(playerid) != GetPVarInt(playerid, "veh_id_taxi")) return SendError(playerid, "Ви повинні бути за кермом такси.");
	if(sscanf(params, "u",params[0])) return SendError(playerid, "Використайте: /taxi [playerid]");
	if(params[0] == playerid) return SendError(playerid, "Ви не можете запросити місце призначення в самого себе.");
	if(!IsPlayerConnected(params[0])) return SendError(playerid, not_id);
	if(GetPlayerState(params[0]) != PLAYER_STATE_PASSENGER || GetPlayerVehicleID(params[0]) != GetPlayerVehicleID(playerid)) return SendError(playerid, "Гравець повинен сидіти на пасажирському місці у вашому таксі.");
	new mes[128];
	format(mes, sizeof(mes), "Гравцю %s відправлено запит на отримання даних про місце призначення.", CI[params[0]][cName]);
	SendClientMessage(playerid, 0x3399FFFF, mes);
	format(mes, sizeof(mes), "Водій такси "P"%s"W" запросив дані про місце призначення.", CI[playerid][cName]);
	SendClientMessage(params[0], 0x3399FFFF, mes);
	SendClientMessage(params[0], 0x3399FFFF, "Відкрийте карту і поставте правою кнопкою миші мітку туди, куди хочете відправитися.");
	SetPVarInt(params[0], "selectpoint", 1);
	SetPVarInt(params[0], "taxidriver", playerid);
	return 1;
}
CMD:fare(playerid, params[]) {
	new tar[15], string[200], slog[36];
	new veh = GetPlayerVehicleID(playerid);
	if(CI[playerid][pJob] != 7) return SendError(playerid, "Ви не водій таксі.");
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || GetPlayerVehicleID(playerid) != GetPVarInt(playerid, "veh_id_taxi")) return SendError(playerid, "Ви повинні бути за кермом таксі.");
	if(!VehicleInfo[veh][vTarif]) format(tar, 15, "Не встановлений");
	else format(tar, 15, "$%i",VehicleInfo[veh][vTarif]);
	if(!VehicleInfo[veh][vSlog]) format(slog, 36, "Не встановлений");
	else format(slog, 36, "%s",VehicleInfo[veh][vSlog]);
	format(string, 150, P"1."W"Змінити тариф\t%s\n"P"2."W" Змінити слоган\t%s",tar, slog);
	ShowPlayerDialog(playerid, D_TAXI_FARE,DST, P"TAXI", string, "Обрати", "Скасувати");
	return 1;
}
CMD:untaxi(playerid,params[]) {
	if(CI[playerid][pJob] != 7) return SendError(playerid, "Ви не водій таксі.");
	RemovePlayerMapIcon(playerid,iconTaxi);
	SendOK(playerid, "Мітка прибрана з карти.");
	return 1;
}
CMD:bl(playerid) {
	if(!CI[playerid][pMember]) return 1;
	if(CI[playerid][pRank] < FI[CI[playerid][pMember]][sRank]) {
		new string[128];
		format(string, sizeof(string), "Доступно з %i рангу.", FI[CI[playerid][pMember]][sRank]);
		return SendError(playerid, string);
	}
	ShowPlayerDialog(playerid, D_BL, DSL, P"Чорний список.", P"1."W" Внести в ЧС\n"P"2."W" Винести з ЧС\n"P"3."W" Очистити повний список ЧС\n"P"4."W" Список занесених в ЧС", "Обрати", "Закрити");
	return 1;
}
CMD:offmembers(playerid) {
	if(!CI[playerid][pLeader]) return 1;
	ShowPlayerDialog(playerid, d_offmembers_selection, DSL, P"Члени організації.", P"1."W" Всі члени організації офлайн\n"P"2."W" Фільтр по рангу", "Обрати", "Скасувати");
	return 1;
}
CMD:lmenu(playerid) {
	if(!CI[playerid][pLeader]) return 1;
	new string[512];
	format(string, sizeof(string), P"1."W" Ранг керівника: "G"%s"W"\n"P"2."W" Банк фракції\n"P"3."W" Назви рангів\n"P"4."W" Склад офлайн\n"P"5."W" Чорний список\n%s",
		GetRankName(CI[playerid][pMember], FI[CI[playerid][pMember]][sRank]), IsAGang(playerid) ? P"6."W" Дипломатія" : "");
	return ShowPlayerDialog(playerid, D_LMENU, DSL, P"Панель лідера.", string, "Обрати", "Закрити");
}
alias:lmenu("lpanel")
CMD:changecar(playerid,params[]) {
	if(!CI[playerid][pRoom] && !CI[playerid][pHouse]) return SendError(playerid, "У вас немає транспорт.");
	new giveplayerid, car_1, car_2, price;
	if(sscanf(params, "dddd", giveplayerid, car_1,car_2, price)) {
		SendError(playerid, "Використайте: /changecar [playerid] [your vehicle slot] [player vehicle slot] [player's surcharge]");
		new string[144];
		format(string, sizeof(string), "Слот #1 [%s]. Слот #2 [%s].", gTransport[CarsInfo[playerid][carModel][0]-400][trName], gTransport[CarsInfo[playerid][carModel][1]-400][trName]);
		SendError(playerid, string);
		return 1;
	}
	if(!CI[giveplayerid][pHouse] && !CI[giveplayerid][pRoom]) return SendError(playerid, "У гравця немає транспорт.");
	if((car_1 < 1 && car_1 > 2) || (car_2 < 1 && car_2 > 2)) return 1;
	new model = GetVehicleModel(house_car[playerid][car_1-1]);
	if(!model) return SendError(playerid, "Вигоніть автомобіль на вулицю.");
	if(price < 1 || price > 15000000) return SendError(playerid, "Не можна менше $1 і більше $15.000.000.");
	if(!IsPlayerStream(5.0, playerid, giveplayerid)) return SendError(playerid, "Гравець не поруч з вами.");
	if(giveplayerid == playerid) return SendError(playerid, not_id);
	SetPVarInt(giveplayerid, "carProdaet", playerid + 1);
	SetPVarInt(playerid, "carPokupaet", giveplayerid + 1);
	SetPVarInt(giveplayerid, "carCena", price);
	SetPVarInt(playerid, "numbercar1", car_1);
	SetPVarInt(playerid, "numbercar2", car_2);
	SetPVarInt(playerid, "sellcar_type", 1);
	new improve[256];
	if(CarsInfo[giveplayerid][carVehcom_1][car_2-1]) strcat(improve, "\t\t\t[Спойлер]\n");
	if(CarsInfo[giveplayerid][carVehcom_2][car_2-1]) strcat(improve, "\t\t\t[Капот]\n");
	if(CarsInfo[giveplayerid][carVehcom_3][car_2-1]) strcat(improve, "\t\t\t[Повітрозабірник]\n");
	if(CarsInfo[giveplayerid][carVehcom_4][car_2-1]) strcat(improve, "\t\t\t[Бічна спідниця]\n");
	if(CarsInfo[giveplayerid][carVehcom_5][car_2-1]) strcat(improve, "\t\t\t[Фари]\n");
	if(CarsInfo[giveplayerid][carVehcom_6][car_2-1]) strcat(improve, "\t\t\t[Нітро]\n");
	if(CarsInfo[giveplayerid][carVehcom_7][car_2-1]) strcat(improve, "\t\t\t[Вихлопная труба]\n");
	if(CarsInfo[giveplayerid][carVehcom_8][car_2-1]) strcat(improve, "\t\t\t[Диски]\n");
	if(CarsInfo[giveplayerid][carVehcom_9][car_2-1]) strcat(improve, "\t\t\t[Стерео]\n");
	if(CarsInfo[giveplayerid][carVehcom_10][car_2-1]) strcat(improve, "\t\t\t[Гідравліка]\n");
	if(CarsInfo[giveplayerid][carVehcom_11][car_2-1]) strcat(improve, "\t\t\t[Передній бампер]\n");
	if(CarsInfo[giveplayerid][carVehcom_12][car_2-1]) strcat(improve, "\t\t\t[Задній бампер]\n");
	new improve2[256];
	if(CarsInfo[playerid][carVehcom_1][car_1-1]) strcat(improve2, "\t\t\t[Спойлер]\n");
	if(CarsInfo[playerid][carVehcom_2][car_1-1]) strcat(improve2, "\t\t\t[Капот]\n");
	if(CarsInfo[playerid][carVehcom_3][car_1-1]) strcat(improve2, "\t\t\t[Повітрозабірник]\n");
	if(CarsInfo[playerid][carVehcom_4][car_1-1]) strcat(improve2, "\t\t\t[Бічна спідниця]\n");
	if(CarsInfo[playerid][carVehcom_5][car_1-1]) strcat(improve2, "\t\t\t[Фари]\n");
	if(CarsInfo[playerid][carVehcom_6][car_1-1]) strcat(improve2, "\t\t\t[Нітро]\n");
	if(CarsInfo[playerid][carVehcom_7][car_1-1]) strcat(improve2, "\t\t\t[Вихлопна труба]\n");
	if(CarsInfo[playerid][carVehcom_8][car_1-1]) strcat(improve2, "\t\t\t[Диски]\n");
	if(CarsInfo[playerid][carVehcom_9][car_1-1]) strcat(improve2, "\t\t\t[Стерео]\n");
	if(CarsInfo[playerid][carVehcom_10][car_1-1]) strcat(improve2, "\t\t\t[Гідравліка]\n");
	if(CarsInfo[playerid][carVehcom_11][car_1-1]) strcat(improve2, "\t\t\t[Передній бампер]\n");
	if(CarsInfo[playerid][carVehcom_12][car_1-1]) strcat(improve2, "\t\t\t[Задній бампер]\n");
	new model1 = CarsInfo[playerid][carModel][car_1-1]-400;
	new model2 = CarsInfo[giveplayerid][carModel][car_2-1]-400;
	new classname[12];
	new classname2[12];
	GetCarClassName(gTransport[model1][trClass], classname);
	GetCarClassName(gTransport[model2][trClass], classname2);
	static const f_str[] = ""W"\t\t\tВаше авто:\n\n\
							"W"Марка авто: \t\t"P"%s\n\
							"W"Клас: \t\t\t"P"%s\n\
							"W"Пробіг: \t\t"P"%.0fкм\n\
							"W"Бензобак: \t\t"P"%dл\n\
							"W"Тюнінг:\n\
							"P"%s\n\n\
							"W"\t\t\tАвто іншого гравця:\n\n\
							"W"Марка авто: \t\t"P"%s\n\
							"W"Клас: \t\t\t"P"%s\n\
							"W"Пробіг: \t\t"P"%.0fкм\n\
							"W"Бензобак: \t\t"P"%dл\n\
							"W"Тюнінг:\n\
							"P"%s\n\n\
							"NO"Ви дійсно хочете запропонувати обмін з доплатою від іншого гравця у розмірі "GREEN"$%i"NO"?";
	new string[900];
	format(string, sizeof(string), f_str, gTransport[model1][trName], classname,CarsInfo[playerid][carDrived][car_1-1], gTransport[model1][trTank],improve2,
	gTransport[model2][trName], classname2,CarsInfo[giveplayerid][carDrived][car_2-1], gTransport[model2][trTank],improve,price);
	ShowPlayerDialog(playerid, D_CHANGECAR, DSM, P"Обмін авто.", string, "Так", "Скасувати");
	return 1;
}
set_string(param_1[], param_2[]) {
    strmid(param_1, param_2, 0, strlen(param_2), 255);
    return 1;
}
CMD:sellcar(playerid, params[]) {
	if(GetPVarInt(playerid, "car_pokupaet")) return SendError(playerid, "У вас активний обмін транспорт з гравцем.");
	if(!CI[playerid][pHouse] && !CI[playerid][pRoom] && !CI[playerid][pTempKey]) return SendError(playerid, "Ви не маєте будинку або квартири.");
	if(CI[playerid][pCredit]) return SendError(playerid, "У вас не виплачений кредит. Продаж транспорт заборонений.");
	if(!params[0]) {
		new string[128];
		format(string, sizeof(string), W"1. Транспорт #1 "P"[%s]\n"W"2. Транспорт #2 "P"[%s]", gTransport[CarsInfo[playerid][carModel][0]-400][trName], gTransport[CarsInfo[playerid][carModel][1]-400][trName]);
		ShowPlayerDialog(playerid, D_HOUSE_CARSELL, DSL, P"Продати домашній транспорт.", string, "Обрати", "Закрити");
		return 1;
	}
	if(sscanf(params, "uii", params[0], params[1], params[2])) return SendError(playerid, "Використайте: /sellcar [playerid] [1-2 vehicles] [price]");
	if(!IsPlayerConnected(params[0]) || playerid == params[0]) return SendError(playerid, not_id);
	if(!(1 <= params[1] < 2)) return SendError(playerid, "Номер автомобіля від 1 до 2.");
	if(GetPlayerDistanceToPlayer(playerid, params[0]) > 3.0 || GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld(params[0])) return SendError(playerid, "Ви далеко один від одного");
	new slot_car = -1, improve[256], model = CarsInfo[playerid][carModel][params[1] - 1] - 400, classname[12], string[400];
	for(new i; i < 2; i++) {
		slot_car = i;
		break;
	}
	if(slot_car == -1) return SendError(playerid, "У гравця немає вільних місць під автомобіль.");
	if(params[2] <= 0) return SendError(playerid, "Вартість автомобіля не може бути менше $1.");
	SetPVarInt(params[0], "car_prodaet", playerid + 1);
	SetPVarInt(playerid, "car_pokupaet", params[0] + 1);
	SetPVarInt(params[0], "carCena", params[2]);
	SetPVarInt(playerid, "carnumber", params[1] - 1);
	SetPVarInt(playerid, "sellcar", 1);
	if(CarsInfo[playerid][carVehcom_1][params[1]-1]) strcat(improve, "\t\t\t[Спойлер]\n");
	if(CarsInfo[playerid][carVehcom_2][params[1]-1]) strcat(improve, "\t\t\t[Капот]\n");
	if(CarsInfo[playerid][carVehcom_3][params[1]-1]) strcat(improve, "\t\t\t[Повітрозабірник]\n");
	if(CarsInfo[playerid][carVehcom_4][params[1]-1]) strcat(improve, "\t\t\t[Бічна спідниця]\n");
	if(CarsInfo[playerid][carVehcom_5][params[1]-1]) strcat(improve, "\t\t\t[Фари]\n");
	if(CarsInfo[playerid][carVehcom_6][params[1]-1]) strcat(improve, "\t\t\t[Нітро]\n");
	if(CarsInfo[playerid][carVehcom_7][params[1]-1]) strcat(improve, "\t\t\t[Вихлопна труба]\n");
	if(CarsInfo[playerid][carVehcom_8][params[1]-1]) strcat(improve, "\t\t\t[Диски]\n");
	if(CarsInfo[playerid][carVehcom_9][params[1]-1]) strcat(improve, "\t\t\t[Стерео]\n");
	if(CarsInfo[playerid][carVehcom_10][params[1]-1]) strcat(improve, "\t\t\t[Гідравліка]\n");
	if(CarsInfo[playerid][carVehcom_11][params[1]-1]) strcat(improve, "\t\t\t[Передній бампер]\n");
	if(CarsInfo[playerid][carVehcom_12][params[1]-1]) strcat(improve, "\t\t\t[Задній бампер]\n");
	GetCarClassName(gTransport[model][trClass], classname);
	format(string, sizeof(string), W"Марка авто: \t\t"P"%s\n\
							"W"Клас: \t\t\t"P"%s\n\
							"W"Пробіг: \t\t"P"%.0fкм\n\
							"W"Бензобак: \t\t"P"%dл\n\
							"W"Тюнінг:\n\
							"P"%s\n\n\
							"W"Ви хочете продати автомобіль гравцю "P"%s"W" за "GREEN"$%i"W"?", gTransport[model][trName], classname,CarsInfo[playerid][carDrived][params[1]-1], gTransport[model][trTank],improve, CI[params[0]][cName], params[2]);
	ShowPlayerDialog(playerid, D_SELL_CAR, DSM, P"Продаж автомобіля.", string, "Так", "Скасувати");
	return 1;
}
CMD:dropgun(playerid, param[]) {
	if(!TI[playerid][tLogin] && AntiCheatIsKickedWithDesync(playerid)) return 1;
	new weaponid = GetPlayerWeapon(playerid);
	if(weaponid != 24 && weaponid != 25 && weaponid != 26 && weaponid != 29 && weaponid != 30 && weaponid != 31 && weaponid != 33) return SendError(playerid, "Неможливо викинути заборонену зброю.");
	if(IsPlayerInAnyVehicle(playerid)) return 0;
	if(TI[playerid][tDuel] != -1) return 0;
	new ammo = GetPlayerAmmo(playerid);
	if(!weaponid) return 0;
	if(!ammo) return 0;
	if(weaponid < 1 || weaponid > 47) return SendError(playerid, "Зброя має знаходитись в руках.");
	DropGun(playerid, weaponid, ammo);
	return 1;
}
CMD:changeskin(playerid,params[]) {
	if(!CI[playerid][pMember]) return SendError(playerid, "Ви не перебуваєте в організації.");
	if(!start_work[playerid]) return SendError(playerid, "Необхідно розпочати робочий день.");
	new content[400];
	for(new i = 1; i < MAX_FACTION_SKINS; i++) {
		if(FI[CI[playerid][pMember]][fSkins][i]) format(content, sizeof(content), "%s"P"%i."W" Скін %i\n", content, i, FI[CI[playerid][pMember]][fSkins][i]);
	}
	return ShowPlayerDialog(playerid, dFractionSkin, DSL, P"|"W" Вибір скіна.", content, "Обрати", "");
}
stock HideMenuSave(playerid) {
	new query[200];
	mysql_format(connects, query, sizeof(query), "UPDATE "TABLE_CHARACTERS" SET `ahMenu0`= %i, `ahMenu1`= %i, `ahMenu2`= %i, `ahMenu3`= %i WHERE `Name` = '%s' LIMIT 1",
		ahMenu[playerid][0], ahMenu[playerid][1], ahMenu[playerid][2], ahMenu[playerid][3], CI[playerid][cName]);
	mysql_tquery(connects, query);
	return 1;
}
CMD:hidemenu(playerid) return HideMenu(playerid);
stock HideMenu(playerid) {
    if(!PI[playerid][pAdmin]) return 1;
    FSPD(playerid, 1285, DST, ""cServer"Hide Menu", "Обрати", "Закрити", ""cServer"[1]{FFFFFF} Сховати себе з /admins\t%s\n"cServer"[2]{FFFFFF} Сховати свій рівень з /admins\t%s\n"cServer"[3]{FFFFFF} Показати фейк рівень в /admins\t%s\n"cServer"[4]{FFFFFF} Підмінити свій нік\t%s",(ahMenu[playerid][0] == 0) ? ("{FF0000}| Деактивовано") : ("{00FF00}| Активовано"), (ahMenu[playerid][1] == 0) ? ("{FF0000}| Деактивовано") : ("{00FF00}| Активовано"), (ahMenu[playerid][2] == 0) ? ("{FF0000}| Деактивовано") : ("{00FF00}| Активовано"), (ahMenu[playerid][3] == 0) ? ("{FF0000}| Деактивовано") : ("{00FF00}| Активовано"));
    return 1;
}
CMD:rank(playerid, params[]) {
	if(!CI[playerid][pMember]) return SendError(playerid, "Ви не перебуваєте в організації.");
	if(!start_work[playerid]) return SendError(playerid, "Необхідно розпочати робочий день.");
	new string[512];
	if(CI[playerid][pRank] < FI[CI[playerid][pMember]][sRank]) {
		format(string, 128, "Доступно з %i рангу.", FI[CI[playerid][pMember]][sRank]);
		SendError(playerid, string);
		return 1;
	}
	if(sscanf(params, "u", params[0])) return SendError(playerid, "Використайте: /rank [playerid]");
	if(!IsPlayerConnected(params[0]) || params[0] == INVALID_PLAYER_ID) return SendError(playerid , not_id);
	if(CI[params[0]][pLeader] >= 1) return SendError(playerid, not_id);
	if(CI[playerid][pMember] != CI[params[0]][pMember]) return SendError(playerid, "Гравець не знаходиться у вашій організації.");
	if(CI[playerid][pRank] <= CI[params[0]][pRank]) return SendError(playerid, "Ваш ранг недостатній.");
	if(CI[playerid][pRank] == FI[CI[playerid][pMember]][lRank]) {
		for(new i = 1; i <= FI[CI[playerid][pMember]][lRank]; i++) {
			if(i>= CI[playerid][pRank]) break;
			format(string, sizeof(string), "%s%s%s (%i)\n", string,(CI[params[0]][pRank] == i) ? (""P"") : (""), GetRankName(CI[playerid][pMember],i),i);
			ShowPlayerDialog(playerid,dRank, DSL, P"Оберіть ранг", string, "Обрати", "Закрити");
		}
		SetPVarInt(playerid, "id_giverank",params[0]);
	} else if(CI[playerid][pRank] == FI[CI[playerid][pMember]][lRank]-(FI[CI[playerid][pMember]][lRank]-CI[playerid][pRank])) {
		for(new i = 1; i <= FI[CI[playerid][pMember]][lRank]; i++) {
			if(i>= CI[playerid][pRank]) break;
			format(string, sizeof(string), "%s%s%s (%i)\n", string,(CI[params[0]][pRank] == i) ? (""P"") : (""), GetRankName(CI[playerid][pMember],i),i);
			ShowPlayerDialog(playerid,dRank, DSL, P"Оберіть ранг.", string, "Обрати", "Закрити");
		}
		SetPVarInt(playerid, "id_giverank", params[0]);
	}
	return 1;
}
alias:rank("giverank")
CMD:f(playerid, params[]) {
	if(CI[playerid][pMember] == 0) return SendError(playerid, "У вас немає доступу до цієї команди.");
	new result[128], string[256];
	if(sscanf(params, "s[128]", result)) return SendError(playerid, "Використайте: /f [text]");
	if(CI[playerid][pFmute] > 0 || CI[playerid][pMute] > 0) return SendError(playerid, "Ви заглушені керівником або адміністратором.");
	format(string, sizeof(string), "(( [F] %s[%i]: %s ))", CI[playerid][cName], playerid, result);
	SendFactionMessage(CI[playerid][pMember], 0x569CD6FF, string);
	SendSpyMessage(CI[playerid][pMember], 0xFFFFCCFF, string);
	foreach(new i:Player) if(GetPVarInt(i, "admin_tipster") == CI[playerid][pMember]) SendClientMessage(i, 0xFFFFCCFF, string);
	return 1;
}
CMD:r(playerid, params[]) {
	if(!GetItemAmount(playerid, 492)) return SendError(playerid, "У вас немає рації.");
	new result[128];
	if(sscanf(params, "s[128]", result)) return SendError(playerid, "Використайте: /r [text]");
	if(CI[playerid][pFmute] > 0 || CI[playerid][pMute] > 0) return SendError(playerid, "Ви заглушені керівником або адміністратором.");
	if(TI[playerid][tGag]) return SendError(playerid, "У вас кляп в роті.");
	if(!CI[playerid][cRadioChannel]) return SendError(playerid, "Налаштуйте свою рацію.");
	SendRadioMessage(playerid, result, CI[playerid][cRadioChannel], 0);
	return 1;
}
CMD:rr(playerid, params[]) {
	if(!GetItemAmount(playerid, 492)) return SendError(playerid, "У вас немає рації.");
	new result[128];
	if(sscanf(params, "s[128]", result)) return SendError(playerid, "Використайте: /rr [text]");
	if(CI[playerid][pFmute] > 0 || CI[playerid][pMute] > 0) return SendError(playerid, "Ви заглушені керівником або адміністратором.");
	if(TI[playerid][tGag]) return SendError(playerid, "У вас кляп в роті.");
	if(!CI[playerid][cRadioChannel]) return SendError(playerid, "Налаштуйте свою рацію.");
	SendRadioMessage(playerid, result, CI[playerid][cRadioChannel], CI[playerid][cRadioSlot]);
	return 1;
}
CMD:d(playerid, params[]) {
	if(!IsState(playerid)) return 1;
	if(!GetItemAmount(playerid, 492)) return SendError(playerid, "У вас немає рації.");
	new result[128], string[256];
	if(sscanf(params, "s[128]", result)) return SendError(playerid, "Використайте: /d [text]");
	if(CI[playerid][pFmute] > 0 || CI[playerid][pMute] > 0) return SendError(playerid, "Ви заглушені керівником або адміністратором.");
	if(TI[playerid][tGag]) return SendError(playerid, "У вас кляп в роті.");
	format(string, sizeof(string), "[%s] %s %s: %s", FI[CI[playerid][pMember]][fName], GetRankName(CI[playerid][pMember], CI[playerid][pRank]), CI[playerid][cName], result);
	SendDeptMessage(COLOR_MINJUST, string);
	SendSpyMessage(CI[playerid][pMember], 0xADFFEFFF, string);
	foreach(new i:Player) {
		if(PI[i][pAdmin] < 1 || GetPVarInt(i, "adminaccess") == 0) continue;
		switch(GetPVarInt(i, "admin_tipster")) {
			case 1-13, 23: SendClientMessage(i, COLOR_MINJUST, string);
		}
	}
	return 1;
}
CMD:db(playerid, params[]) {
	if(!IsState(playerid)) return 1;
	if(!GetItemAmount(playerid, 492)) return SendError(playerid, "У вас немає рації.");
	new result[128], string[256];
	if(sscanf(params, "s[128]", result)) return SendError(playerid, "Використайте: /db [text]");
	if(CI[playerid][pFmute] > 0 || CI[playerid][pMute] > 0) return SendError(playerid, "Ви заглушені керівником або адміністратором.");
	format(string, sizeof(string), "[%s] %s %s: (( %s ))", FI[CI[playerid][pMember]][fName], GetRankName(CI[playerid][pMember], CI[playerid][pRank]), CI[playerid][cName], result);
	SendDeptMessage(COLOR_MINJUST, string);
	SendSpyMessage(CI[playerid][pMember], 0xADFFEFFF, string);
	return 1;
}
CMD:vipchat(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	if(GetPVarInt(playerid, "adm_vip")) {
		DeletePVar(playerid, "adm_vip");
		SendOK(playerid, "Прослушка VIP чату вимкнена.");
	} else SetPVarInt(playerid, "adm_vip", 1),SendOK(playerid, "Прослушка VIP чату увімкнена.");
	return 1;
}
CMD:v(playerid,params[]) {
	if(!CI[playerid][pPremium]) return 1;
	if(CI[playerid][pMute] > 0) return SendError(playerid, "У вас бан чату.");
	if(isnull(params) || strlen(params) > 144) return SendError(playerid, "Використайте: /v [text]");
	new string[128];
	format(string, sizeof(string), "[VIP] %s[%i]: %s", CI[playerid][cName], playerid,params);
	SendVip(COLOR_BLUE, string);
	return 1;
}
CMD:heal(playerid, params[]) {
	if(!IsAMedic(playerid) || !start_work[playerid]) return SendError(playerid, "Ви не медик.");
	if(CI[playerid][pRank] < 2) return SendError(playerid, "Команда доступна з 2 рангу.");
	new model = GetVehicleModel(GetPlayerVehicleID(playerid));
	if(model != 416 && model != 487 && !IsPlayerInRangeOfPoint(playerid, 70, 2187.6946, 571.4658, 1080.4542) && !IsPlayerInRangeOfPoint(playerid, 70, 1554.4142, 505.6061, 1070.4346)&& !IsPlayerInRangeOfPoint(playerid, 50, 309.7332, 2060.8398, 1014.3731)) return SendError(playerid, "Необхідно знаходитись в служебном транспорте/больнице");
	if(sscanf(params, "ud",params[0],params[1])) return SendError(playerid, "Використайте: /heal [playerid] [price]");
	if(params[1] < 50 || params[1] > 150) return SendError(playerid, "Вартість повинна бути від $50 до $150.");
	if(!ProxDetectorS(5.0, playerid, params[0])) return SendError(playerid, "Гравець дуже далеко від вас.");
	if(playerid == params[0]) return SendError(playerid, "Ви не можете вилікувати самого себе.");
	if(!IsPlayerInVehicle(params[0], GetPlayerVehicleID(playerid)) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER) return SendError(playerid, "Цей гравець не в вашій машині.");
	if(HealOffer[params[0]] == playerid) return SendError(playerid, "Ви вже запропонували лікування цьому гравцю.");
	new Float:health;
	GetPlayerHealth(params[0],health);
	if(health >= 100) return SendError(playerid, "Гравець здоровий.");
	HealOffer[params[0]] = playerid;
	HealPrice[params[0]] = params[1];
	new string[128];
	format(string, sizeof(string), "Ви запропонували лікування гравцю "P"%s"W" за "GREEN"$%i"W".", CI[params[0]][cName],params[1]);
	SendOK(playerid, string);
	format(string, sizeof(string), "Лікар "P"%s"W" хоче вас вилікувати за "GREEN"$%i"W".", CI[playerid][cName],params[1]);
	SendHint(params[0], string);
	SendHint(params[0], "Натисніть "YES"Y"W" щоб погодитися, або "NO"N"W" для відмови.");
	return 1;
}
CMD:theftskill(playerid) {
	new str[250];
	format(str, sizeof(str), "\t"P"Навичка автовикрадача"W"\n\nЩоб підвищити навичку автовикрадача, треба частіше виконувати завдания\nпо автовикраденню.\n\n\
	Навичка автовикрадача:"P" [%i/3]\n"W"Викрадено автомобілей: "P"%i", CI[playerid][pTheftlvl], CI[playerid][pTheftExp]);
	ShowPlayerDialog(playerid, DIALOG_NONE, DSM, " ", str, "Закрити", "");
}
CMD:theft(playerid) {
	if(thef_timer[playerid] == -1) return SendError(playerid, "Ви не починали викрадення транспорта.");
	ShowPlayerDialog(playerid, D_THEFT_LIST, DSL, P"Автовикрадення.", P"1."W" Зламати автомобіль відмичкою.\n"P"2."W" Завести двигун.\n"P"3."W" Оновити координати автомобіля.\n"P"4."W" Відлючити сигналізацію.", "Обрати", "Скасувати");
	return 1;
}
CMD:inv(playerid) {
	if(GetPVarInt(playerid, "inv") || GetPVarInt(playerid, "get_class") || GhettoInfo[playerid][GhettoGUI] || BJ_PlayerInfo[playerid][pBlackJackTableID] > 0 || JobTempProcess[playerid] || TI[playerid][tProcess][0] != -1 || PhoneShow[playerid]) return SendError(playerid, "Помилка");
	if(GetPVarInt(playerid, "ppkz")) for(new t = 0; t < 34; t++) TextDrawHideForPlayer(playerid, Capture[t]);
	PlayerTextDrawSetPreviewModel(playerid, nInventory_TD[playerid][2], GetPlayerSkin(playerid));
	DeletePVar(playerid, "block_inv");
	SetPVarInt(playerid, "inv", 1);
	InvPage[playerid] = 0;

	for (new i;	i < 15; i++) {
		if(3 <= i <= 8) continue;
		if(11 <= i <= 12) continue;
		PlayerTextDrawShow(playerid, nInventory_TD[playerid][i]);
	}
	for(new i; i < 25; i++) {
		new ID = CI[playerid][pInventory][i];
		PlayerTextDrawSetPreviewModel(playerid, nInventorySlots_TD[playerid][i], ItemsInfo[ID][ItemModel]);
		PlayerTextDrawSetPreviewRot(playerid, nInventorySlots_TD[playerid][i], ItemsInfo[ID][POSTDx], ItemsInfo[ID][POSTDy], ItemsInfo[ID][POSTDz], ItemsInfo[ID][POSTDc]);
		PlayerTextDrawBackgroundColor(playerid, nInventorySlots_TD[playerid][i], 0x222222ff); // Дефолт промальовка.
		PlayerTextDrawShow(playerid, nInventorySlots_TD[playerid][i]);
	}
	SelectTextDraw(playerid, 0x808080ff);
	return 1;
}
CMD:lock(playerid, params[]) {
	new check_car = INVALID_VEHICLE_ID;
	if(TI[playerid][tMoped] != INVALID_VEHICLE_ID) check_car = TI[playerid][tMoped];
	if(TI[playerid][tBoat] != INVALID_VEHICLE_ID) check_car = TI[playerid][tBoat];
	if(GetPVarInt(playerid, "burger_vehid") != 0) return ToggleDoors(GetPVarInt(playerid, "burger_vehid"), playerid);
	if(check_car != INVALID_VEHICLE_ID) return ToggleDoors(check_car, playerid);
	if(GetPlayerVehicles(playerid)) {
		ToggleDoors(PlayerTrailer[playerVehicleID[playerid]][carVehicle], playerid);
		trailer_text(playerVehicleID[playerid]);
		return 1;
	}
	if(TI[playerid][tArendKey] != -1) {
		if(ArendInfo[TI[playerid][tArendKey]][aPlayerID] != playerid) return 1;
		return ToggleDoors(ArendInfo[TI[playerid][tArendKey]][aID], playerid);
	}
	if(CI[playerid][pFamily]) {
		for(new i = 0; i < 5; i++) {
			if(CarFamily[CI[playerid][pFamily]-1][i][LoadCar] == INVALID_VEHICLE_ID) return ToggleDoors(CarFamily[CI[playerid][pFamily]-1][i][LoadCar], playerid);
		}
	}
	if(CI[playerid][pMember] > 0 && VehicleInfo[GetNearestVehicle(playerid)][vTeam] == CI[playerid][pMember]) return ToggleDoors(GetNearestVehicle(playerid), playerid);
	ToggleDoors(house_car[playerid][GetNearestCar(playerid)], playerid);
	return 1;
}
CMD:light(playerid, const params[]) {
	if(!IsPlayerInAnyVehicle(playerid)) return 0;
	if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return 0;
	new carid = GetPlayerVehicleID(playerid);
	if(IsAVelik(carid)) return 0;
	ToggleLights(carid, playerid);
	return 1;
}
alias:light("l")
CMD:unrent(playerid) {
	if(TI[playerid][tArendaCar] != -1) {
		if(GetPVarInt(playerid, "bus_id")) SetVehicleToRespawn(GetPVarInt(playerid, "bus_id")), DeletePVar(playerid, "bus_id");
		else if(GetPVarInt(playerid, "mehjob")) SetVehicleToRespawn(GetPVarInt(playerid, "mehjob")), DeletePVar(playerid, "mehjob");
		else if(GetPVarInt(playerid, "prod_vehicle_id")) SetVehicleToRespawn(GetPVarInt(playerid, "prod_vehicle_id")), DeletePVar(playerid, "prod_vehicle_id");
		else if(GetPVarInt(playerid, "eatjob")) SetVehicleToRespawn(GetPVarInt(playerid, "eatjob")), DeletePVar(playerid, "eatjob");
		else if(GetPVarInt(playerid, "clear_id")) SetVehicleToRespawn(GetPVarInt(playerid, "clear_id")), DeletePVar(playerid, "clear_id");
		else if(GetPVarInt(playerid, "veh_id_cleaner")) SetVehicleToRespawn(GetPVarInt(playerid, "veh_id_cleaner")), DeletePVar(playerid, "veh_id_cleaner");
		else if(GetPVarInt(playerid, "inc_start")) SetVehicleToRespawn(GetPVarInt(playerid, "veh_id_inc")), DeletePVar(playerid, "veh_id_inc");
		else if(GetPVarInt(playerid, "clear_id")) EndClear(playerid);
		else if(GetPVarInt(playerid, "veh_id_taxi")) EndTaxi(playerid);
		TI[playerid][tArendaCar] = -1;
		SendOK(playerid, "Ви відмовились від оренди робочого транспорта.");
		return 1;
	}
	if(GetPVarInt(playerid, "burger_vehid") != 0) {
		A_DestroyVehicle(GetPVarInt(playerid, "burger_vehid"));
		DeletePVar(playerid, "burger_vehid");
		SendOK(playerid, "Ви відмовились від оренди скутера.");
		return 1;
	}
	if(TI[playerid][tMoped] != INVALID_VEHICLE_ID) {
		A_DestroyVehicle(TI[playerid][tMoped]);
		TI[playerid][tMoped] = INVALID_VEHICLE_ID;
		SendOK(playerid, "Ви відмовились від оренди мопеда.");
		return 1;
	}
	if(TI[playerid][tBoat] != INVALID_VEHICLE_ID) {
		A_DestroyVehicle(TI[playerid][tBoat]);
		TI[playerid][tBoat] = INVALID_VEHICLE_ID;
		SendOK(playerid, "Ви відмовились від оренди човна.");
		return 1;
	}
	if(TI[playerid][tArendKey] == -1) return SendError(playerid, "Ви не орендуєте транспорт.");
	new rc = TI[playerid][tArendKey];
	if(ArendInfo[rc][aPlayerID] != playerid) return SendError(playerid, "Ви не орендуєте транспорт.");
	TI[playerid][tArendKey] = -1;
	SendOK(playerid, "Ви відмовились від оренди транспорта.");
	ArendInfo[rc][aPlayerID] = INVALID_PLAYER_ID;
	SetVehicleToRespawn(ArendInfo[rc][aID]);
	return 1;
}
CMD:prods(playerid) {
	if(GetPVarInt(playerid, "prod_vehicle_id") == GetPlayerVehicleID(playerid) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
		ShowPlayerDialog(playerid, dProdList, DSL, P"Продукти.", P"1."W" Список бізнесів\n"P"2."W" Купити продукти", "Обрати", "Скасувати");
		return 1;
	} else SendError(playerid, "Ви не в машині для розвезення продуктів та палива.");
	return 1;
}
CMD:namestore(playerid, params[]) {
	if(PI[playerid][pAdmin] < 1 || GetPVarInt(playerid, "adminaccess") != 1) return 1;
	new inection[30];
	if(sscanf(params, "s[30]", params[0])) return SendError(playerid, "Використайте: /namestore [name]");
	mysql_escape_string(params[0], inection, 128);
	new query[110];
	mysql_format(connects, query, sizeof(query), "SELECT `cID` FROM "TABLE_CHARACTERS" WHERE `Name` = '%e' LIMIT 1",inection);
	mysql_tquery(connects, query, "namestore_callback", "i", playerid);
	return 1;
}
CB:top_talon(playerid) {
	new rows, player[24], talon, count, string[500];
	cache_get_row_count(rows);
	if(!rows) return SendError(playerid, "Рейтинг членів сім'ї відсутній.");
	strcat(string, W"Ім'я гравця\t"W"Талонів\n");
	if(rows) {
		for(new i; i < rows; i ++) {
			cache_get_value_name(i, "Name", player, 24);
			cache_get_value_name_int(i, "talon_fam", talon);
			format(string, sizeof(string), "%s%i. %s\t%i\n", string, i + 1, player, talon);
			count++;
		}
		ShowPlayerDialog(playerid, DIALOG_NONE, DSTH, P"Рейтинг членів сім'ї.", string, "Закрити", "");
	}
	if(!count) SendError(playerid, "Рейтинг членів сім'ї відсутній.");
	return 1;
}
CB:family_offline(playerid) {
	new rows, string[1500], family, online_s[36], player[24], Cache:result, count = 0, rang;
	cache_get_row_count(rows);
	if(!rows) return SendError(playerid, "Список членов сім'ї офлайн пуст");
	strcat(string, W"Ім'я гравця\t"W"Ранг\t"W"Бул у мережі\nНаступна сторінка\nПопередня сторінка\n");
	if(rows) {
		for(new i; i < rows; i ++) {
			cache_get_value_name(i, "Name", player, 24);
			cache_get_value_name_int(i, "family", family);
			cache_get_value_name_int(i, "pFamRank", rang);
			cache_get_value_name(i, "pOnline", online_s, 36);
			format(string, sizeof(string), "%s"ORANGE"%i."W" %s\t%s\t%s\n", string, i+PageFirst[playerid][0]+ 1,player, GetFamName(CI[playerid][pFamily]-1, rang), online_s);
			count++;
		} 
		ShowPlayerDialog(playerid, D_FAMILY_OFFLINE, DSTH, P"Офлайн члени сім'ї", string, "Далі", "Закрити");
	}
	if(count == 0) SendError(playerid, "Список членів сім'ї офлайн закончился.");
	cache_delete(result);
	return 1;
}
CB:bl_callback_4(playerid) {
	new rows, string[1500], count, name[24], reason[50],
Cache:result, date_[30];
	cache_get_row_count(rows);
