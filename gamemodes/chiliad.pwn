	new string[144];
	foreach(new i:Player) {
		if(!TI[i][tLogin]) continue;
		if(GetPVarInt(i, "tipster_listen") == fraca && GetPVarInt(i, "tipster_listen") > 0) {
			format(string, sizeof(string), "[TIPSTER] %s", mes);
			SendClientMessage(i, color, string);
		}
