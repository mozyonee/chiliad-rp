	new query[156];
	mysql_format(connects, query, sizeof(query), "UPDATE "TABLE_CHARACTERS" SET `licenses` = '%i,%i,%i,%i' WHERE `cID` = %i", lic[playerid][0],lic[playerid][1],lic[playerid][2],lic[playerid][3], CI[playerid][cID]);
