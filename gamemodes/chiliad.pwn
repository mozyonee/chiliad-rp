						new name[44],rows, end_zahv, zahv, count, string[750], query[200];
						format(query, sizeof(query), "SELECT `Name`,`zahvat` FROM "TABLE_CHARACTERS" WHERE `zahvat` > 0 AND `pMember` = %i ORDER BY `zahvat` DESC", CI[playerid][pMember]);
						new Cache:result = mysql_query(connects, query);
						cache_get_row_count(rows);
						if(rows) {
							string = ""W"Ім'я гравця\t"W"Вбивств\n";
							static const f_str[] = "%i. %s\t%i\n";
							new str[sizeof(f_str) + 1 + (-2 + MAX_PLAYER_NAME) + (-2 + 7)];
							for(new i; i < rows; i ++) {
								cache_get_value_name(i, "Name", name, 44);
								cache_get_value_name_int(i, "zahvat", zahv);
								if(end_zahv == zahv || count == 10) continue;
								end_zahv = zahv;
								count++;
								format(str, sizeof(str), f_str, count, name, zahv);
								strcat(string, str);
							}
							ShowPlayerDialog(playerid, D_FAQ_MAFIA_1, DSTH, P"Рейтинг загарбників.", string, "Закрити", "");
						}
						if(count == 0) return ShowPlayerDialog(playerid, DIALOG_NONE, DSM, P"Рейтинг загарбників.", W"Кращих загарбників не знайдено", "Закрити", "");
						cache_delete(result);
					}
				case 1: {
						new mas[9] = {25, 26, 27, 28, 29, 30, 31, 32, 33},num=0, string[750];
						new skr[750];
						for(new i;i < 9;i++) {
							if(AcceptQuest[playerid][mas[i]]==0) skr = ""GREEN"Активний"W"";
							else if(QuestProgress[playerid][mas[i]] == 100) skr = ""NO"Виконано"W"";
							else if(QuestProgress[playerid][mas[i]] == QI[mas[i]][LastProgress] && AcceptQuest[playerid][mas[i]]!=0) skr = ""P"Можна завершити"W"";
							else if(QuestProgress[playerid][mas[i]] >= 0 && AcceptQuest[playerid][mas[i]] != 0) skr = ""G"У процесі"W"";
							format(string, sizeof(string), "%s%s [%s]\n", string, QI[mas[i]][QuestName],skr);
							QuestShow[playerid][num] = mas[i];
							num++;
						}
						ShowPlayerDialog(playerid, D_QUEST_MAFIA, DSL, P"Квести.", string, "Обрати", "Скасувати");
					}
				case 2: ShowPlayerDialog(playerid, D_FAQ_MAFIA_2, DSL, P"Чим зайнятися в мафії?", P"1."W" Пограбування банку\n"P"2."W" Викрадення транспорту\n"P"3."W" Викрадення людини\n"P"4."W" Дуелі та DM зони\n"P"5."W" AirDrop", "Обрати", "Закрити");
				}
			}
