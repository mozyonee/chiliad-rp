public OnPlayerCommandText(playerid, cmdtext[])
{
        if(strcmp("/sm", cmdtext, true, 10) == 0)
        {
            SetPlayerPos(playerid,714.5898, -1352.8984, 13.5513);
            SetPlayerInterior(playerid, 0);
            return 1;
        }
        return 0;
}

