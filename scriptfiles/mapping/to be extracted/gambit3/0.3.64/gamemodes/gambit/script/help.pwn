	{ ""cBLUE"/cuff [ ID ] {ffffff}- Надеть наручники.\n\
		"cBLUE"/uncuff [ ID ] {ffffff}- Снять наручники.\n\
		"cBLUE"/attach [ ID ] {ffffff}- Вести кого-то за собой.\n\
		"cBLUE"/unattach [ ID ] {ffffff}- Прекратить вести кого-то за собой.\n\
		"cBLUE"/arrest [ ID ] {ffffff}- Арестовать кого-то. ( Около камер )\n\
		"cBLUE"/givelic [ ID ] [ стоимость ] {ffffff}- выдать лицензи\n\
		"cBLUE"/su [ ID ] [ кол-во зв. ] {ffffff}- Подать в розыск какого-либо человека.\n\
		"cBLUE"/unsu {ffffff}- Снять розыск с человека.\n\
		"cBLUE"/bk [ ID ] {ffffff}- Вызвать подкрепление.\n\
		"cBLUE"/unbk [ ID ] {ffffff}- Отменить подкрепление.\n\
		"cBLUE"/wanted {ffffff}- список преступников.\n\
		"cBLUE"/callsign {ffffff}- маркировка автомобиля.\n\
		"cBLUE"/spu {ffffff}- Установить/убрать мигалку с транспорта.\n\
		"cBLUE"/taser {ffffff}- Достать/убрать тазер.\n\
		"cBLUE"/copattach {ffffff}- Взять одежду\n" }// 8 SASD
};
new help_select[MAX_PLAYERS][15], help_pcat[MAX_PLAYERS][15];

stock showHelp( playerid, type ) {
	new slot;
	for( new i; i < sizeof help_category; i++ ) {
		if( help_category[i][help_type] == type && help_category[i][help_cat] == 0 ) {
			format( vb_string, sizeof vb_string, "%s%d. %s\n", vb_string, slot + 1, help_category[i][help_text] );
			help_select[playerid][slot] = i;
			slot++;
		}
	}
	setData( playerid, "Player:HelpType", type );
	format( gb_string, sizeof gb_string, "%s", type ? ("Команды сервера"):("Помощь по игре") );
	showPlayerDialog( playerid, d_help + type, DIALOG_STYLE_LIST, gb_string, vb_string, "Выбор", "Выйти" );
	return true;
}	

hook OnDialogResponse( playerid, dialogid, response, listitem, inputtext[] ) {
	if( dialog_cheat_use[playerid] == true ) return true;
	new type = getData( playerid, "Player:HelpType" );
	switch( dialogid ) {
		case d_help: {
			if( !response ) return delData( playerid, "Player:HelpType" );
			new slot;
			for( new i; i < sizeof help_category; i++ ) {
				if( help_category[i][help_type] == type && help_category[i][help_cat] == listitem + 1 ) {
					format( vb_string, sizeof vb_string, "%s%d. %s\n", vb_string, slot + 1, help_category[i][help_text] );
					help_select[playerid][slot] = i;
					help_pcat[playerid][slot] = listitem + 1;
					slot++;
				}
			}
			showPlayerDialog( playerid, d_help + 3, DIALOG_STYLE_LIST, "Помощь по игре", vb_string, "Выбор", "Выйти" );
		}
		case d_help + 1: {
			if( !response ) return delData( playerid, "Player:HelpType" );
			for( new i; i < sizeof help; i++ ) {
				if( help[i][help_type] == type && help[i][help_id] == listitem ) {
					format( gb_string, sizeof gb_string, "%s", help_category[ help_select[playerid][listitem] ][help_text] );
					showPlayerDialog( playerid, d_help + 2, DIALOG_STYLE_MSGBOX, gb_string, help[i][help_text], "Назад", "" );
				}
				else if( help[i][help_type] == type && listitem == 4 ) {
					showPlayerDialog( playerid, d_help + 2, DIALOG_STYLE_MSGBOX, "Организация", help_frac[ Player[playerid][uMember] ], "Назад", "" );
				}
				else if( help[i][help_type] == type && listitem == 5 ) {// Job
					showPlayerDialog( playerid, d_help + 2, DIALOG_STYLE_MSGBOX, "Работа", help_job[ Player[playerid][uJob] ], "Назад", "" );
				}
			}
		}
		
		case d_help + 2: showHelp( playerid, 1 );
		case d_help + 3: {
			if( !response ) return showHelp( playerid, 0 );
			
			for( new i; i < sizeof help; i++ ) {
				if( help[i][help_cat] == help_pcat[playerid][listitem] && 
					help[i][help_type] == type && help[i][help_id] == listitem ) {
					format( gb_string, sizeof gb_string, "%s", help_category[ help_select[playerid][listitem] ][help_text] );
					showPlayerDialog( playerid, d_help + 4, DIALOG_STYLE_MSGBOX, gb_string, help[i][help_text], "Назад", "" );
				}
			}	
		}
		case d_help + 4: showHelp( playerid, 0 );
	}
	return true;
}