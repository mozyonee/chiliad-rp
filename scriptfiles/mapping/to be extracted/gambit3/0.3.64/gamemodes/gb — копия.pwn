public OnPlayerLeaveDynamicArea(playerid, areaid)
{
    foreach(new i: Player) {
        if(!GetPVarInt(playerid,"uLogin")) continue;
		if(areaid == GetPVarInt(i, "BBArea"))
		{
			StopAudioStreamForPlayer(playerid);
			break;
		}
	}
	for(new i = TOTALFIRE[0]; i <= TOTALFIRE[1]; i++)
 	{
 	    if(!FireSystem[i][fStatus]) continue;
	 	if(areaid == FireSystem[i][fZone]) {
            if(GetPVarInt(playerid,"FireTimerr")) {
				KillTimer(GetPVarInt(playerid,"FireTimerr"));
				DeletePVar(playerid,"FireTimerr");
			}
			if(GetPlayerSkin(playerid) == 277 || GetPlayerSkin(playerid) == 278 || GetPlayerSkin(playerid) == 279)
		 	{
		 	    SetPVarInt(playerid, "FireBar", 0);
				HidePlayerProgressBar(playerid, universalbar[playerid]);
				DestroyPlayerProgressBar(playerid, universalbar[playerid]);
			}
			break;
	 	}
	}
    if(ATMZone[0] <= areaid <= ATMZone[cBankomats-1]) SetPVarInt(playerid,"PlayerUseBankomat",0);
    if(PaynSpray[0] <= areaid <= PaynSpray[MAX_PAYNSPRAY-1]) SetPVarInt(playerid,"playerUsePaynSpray",0);
	if(areaid == strZones[0]) {
		if(D::[playerid][dFermClassDuty] != 0) {
			SendClientMessage(playerid,C_GRAY,""gbInfo"Вернитесь на территорию фермы, иначе Ваш рабочий день будет закончен.");
			SetPVarInt(playerid,"TimerCountFerm",MAX_COUNT_FERM_ZONE);
		}
    }
    if(areaid == strZones[10]) {
		if(D::[playerid][dWoodsDuty] != 0) {
			SendClientMessage(playerid,C_GRAY,""gbInfo"Вернитесь на территорию лесопилки, иначе Ваш рабочий день будет закончен.");
			SetPVarInt(playerid,"TimerCountWoods",MAX_COUNT_WOOD_ZONE);
		}
    }
    if(areaid == strZones[4]) {
        if(PlayerTrailer[playerid] != -1) {
            if(GetVehicleTrailer(GetPlayerVehicleID(playerid)) != PlayerTrailer[playerid]) {
            	V::[PlayerTrailer[playerid]][vWoods] = 0;
				V::[PlayerTrailer[playerid]][vUrojai] = 0;
				V::[PlayerTrailer[playerid]][vMebel] = 0;
				V::[PlayerTrailer[playerid]][vToplivo] = 0;
            	DestroyVehicle(PlayerTrailer[playerid]);
            	
            	if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]))
	    			DestroyDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]);
	    			
	    		SetPVarInt(playerid,"dettachTrailer",0);
        		PlayerTrailer[playerid] = -1;
				DisablePlayerCheckpoint(playerid);
        		return SendClientMessage(playerid,C_GRAY,""gbError"Вы оставили свой прицеп на месте аренды. (( Прицеп был удалён. ))");
        	}
        }
    }
    if(areaid == strZones[5]) {
        if(PlayerTrailer[playerid] != -1 && V::[GetPlayerVehicleID(playerid)][vDalnDriver] == playerid) {
            if(GetPVarInt(playerid,"PlayerSelectTrailerTwo") == 2) {
                if(GetPVarInt(playerid,"SelectedToplivoMarsh") == 0) {
              		V::[PlayerTrailer[playerid]][vWoods] = 0;
					V::[PlayerTrailer[playerid]][vUrojai] = 0;
					V::[PlayerTrailer[playerid]][vMebel] = 0;
					V::[PlayerTrailer[playerid]][vToplivo] = 0;
                    DestroyVehicle(PlayerTrailer[playerid]);
                    
                    if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]))
	    				DestroyDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]);
	    			
	    			SetPVarInt(playerid,"dettachTrailer",0);
        			PlayerTrailer[playerid] = -1;
					DisablePlayerCheckpoint(playerid);
        			return SendClientMessage(playerid,C_GRAY,""gbError"Вы не выбрали ни одного маршрута для доставки топлива.");
                }
            }
        }
    }
    if(areaid == strZones[1]) {
		SetPVarInt(playerid,"PlayerInFermZone",0);
		if(GetPVarInt(playerid,"CheckpointFermaPole")) DisablePlayerRaceCheckpoint(playerid);
	}
	
	/*for(new i; i != MAX_VEHICLES; i ++) {
    	if(!IsValidVehicle(i)) continue;
    	if(V::[i][vMusinInCar][1] == 0) continue;
    	if(!IsValidDynamicArea(V::[i][vMusinInCar][0])) continue;
    	if(areaid == V::[i][vMusinInCar][0])
    	{
    	   	StopStream(playerid);
    	    break;
    	}
	}
	for(new i; i != cBizz; i ++) {
	    if(!Bizz::[i][bMusicON]) continue;
	    if(!IsValidDynamicArea(Bizz::[i][bMusicZone])) continue;
		if(areaid == Bizz::[i][bMusicZone])
		{
   			StopStream(playerid);
    		break;
		}
	}
	*/
	return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    if(GetPVarInt(playerid, "DialogID") != dialogid) return 1;
	SetPVarInt(playerid, "DialogID", -2);

	strreplace(inputtext, '%', '#');
	strreplace(inputtext, '\n', '#');

	if(GetPVarInt(playerid, "DialogHider") != 1)
	{
	    SendClientMessage(playerid, -1, "Вы кикнуты по подозрению в читерстве {F81414}(DialogHider)");
	    if(!U::[playerid][uAdmin]) NewKick(playerid);
	    return true;
	}
	else SetPVarInt(playerid, "DialogHider", 0);

    new string[1024], str[512], query[1024];
	switch(dialogid)
	{
	    case 3015:
