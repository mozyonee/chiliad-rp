stock random_values_array(array_input[], const array_size)
{
    for (new i = 0; i < array_size; i++)
	{
        array_input[i] = random(array_size);

        for (new j = 0; j < array_size; j++) {
            if (i != j && array_input[i] == array_input[j]) {
                j = -1;
                array_input[i] = random(array_size);
            }
        }
    }
}

stock RecordDamage(playerid, bodypart, Float:amount, weaponid)
{
    new hour, minute, second;
    gettime(hour,minute,second);

	for(new i = 0; i < MAX_DAMAGES; i++)
	{
	    if(Damage_All[playerid][i][damage_time] == 0)
	    {
			format(Damage_All[playerid][i][damage_time], 32, "%02d:%02d:%02d", hour, minute, second);
			Damage_All[playerid][i][damage_bodypart] = bodypart;
			Damage_All[playerid][i][damage_amount] = amount;
			Damage_All[playerid][i][damage_weapon] = weaponid;
			Damage_All[playerid][i][damage_unixtime] = gettime(); // Нужно для "%d секунд назад".
			break;
		}
	}
	return 1;
}

stock ShowSprayMenu(playerid)
{
    new PlayerTextSpray[201], string[512], TextFont[64], TextSize[15], TextBold[15], TextColor[15];
    GetPVarString(playerid, "PlayerTextSpray", PlayerTextSpray, sizeof(PlayerTextSpray));
    GetPVarString(playerid, "TextFont", TextFont, sizeof(TextFont));
	GetPVarString(playerid, "TextColor", TextColor, sizeof(TextColor));
	if(strlen(PlayerTextSpray) > 0) PlayerTextSpray = "Указан";
	else PlayerTextSpray = "Не указан";
	if(strlen(TextFont) > 0) TextFont = "Указан";
	else TextFont = "Не указан";
	if(strlen(TextColor) > 0) TextColor = "Указан";
	else TextColor = "Не указан";
	if(GetPVarInt(playerid, "TextSize") < 12) TextSize = "Не указан";
	else TextSize = "Указан";
	if(GetPVarInt(playerid, "FontBold") == 0) TextBold = "Выключена";
	else TextBold = "Включена";
    format(string, sizeof(string), "1. "cGRAY" Текст граффити - %s{ffffff}\n2. "cGRAY"Шрифт граффити — %s{ffffff}\n3. "cGRAY"Цвет граффити — %s\n4. "cGRAY"Размер граффити — %s{ffffff}\n5. "cGRAY"Обводка — %s{ffffff}\n6. "cGRAY"Нарисовать граффити", PlayerTextSpray, TextFont, TextColor, TextSize, TextBold);
	showPlayerDialog(playerid, d_spraytag, DIALOG_STYLE_LIST, "> Граффити", string, "Далее", "Отмена");
	return true;
}

stock GetInfoAboutDamage(playerid, userid)
{
  	new string[2048], gunname[32], nickname[32];
  	for(new i = 0; i < MAX_DAMAGES; i++)
  	{
  	    if(Damage_All[userid][i][damage_time] != 0)
  	    {
  	        GetWeaponName(Damage_All[userid][i][damage_weapon],gunname,sizeof(gunname));
	  		format(string,1024,"%s{696969}%d.{ffffff} %s (%s), %s, %.1f DMG, %s\n",string,i+1,GetDuration(gettime() - Damage_All[userid][i][damage_unixtime]), Damage_All[userid][i][damage_time], gunname, Damage_All[userid][i][damage_amount], GetBodypart(Damage_All[userid][i][damage_bodypart]));
		}
  	}
 	GetPlayerName(userid, nickname, sizeof(nickname));
    ShowPlayerDialog(playerid, d_checkdamages, DIALOG_STYLE_LIST, nickname, string, "Закрыть", "");
	if(!strlen(string))
  	{
    	SendClientMessage(playerid,C_GRAY,""gbError"У игрока нет активных повреждений.");
  	}
  	return 1;
}

stock GetBodypart(id)
{
        new name[64] = "Неизвестно";
        if(id == 3) name = "Торс";
        if(id == 4) name = "Пах";
        if(id == 5) name = "Левая рука";
        if(id == 6) name = "Правая рука";
        if(id == 7) name = "Левая нога";
        if(id == 8) name = "Правая нога";
        if(id == 9) name = "Голова";
        return name;
}

stock GetDuration(time)
{
	new
	    str[32];

	if (time < 0 || time == gettime()) {
	    format(str, sizeof(str), "Никогда");
	    return str;
	}
	else if (time < 60)
		format(str, sizeof(str), "%d секунд(-у, -а)", time);

	else if (time >= 0 && time < 60)
		format(str, sizeof(str), "%d секунда", time);

	else if (time >= 60 && time < 3600)
		format(str, sizeof(str), (time >= 120) ? ("%d минут(-ы)") : ("%d минуту"), time / 60);

	else if (time >= 3600 && time < 86400)
		format(str, sizeof(str), (time >= 7200) ? ("%d часа(-ов)") : ("%d час"), time / 3600);

	else if (time >= 86400 && time < 2592000)
 		format(str, sizeof(str), (time >= 172800) ? ("%d дня(-ей)") : ("%d день"), time / 86400);

	else if (time >= 2592000 && time < 31536000)
 		format(str, sizeof(str), (time >= 5184000) ? ("%d месяца(-ев)") : ("%d месяц"), time / 2592000);

	else if (time >= 31536000)
		format(str, sizeof(str), (time >= 63072000) ? ("%d года(лет)") : ("%d год"), time / 31536000);

	strcat(str, " назад");

	return str;
}

