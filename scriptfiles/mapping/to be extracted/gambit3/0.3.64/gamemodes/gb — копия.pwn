	        U::[playerid][uMoney] -= 50;
            mysql_format(1, query,sizeof(query),"UPDATE gb_users SET uMoney = '%d' WHERE BINARY uName = '%s'",U::[playerid][uMoney],U::[playerid][uName]);
			mysql_tquery(1, query, "", "");
