					strcat(string,"Несмотря на то, что армия занимается подавлением массовых нарушений правопорядков, \n");
					strcat(string,"защитой штата и борьбой с организованной преступностью, ей отведена роль по охране и \n");
					strcat(string,"доставки боеприпасов, в организации которым она требуется.");
					showPlayerDialog(playerid,9999,0," ",string,"Закрыть","");
