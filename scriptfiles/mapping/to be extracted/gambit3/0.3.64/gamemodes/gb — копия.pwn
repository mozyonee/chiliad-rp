    for(new i = 1; i <= MAX_VEHICLES; i++)
	{
	    if(!IsValidVehicle(i)) continue;
	    caradmin[i] = false;
		if(i >= ataxils[0] && i <= ataxils[1]) {
		    V::[i][vTaxiDriver] = -1;
		    V::[i][vTaxiText] = -1;
		    SetVehicleParamsEx(i,eng,light,other1,1,other3,other4,other5);
		    V::[i][vLock] = true;
		    V::[i][vHealth] = 1000.0;
		    V::[i][vFuel] = MaxVehicleFuel[GetVehicleModel(i) - 400];
		}
		if(i >= fermcars[0] && i <= fermcars[1]) {
			V::[i][vFermCarIdPlayer] = INVALID_PLAYER_ID;
			V::[i][vHealth] = 1000.0;
			V::[i][vFuel] = MaxVehicleFuel[GetVehicleModel(i) - 400];
		}
		if(i >= buscars[0] && i <= buscars[1]) {
			V::[i][vBusDriver] = -1;
			V::[i][vHealth] = 1000.0;
			V::[i][vFuel] = MaxVehicleFuel[GetVehicleModel(i) - 400];
		}
		if(i >= dalncars[0] && i <= dalncars[1]) {
			V::[i][vDalnDriver] = -1;
			SetVehicleParamsEx(i,eng,light,other1,1,other3,other4,other5);
			V::[i][vLock] = true;
			V::[i][vHealth] = 1000.0;
			V::[i][vFuel] = MaxVehicleFuel[GetVehicleModel(i) - 400];
			V::[i][vProducts] = 0;
