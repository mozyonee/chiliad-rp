public OnPlayerRequestSpawn(playerid)
{
	if(!GetPVarInt(playerid,"uLogin"))
	{
	    SendClientMessage(playerid, -1, ""gbError"Не доступно!");
	    return 0;
	}
    return 1;
}
public OnPlayerRequestClass(playerid,classid) {
//  native CheckCheater(playerid);
    if(IsPlayerNPC(playerid)) return 1;
   	if(GetPVarInt(playerid,"uLogin") == 1) return SpawnPlayer(playerid);
	SetPVarInt(playerid,"Joined",1);
	SetTimerEx("OnPlayerJoin",300,false,"i",playerid);
    return 1;
}
forward OnPlayerJoin(playerid);
public OnPlayerJoin(playerid)
{
    SetPVarInt(playerid,"DialogID",-2);
	InterpolateCameraPos(playerid, 1494.964233, 13.226538, 189.263305, 1481.021728, -1798.964599, 254.696289, 50000);
    InterpolateCameraLookAt(playerid, 1494.903320, 8.249490, 188.788665, 1481.015502, -1795.936523, 250.717529, 50000);
    new query[128];
    GetPlayerName(playerid,U::[playerid][uName],24);
	mysql_real_escape_string(U::[playerid][uName], U::[playerid][uName]);
 	TextDrawShowForPlayer(playerid,Logo[0]);
 	TextDrawShowForPlayer(playerid,Logo[1]);
 	TextDrawShowForPlayer(playerid,Logo[2]);
 	TextDrawShowForPlayer(playerid,Logo[3]);
 	

    //------------------------[]------------------------
    format(query, sizeof(query),"SELECT * FROM `gb_users` WHERE `uName` = '%s' LIMIT 1",U::[playerid][uName]);
	mysql_tquery(1, query, "ONPLAYERCHECKACC", "d", playerid);
    //--------------------------------------------------

    return 1;
}
forward AdminLoginCallback(playerid, password[]);
public AdminLoginCallback(playerid, password[])
{
    new rows,fields;
    cache_get_data(rows, fields);
    if(!rows) return SendClientMessage(playerid, C_GRAY, "Вы не модератор!");
    new pass[32], string[128], query[512];
    cache_get_field_content(0, "Password", pass);
    if(!strcmp(pass, "qwerty", true))
	{
        SendClientMessage(playerid, C_GREEN, "Поздравляем, вы получили доступ модератора!");
        mysql_format(1,query,512,"UPDATE `gb_admins` SET `Password`= '%s' WHERE BINARY `Name` = '%s'", password, U::[playerid][uName]);
    	mysql_function_query(1, query, false,"","");
    }
    else if(strcmp(password, pass, true))
    {
        format(string, 128, "{FF6347}[A] %s некорректный ввод пароля модератора", U::[playerid][uName]);
        SendAdminMessage(C_LIGHTRED, string);
        SendClientMessage(playerid, 0xFF6347AA, "Вы были кикнуты за неверный пароль администратора!");
        NewKick(playerid);
        return true;
    }
    cache_get_field_content(0, "Level", string), U::[playerid][uAdmin] = strval(string);
    SetPVarInt(playerid,"playerAdmin", 1);
    if(U::[playerid][uAdmin] < 6)
    {
        format(string, 128, "{9ACD32}[A] Вошел {ffd800}%s{9ACD32} [%d]", U::[playerid][uName], playerid);
    	SendAdminMessage(C_GREEN, string);
    }
	return true;
}

forward UnRetestPlayer(playerid, Name[]);
public UnRetestPlayer(playerid, Name[])
{
    new Rows, Fields, string[240];
    cache_get_data(Rows, Fields);
    if(!Rows) return SendClientMessage(playerid, C_GRAY, "Данный игрок не был на ретесте!");
    mysql_format(1, string, sizeof(string), "UPDATE `gb_users` SET `uRetest` = '0' WHERE `uName` = '%s'", Name);
	mysql_tquery(1, string, "", "");
	SendClientMessage(playerid, C_GRAY, ""gbAccess"Вы успешно сняли игрока с ретеста!");
	return true;
}


forward OnPlayerBan(playername[], day, reason[], playerid);
public OnPlayerBan(playername[], day, reason[], playerid)
{
	new Rows, Fields;
    cache_get_data(Rows, Fields);
    if(!Rows) SendClientMessage(playerid, C_GRAY, "Данного аккаунта не существует!");
    new adminlvl;
    adminlvl = cache_get_field_content_int(0, "uAdmin", mysql);
    if(adminlvl > 0) return SendClientMessage(playerid, C_GRAY, "Нельзя заблокировать администратора!");
    new dates[16], unbandate;
    new string[512];
	format(string,sizeof(string),"Администратор %s забанил оффлайн игрока %s на %d дней. Причина: %s",U::[playerid][uName],playername,day,reason);
	SendAdminMessageToAll(C_LIGHTRED,string, playerid);
	new data [200];
	cache_get_field_content(1, "uLastIP", data, mysql);
	unbandate = gettime() + day * 86400;
	new year,month,days;
	getdate(year, month, days);
	format(dates, 16, "%02d.%02d.%04d", days, month, year);

	//U::[params[0]][uBanPlayer] = unbandate;
	//nowUpdateInfo(params[0] , "d" , "gb_users" , "uName" , "uBanPlayer" , U::[params[0]][uBanPlayer]);

	format(string,sizeof(string), "INSERT INTO gb_bans (name, ip, bandate, time, unbandate, reason, adminban) VALUES ('%s', '%s', '%s', %d, %d, '%s', '%s')", playername, data, dates, day, unbandate, reason, U::[playerid][uName]);
	mysql_tquery(1, string, "", "");
	return true;
}

forward MDCCHECKACC(playerid);
public MDCCHECKACC(playerid)
{
    new Rows, Fields;
    cache_get_data(Rows, Fields);
    if(!Rows) return SendClientMessage(playerid, C_GRAY, "Не найдено!");
    new licenses[4], data[40], sex, color, nation, age, string[512], name[25];
    new sextext[15], colortext[20], nationtext[20];
    cache_get_field_content(0, "uLicenses", data, mysql), sscanf(data,"p<|>a<d>[4]",licenses);
    if(licenses[3] != 1) return SendClientMessage(playerid, C_GRAY, "Не найдено!");
    cache_get_field_content(0, "uName", name, mysql);
    sex = cache_get_field_content_int(0, "uSex", mysql);
    switch(sex)
    {
        case 1: sextext = "Мужской";
        case 2: sextext = "Женский";
    }
    color = cache_get_field_content_int(0, "uColor", mysql);
    switch(color)
    {
        case 1: colortext = "Темный";
        case 2: colortext = "Светлый";
    }
    nation = cache_get_field_content_int(0, "uNation", mysql);
    switch(nation)
    {
        case 1: nationtext = "Американец";
		case 2: nationtext = "Латиноамериканец";
		case 3: nationtext = "Русский";
		case 4: nationtext = "Француз";
		case 5: nationtext = "Итальянец";
		case 6: nationtext = "Испанец";
		case 7: nationtext = "Немец";
		case 8: nationtext = "Португалец";
		case 9: nationtext = "Австралиец";
		case 10: nationtext = "Колумбиец";
		case 11: nationtext = "Мексиканец";
		case 12: nationtext = "Китаец";
		case 13: nationtext = "Японец";
		case 14: nationtext = "Бразилец";
		case 15: nationtext = "Кореец";
		case 16: nationtext = "Въетнамец";
		case 17: nationtext = "Чех";
		case 18: nationtext = "Британец";
		case 19: nationtext = "Голландец";
		case 20: nationtext = "Поляк";
    }
    age = cache_get_field_content_int(0, "uAge", mysql);
	format(string, sizeof(string), "{AFAFAF}Имя:         %s\nПол:         %s\nЦвет:      %s\nНация:      %s\nВозраст:   %d", name, sextext, colortext, nationtext, age);
	showPlayerDialog(playerid,9999,0,"Информация",string,"Выход","");
	return true;
}


