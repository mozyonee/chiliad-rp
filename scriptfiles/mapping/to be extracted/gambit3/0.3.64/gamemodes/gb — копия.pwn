										format(str,sizeof(str),"№%d - $%d",H::[i][hID],H::[i][hPrice]);
										if(count != 2) {
											count ++;
											strcat(string,str);
											strcat(string,"\t");
										}
										else {
											count = 0;
											strcat(string,str);
											strcat(string,"\n");
										}
										houselist = true;
									}
								}
							}
							else {
							    format(str,sizeof(str),"№%d - $%d",H::[i][hID],H::[i][hPrice]);
								if(count != 2) {
									count ++;
									strcat(string,str);
									strcat(string,"\t");
								}
								else {
									count = 0;
									strcat(string,str);
									strcat(string,"\n");
								}
								houselist = true;
							}
						}
					}
