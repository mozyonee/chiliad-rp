					strcat(string,"Администратор на сервере - это полностью ООС персонаж,\n");
					strcat(string,"которому запрещаеться иметь игровое имущества,\n");
					strcat(string,"вмешиваться в игровой процесс, писать и использовать любые игровые чаты.\n");
					showPlayerDialog(playerid,9999,0," ",string,"Закрыть","");
		        }
		    }
		}
		case d_a_menu + 5: {
		    if(!response) return 1;
		    string = "";
		    switch(listitem) {
		        case 0: {
		            strcat(string,"{ffffff}В каждой организации, лидеры могут подстраивать свою организацию по себя, лидер \n");
					strcat(string,"может: изменять названия рангов, изменять возможности рангов, изменять одежду \n");
					strcat(string,"различным рангам, изменять доступность к оружию.\n\n");
					strcat(string,"Лидер может сделать такую организацию, которую он сам хочет видеть на сервере.");
					showPlayerDialog(playerid,9999,0," ",string,"Закрыть","");
		        }
		        case 1: {
		            strcat(string,"{ffffff}Правоохранительные органы на сервере сделаны в лучшем виде. На сервере, существуют \n");
					strcat(string,"лишь 2 разделения на подразделения - это полиция Лос-Сантоса и Шерифы Округа Рэд. \n");
					strcat(string,"Первые занимаются охраной и защитой города Лос-Сантоса, вторые в свою очередь \n");
					strcat(string,"охраной и защитой Округа Рэда.\n\n");
					strcat(string,"Возможности у полиции обширные, в них входят: Задержания правонарушителей, \n");
					strcat(string,"расстановка специальных объектов заграждения, тяжёлая техника, шипы, воздушный \n");
					strcat(string,"транспорт и многое другое...\n\n");
					strcat(string,"Найти местонахождения участков полиции, вы можете при помощи GPS, в разделе \n");
					strcat(string,"\"Организации\".");
					showPlayerDialog(playerid,9999,0," ",string,"Закрыть","");
		        }
		        case 2: {
		            strcat(string,"{ffffff}Служба спасения на сервере - это соединения больницы и пожарных в одно целое, что \n");
					strcat(string,"делает эту организацию интереснее и более обширной для Role Play мира. \n");
					strcat(string,"У данной организации присутствует как наземный, так и воздушных транспорт, \n");
					strcat(string,"функционал данной организации тоже радует глаз, несмотря на то, что они занимаются \n");
					strcat(string,"лечением людей, они также могут тушить пожары, заниматься различными операциями \n");
					strcat(string,"по спасению людей, и просто помогать людям, которые попали в ситуации, в которым им \n");
					strcat(string,"требуется помощь службы спасения.\n\n");
					strcat(string,"Найти местонахождение службы спасения, вы можете при помощи GPS, в разделе \n");
					strcat(string,"\"Организации\".");
					showPlayerDialog(playerid,9999,0," ",string,"Закрыть","");
		        }
		        case 3: {
		            strcat(string,"{ffffff}Данная организация, занимается контролем за всеми остальными организациями, не \n");
					strcat(string,"смотря на это, ей отведена главная роль в экономической системе штата, они могут как \n");
					strcat(string,"менять зарплаты в различных организациях, как менять налоги на различное имущество, \n");
					strcat(string,"как и назначать и увольнять лидеров различных организаций.\n\n");
					strcat(string,"Также у мэрии, есть возможности, по заказам медикаментов и оружия в организации, \n");
					strcat(string,"которым они требуются.\n\n");
					strcat(string,"Найти местонахождение мэрии, вы можете при помощи GPS, в разделе \"Организации\".");
					showPlayerDialog(playerid,9999,0," ",string,"Закрыть","");
		        }
		        case 4: {
		            strcat(string,"{ffffff}Армия штата представляет из себя маленькую базу, которая расположилась в доках \n");
