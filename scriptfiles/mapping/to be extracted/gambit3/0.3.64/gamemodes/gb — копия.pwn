forward OnPlayerCheckBanTwo(playerid);
public OnPlayerCheckBanTwo(playerid)
{
	new str[100];
    new Rows, Fields;
    cache_get_data(Rows, Fields);
    new unbandate;
	if(Rows) {
		unbandate = cache_get_field_content_int(0, "unbandate");
		if(unbandate > gettime())
		{
		    format(str,sizeof(str),""gbError"Простите, но вы забанены на данном сервере. Дата разблокировки - "cBLUE"%s", date("%dd.%mm.%yy", unbandate) );
			SendClientMessage(playerid,C_GRAY,str);
 			NewKick(playerid);
		}
	}
	else
	{
	    new query[256];
		format(query, sizeof(query),"SELECT * FROM `gb_users` WHERE BINARY `uName` = '%s'",U::[playerid][uName]);
		mysql_tquery(1, query, "ONPLAYERCHECKACC", "d", playerid);
	}

	return 1;
}



public OnPlayerEnterDynamicArea(playerid, areaid)
{
	new string[240];
	for(new i = TOTALFIRE[0]; i <= TOTALFIRE[1]; i++)
 	{
		if(!FireSystem[i][fStatus]) continue;
		if(!IsValidDynamicArea(FireSystem[i][fZone])) continue;
	 	if(areaid == FireSystem[i][fZone]) {
	 	    new s = GetPlayerSkin(playerid);
		 	if(s == 277 || s == 278 || s == 279)
		 	{
				if(GetPVarInt(playerid, "FireBar") >= 1)
				{
				    SetPlayerProgressBarValue(playerid, universalbar[playerid], FireSystem[i][fHealth]);
				    UpdatePlayerProgressBar(playerid, universalbar[playerid]);
				}
				else {
				    SetPVarInt(playerid, "FireBar", 1);
					universalbar[playerid] = CreatePlayerProgressBar(playerid, 600.333, 202.014, 13.666, 192.059, 0xFFFFFFFF, 5);
					UpdatePlayerProgressBar(playerid, universalbar[playerid]);
					ShowPlayerProgressBar(playerid, universalbar[playerid]);
					SetPlayerProgressBarMaxValue(playerid, universalbar[playerid], 600);
					SetPlayerProgressBarValue(playerid, universalbar[playerid], FireSystem[i][fHealth]);
				 	UpdatePlayerProgressBar(playerid, universalbar[playerid]);
				}
			}
		 	break;
		}
	}
	
	if(ATMZone[0] <= areaid <= ATMZone[cBankomats-1]) SetPVarInt(playerid,"PlayerUseBankomat",1);
	if(PaynSpray[0] <= areaid <= PaynSpray[MAX_PAYNSPRAY-1]) {
		SetPVarInt(playerid,"playerUsePaynSpray",1);
	}
	if(PotatoZone[0] <= areaid <= PotatoZone[MAX_OBJECTS_POTATO-1]) {
	    new j = areaid-PotatoZone[0];
	    if(D::[playerid][dFermClassDuty] == 1 && GetVehicleModel(GetPlayerVehicleID(playerid)) == 532) {
			if(PoleR >= 900) {
			    if(IsValidDynamicObject(PotatoObject[j])) {
					DestroyDynamicObject(PotatoObject[j]);
					PotatoObject[j] = -1;
					new Float:p[4];
					new Float:dist = 2.5;
					GetVehiclePos(GetPlayerVehicleID(playerid),p[0],p[1],p[2]);
					GetVehicleZAngle(GetPlayerVehicleID(playerid),p[3]);
					p[3] = p[3] + 180.0;
					_dropFerm ++;
					OF::[_dropFerm][ofP][0] = p[0];
					OF::[_dropFerm][ofP][1] = p[1];
					OF::[_dropFerm][ofP][2] = p[2];
					OF::[_dropFerm][ofObject] = CreateDynamicObject(2060,p[0]+dist*-floatsin(p[3],degrees),p[1]+dist*floatcos(p[3],degrees),p[2] - 2,0.0,0.0,0.0,-1,-1,-1,100.0);
					OF::[_dropFerm][ofText] = CreateDynamic3DTextLabel(""cBLUE"ALT",0xFFFFFFFF,p[0]+dist*-floatsin(p[3],degrees),p[1]+dist*floatcos(p[3],degrees),p[2]-2,3.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0);
     				KustInPole --;
					SetPVarInt(playerid, "SemValue", GetPVarInt(playerid, "SemValue") + 1);
					if(GetPVarInt(playerid, "SemValue") >= 2)
					{
			            if(JobValueNow(playerid, 1, 15, -1) != 0) DeletePVar(playerid,"SemValue");
						else
						{
			   				if(D::[playerid][dFermClassDuty] == 1) {
								FermersOnline --;
								SendClientMessage(playerid, -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
								showPlayerDialog(playerid,9999,0," ","{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке","Закрыть","");
							}
							if(D::[playerid][dFermClassDuty] == 2) SendClientMessage(playerid,-1,""gbError"Вы закончили свой рабочий день помощником фермы!");
				            D::[playerid][dFermClassDuty] = 0;
				            GetBackSkin(playerid);
				            RemovePlayerAttachedObject(playerid,9);
				            DisablePlayerCheckpoint(playerid);
				            DisablePlayerRaceCheckpoint(playerid);
				            SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
				            MeAction(playerid,"увольняется с работы",1);
				            DeletePVar(playerid,"CheckpointFermaPole");
				            DeletePVar(playerid,"BackFermTransport");
						}
					}
					if(KustInPole == 0) {
						PoleR = 0;
						foreach (new i : Player) {
							if(D::[i][dFermClassDuty] == 1 && GetVehicleModel(GetPlayerVehicleID(i)) == 532) {
								SetPVarInt(i,"BackFermTransportKomb",_:SetPlayerCheckpoint(i,-108.6581,25.4261,3.1172,5.0));
        	                    SendClientMessage(i,C_GRAY,""gbInfo"Верните используемый комбайн на место.");
							}
						}
					}
				}
			}
		}
	}
	if(WD::[0][woodZone] <= areaid <= WD::[MAX_WOODS - 1][woodZone]) {
	    new j = areaid - WD::[0][woodZone];
	    if(D::[playerid][dWoodsDuty] == 1) {
	    	new s = GetPlayerSkin(playerid);
			if(s == 16 || s == 27 || s == 260 || s == 13 || s == 56 || s == 131) {
			    if(GetPVarInt(playerid,"PlayerUseBox") == 4) {
			        if(WD::[j][woodUse] == false) {
			            if(WD::[j][woodIsDrop] == false) {
			                if(WD::[j][woodCount] != 0) {
			                	WD::[j][woodUse] = true;
			                	SetPVarInt(playerid,"WoodDrop",j);
								SetTimerEx("WoodsPlayer",10000,false,"ddd",playerid,j,0);
								ClearAnimations(playerid);
								togglePlayerControllable(playerid,false);
								ApplyAnimation(playerid,"CHAINSAW","WEAPON_csaw",1.0,1,0,0,0,10000,0);
								MeAction(playerid,"пилит дерево",1);
							}
						}
		            	else {
		            	    if(WD::[j][woodCount] > 0) {
		            	        WD::[j][woodCount] -= 25;
								SetPVarInt(playerid,"WoodDrop",j);
								SetTimerEx("WoodsPlayer",10000,false,"ddd",playerid,j,1);
								togglePlayerControllable(playerid,false);
								ApplyAnimation(playerid,"CHAINSAW","CSAW_G",1.0,1,0,0,0,10000,0);
								MeAction(playerid,"пилит дерево",1);
		            	    }
		            	}
   					}
   					else SendClientMessage(playerid,C_GRAY,""gbError"Простите, но это дерево уже кто-то пилит.");
				}
			}
			else SendClientMessage(playerid,C_GRAY,""gbError"Вы должны быть в рабочей одежде, для того чтобы пилить дерево.");
	    }
	}
	if(areaid == strZones[0]) {
		if(D::[playerid][dFermClassDuty] != 0) SetPVarInt(playerid,"TimerCountFerm",0);
	}
	if(areaid == strZones[10]) {
		if(D::[playerid][dWoodsDuty] != 0) SetPVarInt(playerid,"TimerCountWoods",0);
	}
	if(areaid == strZones[1]) {
	    if(D::[playerid][dFermClassDuty] == 1 && GetVehicleModel(GetPlayerVehicleID(playerid)) == 531) {
	        if(KustInPole > 0) return SendClientMessage(playerid,C_GRAY,""gbError"На поле ещё есть несобранный урожай, соберите его.");
	        if(_dropFerm > 5) return SendClientMessage(playerid,C_GRAY,""gbError"На поле ещё есть несобранный урожай, соберите его.");
			if(PoleV >= 100 && PoleS >= 100) {
			    SetPVarInt(playerid,"BackFermTransport",_:SetPlayerCheckpoint(playerid,-45.1872,80.6483,3.1172,3.0));
				return SendClientMessage(playerid,C_GRAY,""gbInfo"Поле уже вспахано и засеяно, верните оборудование на место.");
		 	}
