		    if(!isNumeric(inputtext)) return SendClientMessage(playerid,C_GRAY,""gbError"Указанный вами дом, не принадлежит этому центру купли-продажи недвижимости.");
		    if(GetPVarInt(playerid,"BuyHouseCity") != H::[id][hCity]) return SendClientMessage(playerid,C_GRAY,""gbError"Указанный вами дом, не принадлежит этому центру купли-продажи недвижимости.");
