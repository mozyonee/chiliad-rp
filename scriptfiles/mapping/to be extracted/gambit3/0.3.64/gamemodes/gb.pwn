			for(new i; i != MAX_CARS_BUY; i++)
			{
			    if(Car::[i][cID] == 0) {
			        if(Car::[i][cUgon]) Car::[i][cUgon] = 0;
			        Player[playerid][uMoney] -= GetPVarInt(playerid,"salonPriceCar");
			        format(query,sizeof(query),"UPDATE gb_users SET uMoney = '%d' WHERE BINARY uName = '%s'",Player[playerid][uMoney],Player[playerid][uName]);
					mysql_tquery(1, query, "", "");
					if(!strcmp(Bizz::[bizz][bOwner],"None",true)) {}
					else Bizz::[bizz][bSettings][6] += (GetPVarInt(playerid,"salonPriceCar") / 100) * 10;
					if(Bizz::[bizz][bRating] < 5000) Bizz::[bizz][bRating]++;
					Bizz::[bizz][bSettings][3] -= GetPVarInt(playerid,"salonProdCar");
					format(string,sizeof(string),"%d|%d|%d|%d|%d|%d|%d|%d",Bizz::[bizz][bSettings][0],Bizz::[bizz][bSettings][1],Bizz::[bizz][bSettings][2],
					Bizz::[bizz][bSettings][3],Bizz::[bizz][bSettings][4],Bizz::[bizz][bSettings][5],Bizz::[bizz][bSettings][6],Bizz::[bizz][bSettings][7]);
					SetBizzStr(Bizz::[bizz][bID],"bSettings",string);

					strmid(Car::[i][cOwner], Player[playerid][uName], 0, strlen(Player[playerid][uName]), MAX_PLAYER_NAME);
					Car::[i][cModel] = GetPVarInt(playerid,"salonModelCar");
					switch(salon)
					{
					    case 1: Car::[i][cCar] = CreateVehicle(Car::[i][cModel],563.1270,-1288.2494,17.2527,356.4879,1,1,99999);
					    case 2: Car::[i][cCar] = CreateVehicle(Car::[i][cModel],2119.6211,-1151.7699,24.1200,354.0866,1,1,99999);
					    case 3: Car::[i][cCar] = CreateVehicle(Car::[i][cModel],844.8745,-600.2874,18.4240,0.3068,1,1,99999);
					}
					for(new is; is != 18; is ++) {
						V::[Car::[i][cCar]][vInvSlot][is] = 0;
						V::[Car::[i][cCar]][vInvSlotKol][is] = 0;
					}
					GetVehiclePos(Car::[i][cCar],Car::[i][cPos][0],Car::[i][cPos][1],Car::[i][cPos][2]);
					GetVehicleZAngle(Car::[i][cCar],Car::[i][cPos][3]);
					V::[Car::[i][cCar]][vBuyingCar] = i;
					V::[Car::[i][cCar]][vHealth] = 1000.0;
					Car::[i][cSettings][0] = GetPVarInt(playerid,"salonPriceCar");
					Car::[i][cSettings][1] = 1;
					Car::[i][cSettings][2] = 1;
					Car::[i][cSettings][3] = 0;
					Car::[i][cSettings][4] = 0;
					Car::[i][cStatus][0] = 100;
					new Year, Month, Day;
					getdate(Year, Month, Day);
					format(str,sizeof(str),"%02d/%02d/%d", Day, Month, Year);
					strmid(Car::[i][cLastTeh], str, 0, strlen(str), MAX_PLAYER_NAME);
					V::[Car::[i][cCar]][vFuel] = MaxVehicleFuel[Car::[i][cModel] - 400];
					GetVehicleParamsEx(Car::[i][cCar],eng,light,other1,other2,other3,other4,other5);
					SetVehicleParamsEx(Car::[i][cCar],eng,light,other1,other2,false,other4,other5);

					format(query,sizeof(query),"INSERT INTO `gb_cars` (`cOwner`,`cModel`,`cPosition`,`cSettings`,`cLastTeh`) VALUES ('%s',%d,'%f|%f|%f|%f','0|%d|%d|%d|%d|0|0','%02d/%02d/%d')",
					Car::[i][cOwner],Car::[i][cModel],Car::[i][cPos][0],Car::[i][cPos][1],Car::[i][cPos][2],Car::[i][cPos][3],
					Car::[i][cSettings][1],Car::[i][cSettings][2],Car::[i][cSettings][3],Car::[i][cSettings][4], Day, Month, Year);
					mysql_tquery( mysql, query, "LoadCarsZ", "dd", i, playerid);

                    if(!strcmp(Car::[i][cNumber],"None",true)) format(string, sizeof(string), "[БЕЗ НОМЕРА]");
			   		else format(string, sizeof(string), "%s", Car::[i][cNumber]);
					
					SetVehicleNumberPlate( Car::[i][cCar], Car::[i][cNumber] );
					logs( 8, "купил машину", Player[playerid][uID], Car::[i][cModel] );

			 		//if(Car::[i][cModel] != 510 || Car::[i][cModel] != 509 || Car::[i][cModel] != 481)
					//Attach3DTextLabelToVehicle(Car::[i][cNumberLabel], Car::[i][cCar], 0.0, -1.8, 0.0);

					switch(GetVehicleModel(Car::[i][cCar]))
					{
					    case 448: Car::[i][cNumberLabel] = CreateDynamic3DTextLabel(string, 0xFFFFFF60, 0.0, -1.0, 0.0, 10.0, INVALID_PLAYER_ID, Car::[i][cCar]);
					    case 461: Car::[i][cNumberLabel] = CreateDynamic3DTextLabel(string, 0xFFFFFF60, 0.0, -1.3, 0.4, 10.0, INVALID_PLAYER_ID, Car::[i][cCar]);
					    case 462: Car::[i][cNumberLabel] = CreateDynamic3DTextLabel(string, 0xFFFFFF60, 0.0, -1.0, 0.0, 10.0, INVALID_PLAYER_ID, Car::[i][cCar]);
					    case 463: Car::[i][cNumberLabel] = CreateDynamic3DTextLabel(string, 0xFFFFFF60, 0.0, -1.1, 0.3, 10.0, INVALID_PLAYER_ID, Car::[i][cCar]);
					    case 468: Car::[i][cNumberLabel] = CreateDynamic3DTextLabel(string, 0xFFFFFF60, 0.0, -1.1, 0.3, 10.0, INVALID_PLAYER_ID, Car::[i][cCar]);
					    case 521: Car::[i][cNumberLabel] = CreateDynamic3DTextLabel(string, 0xFFFFFF60, 0.0, -1.1, 0.3, 10.0, INVALID_PLAYER_ID, Car::[i][cCar]);
					    case 522: Car::[i][cNumberLabel] = CreateDynamic3DTextLabel(string, 0xFFFFFF60, 0.0, -1.1, 0.4, 10.0, INVALID_PLAYER_ID, Car::[i][cCar]);
					    case 581: Car::[i][cNumberLabel] = CreateDynamic3DTextLabel(string, 0xFFFFFF60, 0.0, -1.1, 0.3, 10.0, INVALID_PLAYER_ID, Car::[i][cCar]);
					    case 586: Car::[i][cNumberLabel] = CreateDynamic3DTextLabel(string, 0xFFFFFF60, 0.0, -1.3, 0.17, 10.0, INVALID_PLAYER_ID, Car::[i][cCar]);
					    case 510:  print("На этот транспорт нельзя прикрепить текст! 510");
					    case 509:  print("На этот транспорт нельзя прикрепить текст! 509");
					    case 481: print("На этот транспорт нельзя прикрепить текст! 481");
					    default: Car::[i][cNumberLabel] = CreateDynamic3DTextLabel(string, 0xFFFFFF60, 0.0, -2.8, 0.0, 10.0, INVALID_PLAYER_ID, Car::[i][cCar]);
					}
					break;
				}
			}


		}
		case d_salon: {
		    if(!response) return 1;
			gCarInfoBuy = CreatePlayerTextDraw(playerid, 155.000000, 182.000000, "");
			PlayerTextDrawBackgroundColor(playerid,gCarInfoBuy, 51);
			PlayerTextDrawFont(playerid,gCarInfoBuy, 5);
			PlayerTextDrawLetterSize(playerid,gCarInfoBuy, 0.500000, 1.000000);
			PlayerTextDrawColor(playerid,gCarInfoBuy, -1);
			PlayerTextDrawSetOutline(playerid,gCarInfoBuy, 1);
			PlayerTextDrawSetProportional(playerid,gCarInfoBuy, 1);
			PlayerTextDrawSetShadow(playerid,gCarInfoBuy, 1);
			PlayerTextDrawUseBox(playerid,gCarInfoBuy, 1);
			PlayerTextDrawBoxColor(playerid,gCarInfoBuy, 0);
			PlayerTextDrawTextSize(playerid,gCarInfoBuy, 90.000000, 90.000000);
			PlayerTextDrawSetSelectable(playerid,gCarInfoBuy, 0);


		    switch(GetPVarInt(playerid, "SALONID"))
		    {
      			case 1:
      			{
     			    PlayerTextDrawSetPreviewModel(playerid,gCarInfoBuy, Salon1[listitem][0]);
				   	format(string, sizeof(string), "{ffffff}Вы уверены, что хотите приобрести данное т/c:\n\n"gbInfo"Название автомобиля: [ %s ]\n"gbInfo"Ёмкость багажника [ %d ] мест\n"gbInfo"Емкость топливного бака [ %.0f ]\n"gbInfo"Сумма вашего заказа: [ %d$ ]", CarNames[Salon1[listitem][0] - 400], GetVehicleBagg(Salon1[listitem][0]), MaxVehicleFuel[Salon1[listitem][0] - 400], Salon1[listitem][1]);
				}
		  		case 2:
		  		{
		  		    PlayerTextDrawSetPreviewModel(playerid, gCarInfoBuy, Salon2[listitem][0]);
				   	format(string, sizeof(string), "{ffffff}Вы уверены, что хотите приобрести данный т/c:\n\n"gbInfo"Название автомобиля: [ %s ]\n"gbInfo"Ёмкость багажника [ %d ] мест\n"gbInfo"Емкость топливного бака [ %.0f ]\n"gbInfo"Сумма вашего заказа: [ %d$ ]", CarNames[Salon2[listitem][0] - 400], GetVehicleBagg(Salon2[listitem][0]), MaxVehicleFuel[Salon2[listitem][0] - 400], Salon2[listitem][1]);
				}
		  		case 3:
				{
				    PlayerTextDrawSetPreviewModel(playerid,gCarInfoBuy, Salon3[listitem][0]);
					format(string, sizeof(string), "{ffffff}Вы уверены, что хотите приобрести данный т/c:\n\n"gbInfo"Название автомобиля: [ %s ]\n"gbInfo"Ёмкость багажника [ %d ] мест\n"gbInfo"Емкость топливного бака [ %.0f ]\n"gbInfo"Сумма вашего заказа: [ %d$ ]", CarNames[Salon3[listitem][0] - 400], GetVehicleBagg(Salon3[listitem][0]), MaxVehicleFuel[Salon3[listitem][0] - 400], Salon3[listitem][1]);
				}
			}
			PlayerTextDrawSetPreviewRot(playerid, gCarInfoBuy, -16.000000, 0.000000, 60.000000, 1.000000);
			//PlayerTextDrawSetPreviewRot(playerid, gCarInfoBuy, 0.000000, 0.000000, 50.000000, 1.000000);
			PlayerTextDrawShow(playerid, gCarInfoBuy);

			showPlayerDialog(playerid, d_salon + 1, 0, " ", string,"Согласен","Нет");
		    DeletePVar(playerid, "SALONID");
			SetPVarInt(playerid, "BuyCarsZZ", listitem);
		}
	}
	return 1;
}

public OnPlayerEnterCheckpoint(playerid) {
	clear_massive();
	DisablePlayerCheckpoint(playerid);
	if(GetPVarInt(playerid,"playerUseGPS") == 1) {
	    SendClientMessage(playerid,C_GRAY,""gbAccess"Вы достигли места назначения!");
	    SetPVarInt(playerid,"playerUseGPS",0);
	}

	if(GetPVarInt(playerid, "CallInfoGPS") == 1)
	{
	    new id = GetPVarInt(playerid, "CallInfoIndex");
 	    CallInfo[id][cStatus] = false;
	    DeletePVar(playerid,"CallInfoGPS");
	    DisablePlayerCheckpoint(playerid);
	}
	if(GetPVarInt(playerid,"PosevLoad")) {
    	if(IsPlayerInRangeOfPoint(playerid,3.0,-79.2376,70.9134,3.1172)) {
    	    if(GetVehicleModel(GetPlayerVehicleID(playerid)) != 531) return SendClientMessage(playerid,C_GRAY,""gbError"Вам необходим трактор и специальное оборудование.");
    	    if(GetVehicleModel(GetVehicleTrailer(GetPlayerVehicleID(playerid))) != 610) return SendClientMessage(playerid,C_GRAY,""gbError"Вам необходим трактор и специальное оборудование.");
			if(S::[0][sFerm][5] < 50) return SendClientMessage(playerid,C_GRAY,""gbError"В амбаре нет семян для загрузки в оборудование.");
			SendClientMessage(playerid,C_GRAY,""gbError"Вернитесь на поле и продолжите посадку семян.");
    	    S::[0][sFerm][5] -= 50;
    	    format( gb_string,sizeof(gb_string),"Семена для загрузки\n{ffffff}%d/%d ед.",S::[0][sFerm][5],MAX_SEM_AMBAR_TWO);
	        UpdateDynamic3DTextLabelText(InfoFermText[2],C_BLUE,gb_string);
    	    V::[GetVehicleTrailer(GetPlayerVehicleID(playerid))][vPosev] = MAX_POSEV_IN_VEHICLE;
    	    format(gb_string,sizeof(gb_string),"Семена\n{ffffff}%d/%d ед.",V::[GetVehicleTrailer(GetPlayerVehicleID(playerid))][vPosev],MAX_POSEV_IN_VEHICLE);
    	    UpdateDynamic3DTextLabelText(V::[GetVehicleTrailer(GetPlayerVehicleID(playerid))][vTextFerm],C_BLUE,gb_string);
    	    DisablePlayerCheckpoint(playerid);
    	    DeletePVar(playerid,"PosevLoad");
    	    togglePlayerControllable(playerid,false);
    	    MeAction(playerid,"загрузил(-а) семяна в оборудование",1);
    	    SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);
			DeletePVar(playerid,"PosevLoad");
    	}
	}
	if(GetPVarInt(playerid,"WoodCheckpointTop")) {
	    if(D::[playerid][dWoodsDuty] == 0) {
	        DeletePVar(playerid,"WoodCheckpointTop");
	        DisablePlayerCheckpoint(playerid);
	    }
	    if(IsPlayerInRangeOfPoint(playerid,3.0,-462.9798,-88.4665,59.9006)) {
	        ClearAnimations(playerid);
	        RemovePlayerAttachedObject(playerid,9);
	        DisablePlayerCheckpoint(playerid);
	        DeletePVar(playerid,"WoodCheckpointTop");
	        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	        SetPlayerAttachedObject(playerid,9,341,6);
	        new obj = CreateDynamicObject(1463,-462.97189, -87.00266, 60.04498,0.00000, 0.00000, -90.00000);
	        SetGVarInt("WoodConv",1,obj);
	        MoveDynamicObject(obj,-462.97189, -77.84270, 60.04500,1,0.00000, 0.00000, -90.00000);
	        SetPVarInt(playerid,"PlayerUseBox",4);
	        MeAction(playerid,"положил(-а) древесину на конвеер",1);
         	if(JobValueNow(playerid, 2, 34, -1) != 0) { }
			else {
			    SendClientMessage(playerid, -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
			    showPlayerDialog(playerid, 9999, 0, " ", "{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке", "Закрыть", "");
    			D::[playerid][dWoodsDuty] = 0;
				DeletePVar(playerid,"PlayerUseBox");
				DeletePVar(playerid,"PlayerStanok");
    			GetBackSkin(playerid);
				RemovePlayerAttachedObject(playerid,9);
				SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
			}
	    }
	}
	if(GetPVarInt(playerid,"CheckpointPosevUnload"))
	{
	    if(IsPlayerInRangeOfPoint(playerid,3.0,-60.0373,12.7697,3.1094))
		{
			if(GetVehicleModel(playerid) != 478 && V::[GetPlayerVehicleID(playerid)][vLoadPosev] == 0) return SendClientMessage(playerid,C_GRAY,""gbError"В этом автомобиле нет урожая для разгрузки.");
            if(IsPlayerInRangeOfPoint(playerid,3.0,-60.0373,12.7697,3.1094))
			{
				S::[0][sFerm][0] += V::[GetPlayerVehicleID(playerid)][vLoadPosev];
				format(gb_string,sizeof(gb_string),"Урожай на складе\n{ffffff}%d/%d ед.",S::[0][sFerm][0],MAX_AMBAR_COUNT);
				UpdateDynamic3DTextLabelText(InfoFermText[3],C_BLUE,gb_string);
			}
			V::[GetPlayerVehicleID(playerid)][vLoadPosev] = 0;
			format(gb_string,sizeof(gb_string),"Урожай\n{ffffff}%d/%d ед.",V::[GetPlayerVehicleID(playerid)][vLoadPosev],MAX_LPOSEV_IN_VEHICLE);
    	    UpdateDynamic3DTextLabelText(V::[GetPlayerVehicleID(playerid)][vTextFerm],C_BLUE,gb_string);
    	    DisablePlayerCheckpoint(playerid);
    	    DeletePVar(playerid,"CheckpointPosevUnload");
    	    togglePlayerControllable(playerid,false);
            SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);
		}
	}
	if(GetPVarInt(playerid,"PlayerDriverCheckpoint")) {
	    new v = PlayerTrailer[playerid];
	    switch(GetPVarInt(playerid,"PlayerSelectTrailerTwo")) {
	        case 1: {
	            if(IsPlayerInRangeOfPoint(playerid,5.0,-18.9291,-273.3552,5.4297)) {
					if(V::[v][vMebel] >= MAX_MEBEL_IN_VEHICLE) return SendClientMessage(playerid,C_GRAY,""gbError"В прицепе нет места для загрузки мебели в него.");

					if(MebelZavod <= 0) {
					    SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
					    SendClientMessage(playerid,C_GRAY,""gbInfo"На заводе мебели больше нет мебели, верните прицеп на склад!");
					}
					else if(MebelZavod > 0) {
					    if(MebelZavod < MAX_MEBEL_IN_VEHICLE) {
					        V::[v][vMebel] = MebelZavod;
					        MebelZavod = 0;
					    }
					    else {
					        V::[v][vMebel] = MAX_MEBEL_IN_VEHICLE;
                            MebelZavod -= MAX_MEBEL_IN_VEHICLE;
					    }
					    format(gb_string,sizeof(gb_string),"Мебель\n{ffffff}%d/%d ед.",V::[v][vMebel],MAX_MEBEL_IN_VEHICLE);
      					UpdateDynamic3DTextLabelText(V::[v][vTextTrailer],C_BLUE,gb_string);
	            		format(gb_string,sizeof(gb_string),"Завод мебели\n\n{ffffff}Мебель: %d ед.\nДревесины: %d ед.",MebelZavod,WoodsZavod);
						UpdateDynamic3DTextLabelText(InfoFermText[7],C_BLUE,gb_string);
						SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
						SendClientMessage(playerid,C_GRAY,""gbInfo"Вам в прицеп загрузили мебель, отвезите её на общий склад.");
					}

					togglePlayerControllable(playerid,false);
					SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);
	            }
	            if(IsPlayerInRangeOfPoint(playerid,5.0,1061.2046,-322.2485,73.9851)) {
	                S::[0][sProducts] += V::[v][vMebel];
	                V::[v][vMebel] = 0;
	                DestroyVehicle(v);
	                
	                if (IsValidDynamic3DTextLabel(V::[v][vTextTrailer]))
	                	DestroyDynamic3DTextLabel(V::[v][vTextTrailer]);
	                
	                SetPVarInt(playerid,"dettachTrailer",0);
	                PlayerTrailer[playerid] = -1;
					if(Player[playerid][uDalnSkill] != 150) Player[playerid][uDalnSkill] ++;
					if(JobValueNow(playerid, 10, 300,Player[playerid][uJob]) != 0) { }
					else
					{
					    D::[playerid][dDalnDuty] = false;
		                if(D::[playerid][dDalnKey] != -1) SetVehicleToRespawn(D::[playerid][dDalnKey]);
						DisablePlayerCheckpoint(playerid);
					}
					format(gb_string,sizeof(gb_string),"UPDATE gb_users SET uDalnSkill = '%d' WHERE BINARY uName = '%s'",Player[playerid][uDalnSkill],Player[playerid][uName]);
					mysql_tquery(1, gb_string, "", "");
	            }
	        }
	        case 2: {
	        	if(IsPlayerInRangeOfPoint(playerid,5.0,248.2978,1420.6721,10.5727)) {
	        	    if(V::[v][vToplivo] >= MAX_FUEL_IN_VEHICLE) return showPlayerDialog(playerid,d_daln + 2,2,"Выбор маршрута","1. "cGRAY"Отвезти топливо на ферму{ffffff}\n2. "cGRAY"Отвозить топливо по бизнесам","Дальше","");
	        	    if(ToplivoZavod == 0) return SendClientMessage(playerid,C_GRAY,""gbError"На заводе закончилось топливо.");

	        	    if(ToplivoZavod <= 0) {
	        	        SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
	        	        SendClientMessage(playerid,C_GRAY,""gbInfo"На заводе закончилось топливо, верните прицеп на склад!");
	        	    }
	        	    else if(ToplivoZavod > 0) {
	        	        if(ToplivoZavod < MAX_FUEL_IN_VEHICLE) {
	        	            V::[v][vToplivo] = ToplivoZavod;
	        	            ToplivoZavod = 0;
	        	        }
	        	        else {
	        	            V::[v][vToplivo] = MAX_FUEL_IN_VEHICLE;
	        	            ToplivoZavod -= MAX_FUEL_IN_VEHICLE;
	        	        }
	        	        format(gb_string,sizeof(gb_string),"Топливо\n{ffffff}%d/%d л.",V::[v][vToplivo],MAX_FUEL_IN_VEHICLE);
			            UpdateDynamic3DTextLabelText(V::[v][vTextTrailer],C_BLUE,gb_string);
			            format(gb_string,sizeof(gb_string),"Нефтеперерабатывающий завод\n\n{ffffff}Топливо: {ffffff}%d л.",ToplivoZavod);
			            UpdateDynamic3DTextLabelText(InfoFermText[8],C_BLUE,gb_string);
	        	        showPlayerDialog(playerid,d_daln + 2,2,"Выбор маршрута","1. "cGRAY"Отвезти топливо на ферму{ffffff}\n2. "cGRAY"Отвозить топливо по бизнесам","Дальше","");
	        	    }

					togglePlayerControllable(playerid,false);
					SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);
	            }
				if(IsPlayerInRangeOfPoint(playerid,5.0,-94.6174,68.8944,3.1172)) {
				    S::[0][sFerm][6] += V::[v][vToplivo];
					if(S::[0][sFerm][6] > MAX_FUEL_IN_FERMA) S::[0][sFerm][6] = MAX_FUEL_IN_FERMA;
	                V::[v][vToplivo] = 0;
	                format(gb_string,sizeof(gb_string),"Топливо\n{ffffff}%d/%d л.",V::[v][vToplivo],MAX_FUEL_IN_VEHICLE);
	            	UpdateDynamic3DTextLabelText(V::[v][vTextTrailer],C_BLUE,gb_string);
	            	SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
	            	SendClientMessage(playerid,C_GRAY,""gbInfo"Вы отвезли топливо на ферму, верните прицеп обратно.");
	            	togglePlayerControllable(playerid,false);
	            	SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);
				}
				if(IsPlayerInRangeOfPoint(playerid,5.0,1061.2046,-322.2485,73.9851)) {
				    DestroyVehicle(v);
				    
				    if (IsValidDynamic3DTextLabel(V::[v][vTextTrailer]))
				    	DestroyDynamic3DTextLabel(V::[v][vTextTrailer]);
				    	
				    if(Player[playerid][uDalnSkill] != 150) Player[playerid][uDalnSkill] ++;
        			
        			if(JobValueNow(playerid, 20, 500,Player[playerid][uJob]) != 0) { }
					else
					{
					    D::[playerid][dDalnDuty] = false;
		                if(D::[playerid][dDalnKey] != -1) SetVehicleToRespawn(D::[playerid][dDalnKey]);
						DisablePlayerCheckpoint(playerid);
					}
        			
        			SetPVarInt(playerid,"dettachTrailer",0);
				    PlayerTrailer[playerid] = -1;
				    format(gb_string,sizeof(gb_string),"UPDATE gb_users SET uDalnSkill = '%d' WHERE BINARY uName = '%s'",Player[playerid][uDalnSkill],Player[playerid][uName]);
					mysql_tquery(1, gb_string, "", "");
				}
	        }
	        case 3: {
            	if(IsPlayerInRangeOfPoint(playerid,5.0,-112.0009,-1.5788,3.1172))
				{
                    if(IsPlayerInRangeOfPoint(playerid,5.0,-112.0009,-1.5788,3.1172))
					{
                        if(S::[0][sFerm][0] == 0)
						{
                            SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
							return SendClientMessage(playerid,C_GRAY,""gbInfo"На складе нет урожая для загрузки вам, верните прицеп обратно.");
						}
                    }
                	if(V::[v][vUrojai] >= MAX_UROJAI_IN_VEHICLE) return SendClientMessage(playerid,C_GRAY,""gbError"В прицепе недостаточно места для загрузки урожая.");
					if(IsPlayerInRangeOfPoint(playerid,5.0,-112.0009,-1.5788,3.1172)) SetPVarInt(playerid,"AmbarSelect",1);
					if(S::[0][sFerm][GetPVarInt(playerid,"AmbarSelect") - 1] <= 0) {
					    SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
					    SendClientMessage(playerid,C_GRAY,""gbInfo"На ферме больше нет урожая, отвезите прицеп обратно на склад.");
					}
					else if(S::[0][sFerm][GetPVarInt(playerid,"AmbarSelect") - 1] > 0) {
						if(S::[0][sFerm][GetPVarInt(playerid,"AmbarSelect") - 1] < MAX_UROJAI_IN_VEHICLE) {
                            V::[v][vUrojai] += S::[0][sFerm][GetPVarInt(playerid,"AmbarSelect") - 1];
						    S::[0][sFerm][GetPVarInt(playerid,"AmbarSelect") - 1] = 0;
						}
						else if(S::[0][sFerm][GetPVarInt(playerid,"AmbarSelect") - 1] > MAX_UROJAI_IN_VEHICLE) {
						    V::[v][vUrojai] += MAX_UROJAI_IN_VEHICLE;
						    S::[0][sFerm][GetPVarInt(playerid,"AmbarSelect") - 1] -= MAX_UROJAI_IN_VEHICLE;
						}
					    format(gb_string,sizeof(gb_string),"Урожай на складе\n{ffffff}%d/%d ед.",S::[0][sFerm][0],MAX_AMBAR_COUNT);
						UpdateDynamic3DTextLabelText(InfoFermText[3],C_BLUE,gb_string);
						format(gb_string,sizeof(gb_string),"Урожай\n{ffffff}%d/%d ед.",V::[v][vUrojai],MAX_UROJAI_IN_VEHICLE);
			            UpdateDynamic3DTextLabelText(V::[v][vTextTrailer],C_BLUE,gb_string);
					    SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
						SendClientMessage(playerid,C_GRAY,""gbInfo"Вам в прицеп загрузили урожай, отвезите его на общий склад.");
					}
					togglePlayerControllable(playerid,false);
					SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);
				}
				if(IsPlayerInRangeOfPoint(playerid,5.0,1061.2046,-322.2485,73.9851)) {
	                S::[0][sProducts] += V::[v][vUrojai] / 2;
	                V::[v][vUrojai] = 0;
	                DestroyVehicle(v);
	                if (IsValidDynamic3DTextLabel(V::[v][vTextTrailer]))
	                	DestroyDynamic3DTextLabel(V::[v][vTextTrailer]);
	                
	                SetPVarInt(playerid,"dettachTrailer",0);
	                PlayerTrailer[playerid] = -1;
	                if(Player[playerid][uDalnSkill] != 150) Player[playerid][uDalnSkill] ++;
	                if(JobValueNow(playerid, 20, 500,Player[playerid][uJob]) != 0) { }
					else
					{
					    D::[playerid][dDalnDuty] = false;
		                if(D::[playerid][dDalnKey] != -1) SetVehicleToRespawn(D::[playerid][dDalnKey]);
						DisablePlayerCheckpoint(playerid);
					}
	                format(gb_string,sizeof(gb_string),"UPDATE gb_users SET uDalnSkill = '%d' WHERE BINARY uName = '%s'",Player[playerid][uDalnSkill],Player[playerid][uName]);
					mysql_tquery(1, gb_string, "", "");
	            }
	        }
	        case 4: {
	            if(IsPlayerInRangeOfPoint(playerid,5.0,-496.0325,-82.4771,61.2981)) {
	                if(S::[0][wsWoodsSklad] == 0) {
						if(V::[v][vWoods] == 0) {
	                		SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
							return SendClientMessage(playerid,C_GRAY,""gbInfo"На лесопилке закончилась древесина, верните прицеп обратно.");
						}
						else if(V::[v][vWoods] != 0) {
						    SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,-18.9291,-273.3552,5.4297,5.0));
							return SendClientMessage(playerid,C_GRAY,""gbInfo"На лесопилке закончилась древесина, отвезите всё что у вас есть на завод мебели.");
						}
					}
					if(V::[v][vWoods] >= MAX_WOODS_IN_VEHICLE) return SendClientMessage(playerid,C_GRAY,""gbError"В прицепе недостаточно места для загрузки урожая.");
					if(S::[0][wsWoodsSklad] <= 0) {
					    SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
					    SendClientMessage(playerid,C_GRAY,""gbInfo"На лесопилке больше нет древесины, отвезите прицеп на склад!");
					}
					else if(S::[0][wsWoodsSklad] > 0) {
					    if(S::[0][wsWoodsSklad] < MAX_WOODS_IN_VEHICLE) {
					        V::[v][vWoods] = S::[0][wsWoodsSklad];
					        S::[0][wsWoodsSklad] = 0;
					    }
					    else {
					        V::[v][vWoods] = MAX_WOODS_IN_VEHICLE;
                            S::[0][wsWoodsSklad] -= MAX_WOODS_IN_VEHICLE;
					    }
					}
					format(gb_string,sizeof(gb_string),"Древесина\n{ffffff}%d/%d кг.",V::[v][vWoods],MAX_WOODS_IN_VEHICLE);
					UpdateDynamic3DTextLabelText(V::[v][vTextTrailer],C_BLUE,gb_string);
					format(gb_string,sizeof(gb_string),"Обработанная древесина\n{ffffff}%d кг.",S::[0][wsWoodsSklad]);
		    		UpdateDynamic3DTextLabelText(S::[0][wsWoodsTS][0],C_BLUE,gb_string);
		    		UpdateDynamic3DTextLabelText(S::[0][wsWoodsTS][1],C_BLUE,gb_string);
					togglePlayerControllable(playerid,false);
					SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);
					SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,-18.9291,-273.3552,5.4297,5.0));
					SendClientMessage(playerid,C_GRAY,""gbInfo"Вам в прицеп загрузили древесину, отвезите её на завод мебели.");
	            }
	            if(IsPlayerInRangeOfPoint(playerid,5.0,-18.9291,-273.3552,5.4297)) {
	                WoodsZavod += V::[v][vWoods];
	                V::[v][vWoods] = 0;
	                SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
	                format(gb_string,sizeof(gb_string),"Древесина\n{ffffff}%d/%d кг.",V::[v][vWoods],MAX_WOODS_IN_VEHICLE);
					UpdateDynamic3DTextLabelText(V::[v][vTextTrailer],C_BLUE,gb_string);
					format(gb_string,sizeof(gb_string),"Завод мебели\n\n{ffffff}Мебель: %d ед.\nДревесины: %d ед.",MebelZavod,WoodsZavod);
					UpdateDynamic3DTextLabelText(InfoFermText[7],C_BLUE,gb_string);
					SendClientMessage(playerid,C_GRAY,""gbInfo"Вы отвезли древесину на завод, верните прицеп обратно.");
					togglePlayerControllable(playerid,false);
					SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);
	            }
	            if(IsPlayerInRangeOfPoint(playerid,5.0,1061.2046,-322.2485,73.9851)) {
	                DestroyVehicle(v);
	                
	                if (IsValidDynamic3DTextLabel(V::[v][vTextTrailer]))
	                	DestroyDynamic3DTextLabel(V::[v][vTextTrailer]);
	                
	                SetPVarInt(playerid,"dettachTrailer",0);
	                PlayerTrailer[playerid] = -1;
	                if(Player[playerid][uDalnSkill] != 150) Player[playerid][uDalnSkill] ++;
	                
	                if(JobValueNow(playerid, 10, 300,Player[playerid][uJob]) != 0) { }
					else
					{
					    D::[playerid][dDalnDuty] = false;
		                if(D::[playerid][dDalnKey] != -1) SetVehicleToRespawn(D::[playerid][dDalnKey]);
						DisablePlayerCheckpoint(playerid);
					}
	                
	                format(gb_string,sizeof(gb_string),"UPDATE gb_users SET uDalnSkill = '%d' WHERE BINARY uName = '%s'",Player[playerid][uDalnSkill],Player[playerid][uName]);
					mysql_tquery(1, gb_string, "", "");
	            }
	        }
	    }
	}
	if(GetPVarInt(playerid,"BackFermTransport")) {
	    if(IsPlayerInRangeOfPoint(playerid,3.0,-45.1872,80.6483,3.1172)) {
	        if(GetVehicleModel(GetPlayerVehicleID(playerid)) != 531) return SendClientMessage(playerid,C_GRAY,""gbError"Это не тот транспорт, который вам нужно вернуть обратно.");
	        SendClientMessage(playerid,C_GRAY,""gbInfo"Вы закончили вспашку и засеивание урожая, теперь подождите пока урожай вырастет ( 15 минут ).");
	        V::[GetVehicleTrailer(GetPlayerVehicleID(playerid))][vPosev] = 0;
    	    format(gb_string,sizeof(gb_string),"Семена\n{ffffff}%d/%d ед.",V::[GetVehicleTrailer(GetPlayerVehicleID(playerid))][vPosev],MAX_POSEV_IN_VEHICLE);
    	    UpdateDynamic3DTextLabelText(V::[GetVehicleTrailer(GetPlayerVehicleID(playerid))][vTextFerm],C_BLUE,gb_string);
	        SetVehicleToRespawn(GetVehicleTrailer(GetPlayerVehicleID(playerid)));
	        SetVehicleToRespawn(GetPlayerVehicleID(playerid));
	        DisablePlayerCheckpoint(playerid);
	        DisablePlayerRaceCheckpoint(playerid);
			DeletePVar(playerid,"BackFermTransport");
	    }
	}
	if(GetPVarInt(playerid,"BackFermTransportKomb")) {
	    if(IsPlayerInRangeOfPoint(playerid,5.0,-108.6581,25.4261,3.1172)) {
	        if(GetVehicleModel(GetPlayerVehicleID(playerid)) != 532) return SendClientMessage(playerid,C_GRAY,""gbError"Это не тот транспорт, который вам нужно вернуть обратно.");
	        showPlayerDialog(playerid,9999,0,"Справка","{ffffff}\
	        Вы прекрасно поработали за этот день, но теперь вы должны отдохнуть.\n\
	        "cGREEN"Мы ждём Вас через 3 часа на работе или вы можете помочь фермерам с работой.","Закрыть","");
	        SetVehicleToRespawn(GetPlayerVehicleID(playerid));
	        DisablePlayerCheckpoint(playerid);
	        DisablePlayerRaceCheckpoint(playerid);
	        FermersOnline --;
	        DeletePVar(playerid,"BackFermTransportKomb");
	        D::[playerid][dFermClassDuty] = 0;
            GetBackSkin(playerid);
            DeletePVar(playerid,"CheckpointFermaPole");
            DeletePVar(playerid,"BackFermTransport");
	    }
	}
	if(GetPVarInt(playerid,"CheckpointBack")) {
		if(IsPlayerInRangeOfPoint(playerid,5.0,1099.9902,-1242.7791,15.3823)) {
        	DisablePlayerCheckpoint(playerid);
        	new car = GetPlayerVehicleID(playerid);
        	SetVehicleToRespawn(car);
        	SetPVarInt(playerid,"CountBackTaxi",0);
			DeletePVar(playerid,"CheckpointBack");
			D::[playerid][dTaxiDuty] = false;
			SendClientMessage(playerid, -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
			showPlayerDialog(playerid,9999,0," ","{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке","Закрыть","");
		}
	}
	if(GetPVarInt(playerid,"CheckpointBackDaln")) {
		if(IsPlayerInRangeOfPoint(playerid,5.0,2209.2693,-2220.6868,14.1527)) {
        	DisablePlayerCheckpoint(playerid);
        	new car = GetPlayerVehicleID(playerid);
        	SetVehicleToRespawn(car);
        	if(PlayerTrailer[playerid] != -1) {
	        	V::[PlayerTrailer[playerid]][vWoods] = 0;
				V::[PlayerTrailer[playerid]][vUrojai] = 0;
				V::[PlayerTrailer[playerid]][vMebel] = 0;
				V::[PlayerTrailer[playerid]][vToplivo] = 0;
			    DestroyVehicle(PlayerTrailer[playerid]);
			    
			    if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]))
			    	DestroyDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]);
			    
		        PlayerTrailer[playerid] = -1;
		        SetPVarInt(playerid,"dettachTrailer",0);
	        }
        	SetPVarInt(playerid,"CountBackDaln",0);
			DeletePVar(playerid,"CheckpointBackDaln");
		}
	}
	if(GetPVarInt(playerid,"SemToGo")) {
	    if(IsPlayerInRangeOfPoint(playerid,1.0,-79.2376,70.9134,3.1172)) {
	        if(S::[0][sFerm][5] >= MAX_SEM_AMBAR_TWO) {
	            DisablePlayerCheckpoint(playerid);
	            SetPVarInt(playerid,"PlayerUseBox",0);
	            DeletePVar(playerid,"SemToGo");
	            RemovePlayerAttachedObject(playerid,9);
	            SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	            return SendClientMessage(playerid,C_GRAY,""gbError"В амбаре закончилось место для семян.");
	        }
	        SetPVarInt(playerid, "SemValue", GetPVarInt(playerid, "SemValue") + 1);
			if(GetPVarInt(playerid, "SemValue") >= 2)
			{
	            if(JobValueNow(playerid, 1, 15, -1) != 0) DeletePVar(playerid,"SemValue");
				else
				{
	   				if(D::[playerid][dFermClassDuty] == 1) {
						FermersOnline --;
						SendClientMessage(playerid, -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
						showPlayerDialog(playerid,9999,0," ","{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке","Закрыть","");
					}
					if(D::[playerid][dFermClassDuty] == 2) SendClientMessage(playerid,-1,""gbError"Вы закончили свой рабочий день помощником фермы!");
		            D::[playerid][dFermClassDuty] = 0;
		            GetBackSkin(playerid);
		            RemovePlayerAttachedObject(playerid,9);
		            DisablePlayerCheckpoint(playerid);
		            DisablePlayerRaceCheckpoint(playerid);
		            SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
		            MeAction(playerid,"увольняется с работы",1);
		            DeletePVar(playerid,"CheckpointFermaPole");
		            DeletePVar(playerid,"BackFermTransport");
				}
			}
	        RemovePlayerAttachedObject(playerid,9);
	        S::[0][sFerm][5] += 50;
	        SetPVarInt(playerid,"PlayerUseBox",0);
	        format(gb_string,sizeof(gb_string),"Семена для загрузки\n{ffffff}%d/%d ед.",S::[0][sFerm][5],MAX_SEM_AMBAR_TWO);
	        UpdateDynamic3DTextLabelText(InfoFermText[2],C_BLUE,gb_string);
	        DisablePlayerCheckpoint(playerid);
	        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	        ClearAnimations(playerid);
	        DeletePVar(playerid,"SemToGo");
		}
	}
	if(GetPVarInt(playerid,"ProductsCheckpoint")) {
		new id = GetPVarInt(playerid,"PlayerSelectedProducts") - 1;
		if(IsPlayerInRangeOfPoint(playerid,5.0,Bizz::[Product::[id][bID]][bEnter][0],Bizz::[Product::[id][bID]][bEnter][1],Bizz::[Product::[id][bID]][bEnter][2]) && (dalncars[0] <= GetPlayerVehicleID(playerid) <= dalncars[1])) {
			if(Product::[id][bCount] <= 0) return SendClientMessage(playerid,C_GRAY,""gbError"Этот заказ уже был выполнен, возьмите другой (( "cBLUE"/job {ffffff}))");
			if(V::[GetPlayerVehicleID(playerid)][vProducts] == 0) {
				if(GetPVarInt(playerid,"PlayerSelectedProducts") != 0) Product::[GetPVarInt(playerid,"PlayerSelectedProducts") - 1][bStatus] = false;
				DeletePVar(playerid,"ProductsCheckpoint");
				return DisablePlayerCheckpoint(playerid);
			}
			new i = Product::[id][bID];

			if(V::[GetPlayerVehicleID(playerid)][vProducts] < Product::[id][bCount]) {
				if(Bizz::[i][bSettings][6] < V::[GetPlayerVehicleID(playerid)][vProducts]) return SendClientMessage(playerid,C_GRAY,""gbError"В данном бизнесе недостаточно денег для оплаты заказа!");
				Bizz::[i][bSettings][3] += V::[GetPlayerVehicleID(playerid)][vProducts];
				Bizz::[i][bSellHour] = 0;
				SetBizzStr(Bizz::[i][bID],"bSellHour",Bizz::[i][bSellHour]);
				Product::[id][bCount] -= V::[GetPlayerVehicleID(playerid)][vProducts];
				if(V::[GetPlayerVehicleID(playerid)][vProducts] >= 450) 
				{
		            if(JobValueNow(playerid, 10, 300, Player[playerid][uJob]) != 0) { }
					else
					{
                        D::[playerid][dJobMarsh] = 0;
						D::[playerid][dDalnDuty] = false;
		    			if(D::[playerid][dDalnKey] != -1) SetVehicleToRespawn(D::[playerid][dDalnKey]);
						MeAction(playerid,"закончил(-а) рабочий день",1);
						DisablePlayerCheckpoint(playerid);
					}
				}
				else SendClientMessage(playerid,C_GRAY,""gbError"У вас с собой слишком мало продуктов для выдачи денег Вам!");
				Bizz::[i][bSettings][6] -= V::[GetPlayerVehicleID(playerid)][vProducts];
                V::[GetPlayerVehicleID(playerid)][vProducts] = 0;
			}
			else if(V::[GetPlayerVehicleID(playerid)][vProducts] >= Product::[id][bCount]) {
				if(Bizz::[i][bSettings][6] < Product::[id][bCount]) return SendClientMessage(playerid,C_GRAY,""gbError"В данном бизнесе недостаточно денег для оплаты заказа!");
				Bizz::[i][bSettings][3] += Product::[id][bCount];
				Bizz::[i][bSellHour] = 0;
				//SetBizzStr(Bizz::[i][bID],"bSellHour",Bizz::[i][bSellHour]);
				SetBizzStr(Bizz::[i][bID],"bSellHour",Bizz::[i][bSellHour]);
				if(V::[GetPlayerVehicleID(playerid)][vProducts] >= 450)
				{
				    if(JobValueNow(playerid, 10, 300, Player[playerid][uJob]) != 0) { }
					else
					{
                        D::[playerid][dJobMarsh] = 0;
						D::[playerid][dDalnDuty] = false;
		    			if(D::[playerid][dDalnKey] != -1) SetVehicleToRespawn(D::[playerid][dDalnKey]);
						MeAction(playerid,"закончил(-а) рабочий день",1);
						DisablePlayerCheckpoint(playerid);
					}
				}
				else SendClientMessage(playerid,C_GRAY,""gbError"У вас с собой слишком мало продуктов для выдачи денег Вам!");
				V::[GetPlayerVehicleID(playerid)][vProducts] -= Product::[id][bCount];
				Bizz::[i][bSettings][6] -= Product::[id][bCount];
				Product::[id][bID] = 0;
		        Product::[id][bCount] = 0;
		        Bizz::[i][bProds] = false;
			}
            Product::[id][pStatus] = false;
            
			SetPVarInt(playerid, "LoadNow", 0);

			SendClientMessage(playerid,C_GRAY,""gbAccess"Вы выполнили заказ на развозку товаров!");

			if(GetPVarInt(playerid,"PlayerSelectedProducts") != 0) Product::[GetPVarInt(playerid,"PlayerSelectedProducts") - 1][bStatus] = false;
			DeletePVar(playerid,"PlayerSelectedProducts");

			if(V::[GetPlayerVehicleID(playerid)][vProducts] != 0) {
				format(gb_string,sizeof(gb_string),"Товары:\n{ffffff}%d/%d ед.",V::[GetPlayerVehicleID(playerid)][vProducts],MAX_PRODUCTS_INCAR);
				UpdateDynamic3DTextLabelText(V::[GetPlayerVehicleID(playerid)][vProductsText],C_BLUE,gb_string);
			}
			else
			{
			    if (IsValidDynamic3DTextLabel(V::[GetPlayerVehicleID(playerid)][vProductsText]))
					DestroyDynamic3DTextLabel(V::[GetPlayerVehicleID(playerid)][vProductsText]);
			}

			format(gb_string,sizeof(gb_string),"%d|%d|%d|%d|%d|%d|%d|%d",Bizz::[i][bSettings][0],Bizz::[i][bSettings][1],Bizz::[i][bSettings][2],
			Bizz::[i][bSettings][3],Bizz::[i][bSettings][4],Bizz::[i][bSettings][5],Bizz::[i][bSettings][6],Bizz::[i][bSettings][7]);
			SetBizzStr(Bizz::[i][bID],"bSettings",gb_string);

			DeletePVar(playerid,"ProductsCheckpoint");
			togglePlayerControllable(playerid,false);
			SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);

			DisablePlayerCheckpoint(playerid);
			return 1;
		}
	}
	if(GetPVarInt(playerid,"FuelsCheckpoint")) {
		new id = GetPVarInt(playerid,"PlayerSelectedFuels") - 1;
		if(IsPlayerInRangeOfPoint(playerid,10.0,Bizz::[Fuel::[id][bID]][bEnter][0],Bizz::[Fuel::[id][bID]][bEnter][1],Bizz::[Fuel::[id][bID]][bEnter][2]) && PlayerTrailer[playerid] != -1 && (dalncars[0] <= GetPlayerVehicleID(playerid) <= dalncars[1])) {
            if(Fuel::[id][bCount] <= 0) {
                showPlayerDialog(playerid,d_daln + 2,2,"Выбор маршрута","1. "cGRAY"Отвезти топливо на ферму{ffffff}\n2. "cGRAY"Отвозить топливо по бизнесам","Дальше","");
				DeletePVar(playerid,"FuelsCheckpoint");
				return SendClientMessage(playerid,C_GRAY,""gbError"Этот заказ уже был выполнен, возьмите другой.");
			}
			if(GetVehicleTrailer(GetPlayerVehicleID(playerid)) != PlayerTrailer[playerid]) {
				if(GetPVarInt(playerid,"PlayerSelectedFuels") != 0) Fuel::[GetPVarInt(playerid,"PlayerSelectedFuels") - 1][bStatus] = false;
				DeletePVar(playerid,"FuelsCheckpoint");
				DisablePlayerCheckpoint(playerid);
				return SendClientMessage(playerid,C_GRAY,""gbError"У вашего тягача должна быть цистерна с топливом!");
			}
			if(V::[PlayerTrailer[playerid]][vToplivo] == 0 && GetVehicleTrailer(GetPlayerVehicleID(playerid)) == PlayerTrailer[playerid]) {
				if(GetPVarInt(playerid,"PlayerSelectedFuels") != 0) Fuel::[GetPVarInt(playerid,"PlayerSelectedFuels") - 1][bStatus] = false;
				SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
				DeletePVar(playerid,"FuelsCheckpoint");
				return SendClientMessage(playerid,C_GRAY,""gbInfo"В вашей цистерне закончилось топливо, верните цистерну обратно!");
			}

			new i = Fuel::[id][bID];

			if(V::[PlayerTrailer[playerid]][vToplivo] < Fuel::[id][bCount]) {
				if(Bizz::[i][bSettings][6] < V::[PlayerTrailer[playerid]][vToplivo]) {
					showPlayerDialog(playerid,d_daln + 2,2,"Выбор маршрута","1. "cGRAY"Отвезти топливо на ферму{ffffff}\n2. "cGRAY"Отвозить топливо по бизнесам","Дальше","");
					DeletePVar(playerid,"FuelsCheckpoint");
					return SendClientMessage(playerid,C_GRAY,""gbError"В данном бизнесе недостаточно денег для оплаты заказа!");
				}
				Bizz::[i][bSettings][3] += V::[PlayerTrailer[playerid]][vToplivo];
				Bizz::[i][bSellHour] = 0;
				SetBizzStr(Bizz::[i][bID],"bSellHour",Bizz::[i][bSellHour]);
				Fuel::[id][bCount] -= V::[PlayerTrailer[playerid]][vToplivo];
				
				JobValueNow(playerid, 20, 500, Player[playerid][uJob]);
				//GiveJobMoney(playerid,Player[playerid][uJob],V::[PlayerTrailer[playerid]][vToplivo]);
				Bizz::[i][bSettings][6] -= V::[PlayerTrailer[playerid]][vToplivo];
				V::[PlayerTrailer[playerid]][vToplivo] = 0;
			}
			else if(V::[PlayerTrailer[playerid]][vToplivo] >= Fuel::[id][bCount]) {
				if(Bizz::[i][bSettings][6] < Product::[id][bCount]) {
					showPlayerDialog(playerid,d_daln + 2,2,"Выбор маршрута","1. "cGRAY"Отвезти топливо на ферму{ffffff}\n2. "cGRAY"Отвозить топливо по бизнесам","Дальше","");
					DeletePVar(playerid,"FuelsCheckpoint");
					return SendClientMessage(playerid,C_GRAY,""gbError"В данном бизнесе недостаточно денег для оплаты заказа!");
				}
				Bizz::[i][bSettings][3] += Fuel::[id][bCount];
				Bizz::[i][bSellHour] = 0;
				SetBizzStr(Bizz::[i][bID],"bSellHour",Bizz::[i][bSellHour]);
                JobValueNow(playerid, 20, 500, Player[playerid][uJob]);
				//GiveJobMoney(playerid,Player[playerid][uJob],Fuel::[id][bCount]);
				V::[PlayerTrailer[playerid]][vToplivo] -= Fuel::[id][bCount];
				Bizz::[i][bSettings][6] -= Fuel::[id][bCount];
				Fuel::[id][bID] = 0;
		        Fuel::[id][bCount] = 0;
			}

			SendClientMessage(playerid,C_GRAY,""gbAccess"Вы выполнили заказ на развозку топлива!");
			if(GetPVarInt(playerid,"PlayerSelectedFuels") != 0) Fuel::[GetPVarInt(playerid,"PlayerSelectedFuels") - 1][bStatus] = false;
			DeletePVar(playerid,"PlayerSelectedFuels");

			format(gb_string,sizeof(gb_string),"Топливо\n{ffffff}%d/%d л.",V::[PlayerTrailer[playerid]][vToplivo],MAX_FUEL_IN_VEHICLE);
			UpdateDynamic3DTextLabelText(V::[PlayerTrailer[playerid]][vTextTrailer],C_BLUE,gb_string);

			format(gb_string,sizeof(gb_string),"%d|%d|%d|%d|%d|%d|%d|%d",Bizz::[i][bSettings][0],Bizz::[i][bSettings][1],Bizz::[i][bSettings][2],
			Bizz::[i][bSettings][3],Bizz::[i][bSettings][4],Bizz::[i][bSettings][5],Bizz::[i][bSettings][6],Bizz::[i][bSettings][7]);
			SetBizzStr(Bizz::[i][bID],"bSettings",gb_string);

			DisablePlayerCheckpoint(playerid);

			togglePlayerControllable(playerid,false);
			SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);

			if(V::[PlayerTrailer[playerid]][vToplivo] == 0) {
				SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
				SendClientMessage(playerid,C_GRAY,""gbInfo"В вашей цистерне закончилось топливо, верните цистерну обратно!");
				DeletePVar(playerid,"FuelsCheckpoint");
			}
			else {
				DeletePVar(playerid,"FuelsCheckpoint");
				showPlayerDialog(playerid,d_daln + 2,2,"Выбор маршрута","1. "cGRAY"Отвезти топливо на ферму{ffffff}\n2. "cGRAY"Отвозить топливо по бизнесам","Дальше","");
			}
		}
	}
	return 1;
}

public OnDynamicObjectMoved(objectid)
{
	new string[128];
    if(GetGVarType("WoodConv2",objectid) == GLOBAL_VARTYPE_INT) {
    	DeleteGVar("WoodConv2",objectid);
    	DestroyDynamicObject(objectid);
    	S::[0][wsWoods] += 25;
    	format(string,sizeof(string),"Древесина\n{ffffff}%d кг.",S::[0][wsWoods]);
    	UpdateDynamic3DTextLabelText(S::[0][wsWoodsT],C_BLUE,string);
	}
	if(GetGVarType("WoodStanok2",objectid) == GLOBAL_VARTYPE_INT) {
	    DeleteGVar("WoodStanok2",objectid);
	    DestroyDynamicObject(objectid);
	}
	if(GetGVarType("WoodStanok3",objectid) == GLOBAL_VARTYPE_INT) {
	    DeleteGVar("WoodStanok3",objectid);
	    DestroyDynamicObject(objectid);
	}
	if(GetGVarType("WoodGoSklad",objectid) == GLOBAL_VARTYPE_INT) {
	    DeleteGVar("WoodGoSklad",objectid);
	    DestroyDynamicObject(objectid);
	    S::[0][wsWoodsSklad] += 10;
	    format(string,sizeof(string),"Обработанная древесина\n{ffffff}%d кг.",S::[0][wsWoodsSklad]);
	    UpdateDynamic3DTextLabelText(S::[0][wsWoodsTS][0],C_BLUE,string);
	    UpdateDynamic3DTextLabelText(S::[0][wsWoodsTS][1],C_BLUE,string);
	}
	if(GetGVarType("WoodGoSklad2",objectid) == GLOBAL_VARTYPE_INT) {
	    DeleteGVar("WoodGoSklad2",objectid);
	    DestroyDynamicObject(objectid);
	}
	if(GetGVarType("WoodConv",objectid) == GLOBAL_VARTYPE_INT) {
    	DeleteGVar("WoodConv",objectid);
    	DestroyDynamicObject(objectid);
    	new obj = CreateDynamicObject(1463,-456.91119, -94.95390, 774.12469,0.00000, 0.00000, 0.00000);
	    SetGVarInt("WoodConv2",1,obj);
	    MoveDynamicObject(obj,-464.57120, -94.95390, 774.12469,1,0.00000, 0.00000, 0.00000);
    }
	if(GetGVarType("WoodStanok",objectid) == GLOBAL_VARTYPE_INT) {
	    DeleteGVar("WoodStanok",objectid);
	    DestroyDynamicObject(objectid);
	    
	    new obj = CreateDynamicObject(2468,-468.29230, -86.36710, 773.94043,0.00,0.00,90.00);
	    new obj2 = CreateDynamicObject(2468, -468.35901, -86.75980, 773.94043,0.00,0.00,-90.00);
	    MoveDynamicObject(obj,-468.29230, -90.60710, 773.94043,1,0.00,0.00,90.00);
	    MoveDynamicObject(obj2,-468.35898, -90.97980, 773.94043,1,0.00,0.00,-90.00);
	    
	    SetGVarInt("WoodStanok2",1,obj);
	    SetGVarInt("WoodStanok3",1,obj2);
	}
	return 1;
}

public OnPlayerEnterRaceCheckpoint(playerid) {
	new string[128];
	if(GetPVarInt(playerid,"CheckpointFermaPole")) {
        if(GetVehicleModel(GetVehicleTrailer(GetPlayerVehicleID(playerid))) != 610) return SendClientMessage(playerid,C_GRAY,""gbError"У вас должно быть подцепленно специальное оборудование.");
        new Float:x,Float:y;
		x = -157 - random(77);
		y = 70 - random(153);
		DeletePVar(playerid,"CheckpointFermaPole");
	    SetPVarInt(playerid,"CheckpointFermaPole",_:SetPlayerRaceCheckpoint(playerid,2,x,y,3.12,0.0,0.0,0.0,5.0));
        if(PoleV < 100)
		{
			PoleV += 2.0;
            SetPVarInt(playerid, "SemValueT", GetPVarInt(playerid, "SemValueT") + 1);
			if(GetPVarInt(playerid, "SemValueT") >= 5)
			{
	            if(JobValueNow(playerid, 1, 24, -1) != 0) DeletePVar(playerid,"SemValueT");
				else
				{
	   				if(D::[playerid][dFermClassDuty] == 1) {
						FermersOnline --;
						SendClientMessage(playerid, -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
						showPlayerDialog(playerid,9999,0," ","{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке","Закрыть","");
					}
					if(D::[playerid][dFermClassDuty] == 2) SendClientMessage(playerid,-1,""gbError"Вы закончили свой рабочий день помощником фермы!");
		            D::[playerid][dFermClassDuty] = 0;
		            GetBackSkin(playerid);
		            RemovePlayerAttachedObject(playerid,9);
		            DisablePlayerCheckpoint(playerid);
		            DisablePlayerRaceCheckpoint(playerid);
		            SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
		            MeAction(playerid,"увольняется с работы",1);
		            DeletePVar(playerid,"CheckpointFermaPole");
		            DeletePVar(playerid,"BackFermTransport");
				}
			}
		}
		if(PoleV >= 100 && PoleS < 100) {
            if(V::[GetVehicleTrailer(GetPlayerVehicleID(playerid))][vPosev] != 0) {
				V::[GetVehicleTrailer(GetPlayerVehicleID(playerid))][vPosev] --;
				format(string,sizeof(string),"Семена\n{ffffff}%d/%d ед.",V::[GetVehicleTrailer(GetPlayerVehicleID(playerid))][vPosev],MAX_POSEV_IN_VEHICLE);
    	    	UpdateDynamic3DTextLabelText(V::[GetVehicleTrailer(GetPlayerVehicleID(playerid))][vTextFerm],C_BLUE,string);
    	    	SetPVarInt(playerid, "SemValueT", GetPVarInt(playerid, "SemValueT") + 1);
				if(GetPVarInt(playerid, "SemValueT") >= 5)
				{
		            if(JobValueNow(playerid, 1, 24, -1) != 0) DeletePVar(playerid,"SemValueT");
					else
					{
		   				if(D::[playerid][dFermClassDuty] == 1) {
							FermersOnline --;
							SendClientMessage(playerid, -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
							showPlayerDialog(playerid,9999,0," ","{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке","Закрыть","");
						}
						if(D::[playerid][dFermClassDuty] == 2) SendClientMessage(playerid,-1,""gbError"Вы закончили свой рабочий день помощником фермы!");
			            D::[playerid][dFermClassDuty] = 0;
			            GetBackSkin(playerid);
			            RemovePlayerAttachedObject(playerid,9);
			            DisablePlayerCheckpoint(playerid);
			            DisablePlayerRaceCheckpoint(playerid);
			            SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
			            MeAction(playerid,"увольняется с работы",1);
			            DeletePVar(playerid,"CheckpointFermaPole");
			            DeletePVar(playerid,"BackFermTransport");
					}
				}
				PoleS += 2.0;
				if(V::[GetVehicleTrailer(GetPlayerVehicleID(playerid))][vPosev] == 0) {
			    	SendClientMessage(playerid,C_GRAY,""gbInfo"Езжайте в амбар и загрузите семена в оборудование.");
			    	DisablePlayerRaceCheckpoint(playerid);
					return SetPVarInt(playerid,"PosevLoad",_:SetPlayerCheckpoint(playerid,-79.2376,70.9134,3.1172,3.0));
				}
			}
			else if(V::[GetVehicleTrailer(GetPlayerVehicleID(playerid))][vPosev] == 0) {
			    SendClientMessage(playerid,C_GRAY,""gbInfo"Езжайте в амбар и загрузите семена в оборудование.");
			    DisablePlayerRaceCheckpoint(playerid);
				return SetPVarInt(playerid,"PosevLoad",_:SetPlayerCheckpoint(playerid,-79.2376,70.9134,3.1172,3.0));
			}
		}
        if(PoleV >= 100 && PoleS >= 100) {
			DisablePlayerRaceCheckpoint(playerid);
			SetPVarInt(playerid,"BackFermTransport",_:SetPlayerCheckpoint(playerid,-45.1872,80.6483,3.1172,3.0));
			return SendClientMessage(playerid,C_GRAY,""gbInfo"Верните транспорт и оборудование туда, откуда вы его брали.");
		}
	}
	return 1;
}

public OnVehicleSpawn(vehicleid) {
    if(vehiclecallsign[vehicleid] == 1)
	{
  		if(IsValidDynamic3DTextLabel(vehicle3Dtext[vehicleid]))
	    {
			DestroyDynamic3DTextLabel(vehicle3Dtext[vehicleid]);
		   	vehiclecallsign[vehicleid] = 0;
		}
	}
	if(V::[vehicleid][vRentCar][0] == 1 && D::[V::[vehicleid][vRentCar][1]][dRentVehicleID] == vehicleid)
	{
		V::[vehicleid][vRentCar][0] = 0;
		D::[V::[vehicleid][vRentCar][1]][dRentVehicleID] = -1;
		D::[V::[vehicleid][vRentCar][1]][dRentVehicleTime] = 0;
		V::[vehicleid][vRentCar][1] = 0;
		V::[vehicleid][vHealth] = 1000.0;
		V::[vehicleid][vFuel] = MaxVehicleFuel[GetVehicleModel(vehicleid) - 400];
	}
    for(new i; i != 18; i ++) V::[vehicleid][vInvSlot][i] = 0,V::[vehicleid][vInvSlotKol][i] = 0;
    V::[vehicleid][vHealth] = 1000.0;
	V::[vehicleid][vWoods] = 0;
	V::[vehicleid][vUrojai] = 0;
	V::[vehicleid][vMebel] = 0;
	V::[vehicleid][vToplivo] = 0;
	GetVehicleParamsEx(vehicleid,eng,light,other1,other2,other3,other4,other5);
	if(vehicleid >= ataxils[0] && vehicleid <= ataxils[1]) {
		SetPVarInt(V::[vehicleid][vTaxiDriver],"CountBackTaxi",0);
		DeletePVar(V::[vehicleid][vTaxiDriver],"CheckpointBack");
		SendClientMessage(V::[vehicleid][vTaxiDriver], -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
		showPlayerDialog(V::[vehicleid][vTaxiDriver],9999,0," ","{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке","Закрыть","");
		D::[V::[vehicleid][vTaxiDriver]][dTaxiKey] = -1;
    	D::[V::[vehicleid][vTaxiDriver]][dTaxiDuty] = false;
    	GiveTaxiMoney(V::[vehicleid][vTaxiDriver]);
		V::[vehicleid][vTaxiDriver] = -1;
		if(V::[vehicleid][vTaxiText] != -1) {
        	DestroyDynamicObject(V::[vehicleid][vTaxiText]);
        	V::[vehicleid][vTaxiText] = -1;
		}
		V::[vehicleid][vFuel] = MaxVehicleFuel[GetVehicleModel(vehicleid) - 400];
		SetVehicleParamsEx(vehicleid,false,0,other1,1,other3,other4,other5);
	}
	if(vehicleid >= fermcars[0] && vehicleid <= fermcars[1]) V::[vehicleid][vFermCarIdPlayer] = INVALID_PLAYER_ID;
	if(vehicleid >= buscars[0] && vehicleid <= buscars[1]) {
	    SendClientMessage(V::[vehicleid][vBusDriver], -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
		showPlayerDialog(V::[vehicleid][vBusDriver],9999,0," ","{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке","Закрыть","");
		D::[V::[vehicleid][vBusDriver]][dBusKey] = -1;
    	D::[V::[vehicleid][vBusDriver]][dBusDuty] = false;
    	SetPVarInt(V::[vehicleid][vBusDriver],"CountBackToBus",0);
    	SetPVarInt(V::[vehicleid][vBusDriver],"BusToGo",-1);
    	V::[vehicleid][vBusDriver] = -1;
    	SetVehicleParamsEx(vehicleid,false,0,other1,1,other3,other4,other5);
    	V::[vehicleid][vFuel] = MaxVehicleFuel[GetVehicleModel(vehicleid) - 400];
		if(V::[vehicleid][vBusText]) {
		if (IsValidDynamic3DTextLabel(V::[vehicleid][vBusText]))
			DestroyDynamic3DTextLabel(V::[vehicleid][vBusText]);
  		}
	}
	if(vehicleid >= dalncars[0] && vehicleid <= dalncars[1]) {
    	SetPVarInt(V::[vehicleid][vDalnDriver],"CountBackDaln",0);
    	if(PlayerTrailer[V::[vehicleid][vDalnDriver]] != -1) {
    		V::[PlayerTrailer[V::[vehicleid][vDalnDriver]]][vWoods] = 0;
			V::[PlayerTrailer[V::[vehicleid][vDalnDriver]]][vUrojai] = 0;
			V::[PlayerTrailer[V::[vehicleid][vDalnDriver]]][vMebel] = 0;
			V::[PlayerTrailer[V::[vehicleid][vDalnDriver]]][vToplivo] = 0;
    		DestroyVehicle(PlayerTrailer[V::[vehicleid][vDalnDriver]]);
    		
    		if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[V::[vehicleid][vDalnDriver]]][vTextTrailer]))
    			DestroyDynamic3DTextLabel(V::[PlayerTrailer[V::[vehicleid][vDalnDriver]]][vTextTrailer]);
    		
    		PlayerTrailer[V::[vehicleid][vDalnDriver]] = -1;
			DisablePlayerCheckpoint(V::[vehicleid][vDalnDriver]);
			SetPVarInt(V::[vehicleid][vDalnDriver],"dettachTrailer",0);
		}
		if(V::[vehicleid][vProducts] != 0) {
		    V::[vehicleid][vProducts] = 0;
		    Product::[V::[vehicleid][vProductsID]][pStatus] = false;
		    V::[vehicleid][vProductsID] = 0;
		    if (IsValidDynamic3DTextLabel(V::[vehicleid][vProductsText]))
		    	DestroyDynamic3DTextLabel(V::[vehicleid][vProductsText]);
		}
		DeletePVar(V::[vehicleid][vDalnDriver],"CheckpointBackDaln");
		SendClientMessage(V::[vehicleid][vDalnDriver], -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
		showPlayerDialog(V::[vehicleid][vDalnDriver],9999,0," ","{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке","Закрыть","");
		D::[V::[vehicleid][vDalnDriver]][dDalnKey] = -1;
    	D::[V::[vehicleid][vDalnDriver]][dDalnDuty] = false;
    	for(new s;s<10;s++)
		{
			if(gTruckLoadTurn[0][s] == V::[vehicleid][vDalnDriver]) gTruckLoadTurn[0][s] = INVALID_PLAYER_ID;
		}

    	V::[vehicleid][vDalnDriver] = -1;
    	V::[vehicleid][vFuel] = MaxVehicleFuel[GetVehicleModel(vehicleid) - 400];
    	SetVehicleParamsEx(vehicleid, false, 0, other1,1,other3,other4,other5);
    	SetVehicleVirtualWorld(vehicleid, 0);

	}
	if(vehicleid >= sheriffandpolice[0] && vehicleid <= sheriffandpolice[1]) {
	    V::[vehicleid][vHealth] = 1000.0;
		V::[vehicleid][vFuel] = MaxVehicleFuel[GetVehicleModel(vehicleid) - 400];
	}
	if(vehicleid >= lspdcars[0] && vehicleid <= lspdcars[1]) {
		V::[vehicleid][vHealth] = 1000.0;
		V::[vehicleid][vFuel] = MaxVehicleFuel[GetVehicleModel(vehicleid) - 400];
		if( vehicle_spawn[ vehicleid ][ vs_int ] ) {
			LinkVehicleToInterior( vehicleid, vehicle_spawn[ vehicleid ][ vs_int ] ),
			SetVehicleVirtualWorld( vehicleid, vehicle_spawn[ vehicleid ][ vs_world ] );
		}
		switch(GetVehicleModel(vehicleid)) {
			case 528:
			{
				V::[vehicleid][vInvSlot][0] = 433,V::[vehicleid][vInvSlot][1] = 433,V::[vehicleid][vInvSlot][2] = 434,V::[vehicleid][vInvSlot][3] = 434,V::[vehicleid][vInvSlot][4] = 431,V::[vehicleid][vInvSlot][5] = 431;
				V::[vehicleid][vInvSlotKol][0] = 1,V::[vehicleid][vInvSlotKol][1] = 1,V::[vehicleid][vInvSlotKol][2] = 2,V::[vehicleid][vInvSlotKol][3] = 2,V::[vehicleid][vInvSlotKol][4] = 100,V::[vehicleid][vInvSlotKol][5] = 100;
			}
			case 601:
			{
