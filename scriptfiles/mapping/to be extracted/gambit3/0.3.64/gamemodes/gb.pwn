public OnVehicleRespray(playerid, vehicleid, color1, color2) {
	if(V::[vehicleid][vBuyingCar] != -1) {
		new i = V::[vehicleid][vBuyingCar];
		new string[128];
    	Car::[i][cSettings][1] = color1;
    	Car::[i][cSettings][2] = color2;
    	format(string,sizeof(string),"%d|%d|%d|%d|%d|%d|%d",Car::[i][cSettings][0],Car::[i][cSettings][1],Car::[i][cSettings][2],
        Car::[i][cSettings][3],Car::[i][cSettings][4],Car::[i][cSettings][5],Car::[i][cSettings][6]);
        SetCarStr(Car::[i][cID],"cSettings",string);
	}
    return 1;
}

