public OnPlayerSpawn( playerid ) {
	if(IsPlayerNPC(playerid)) {
        if(!strcmp(Player[playerid][uName],"Dealers",true)) {
            new r = random(9);
        	new i = CreateVehicle(482,DealersSpawn[r][0],DealersSpawn[r][1],DealersSpawn[r][2],DealersSpawn[r][3],0,0,60);
        	SetVehicleParamsEx(i,eng,light,other1,1,other3,1,other5);
        	switch(random(6)) {
			    case 0: SetPlayerSkin(playerid,24);
			    case 1: SetPlayerSkin(playerid,28);
			    case 2: SetPlayerSkin(playerid,29);
			    case 3: SetPlayerSkin(playerid,44);
			    case 4: SetPlayerSkin(playerid,111);
			    case 5: SetPlayerSkin(playerid,121);
			}
			Dealer::[0][dP][0] = DealersSpawn[r][4];
			Dealer::[0][dP][1] = DealersSpawn[r][5];
			Dealer::[0][dP][2] = DealersSpawn[r][6];
			Dealer::[0][dSpawned] = true;
			V::[i][vNoBag] = true;
			Dealer::[0][dSkin] = GetPlayerSkin(playerid);
			for(new s; s != 16; s ++) {
			    switch(s) {
			        case 0 .. 9: {
			            new rand;
						switch(random(17)) {
						    case 0: rand = 322;
						    case 1: rand = 323;
						    case 2: rand = 324;
						    case 3: rand = 325;
						    case 4: rand = 326;
						    case 5: rand = 329;
						    case 6: rand = 330;
						    case 7: rand = 331;
						    case 8: rand = 332;
						    case 9: rand = 333;
						    case 10: rand = 334;
						    case 11: rand = 335;
						    case 12: rand = 336;
						    case 13: rand = 337;
						    case 14: rand = 338;
						    case 15: rand = 339;
						    case 16: rand = 340;
          					case 17: rand = 341;
						}
						Dealer::[0][dGun][s] = rand;
						Dealer::[0][dGunValue][s] = RandomEx(1,5);
						Dealer::[0][dGunPrice][s] = RandomEx(300,1200);
			        }
			        case 10 .. 16: {
			            Dealer::[0][dGun][s] = RandomEx(387,391);
						Dealer::[0][dGunValue][s] = RandomEx(1,5);
						Dealer::[0][dGunPrice][s] = RandomEx(50,200);
			        }
			    }
			}
        	setPlayerPos(playerid,DealersSpawn[r][4],DealersSpawn[r][5],DealersSpawn[r][6]);
            SetPlayerFacingAngle(playerid,DealersSpawn[r][7]);
            CreateDynamic3DTextLabel("Торговец оружием\nНажмите "cBLUE"Y\n{ffffff}[ Открыть свой инвентарь ]",0xFFFFFFFF,0.0,0.0,0.2,20.0,playerid,INVALID_VEHICLE_ID,1);
            togglePlayerControllable(playerid,false);
            Player[playerid][uMember] = 0;
		}
        return 1;
    }
	if( getData( playerid, "uLogin" )) return 1;
	PreloadAnim( playerid );
	
	setData( playerid, "AntiCheatGun", 2 );

// Job	
	if(GetPVarInt(playerid,"TimerStanok")) {
		KillTimer(GetPVarInt(playerid,"TimerStanok"));
		DeletePVar(playerid,"TimerStanok");
	}
    if(GetPVarInt(playerid,"WoodsPlayer")) {
		KillTimer(GetPVarInt(playerid,"WoodsPlayer"));
		DeletePVar(playerid,"WoodsPlayer");
	}

	if(GetPVarInt(playerid,"TimerCountFerm") != 0) SetPVarInt(playerid,"TimerCountFerm",0);
	if(GetPVarInt(playerid,"CountBackTaxi") != 0) SetPVarInt(playerid,"CountBackTaxi",0);
	if(GetPVarInt(playerid,"CountBackToBus") != 0) SetPVarInt(playerid,"CountBackToBus",0);
	if(GetPVarInt(playerid,"TimerCountWoods") != 0) SetPVarInt(playerid,"TimerCountWoods",0);
	if(GetPVarInt(playerid,"CountBackDaln") != 0) SetPVarInt(playerid,"CountBackDaln",0);
	if(GetPVarInt(playerid,"follow") != INVALID_PLAYER_ID) SetPVarInt(GetPVarInt(playerid,"follow"),"follow",INVALID_PLAYER_ID);
//
	if(Inv[playerid][invSlot][48] != 0) {
		switch(_itemsInfo[Inv[playerid][invSlot][48]][invObject]) {
			case 18926 .. 18935: SetPlayerAttachedObject(playerid, 0, _itemsInfo[Inv[playerid][invSlot][48]][invObject], 2, SkinCaps[GetPlayerSkin(playerid)][0], SkinCaps[GetPlayerSkin(playerid)][1], SkinCaps[GetPlayerSkin(playerid)][2], SkinCaps[GetPlayerSkin(playerid)][3],SkinCaps[GetPlayerSkin(playerid)][4], SkinCaps[GetPlayerSkin(playerid)][5]);
        	case 18944 .. 18951: SetPlayerAttachedObject(playerid, 0, _itemsInfo[Inv[playerid][invSlot][48]][invObject], 2, SkinHead[GetPlayerSkin(playerid)][0], SkinHead[GetPlayerSkin(playerid)][1], SkinHead[GetPlayerSkin(playerid)][2], SkinHead[GetPlayerSkin(playerid)][3],SkinHead[GetPlayerSkin(playerid)][4], SkinHead[GetPlayerSkin(playerid)][5]);
			case 19528: SetPlayerAttachedObject(playerid, 0, _itemsInfo[Inv[playerid][invSlot][48]][invObject], 2, SkinHead[GetPlayerSkin(playerid)][0], SkinHead[GetPlayerSkin(playerid)][1], SkinHead[GetPlayerSkin(playerid)][2], SkinHead[GetPlayerSkin(playerid)][3],SkinHead[GetPlayerSkin(playerid)][4], SkinHead[GetPlayerSkin(playerid)][5]);

		}
	}
	if(Inv[playerid][invSlot][49] != 0) SetPlayerAttachedObject(playerid,1,_itemsInfo[Inv[playerid][invSlot][49]][invObject],2,_skinGlasses[GetPlayerSkin(playerid)][0], _skinGlasses[GetPlayerSkin(playerid)][1], _skinGlasses[GetPlayerSkin(playerid)][2], _skinGlasses[GetPlayerSkin(playerid)][3], _skinGlasses[GetPlayerSkin(playerid)][4], _skinGlasses[GetPlayerSkin(playerid)][5]);
	if(Inv[playerid][invSlot][50] != 0) givePlayerWeapon(playerid,GetWeaponToObject(_itemsInfo[Inv[playerid][invSlot][50]][invObject]),Inv[playerid][invSlotKol][50]);
	if(Inv[playerid][invSlot][51] != 0) givePlayerWeapon(playerid,GetWeaponToObject(_itemsInfo[Inv[playerid][invSlot][51]][invObject]),Inv[playerid][invSlotKol][51]);
	if(Inv[playerid][invSlot][53] != 0) {
		switch(_itemsInfo[Inv[playerid][invSlot][53]][invObject]) {
	    	case 18911 .. 18920: SetPlayerAttachedObject(playerid, 2, _itemsInfo[Inv[playerid][invSlot][53]][invObject], 2, BandSkin[GetPlayerSkin(playerid)][0], BandSkin[GetPlayerSkin(playerid)][1], BandSkin[GetPlayerSkin(playerid)][2], BandSkin[GetPlayerSkin(playerid)][3],BandSkin[GetPlayerSkin(playerid)][4], BandSkin[GetPlayerSkin(playerid)][5], 1.000000, 1.000000, 1.000000);
			case 19421 .. 19424: SetPlayerAttachedObject(playerid, 2, _itemsInfo[Inv[playerid][invSlot][53]][invObject], 1, Beats[GetPlayerSkin(playerid)][0], Beats[GetPlayerSkin(playerid)][1], Beats[GetPlayerSkin(playerid)][2], Beats[GetPlayerSkin(playerid)][3],Beats[GetPlayerSkin(playerid)][4], Beats[GetPlayerSkin(playerid)][5], 1.000000, 1.000000, 1.000000);
			case 18637: SetPlayerAttachedObject(playerid, 2, _itemsInfo[Inv[playerid][invSlot][53]][invObject], 14, 0.0, 0.0, 0.0, 0.0, 180.0, 180.0);
		}
	}
	if(Inv[playerid][invSlot][54] != 0) setPlayerArmour(playerid,Inv[playerid][invSlotKol][54]);
	TogglePlayerControllable( playerid, true );
	//setPlayerHealth( playerid, 100 );
	return true;
}	


forward MDCCHECKACC(playerid);
public MDCCHECKACC(playerid)
{
    new Rows, Fields;
    cache_get_data(Rows, Fields);
    if(!Rows) return SendClientMessage(playerid, C_GRAY, "Не найдено!");
    new licenses[4], data[40], sex, color, nation, age, string[512], name[25];
    new sextext[15], colortext[20], nationtext[20];
    cache_get_field_content(0, "uLicenses", data, mysql), sscanf(data,"p<|>a<d>[4]",licenses);
    if(licenses[3] != 1) return SendClientMessage(playerid, C_GRAY, "Не найдено!");
    cache_get_field_content(0, "uName", name, mysql);
    sex = cache_get_field_content_int(0, "uSex", mysql);
    switch(sex)
    {
        case 1: sextext = "Мужской";
        case 2: sextext = "Женский";
    }
    color = cache_get_field_content_int(0, "uColor", mysql);
    switch(color)
    {
        case 1: colortext = "Темный";
        case 2: colortext = "Светлый";
    }
    nation = cache_get_field_content_int(0, "uNation", mysql);
    switch(nation)
    {
        case 1: nationtext = "Американец";
		case 2: nationtext = "Латиноамериканец";
		case 3: nationtext = "Русский";
		case 4: nationtext = "Француз";
		case 5: nationtext = "Итальянец";
		case 6: nationtext = "Испанец";
		case 7: nationtext = "Немец";
		case 8: nationtext = "Португалец";
		case 9: nationtext = "Австралиец";
		case 10: nationtext = "Колумбиец";
		case 11: nationtext = "Мексиканец";
		case 12: nationtext = "Китаец";
		case 13: nationtext = "Японец";
		case 14: nationtext = "Бразилец";
		case 15: nationtext = "Кореец";
		case 16: nationtext = "Въетнамец";
		case 17: nationtext = "Чех";
		case 18: nationtext = "Британец";
		case 19: nationtext = "Голландец";
		case 20: nationtext = "Поляк";
    }
    age = cache_get_field_content_int(0, "uAge", mysql);
	format(string, sizeof(string), "{AFAFAF}Имя:         %s\nПол:         %s\nЦвет:      %s\nНация:      %s\nВозраст:   %d", name, sextext, colortext, nationtext, age);
	showPlayerDialog(playerid,9999,0,"Информация",string,"Выход","");
	return true;
}

forward OnPlayerCheckDonate(playerid);
public OnPlayerCheckDonate(playerid)
{
    new Rows, Fields;
    cache_get_data(Rows, Fields);
    if(!Rows)
	{
	    showPlayerDialog(playerid,d_donate+12,0," ","{ffffff}Выберите пол персонажа:","Мужской","Женский");
    }
    else
    {
        DeletePVar(playerid, "NewPlayerNick");
        showPlayerDialog(playerid,d_donate+11,1," ","Введите в поле ниже, Ваше новое игровое имя\n\n"gbError"Внимание! Не забудте, после смены имени поменять его в клиенте","Далее","Закрыть");
        SendClientMessage(playerid,C_GRAY,""gbError"Данное имя уже где-то используется!");
    }
	return true;
}

forward OnPlayerGetStat(playerid);
public OnPlayerGetStat(playerid)
{
    new Rows, Fields;
    cache_get_data(Rows, Fields);
    
    new regdate, ids;
    if(Rows)
	{
	    cache_get_field_content_int(0, "uID", ids);
	    cache_get_field_content_int(0, "uRegDate", regdate);
	    
	}
	return true;
}

forward OnPlayerCheckBan(playerid);
public OnPlayerCheckBan(playerid)
{
    new Rows, Fields;
    cache_get_data(Rows, Fields);
	if(Rows)
	{
	    SendClientMessage(playerid, C_LIGHTRED, "Простите, но Ваш IP адрес заблокирован!");
	    KickEx(playerid);
	}
	return 1;
}

publics: OnPlayerCheckBanTwo(playerid) {
	clear_massive();
    new Rows, Fields;
    cache_get_data(Rows, Fields);
    new unbandate;
	if(Rows) {
		unbandate = cache_get_field_content_int(0, "unbandate");
		if(unbandate > gettime()) {
		    format( gb_string,sizeof gb_string,""gbError"Простите, но вы забанены на данном сервере. Дата разблокировки - "cBLUE"%s", date("%dd.%mm.%yy", unbandate) );
			SendClientMessage( playerid, C_GRAY, gb_string);
 			KickEx( playerid );
		}
	}
	else {
		format(query, sizeof(query),"SELECT * FROM `gb_users` WHERE BINARY `uName` = '%s'",Player[playerid][uName]);
		mysql_tquery( mysql, query, "ONPLAYERCHECKACC", "d", playerid);
	}
	return 1;
}

public OnPlayerEnterDynamicArea(playerid, areaid) {
	clear_massive();
	for(new i = TOTALFIRE[0]; i <= TOTALFIRE[1]; i++) {
		if(!FireSystem[i][fStatus]) continue;
		if(!IsValidDynamicArea(FireSystem[i][fZone])) continue;
	 	if(areaid == FireSystem[i][fZone]) {
	 	    new s = GetPlayerSkin(playerid);
		 	if(s == 277 || s == 278 || s == 279)
		 	{
				if(GetPVarInt(playerid, "FireBar") >= 1)
				{
				    SetPlayerProgressBarValue(playerid, universalbar[playerid], FireSystem[i][fHealth]);
				    UpdatePlayerProgressBar(playerid, universalbar[playerid]);
				}
				else {
				    SetPVarInt(playerid, "FireBar", 1);
					universalbar[playerid] = CreatePlayerProgressBar(playerid, 600.333, 202.014, 13.666, 192.059, 0xFFFFFFFF, 5);
					UpdatePlayerProgressBar(playerid, universalbar[playerid]);
					ShowPlayerProgressBar(playerid, universalbar[playerid]);
					SetPlayerProgressBarMaxValue(playerid, universalbar[playerid], 600);
					SetPlayerProgressBarValue(playerid, universalbar[playerid], FireSystem[i][fHealth]);
				 	UpdatePlayerProgressBar(playerid, universalbar[playerid]);
				}
			}
		 	break;
		}
	}
	if(PaynSpray[0] <= areaid <= PaynSpray[MAX_PAYNSPRAY-1]) {
		SetPVarInt(playerid,"playerUsePaynSpray",1);
	}
	if(PotatoZone[0] <= areaid <= PotatoZone[MAX_OBJECTS_POTATO-1]) {
	    new j = areaid-PotatoZone[0];
	    if(D::[playerid][dFermClassDuty] == 1 && GetVehicleModel(GetPlayerVehicleID(playerid)) == 532) {
			if(PoleR >= 900) {
			    if(IsValidDynamicObject(PotatoObject[j])) {
					DestroyDynamicObject(PotatoObject[j]);
					PotatoObject[j] = -1;
					new Float:p[4];
					new Float:dist = 2.5;
					GetVehiclePos(GetPlayerVehicleID(playerid),p[0],p[1],p[2]);
					GetVehicleZAngle(GetPlayerVehicleID(playerid),p[3]);
					p[3] = p[3] + 180.0;
					_dropFerm ++;
					OF::[_dropFerm][ofP][0] = p[0];
					OF::[_dropFerm][ofP][1] = p[1];
					OF::[_dropFerm][ofP][2] = p[2];
					OF::[_dropFerm][ofObject] = CreateDynamicObject(2060,p[0]+dist*-floatsin(p[3],degrees),p[1]+dist*floatcos(p[3],degrees),p[2] - 2,0.0,0.0,0.0,-1,-1,-1,100.0);
					OF::[_dropFerm][ofText] = CreateDynamic3DTextLabel(""cBLUE"ALT",0xFFFFFFFF,p[0]+dist*-floatsin(p[3],degrees),p[1]+dist*floatcos(p[3],degrees),p[2]-2,3.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,0);
     				KustInPole --;
					SetPVarInt(playerid, "SemValue", GetPVarInt(playerid, "SemValue") + 1);
					if(GetPVarInt(playerid, "SemValue") >= 2)
					{
			            if(JobValueNow(playerid, 1, 15, -1) != 0) DeletePVar(playerid,"SemValue");
						else
						{
			   				if(D::[playerid][dFermClassDuty] == 1) {
								FermersOnline --;
								SendClientMessage(playerid, -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
								showPlayerDialog(playerid,9999,0," ","{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке","Закрыть","");
							}
							if(D::[playerid][dFermClassDuty] == 2) SendClientMessage(playerid,-1,""gbError"Вы закончили свой рабочий день помощником фермы!");
				            D::[playerid][dFermClassDuty] = 0;
				            GetBackSkin(playerid);
				            RemovePlayerAttachedObject(playerid,9);
				            DisablePlayerCheckpoint(playerid);
				            DisablePlayerRaceCheckpoint(playerid);
				            SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
				            MeAction(playerid,"увольняется с работы",1);
				            DeletePVar(playerid,"CheckpointFermaPole");
				            DeletePVar(playerid,"BackFermTransport");
						}
					}
					if(KustInPole == 0) {
						PoleR = 0;
						foreach (new i : Player) {
							if(D::[i][dFermClassDuty] == 1 && GetVehicleModel(GetPlayerVehicleID(i)) == 532) {
								SetPVarInt(i,"BackFermTransportKomb",_:SetPlayerCheckpoint(i,-108.6581,25.4261,3.1172,5.0));
        	                    SendClientMessage(i,C_GRAY,""gbInfo"Верните используемый комбайн на место.");
							}
						}
					}
				}
			}
		}
	}
	if(WD::[0][woodZone] <= areaid <= WD::[MAX_WOODS - 1][woodZone]) {
	    new j = areaid - WD::[0][woodZone];
	    if(D::[playerid][dWoodsDuty] == 1) {
	    	new s = GetPlayerSkin(playerid);
			if(s == 16 || s == 27 || s == 260 || s == 13 || s == 56 || s == 131) {
			    if(GetPVarInt(playerid,"PlayerUseBox") == 4) {
			        if(WD::[j][woodUse] == false) {
			            if(WD::[j][woodIsDrop] == false) {
			                if(WD::[j][woodCount] != 0) {
			                	WD::[j][woodUse] = true;
			                	SetPVarInt(playerid,"WoodDrop",j);
								SetTimerEx("WoodsPlayer",10000,false,"ddd",playerid,j,0);
								ClearAnimations(playerid);
								togglePlayerControllable(playerid,false);
								ApplyAnimation(playerid,"CHAINSAW","WEAPON_csaw",1.0,1,0,0,0,10000,0);
								MeAction(playerid,"пилит дерево",1);
							}
						}
		            	else {
		            	    if(WD::[j][woodCount] > 0) {
		            	        WD::[j][woodCount] -= 25;
								SetPVarInt(playerid,"WoodDrop",j);
								SetTimerEx("WoodsPlayer",10000,false,"ddd",playerid,j,1);
								togglePlayerControllable(playerid,false);
								ApplyAnimation(playerid,"CHAINSAW","CSAW_G",1.0,1,0,0,0,10000,0);
								MeAction(playerid,"пилит дерево",1);
		            	    }
		            	}
   					}
   					else SendClientMessage(playerid,C_GRAY,""gbError"Простите, но это дерево уже кто-то пилит.");
				}
			}
			else SendClientMessage(playerid,C_GRAY,""gbError"Вы должны быть в рабочей одежде, для того чтобы пилить дерево.");
	    }
	}
	if(areaid == strZones[0]) {
		if(D::[playerid][dFermClassDuty] != 0) SetPVarInt(playerid,"TimerCountFerm",0);
	}
	if(areaid == strZones[10]) {
		if(D::[playerid][dWoodsDuty] != 0) SetPVarInt(playerid,"TimerCountWoods",0);
	}
	if(areaid == strZones[1]) {
	    if(D::[playerid][dFermClassDuty] == 1 && GetVehicleModel(GetPlayerVehicleID(playerid)) == 531) {
	        if(KustInPole > 0) return SendClientMessage(playerid,C_GRAY,""gbError"На поле ещё есть несобранный урожай, соберите его.");
	        if(_dropFerm > 5) return SendClientMessage(playerid,C_GRAY,""gbError"На поле ещё есть несобранный урожай, соберите его.");
			if(PoleV >= 100 && PoleS >= 100) {
			    SetPVarInt(playerid,"BackFermTransport",_:SetPlayerCheckpoint(playerid,-45.1872,80.6483,3.1172,3.0));
				return SendClientMessage(playerid,C_GRAY,""gbInfo"Поле уже вспахано и засеяно, верните оборудование на место.");
		 	}
	        if(GetVehicleModel(GetVehicleTrailer(GetPlayerVehicleID(playerid))) != 610) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет необходимого инструмента для работы на поле.");
			SetPVarInt(playerid,"PlayerInFermZone",1);
			new Float:x,Float:y;
			x = -157 - random(77);
			y = 70 - random(153);
	    	SetPVarInt(playerid,"CheckpointFermaPole",_:SetPlayerRaceCheckpoint(playerid,2,x,y,3.12,0.0,0.0,0.0,5.0));
		}
	}
	if(areaid == strZones[2]) {
	    if(D::[playerid][dFermClassDuty] != 0 && !IsPlayerInAnyVehicle(playerid)) {
	        if(GetPVarInt(playerid,"PlayerUseBox") == 0) {
	        	new s = GetPlayerSkin(playerid);
				if(s == 34 || s == 158 || s == 161 || s == 1 || s == 73 || s == 132 || s == 151 || s == 157 || s == 198) {
	            	if(S::[0][sFerm][4] < 50) return SendClientMessage(playerid,C_GRAY,""gbError"В амбаре недостаточно семян для переноса.");
                    if(S::[0][sFerm][5] >= MAX_SEM_AMBAR_TWO) return SendClientMessage(playerid,C_GRAY,""gbError"В амбаре к которому вам нужно идти нет места для семян.");
					SetPVarInt(playerid,"SemToGo",_:SetPlayerCheckpoint(playerid,-79.2376,70.9134,3.1172,1.0));
	            	SetPVarInt(playerid,"PlayerUseBox",2);
					S::[0][sFerm][4] -= 50;
	            	format( gb_string,sizeof(gb_string),"Семян в амбаре\n{ffffff}%d/%d ед.",S::[0][sFerm][4],MAX_SEM_AMBAR_ONE);
	            	UpdateDynamic3DTextLabelText(InfoFermText[0],C_BLUE,gb_string);
	            	SetPlayerAttachedObject(playerid,9,1575,5,0.127999,0.008000,0.149999,105.899963,-175.499984,-72.199935);
	            	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
	            	MeAction(playerid,"взял(-а) упаковку с семянами",1);
	            }
	            else SendClientMessage(playerid,C_GRAY,""gbError"На вас нет рабочей одежды для работы на ферме.");
	        }
	        else SendClientMessage(playerid,C_GRAY,""gbError"Вы уже несёте что-то в своих руках.");
	    }
	}
	if(areaid == strZones[3]) {
	    if(D::[playerid][dFermClassDuty] != 0 && !IsPlayerInAnyVehicle(playerid)) {
	        if(GetPVarInt(playerid,"PlayerUseBox") == 0) {
	        	new s = GetPlayerSkin(playerid);
				if(s == 34 || s == 158 || s == 161 || s == 1 || s == 73 || s == 132 || s == 151 || s == 157 || s == 198) {
	            	if(S::[0][sFerm][6] < 10) return SendClientMessage(playerid,C_GRAY,""gbError"В бочке недостаточно топлива для заполнения канистры.");
	            	SetPVarInt(playerid,"PlayerUseBox",3);
	            	S::[0][sFerm][6] -= 10;
	            	SendClientMessage(playerid,C_GRAY,""gbInfo"Подойдите к любому фермерскому ТС и нажмите "cBLUE"ALT {ffffff}для заправки.");
	            	format( gb_string,sizeof( gb_string ),"Топлива в бочке\n{ffffff}%d/%d л.",S::[0][sFerm][6],MAX_FUEL_IN_FERMA);
	            	UpdateDynamic3DTextLabelText(InfoFermText[1],C_BLUE, gb_string);
	            	SetPlayerAttachedObject(playerid,9,1650,6,0.120999,0.017000,0.050000,3.200000,-102.399993,-7.799998);
	            	MeAction(playerid,"залил(-а) топливо в канистру",1);
				}
				else SendClientMessage(playerid,C_GRAY,""gbError"На вас нет рабочей одежды для работы на ферме.");
	        }
	        else SendClientMessage(playerid,C_GRAY,""gbError"Вы уже несёте что-то в своих руках.");
		}
	}
	if(areaid == strZones[6]) {
	    if(D::[playerid][dWoodsDuty] == 2) {
	        new s = GetPlayerSkin(playerid);
			if(s == 16 || s == 27 || s == 260 || s == 13 || s == 56 || s == 131) {
	        	if(GetPVarInt(playerid,"PlayerUseBox") == 0 && !GetPVarInt(playerid,"TimerStanok") && GetPVarInt(playerid,"PlayerStanok") != 1) {
	            	if(S::[0][wsWoods] <= 0) return SendClientMessage(playerid,C_GRAY,""gbError"На конвеере недостаточно древесины для переработки.");
	            	RemovePlayerAttachedObject(playerid,9);
					SetPlayerAttachedObject(playerid,9,1463,5,0.073999,0.186000,0.105998,95.299972,-175.499984,-72.199935,0.540999,0.350999,0.610999);
	        		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
					SetPVarInt(playerid,"PlayerUseBox",5);
					S::[0][wsWoods] -= 25;
					format( gb_string,sizeof( gb_string ),"Древесина\n{ffffff}%d кг.",S::[0][wsWoods]);
    				UpdateDynamic3DTextLabelText(S::[0][wsWoodsT],C_BLUE, gb_string);
					SendClientMessage(playerid,C_GRAY,""gbError"Теперь отнесите древесину на станок для переработки.");
					MeAction(playerid,"взял(-а) древесину",1);
	        	}
			}
	    }
	    else SendClientMessage(playerid,C_GRAY,""gbError"На вас должна быть рабочая одежда для работы в цеху.");
	}
	if(areaid == strZones[7]) {
	    if(GetPVarInt(playerid,"PlayerUseBox") == 5 && D::[playerid][dWoodsDuty] == 2) {
			SetPVarInt(playerid,"PlayerUseBox",0);
			RemovePlayerAttachedObject(playerid,9);
			new obj = CreateDynamicObject(1463,-468.38101, -73.43010, 774.27722,0.00,0.00,-90.00);
			MoveDynamicObject(obj,-468.38101, -86.69010, 774.27722,1,0.00,0.00,-90.00);
	        SetGVarInt("WoodStanok",1,obj);
	        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	        SetPVarInt(playerid,"TimerStanok",_:SetTimerEx("WoodStanok",15000,false,"d",playerid));
	        SendClientMessage(playerid,C_GRAY,""gbInfo"Дождитесь пока ваша древесина пройдёт обработку.");
	    }
	}
	if(areaid == strZones[8]) {
	    if(GetPVarInt(playerid,"PlayerStanok") == 1) {
	        SetPVarInt(playerid,"PlayerUseBox",7);
	        SetPlayerAttachedObject(playerid,8,2468,5,0.102999,-0.018998,0.105998,95.299972,-175.499984,-164.200012,0.540997,0.761999,0.610997);
			SetPlayerAttachedObject(playerid,9,2468,5,-0.104000,-0.031999,0.105998,95.299972,-175.499984,15.699944,0.540998,0.761999,0.610998);
	        DeletePVar(playerid,"PlayerStanok");
	        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
	        SendClientMessage(playerid,C_GRAY,""gbInfo"Отнесите готовую заготовку на конвеер склада.");
	        MeAction(playerid,"взял(-а) заготовку",1);
	    }
	}
	if(areaid == strZones[9]) {
	    if(GetPVarInt(playerid,"PlayerUseBox") == 7) {
	        RemovePlayerAttachedObject(playerid,9);
	        RemovePlayerAttachedObject(playerid,8);
	        SetPVarInt(playerid,"PlayerUseBox",0);
	        
	        new obj = CreateDynamicObject(2468,-470.67337, -97.64543, 773.79999, 0.00, 0.00, 90.00);
	        new obj2 = CreateDynamicObject(2468,-470.74451, -98.02264, 773.79999,0.00,0.00,-90.00);
			MoveDynamicObject(obj,-470.67340, -104.42540, 773.79999,1,0.00,0.00,90.00);
			MoveDynamicObject(obj2,-470.74451, -104.80260, 773.79999,1,0.00,0.00,-90.00);
			
	        SetGVarInt("WoodGoSklad",1,obj);
	        SetGVarInt("WoodGoSklad2",1,obj2);
	        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	        if(JobValueNow(playerid, 2, 34, -1) != 0) { }
			else
			{
			    SendClientMessage(playerid, -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
		     	showPlayerDialog(playerid, 9999, 0, " ", "{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке", "Закрыть", "");
				D::[playerid][dWoodsDuty] = 0;
				DeletePVar(playerid,"PlayerUseBox");
				DeletePVar(playerid,"PlayerStanok");
    			GetBackSkin(playerid);
				RemovePlayerAttachedObject(playerid,9);
			}
	    }
	}
	if( areaid == strZones[11] ) {
		if( IsPlayerInAnyVehicle( playerid ) ) {
	        if( V::[GetPlayerVehicleID(playerid)][vBuyingCar] != -1 ) {
	            new i = V::[GetPlayerVehicleID(playerid)][vBuyingCar];
		       	if(strcmp(Car::[i][cOwner], Player[playerid][uName], true) == 0) {
					new model = GetVehicleModel( GetPlayerVehicleID( playerid ) ), 
						price;
					price = getCarPrice( model );
					switch( Player[playerid][uPremium] ) {
						case 1: price = floatround( price * 0.7 );
						case 2: price = floatround( price * 0.8 );
						case 3: price = floatround( price * 0.9 );
						default: price = floatround( price/2 );
					}
					setData( playerid, "Player:UtilCarSlot", i ), setData( playerid, "Player:UtilCarPrice", price );
					format( vb_string, sizeof vb_string, 
						"{ffffff}| Информация об автомобиле:"cGRAY"\n\
						\nНазвание - %s ($%d)\nСтоимость утилизации - "cGREEN"$%d\n\
						\n{ffffff}Вы действительно хотите утилизировать своё авто?",
						CarNames[ model - 400 ], getCarPrice( model ), price );
					showPlayerDialog( playerid, d_cars + 7, 0, "Утилизация авто", vb_string, "Да", "Нет" );	
      			}
	        }
	    }
	}
	foreach(new i: Player)
	{
	    if(!GetPVarInt(playerid,"uLogin")) continue;
		if(areaid == GetPVarInt(i, "BBArea"))
  		{
    		GetPVarString(i, "BBStation", gb_string, sizeof( gb_string ));
   			PlayAudioStreamForPlayer(playerid, gb_string, GetPVarFloat(i, "BBX"), GetPVarFloat(i, "BBY"), GetPVarFloat(i, "BBZ"), 10.0, 1);
    		break;
    	}
	}
	return 1;
}

public OnPlayerLeaveDynamicArea(playerid, areaid) {
    foreach(new i: Player) {
        if(!GetPVarInt(playerid,"uLogin")) continue;
		if(areaid == GetPVarInt(i, "BBArea"))
		{
			StopAudioStreamForPlayer(playerid);
			break;
		}
	}
	for(new i = TOTALFIRE[0]; i <= TOTALFIRE[1]; i++)
 	{
 	    if(!FireSystem[i][fStatus]) continue;
	 	if(areaid == FireSystem[i][fZone]) {
            if(GetPVarInt(playerid,"FireTimerr")) {
				KillTimer(GetPVarInt(playerid,"FireTimerr"));
				DeletePVar(playerid,"FireTimerr");
			}
			if(GetPlayerSkin(playerid) == 277 || GetPlayerSkin(playerid) == 278 || GetPlayerSkin(playerid) == 279)
		 	{
		 	    SetPVarInt(playerid, "FireBar", 0);
				HidePlayerProgressBar(playerid, universalbar[playerid]);
				DestroyPlayerProgressBar(playerid, universalbar[playerid]);
			}
			break;
	 	}
	}
    
    if(PaynSpray[0] <= areaid <= PaynSpray[MAX_PAYNSPRAY-1]) SetPVarInt(playerid,"playerUsePaynSpray",0);
	if(areaid == strZones[0]) {
		if(D::[playerid][dFermClassDuty] != 0) {
			SendClientMessage(playerid,C_GRAY,""gbInfo"Вернитесь на территорию фермы, иначе Ваш рабочий день будет закончен.");
			SetPVarInt(playerid,"TimerCountFerm",MAX_COUNT_FERM_ZONE);
		}
    }
    if(areaid == strZones[10]) {
		if(D::[playerid][dWoodsDuty] != 0) {
			SendClientMessage(playerid,C_GRAY,""gbInfo"Вернитесь на территорию лесопилки, иначе Ваш рабочий день будет закончен.");
			SetPVarInt(playerid,"TimerCountWoods",MAX_COUNT_WOOD_ZONE);
		}
    }
    if(areaid == strZones[4]) {
        if(PlayerTrailer[playerid] != -1) {
            if(GetVehicleTrailer(GetPlayerVehicleID(playerid)) != PlayerTrailer[playerid]) {
            	V::[PlayerTrailer[playerid]][vWoods] = 0;
				V::[PlayerTrailer[playerid]][vUrojai] = 0;
				V::[PlayerTrailer[playerid]][vMebel] = 0;
				V::[PlayerTrailer[playerid]][vToplivo] = 0;
            	DestroyVehicle(PlayerTrailer[playerid]);
            	
            	if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]))
	    			DestroyDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]);
	    			
	    		SetPVarInt(playerid,"dettachTrailer",0);
        		PlayerTrailer[playerid] = -1;
				DisablePlayerCheckpoint(playerid);
        		return SendClientMessage(playerid,C_GRAY,""gbError"Вы оставили свой прицеп на месте аренды. (( Прицеп был удалён. ))");
        	}
        }
    }
    if(areaid == strZones[5]) {
        if(PlayerTrailer[playerid] != -1 && V::[GetPlayerVehicleID(playerid)][vDalnDriver] == playerid) {
            if(GetPVarInt(playerid,"PlayerSelectTrailerTwo") == 2) {
                if(GetPVarInt(playerid,"SelectedToplivoMarsh") == 0) {
              		V::[PlayerTrailer[playerid]][vWoods] = 0;
					V::[PlayerTrailer[playerid]][vUrojai] = 0;
					V::[PlayerTrailer[playerid]][vMebel] = 0;
					V::[PlayerTrailer[playerid]][vToplivo] = 0;
                    DestroyVehicle(PlayerTrailer[playerid]);
                    
                    if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]))
	    				DestroyDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]);
	    			
	    			SetPVarInt(playerid,"dettachTrailer",0);
        			PlayerTrailer[playerid] = -1;
					DisablePlayerCheckpoint(playerid);
        			return SendClientMessage(playerid,C_GRAY,""gbError"Вы не выбрали ни одного маршрута для доставки топлива.");
                }
            }
        }
    }
    if(areaid == strZones[1]) {
		SetPVarInt(playerid,"PlayerInFermZone",0);
		if(GetPVarInt(playerid,"CheckpointFermaPole")) DisablePlayerRaceCheckpoint(playerid);
	}
	return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[]) {
	strreplace(inputtext, '%', '#');
	strreplace(inputtext, '\n', '#');
	clear_massive();
    new string[1024], str[512];
	
    antiDialogHider( playerid, dialogid );
	if( dialog_cheat_use[playerid] == true ) return true;
	switch(dialogid) {
		case d_create: {
			if( !response ) return true;
			switch( listitem ) {
				case 0: {// Падик
					showPlayerDialog( playerid, d_create + 1, DIALOG_STYLE_INPUT, "Создание подъезда",
						"{ffffff}Укажите тип подъезда цифрой от 1 до 2", "Ввод", "Назад" );
					setData( playerid, "Player:ADMCreate", 1 );	
				}
				case 1: {
					showPlayerDialog( playerid, d_create + 1, DIALOG_STYLE_INPUT, "Создание дома",
						"{ffffff}Укажите интерьер дома и цену на дом\nПример: 1 10000", "Ввод", "Назад" );
					setData( playerid, "Player:ADMCreate", 2 );	
				}
			}
		}
		case d_create + 1: {
			if( !response ) return CallLocalFunction( "cmd_create", "d", playerid );
			switch( getData( playerid, "Player:ADMCrate" ) ) {
				case 1: CallLocalFunction( "cmd_addhostel", "ds", playerid, inputtext );
				case 2: CallLocalFunction( "cmd_addhouse", "ds", playerid, inputtext );
			}
			delData( playerid, "Player:ADMCrate" );
		}
	    case d_cigg: {
	        if(!response) {
	            showPlayerDialog( playerid, d_cigg, DIALOG_STYLE_LIST, "Использование сигареты", "1. "cGRAY"Взять сигарету в правую руку{ffffff}\n2. "cGRAY"Взять сигарету в левую руку{ffffff}\n3. "cGRAY"Прикрепить сигарету ко рту", "Выбор", "" );
				return true;
			}
	        switch(listitem) {
	            case 0: SetPlayerAttachedObject( playerid, 7,  19625, 6, 0.098999, -0.003000, 0.020000,  -2.999998, -24.799991, 45.300014, 1.000000, 1.000000, 1.000000 );
	            case 1: SetPlayerAttachedObject( playerid, 7, 19625, 5, 0.116999, -0.019000, 0.000000,  0.000000, 0.000000, 34.400043, 1.000000, 1.000000, 1.000000 );
	            case 2: SetPlayerAttachedObject( playerid, 7, 19625, 2, -0.013000, 0.110999, -0.008000,  -5.000001, 0.000000, -178.599838, 1.000000, 1.000000, 1.000000 );
	        }
	        format( string, sizeof string, "закуривает сигарету %s", Inv[playerid][invSlotKol][GetPVarInt( playerid, "use_cigg" )] == 154 ? ("Wind"):("C&K") );
			printf("%s", string );
			MeAction(playerid, string, 1);
			SetPVarInt( playerid, "smoke", 1 );
			Inv[playerid][invSlotKol][GetPVarInt( playerid, "use_cigg" )]--;
			if(Inv[playerid][invSlotKol][GetPVarInt( playerid, "use_cigg" )] < 1 ) {
	        	Inv[playerid][invSlot][GetPVarInt( playerid, "use_cigg" )] = 0;
	        	Inv[playerid][invSlotKol][GetPVarInt( playerid, "use_cigg" )] = 0;
			}
	    }
	    case 3015:
	    {
	        if(!response) return true;
	        if(Player[playerid][uMoney] < 50) return SendClientMessage(playerid, C_GRAY, "У Вас недостаточно средств!");
	        Player[playerid][uMoney] -= 50;
            mysql_format(1, query,sizeof(query),"UPDATE gb_users SET uMoney = '%d' WHERE BINARY uName = '%s'",Player[playerid][uMoney],Player[playerid][uName]);
			mysql_tquery(1, query, "", "");
