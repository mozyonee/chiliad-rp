					Player[playerid][uJob] = 1;
					mysql_format(1, query,sizeof(query),"UPDATE gb_users SET uJob = '%d' WHERE BINARY uName = '%s'",Player[playerid][uJob],Player[playerid][uName]);
					mysql_tquery(1, query, "", "");
