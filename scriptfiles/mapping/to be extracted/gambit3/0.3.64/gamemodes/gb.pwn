bool: UseCarDriver(carid);
stock bool: UseCarDriver(carid)
{
	foreach(new i : Player)
	{
		if(GetPlayerState(i) == PLAYER_STATE_DRIVER && GetPlayerVehicleID(i) == carid) return true;
	}
	return false;
}


