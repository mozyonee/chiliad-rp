public OnVehicleStreamIn(vehicleid, forplayerid) {
 	return 1;
}

public OnVehicleStreamOut(vehicleid, forplayerid) {
    return 1;
}

public OnUnoccupiedVehicleUpdate(vehicleid, playerid, passenger_seat, Float:new_x, Float:new_y, Float:new_z, Float:vel_x, Float:vel_y, Float:vel_z)
{
    new Float:distance = GetPlayerDistanceFromPoint(playerid, new_x, new_y, new_z);
	new Float:speed = floatsqroot(floatpower(floatabs(vel_x), 2.0) + floatpower(floatabs(vel_y), 2.0) + floatpower(floatabs(vel_z), 2.0)) * 100.3;
    new strings[128];
	if(IsPlayerInAnyVehicle(playerid) && SpeedVehicle(GetPlayerVehicleID(playerid)) > 30 && GetPlayerVehicleSeat(playerid) == 0 && speed > 45.0){
	    if(NoFludReport + (3) < gettime()) {
			NoFludReport = gettime();
	        format(strings, 128, "<Warning> %s[%d] возможно раскидывает автомобили", Player[playerid][uName], playerid, speed);
			SendAdminMessage(C_YELLOW, strings);
		}
    }
    GetVehiclePos(vehicleid, new_x, new_y, new_z);
	if(!IsPlayerInRangeOfPoint(playerid, 30, new_x, new_y, new_z)){
  		return 0;
	}
	if(distance > 100.0){
	    format(strings, 128, "<Warning> %s[%d] возможно раскидывает автомобили. Distance: %f", Player[playerid][uName], playerid,distance);
	 	SendAdminMessage(C_YELLOW, strings);
	}
	if(speed > 50.0 ){
	    if(NoFludReport + (3) < gettime()) {
			NoFludReport = gettime();
            format(strings, 128, "<Warning> %s[%d] возможно использует CarShot", Player[playerid][uName], playerid);
			SendAdminMessage(C_YELLOW, strings);
 		}
	}
 	return true;
}

stock Air_Get_Pos(playerid)
{
    if(!IsPlayerInAnyVehicle(playerid)){
		GetPlayerPos(playerid,FP_Air_Player[playerid][0],FP_Air_Player[playerid][1],FP_Air_Player[playerid][2]);
	}
    else GetVehiclePos(GetPlayerVehicleID(playerid),FP_Air_Car[playerid][0],FP_Air_Car[playerid][1],FP_Air_Car[playerid][2]);
}

stock Air_Gettime(playerid,extra)
{
    if(!IsPlayerInAnyVehicle(playerid))FP_Air_Time[playerid]=gettime()+extra;
    else FP_Air_Time_Car[playerid]=gettime()+extra;
}


stock TurnPlayerFaceToPlayer(playerid, facingtoid)
{
    new Float:angle;
    new Float:misc = 5.0;
    new Float:x, Float:y, Float:z;
    new Float:ix, Float:iy, Float:iz;
    GetPlayerPos(facingtoid, x, y, z);
    GetPlayerPos(playerid, ix, iy, iz);
    angle = 180.0-atan2(ix-x,iy-y);
    angle += misc;
    misc *= -1;
    SetPlayerFacingAngle(playerid, angle+misc);
}

publics: MySQLQuery(playerid, type) {
	clear_massive();
	new data[120];
	new string[500], str[215];
	new Rows, Fields;
    cache_get_data(Rows, Fields);
	switch(type) {
	    case 45:
	    {
	        if(!Rows) showPlayerDialog(playerid,d_auth,1,"Регистрация",regtext,"Дальше","Выход");
			else showPlayerDialog(playerid,d_auth + 1,3,"Авторизация",logtext,"Дальше","Выход");
	    }
	    case 66:
	    {
	        if(!Rows) return SendClientMessage(playerid, C_GRAY, "У игрока нет прошлых сессий!");
	        for(new j; j != Rows; j++)
	        {
	            new playername[25], playerip[32], sessionstart/*, sessionclose*/;
	            sessionstart = cache_get_field_content_int(j, "pSessionStart");
				cache_get_field_content(j, "uName", playername, mysql);
				cache_get_field_content(j, "pIP", playerip, mysql);
				format(string, sizeof(string), "[%d] Игрок: %s | IP: %s | SS: %d | SC: %d",  j, playername, playerip, date("%dd.%mm.%yyyy", sessionstart), date("%dd.%mm.%yyyy", sessionstart));
				SendClientMessage(playerid, C_GRAY, string);
	        }
	    }
	    case 105:
	    {
	        if(!Rows)
  			{
  			    //Меняем игроку номер!
  			    Player[playerid][uNumber] = GetPVarInt(playerid, "PlayerNumber");
				mysql_format(1, query,sizeof(query),"UPDATE gb_users SET uNumber = '%d' WHERE BINARY uName = '%s'",Player[playerid][uNumber],Player[playerid][uName]);
				mysql_tquery(1, query, "", "");
				SendClientMessage(playerid, -1, ""gbAccess"Вы успешно сменили свой номер телефона!");
				//-----------------------------[]-------------------------------------------
	   			Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")] = 0;
	        	Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")] = 0;
	        	PlayerTextDrawSetPreviewModel(playerid, invSPlayer[playerid][GetPVarInt(playerid,"selectSlot")], 19464);
				PlayerTextDrawSetPreviewRot(playerid, invSPlayer[playerid][GetPVarInt(playerid,"selectSlot")], 0.000000, 0.000000, 90.000000, 0.100000);
				PlayerTextDrawShow(playerid,invSPlayer[playerid][GetPVarInt(playerid,"selectSlot")]);
				SaveInventory(playerid);
	        	SetPVarInt(playerid,"selectSlot",-1);
				SetPVarInt(playerid,"changeSlot",-1);
		    }
		    else
		    {
				SendClientMessage(playerid, -1, ""gbError"Данный номер занят!");
				return 1;
		    }
	    }
	    case 106:
	    {
	        if(!Rows)
	        {
			    new i = GetPVarInt(playerid, "SelectCarID");
			    switch(GetVehicleModel(Car::[i][cCar]))
				{
				    case 510, 509, 481:
				    {
				        SendClientMessage(playerid, C_GRAY, ""gbError"Данному транспорту не нужны номера!");
				        return true;
				    }
				    default:
				    {
			    		new reason[32];
			    		GetPVarString(playerid, "PlayerCarNumber", reason, sizeof(reason));
				        format(string, sizeof(string), "[%s]", reason);
						strmid(Car::[i][cNumber], string, 0, strlen(string), 255);
						UpdateDynamic3DTextLabelText(Car::[i][cNumberLabel], 0xFFFFFF60, Car::[i][cNumber]);
						SetCarStr(Car::[i][cID], "cNumber", Car::[i][cNumber]);
				    }
				}
				format(string, sizeof(string), ""gbAccess"Вы успешно сменили номера своего транспорта на %s", Car::[i][cNumber]);
				SendClientMessage(playerid, C_GRAY, string);
				DeletePVar(playerid, "SelectCarID");
				Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")] = 0;
	        	Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")] = 0;
	        	PlayerTextDrawSetPreviewModel(playerid, invSPlayer[playerid][GetPVarInt(playerid,"selectSlot")], 19464);
				PlayerTextDrawSetPreviewRot(playerid, invSPlayer[playerid][GetPVarInt(playerid,"selectSlot")], 0.000000, 0.000000, 90.000000, 0.100000);
				PlayerTextDrawShow(playerid,invSPlayer[playerid][GetPVarInt(playerid,"selectSlot")]);
				SaveInventory(playerid);
	        	SetPVarInt(playerid,"selectSlot",-1);
				SetPVarInt(playerid,"changeSlot",-1);
	        }
	        else
	        {
	            SendClientMessage(playerid, C_GRAY, ""gbError"Данный номерной знак занят!");
	        }
	    }
	    
	    case 5:
	    {
	        new BussinesOwner[32], BussinesName[32];
	        for(new j; j != Rows; j++)
	        {
	            //
