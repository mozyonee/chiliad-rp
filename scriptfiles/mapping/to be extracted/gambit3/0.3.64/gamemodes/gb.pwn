#include "gambit\cmd"
#include "gambit\script.inc"

stock random_values_array(array_input[], const array_size)
{
    for (new i = 0; i < array_size; i++)
	{
        array_input[i] = random(array_size);

        for (new j = 0; j < array_size; j++) {
            if (i != j && array_input[i] == array_input[j]) {
                j = -1;
                array_input[i] = random(array_size);
            }
        }
    }
}

stock RecordDamage(playerid, bodypart, Float:amount, weaponid)
{
    new hour, minute, second;
    gettime(hour,minute,second);

	for(new i = 0; i < MAX_DAMAGES; i++)
	{
	    if(Damage_All[playerid][i][damage_time] == 0)
	    {
			format(Damage_All[playerid][i][damage_time], 32, "%02d:%02d:%02d", hour, minute, second);
			Damage_All[playerid][i][damage_bodypart] = bodypart;
			Damage_All[playerid][i][damage_amount] = amount;
			Damage_All[playerid][i][damage_weapon] = weaponid;
			Damage_All[playerid][i][damage_unixtime] = gettime(); // Нужно для "%d секунд назад".
			break;
		}
	}
	return 1;
}

stock GetBodypart(id) {
        new name[64] = "Неизвестно";
        if(id == 3) name = "Торс";
        if(id == 4) name = "Пах";
        if(id == 5) name = "Левая рука";
        if(id == 6) name = "Правая рука";
        if(id == 7) name = "Левая нога";
        if(id == 8) name = "Правая нога";
        if(id == 9) name = "Голова";
        return name;
}

stock GetDuration(time)
{
	new
	    str[32];

	if (time < 0 || time == gettime()) {
	    format(str, sizeof(str), "Никогда");
	    return str;
	}
	else if (time < 60)
		format(str, sizeof(str), "%d секунд(-у, -а)", time);

	else if (time >= 0 && time < 60)
		format(str, sizeof(str), "%d секунда", time);

	else if (time >= 60 && time < 3600)
		format(str, sizeof(str), (time >= 120) ? ("%d минут(-ы)") : ("%d минуту"), time / 60);

	else if (time >= 3600 && time < 86400)
		format(str, sizeof(str), (time >= 7200) ? ("%d часа(-ов)") : ("%d час"), time / 3600);

	else if (time >= 86400 && time < 2592000)
 		format(str, sizeof(str), (time >= 172800) ? ("%d дня(-ей)") : ("%d день"), time / 86400);

	else if (time >= 2592000 && time < 31536000)
 		format(str, sizeof(str), (time >= 5184000) ? ("%d месяца(-ев)") : ("%d месяц"), time / 2592000);

	else if (time >= 31536000)
		format(str, sizeof(str), (time >= 63072000) ? ("%d года(лет)") : ("%d год"), time / 31536000);

	strcat(str, " назад");

	return str;
}

stock BizzUpdate(b) //паблик контроля слет бизнесов
{
    new String[1024];
    if(!strcmp(Bizz::[b][bOwner], "None", true)) return 1;
	else
	{
	    if(Bizz::[b][bSettings][3] <= 0)
	    {
	        Bizz::[b][bSellHour]++;
	        SetBizzStr(Bizz::[b][bID],"bSellHour",Bizz::[b][bSellHour]);
			if(Bizz::[b][bSellHour] >= 72)
			{
			    //отдаем владельцу бизнеса 80 процентов стоимости с бизнеса!
			    format(String,sizeof(String),"INSERT INTO `gb_business_money` (ID,Name,Money,BizzID) VALUES ('%d','%s','%d','%d')",Bizz::[b][bOwnerID], Bizz::[b][bOwner], Bizz::[b][bSettings][0] / 100 * 80, b+1);
				mysql_tquery(1, String, "", "");
	            //обнуляем улучшения в бизнесе!
	            if(Bizz::[b][bUpdate][0] != 0) Bizz::[b][bUpdate][0] = 0;
	   			if(Bizz::[b][bUpdate][1] != 0) Bizz::[b][bUpdate][1] = 0;
	   			if(Bizz::[b][bUpdate][2] != 0) Bizz::[b][bUpdate][2] = 0;
	   			format(String,sizeof(String),"%d|%d|%d",Bizz::[b][bUpdate][0],Bizz::[b][bUpdate][1],Bizz::[b][bUpdate][2]);
				SetBizzStr(Bizz::[b][bID],"bUpdate",String);
				//
				strmid(Bizz::[b][bOwner], "None", 0, strlen("None"), MAX_PLAYER_NAME); // устанавливаем владельца бизнеса (государство)
				Bizz::[b][bOwnerID] = 0; // устанавливаем ид аккаунта владельца бизнеса
				//--------------------------------
            	SetBizzInt(Bizz::[b][bID],"bOwnerID",Bizz::[b][bOwnerID]); // отправляем это в базу
            	SetBizzStr(Bizz::[b][bID],"bOwner",Bizz::[b][bOwner]); // x2
				
            	
            	
				switch(Bizz::[b][bSettings][7]) // удаляем объекты которые создаются при
				{
				   	case 3:
					{
						if(Bizz::[b][bUpdate][1] == 1)
						{
							for(new s; s != 351; s ++) DestroyDynamicObject(Bizz::[b][bObjects][s]);
							for(new s; s != 5; s ++) {
							if (IsValidDynamic3DTextLabel(Bizz::[b][bTextBuy][s]))
								DestroyDynamic3DTextLabel(Bizz::[b][bTextBuy][s]);
							}
						}
					}
					case 8:
					{
				     	if(Bizz::[b][bUpdate][1] == 1)
						{
					    	for(new i; i < 54; i ++) DestroyDynamicObject(Bizz::[b][bAObject][i]);
					    	if (IsValidDynamic3DTextLabel(Bizz::[b][bAText]))
					    		DestroyDynamic3DTextLabel(Bizz::[b][bAText]);
						}
					}
				}
	        }
	    }
	    else
	    {
	        if(Bizz::[b][bSettings][3] >= 20)
	        {
		        //продаем со склада 20 продуктов, и начисляем стоимость в сейф.
		        Bizz::[b][bSettings][3] -= 20;
				Bizz::[b][bSettings][6] += Bizz::[b][bSettings][5]*20;
			}
	    }
	}
	return 1;
}

public OnGameModeExit() {
	foreach (new i : Player) {
		if(GetPVarInt(i, "uLogin") == 1) {
   			showPlayerDialog(i,-1,DIALOG_STYLE_MSGBOX,"1","1","1","1");
		}
	}
	SaveAllProducts();
	mysql_close();
	return 1;
}

public OnPlayerConnect(playerid) {
	if(closeserver == true) {
	    SendClientMessage(playerid, C_ORANGE, "В данный момент на сервере происходит рестарт. Войдите через минуту!");
	    KickEx(playerid);
	    return true;
	}
    if(IsPlayerNPC(playerid)) return BanEx(playerid, "Fake NPC");
    for(new i;i<13;i++) gGuns[playerid][i] = 0, gAmmos[playerid][i] = 0;
    PlayerKey[playerid] = "";
    D::[playerid][dRentVehicleID] = -1;
	dialog_anticheat[playerid] = 0;
	SetPVarInt(playerid,"RadioAdmin", 0);
    SetPVarInt(playerid,"FP_Protection", 0);
    SetPVarInt(playerid, "NarkEffect", 0);
    SetPVarInt(playerid, "HouseFurniture", 0);
    for(new uInfo:i; i < uInfo; ++i) Player[playerid][i] = 0;
    for(new pData:i; i < pData; ++i) D::[playerid][i] = 0;
    for(new invInfo:i; i < invInfo; ++i) Inv[playerid][i] = 0;
    //------------[АнтиЧит] -------------------------
	IDVEH[playerid] = -1;
    UseEnter[playerid] = false;
	FP_Air_Time[playerid] = 0;
    FP_Air_Time_Car[playerid]=0;
    //------------------------------------------------
    VPInfo[playerid][SeeVehicle] = -1;

    playerFlags[playerid] = Flags:0;

    D::[playerid][dTaxiKey] = -1;
    D::[playerid][dBusKey] = -1;
    D::[playerid][dDalnKey] = -1;
    PlayerTrailer[playerid] = -1;
    PlayerTrailerTime[playerid] = -1;

	PlayerUseDrink[playerid] = 0;
	PlayerCountMinute[playerid] = 0;
	PlayerCountReport[playerid] = 0;

    SetPVarInt(playerid,"ACPlayerCarID",-1);
    SetPVarInt(playerid,"BusToGo",-1);
    SetPVarInt(playerid,"changeSlot",-1);
	SetPVarInt(playerid,"selectSlot",-1);
	SetPVarInt(playerid,"changeSlotUse",-1);
	SetPVarInt(playerid,"selectSlotUse",-1);
	SetPVarInt(playerid,"PlayerVehicleID",-1);
	SetPVarInt(playerid,"uLogin",0);
	SetPVarInt(playerid,"UseSlots",-1);

	SetPVarInt(playerid,"BlockID",INVALID_PLAYER_ID);
