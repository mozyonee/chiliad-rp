		    V::[i][vTaxiDriver] = -1;
		    V::[i][vTaxiText] = -1;
		    SetVehicleParamsEx(i,eng,light,other1,1,other3,other4,other5);
		    V::[i][vLock] = true;
		    V::[i][vHealth] = 1000.0;
		    V::[i][vFuel] = MaxVehicleFuel[GetVehicleModel(i) - 400];
		}
		if(i >= fermcars[0] && i <= fermcars[1]) {
			switch( GetVehicleModel( i ) ) {
				case 610: {
					format( gb_string,sizeof(gb_string),"Семена\n{ffffff}%d/%d ед.",V::[i][vPosev],MAX_POSEV_IN_VEHICLE);
