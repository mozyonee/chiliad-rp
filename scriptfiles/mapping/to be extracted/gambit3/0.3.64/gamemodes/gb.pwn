forward ClearBackup(playerid);
public ClearBackup(playerid) {
	if(GetPVarInt(playerid,"playerUseBackup") != 0) {
	    SendClientMessage(playerid,C_GRAY,""gbInfo"Выше время на ожидание подмоги закончилось.");
	    SetPVarInt(playerid,"playerUseBackup",0);
	    foreach(new i : Player) {
	        switch(Player[playerid][uMember]) {
	            case 1,2: SetPlayerMarkerForPlayer(i, playerid, FracColor[Player[i][uMember]]);
	        }
	    }
	    if(Player[playerid][uIsPlayerJob][0] == 1) SetPlayerColor(playerid,FracColor[Player[playerid][uMember]]);
	}
	return 1;
}

forward CloseDoors(id);
public CloseDoors(id) {
	switch(id) {
		case 0: MoveDynamicObject(gDoors[0],1553.51501, -1671.65527, 1099.50562,1.0,0.00000, 0.00000, 0.00000);
		case 1: MoveDynamicObject(gDoors[1],1553.51501, -1682.53528, 1099.50562,1.0,0.00000, 0.00000, 0.00000);
		case 2: MoveDynamicObject(gDoors[2],1552.85889, -1684.95496, 1098.23999,1.0,0.00000, 0.00000, 90.00000);
		case 3: MoveDynamicObject(gDoors[3],245.6280, 72.5611, 1002.6413,1.0, 0.0,0.0,0.0);
		case 4: MoveDynamicObject(gDoors[4],1577.08997, -1684.97498, 1098.23999,1.0, 0.00000, 0.00000, 90.00000);
	}
}

forward WoodsPlayer(playerid,wood,selected);
public WoodsPlayer(playerid,wood,selected) {
	new j = GetPVarInt(playerid,"WoodDrop");
	switch(selected) {//-462.9798,-88.4665,59.9006
	    case 0: {
	        WD::[j][woodIsDrop] = true;
	        WD::[j][woodUse] = false;
	        MoveDynamicObject(WD::[j][woodObject],WoodsDrop[j][0],WoodsDrop[j][1],WoodsDrop[j][2] - 0.05, 0.05, WoodsDrop[j][3],WoodsDrop[j][4],WoodsDrop[j][5]);
	        SendClientMessage(playerid,C_GRAY,""gbInfo"Чтобы напилить ещё дров, подойдите к основанию дерева.");
            RemovePlayerAttachedObject(playerid,9);
			SetPlayerAttachedObject(playerid,9,1463,5,0.073999,0.186000,0.105998,95.299972,-175.499984,-72.199935,0.540999,0.350999,0.610999);
	        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
			SetPVarInt(playerid,"PlayerUseBox",5);
            WD::[j][woodCount] -= 25;
			SetPVarInt(playerid,"WoodCheckpointTop",_:SetPlayerCheckpoint(playerid,-462.9798,-88.4665,59.9006,1.0));
	    }
	    case 1: {
            RemovePlayerAttachedObject(playerid,9);
			SetPlayerAttachedObject(playerid,9,1463,5,0.073999,0.186000,0.105998,95.299972,-175.499984,-72.199935,0.540999,0.350999,0.610999);
	        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
	        SetPVarInt(playerid,"PlayerUseBox",5);
	        SetPVarInt(playerid,"WoodCheckpointTop",_:SetPlayerCheckpoint(playerid,-462.9798,-88.4665,59.9006,1.0));
	        if(WD::[j][woodCount] == 0) {
		   		DestroyDynamicObject(WD::[j][woodObject]);
    		}
	    }
	}
	togglePlayerControllable(playerid,true);
	DeletePVar(playerid,"WoodDrop");
	return 1;
}

forward WoodStanok(playerid);
