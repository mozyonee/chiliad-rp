forward VehicleToPoint(Float:radi, vehicleid, Float:x, Float:y, Float:z);
public VehicleToPoint(Float:radi, vehicleid, Float:x, Float:y, Float:z) {
	new Float:oldposx, Float:oldposy, Float:oldposz;
	new Float:tempposx, Float:tempposy, Float:tempposz;
	GetVehiclePos(vehicleid, oldposx, oldposy, oldposz);
	tempposx = (oldposx -x);
	tempposy = (oldposy -y);
	tempposz = (oldposz -z);
	if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi))) return 1;
	return 0;
}

publics: ClearAnimationsDelay(playerid) ApplyAnimation(playerid,"ped","IDLE_chat",4.1,1,0,0,0,1,1);


publics: OnMinuteTimer() {
    tenmenitetimer++;
	callHouse();
    if( tenmenitetimer == 10 ) tenmenitetimer = 0;
    foreach (new playerid : Player) {
		new afk = getData( playerid, "PlayerAFK");
    	if( Player[playerid][uMute] > 0) Player[playerid][uMute]--;
    	if( Player[playerid][uBMute] > 0) Player[playerid][uBMute]--;
        if( Player[playerid][uHunger] >= 1 && afk <= 0 ) {
			Player[playerid][uHunger] --;
			if( Player[playerid][uSettings][2] == 1 ) Hunger( playerid, 0 );
			else Hunger(playerid, Player[playerid][uHunger]);
		}
		else if( afk <= 0 ) setPlayerHealth( playerid, Player[playerid][uHP] - 2.0 );
		if( afk > 2400 ) { 
		    if( Player[playerid][uAdmin] == 0 ) {
				SendMes( playerid, C_LIGHTRED, "[KICK] Вы были кикнуты сервером за продолжительное афк" );
				format( gb_string, sizeof gb_string, "[AFK] Игрок %s был кикнут сервером за продолжительное афк", Player[playerid][uName] );
		        SendAdminMessage( C_LIGHTRED, gb_string );
				KickEx( playerid );
				continue;
			}
		}
		if( GetPlayerState( playerid ) == PLAYER_STATE_DRIVER) UpdateFuelBar( playerid, GetPlayerVehicleID(playerid) );
		prisonTimer( playerid );
		PlayerCountMinute[playerid] ++;
        Player[playerid][uPayTime]++;
  		if(Player[playerid][uPayTime] >= 60) payDay( playerid );
        if( D::[playerid][dRentVehicleTime] && D::[playerid][dRentVehicleID] ) {
			D::[playerid][dRentVehicleTime] --;
		 	if( D::[playerid][dRentVehicleTime] <= 0 ) {
		 	    SendMes( playerid, -1, ""gbInfo"Время аренды истекло, хотите продлить ?");
				RemovePlayerFromVehicle(playerid);
				SetVehicleToRespawn(D::[playerid][dRentVehicleID]);
			}
		}
        if( Player[playerid][uDMJail] > 0 ) {
			Player[playerid][uDMJail]--;
			if( Player[playerid][uDMJail] == 0 ) {
				Player[playerid][uDMJail] = 0;
				nowUpdateInfo( playerid , "d" , "gb_users" , "uName" , "uDMJail" , Player[playerid][uDMJail] );
				SendClientMessage( playerid, C_GRAY, ""gbAccess"Вы отсидели свой срок в Де Моргане!" );
				SetPlayerInterior( playerid, 0 );
				SetPlayerVirtualWorld( playerid, 0 );
				setPlayerPos( playerid, 1543.9922, -1669.7343, 13.5575 );
			}
		}
    }
    for(new i; i != MAX_VEHICLES; i ++) {
    	if( !IsValidVehicle( i ) ) continue;
    	GetVehicleParamsEx( i, eng, light, other1, other2, other3, other4, other5 );
    	if( eng == 1 ) {
    		V::[i][vFuel] -= 0.5;
    		if( V::[i][vFuel] == 0.0 ) SetVehicleParamsEx( i, false, light, other1, other2, other3, other4, other5 );
    	}
    	if( V::[i][vBuyingCar] != -1 ) {
    	    new c = V::[i][vBuyingCar];
    	    if( Car::[c][cStatus][0] <= 20 ) {
    			GetVehicleParamsEx( Car::[c][cCar], eng, light, other1, other2, other3, other4, other5 );
    			if( eng == 1 ) {
    				switch( random( 10 ) ) {
    					case 0 .. 4: {}
    					case 5 .. 9: SetVehicleParamsEx( Car::[c][cCar], false, light, other1, other2, other3, other4, other5 );
    				}
    			}
    		}
    	}
    }
    if( countWoods != 10 ) countWoods ++;
	else {
	    countWoods = 0;
		for( new i; i != MAX_WOODS; i++ ) {
		    if( WD::[i][woodCount] <= 0 ) {
		        WD::[i][woodObject] = CreateDynamicObject( 660, Woods[i][0], Woods[i][1], Woods[i][2], Woods[i][3], Woods[i][4], Woods[i][5] );
		        WD::[i][woodUse] = false;
				WD::[i][woodIsDrop] = false;
				WD::[i][woodCount] = 100;
		    }
		}
	}
    if( countSave != 10 ) countSave ++;
	else {
	    countSave = 0;
	    S::[0][sProducts] += 100;
	    MebelZavod += 100;
	    WoodsZavod += 100;
	    ToplivoZavod += 1000;
	    S::[0][wsWoodsSklad] += 100;

	    S::[0][sFerm][4] += 50;
	    S::[0][sFerm][5] += 50;
	    S::[0][sFerm][6] += 60;

	    if( ToplivoZavod >= MAX_FUEL_IN_ZAVOD ) ToplivoZavod = 100000;
	    if( S::[0][sFerm][4] >= MAX_SEM_AMBAR_ONE ) S::[0][sFerm][4] = 10000;
	    if( S::[0][sFerm][6] >= MAX_FUEL_IN_FERMA ) S::[0][sFerm][6] = MAX_FUEL_IN_FERMA;
	    if( S::[0][sFerm][5] >= MAX_SEM_AMBAR_TWO ) S::[0][sFerm][5] = 5000;
	    if( S::[0][sFerm][0] >= MAX_AMBAR_COUNT ) S::[0][sFerm][0] = 3000;
	    if( S::[0][sFerm][1] >= MAX_AMBAR_COUNT ) S::[0][sFerm][1] = 3000;
	    if( S::[0][sFerm][2] >= MAX_AMBAR_COUNT ) S::[0][sFerm][2] = 3000;
	    if( S::[0][sFerm][3] >= MAX_AMBAR_COUNT ) S::[0][sFerm][3] = 3000;

	    format( gb_string, sizeof gb_string,"Завод мебели\n\n{ffffff}Мебель: %d ед.\nДревесины: %d ед.",MebelZavod,WoodsZavod);
		UpdateDynamic3DTextLabelText( InfoFermText[7], C_BLUE, gb_string );
	    format( gb_string, sizeof gb_string, "Нефтеперерабатывающий завод{ffffff}\n\nТопливо: %d л.",ToplivoZavod );
	    UpdateDynamic3DTextLabelText( InfoFermText[8], C_BLUE, gb_string );
	    format( gb_string, sizeof gb_string, "Обработанная древесина\n{ffffff}%d кг.",S::[0][wsWoodsSklad] );
	    UpdateDynamic3DTextLabelText( S::[0][wsWoodsTS][0], C_BLUE, gb_string );
	    UpdateDynamic3DTextLabelText( S::[0][wsWoodsTS][1], C_BLUE, gb_string );
	    format( gb_string, sizeof gb_string, "Семян в амбаре\n{ffffff}%d/10000 ед.",S::[0][sFerm][4] );
		UpdateDynamic3DTextLabelText( InfoFermText[0], C_BLUE, gb_string );
		format( gb_string, sizeof gb_string, "Топлива в бочке\n{ffffff}%d/60000 л.",S::[0][sFerm][6] );
		UpdateDynamic3DTextLabelText( InfoFermText[1], C_BLUE, gb_string );
		format( gb_string, sizeof gb_string, "Семена для загрузки\n{ffffff}%d/5000 ед.",S::[0][sFerm][5] );
		UpdateDynamic3DTextLabelText( InfoFermText[2], C_BLUE, gb_string );
		SaveAllProducts();
	}
}

publics: OnSecondTimer() {
	clear_massive();
    new string[128];
	new text[256];
	strcat(text,"  "cYELLOW"Очередь на загрузку:{FFFFFF}");
	for(new i;i<10;i++)
	{
		if(gTruckLoadTurn[0][i] != INVALID_PLAYER_ID && !IsPlayerConnected(gTruckLoadTurn[0][i])) gTruckLoadTurn[0][i] = INVALID_PLAYER_ID;
		if(i != 9 && gTruckLoadTurn[0][i] == INVALID_PLAYER_ID && gTruckLoadTurn[0][i+1] != INVALID_PLAYER_ID) {gTruckLoadTurn[0][i] = gTruckLoadTurn[0][i+1]; gTruckLoadTurn[0][i+1] = INVALID_PLAYER_ID;}
		if(gTruckLoadTurn[0][i] != INVALID_PLAYER_ID) format(text,sizeof(text),"%s\n%d. %s",text,i+1,Player[gTruckLoadTurn[0][i]][uName]);
		else format(text,sizeof(text),"%s\n%d. -",text,i+1);
	}
	UpdateDynamic3DTextLabelText(gTruckLoadTurnText[0], -1, text);
	if(gTruckLoadTurn[0][0] != INVALID_PLAYER_ID)
	{
	    new playerid = gTruckLoadTurn[0][0];
		new Float:posv[3][6] = {
       		{-520.3046,-488.6065,26.5456,1019.3719, -325.2847, 74.4603},
       		{-529.7679,-488.5077,26.5385,-529.7606,-500.6951,25.6024},
       		{-557.5859,-488.8280,26.5471,-557.7141,-500.6195,25.6110}
    	};
		if(IsPlayerConnected(playerid))
		{
		    if(PlayerTrailer[playerid] != -1)
		    {
		        if(PlayerTrailerTime[playerid] && GetPVarInt(playerid,"waitgruz") == 2) PlayerTrailerTime[playerid]--;
          		else if(PlayerTrailerTime[playerid] < 1 && GetPVarInt(playerid,"waitgruz") == 2)
		        {

    				V::[PlayerTrailer[playerid]][vWoods] = 0;
					V::[PlayerTrailer[playerid]][vUrojai] = 0;
					V::[PlayerTrailer[playerid]][vMebel] = 0;
					V::[PlayerTrailer[playerid]][vToplivo] = 0;
		   			DestroyVehicle(PlayerTrailer[playerid]);
		   			
		   			if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]))
			    		DestroyDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]);
			    	
			    	SetPVarInt(playerid,"dettachTrailer",0);
			       	PlayerTrailer[playerid] = -1;
					DisablePlayerCheckpoint(playerid);
     				SendClientMessage(playerid,C_GRAY,""gbError"Вы оставили свой прицеп на месте аренды. (( Прицеп был удалён. ))");
			   		gTruckLoadTurn[0][0] = INVALID_PLAYER_ID;
                    SetPVarInt(playerid,"waitgruz",0);
				}
		    }
		    else
			{
			    SendClientMessage(playerid,-1,""gbInfo"Подошла очередь загрузки вашей фуры");
				SendClientMessage(playerid,-1,""gbInfo"После загрузки у Вас будет всего минута, чтобы прицепить её.");
				SetPVarInt(playerid,"waitgruz",2);
				PlayerTrailerTime[playerid] = 80;
				switch(GetPVarInt(playerid,"PlayerSelectTrailer"))
				{
					case 1: {
						PlayerTrailer[playerid] = CreateVehicle(435,posv[0][3],posv[0][4],posv[0][5],180.0000,1,1,-1);
						format(string,sizeof(string),"Мебель\n{ffffff}%d/%d ед.",V::[PlayerTrailer[playerid]][vMebel],MAX_MEBEL_IN_VEHICLE);
						SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,-18.9291,-273.3552,5.4297,5.0));
						SetPVarInt(playerid,"PlayerSelectTrailerTwo",1);
					}
					case 2: {
						PlayerTrailer[playerid] = CreateVehicle(584,posv[0][3],posv[0][4],posv[0][5],180.0000,1,1,-1);
						format(string,sizeof(string),"Топливо\n{ffffff}%d/%d л.",V::[PlayerTrailer[playerid]][vToplivo],MAX_FUEL_IN_VEHICLE);
						SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,248.2978,1420.6721,10.5727,5.0));
						SetPVarInt(playerid,"PlayerSelectTrailerTwo",2);
					}
				   	case 3: {
						PlayerTrailer[playerid] = CreateVehicle(591,posv[0][3],posv[0][4],posv[0][5],180.0000,1,1,-1);
						format(string,sizeof(string),"Урожай\n{ffffff}%d/%d ед.",V::[PlayerTrailer[playerid]][vUrojai],MAX_UROJAI_IN_VEHICLE);
						if(S::[0][sFerm][0] != 0) SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,-112.0009,-1.5788,3.1172,3.0));
						SetPVarInt(playerid,"PlayerSelectTrailerTwo",3);
					}
					case 4: {
						PlayerTrailer[playerid] = CreateVehicle(450,posv[0][3],posv[0][4],posv[0][5],180.0000,1,1,-1);
						format(string,sizeof(string),"Древесина\n{ffffff}%d/%d кг.",V::[PlayerTrailer[playerid]][vWoods],MAX_WOODS_IN_VEHICLE);
						SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,-496.0325,-82.4771,61.2981,5.0));
						SetPVarInt(playerid,"PlayerSelectTrailerTwo",4);
					}
		  			default: SendClientMessage(playerid,C_GRAY,""gbError"Вы должны выбрать хотя бы один из прицепов.");
				}
				V::[PlayerTrailer[playerid]][vTextTrailer] = CreateDynamic3DTextLabel(string,C_BLUE,0.0,0.0,0.0,20.0,INVALID_PLAYER_ID,PlayerTrailer[playerid],1);
    		}
    		if(!IsPlayerInDynamicArea(playerid, strZones[4]) && (gTruckLoadTurn[0][0] == playerid))
			{
			    if(GetVehicleTrailer(GetPlayerVehicleID(playerid)) == PlayerTrailer[playerid])
			    {
					gTruckLoadTurn[0][0] = INVALID_PLAYER_ID;
			        PlayerTrailerTime[playerid] = 0;
			    }
			}
		}
	}
	new hour,minuts,second;
    gettime(hour,minuts,second);
	if( hour == 5 ) {
	    if( minuts < 5 && second == 0 ) {
			format( text, sizeof text, "Уважаемые игроки! Через %d мин. произойдёт рестарт сервера!", 5 - minuts);
	        SendClientMessageToAll(C_ORANGE, text );
	    }
	    else if( minuts == 5 && second == 0 ) {
     		SendClientMessageToAll(C_ORANGE, "Уважаемые игроки! В данный момент происходит рестарт сервера. Пожалуйста, войдите через минуту!");
        	foreach(new i : Player) KickEx(i);
    		SetTimer("ModePlanRestart",30*1000,false);
    		closeserver = true;
	    }
	}
    
	if( ghour != hour ) {
		for( new b; b != cBizz; b ++ ) BizzUpdate( b );
		callHouse();
		//CallFire();
	}
	
	if( ghour != hour ) ghour = hour;
	
	callWeather();
    foreach( new i:Player) // TYT
	{
		if(!IsPlayerConnected(i)) continue;
		if(GetPVarInt(i,"uLogin") == 0) continue;
		if(IsKicked(i)) continue;
		if(PlayerCountReport[i] != 0) PlayerCountReport[i] --;
		user_update_weather[i]++;
		if( user_update_weather[i] > 160 ) user_update_weather[i] = 0, updateWeather( i );
		
        new weaponids, ammos;
		new Float: p[3];
        GetPlayerPos(i, p[0], p[1], p[2]);
    	if(!GetPVarInt(i, "uLogin") && (p[0] > 0 || p[1] > 0 || p[2] > 0)) {
		    SendClientMessage(i, 0xFF6347AA, "[AC]: Вы были кикнуты за подозрения в читерстве [#0018]");
			KickEx(i);
    	}
		if( stop_time[i] > 0 ) {
			stop_time[i]--;
			if( stop_time[i] < 1 ) {
				TogglePlayerControllable( i, true );
			}
		}
		cctvTimer( i );
    	deathtimer( i );
		walktimer( i );
        if(IDVEH[i] != -1 && IsPlayerConnected(i) && IsPlayerInAnyVehicle(i) && !UseEnter[i] && IDVEH[i] != GetPlayerVehicleID(i)) {
		    SendClientMessage(i, 0xFF6347AA, "[AC]: Вы были кикнуты за подозрения в читерстве [#0005]");
		    if( !Player[i][uAdmin] ) KickEx(i);
        }
	    if(SpeedVehicle(GetPlayerVehicleID(i)) > GetMaxSpeedInVehicle(GetPlayerVehicleID(i)) + 12) {
	        SetPVarInt(i, "SpeedHackWarning", GetPVarInt(i, "SpeedHackWarning") + 1);
	        if(GetPVarInt(i, "SpeedHackWarning") > 7) {
	            if(NoFludReport + (3) < gettime()) {

       				NoFludReport = gettime();
	            	format( gb_string, sizeof gb_string, "{FF0000}<Warning> %s[%d] возможно использует SpeedHack [%d|%d]", Player[i][uName], i, SpeedVehicle(GetPlayerVehicleID(i)), GetMaxSpeedInVehicle(GetPlayerVehicleID(i)));
	            	SendAdminMessage(C_RED, gb_string);
	            	SetPVarInt(i, "SpeedHackWarning", 0);
				}
			}
	    }
     	GetPlayerWeaponData(i, GetWeaponSlot(GetPlayerWeapon(i)), weaponids, ammos);
	    if(weaponids==9||weaponids==35||weaponids==36||weaponids==37||weaponids==38||weaponids==44||weaponids==45|| weaponids ==16||weaponids == 17|| weaponids == 18 || weaponids == 26 || weaponids == 39 || weaponids == 40) {
	        SendClientMessage(i, 0xFF6347AA, "[AC]: Вы были кикнуты за подозрения в читерстве [#0008]");
			KickEx(i);
	    }	

		SetPVarInt(i,"PlayerAFK",GetPVarInt(i,"PlayerAFK") + 1);
		new Float:hp,Float:armour;
		GetPlayerHealth(i,hp);
		GetPlayerArmour(i,armour);
		if(Player[i][uHP] < hp) SetPlayerHealth(i,Player[i][uHP]);
		else Player[i][uHP] = hp;
		if(Inv[i][invSlotKol][54] < floatround(armour)) setPlayerArmour(i,Inv[i][invSlotKol][54]);
		if(GetPlayerSpecialAction(i) == SPECIAL_ACTION_USEJETPACK) ACKick(i,"JetPack");
		if(Player[i][uJailSettings][2] != 0) {
			if(Player[i][uJailSettings][3] != 0) {
				Player[i][uJailSettings][3] --;
    			format(string,sizeof(string),"%d",Player[i][uJailSettings][3]);
    			GameTextForPlayer(i, string, 2000, 6);
    			ApplyAnimation(i, "CRACK", "crckdeth2", 4.0, 1, 0, 0, 0, 0);
    			new Float:health;
    			GetPlayerHealth(i,health);
    			if(health < 100.0) setPlayerHealth(i,health + 5);
			}
			else {
				Player[i][uJailSettings][2] = 0;
				Player[i][uJailSettings][3] = 0;
				format(string,sizeof(string),"%d|%d|%d|%d|%d",Player[i][uJailSettings][0],Player[i][uJailSettings][1],Player[i][uJailSettings][2],Player[i][uJailSettings][3],Player[i][uJailSettings][4]);
				nowUpdateInfo(i , "s" , "gb_users" , "uName" , "uJailSettings" , string);
				ClearAnimations(i);
				SendClientMessage(i,C_GRAY,""gbAccess"Вас выписали из больницы!");
				setPlayerPos(i,1137.4501,-1321.1863,804.5207);
				togglePlayerControllable(i,true);
				spawnFreezeTime(i);
			 	SetPVarInt(i, "RepeatKill", 0);
			}
		}
		if( Player[i][uJail] ) {
			if( Player[i][uJailTime] ) Player[i][uJailTime]--;
			else {
				switch( Player[i][uJail] ) {
					case 1: setPlayerPos( i, 1547.1527, -1679.3868, 2494.2449 );
					case 2: setPlayerPos( i, 637.7561, -576.3484, 1994.0859 );
					//
				}
				stopPlayer( i, 3 );
				Player[i][uJail] = 0, Player[i][uJailTime] = 0;
				userUpdate( i, "uJail", 0 ), userUpdate( i, "uJailTime", 0 );
				SendMes( i, C_GRAY, ""gbAccess"Вы отсидели свой срок  в тюрьме!" );
			}
		}
		if(Player[i][uJailSettings][4] != 0) ApplyAnimation(i, "WUZI", "CS_Dead_Guy", 4.0, 1, 0, 0, 0, 0);
		if(GetPVarInt(i,"playerFreezingTime") != 0) {
		    SetPVarInt(i,"playerFreezingTime",GetPVarInt(i,"playerFreezingTime") - 1);
			if(GetPVarInt(i,"playerFreezingTime") == 0) {
			    togglePlayerControllable(i,true);
			}
		}
		if(GetPVarInt(i,"Stunned") != 0) {
		    SetPVarInt(i,"Stunned",GetPVarInt(i,"Stunned") - 1);
		    if (GetPlayerAnimationIndex(i) != 388)
            	ApplyAnimation(i, "CRACK", "crckdeth4", 4.0, 0, 0, 0, 1, 0, 1);
			if(GetPVarInt(i,"Stunned") == 0) {
			    togglePlayerControllable(i,true);
			}
		}
		if(GetPVarInt(i,"follow") != INVALID_PLAYER_ID && GetPVarInt(i,"playerCuffed") != 0) {
		    if(IsPlayerConnected(GetPVarInt(i,"follow"))) {
		        if(!IsPlayerInAnyVehicle(GetPVarInt(i,"follow"))) {
		            if(!IsPlayerInAnyVehicle(i)) {
		                if(GetDistanceBetweenPlayers(i, GetPVarInt(i,"follow")) < 1.5) {
							ClearAnimations(i);
						}
						else if(GetDistanceBetweenPlayers(i, GetPVarInt(i,"follow")) > 1.0 && GetDistanceBetweenPlayers(i, GetPVarInt(i,"follow")) < 10.0) {
							SetPlayerToFacePlayer(i, GetPVarInt(i,"follow"));
							ApplyAnimation(i, "ped", "WALK_civi", 6.0, 1, 1, 1, 1, 0, 1);
						}
						else if(GetDistanceBetweenPlayers(i, GetPVarInt(i,"follow")) > 10.0) {
							SendClientMessage(GetPVarInt(i,"follow"),C_GRAY,""gbInfo"Вы отошли слишком далеко от человека, которого ведёте за собой!");
							SetPVarInt(GetPVarInt(i,"follow"),"follow",INVALID_PLAYER_ID);
							SetPVarInt(i,"follow",INVALID_PLAYER_ID);
							togglePlayerControllable(i,false);
						}
		            }
		            else {
					    SetPVarInt(GetPVarInt(i,"follow"),"follow",INVALID_PLAYER_ID);
						SetPVarInt(i,"follow",INVALID_PLAYER_ID);
					}
				}
				else {
				    SetPVarInt(GetPVarInt(i,"follow"),"follow",INVALID_PLAYER_ID);
					SetPVarInt(i,"follow",INVALID_PLAYER_ID);
				}
		    }
		    else SetPVarInt(i,"follow",INVALID_PLAYER_ID);
		}
		if(GetPVarInt(i,"dettachTrailer") != 0) {
		    SetPVarInt(i,"dettachTrailer",GetPVarInt(i,"dettachTrailer") - 1);
		    format(string,sizeof(string),"%d",GetPVarInt(i,"dettachTrailer"));
		    GameTextForPlayer(i, string, 1000, 6);
		    if(GetPVarInt(i,"dettachTrailer") == 0) {
		        V::[PlayerTrailer[i]][vWoods] = 0;
				V::[PlayerTrailer[i]][vUrojai] = 0;
				V::[PlayerTrailer[i]][vMebel] = 0;
				V::[PlayerTrailer[i]][vToplivo] = 0;
			    DestroyVehicle(PlayerTrailer[i]);
			    
			    if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[i]][vTextTrailer]))
			    	DestroyDynamic3DTextLabel(V::[PlayerTrailer[i]][vTextTrailer]);
			    
		        PlayerTrailer[i] = -1;
				DisablePlayerCheckpoint(i);
				SetPVarInt(i,"dettachTrailer",0);
		        SendClientMessage(i,C_GRAY,""gbError"Ваш прицеп отцепился от тягача, прицеп возвращен на склад.");
		    }
		}
		if(GetPVarInt(i,"CountBackTaxi") != 0) {
		    SetPVarInt(i,"CountBackTaxi",GetPVarInt(i,"CountBackTaxi") - 1);
		    format(string,sizeof(string),"%d",GetPVarInt(i,"CountBackTaxi"));
		    GameTextForPlayer(i, string, 1000, 6);
		    if(GetPlayerVehicleID(i) >= ataxils[0] && GetPlayerVehicleID(i) <= ataxils[1]) {
	            if(V::[GetPlayerVehicleID(i)][vTaxiDriver] == i && D::[i][dTaxiKey] == GetPlayerVehicleID(i)) SetPVarInt(i,"CheckpointBack",_:SetPlayerCheckpoint(i,1099.9902,-1242.7791,15.3823,5.0));
			}
			else DisablePlayerCheckpoint(i);
			if(GetPVarInt(i,"CountBackTaxi") == 0) {
			    if(GetPlayerVehicleID(i) >= ataxils[0] && GetPlayerVehicleID(i) <= ataxils[1]) {
			        if(V::[GetPlayerVehicleID(i)][vTaxiDriver] == i && D::[i][dTaxiKey] == GetPlayerVehicleID(i)) {
		                V::[GetPlayerVehicleID(i)][vTaxiDriver] = -1;
		                D::[i][dTaxiKey] = -1;
						DisablePlayerCheckpoint(i);
						D::[i][dTaxiDuty] = false;
						Player[i][uTaxiNoZp] = gettime();
						nowUpdateInfo(i, "d" , "gb_users" , "uName" , "uTaxiNoZp" , Player[i][uTaxiNoZp]);
		            }
		            else {
		                if(D::[i][dTaxiKey] != -1) {
					    	V::[D::[i][dTaxiKey]][vTaxiDriver] = -1;
						    D::[i][dTaxiKey] = -1;
							DisablePlayerCheckpoint(i);
							D::[i][dTaxiDuty] = false;
							Player[i][uTaxiNoZp] = gettime();
							nowUpdateInfo(i , "d" , "gb_users" , "uName" , "uTaxiNoZp" , Player[i][uTaxiNoZp]);
						}
		            }
			    }
			}
		}
		if(GetPVarInt(i,"CountBackDaln") != 0) {
		    SetPVarInt(i,"CountBackDaln",GetPVarInt(i,"CountBackDaln") - 1);
		    format(string,sizeof(string),"%d",GetPVarInt(i,"CountBackDaln"));
		 	GameTextForPlayer(i, string, 1000, 6);
			if(GetPVarInt(i,"CountBackDaln") == 0) {
			    if(GetPlayerVehicleID(i) >= dalncars[0] && GetPlayerVehicleID(i) <= dalncars[1]) {
			        if(V::[GetPlayerVehicleID(i)][vDalnDriver] == i && D::[i][dDalnKey] == GetPlayerVehicleID(i)) {
		                V::[GetPlayerVehicleID(i)][vDalnDriver] = -1;
		                D::[i][dDalnKey] = -1;
						DisablePlayerCheckpoint(i);
						D::[i][dDalnDuty] = false;
						if(PlayerTrailer[i] != -1) {
							V::[PlayerTrailer[i]][vWoods] = 0;
							V::[PlayerTrailer[i]][vUrojai] = 0;
							V::[PlayerTrailer[i]][vMebel] = 0;
							V::[PlayerTrailer[i]][vToplivo] = 0;
							DestroyVehicle(PlayerTrailer[i]);
							
							if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[i]][vTextTrailer]))
								DestroyDynamic3DTextLabel(V::[PlayerTrailer[i]][vTextTrailer]);
							
							PlayerTrailer[i] = -1;
							SetPVarInt(i,"dettachTrailer",0);
						}
		            }
			    }
			    else {
			        if(D::[i][dDalnKey] != -1) {
				    	V::[D::[i][dDalnKey]][vDalnDriver] = -1;
					    D::[i][dDalnKey] = -1;
						DisablePlayerCheckpoint(i);
						D::[i][dDalnDuty] = false;
						if(PlayerTrailer[i] != -1) {
							V::[PlayerTrailer[i]][vWoods] = 0;
							V::[PlayerTrailer[i]][vUrojai] = 0;
							V::[PlayerTrailer[i]][vMebel] = 0;
							V::[PlayerTrailer[i]][vToplivo] = 0;
							DestroyVehicle(PlayerTrailer[i]);
							
							if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[i]][vTextTrailer]))
								DestroyDynamic3DTextLabel(V::[PlayerTrailer[i]][vTextTrailer]);
							
							PlayerTrailer[i] = -1;
							SetPVarInt(i,"dettachTrailer",0);
						}
					}
			    }
			}
		}
		if(GetPVarInt(i,"CountBackToBus") != 0) {
		    SetPVarInt(i,"CountBackToBus",GetPVarInt(i,"CountBackToBus") - 1);
		    format(string,sizeof(string),"%d",GetPVarInt(i,"CountBackToBus"));
    		GameTextForPlayer(i, string, 2000, 6);
		    if(GetPVarInt(i,"CountBackToBus") == 0) SetVehicleToRespawn(D::[i][dBusKey]);
		}
		if(GetPVarInt(i,"TimerCountFerm") != 0) {
		    SetPVarInt(i,"TimerCountFerm",GetPVarInt(i,"TimerCountFerm") - 1);
		    format(string,sizeof(string),"%d",GetPVarInt(i,"TimerCountFerm"));
    		GameTextForPlayer(i, string, 2000, 6);
    		if(GetPVarInt(i,"TimerCountFerm") == 0) {
				if(D::[i][dFermClassDuty] == 1) FermersOnline --;
				SendClientMessage(i, -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
    		    showPlayerDialog(i, 9999, 0, " ", "{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке", "Закрыть", "");
				D::[i][dFermClassDuty] = 0;
				if(GetPlayerVehicleID(i) >= fermcars[0] && GetPlayerVehicleID(i) <= fermcars[1]) removePlayerFromVehicle(i);
				GetBackSkin(i);
				DeletePVar(i,"CheckpointFermaPole");
				DeletePVar(i,"BackFermTransport");
    		}
		}
		if(GetPVarInt(i,"TimerCountWoods") != 0) {
		    SetPVarInt(i,"TimerCountWoods",GetPVarInt(i,"TimerCountWoods") - 1);
		    format(string,sizeof(string),"%d",GetPVarInt(i,"TimerCountWoods"));
    		GameTextForPlayer(i, string, 2000, 6);
    		if(GetPVarInt(i,"TimerCountWoods") == 0) {
    		    DeletePVar(i,"PlayerWoodsLimit");
    			SendClientMessage(i, -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
    		    showPlayerDialog(i, 9999, 0, " ", "{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке", "Закрыть", "");
				D::[i][dWoodsDuty] = 0;
				DeletePVar(i,"PlayerUseBox");
				DeletePVar(i,"PlayerStanok");
				GetBackSkin(i);
				RemovePlayerAttachedObject(i,9);
				RemovePlayerAttachedObject(i,8);
				SetPlayerSpecialAction(i, SPECIAL_ACTION_NONE);
    		}
		}
		if(IsPlayerInAnyVehicle(i)) {
		    new Float:hpcar,car = GetPlayerVehicleID(i);
	        GetVehicleHealth(GetPlayerVehicleID(i),hpcar);
			if(V::[GetPlayerVehicleID(i)][vHealth] < hpcar) {
			    if(GetPVarInt(i,"ACPlayerTuning") == 0 && GetPVarInt(i,"playerUsePaynSpray") == 0) SetVehicleHealth(GetPlayerVehicleID(i),V::[GetPlayerVehicleID(i)][vHealth]);
				if(GetPVarInt(i,"ACPlayerTuning") != 0) setVehicleHealth(GetPlayerVehicleID(i),1000.0);
				if(GetPVarInt(i,"playerUsePaynSpray") != 0 && GetPlayerState(i) == PLAYER_STATE_DRIVER) {
				    setVehicleHealth(GetPlayerVehicleID(i),1000.0);
					Player[i][uMoney] -= 100;
					format(string,sizeof(string),"UPDATE gb_users SET uMoney = '%d' WHERE BINARY uName = '%s'",Player[i][uMoney],Player[i][uName]);
					mysql_tquery(1, string, "", "");
					S::[0][sMeria][0] += S::[0][sMeria][1];
			        format(string,sizeof(string),"UPDATE gb_others SET sMeria0 = %d",S::[0][sMeria][0]);
					mysql_tquery(1, string, "", "");
				    SetPVarInt(i,"playerUsePaynSpray",0);
				}
			}
			else V::[GetPlayerVehicleID(i)][vHealth] = hpcar;
			if(car >= ataxils[0] && car <= ataxils[1]) {
				if(V::[car][vTaxiDriver] == i && D::[i][dTaxiKey] == car) {
                    if(D::[i][dArendTaxi] != 0) {
						D::[i][dArendTaxi] --;
						switch(D::[i][dArendTaxi]) {
							case 400: JobValueNow(i, 10, 350,Player[i][uJob]);
							case 800: JobValueNow(i, 10, 350,Player[i][uJob]);
							case 1200: JobValueNow(i, 10, 350,Player[i][uJob]);
							case 1600: JobValueNow(i, 10, 350,Player[i][uJob]);
							case 2000: JobValueNow(i, 10, 350,Player[i][uJob]);
							case 2400: JobValueNow(i, 10, 350,Player[i][uJob]);
							case 2800: JobValueNow(i, 10, 350,Player[i][uJob]);
							case 3200: JobValueNow(i, 10, 350,Player[i][uJob]);
							case 3600: JobValueNow(i, 10, 350,Player[i][uJob]);
							case 4000: JobValueNow(i, 10, 350,Player[i][uJob]);
							case 4400: JobValueNow(i, 10, 350,Player[i][uJob]);
							case 4800: JobValueNow(i, 10, 350,Player[i][uJob]);
							case 5200: JobValueNow(i, 10, 350,Player[i][uJob]);
							case 5600: JobValueNow(i, 10, 350,Player[i][uJob]);
						}
					}
                    else {
                        D::[i][dArendTaxi] = -1;
						SendClientMessage(i,C_GRAY,""gbInfo"Ваш контракт с таксопарком подошёл к концу, верните автомобиль на место!");
						SetPVarInt(i,"CountBackTaxi",MAX_COUNT_BACK_TAXI);
						SetPVarInt(i,"CheckpointBack",_:SetPlayerCheckpoint(i,1099.9902,-1242.7791,15.3823,5.0));
                    }
                }
			}
			if(car >= dalncars[0] && car <= dalncars[1]) {
				if(V::[car][vDalnDriver] == i && D::[i][dDalnKey] == car) {
                    if(D::[i][dArendDaln] != 0) D::[i][dArendDaln] --;
                    else {
                        D::[i][dArendDaln] = -1;
						SendClientMessage(i,C_GRAY,""gbInfo"Ваш контракт с транспортной компанией подошёл к концу, верните автомобиль на место!");
						SetPVarInt(i,"CountBackDaln",MAX_COUNT_BACK_DALN);
						SetPVarInt(i,"CheckpointBackDaln",_:SetPlayerCheckpoint(i,2209.2693,-2220.6868,14.1527,5.0));
                    }
                }
			}
    		new Float:ST[4], vehicleid;
    		vehicleid = GetPlayerVehicleID(i);
			GetVehicleVelocity(vehicleid,ST[0],ST[1],ST[2]);
			ST[3] = floatsqroot(floatpower(floatabs(ST[0]), 2.0) + floatpower(floatabs(ST[1]), 2.0) + floatpower(floatabs(ST[2]), 2.0)) * 179.28625;
			V::[vehicleid][vMile] += ST[3]/2000;
			format(string,sizeof(string),"%.1f km",V::[vehicleid][vMile]);
			PlayerTextDrawSetString(i,Speed[4][i],string);
		}
		else {
			if(GetPVarInt(i, "NarkEffect") <= 0) SetPlayerDrunkLevel(i, 0);
		}
		if(SpeedVehicle(GetPlayerVehicleID(i)) > 160) KickEx(i);
	}	
	
	for(new i; i != MAX_VEHICLES; i ++) {
		if(!IsValidVehicle(i)) continue;
		
		
    	new Float:hp;
    	GetVehicleHealth(i,hp);
    	GetVehicleParamsEx(i,eng,light,other1,other2,other3,other4,other5);
    	if(hp <= 400.0) {
    		setVehicleHealth(i,400.0);
    		SetVehicleParamsEx(i,false,light,other1,other2,other3,other4,other5);
    	}
    	if(GetVehicleModel(i) == 528 || GetVehicleModel(i) == 601) {
    		if(hp <= 950.0) setVehicleHealth(i,1000.0);
    	}
    	new value = floatround(V::[i][vMile]);
    	if(value == 50.0 * V::[i][vCountMile]) {

    	    if(V::[i][vBuyingCar] != -1) {
    	        new c = V::[i][vBuyingCar];
    	        if(Car::[c][cStatus][0] != 20) Car::[c][cStatus][0] -= 5;
				else {
					GetVehicleParamsEx(i,eng,light,other1,other2,other3,other4,other5);
					switch(random(10)) {
						case 0 .. 4: {}
						case 5 .. 9: SetVehicleParamsEx(i,false,light,other1,other2,other3,other4,other5);
					}
				}
    	    }
    		V::[i][vCountMile] ++;
    	}
    	if(V::[i][vBuyingCar] != -1 && V::[i][vBuyingCarDelete] == 1)
    	{
            V::[i][vBuyingCarTimer] --;
            if(V::[i][vBuyingCarTimer] <= 0)
            {
                new j = V::[i][vBuyingCar];
                Car::[j][cDostupCars] = 0;
                V::[Car::[j][cCar]][vBuyingCarDelete] = 0;
			    V::[Car::[j][cCar]][vBuyingCarTimer] = 0;
                V::[Car::[j][cCar]][vCountMile] = floatround(V::[Car::[j][cCar]][vMile] / 50.0);
   	 			V::[Car::[j][cCar]][vBuyingCar] = -1;
 	   			V::[Car::[j][cCar]][vGang] = -1;
 	   			if(V::[Car::[j][cCar]][vAction] == true)
 	   			{
 	   			    V::[Car::[j][cCar]][vAction] = false;
					V::[Car::[j][cCar]][vIDAction] = INVALID_PLAYER_ID;
					
					if (IsValidDynamic3DTextLabel(V::[Car::[j][cCar]][vTextAction]))
						DestroyDynamic3DTextLabel(V::[Car::[j][cCar]][vTextAction]);
 	   			}
 	   			switch(GetVehicleModel(Car::[j][cCar]))
 	   			{
 	   			    case 510, 509, 481: print("Нельзя удалить 3D текст которого нет!");
 	   			    default:
					{
					    if(IsValidDynamic3DTextLabel(Car::[j][cNumberLabel]))
						{
						    DestroyDynamic3DTextLabel(Car::[j][cNumberLabel]);
						}
					} 
 	   			}
				DestroyVehicle(Car::[j][cCar]);
            }
            
    	}
    	if(IsVelo(i))
		{
    		GetVehicleParamsEx(i,eng,light,other1,other2,other3,other4,other5);
    		SetVehicleParamsEx(i,true,light,other1,other2,other3,other4,other5);
    	}
    }
	for(new i; i != MAX_GATE; i ++) {
		if(gTime[i] + (10) < gettime() && gStatus[i] == true) {
		    switch(G::[i][gObject]) {
		        case 968: MoveDynamicObject(gID[i], G::[i][gP][0],G::[i][gP][1],G::[i][gP][2] - 0.05, 0.05, G::[i][gP][3],G::[i][gP][4],G::[i][gP][5]);
                case 19313: MoveDynamicObject(gID[i], G::[i][gP][0],G::[i][gP][1],G::[i][gP][2], 1.0, G::[i][gP][3],G::[i][gP][4],G::[i][gP][5]);
                case 19912: MoveDynamicObject(gID[i], G::[i][gP][0],G::[i][gP][1],G::[i][gP][2], 1.0, G::[i][gP][3],G::[i][gP][4],G::[i][gP][5]);
			}
		    gStatus[i] = false;
		}
	}
	if(PoleV >= 100 && PoleS >= 100) {
		if(PoleR < 900) {
			PoleR += 1;
			if(PoleR == 1) for(new i; i != MAX_OBJECTS_POTATO; i ++) PotatoObject[i] = CreateDynamicObject(761,Potato[i][0],Potato[i][1],Potato[i][2],0.0,0.0,0.0,-1,-1,-1,100.0);
			if(PoleR == 350) for(new i; i != MAX_OBJECTS_POTATO; i ++) DestroyDynamicObject(PotatoObject[i]),PotatoObject[i] = CreateDynamicObject(760,Potato[i][0],Potato[i][1],Potato[i][2],0.0,0.0,0.0,-1,-1,-1,100.0);
			if(PoleR >= 900) {
				KustInPole = 299;
				for(new i; i != MAX_OBJECTS_POTATO; i ++) DestroyDynamicObject(PotatoObject[i]), PotatoObject[i] = CreateDynamicObject(759,Potato[i][0],Potato[i][1],Potato[i][2],0.0,0.0,0.0,-1,-1,-1,100.0);
			}
		}
		else {
		    PoleV = 0;
		    PoleS = 0;
		    for(new i; i != GetMaxPlayers() + 1; i ++) {
		        if(!IsPlayerConnected(i)) continue;
				if(GetPVarInt(i,"uLogin") == 0) continue;
				if(IsKicked(i)) continue;
				if(D::[i][dFermClassDuty] != 0) SendClientMessage(i,C_GRAY,""gbInfo"Весь урожай на поле созрел, возьмите комбайн и соберите его.");
			}
		}
	}
    format(string,sizeof(string),"%02d:%02d",hour,minuts);
    TextDrawSetString(phoneOne[16],string);
    TextDrawSetString(phoneTwo[13],string);
    TextDrawSetString(phoneThree[5],string);
	return 1;
}


stock SetPlayerToFacePlayer(playerid, targetid) {
    new Float:pX, Float:pY, Float:pZ, Float:X, Float:Y, Float:Z,Float:ang;
    if(!IsPlayerConnected(playerid) || !IsPlayerConnected(targetid)) return 0;
    GetPlayerPos(targetid, X, Y, Z);
    GetPlayerPos(playerid, pX, pY, pZ);
    if( Y > pY ) ang = (-acos((X - pX) / floatsqroot((X - pX)*(X - pX) + (Y - pY)*(Y - pY))) - 90.0);
    else if( Y < pY && X < pX ) ang = (acos((X - pX) / floatsqroot((X - pX)*(X - pX) + (Y - pY)*(Y - pY))) - 450.0);
    else if( Y < pY ) ang = (acos((X - pX) / floatsqroot((X - pX)*(X - pX) + (Y - pY)*(Y - pY))) - 90.0);
    if(X > pX) ang = (floatabs(floatabs(ang) + 180.0));
    else ang = (floatabs(ang) - 180.0);
    SetPlayerFacingAngle(playerid, ang);
    return 0;
}

stock SuspectPlayer(playerid,text[],name[],value) {
	clear_massive();
	format( gb_string,sizeof( gb_string ),"%s объявил(-а) вас в розыск. Причина: %s.",name,text);
	SendClientMessage(playerid,C_LIGHTRED, gb_string);
	Player[playerid][uSuspect] += value;
	if(Player[playerid][uSuspect] >= 6) Player[playerid][uSuspect] = 6;
	SetPlayerWantedLevel(playerid,Player[playerid][uSuspect]);
	nowUpdateInfo(playerid , "d" , "gb_users" , "uName" , "uSuspect" , Player[playerid][uSuspect]);
	return 1;
}

nowUpdateInfo ( playerid , const type [ ] , db_table [ ] , db_name_field [ ] , field [ ] , {Float, _}:...) {
    static const STATIC_ARGS = 0x5 ;
	clear_massive();
    new g_szName [ MAX_PLAYER_NAME ] ;
    GetPlayerName ( playerid , g_szName , sizeof ( g_szName ) ) ;
    mysql_real_escape_string ( g_szName , g_szName ) ;
    for ( new i , x = numargs ( ) - STATIC_ARGS ; i != x ; i++ ) {
        switch ( type [ i ] ) {
            case 'i','d' : format ( query , sizeof query , "update `%s` set `%s`=%d where BINARY `%s`='%s' limit 1;" , db_table , field , getarg (i + STATIC_ARGS ) , db_name_field , g_szName );
            case 'f' : format ( query , sizeof query , "update `%s` set `%s`=%f where BINARY `%s`='%s' limit 1;" , db_table , field , Float:getarg ( i + STATIC_ARGS ) , db_name_field , g_szName );
            case 's' : {
                for ( new a ; getarg ( i + STATIC_ARGS , a ) != 0x0 ; a++) {
                    gb_string [ a ] = getarg ( i+STATIC_ARGS , a ) ;
                }
                format ( query , sizeof query , "update `%s` set `%s`='%s' where BINARY `%s`='%s' limit 1;" , db_table , field , gb_string , db_name_field , g_szName ) ;
            }
        }
    }
    return mysql_tquery ( mysql, query, "", "" ) ;
}

stock SpeedVehicle(vehicleid) {
    new Float:x, Float:y, Float:z;
    GetVehicleVelocity(vehicleid, x, y, z);
    return floatround(floatsqroot(x*x+y*y)*100);
}

stock MeAction( playerid, text[], type ) {
	//clear_massive();
	switch(type) {
	    case 0: {
			format( vb_string, sizeof vb_string, "%s %s", Player[playerid][uName], text );
			sendLongMessage( playerid, vb_string, 0xE75480FF, 0xE75480FF, 0xE75480FF, 0xE75480FF, 0xE75480FF);
        }
        case 1: {
            format( vb_string, sizeof vb_string,"%s", text );
			SetPlayerChatBubble( playerid, vb_string, 0xE75480FF, 15.0, 5000 );
        }
	}
	return 1;
}

stock DoAction(playerid,text[]) {
	clear_massive();
	format( gb_string, sizeof gb_string,"%s (( %s ))", text, Player[playerid][uName] );
    sendLongMessage( playerid, gb_string, 0xE75480FF, 0xE75480FF, 0xE75480FF, 0xE75480FF, 0xE75480FF );
	return 1;
}

stock TryAction(playerid,text[]) {
	new rand[50];
	switch(random(2)) {
	    case 0: rand = ""cGREEN"Удачно";
	    case 1: rand = ""cRED"Неудачно";
		default: rand = ""cRED"Неудачно";
	}
	format( gb_string, sizeof gb_string,"%s %s | %s", Player[playerid][uName], text, rand );
    ProxDetector( 20.0, playerid, gb_string, 0xE75480FF, 0xE75480FF, 0xE75480FF, 0xE75480FF, 0xE75480FF );
	return 1;
}

