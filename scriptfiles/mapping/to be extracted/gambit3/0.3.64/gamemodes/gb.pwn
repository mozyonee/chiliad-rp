	    SetPVarInt(playerid,"PlayerSelectTrailer",2);
	    if(ToplivoZavod == 0) warningtext = "~n~~n~~r~Внимание!~n~Нет топлива на заводе!";
	    format(string,sizeof(string),"~w~Маршрут:~n~~y~Топливный завод <> Ферма,Заправки~n~~n~~w~Описание:~n~~y~Выбрав этот прицеп, вы будете ~n~осуществлять перевозку топлива с ~n~топливного завода на ферму,~n~заправки и предприятия которые ~n~его используют.%s",warningtext);
     	PlayerTextDrawSetString(playerid,dalnmenuplayer[playerid],string);
	}
	if(clickedid == dalnmenu[5]) {
	    SetPVarInt(playerid,"PlayerSelectTrailer",3);
		if(S::[0][sFerm][0] == 0 && S::[0][sFerm][1] == 0 && S::[0][sFerm][2] == 0 && S::[0][sFerm][3] == 0) warningtext = "~n~~n~~r~Внимание!~n~Склад спуст!";
		format(string,sizeof(string),"~w~Маршрут:~n~~y~Ферма <> Склад~n~~n~~w~Описание:~n~~y~Выбрав данный прицеп,~n~вы будете осуществлять перевозку ~n~урожая с фермы на склад.%s",warningtext);
  		PlayerTextDrawSetString(playerid,dalnmenuplayer[playerid],string);
	}
	if(clickedid == dalnmenu[6]) {
	    SetPVarInt(playerid,"PlayerSelectTrailer",4);
	    if(S::[0][wsWoodsSklad] == 0) warningtext = "~n~~n~~r~Внимание!~n~Нет дерева на лесопилке!";
	    format(string,sizeof(string),"~w~Маршрут:~n~~y~Лесопилка <> Завод мебели~n~~n~~w~Описание:~n~~y~Выбрав этот прицеп, ~n~вы будете осуществлять перевозку ~n~дерева на завод мебели.%s",warningtext);
     	PlayerTextDrawSetString(playerid,dalnmenuplayer[playerid],string);
	}
	if(clickedid == dalnmenu[8]) {
	    if(IsTrailerAttachedToVehicle(D::[playerid][dDalnKey])) return SendClientMessage(playerid,C_GRAY,""gbError"К вашему тягачу уже подцеплен прицеп.");
	    if(D::[playerid][dDalnKey] == -1) return SendClientMessage(playerid,C_GRAY,""gbError"Вашего тягача нет рядом с местом загрузки.");
        if(GetVehicleModel(D::[playerid][dDalnKey]) == 403 || GetVehicleModel(D::[playerid][dDalnKey]) == 514 || GetVehicleModel(D::[playerid][dDalnKey]) == 515) {
			if(PlayerTrailer[playerid] != -1) return SendClientMessage(playerid,C_GRAY,""gbInfo"Вам в аренду уже выдали прицеп, подцепите его тягачом.");
	    	switch(GetPVarInt(playerid,"PlayerSelectTrailer")) {
	        	case 1: if(MebelZavod == 0) return SendClientMessage(playerid,C_GRAY,""gbError"На заводе мебели кончилась мебель.");
	        	case 2: if(ToplivoZavod == 0) return SendClientMessage(playerid,C_GRAY,""gbError"На заводе топлива кончилось топливо.");
	        	case 3: if(S::[0][sFerm][0] == 0 && S::[0][sFerm][1] == 0 && S::[0][sFerm][2] == 0 && S::[0][sFerm][3] == 0) return SendClientMessage(playerid,C_GRAY,""gbError"На ферме кончился урожай.");
	        	case 4: if(S::[0][wsWoodsSklad] == 0) return SendClientMessage(playerid,C_GRAY,""gbError"На лесопилке кончилось дерево.");
	        	default: return 0;
	    	}
			for(new i;i<10;i++)
			{
				if(gTruckLoadTurn[0][i] == INVALID_PLAYER_ID)
				{
					gTruckLoadTurn[0][i] = playerid;
					format(string,sizeof(string),"Вы номер %d в очереди на загрузку",i+1);
					SendClientMessage(playerid, -1, string);
					SetPVarInt(playerid,"truckonroad",0);
					SetPVarInt(playerid,"waitgruz",0);
					break;
				}
			}
		}
		else return SendClientMessage(playerid,C_GRAY,""gbError"Транспортное средство выданное вам должно быть рядом.");
	}
	if(clickedid == phoneOne[23] || clickedid == phoneTwo[11] || clickedid == phoneThree[10])  {
		if(Player[playerid][uNumber] == 0) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет сим-карты в вашем телефоне!");
		new str[128];
		string = "";
		for(new i; i != 10; i ++) {
			if(Player[playerid][uContacts][i] != 0) {
				format(str,sizeof(str),"%i. "cGRAY"%s Номер: %d\n",i + 1,phoneName[playerid][i],Player[playerid][uContacts][i]);
				strcat(string,str);
			}
			else strcat(string,"{d3d3d3}- Пусто\n");
		}
		showPlayerDialog(playerid,d_phone + 2,2,"Контакты",string,"Дальше","Закрыть");
	}
	if(clickedid == phoneOne[24] || clickedid == phoneTwo[9] || clickedid == phoneThree[9]) {
		format(string,sizeof(string),"{ffffff}1. "cGRAY"Показывать объявления - %s\n{ffffff}2. "cGRAY" Показывать радио-эфиры - %s\n{ffffff}3. "cGRAY" Радио - %s",Player[playerid][uSettings][4] ? (""cGREEN"Да") : (""cRED"Нет"), Player[playerid][uEther] ? (""cGREEN"Да") : (""cRED"Нет"), Player[playerid][uRadio] ? (""cGREEN"Да") : (""cRED"Нет"));
		showPlayerDialog(playerid,d_phone + 14,2,"Настройки",string,"Дальше","Закрыть");
	}
	if(clickedid == phoneOne[25] || clickedid == phoneTwo[10] || clickedid == phoneThree[12]) {
		if(Player[playerid][uNumber] == 0) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет сим-карты в вашем телефоне!");
		showPlayerDialog(playerid,d_phone + 6,2,"Сообщения","1. "cGRAY"Входящие сообщения{ffffff}\n2. "cGRAY"Исходящие сообщения{ffffff}\n3. "cGRAY"Отправить сообщение","Дальше","Закрыть");
	}
	if(clickedid == phoneOne[26] || clickedid == phoneTwo[8] || clickedid == phoneThree[11]) {
		if(Player[playerid][uNumber] == 0) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет сим-карты в вашем телефоне!");
		showPlayerDialog(playerid,d_phone,2,"Набрать номер","1. "cGRAY"Набрать новый номер{ffffff}\n2. "cGRAY"Номера сервисных служб\n{ffffff}3. "cGRAY"Телефонная книга","Дальше","Закрыть");
	}
	if(clickedid == phoneOne[27] || clickedid == phoneTwo[12] || clickedid == phoneThree[17]) hidePhone(playerid);
	
	
   	
	return 1;
}


public OnPlayerText(playerid,text[]) {
	clear_massive();
	if(GetPVarInt(playerid,"uLogin") == 0) return 0;
	if(Player[playerid][uMute] != 0) {
		SendClientMessage(playerid,C_GRAY,""gbError"Простите, но вам запрещено писать что-то!");
		return 0;
	}
	if(GetPVarInt(playerid,"Spectrate") != 0) {
		SendClientMessage(playerid,C_GRAY,"Агент 007, вы на спец. задании! Вам нельзя разговаривать!");
		return 0;
	}
	if(GetPVarInt(playerid,"playerAdmin") == 1)
	{

		if(GetPVarInt(playerid,"Animation") == 0)
		{
			if(Player[playerid][uSettings][7] == 0) ApplyAnimation(playerid,"ped",Talk[Player[playerid][uSettings][7]],4.1,1,1,1,1,1,1);
			else if(Player[playerid][uSettings][7] != 0) ApplyAnimation(playerid,"GANGS",Talk[Player[playerid][uSettings][7]],4.1,1,1,1,1,1,1);
		}
		if(GetPVarInt(playerid,"Animation") == 0) SetTimerEx("ClearAnimationsDelay",strlen(text)*200+1000,false,"i",playerid);
		format(gb_string, sizeof gb_string, "(( %s(%d): %s ))", Player[playerid][uName], playerid, text);
		sendLongMessage(playerid, gb_string, COLOR_FADE1, COLOR_FADE2, COLOR_FADE3, COLOR_FADE4, COLOR_FADE5);
		return 0;
	}
	if(Player[playerid][uJailSettings][2] != 0 || Player[playerid][uJailSettings][4] != 0)
	{
		SendClientMessage(playerid,C_GRAY,""gbError"Вы не в состоянии говорить что-то!");
		return 0;
	}

	if(newsClientEther == playerid && D::[playerid][dPhone] == true) {
		format( gb_string, sizeof gb_string,"[ CNN Эфир ] %s ( тел. ): %s",Player[playerid][uName],text);
		foreach(new i : Player) {
			if(IsPlayerInAnyVehicle(i)) SendClientMessage(i,0x42E73AAA, gb_string);
			else {
				if(Player[i][uSettings][4] == 1) SendClientMessage(i,0x42E73AAA, gb_string);
			}
		}
		format( gb_string,sizeof gb_string,"(Телефон) %s(%d) говорит: %s",Player[playerid][uName],playerid,text);
		ProxDetector(20.0, playerid, gb_string,COLOR_FADE1,COLOR_FADE2,COLOR_FADE3,COLOR_FADE4,COLOR_FADE5);
		return 0;
	}
	if(GetPVarInt(playerid,"phoneCaller") != INVALID_PLAYER_ID && GetPVarInt(playerid,"phoneCalled") != INVALID_PLAYER_ID && D::[playerid][dPhone] == true) {
		new id;
		if(GetPVarInt(playerid,"phoneCaller") == playerid) id = GetPVarInt(playerid,"phoneCalled");
		else if(GetPVarInt(playerid,"phoneCalled") == playerid) id = GetPVarInt(playerid,"phoneCaller");
		format( gb_string,sizeof gb_string,"(Телефон) %s(%d) говорит: %s",Player[playerid][uName],playerid,text);
		ProxDetector(20.0, playerid, gb_string,COLOR_FADE1,COLOR_FADE2,COLOR_FADE3,COLOR_FADE4,COLOR_FADE5);
		if(D::[id][dPhone] == true) {
			format( gb_string,sizeof gb_string,"(Телефон) %s(%d): %s",Player[playerid][uName],playerid,text);
			SendClientMessage( id, 0xFFFFFFAA, gb_string);
		}
		return 0;
	}
	format( gb_string, sizeof gb_string, "%s(%d) говорит: %s", Player[playerid][uName], playerid, text);
	SetPlayerChatBubble(playerid,text,0xFFFFFFFF,15.0,5000);
	sendLongMessage(playerid, gb_string, COLOR_FADE1, COLOR_FADE2, COLOR_FADE3, COLOR_FADE4, COLOR_FADE5);
	return 0;
}

public OnPlayerShootDynamicObject(playerid, weaponid, objectid, Float:x, Float:y, Float:z)
{
	gAmmos[playerid][GetWeaponSlot(weaponid)]--;
	if(gAmmos[playerid][GetWeaponSlot(weaponid)] <= 0 && playerid != 0){
        SendClientMessage(playerid, 0xFF6347AA, "[AC]: Вы были кикнуты за подозрения в читерстве [#0019]");
        KickEx(playerid);
        return false;
    }
	
    if(Inv[playerid][invSlot][50] != 0) {
        if(GetPlayerWeapon(playerid) == GetWeaponToObject(_itemsInfo[Inv[playerid][invSlot][50]][invObject])) {
        	if(GetPlayerAmmo(playerid) - (1) != -1)
			{
			    new ammo = GetPlayerAmmo(playerid) - 1;
				Inv[playerid][invSlotKol][50] = ammo;
			}
        }
	}
	if(Inv[playerid][invSlot][51] != 0) {
        if(GetPlayerWeapon(playerid) == GetWeaponToObject(_itemsInfo[Inv[playerid][invSlot][51]][invObject])) {
        	if(GetPlayerAmmo(playerid) - (1) != -1)
			{
				new ammo = GetPlayerAmmo(playerid) - 1;
				Inv[playerid][invSlotKol][51] = ammo;
			}
        }
	}
	return 1;
}

public OnPlayerWeaponShot(playerid, weaponid, hittype, hitid, Float:fX, Float:fY, Float:fZ)
{
	gAmmos[playerid][GetWeaponSlot(weaponid)]--;
	if(gAmmos[playerid][GetWeaponSlot(weaponid)] +1  <= 0 && playerid != 0){
        SendClientMessage(playerid, 0xFF6347AA, "[AC]: Вы были кикнуты за подозрения в читерстве [#0019]");
		KickEx(playerid);
        return false;
    }
    //if(weaponid == 23 && )
    if(Inv[playerid][invSlot][50] != 0) {
        if(GetPlayerWeapon(playerid) == GetWeaponToObject(_itemsInfo[Inv[playerid][invSlot][50]][invObject])) {
        	if(GetPlayerAmmo(playerid) - (1) != -1)
			{
			    new ammo = GetPlayerAmmo(playerid) - 1;
				Inv[playerid][invSlotKol][50] = ammo;
			}
        }
	}
	if(Inv[playerid][invSlot][51] != 0) {
        if(GetPlayerWeapon(playerid) == GetWeaponToObject(_itemsInfo[Inv[playerid][invSlot][51]][invObject])) {
        	if(GetPlayerAmmo(playerid) - (1) != -1)
			{
				new ammo = GetPlayerAmmo(playerid) - 1;
				Inv[playerid][invSlotKol][51] = ammo;
			}
        }
	}
	return 1;
    
}

public OnPlayerPressButton(playerid,buttonid) {
	if(buttonid == gDoorsButton[0] || buttonid == gDoorsButton[1]) {
		if(Player[playerid][uMember] != 2) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет ключа для открытия данной двери!");
		MoveDynamicObject(gDoors[0], 1552.25488, -1671.65527, 1099.50562, 1.0,0.00000, 0.00000, 0.00000);
		SetTimerEx("CloseDoors",10000,false,"i",0);
	}
	if(buttonid == gDoorsButton[2] || buttonid == gDoorsButton[3]) {
		if(Player[playerid][uMember] != 2) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет ключа для открытия данной двери!");
		MoveDynamicObject(gDoors[1], 1552.23499, -1682.53528, 1099.50562, 1.0,0.00000, 0.00000, 0.00000);
		SetTimerEx("CloseDoors",10000,false,"i",1);
	}
	if(buttonid == gDoorsButton[4] || buttonid == gDoorsButton[5]) {
		if(Player[playerid][uMember] != 2) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет ключа для открытия данной двери!");
		MoveDynamicObject(gDoors[2], 1552.85889, -1686.27502, 1098.23999, 1.0, 0.00000, 0.00000, 90.00000);
		SetTimerEx("CloseDoors",10000,false,"i",2);
	}
	if(buttonid == gDoorsButton[8] || buttonid == gDoorsButton[9]) {
		if(Player[playerid][uMember] != 2) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет ключа для открытия данной двери!");
		MoveDynamicObject(gDoors[4], 1577.08997, -1686.29504, 1098.23999, 1.0, 0.00000, 0.00000, 90.00000);
		SetTimerEx("CloseDoors",10000,false,"i",4);
	}
	if(buttonid == gDoorsButton[6] || buttonid == gDoorsButton[7]) {
		if(Player[playerid][uMember] != 8) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет ключа для открытия данной двери!");
		MoveDynamicObject(gDoors[3], 244.2880,72.5611,1002.6413,1.0,0.0,0.0,0.0);
		SetTimerEx("CloseDoors",10000,false,"i",3);
	}
	return 1;
}

