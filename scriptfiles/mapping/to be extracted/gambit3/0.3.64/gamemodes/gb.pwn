stock SetBizzInt(idx, stolb[], znach) {
	new Query[128];
	format(Query, sizeof(Query), "UPDATE gb_business SET %s = '%d' WHERE bID = '%d'", stolb, znach, idx);
	return mysql_tquery(1, Query, "", "");
}
stock SetBizzStr(idx, stolb[], znach[]) {
	new Query[128];
	format(Query, sizeof(Query), "UPDATE gb_business SET  %s = '%s' WHERE bID = '%d'", stolb, znach, idx);
	return mysql_tquery(1, Query, "", "");
}


stock SetCarStr(idx, stolb[], znach[]) {
	new Query[128];
	format(Query, sizeof(Query), "UPDATE gb_cars SET  %s = '%s' WHERE cID = '%d'", stolb, znach, idx);
	return mysql_tquery(1, Query, "", "");

}
stock SetCarInt(idx, stolb[], znach) {
	new Query[128];
	format(Query, sizeof(Query), "UPDATE gb_cars SET  %s = '%d' WHERE cID = '%d'", stolb, znach, idx);
	return mysql_tquery(1, Query, "", "");

}

