stock giveRegisterSkin(playerid) {
	switch(Player[playerid][uRole])
	{
	    case 2:
		{
			switch(Player[playerid][uSex]) {
			    case 1: {
			        switch(Player[playerid][uColor]) {
			            case 1: giveThreeSkin(playerid,79,134,136);
			            case 2: giveThreeSkin(playerid,200,212,213);
			        }
			    }
			    case 2: {
			    	switch(Player[playerid][uColor]) {
			            case 1: giveOneSkin(playerid,218);
			            case 2: giveTwoSkin(playerid,77,151);
			        }
			    }
			}
		}
		default: {
			switch(Player[playerid][uSex]) {
			    case 1: {
			        switch(Player[playerid][uColor]) {
			            case 1: giveThreeSkin(playerid,7,20,36);
			            case 2: giveThreeSkin(playerid,2,3,23);
			        }
			    }
			    case 2: {
			    	switch(Player[playerid][uColor]) {
			            case 1: giveThreeSkin(playerid,69,93,215);
			            case 2: giveTwoSkin(playerid,41,69);
			        }
			    }
			}
		}
	}
}

stock giveOneSkin(playerid,id) {
    Inv[playerid][invSlot][52] = id,Inv[playerid][invSlotKol][52] = 1;
}

stock giveTwoSkin(playerid,one,two) {
	switch(random(2)) {
	    case 0: Inv[playerid][invSlot][52] = one,Inv[playerid][invSlotKol][52] = 1;
	    case 1: Inv[playerid][invSlot][52] = two,Inv[playerid][invSlotKol][52] = 1;
	}
}

stock giveThreeSkin(playerid,one,two,three) {
	switch(random(3)) {
		case 0: Inv[playerid][invSlot][52] = one,Inv[playerid][invSlotKol][52] = 1;
	    case 1: Inv[playerid][invSlot][52] = two,Inv[playerid][invSlotKol][52] = 1;
	    case 2: Inv[playerid][invSlot][52] = three,Inv[playerid][invSlotKol][52] = 1;
	}
}

