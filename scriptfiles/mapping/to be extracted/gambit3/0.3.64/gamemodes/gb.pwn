			Player[playerid][uMoney] -= Dealer::[0][dGunPrice][GetPVarInt(playerid,"playerSelectBuyingSlot")];
			Dealer::[0][dGunValue][GetPVarInt(playerid,"playerSelectBuyingSlot")] --;
