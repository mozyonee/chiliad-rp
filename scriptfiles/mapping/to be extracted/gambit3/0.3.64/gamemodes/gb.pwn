				Car::[j][cModel] = cache_get_field_content_int(j, "cModel");
				cache_get_field_content(j, "cOwner", CarOwner, mysql);
				Car::[j][cStatus] = cache_get_field_content_int(j, "cStatus");
				cache_get_field_content(j, "cLastTeh", CarLastTeh);
				cache_get_field_content(j, "cPosition", data, mysql), sscanf(data,"p<|>a<f>[4]",Car::[j][cPos]);
				cache_get_field_content(j, "cSettings", data, mysql), sscanf(data,"p<|>a<d>[7]",Car::[j][cSettings]);
				cache_get_field_content(j, "cTunning", data, mysql), sscanf(data,"p<|>a<d>[18]",Car::[j][cTunning]);
				cache_get_field_content(j, "cFloating", data, mysql), sscanf(data,"p<|>a<f>[3]",Car::[j][cFloating]);
				cache_get_field_content(j, "cDamage", data, mysql), sscanf(data,"p<|>a<d>[4]",Car::[j][cDamage]);
				cache_get_field_content(j, "cInvSlots", data, mysql), sscanf(data,"p<|>a<d>[18]",Car::[j][cInvSlot]);
				cache_get_field_content(j, "cInvSlotsKol", data, mysql), sscanf(data,"p<|>a<d>[18]",Car::[j][cInvSlotKol]);
				cache_get_field_content(j, "cNumber", CarNubmer);
				Car::[j][cWanted] = cache_get_field_content_int(j, "cWanted");
				
				
				Car::[j][cUgon] = 0;
				strmid(Car::[j][cOwner], CarOwner, 0, strlen(CarOwner), 255);
				strmid(Car::[j][cLastTeh], CarLastTeh, 0, strlen(CarLastTeh), 255);
				strmid(Car::[j][cNumber], CarNubmer, 0, strlen(CarNubmer), 255);
			}
			printf("[LOADING MODE] Cars Loading Done..");
	    }
		case 7:
		{

		    for(new j; j != Rows; j++)
	        {
	            Fields = cache_get_field_count(mysql);

			    f_mysql_fetch_row_format(j, query, Fields);
			    sscanf(query,"p<|>is[32]s[25]s[32]s[32]s[32]s[32]s[32]s[32]s[32]s[32]s[32]s[32]s[32]s[32]s[32]s[32]s[32]a<i>[15]a<i>[6]a<i>[7]",
		        F::[j][fID],F::[j][fName],F::[j][fLeader],
		        FRank[j][0],FRank[j][1],FRank[j][2],FRank[j][3],FRank[j][4],
		        FRank[j][5],FRank[j][6],FRank[j][7],FRank[j][8],FRank[j][9],
		        FRank[j][10],FRank[j][11],FRank[j][12],FRank[j][13],FRank[j][14],F::[j][fSkins],F::[j][fGuns],F::[j][fRank]);
		        //fRank[5]
			}
			printf("[LOADING MODE] Frac Loading Done..");
		}
		case 11:
		{
 			if(!Rows) showPlayerDialog(playerid,9999,1,"Регистрация",regtext,"Дальше","Выход");
			else showPlayerDialog(playerid,d_auth + 1,3,"Авторизация",logtext,"Дальше","Выход");
		}
		case 13:
		{
		    if(!Rows) return SendClientMessage(playerid,C_GRAY,""gbError"Во входящих сообщениях ничего нет.");
			else {
				new status,title[15],number,namel[MAX_PLAYER_NAME];
				string = "";
				Fields = cache_get_field_count(mysql);
				for(new cMessage; cMessage != Rows; cMessage++)
				{
			    	f_mysql_fetch_row_format(cMessage, query, Fields);
					sscanf(query,"p<|>is[128]is[25]",status,str,number,namel);
					strmid(title,str,0,15,128);
					format(str,sizeof(str),"\n%s%s ... | От "cBLUE"%d(%s)",(status==0)?("{ffffff}"):("{d3d3d3}"),title,number,namel);
					strcat(string,str);
				}
				showPlayerDialog(playerid,d_phone + 8,2,"Входящие",string,"Дальше","Закрыть");
			}
			
		}
		case 16:
		{
		    if(!Rows) return SendClientMessage(playerid,C_GRAY,""gbError"Произошла ошибка! Обратитесь к Администрации.");
			else {
			    new id = GetPVarInt(playerid,"phoneSelectMessage");
			    Fields = cache_get_field_count(mysql);
			    new dates[32],status,text[128],number,name[MAX_PLAYER_NAME];
				for(new cMessage; cMessage != Rows; cMessage++)
				{
					f_mysql_fetch_row_format(cMessage, query, Fields);
				    sscanf(query,"p<|>s[32]is[128]is[25]",dates,status,text,number,name);
				    if(status == 0) {
						format(string,sizeof(string),"UPDATE gb_messages SET mRead = 1 WHERE mID = '%d' LIMIT 1", id);
      					mysql_tquery(1, string, "", "");
					}
					format(string,sizeof(string),"{ffffff}От | "cBLUE"%d(%s)\n\n{ffffff}%s\n\nДата | "cBLUE"%s",number,name,text,dates);
					showPlayerDialog(playerid,9999,0," ",string,"Закрыть","");
				}

			}
		}
		case 14:
		{
			if(!Rows) return SendClientMessage(playerid,C_GRAY,""gbError"В исходящих сообщениях ничего нет.");
			else {
				new status,title[15],number,namel[MAX_PLAYER_NAME];
				string = "";
				Fields = cache_get_field_count(mysql);
				for(new cMessage; cMessage != Rows; cMessage++)
				{
                	f_mysql_fetch_row_format(cMessage, query, Fields);
					sscanf(query,"p<|>is[128]is[25]",status,str,number,namel);
					strmid(title,str,0,15,128);
					format(str,sizeof(str),"\n%s%s ... | Кому "cBLUE"%d(%s)",(status==0)?("{ffffff}"):("{d3d3d3}"),title,number,namel);
					strcat(string,str);
				}
				showPlayerDialog(playerid,9999,2,"Исходящие",string,"Дальше","Закрыть");
			}
			
		}
		case 18:
		{

            if(!Rows) SendClientMessage(playerid,-1,"Ошибка №1");
			else
			{
				new namel[MAX_PLAYER_NAME],rank;
				vb_string = "";
				for(new cMembers; cMembers != Rows; cMembers++)
				{
                	rank = cache_get_field_content_int(cMembers, "uRank");
					cache_get_field_content(cMembers, "uName", data, mysql), sscanf(data,"s[32]",namel);
					format(str,sizeof(str),"{ffffff}%i. {d3d3d3}%s - %s\n",cMembers + 1,namel,FRank[Player[playerid][uMember]][rank - 1]);
					strcat( vb_string,str);
					if(cMembers == 9) {
						SetPVarInt(playerid,"pageFrac",0);
						strcat(vb_string,"Далее >>");
					}
				}
				showPlayerDialog(playerid,d_frac + 12,2," ",vb_string,"Дальше","Закрыть");
			}
		}
		case 20:
		{
		   	new namel[MAX_PLAYER_NAME],rank;
		    if(!Rows) SendClientMessage(playerid,-1,"Ошибка №1");
			else {
    			for(new cMembers; cMembers != Rows; cMembers++) {
                	rank = cache_get_field_content_int(cMembers, "uRank");
					cache_get_field_content(cMembers, "uName", data, mysql), sscanf(data,"s[32]",namel);
					format( gb_string, sizeof( gb_string ),"{ffffff}%i. {d3d3d3}%s - %s\n",cMembers + 1,namel,FRank[Player[playerid][uMember]][rank - 1]);
					strcat( vb_string, gb_string );
					if(cMembers == 9) {
						strcat( vb_string,"Далее >>");
					}
				}
				showPlayerDialog(playerid,d_frac + 12,2," ", vb_string,"Дальше","Закрыть");
			}
		}
		case 30:
		{
		    new result = GetPVarInt(playerid, "InfoForBan");
			if(!Rows) return SendClientMessage(result,C_GRAY,""gbError"Простите, но данный аккаунт не был найден в БД!");
			format(string,sizeof(string),"DELETE FROM gb_bans WHERE name = '%s'",Player[playerid][uName]);
			mysql_tquery(1, string, "", "");
			SendClientMessage(result,C_GRAY,""gbAccess"Вы успешно разбанили данный аккаунт!");
			DeletePVar(playerid, "InfoForBan");
		}
		case 31:
		{
		    if(Rows) {
		        Player[playerid][uID] = cache_get_field_content_int(0, "uID");
		        return Player[playerid][uID];
		    }
		}
		case 32:
		{
		    new id;
		    if(Rows) id = cache_get_field_content_int(0, "uID");
			return id;
		}
		case 33:
		{
		    if(Rows) {
		        new money = cache_get_field_content_int(0, "Money");
		        new id = cache_get_field_content_int(0, "BizzID");
		        SendClientMessage(playerid,C_GRAY,""gbInfo"Оповещаем Вас о том, что ваш бизнес был продан!");
		        Player[playerid][uMoney] += money;

				format(string, sizeof(string), ""gbAccess"Вам возвращено %d$ с вашего бизнеса", money);
				SendClientMessage(playerid,C_GRAY,string);

				format(string,sizeof(string),"DELETE FROM gb_business_money WHERE BINARY Name = '%s'", Player[playerid][uName]);
				mysql_tquery(1, string, "", "");

				mysql_format(1, string, sizeof(string),"UPDATE gb_users SET uMoney = '%d' WHERE BINARY uName = '%s'",Player[playerid][uMoney],Player[playerid][uName]);
				mysql_tquery(1, string, "", "");

				for(new i; i != MAX_SLOTS; i ++) {
					switch(Inv[playerid][invSlot][i]) {
						case 377,410 .. 413,421 .. 425: {
							if(Inv[playerid][invSlotKol][i] == id) {
								Inv[playerid][invSlot][i] = 0;
                        		Inv[playerid][invSlotKol][i] = 0;
							}
						}
					}
				}

		    }
		    else return 1;
		}
		case 35:
		{
  			if(!Rows)
  			{
  			    new NewName[MAX_PLAYER_NAME];
		    	GetPVarString(playerid, "NewNickName", NewName, sizeof(NewName));
	    		format(string, sizeof(string), ""gbInfo"Вы указали новое имя: %s\n"gbAccess"Вы уверенны, что хотите поменять имя ?", NewName);
		    	showPlayerDialog(playerid,d_donate+3,0," ",string,"Да","Закрыть");
		    }
		    else
		    {
		        DeletePVar(playerid, "NewNickName");
                SendClientMessage(playerid,C_GRAY,""gbError"Данное имя уже где-то используется!");
				return 1;
		    }
		}
		case 8: {
            Fields = cache_get_field_count(mysql);
			f_mysql_fetch_row_format(0, query, Fields);
		    sscanf(query,"p<|>iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiia<i>[13]i",S::[0][sFerm][0],S::[0][sFerm][1],S::[0][sFerm][2],S::[0][sFerm][3],S::[0][sFerm][4],S::[0][sFerm][5],S::[0][sFerm][6],S::[0][sProducts],
			MebelZavod,ToplivoZavod,WoodsZavod,S::[0][wsWoods],S::[0][wsWoodsSklad],adminsPanel[0],adminsPanel[1],adminsPanel[2],adminsPanel[3],adminsPanel[4],adminsPanel[5],
			S::[0][sMeria][0],S::[0][sMeria][1],S::[0][sMeria][2],S::[0][sMeria][3],S::[0][sMeria][4],S::[0][sMeria][5],S::[0][sMeria][6],S::[0][sMeria][7],S::[0][sMeria][8],S::[0][sMeria][9],
			S::[0][sHouses],S::[0][sBusiness],adminsPanel[6],adminsPanel[7],adminsPanel[8],adminsPanel[9],adminsPanel[10],adminsPanel[11],S::[0][sNalog],adminsPanel[12]);
			printf( "[SYSTEM] Зарплаты загружены" );
		}	
	}
	return 1;
}

stock f_mysql_fetch_row_format(row, destination[], fields, max_len = sizeof(destination)) {
	clear_massive();
    strdel(destination, 0, max_len);
    for(new f=0; f < fields; f++) {
        if(f != 0)strcat(destination, "|", max_len);
        cache_get_row(row, f, gb_string, mysql);
        if(!f)strins(destination, gb_string, 0, max_len);
        else strcat(destination, gb_string, max_len);
    }
    return true;
}

publics: PhoneMessageOne(playerid, listitem) {
    new Rows, Fields;
    cache_get_data(Rows, Fields);
    if(!Rows) return SendClientMessage(playerid,C_GRAY,""gbError"Не удалось прочитать сообщение, неполадки в SA-Telecome.");
	else {
		for(new cMessage; cMessage != Rows; cMessage++) {
			if(cMessage == listitem) {
			    new id = cache_get_field_content_int(cMessage, "mID");
			    SetPVarInt(playerid,"phoneSelectMessage", id);
				break;
			}
		}
		showPlayerDialog(playerid,d_phone + 9,2," ","1. "cGRAY"Прочитать сообщение{ffffff}\n2. "cGRAY"Удалить сообщение","Дальше","Закрыть");
	}
	return 1;
}

publics: ListForFrac(playerid, listitem) {
	clear_massive();
    new Rows, Fields;
    cache_get_data(Rows, Fields);
    new name[MAX_PLAYER_NAME], rank;
	if(Rows) {
		for(new cMembers; cMembers != Rows; cMembers++) {
			if(cMembers == listitem) {
				rank = cache_get_field_content_int(cMembers, "uRank");
				cache_get_field_content(cMembers, "uName", gb_string, mysql), sscanf(gb_string,"s[32]",name);
				SetPVarInt(playerid,"playerSelectFracID", cache_get_field_content_int(cMembers, "uID"));
				format( gb_string,sizeof(gb_string),"%s - %s",name,FRank[Player[playerid][uMember]][rank - 1]);
				showPlayerDialog(playerid,d_frac + 13,2, gb_string,"1. "cGRAY"Уволить человека из организации","Дальше","Закрыть");
				break;
			}
		}
	}
	return 1;
}
forward MySQLSMS(playerid, strs[]);
public MySQLSMS(playerid, strs[])
{
    new Rows, Fields;
    cache_get_data(Rows, Fields);
	new result[64];
    if(!Rows) return SendClientMessage(playerid,C_GRAY,""gbError"Простите, но данный номер не найден в SA-Telecome.");
	else {
		SetPVarString(playerid,"phoneSMSName",result);
		SetPVarInt(playerid,"phoneSMSUser",strval(strs));
		showPlayerDialog(playerid,d_phone + 11,1," ","{ffffff}Введите текст СМС сообщения:\n\n"cRED"| Текст должен состоять только из букв и цифр.\n| Длинна текста не должна привышать 120 символов","Дальше","Закрыть");
	}
	return 1;
}

forward SupportSellect(playerid, strs[]);
public SupportSellect(playerid, strs[])
{
    new Rows, Fields;
    cache_get_data(Rows, Fields);
    if(Rows)
	{
       	SetPVarInt(playerid,"SelectSupport",strval(strs));
       	new supportstatus;
 		supportstatus = cache_get_field_content_int(0, "uSupport", mysql);
       	SetPVarInt(playerid,"SupportCurent", supportstatus);
       	showPlayerDialog(playerid,d_admins + 12,2," ","1. "cGRAY"Назначить/Снять Support","Дальше","Закрыть");
	}
   	else SendClientMessage(playerid,C_GRAY,""gbError"Данный ID не был найден в базе данных!");
	return 1;
}

stock GetPlayerID(Name[])
{
	foreach(new i : Player)
	{
		if(!strcmp(Name, Player[i][uName])) return i;
	}
	return -1;
}
forward LoadCarsZ(i, playerid);
public LoadCarsZ(i, playerid)
{
	Car::[i][cID] = cache_insert_id();
	SendClientMessage(playerid,C_GRAY,""gbAccess"Поздравляем с покупкой нового автомобиля!");
	SendClientMessage(playerid,C_GRAY,""gbInfo"Покрасить автомобиль вы можете в одном из СТО");
	GivePlayerItem(playerid, 375, Car::[i][cID]);
	DeletePVar(playerid,"salonPriceCar");
	DeletePVar(playerid,"salonModelCar");
	DeletePVar(playerid,"salonProdCar");
	DeletePVar(playerid,"BuyCarsZZ");
	return 1;
}

publics: MailSendPlayer( playerid, str[] ) {
	clear_massive();
    new Rows, Fields;
    cache_get_data(Rows, Fields);
    if(!Rows) {
	    new email[64],password[64];
     	GetPVarString(playerid, "playerInputEmail", email, sizeof(email));
     	GetPVarString(playerid, "passwordInput", password, sizeof(password));
      	new ipStr[16];
 	    GetPlayerIp( playerid, ipStr, 16 );
 	    mysql_format( mysql, query,sizeof(query),"INSERT INTO gb_users (uName,uPass,uLastIP,uRegDate,uEmail,uLevel) VALUE ('%s',md5(md5('%s')),'%s',%d,'%s','0')",Player[playerid][uName],password,ipStr,gettime(),email);
 	    mysql_tquery( mysql, query, "", "");
 	    
 	    showPlayerDialog(playerid,d_auth + 10,1,"Реферальная система","Укажите ник игрока, который пригласил Вас на проект\n"gbInfo"Данный игрок после выполнения ваших заданий\nполучит маленький подарок\n\n"gbError"Если не хотите указывать ник нажмите, Пропустить","Дальше","Пропустить");
	}
    else {
		SendClientMessage(playerid,C_GRAY,""gbError"Простите, но данный E-Mail адрес уже используется!");
	   	return showPlayerDialog(playerid,d_auth + 2,1,"Регистрация","{ffffff}Укажите ваш действительный E-Mail адрес:\n\n"cGRAY"| В случае утери доступа над аккаунтом, Вы сможете восстановить его по E-Mail.","Дальше","Выход");
	}
	return 1;
}

forward BackupClear(playerid, calledbytimer);
public BackupClear(playerid, calledbytimer)
{
	if(IsPlayerConnected(playerid))
	{
		if(Player[playerid][uMember] == 8 || Player[playerid][uMember] == 1 || Player[playerid][uMember] == 2 || Player[playerid][uMember] == 5)
		{
   			if(GetPVarInt(playerid, "BKONFORPLAYER") == 1)
			{
				foreach(new i: Player) if(Player[i][uMember] == 1 || Player[i][uMember] == 2 || Player[i][uMember] == 5) SetPlayerMarkerForPlayer(i, playerid, FracColor[Player[playerid][uMember]]);
				if(calledbytimer != 1) SendClientMessage(playerid, -1, ""gbAccess"Ваш запрос о поддержке был отменён");
				else SendClientMessage(playerid, -1, ""gbAccess"Ваш запрос о поддержке автоматически отменён");
				SetPVarInt(playerid, "BKONFORPLAYER", 0);
			}
			else if(calledbytimer != 1) SendClientMessage(playerid, -1, ""gbError"Вы не запрашивали поддержку!");
		}
		else if(calledbytimer != 1) SendClientMessage(playerid, -1, ""gbError"Вы не состоите в полиции!");
	}
	return 1;
}

