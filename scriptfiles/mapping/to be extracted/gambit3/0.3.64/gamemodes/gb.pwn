//	vehPos[vehicleid][0] = X;
//	vehPos[vehicleid][1] = Y;
//	vehPos[vehicleid][2] = Z;
	SetVehiclePos(vehicleid, X, Y, Z);
}

stock setPlayerPos(playerid,Float:X,Float:Y,Float:Z) {
	SetPlayerPos(playerid,X,Y,Z);
	Player[playerid][CurentPos][0] = X;
	Player[playerid][CurentPos][1] = Y;
	Player[playerid][CurentPos][2] = Z;
	CancelEdit(playerid);
	return SetPlayerPos(playerid, X,Y,Z);
}

ACKick(playerid,text[]) {
	new string[256],Year, Month, Day, Hour, Minute, Second;
	getdate(Year, Month, Day);
	gettime(Hour, Minute, Second);
	format(string,sizeof(string),"{ffffff}Имя игрока: "cBLUE"%s{ffffff}\nДата: "cBLUE"%02d/%02d/%d{ffffff}\nВремя: "cBLUE"%02d:%02d:%02d{ffffff}\nЧиты: "cBLUE"%s{ffffff}",Player[playerid][uName],Day,Month,Year,Hour, Minute, Second,text);
	showPlayerDialog(playerid,9999,0,"Античит",string,"Закрыть","");
	format(string,sizeof(string),"{FF0000}<Warning> %s [%d] был кикнут за %s.",Player[playerid][uName],playerid,text);
	SendAdminMessage(C_YELLOW,string);
	KickEx(playerid);
	return 1;
}

stock GetPlayerSpeed(playerid) {
    new Float:Coord[4];
    GetPlayerVelocity(playerid, Coord[0], Coord[1], Coord[2]);
    Coord[3] = floatsqroot(floatpower(floatabs(Coord[0]), 2.0) + floatpower(floatabs(Coord[1]), 2.0) + floatpower(floatabs(Coord[2]), 2.0)) * 213.3;
    return floatround(Coord[3]);
}

stock SendAdminMessageRadio(id, color, const message[], radio = 0) {
	if(GetPVarInt(id, "RadioAdmin") <= 0) return 0;
	if(GetPVarInt(id, "RadioAdmin") == radio) SendClientMessage(id, color, message);
	return 1;
}

stock SendRadioMessageForSubChanel(chanel, subchanel, text[])
{
    foreach(new i: Player)
	{

	    if(!IsPlayerConnected(i)) continue;
		//GetPVarInt(i,"uLogin") == 0)) continue;
	    if(Player[i][uRadioChanel] == chanel && Player[i][uRadioSubChanel] == subchanel) SendClientMessage(i, 0xE6E6B8AA, text);
	}
}

stock SendRadioMessage(chanel, text[])
{
	foreach(new i: Player)
	{
	
	    if(!IsPlayerConnected(i)) continue;
  		//GetPVarInt(i,"uLogin") == 0)) continue;
	    if(Player[i][uRadioChanel] == chanel) SendClientMessage(i, 0xFFFFCCAA, text);
	}
}

stock SendAdminMessage(color,const message[]) {
	foreach(new i: Player) {
		if(Player[i][uAdmin] >= 1) SendClientMessage(i,color,message);
	}
}


stock SendSupportsMessage(color,const message[])
{
	foreach(new i: Player)
	{
		if(Player[i][uSupport] == 1 && GetPVarInt(i, "SDuty") == 1 || Player[i][uAdmin] >= 1)
		{
		 	SendClientMessage(i,color,message);
		}
	}
}
