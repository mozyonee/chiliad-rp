			{
				f(lic_text, "{FFFFFF}Имя: {9DDAF2}%s {FFFFFF}| Телефон: {9DDAF2}%d {FFFFFF}| Ранг: {9DDAF2}%s\n", PlayerNameEx[i], PlayerInfo[i][pPhNumber], GetPlayerRank(i));
				strcat(string, lic_text);
