			if(PlayerInfo[playerid][pMember] == PATRUL_ORG)
		{
			if(PlayerToPoint(playerid, 3.0, 1618.4707, -1629.1959, 2584.0730))
			{
				if(GateOpen[4]) return true;
				MoveObject(TRAN_GATE2, 1618.4707, -1627.8759, 2584.0730, 3);
				SetTimer("TRAN_closeGATE2", 5000, false);
				GateOpen[4] = true;
				return true;
			}
		}
	}
	if(!IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) != PLAYER_STATE_SPECTATING && !PlayerUsePickup[playerid])
	{
		if(PRESSED(KEY_WALK))
		{
			if(IsMushroom(playerid))
			{
				if(PlayerUseGrib[playerid]) return true;
				if(PlayerInfo[playerid][pGrib] >= 50) return SendClientMessage(playerid, COLOR_GREEN, "У тебя уже есть максимальное количество листьев");
                SetPlayerChatBubble(playerid, "сорвал листик", COLOR_AQUA, 30.0, 5000);
				SeccureAnimation(playerid, "BOMBER", "BOM_Plant_Loop");
				SetTimerEx("GivePlayerMushroom", 1000, false, "i", playerid);
