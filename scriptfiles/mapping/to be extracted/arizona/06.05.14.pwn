			SendClientMessage(playerid, COLOR_GRAY, "{FFFFFF}Чтобы выгрузить материалы , нажми  {FFFFFF}/boot");
			DeleteAnimation(playerid);
			SetPlayerCheckpointEx(playerid, -1079.4023,-722.4123,32.0078, CHECKPOINT_PLAYER);
		}
		return true;
	}
