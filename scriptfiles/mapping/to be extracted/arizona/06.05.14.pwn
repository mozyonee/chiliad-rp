	//------------------------------------------------------------------------------

	else if(dialogid == ORGAN_ID)
	{
		if(response)
		{
			switch(listitem)
			{
			case 0:
				{
					new lic_text[256],licons;
					for(new i=0; i<GetMaxPlayers(); i++)
					{
						if(IsPlayerConnected(i) && PlayerInfo[i][pMember] == PlayerInfo[playerid][pMember])
						{
							f(lic_text, "{FFFFFF}Имя: {9DDAF2}%s {FFFFFF}| id: {9DDAF2}%d {FFFFFF}| Ранг: {9DDAF2}%s\n", PlayerNameEx[i], i, GetPlayerRank(i));
							strcat(string, lic_text);
							licons += 1;
						}
					}
					if(licons == 0) f(string, "{FF0000}Членов фракции онлайн не найдено");
					ShowDialog(playerid, ORGAN_ID+90, DIALOG_STYLE_MSGBOX, "Члены фракции онлайн", string, "Назад", "Закрыть");
				}
			case 1:
				{
					ShowDialog(playerid, ORGAN_ID+3, DIALOG_STYLE_INPUT, "Принять игрока", "\
Введи id игрока которго ты хочешь принять в свою организацию:\
", "Ок", "Назад");
				}
			case 2: ShowPlayerMembersList(playerid, "Уволить игрока", 20);
			case 3: ShowPlayerMembersList(playerid, "Дать выговор", 30);
			case 4: ShowPlayerMembersList(playerid, "Очистить выговоры", 40);
			case 5: ShowPlayerMembersList(playerid, "Установить ранг", 50, true);
			case 6: ShowPlayerMembersList(playerid, "Назначить зама", 60);
			case 7: ShowPlayerMembersList(playerid, "Уволить зама", 70);
			case 8: ShowPlayerRankList(playerid);
			}
		}
		return true;
	}

