stock SetVehicleNumber(vehicleid, stringx[] = "[none]")
{
	if(strcmp(stringx, "[none]", false))
	{
		SetVehicleNumberPlate(vehicleid, stringx);
		settext(NumberVehicle[vehicleid], stringx);
	}
	else
	{
		new string[64],a1[32],a2[32],a3[32],id[32];
		a1 = abc[random(24)];
		a2 = abc[random(24)];
		a3 = abc[random(24)];
		if(vehicleid >= 0 && vehicleid <= 9) f(id, "00%d", vehicleid);
		else if(vehicleid >= 10 && vehicleid <= 99) f(id, "0%d", vehicleid);
		else if(vehicleid >= 100 && vehicleid <= 999) f(id, "%d", vehicleid);
		f(string, "{0000FF}%s{000000}%s{0000FF}%s%s", a1, id, a2, a3);
		SetVehicleNumberPlate(vehicleid, string);
		f(string, "%s%s%s%s", a1, id, a2, a3);
		settext(NumberVehicle[vehicleid], string);
	}
	return true;
}

stock RemoveVehicleTuning(vehicleid)
{
	TuningInfo[vehicleid][14] = 0;
	for(new i=0; i<14; i++)
	{
		if(GetVehicleComponentInSlot(vehicleid, i) != 0)
		{
			RemoveVehicleComponent(vehicleid, i);
			TuningInfo[vehicleid][i] = 0;
		}
	}
	return true;
}

stock OnTuning(vehicleid)
{
	if(TuningInfo[vehicleid][0] != 0) AddVehicleComponent(vehicleid, TuningInfo[vehicleid][0]);
	if(TuningInfo[vehicleid][1] != 0) AddVehicleComponent(vehicleid, TuningInfo[vehicleid][1]);
	if(TuningInfo[vehicleid][2] != 0) AddVehicleComponent(vehicleid, TuningInfo[vehicleid][2]);
	if(TuningInfo[vehicleid][3] != 0) AddVehicleComponent(vehicleid, TuningInfo[vehicleid][3]);
	if(TuningInfo[vehicleid][4] != 0) AddVehicleComponent(vehicleid, TuningInfo[vehicleid][4]);
	if(TuningInfo[vehicleid][5] != 0) AddVehicleComponent(vehicleid, TuningInfo[vehicleid][5]);
	if(TuningInfo[vehicleid][6] != 0) AddVehicleComponent(vehicleid, TuningInfo[vehicleid][6]);
	if(TuningInfo[vehicleid][7] != 0) AddVehicleComponent(vehicleid, TuningInfo[vehicleid][7]);
	if(TuningInfo[vehicleid][8] != 0) AddVehicleComponent(vehicleid, TuningInfo[vehicleid][8]);
	if(TuningInfo[vehicleid][9] != 0) AddVehicleComponent(vehicleid, TuningInfo[vehicleid][9]);
	if(TuningInfo[vehicleid][10] != 0) AddVehicleComponent(vehicleid, TuningInfo[vehicleid][10]);
	if(TuningInfo[vehicleid][11] != 0) AddVehicleComponent(vehicleid, TuningInfo[vehicleid][11]);
	if(TuningInfo[vehicleid][12] != 0) AddVehicleComponent(vehicleid, TuningInfo[vehicleid][12]);
	if(TuningInfo[vehicleid][13] != 0) AddVehicleComponent(vehicleid, TuningInfo[vehicleid][13]);
	if(TuningInfo[vehicleid][14] != 0) ChangeVehiclePaintjob(vehicleid, TuningInfo[vehicleid][14]-1);
	return true;
}

stock SendDistanceChat(playerid, Float:range, string[])
{
	new Float:POS[3],Float:radius;
	GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
	for(new i=0; i<GetMaxPlayers(); i++)
	{
		if(IsPlayerConnected(i) && GetPlayerVirtualWorld(playerid) == GetPlayerVirtualWorld(i))
		{
			radius = GetPlayerDistanceFromPoint(i, POS[0], POS[1], POS[2]);
			if(radius < range/16) SendClientMessage(i, 0xD7D7D7FF, string);
			else if(radius < range/8) SendClientMessage(i, 0xCDCDCDFF, string);
			else if(radius < range/4) SendClientMessage(i, 0xC0C0C0FF, string);
			else if(radius < range/2) SendClientMessage(i, 0xB4B4B4FF, string);
			else if(radius < range) SendClientMessage(i, 0xA5A5A5FF, string);
		}
	}
	return true;
}

stock SetupPlayerWeaponSkill(playerid, weaponid)
{
	if(playerid == INVALID_PLAYER_ID) return true;
	if(weaponid == 22 && PlayerSkills[playerid][0] <= 990)
	{
		PlayerSkills[playerid][0] += 10;
		SetPlayerSkillLevel(playerid, 0, PlayerSkills[playerid][0]);
	}
	if(weaponid == 23 && PlayerSkills[playerid][1] <= 990)
	{
		PlayerSkills[playerid][1] += 10;
		SetPlayerSkillLevel(playerid, 1, PlayerSkills[playerid][1]);
	}
	if(weaponid == 24 && PlayerSkills[playerid][2] <= 990)
	{
		PlayerSkills[playerid][2] += 10;
		SetPlayerSkillLevel(playerid, 2, PlayerSkills[playerid][2]);
	}
	if(weaponid == 25 && PlayerSkills[playerid][3] <= 990)
	{
		PlayerSkills[playerid][3] += 10;
		SetPlayerSkillLevel(playerid, 3, PlayerSkills[playerid][3]);
	}
	if(weaponid == 26 && PlayerSkills[playerid][4] <= 990)
	{
		PlayerSkills[playerid][4] += 10;
		SetPlayerSkillLevel(playerid, 4, PlayerSkills[playerid][4]);
	}
	if(weaponid == 27 && PlayerSkills[playerid][5] <= 990)
	{
		PlayerSkills[playerid][5] += 10;
		SetPlayerSkillLevel(playerid, 5, PlayerSkills[playerid][5]);
	}
	if(weaponid == 28 && PlayerSkills[playerid][6] <= 990)
	{
		PlayerSkills[playerid][6] += 10;
		SetPlayerSkillLevel(playerid, 6, PlayerSkills[playerid][6]);
	}
	if(weaponid == 29 && PlayerSkills[playerid][7] <= 990)
	{
		PlayerSkills[playerid][7] += 10;
		SetPlayerSkillLevel(playerid, 7, PlayerSkills[playerid][7]);
	}
	if(weaponid == 30 && PlayerSkills[playerid][8] <= 990)
	{
		PlayerSkills[playerid][8] += 10;
		SetPlayerSkillLevel(playerid, 8, PlayerSkills[playerid][8]);
	}
	if(weaponid == 31 && PlayerSkills[playerid][9] <= 990)
	{
		PlayerSkills[playerid][9] += 10;
		SetPlayerSkillLevel(playerid, 9, PlayerSkills[playerid][9]);
	}
	if(weaponid == 34 && PlayerSkills[playerid][10] <= 990)
	{
		PlayerSkills[playerid][10] += 10;
		SetPlayerSkillLevel(playerid, 10, PlayerSkills[playerid][10]);
	}
	return true;
}

stock EndPlayerCasualJob(playerid)
{
	if(PlayerInfo[playerid][pJob] == TRUCK_JOB && Checkpoint[TRUCK_JOB][playerid] != 0)
	{
		DisablePlayerRaceCheckpoint(playerid);
		GetJobVehicle[playerid] = INVALID_VEHICLE_ID;
		Checkpoint[TRUCK_JOB][playerid] = 0;
	}
	else if(PlayerInfo[playerid][pJob] == GASTRUCK_JOB && Checkpoint[GASTRUCK_JOB][playerid] != 0)
	{
		DisablePlayerRaceCheckpoint(playerid);
		GetJobVehicle[playerid] = INVALID_VEHICLE_ID;
		Checkpoint[GASTRUCK_JOB][playerid] = 0;
	}
	else if(PlayerInfo[playerid][pJob] == COLLECTOR_JOB && Checkpoint[COLLECTOR_JOB][playerid] != 0)
	{
		DisablePlayerRaceCheckpoint(playerid);
		GetJobVehicle[playerid] = INVALID_VEHICLE_ID;
		Checkpoint[COLLECTOR_JOB][playerid] = 0;
	}
	else if(PlayerInfo[playerid][pJob] == AMMO_JOB && Checkpoint[AMMO_JOB][playerid] != 0)
	{
		DisablePlayerRaceCheckpoint(playerid);
		GetJobVehicle[playerid] = INVALID_VEHICLE_ID;
		Checkpoint[AMMO_JOB][playerid] = 0;
		PlayerAmountPack[playerid] = 0;
	}
	else if(PlayerInfo[playerid][pJob] == STICK_JOB && Checkpoint[STICK_JOB][playerid] != 0)
	{
		DisablePlayerRaceCheckpoint(playerid);
		GetJobVehicle[playerid] = INVALID_VEHICLE_ID;
		Checkpoint[STICK_JOB][playerid] = 0;
		PlayerAmountPack[playerid] = 0;
	}
	else if(PlayerInfo[playerid][pJob] == TAXI_JOB && TaxiJobStarted[playerid])
	{
		new vehicleid = GetJobVehicle[playerid];
		DestroyDynamic3DTextLabel(INFO[vehicleid]);
		PlayerAmountPack[playerid] = 0;
		KillTimer(TaxiCountTimer[playerid]);
		KillTimer(ExitCarTimer[playerid]);
		GetJobVehicle[playerid] = INVALID_VEHICLE_ID;
		TaxiJobStarted[playerid] = false;
		GetPlayerRentTaxi[playerid] = -1;
		SetVehicleToRespawn(vehicleid);
	}
	else if(PlayerInfo[playerid][pJob] == BUSDRIVER_JOB && CheckpointBus[0][playerid] != 0)
	{
		new vehicleid = GetJobVehicle[playerid];
		DisablePlayerRaceCheckpoint(playerid);
		CheckpointBus[0][playerid] = 0;
		CheckpointBus[1][playerid] = 0;
		PlayerAmountPack[playerid] = 0;
		DestroyDynamic3DTextLabel(INFO[vehicleid]);
		GetRouteBus[vehicleid] = 0;
		GetInfoMode[vehicleid] = 0;
		TogglePlayerControllable(playerid, true);
		SetVehicleToRespawn(vehicleid);
		RemovePlayerFromVehicleEx(playerid);
		GetJobVehicle[playerid] = INVALID_VEHICLE_ID;
		GetPlayerRentBus[playerid] = -1;
	}
		else if(PlayerInfo[playerid][pJob] == BUSDRIVER1_JOB && CheckpointFarmer[0][playerid] != 0)
	{
		new vehicleid = GetJobVehicle[playerid];
		DisablePlayerRaceCheckpoint(playerid);
		CheckpointFarmer[0][playerid] = 0;
		CheckpointFarmer[1][playerid] = 0;
		PlayerAmountPack[playerid] = 0;
		DestroyDynamic3DTextLabel(INFO[vehicleid]);
		GetRouteBus[vehicleid] = 0;
		GetInfoMode[vehicleid] = 0;
		TogglePlayerControllable(playerid, true);
		SetVehicleToRespawn(vehicleid);
		RemovePlayerFromVehicleEx(playerid);
		GetJobVehicle[playerid] = INVALID_VEHICLE_ID;
		GetPlayerRentFarmer[playerid] = -1;
	}
	else if(PlayerInfo[playerid][pJob] == PORTER_JOB && Checkpoint[PORTER_JOB][playerid] != 0)
	{
		PlayerAmountPack[playerid] = 0;
		DisablePlayerRaceCheckpoint(playerid);
		Checkpoint[PORTER_JOB][playerid] = 0;
		DeleteAnimation(playerid);
		RemovePlayerAttachedObject(playerid, ATT_PACK);
		SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
		if(PlayerInfo[playerid][pBandana] != 0) SetPlayerBandana(playerid, PlayerInfo[playerid][pBandana]);
		if(PlayerInfo[playerid][pHat] != 0) SetPlayerHat(playerid, PlayerInfo[playerid][pHat]);
	}
 else if(PlayerInfo[playerid][pJob] == BUILD_JOB && Checkpoint[BUILD_JOB][playerid] != 0)
	{
		PlayerAmountPack[playerid] = 0;
		DisablePlayerRaceCheckpoint(playerid);
		Checkpoint[BUILD_JOB][playerid] = 0;
		DeleteAnimation(playerid);
		RemovePlayerAttachedObject(playerid, ATT_PACK);
		SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
		if(PlayerInfo[playerid][pBandana] != 0) SetPlayerBandana(playerid, PlayerInfo[playerid][pBandana]);
		if(PlayerInfo[playerid][pHat] != 0) SetPlayerHat(playerid, PlayerInfo[playerid][pHat]);
	}
	else if(PlayerInfo[playerid][pJob] == FOREST_JOB && Checkpoint[FOREST_JOB][playerid] != 0)
	{
		RemovePlayerWeapon(playerid, 9);
		PlayerAmountPack[playerid] = 0;
		DisablePlayerRaceCheckpoint(playerid);
		Checkpoint[FOREST_JOB][playerid] = 0;
		DeleteAnimation(playerid);
		RemovePlayerAttachedObject(playerid, ATT_PACK);
		SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
		if(PlayerInfo[playerid][pBandana] != 0) SetPlayerBandana(playerid, PlayerInfo[playerid][pBandana]);
		if(PlayerInfo[playerid][pHat] != 0) SetPlayerHat(playerid, PlayerInfo[playerid][pHat]);
	}
	else if(PlayerInfo[playerid][pJob] == PIZZA_JOB && Checkpoint[PIZZA_JOB][playerid] != 0)
	{
		PlayerAmountPack[playerid] = 0;
		DeleteAnimation(playerid);
		RemovePlayerAttachedObject(playerid, ATT_PACK);
		DisablePlayerRaceCheckpoint(playerid);
		Checkpoint[PIZZA_JOB][playerid] = 0;
		GetJobVehicle[playerid] = INVALID_VEHICLE_ID;
		SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
		if(PlayerInfo[playerid][pBandana] != 0) SetPlayerBandana(playerid, PlayerInfo[playerid][pBandana]);
		if(PlayerInfo[playerid][pHat] != 0) SetPlayerHat(playerid, PlayerInfo[playerid][pHat]);
	}
	return true;
}

stock SpawnPlayerInJail(playerid)
{
	if(PlayerInfo[playerid][pJailTime] > 0)
	{
		DisablePlayerRaceCheckpoint(playerid);
		SetPlayerArmourEx(playerid, 0);
		SetPlayerWantedLevel(playerid, 0);
		RemovePlayerAllWeaponEx(playerid);
		SetPlayerInterior(playerid, 1);
		switch(random(3))
		{
		case 0:
		{
		SetPlayerPos(playerid, 1611.5513,-1632.7450,2583.8660);
		SetPlayerFacingAngle(playerid, 180.0);
		}
		case 1:
		{
		SetPlayerPos(playerid, 1612.2408,-1625.7700,2583.8660);
		SetPlayerFacingAngle(playerid, 180.0);
		}
			case 2:
		{
		SetPlayerPos(playerid, 1608.2272,-1630.4746,2583.8660);
		SetPlayerFacingAngle(playerid, 180.0);
		}
		}
		SetCameraBehindPlayer(playerid);
		SetPlayerSkin(playerid, 268);
		SetPlayerVirtualWorld(playerid, POLC_MIR);
		EndPlayerCasualJob(playerid);
		RemovePlayerHat(playerid, false);
		RemovePlayerBandana(playerid, false);
		PlayerInInterior[playerid] = true;
		CurrentPlayerTime(playerid);
	}
	return true;
}

stock GivePlayersPayDay(bool:payed)
{
	for(new playerid=0; playerid<GetMaxPlayers(); playerid++)
	{
		if(IsPlayerConnected(playerid) && PlayerLogged[playerid])
		{
   if(PlayerInfo[playerid][pPayTime] < 20 && payed)
			{
				SendClientMessage(playerid, COLOR_GREEN, "Ты отыграл слишком мало времени, чтобы получить зарплату");
				continue;
			}
			if(PlayerInfo[playerid][pVip] == 1)
			{
			PlayerInfo[playerid][pPayDay] += 1;
			}
			if(PlayerInfo[playerid][pLevel] >= 12 && PlayerInfo[playerid][pLevel] <= 50)
            {
                PlayerInfo[playerid][pPayPensia] += 1200;
			}
			PlayerInfo[playerid][pPayDay] += 1;
			PlayerInfo[playerid][pPayTime] = 0;
			if(PlayerInfo[playerid][pZakon] <= 99) PlayerInfo[playerid][pZakon] += 1;
			else PlayerInfo[playerid][pZakon] = 100;
			if(PlayerInfo[playerid][pBalance] < 0) PlayerInfo[playerid][pBalance] = 0;
			new string[128],zarplata,procent,komunal,pensia;
			if(PlayerInfo[playerid][pJob] != 0)
			{
				switch(random(3))
				{
				case 0,1: zarplata = GetWage - random(100);
				case 2,3: zarplata = GetWage + random(100);
				}
			}
			if(PlayerInfo[playerid][pMember] != 0) zarplata = (GetWage+random(100)) * PlayerInfo[playerid][pRank];
			new nalogi = floatround(zarplata/100*GetNalog);
			MeriaBudget += nalogi;
			if(PlayerInfo[playerid][pRent] != 0) komunal = PlayerInfo[playerid][pRentPrice];
			else if(PlayerInfo[playerid][pHouse] != 0) komunal = PlayerInfo[playerid][pLevel]*5 + random(100);
			new oldbank = PlayerInfo[playerid][pBalance];
			if(PlayerInfo[playerid][pBalance] >= 100 &&  PlayerInfo[playerid][pBalance] <= 70000) procent = PlayerInfo[playerid][pBalance]/100*2;
			PlayerInfo[playerid][pBalance] = oldbank+zarplata+procent-nalogi-komunal;
			new newbank = PlayerInfo[playerid][pBalance];
			f(string, "Банковский чек: {FCFCD4}[ %d/%d ]", PlayerInfo[playerid][pPayDay], (PlayerInfo[playerid][pLevel]+1)*4);
			SendClientMessage(playerid, COLOR_CREAM, string);
			f(string,"-------------------------------------\n");
			SendClientMessage(playerid, 0x0F9FBFFF, string);
			f(string,"Пенсия %d$", pensia);
			SendClientMessage(playerid, 0x0F9FBFFF, string);
			f(string, "Зарплата: {8CC6D4}%d$", zarplata);
			SendClientMessage(playerid, 0x0F9FBFFF, string);
			f(string, "Накопительные: {8CC6D4}%d$", procent);
			SendClientMessage(playerid, 0x0F9FBFFF, string);
			f(string, "Налоги: {8CC6D4}%d$ (%d%s)", nalogi, GetNalog, "%%");
			SendClientMessage(playerid, 0x0F9FBFFF, string);
			f(string,"------------------------------------");
			SendClientMessage(playerid, 0x0F9FBFFF, string);
			if(PlayerInfo[playerid][pRent] != 0)
			{
				f(string, "Аренда жилья: {8CC6D4}%d$", komunal);
				SendClientMessage(playerid, 0x0F9FBFFF, string);
			}
			else if(PlayerInfo[playerid][pHouse] != 0)
			{
				f(string, "Коммунальные услуги: {8CC6D4}%d$", komunal);
				SendClientMessage(playerid, 0x0F9FBFFF, string);
			}
			if(PlayerInfo[playerid][pBankKart] != 0)
			{
				f(string, "Старый счёт: {8CC6D4}%d$", oldbank);
				SendClientMessage(playerid, 0x1BBCE0FF, string);
				f(string, "Новый счёт: {8CC6D4}%d$", newbank);
				SendClientMessage(playerid, 0x1BBCE0FF, string);
			}
			f(string,"------------------------------------");
			SendClientMessage(playerid, 0x0F9FBFFF, string);
			if(PlayerInfo[playerid][pPayDay] >= (PlayerInfo[playerid][pLevel]+1)*4)
			{
				PlayerInfo[playerid][pPayDay] -= (PlayerInfo[playerid][pLevel]+1)*4;
				PlayerInfo[playerid][pLevel] += 1;
				PlayerInfo[playerid][pList] += 1;
				SendClientMessage(playerid, 0xBFE01BFF, "Поздравляем у вас день рождения , кажись вам чтото прислали на почту!");
				SetPlayerScore(playerid, PlayerInfo[playerid][pLevel]);
			}
		}
 }
	return true;
}

stock PromoteBusiness(bizz, funds, balance)
{
	if(BusinessInfo[bizz][bUpload] == 1 && strcmp(BusinessInfo[bizz][bOwner], "None", false))
	{
		BusinessInfo[bizz][bFunds] += funds;
		BusinessInfo[bizz][bBalance] -= balance;
		if(BusinessInfo[bizz][bFunds] > 1000) BusinessInfo[bizz][bBalance] = 1000;
		if(BusinessInfo[bizz][bBalance] < 0) BusinessInfo[bizz][bBalance] = 0;
	}
	return true;
}

stock GetPlayerSpeed(playerid)
{
	new speed,Float:POS[4];
	if(!IsPlayerInAnyVehicle(playerid)) GetPlayerVelocity(playerid, POS[0], POS[1], POS[2]);
	else GetVehicleVelocity(GetPlayerVehicleID(playerid), POS[0], POS[1], POS[2]);
	POS[3] = floatsqroot(floatpower(floatabs(POS[0]), 2.0)+floatpower(floatabs(POS[1]), 2.0)+floatpower(floatabs(POS[2]), 2.0)) * 253.3;
	speed = floatround(POS[3])/2;
	return speed;
}

