		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /find [ id игрока ]");
		giveplayerid = strval(tmp);
		if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
		if(GetPlayerInterior(giveplayerid) != GetPlayerInterior(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Игрок находится в каком-то здание");
