			{
				f(string, "Ты принял приглашение от игрока {9DDAF2}%s{FFFFFF} вступить во фракцию {9DDAF2}%s", PlayerNameEx[frakid], GetOrganizationName(PlayerInfo[playerid][pMember]));
				SendClientMessage(playerid, COLOR_WHITE, string);
				f(string, "Игрок {9DDAF2}%s{FFFFFF} принял твоё приглашения вступить во фракцию {9DDAF2}%s", PlayerNameEx[playerid], GetOrganizationName(PlayerInfo[playerid][pMember]));
				SendClientMessage(frakid, COLOR_WHITE, string);
