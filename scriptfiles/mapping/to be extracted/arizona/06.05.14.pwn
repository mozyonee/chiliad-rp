				case 2: SetPlayerPos(playerid, 2233.690, -1115.26, 1050.88), SetPlayerInterior(playerid, 5),  SetPlayerFacingAngle(playerid, 0.00000), PlayerInteriorPrice[playerid] = 50000;
				case 3: SetPlayerPos(playerid, 2218.390, -1076.21, 1050.48), SetPlayerInterior(playerid, 1),  SetPlayerFacingAngle(playerid, 90.0000), PlayerInteriorPrice[playerid] = 60000;
				case 4: SetPlayerPos(playerid, 2196.840, -1204.36, 1049.02), SetPlayerInterior(playerid, 6),  SetPlayerFacingAngle(playerid, 90.0000), PlayerInteriorPrice[playerid] = 70000;
				case 5: SetPlayerPos(playerid, 2496.000, -1692.08, 1014.74), SetPlayerInterior(playerid, 3),  SetPlayerFacingAngle(playerid, 180.000), PlayerInteriorPrice[playerid] = 80000;
				case 6: SetPlayerPos(playerid, 2365.250, -1135.58, 1050.88), SetPlayerInterior(playerid, 8),  SetPlayerFacingAngle(playerid, 358.000), PlayerInteriorPrice[playerid] = 90000;
				case 7: SetPlayerPos(playerid, 2317.770, -1026.76, 1050.21), SetPlayerInterior(playerid, 9),  SetPlayerFacingAngle(playerid, 358.491), PlayerInteriorPrice[playerid] = 100000;
				case 8: SetPlayerPos(playerid, 2324.410, -1149.54, 1050.71), SetPlayerInterior(playerid, 12), SetPlayerFacingAngle(playerid, 357.587), PlayerInteriorPrice[playerid] = 110000;
				case 9: SetPlayerPos(playerid, 140.2800, 1365.920, 1083.85), SetPlayerInterior(playerid, 5),  SetPlayerFacingAngle(playerid, 359.226), PlayerInteriorPrice[playerid] = 120000;
				}
				new string[128];
				f(string, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~PRICE: ~w~%d$", PlayerInteriorPrice[playerid]);
				GameTextForPlayer(playerid, string, 10000, 3);
				PlayerInteriorView[playerid] += 1;
				if(PlayerInteriorView[playerid] == 10) PlayerInteriorView[playerid] = 1;
			}
		case 1:
			{
				new string[128];
				f(string, "\
Ты действительно хочешь купить этот интерьер за %d$?\
", PlayerInteriorPrice[playerid]);
				ShowDialog(playerid, HOUSE_ID+3, DIALOG_STYLE_MSGBOX, "Покупка интерьера", string, "Купить", "Отмена");
			}
		case 2:
			{
				KillTimer(InteriorView[playerid]);
				SetPlayerHouseInterior(playerid, PlayerInfo[playerid][pHouse]);
				SetCameraBehindPlayer(playerid);
				GetPlayerInteriorView[playerid] = false;
				PlayerInteriorView[playerid] = 0;
				TogglePlayerControllable(playerid, true);
			}
		}
		return true;
	}
	else if(GetPlayerMenu(playerid) == VehicleMenu)
	{
		switch(row)
		{
		case 0:
			{
				new string[128];
				ShowMenuForPlayer(VehicleMenu, playerid);
				pPressed[playerid] += 1;
				DestroyVehicle(BuyVehicle[playerid]);
				switch(pInShop[playerid])
				{
				case 1:
					{
						if(pPressed[playerid] >= sizeof(carsA)) pPressed[playerid] = 0;
						BuyVehicle[playerid] = CreateVehicle(carsA[pPressed[playerid]][0], -540.4669, -517.0956, 25.7599, 9.2600, -1, -1, -1);
						f(string, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~PRICE: ~w~%d$", carsA[pPressed[playerid]][1]);
						VehicleInfo[BuyVehicle[playerid]][vPrice] = carsA[pPressed[playerid]][1];
					}
				case 2:
					{
						if(pPressed[playerid] >= sizeof(carsB)) pPressed[playerid] = 0;
						BuyVehicle[playerid] = CreateVehicle(carsB[pPressed[playerid]][0], -540.4669, -517.0956, 25.7599, 9.2600, -1, -1, -1);
						f(string, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~PRICE: ~w~%d$", carsB[pPressed[playerid]][1]);
						VehicleInfo[BuyVehicle[playerid]][vPrice] = carsB[pPressed[playerid]][1];
					}
				case 3:
					{
						if(pPressed[playerid] >= sizeof(carsC)) pPressed[playerid] = 0;
						BuyVehicle[playerid] = CreateVehicle(carsC[pPressed[playerid]][0], -540.4669, -517.0956, 25.7599, 9.2600, -1, -1, -1);
						f(string, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~PRICE: ~w~%d$", carsC[pPressed[playerid]][1]);
						VehicleInfo[BuyVehicle[playerid]][vPrice] = carsC[pPressed[playerid]][1];
					}
				case 4:
					{
						if(pPressed[playerid] >= sizeof(carsD)) pPressed[playerid] = 0;
						BuyVehicle[playerid] = CreateVehicle(carsD[pPressed[playerid]][0], -540.4669, -517.0956, 25.7599, 9.2600, -1, -1, -1);
						f(string, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~PRICE: ~w~%d$", carsD[pPressed[playerid]][1]);
						VehicleInfo[BuyVehicle[playerid]][vPrice] = carsD[pPressed[playerid]][1];
					}
				case 5:
					{
						if(pPressed[playerid] >= sizeof(carsE)) pPressed[playerid] = 0;
						BuyVehicle[playerid] = CreateVehicle(carsE[pPressed[playerid]][0], -540.4669, -517.0956, 25.7599, 9.2600, -1, -1, -1);
						f(string, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~PRICE: ~w~%d$", carsE[pPressed[playerid]][1]);
						VehicleInfo[BuyVehicle[playerid]][vPrice] = carsE[pPressed[playerid]][1];
					}
				}
				GameTextForPlayer(playerid, string, 10000, 3);
				LinkVehicleToInterior(BuyVehicle[playerid], 3);
				SetVehicleVirtualWorld(BuyVehicle[playerid], playerid);
				PutPlayerInVehicle(playerid, BuyVehicle[playerid], 0);
				SetPlayerCameraPos(playerid, -537.56,-512.06,26.25);
				SetPlayerCameraLookAt(playerid,  -540.4669, -517.0956, 25.7599);
			}
		case 1:
			{
				new string[128];
				f(string, "\
Ты действительно хочешь купить эту машину за %d$?\
", VehicleInfo[BuyVehicle[playerid]][vPrice]);
				ShowDialog(playerid, BUYCAR_ID, DIALOG_STYLE_MSGBOX, "Покупка машины", string, "Купить", "Отмена");
			}
		case 2:
			{
				RemovePlayerFromVehicleEx(playerid);
				DestroyVehicle(BuyVehicle[playerid]);
				SetCameraBehindPlayer(playerid);
				TogglePlayerControllable(playerid, true);
				SetPlayerInterior(playerid, 0);
				SetPlayerVirtualWorld(playerid, 0);
				SetPlayerPos(playerid, -543.3920,-531.5029,25.7859);
				GameTextForPlayer(playerid, "~n~", 1000, 3);
			}
		}
		return true;
	}
	else if(GetPlayerMenu(playerid) == ClothingMenu)
	{
		switch(row)
		{
		case 0:
			{
				SelectCharSkin[playerid] += 1;
				if(PlayerInfo[playerid][pSex] == 1)
				{
					SetPlayerSkin(playerid, IndivMan[SelectCharSkin[playerid]-1]);
				}
				if(PlayerInfo[playerid][pSex] == 2)
				{
					SetPlayerSkin(playerid, IndivWoman[SelectCharSkin[playerid]-1]);
				}
				if(SelectCharSkin[playerid] == 11 && PlayerInfo[playerid][pSex] == 2
						|| SelectCharSkin[playerid] == 16 && PlayerInfo[playerid][pSex] == 1)
				{
					SelectCharSkin[playerid] = 0;
				}
				ShowMenuForPlayer(ClothingMenu, playerid);
				GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~PRICE: ~w~1000$", 10000, 3);
			}
		case 1:
			{
				if(BusinessInfo[CLOTH_BIZZ][bFunds] < 1) return SendClientMessage(playerid, COLOR_GREEN, "В магазине закончилась одежда");
				PlayerInfo[playerid][pSkin] = GetPlayerSkin(playerid);
				TogglePlayerControllable(playerid, true);
				GivePlayerMoneyEx(playerid, -1000);
				BusinessInfo[CLOTH_BIZZ][bFunds] -= 1;
				BusinessInfo[CLOTH_BIZZ][bBalance] += 200;
				SetPlayerPos(playerid, 207.4350, -4.8380, 1001.2109);
				SetPlayerFacingAngle(playerid, 229.0);
				SetCameraBehindPlayer(playerid);
				SetPlayerVirtualWorld(playerid, PlayerInfo[playerid][pMir]);
				GameTextForPlayer(playerid, " ", 1000, 3);
				PlayerInClothing[playerid] = false;
			}
		case 2:
			{
				GameTextForPlayer(playerid, " ", 1000, 3);
				SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
				TogglePlayerControllable(playerid, true);
				SetPlayerPos(playerid, 207.4350, -4.8380, 1001.2109);
				SetPlayerFacingAngle(playerid, 229.0);
				SetCameraBehindPlayer(playerid);
				SetPlayerVirtualWorld(playerid, PlayerInfo[playerid][pMir]);
				PlayerInClothing[playerid] = false;
			}
		}
		return true;
	}
	else if(GetPlayerMenu(playerid) == SkinMenu)
	{
		switch(row)
		{
		case 0:
			{
				SelectCharSkin[playerid] += 1;
				if(PlayerOrganizationSkin[playerid])
				{
					new skin = SelectCharSkin[playerid]-1;
					new setorg = PlayerInfo[playerid][pMember];
					switch(setorg)
					{
					case ARMY_ORG: SetPlayerSkin(playerid, PoliceSkins[skin]);
					case PATRUL_ORG: SetPlayerSkin(playerid, PatrulSkins[skin]);
					case MERIA_ORG: SetPlayerSkin(playerid, MeriaSkins[skin]);
					case HITMAN_ORG: SetPlayerSkin(playerid, HitmanSkins[skin]);
					case ADVOKAT_ORG: SetPlayerSkin(playerid, AdvokatSkins[skin]);
					case MEDIC_ORG: SetPlayerSkin(playerid, MedicSkins[skin]);
					case TRANSPORT_ORG: SetPlayerSkin(playerid, TransportSkins[skin]);
					case REPORTER_ORG: SetPlayerSkin(playerid, ReporterSkins[skin]);
					case GROOVE_GANG: SetPlayerSkin(playerid, GroveSkins[skin]);
					case BALLAS_GANG: SetPlayerSkin(playerid, BallasSkins[skin]);
					case RIFA_GANG: SetPlayerSkin(playerid, RifaSkins[skin]);
					case VAGOS_GANG: SetPlayerSkin(playerid, VagosSkins[skin]);
					case AZTECAS_GANG: SetPlayerSkin(playerid, AztecasSkins[skin]);
					case NOSTRA_MAFIA: SetPlayerSkin(playerid, NostraSkins[skin]);
					case YAKUZA_MAFIA: SetPlayerSkin(playerid, YakuzaSkins[skin]);
					case RUSSIAN_MAFIA: SetPlayerSkin(playerid, RussianSkins[skin]);
					}
					if((SelectCharSkin[playerid] == sizeof(PoliceSkins) && setorg == ARMY_ORG)
							|| (SelectCharSkin[playerid] == sizeof(MeriaSkins) && setorg == MERIA_ORG)
							|| (SelectCharSkin[playerid] == sizeof(HitmanSkins) && setorg == HITMAN_ORG)
							|| (SelectCharSkin[playerid] == sizeof(AdvokatSkins) && setorg == ADVOKAT_ORG)
							|| (SelectCharSkin[playerid] == sizeof(MedicSkins) && setorg == MEDIC_ORG)
							|| (SelectCharSkin[playerid] == sizeof(TransportSkins) && setorg == TRANSPORT_ORG)
							|| (SelectCharSkin[playerid] == sizeof(ReporterSkins) && setorg == REPORTER_ORG)
							|| (SelectCharSkin[playerid] == sizeof(PatrulSkins) && setorg == PATRUL_ORG)
							|| (SelectCharSkin[playerid] == sizeof(GroveSkins) && setorg == GROOVE_GANG)
							|| (SelectCharSkin[playerid] == sizeof(BallasSkins) && setorg == BALLAS_GANG)
							|| (SelectCharSkin[playerid] == sizeof(RifaSkins) && setorg == RIFA_GANG)
							|| (SelectCharSkin[playerid] == sizeof(VagosSkins) && setorg == VAGOS_GANG)
							|| (SelectCharSkin[playerid] == sizeof(AztecasSkins) && setorg == AZTECAS_GANG)
							|| (SelectCharSkin[playerid] == sizeof(NostraSkins) && setorg == NOSTRA_MAFIA)
							|| (SelectCharSkin[playerid] == sizeof(YakuzaSkins) && setorg == YAKUZA_MAFIA)
							|| (SelectCharSkin[playerid] == sizeof(RussianSkins) && setorg == RUSSIAN_MAFIA))
					{
						SelectCharSkin[playerid] = 0;
					}
				}
				else
				{
					if(PlayerInfo[playerid][pSex] == 1)
					{
						SetPlayerSkin(playerid, ClassMan[SelectCharSkin[playerid]-1]);
					}
					if(PlayerInfo[playerid][pSex] == 2)
					{
						SetPlayerSkin(playerid, ClassWoman[SelectCharSkin[playerid]-1]);
					}
                    if((SelectCharSkin[playerid] == 5 && PlayerInfo[playerid][pSex] == 2)
					|| (SelectCharSkin[playerid] == 5 && PlayerInfo[playerid][pSex] == 1))
					{
						SelectCharSkin[playerid] = 0;
					}
				}
				ShowMenuForPlayer(SkinMenu, playerid);
			}
		case 1:
			{
				if(!PlayerLogged[playerid])
				{
					PlayerLogged[playerid] = true;
					PlayerInfo[playerid][pSkin] = GetPlayerSkin(playerid);
					new string[64];
					f(string, "users/%s.ini", PlayerName[playerid]);
					new GetFile = ini_openFile(string);
					ini_setInteger(GetFile, "SKIN", PlayerInfo[playerid][pSkin]);
					ini_closeFile(GetFile);
					TogglePlayerControllable(playerid, true);
					OnPlayerSpawn(playerid);
					SetPlayerMoneyEx(playerid, PlayerInfo[playerid][pMoney]);
					PlayerInClothing[playerid] = false;
				}
				else
				{
					PlayerOrganizationSkin[playerid] = false;
					PlayerInfo[playerid][pSkin] = GetPlayerSkin(playerid);
					TogglePlayerControllable(playerid, true);
					PlayerSavedPositions[playerid] = true;
					OnPlayerSpawn(playerid);
					PlayerInClothing[playerid] = false;
				}
			}
		}
		return true;
	}
	return true;
}

public OnPlayerExitedMenu(playerid)
{
	ShowMenuForPlayer(GetPlayerMenu(playerid), playerid);
	return true;
}

public OnPlayerEnterRaceCheckpoint(playerid)
{
	new string[128];
	if(PlayerFinded[playerid])
	{
		DisablePlayerRaceCheckpoint(playerid);
		PlayerFinded[playerid] = false;
		CountPlayerFind[playerid] = 0;
		return true;
	}

	if(!EnableJobCheckpoint(playerid) && KartingPoint[playerid] != 1)
	{
		DisablePlayerRaceCheckpoint(playerid);
	}

	if(PlayerSteal[playerid] == 1)
	{
		new Float:POS[3];
		DisablePlayerRaceCheckpoint(playerid);
		PlayerSteal[playerid] = 2;
		if(GetGunsOnSklad >= 50)
		{
			GetGunsOnSklad -= 50;
		}
		else
		{
			PlayerSteal[playerid] = 0;
			SendClientMessage(playerid, 0x00ACBFFF, "На складе закончились материалы");
			return true;
		}
		f(string, "На складе {FFFF00}%d {FFFFFF}шт. материалов", GetGunsOnSklad);
		UpdateDynamic3DTextLabelText(GunsText, 0xFFFFFFFF, string);
		ToggleAnimation(playerid, "CARRY", "crry_prtial");
		SetPlayerAttachedObject(playerid, ATT_PACK, 2358, 1, 0.128, 0.524, -0.038, 177.336, 85.343, 0.0, 1.0, 1.0, 1.0);
		GetCoordBootVehicle(GetStealCar[playerid], POS[0], POS[1], POS[2]);
		SetPlayerCheckpointEx(playerid, POS[0], POS[1], POS[2], CHECKPOINT_PLAYER);
		return true;
	}
	if(PlayerSteal[playerid] == 2)
	{
		DisablePlayerRaceCheckpoint(playerid);
		DeleteAnimation(playerid);
		RemovePlayerAttachedObject(playerid, ATT_PACK);
		if(VehicleInfo[GetStealCar[playerid]][vMats] <= 4950)
		{
			PlayerSteal[playerid] = 1;
			VehicleInfo[GetStealCar[playerid]][vMats] += 15;
			SetPlayerCheckpointEx(playerid, -1022.5657,-732.4492,24.8891, CHECKPOINT_PLAYER);
			return true;
		}
		else
		{
			PlayerSteal[playerid] = 0;
			SendClientMessage(playerid, 0x00ACBFFF, "Багажник этой машины полон материалами");
			SendClientMessage(playerid, COLOR_GRAY, "Чтобы достать материалы из машины используй команду {FFFFFF}/boot");
		}
		return true;
	}
	////===============Поставка боеприпасов=========================
 	if(PlayerSteal2[playerid] == 1)
	{
		new Float:POS[3];
		DisablePlayerRaceCheckpoint(playerid);
		PlayerSteal2[playerid] = 2;
		if(GetGunsOnSklad >= 50)
		{
			GetGunsOnSklad -= 50;
		}
		else
		{
			PlayerSteal2[playerid] = 0;
			SendClientMessage(playerid, 0x00ACBFFF, "На складе закончились материалы");
			return true;
		}
		f(string, "На складе {FFFF00}%d {FFFFFF}шт. материалов", GetGunsOnSklad);
		UpdateDynamic3DTextLabelText(GunsText, 0xFFFFFFFF, string);
		ToggleAnimation(playerid, "CARRY", "crry_prtial");
		SetPlayerAttachedObject(playerid, ATT_PACK, 2358, 1, 0.128, 0.524, -0.038, 177.336, 85.343, 0.0, 1.0, 1.0, 1.0);
		GetCoordBootVehicle(GetStealCar[playerid], POS[0], POS[1], POS[2]);
		SetPlayerCheckpointEx(playerid, POS[0], POS[1], POS[2], CHECKPOINT_PLAYER);
		return true;
	}
	if(PlayerSteal2[playerid] == 2)
	{
		DisablePlayerRaceCheckpoint(playerid);
		DeleteAnimation(playerid);
		RemovePlayerAttachedObject(playerid, ATT_PACK);
		if(VehicleInfo[GetStealCar[playerid]][vMats] <= 4950)
		{
			PlayerSteal2[playerid] = 1;
			VehicleInfo[GetStealCar[playerid]][vMats] += 30;
			SetPlayerCheckpointEx(playerid, -1902.1361,-1678.0259,23.0156, CHECKPOINT_PLAYER);
			return true;
		}
		else
		{
			PlayerSteal2[playerid] = 0;
			SendClientMessage(playerid, 0x00ACBFFF, "Кузов этой машины переполнен");
			SendClientMessage(playerid, COLOR_GRAY, "Чтобы достать материалы из машины используй команду {FFFFFF}/boot");
		}
		return true;
	}

	//------------------------------------------------------------------------------

 if(Checkpoint[BUILD_JOB][playerid] == 1)
	{
		DisablePlayerRaceCheckpoint(playerid);
		Checkpoint[BUILD_JOB][playerid] = 2;
		new rand = random(sizeof(gBuildPoint));
		SetPlayerCheckpointEx(playerid, gBuildPoint[rand][0], gBuildPoint[rand][1], gBuildPoint[rand][2], CHECKPOINT_PLAYER);
		PlayerFaceBuild[playerid] = gBuildPoint[rand][3];
		ToggleAnimation(playerid, "CARRY", "crry_prtial", false);
		SetPlayerAttachedObject(playerid, ATT_PACK, 2040, 1, 0.11, 0.36, 0.0, 90.0, 90.0, 2, 2, 2);
		SendClientMessage(playerid, COLOR_WHITE, "Отнеси эти стройматериалы к красному маркеру");
		return true;
	}
 if(Checkpoint[BUILD_JOB][playerid] == 2)
	{
		DisablePlayerRaceCheckpoint(playerid);
		RemovePlayerAttachedObject(playerid, ATT_PACK);
		SeccureAnimation(playerid, "SWORD", "sword_block");
		SetPlayerAttachedObject(playerid, ATT_PACK, 18634, 6, 0.078222, 0.000000, 0.110844, 298.897308, 264.126861, 193.350555, 1.000000, 1.000000, 1.000000);
		SetTimerEx("OnPlayerBuild", 1000, false, "i", playerid);
		SetPlayerFacingAngle(playerid, PlayerFaceBuild[playerid]);
		Checkpoint[BUILD_JOB][playerid] = 110;
		return true;
	}

	//------------------------------------------------------------------------------

	if(Checkpoint[FOREST_JOB][playerid] == 1)
	{
		DisablePlayerRaceCheckpoint(playerid);
		GivePlayerWeaponEx(playerid, 9);
		LoopingAnimation(playerid, "CHAINSAW", "WEAPON_csaw", false);
		SetTimerEx("OnPlayerForest", 10000, false, "i", playerid);
		return true;
	}
	if(Checkpoint[FOREST_JOB][playerid] == 2)
	{
		DisablePlayerRaceCheckpoint(playerid);
