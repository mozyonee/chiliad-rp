stock CreateHouseExitPickup(houseid)
{
	switch(HouseInfo[houseid][hInterior])
	{
	case 1: HousePickupInt[houseid] = CreateDynamicPickup(19197, 23, 2282.990, -1140.28, 1050.89, HOUS_MIR+houseid);
