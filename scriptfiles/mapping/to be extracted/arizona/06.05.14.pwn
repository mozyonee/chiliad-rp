				if(Checkpoint[COLLECTOR_JOB][playerid] == 1 || Checkpoint[COLLECTOR_JOB][playerid] == 2 || Checkpoint[COLLECTOR_JOB][playerid] == 3 || Checkpoint[COLLECTOR_JOB][playerid] == 888 || !IsPlayerInRaceCheckpoint(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не достиг места разгрузки");
				if(Checkpoint[COLLECTOR_JOB][playerid] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не начал работу инкассатора");
				if(Checkpoint[COLLECTOR_JOB][playerid] == 5) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже разгрузил фургон");
				if(Checkpoint[COLLECTOR_JOB][playerid] == 4)
				{
					DisablePlayerRaceCheckpoint(playerid);
					TogglePlayerControllable(playerid, false);
					SendClientMessage(playerid, COLOR_WHITE, "Разгрузка фургона началась...");
					SetTimerEx("RazgruzCollector", 10000, false, "i", playerid);
					Checkpoint[COLLECTOR_JOB][playerid] = 999;
					return true;
