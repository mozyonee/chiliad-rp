 else if(!strcmp(cmd, "/forest", true))
	{
		if(PlayerInfo[playerid][pJob] != FOREST_JOB) return SendClientMessage(playerid, COLOR_GREEN, "Ты не устроился на работу лесоруба");
		if(!IsPlayerAreaJob(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься на лесопилке");
		if(PlayerKarting[playerid] && PlayerInKart[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Участвуя в гонках на картинге, ты не можешь начать работу");
		if(Checkpoint[FOREST_JOB][playerid] == 0)
		{
			PlayerAmountPack[playerid] = 0;
			SendClientMessage(playerid, COLOR_WHITE, "Чтобы напилить брёвна, отправляйся к красному маркеру");
			SendClientMessage(playerid, COLOR_YELLOW, "Чтобы закончить работу вернешься обратно к раздевалки");
			Checkpoint[FOREST_JOB][playerid] = 1;
			SetPlayerSkin(playerid, 16);
			new rand = random(sizeof(gForestPoint));
			SetPlayerCheckpointEx(playerid, gForestPoint[rand][0], gForestPoint[rand][1], gForestPoint[rand][2], CHECKPOINT_PLAYER);
			RemovePlayerHat(playerid, false);
			RemovePlayerBandana(playerid, false);
		}
		else
		{
			if(PlayerAmountPack[playerid] <= 0)
			{
				SendClientMessage(playerid, COLOR_WHITE, "Ты ничего не заработал");
			}
			else
			{
				new zarplata = PlayerAmountPack[playerid]*30;
				PlayerInfo[playerid][pMoney] += zarplata;//Выдаем деньги ставим свое значение
				f(string, "Ты перетаскал брёвна и получил зарплату в размере {9DDAF2}%d$", zarplata);
				SendClientMessage(playerid, COLOR_WHITE, string);
			}
			PlayerAmountPack[playerid] = 0;
			Checkpoint[FOREST_JOB][playerid] = 0;
			SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
			DisablePlayerRaceCheckpoint(playerid);
			RemovePlayerAttachedObject(playerid, ATT_PACK);
			DeleteAnimation(playerid);
			if(PlayerInfo[playerid][pBandana] != 0)
			{
				SetPlayerBandana(playerid, PlayerInfo[playerid][pBandana]);
			}
			if(PlayerInfo[playerid][pHat] != 0)
			{
				SetPlayerHat(playerid, PlayerInfo[playerid][pHat]);
			}
		}
		return true;
	}

