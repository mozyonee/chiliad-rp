		else
		{
			GetPlayerTransfer[playerid] = INVALID_PLAYER_ID;
			if(GetOrganizationType(PlayerInfo[playerid][pMember]) == 2)
			{
				f(string, "Ты отказался от приглашения игрока {9DDAF2}%s{FFFFFF} вступить в банду {9DDAF2}%s", PlayerNameEx[frakid], GetOrganizationName(PlayerInfo[playerid][pMember]));
				SendClientMessage(playerid, COLOR_WHITE, string);
				f(string, "Игрок {9DDAF2}%s{FFFFFF} отказался от твого приглашения вступить в банду {9DDAF2}%s", PlayerNameEx[playerid], GetOrganizationName(PlayerInfo[playerid][pMember]));
				SendClientMessage(frakid, COLOR_WHITE, string);
			}
			if(GetOrganizationType(PlayerInfo[playerid][pMember]) == 1)
			{
				f(string, "Ты отказался от приглашения игрока {9DDAF2}%s{FFFFFF} вступить во фракцию {9DDAF2}%s", PlayerNameEx[frakid], GetOrganizationName(PlayerInfo[playerid][pMember]));
				SendClientMessage(playerid, COLOR_WHITE, string);
				f(string, "Игрок {9DDAF2}%s{FFFFFF} отказался от твого приглашения вступить во фракцию {9DDAF2}%s", PlayerNameEx[playerid], GetOrganizationName(PlayerInfo[playerid][pMember]));
				SendClientMessage(frakid, COLOR_WHITE, string);
			}
			if(GetOrganizationType(PlayerInfo[playerid][pMember]) == 3)
			{
				f(string, "Ты отказался от приглашения игрока {9DDAF2}%s{FFFFFF} вступить в мафию {9DDAF2}%s", PlayerNameEx[frakid], GetOrganizationName(PlayerInfo[playerid][pMember]));
				SendClientMessage(playerid, COLOR_WHITE, string);
				f(string, "Игрок {9DDAF2}%s{FFFFFF} отказался от твого приглашения вступить в мафию {9DDAF2}%s", PlayerNameEx[playerid], GetOrganizationName(PlayerInfo[playerid][pMember]));
				SendClientMessage(frakid, COLOR_WHITE, string);
			}
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(dialogid == ORGAN_ID+20)
	{
		if(response)
		{
			if(!PlayerMembersList[playerid]) return ShowPlayerMembersList(playerid, "Уволить игрока", 20);
			GetPlayerTransfer[playerid] = PlayerMemberName[playerid][listitem];
			f(string, "\
Ты действиетльно хочешь уволить игрока %s?\
", PlayerNameEx[GetPlayerTransfer[playerid]]);
			ShowDialog(playerid, ORGAN_ID+21, DIALOG_STYLE_MSGBOX, "Уволить игрока", string, "Уволить", "Назад");
		}
		else
		{
			ShowPlayerLeaderDialog(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(dialogid == ORGAN_ID+21)
	{
		if(response)
		{
			new giveplayerid = GetPlayerTransfer[playerid];
			if(PlayerInfo[giveplayerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок находится в тюрьме");
			if(PlayerInDuel[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок находится на дуэли");
			if(PlayerCuffed[giveplayerid] || PlayerTied[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок находится в наручниках или он связан");
			if(PlayerConvoi[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок находится под конвоем");
			PlayerInfo[giveplayerid][pLeader] = 0;
			PlayerInfo[giveplayerid][pMember] = 0;
			PlayerInfo[giveplayerid][pZam] = 0;
			PlayerInfo[giveplayerid][pRank] = 0;
			if(PlayerInfo[giveplayerid][pHouse] != 0) PlayerInfo[giveplayerid][pSpawn] = 1;
			else PlayerInfo[giveplayerid][pSpawn] = 0;
			if(GetOrganizationType(PlayerInfo[playerid][pMember]) == 2)
			{
				f(string, "Ты выгнал игрока {9DDAF2}%s{FFFFFF} из банды {9DDAF2}%s", PlayerNameEx[giveplayerid], GetOrganizationName(PlayerInfo[playerid][pMember]));
				SendClientMessage(playerid, COLOR_WHITE, string);
				f(string, "Тебя выгнал из банды {9DDAF2}%s{FFFFFF} игрок {9DDAF2}%s", GetOrganizationName(PlayerInfo[playerid][pMember]), PlayerNameEx[playerid]);
				SendClientMessage(giveplayerid, COLOR_WHITE, string);
			}
			if(GetOrganizationType(PlayerInfo[playerid][pMember]) == 1)
			{
				f(string, "Ты выгнал игрока {9DDAF2}%s{FFFFFF} из фракции {9DDAF2}%s", PlayerNameEx[giveplayerid], GetOrganizationName(PlayerInfo[playerid][pMember]));
				SendClientMessage(playerid, COLOR_WHITE, string);
				f(string, "Тебя выгнал из фракции {9DDAF2}%s{FFFFFF} игрок {9DDAF2}%s", GetOrganizationName(PlayerInfo[playerid][pMember]), PlayerNameEx[playerid]);
				SendClientMessage(giveplayerid, COLOR_WHITE, string);
			}
			if(GetOrganizationType(PlayerInfo[playerid][pMember]) == 3)
			{
				f(string, "Ты выгнал игрока {9DDAF2}%s{FFFFFF} из мафии {9DDAF2}%s", PlayerNameEx[giveplayerid], GetOrganizationName(PlayerInfo[playerid][pMember]));
				SendClientMessage(playerid, COLOR_WHITE, string);
				f(string, "Тебя выгнал из мафии {9DDAF2}%s{FFFFFF} игрок {9DDAF2}%s", GetOrganizationName(PlayerInfo[playerid][pMember]), PlayerNameEx[playerid]);
				SendClientMessage(giveplayerid, COLOR_WHITE, string);
			}
			RemovePlayerAllWeaponEx(giveplayerid);
			GetPlayerSavedPos(giveplayerid);
			if(PlayerInfo[giveplayerid][pSex] == 1)
			{
				SelectCharSkin[giveplayerid] = 1;
				SetPlayerSkin(giveplayerid, ClassMan[0]);
			}
			else if(PlayerInfo[giveplayerid][pSex] == 2)
			{
				SelectCharSkin[giveplayerid] = 1;
				SetPlayerSkin(giveplayerid, ClassWoman[0]);
			}
			PlayerInClothing[giveplayerid] = true;
			ShowMenuForPlayer(SkinMenu, giveplayerid);
			SetPlayerInterior(giveplayerid, 5);
			SetPlayerArmourEx(giveplayerid, 0);
			SetPlayerHealthEx(giveplayerid, 100);
			SetPlayerCameraLookAt(giveplayerid, 208.800, -1.0000, 1001.2100);
			SetPlayerCameraPos(giveplayerid, 208.800, -4.0000, 1001.2000);
			SetPlayerPos(giveplayerid, 208.800, -1.7000, 1001.2100);
			SetPlayerFacingAngle(giveplayerid, 180.0);
			TogglePlayerControllable(giveplayerid, false);
			SetPlayerVirtualWorld(giveplayerid, SKIN_MIR+giveplayerid);
		}
		else
		{
			ShowPlayerMembersList(playerid, "Уволить игрока", 20);
		}
		return true;
	}
	////////////////////////////////////////////////////////////////////////////


	//------------------------------------------------------------------------------

	else if(dialogid == ORGAN_ID+30)
	{
		if(response)
		{
			if(!PlayerMembersList[playerid]) return ShowPlayerMembersList(playerid, "Дать выговор", 30);
			new giveplayerid = PlayerMemberName[playerid][listitem];
			f(string, "Ты дал выговор игроку {9DDAF2}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Лидер {9DDAF2}%s{FFFFFF} дал тебе выговор", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
			PlayerInfo[giveplayerid][pVigovors] += 1;
		}
		else
		{
			ShowPlayerLeaderDialog(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(dialogid == ORGAN_ID+40)
	{
		if(response)
		{
			if(!PlayerMembersList[playerid]) return ShowPlayerMembersList(playerid, "Очистить выговоры", 40);
			new giveplayerid = PlayerMemberName[playerid][listitem];
			if(PlayerInfo[giveplayerid][pVigovors] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок не имеет выговоров");
			f(string, "Ты очистил все выговоры игрока {9DDAF2}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Лидер {9DDAF2}%s{FFFFFF} очистил все твои выговоры", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
			PlayerInfo[giveplayerid][pVigovors] = 0;
		}
		else
		{
			ShowPlayerLeaderDialog(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(dialogid == ORGAN_ID+50)
	{
		if(response)
		{
			if(!PlayerMembersList[playerid]) return ShowPlayerMembersList(playerid, "Установить ранг", 50, true);
			GetPlayerTransfer[playerid] = PlayerMemberName[playerid][listitem];
			f(string, "\
Введи ранг который ты хочешь установить игроку %s:\
", PlayerNameEx[GetPlayerTransfer[playerid]]);
			ShowDialog(playerid, ORGAN_ID+51, DIALOG_STYLE_INPUT, "Установить ранг", string, "Ок", "Назад");
		}
		else
		{
			ShowPlayerLeaderDialog(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(dialogid == ORGAN_ID+51)
	{
		if(response)
		{
			new giveplayerid = GetPlayerTransfer[playerid];
			new rank = strval(inputtext);
			if(rank < 1 || rank > 9)
			{
				f(string, "\
Введи ранг который ты хочешь установить игроку %s:\n\
{FF0000}Используй значение ранга от 1 до 9\
", PlayerNameEx[giveplayerid]);
				ShowDialog(playerid, ORGAN_ID+51, DIALOG_STYLE_INPUT, "Установить ранг", string, "Ок", "Назад");
				return true;
			}
			if(PlayerInfo[giveplayerid][pRank] == rank) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок уже имеет указанный тобой ранг");
			if(PlayerInfo[giveplayerid][pRank] < rank)
			{
				PlayerInfo[giveplayerid][pRank] = rank;
				if(giveplayerid == playerid)
				{
					f(string, "Ты повысил свой ранг до {9DDAF2}%s", GetPlayerRank(giveplayerid));
					SendClientMessage(playerid, COLOR_WHITE, string);
				}
				else
				{
					f(string, "Ты повысил ранг игрока {9DDAF2}%s{FFFFFF} до {9DDAF2}%s", PlayerNameEx[giveplayerid], GetPlayerRank(giveplayerid));
					SendClientMessage(playerid, COLOR_WHITE, string);
					f(string, "Лидер {9DDAF2}%s{FFFFFF} повысил твой ранг до {9DDAF2}%s", PlayerNameEx[playerid], GetPlayerRank(giveplayerid));
					SendClientMessage(giveplayerid, COLOR_WHITE, string);
				}
			}
			if(PlayerInfo[giveplayerid][pRank] > rank)
			{
				PlayerInfo[giveplayerid][pRank] = rank;
				if(giveplayerid == playerid)
				{
					f(string, "Ты понизил свой ранг до {9DDAF2}%s", GetPlayerRank(giveplayerid));
					SendClientMessage(playerid, COLOR_WHITE, string);
				}
				else
				{
					f(string, "Ты понизил ранг игрока {9DDAF2}%s{FFFFFF} до {9DDAF2}%s", PlayerNameEx[giveplayerid], GetPlayerRank(giveplayerid));
					SendClientMessage(playerid, COLOR_WHITE, string);
					f(string, "Лидер {9DDAF2}%s{FFFFFF} понизил твой ранг до {9DDAF2}%s", PlayerNameEx[playerid], GetPlayerRank(giveplayerid));
					SendClientMessage(giveplayerid, COLOR_WHITE, string);
				}
			}
		}
		else
		{
			ShowPlayerMembersList(playerid, "Установить ранг", 50, true);
		}
		return true;
	}

