			Игрок %s предлагает тебе освободиться из тюрьмы.\n\
			Стоимость: %d$\
			", PlayerNameEx[playerid], price);
			ShowDialog(giveplayerid, ADVOKAT_ID, DIALOG_STYLE_MSGBOX, "Предложение", string, "Да", "Нет");
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/prison", true))
	{
		if(PlayerInfo[playerid][pMember] != MERIA_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции кадрового агенства");
		if(PlayerInfo[playerid][pRank] < 2) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть второго ранга, чтобы узнавать статус игроков");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь узнавать статус игроков");
		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь узнавать статус игроков");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /prison [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(PlayerInfo[giveplayerid][pJailTime] == 0) f(string, "Игрок: {9DDAF2}%s{FFFFFF} Статус: {9DDAF2}На свободе", PlayerNameEx[giveplayerid]);
			else f(string, "Игрок: {9DDAF2}%s{FFFFFF} Статус: {9DDAF2}В тюрьме{FFFFFF} Осталось сидеть: {9DDAF2}%d{FFFFFF} минут.", PlayerNameEx[giveplayerid], ConvertTime(PlayerInfo[giveplayerid][pJailTime]));
			SendClientMessage(playerid, COLOR_WHITE, string);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}
	else if(!strcmp(cmd, "/frisk", true))
	{
		if(PlayerInfo[playerid][pMember] != PATRUL_ORG && PlayerInfo[playerid][pMember] != PATRUL_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата или дорожного патруля");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь обыскивать игроков");
		if(IsPlayerInAnyVehicle(playerid)) return MSG_INVEHICLE(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /frisk [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(PlayerInfo[giveplayerid][pMember] == PATRUL_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не можешь обыскивать полицейского");
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			f(string, "Ты обыскал игрока {9DDAF2}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Тебя обыскал полицейский {9DDAF2}%s", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
			new getgun[13], ammox;
			new guns_text[64];
			guns_text = "нету";
			for(new i=0; i<13; i++)
			{
				GetPlayerWeaponData(giveplayerid, i, getgun[i], ammox);
				if(getgun[i] != 0)
				{
					guns_text = "есть";
					break;
				}
			}
			f(string, "\
			{FFFF00}Деньги: {FFFFFF}%d$\n\
			{FFFF00}Наркотики: {FFFFFF}%d гр.\n\
			{FFFF00}Оружие: {FFFFFF}%s\n\
			{FFFF00}Материалы: {FFFFFF}%d",
			GetPlayerMoneyEx(giveplayerid), PlayerInfo[giveplayerid][pGrib], guns_text, PlayerInfo[giveplayerid][pMats]);
			ShowDialog(playerid, 00000, DIALOG_STYLE_MSGBOX, "Обыск игрока", string, "Закрыть", "");
			SetPlayerChatBubble(playerid, "Обыскал игрока", COLOR_AQUA, 30.0, 5000);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/takelic", true))
	{
		if(PlayerInfo[playerid][pMember] != TRANSPORT_ORG && !IsPlayerCop(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции которая может отбирать лицензии");
		if(PlayerInfo[playerid][pRank] < 4 && PlayerInfo[playerid][pMember] == TRANSPORT_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть четвёртого ранга, чтобы отбирать лицензии");
		if(PlayerInfo[playerid][pRank] < 2 && PlayerInfo[playerid][pMember] == PATRUL_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть второго ранга, чтобы отбирать лицензии");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь отбирать лицензии");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
		{
			SendClientMessage(playerid, COLOR_GREEN, "» Использование: /takelic [ id игрока ] [ номер лицензии ]");
			SendClientMessage(playerid, COLOR_GRAY, "| 1: Оружие | 2: Рыбалка");
			SendClientMessage(playerid, COLOR_GRAY, "| 3: Наземный трансопрт");
			SendClientMessage(playerid, COLOR_GRAY, "| 4: Водный трансопрт");
			SendClientMessage(playerid, COLOR_GRAY, "| 5: Воздушный трансопрт");
			return true;
		}
		giveplayerid = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
		{
			SendClientMessage(playerid, COLOR_GREEN, "» Использование: /takelic [ id игрока ] [ номер лицензии ]");
			SendClientMessage(playerid, COLOR_GRAY, "| 1: Оружие | 2: Рыбалка");
			SendClientMessage(playerid, COLOR_GRAY, "| 3: Наземный транспорт");
			SendClientMessage(playerid, COLOR_GRAY, "| 4: Водный транспорт");
			SendClientMessage(playerid, COLOR_GRAY, "| 5: Воздушный транспорт");
			SendClientMessage(playerid, COLOR_GRAY, "| 6: Добыча золота");
			return true;
		}
		new licenses = strval(tmp);
		if(licenses < 1 || licenses > 5) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верный номер лицензии. Используй номер от 1 до 5");
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			new lic_text[64];
			if(licenses == 1)
			{
				if(PlayerInfo[giveplayerid][pLicGun] == 0) return SendClientMessage(playerid, COLOR_GREEN, "У этого игрока нет указанной лицензии");
				PlayerInfo[giveplayerid][pLicGun] = 0;
				lic_text = "оружие";
			}
			if(licenses == 2)
			{
				if(PlayerInfo[giveplayerid][pLicFish] == 0) return SendClientMessage(playerid, COLOR_GREEN, "У этого игрока нет указанной лицензии");
				PlayerInfo[giveplayerid][pLicFish] = 0;
				lic_text = "рыбалку";
			}
			if(licenses == 3)
			{
				if(PlayerInfo[giveplayerid][pLicCar] == 0) return SendClientMessage(playerid, COLOR_GREEN, "У этого игрока нет указанной лицензии");
				PlayerInfo[giveplayerid][pLicCar] = 0;
				lic_text = "наземный транспорт";
			}
			if(licenses == 4)
			{
				if(PlayerInfo[giveplayerid][pLicBoat] == 0) return SendClientMessage(playerid, COLOR_GREEN, "У этого игрока нет указанной лицензии");
				PlayerInfo[giveplayerid][pLicBoat] = 0;
				lic_text = "водный транспорт";
			}
			if(licenses == 5)
			{
				if(PlayerInfo[giveplayerid][pLicFly] == 0) return SendClientMessage(playerid, COLOR_GREEN, "У этого игрока нет указанной лицензии");
				PlayerInfo[giveplayerid][pLicFly] = 0;
				lic_text = "воздушный транспорт";
			}
			if(licenses == 6)
			{
				if(PlayerInfo[giveplayerid][pLicGold] == 0) return SendClientMessage(playerid, COLOR_GREEN, "У этого игрока нет указанной лицензии");
				PlayerInfo[giveplayerid][pLicGold] = 0;
				lic_text = "воздушный транспорт";
			}
			if(PlayerInfo[playerid][pMember] == PATRUL_ORG)
			{
				f(string, "Полицейский {9DDAF2}%s{FFFFFF} отобрал у тебя лицензию на {9DDAF2}%s", PlayerNameEx[playerid], lic_text);
			}
			else
			{
				f(string, "Лицензер {9DDAF2}%s{FFFFFF} отобрал у тебя лицензию на {9DDAF2}%s", PlayerNameEx[playerid], lic_text);
			}
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
			f(string, "Ты отобрал лицензию на {9DDAF2}%s{FFFFFF} У гражданина {9DDAF2}%s", lic_text, PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/takegun", true) || !strcmp(cmd, "/takeguns", true))
	{
		if(PlayerInfo[playerid][pMember] != PATRUL_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата");
		if(PlayerInfo[playerid][pRank] < 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть третьего ранга, чтобы отбирать оружие");
		if(PlayerInDuel[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь на дуэли, ты не можешь отбирать оружие");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь отбирать оружие");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /takeguns [ id игрока ]");
		giveplayerid = strval(tmp);
		new bool:weapon;
		new getgun[13];
		new ammopragmaunused;
		for(new i=0; i<13; i++)
		{
			GetPlayerWeaponData(giveplayerid, i, getgun[i], ammopragmaunused);
			if(getgun[i] != 0)
			{
				weapon = true;
				break;
			}
		}
		if(!weapon) return SendClientMessage(playerid, COLOR_GREEN, "У этого игрока нет оружия");
		if(IsPlayerConnected(giveplayerid))
		{
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			RemovePlayerAllWeaponEx(giveplayerid);
			f(string, "Полицейский {F0EFD8}%s{FFFEBF} отобрал у тебя всё оружие.", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_CREAM, string);
			f(string, "Ты отобрал всё оружие У гражданина {F0EFD8}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_CREAM, string);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/takemats", true))
	{
		if(PlayerInfo[playerid][pMember] != PATRUL_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата");
		if(PlayerInfo[playerid][pRank] < 2) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть третьего ранга, чтобы отбирать материалы");
		if(PlayerInDuel[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь на дуэли, ты не можешь отбирать оружие");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь отбирать материалы");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /takemats [ id игрока ]");
		giveplayerid = strval(tmp);
		if(PlayerInfo[giveplayerid][pMats] == 0) return SendClientMessage(playerid, COLOR_GREEN, "У этого игрока нет материалов");
		if(IsPlayerConnected(giveplayerid))
		{
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			PlayerInfo[giveplayerid][pMats] = 0;
			f(string, "Полицейский {F0EFD8}%s{FFFEBF} отобрал у тебя все материалы.", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_CREAM, string);
			f(string, "Ты отобрал все материалы У гражданина {F0EFD8}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_CREAM, string);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/takedrugs", true))
	{
		if(PlayerInfo[playerid][pMember] != PATRUL_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата");
		if(PlayerInfo[playerid][pRank] < 2) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть третьего ранга, чтобы отбирать наркотики");
		if(PlayerInDuel[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь на дуэли, ты не можешь отбирать оружие");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь отбирать наркотики");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /takedrugs [ id игрока ]");
		giveplayerid = strval(tmp);
		if(PlayerInfo[giveplayerid][pGrib] == 0) return SendClientMessage(playerid, COLOR_GREEN, "У этого игрока нет наркотиков");
		if(IsPlayerConnected(giveplayerid))
		{
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			PlayerInfo[giveplayerid][pGrib] = 0;
			f(string, "Полицейский {F0EFD8}%s{FFFEBF} отобрал у тебя все наркотики.", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_CREAM, string);
			f(string, "Ты отобрал все наркотики У гражданина {F0EFD8}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_CREAM, string);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/r", true) || !strcmp(cmd, "/radio", true))
	{
		if(GetOrganizationType(PlayerInfo[playerid][pMember]) != 1) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься в какой-либо фракции");
		if(PlayerInfo[playerid][pMuteTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Твоё время молчанки ещё не истекло");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь говорить по рации");
		result = strrest(cmdtext, idx);
	  	if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: (/r)adio [ текст ]");
		f(string, "[ рация ] %s %s: {DEDA62}%s", GetPlayerRank(playerid), PlayerNameEx[playerid], result);
    	SendFamilyMessage(PlayerInfo[playerid][pMember], 0xBFB900FF, string);
		f(string, "{B17FC8}%s что-то говорит в рацию", PlayerNameEx[playerid]);
		SendDistanceChat(playerid, 20.0, string);
		return true;
	}

	else if(!strcmp(cmd, "/d", true) || !strcmp(cmd, "/deportament", true))
	{
		if(GetOrganizationType(PlayerInfo[playerid][pMember]) != 1) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься в какой-либо фракции");
		if(PlayerInfo[playerid][pMuteTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Твоё время молчанки ещё не истекло");
  		if(PlayerInfo[playerid][pMember] == HITMAN_ORG || PlayerInfo[playerid][pLeader] == HITMAN_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Террористы не могут писать в этот чат");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь говорить по рации");
		result = strrest(cmdtext, idx);
	  	if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: (/d)eportament [ текст ]");
		f(string, "[ департамент ] %s %s: {DEDA62}%s", GetPlayerRank(playerid), PlayerNameEx[playerid], result);
    	for(new i=0; i<GetMaxPlayers(); i++) if(IsPlayerConnected(i) && GetOrganizationType(PlayerInfo[i][pMember]) == 1) SendClientMessage(i, 0xBFB900FF, string);
		f(string, "{B17FC8}%s что-то говорит в рацию", PlayerNameEx[playerid]);
		SendDistanceChat(playerid, 20.0, string);
		return true;
	}
	else if(!strcmp(cmd, "/arrest", true))
	{
		if(PlayerInfo[playerid][pMember] != PATRUL_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата");
		if(PlayerInfo[playerid][pRank] < 2) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть второго ранга, чтобы арестовывать игроков");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь арестовывать игроков");
		if(!PlayerToPoint(playerid, 10, 611.0121,-583.7211,18.1124)) return SendClientMessage(playerid, COLOR_GREEN, "Ты находишься слишком далеко от тюремной камеры");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /arrest [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(IsPlayerCop(giveplayerid)) return MSG_COPACT(playerid);
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			if(GetPlayerWantedLevel(giveplayerid) == 0) return SendClientMessage(playerid, COLOR_GREEN, "У этого игрока нет розыска");
			PlayerInfo[giveplayerid][pJailed] += 1;
			PlayerInfo[playerid][pMoney] += 500;
			PlayerInfo[giveplayerid][pJailTime] = GetPlayerWantedLevel(giveplayerid)*300;
			f(string, "Полицейский {F5EFA4}%s{FFEE00} посадил преступника {F5EFA4}%s{FFEE00} в тюрьму на {F5EFA4}%s{FFEE00} минут.", PlayerNameEx[playerid], PlayerNameEx[giveplayerid], ConvertTime(PlayerInfo[giveplayerid][pJailTime]));
			SendClientMessageToAll(0xF0C392AA, string);
			f(string, "Тебя посадил в тюрьму полицейский {9DDAF2}%s{FFFFFF} на {9DDAF2}%s{FFFFFF} минут.", PlayerNameEx[playerid], ConvertTime(PlayerInfo[giveplayerid][pJailTime]));
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
			JailTimer[giveplayerid] = SetTimerEx("CountPlayerUnJail", 1000, true, "i", giveplayerid);
			if(PlayerConvoi[giveplayerid])
			{
				PlayerConvoi[giveplayerid] = false;
				GetPlayerConvoi[giveplayerid] = INVALID_PLAYER_ID;
				DeleteAnimation(giveplayerid);
			}
			if(PlayerCuffed[giveplayerid])
			{
				PlayerCuffed[giveplayerid] = false;
				SetPlayerCuffed(giveplayerid, false);
				TogglePlayerControllable(giveplayerid, true);
			}
			SpawnPlayerInJail(giveplayerid);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/tazer", true))
	{
		if((PlayerInfo[playerid][pMember] != MERIA_ORG || PlayerInfo[playerid][pRank] != 1) && !IsPlayerCop(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата или дорожного патруля");
		if(PlayerInfo[playerid][pRank] < 3 && PlayerInfo[playerid][pMember] == PATRUL_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть третьего ранга, чтобы применять электрошокер");
		if(IsPlayerInAnyVehicle(playerid)) return MSG_INVEHICLE(playerid);
		if(PlayerInDuel[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь на дуэли, ты не можешь применять электрошокер");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь применять электрошокер");
		if(PlayerUseElectro[playerid] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Подожди пока заряд электрошокера восстановится");
		giveplayerid = GetClosestPlayer(playerid);
		if(giveplayerid != INVALID_VEHICLE_ID
				&& !IsPlayerCop(giveplayerid)
				&& GetDistancePlayers(playerid, giveplayerid) <= 3.0
				&& GetPlayerWeapon(giveplayerid) == 0
				&& !IsPlayerInAnyVehicle(giveplayerid))
		{
			f(string, "Ты применил электрошокер к игроку {9DDAF2}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Полицейский {9DDAF2}%s{FFFFFF} применил к тебе электрошокер.", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
			TogglePlayerControllable(giveplayerid, false);
			ToggleAnimation(giveplayerid, "CRACK", "crckdeth2");
			PlayerUseElectro[playerid] = 60;
			PlayerOnElectro[giveplayerid] = 10;
		}
		else
		{
			SendClientMessage(playerid, COLOR_GREEN, "Поблизости нет игроков, к которым ты можешь применить электрошокер");
		}
		return true;
	}

	else if(!strcmp(cmd, "/cuff", true))
	{
		if((PlayerInfo[playerid][pMember] != MERIA_ORG || PlayerInfo[playerid][pRank] != 1) && !IsPlayerCop(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата или Пограничники");
		if(PlayerInfo[playerid][pRank] < 2 && PlayerInfo[playerid][pMember] != MERIA_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть второго ранга, чтобы одевать наручники");
		if(PlayerInDuel[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь на дуэли, ты не можешь одевать наручники");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь одевать наручники");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /cuff [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			if(IsPlayerInAnyVehicle(giveplayerid)) return SendClientMessage(playerid, COLOR_GREEN, "Указанный тобой игрок находится в машине");
			if(IsPlayerCop(giveplayerid)) return MSG_COPACT(playerid);
			if(PlayerCuffed[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "На этом игроке уже одеты наручники");
			f(string, "Ты одел наручнки на игрока {9DDAF2}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Полицейский {9DDAF2}%s{FFFFFF} одел на тебя наручники.", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
			GameTextForPlayer(giveplayerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~CUFFED", 3000, 3);
			PlayerCuffed[giveplayerid] = true;
			SetPlayerCuffed(giveplayerid, true);
			TogglePlayerControllable(giveplayerid, false);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/uncuff", true))
	{
		if((PlayerInfo[playerid][pMember] != MERIA_ORG || PlayerInfo[playerid][pRank] != 1) && !IsPlayerCop(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата или дорожного патруля");
		if(PlayerInfo[playerid][pRank] < 2 && PlayerInfo[playerid][pMember] != MERIA_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть второго ранга, чтобы снимать наручники");
		if(PlayerInDuel[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь на дуэли, ты не можешь снимать наручники");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь снимать наручники");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /uncuff [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			if(!PlayerCuffed[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "На этом игроке не одеты наручники");
			f(string, "Ты снял наручнки с игрока {9DDAF2}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Полицейский {9DDAF2}%s{FFFFFF} снял с тебя наручники.", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
			GameTextForPlayer(giveplayerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~UNCUFFED", 3000, 3);
			PlayerCuffed[giveplayerid] = false;
			SetPlayerCuffed(giveplayerid, false);
			TogglePlayerControllable(giveplayerid, true);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/drag", true))
	{
		if((PlayerInfo[playerid][pMember] != MERIA_ORG || PlayerInfo[playerid][pRank] != 1) && PlayerInfo[playerid][pMember] != PATRUL_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата");
		if(PlayerInfo[playerid][pRank] < 2 && PlayerInfo[playerid][pMember] != MERIA_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть второго ранга, чтобы брать игроков под конвой");
		if(PlayerInDuel[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь на дуэли, ты не можешь брать игроков под конвой");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь брать игроков под конвой");
		if(IsPlayerInAnyVehicle(playerid)) return MSG_INVEHICLE(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /drag [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(IsPlayerCop(giveplayerid)) return MSG_COPACT(playerid);
			if(IsPlayerInAnyVehicle(giveplayerid)) return SendClientMessage(playerid, COLOR_GREEN, "Указанный тобой игрок находиться в машине");
			if(PlayerConvoi[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "Указанный тобой игрок уже под конвоем");
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			if(!PlayerCuffed[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "На указанном тобой игроке не надеты наручники");
			f(string, "Ты взял под конвой игрока {9DDAF2}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Полицейский {9DDAF2}%s{FFFFFF} взял тебя под конвой.", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
			PlayerConvoi[giveplayerid] = true;
			GetPlayerConvoi[giveplayerid] = playerid;
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/undrag", true))
	{
		if((PlayerInfo[playerid][pMember] != MERIA_ORG || PlayerInfo[playerid][pRank] != 1) && PlayerInfo[playerid][pMember] != PATRUL_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата");
		if(PlayerInfo[playerid][pRank] < 2 && PlayerInfo[playerid][pMember] != MERIA_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть второго ранга, чтобы брать игроков под конвой");
		if(PlayerInDuel[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь на дуэли, ты не можешь брать игроков под конвой");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь брать игроков под конвой");
		if(IsPlayerInAnyVehicle(playerid)) return MSG_INVEHICLE(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /undrag [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(IsPlayerInAnyVehicle(giveplayerid)) return SendClientMessage(playerid, COLOR_GREEN, "Указанный тобой игрок находиться в машине");
			if(!PlayerConvoi[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "Указанный тобой игрок не под конвоем");
			f(string, "Ты выпустил из под конвоя игрока {9DDAF2}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Полицейский {9DDAF2}%s{FFFFFF} выпустил тебя из под конвоя.", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
			PlayerConvoi[giveplayerid] = false;
			GetPlayerConvoi[giveplayerid] = INVALID_PLAYER_ID;
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/alco", true))
	{
		if(!IsPlayerCop(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата или дорожного патруля");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь проверять игроков на алкоголь");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /alco [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			if(GetPlayerDrunkLevel(giveplayerid) > 0)
			{
				f(string, "В игроке {9DDAF2}%s{FFFFFF} обнаружен алкоголь.", PlayerNameEx[giveplayerid]);
				SendClientMessage(playerid, COLOR_WHITE, string);
			}
			else
			{
				f(string, "В игроке {9DDAF2}%s{FFFFFF} алкоголь не обнаружен.", PlayerNameEx[giveplayerid]);
				SendClientMessage(playerid, COLOR_WHITE, string);
			}
			f(string, "Полицейский {9DDAF2}%s{FFFFFF} проверил тебя на алкоголь.", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/rem", true))
	{
		if(PlayerInfo[playerid][pMember] != PATRUL_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции дорожного патруля");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь проверять ремень бехопасности у игроков");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /rem [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(GetDistancePlayers(playerid, giveplayerid) > 10.0) return MSG_BIGDIST(playerid);
			if(!IsPlayerInAnyVehicle(giveplayerid)) return SendClientMessage(playerid, COLOR_GREEN, "Указанный тобой игрок не находиться в машине");
			if(PlayerOnRemen[giveplayerid])
			{
				f(string, "Игрок {9DDAF2}%s{FFFFFF} пристёгнут ремнём безопасности.", PlayerNameEx[giveplayerid]);
				SendClientMessage(playerid, COLOR_WHITE, string);
			}
			else
			{
				f(string, "Игрок {9DDAF2}%s{FFFFFF} не пристёгнут ремнём безопасности.", PlayerNameEx[giveplayerid]);
				SendClientMessage(playerid, COLOR_WHITE, string);
			}
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/strip", true))
	{
		if(PlayerInfo[playerid][pMember] != PATRUL_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции  дорожного патруля");
		if(PlayerInfo[playerid][pRank] < 2) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть второго ранга, чтобы управлять шипами на дорогах");
		SeccureAnimation(playerid, "BOMBER", "BOM_Plant_Loop");
		if(GetPlayerStrip[playerid] == -1)
		{
			new Float:POS[4];
			GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
			GetPlayerFacingAngle(playerid, POS[3]);
			for(new i=0; i<MAX_SPIKES; i++)
			{
				if(SpikesInfo[i][ssCreated] == 0)
				{
					SpikesInfo[i][ssCreated] = 1;
					SpikesInfo[i][ssPos][0] = POS[0];
					SpikesInfo[i][ssPos][1] = POS[1];
					SpikesInfo[i][ssPos][2] = POS[2]-0.7;
					SpikesInfo[i][ssObject] = CreateObject(2892, POS[0], POS[1], POS[2]-0.9, 0.0, 0.0, POS[3]-90);
					GetPlayerStrip[playerid] = i;
					break;
				}
			}
		}
		else
		{
			new i = GetPlayerStrip[playerid];
			if(!PlayerToPoint(playerid, 5.0, SpikesInfo[i][ssPos][0], SpikesInfo[i][ssPos][1], SpikesInfo[i][ssPos][2])) return SendClientMessage(playerid, COLOR_GREEN, "Ты находешься слишком далеко от установленных тобой шипов");
			DeletePlayerStrip(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/incar", true))
	{
		if(!IsPlayerCop(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата или дорожного патруля");
		if(PlayerInfo[playerid][pRank] < 2)return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть второго ранга, чтобы затаскивать игроков в машины");
		if(PlayerInDuel[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь на дуэли, ты не можешь затаскивать игроков в машины");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь затаскивать игроков в машины");
		if(IsPlayerInAnyVehicle(playerid)) return MSG_INVEHICLE(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /incar [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			if(IsPlayerCop(giveplayerid)) return MSG_COPACT(playerid);
			if(IsPlayerInAnyVehicle(giveplayerid)) return SendClientMessage(playerid, COLOR_GREEN, "Указанный тобой игрок уже находиться в машине");
			new vehicleid = INVALID_VEHICLE_ID;
			new Float:POS[3];
			for(new i=0; i<MAX_VEHICLES; i++)
			{
				GetVehiclePos(i, POS[0], POS[1], POS[2]);
				if(PlayerToPoint(playerid, 3.0, POS[0], POS[1], POS[2]))
				{
					vehicleid = i;
					break;
				}
			}
			if(vehicleid != INVALID_VEHICLE_ID)
			{
				if(VehicleLock[vehicleid]) return SendClientMessage(playerid, COLOR_GREEN, "Близжайщее транспортное средство закрыто на замок");
				new bool:seat[4],getter = 999;
				for(new i=0; i<GetMaxPlayers(); i++)
				{
					if(IsPlayerConnected(i) && GetPlayerVehicleID(i) == vehicleid)
					{
						if(GetPlayerVehicleSeat(i) == 1) seat[1] = true;
						else if(GetPlayerVehicleSeat(i) == 2) seat[2] = true;
						else if(GetPlayerVehicleSeat(i) == 3) seat[3] = true;
					}
				}
				for(new i=1; i<4; i++)
				{
					if(!seat[i])
					{
						getter = i;
						break;
					}
				}
				if(getter == 999) return SendClientMessage(playerid, COLOR_GREEN, "В этой машине нет свободных мест");
				f(string, "Полицейский {9DDAF2}%s{FFFFFF} затащил тебя в машину.", PlayerNameEx[playerid]);
				SendClientMessage(giveplayerid, COLOR_WHITE, string);
				f(string, "Ты затащил в машину гражданина {9DDAF2}%s", PlayerNameEx[giveplayerid]);
				SendClientMessage(playerid, COLOR_WHITE, string);
				PutPlayerInVehicle(giveplayerid, vehicleid, getter);
			}
			else
			{
				SendClientMessage(playerid, COLOR_GREEN, "Ты находишься далеко от машины");
			}
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/wanted", true) || !strcmp(cmd, "/wanteds", true))
	{
		if(!IsPlayerCop(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата или дорожного патруля");
		new want_text[256],want;
		for(new i=0; i<GetMaxPlayers(); i++)
		{
			if(IsPlayerConnected(i) && GetPlayerWantedLevel(i) > 0)
			{
				f(want_text, "{FFFFFF}ID: {9DDAF2}%d {FFFFFF}| Имя: {9DDAF2}%s {FFFFFF}| Количество звёзд: {9DDAF2}%d\n", i, PlayerNameEx[i], GetPlayerWantedLevel(i));
				strcat(string, want_text); want += 1;
			}
		}
		if(want == 0) f(string, "{FF0000}Список подозреваемых пуст");
		ShowDialog(playerid, 00000, DIALOG_STYLE_MSGBOX, "Список подозреваемых", string, "Закрыть", "");
		return true;
	}

	else if(!strcmp(cmd, "/m", true) || !strcmp(cmd, "/megafon", true))
	{
		if(!IsPlayerCop(playerid) && PlayerInfo[playerid][pMember] != MEDIC_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции, которая может использовать рупор");
		if(PlayerInfo[playerid][pMuteTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Твоё время молчанки ещё не истекло");
		if(!IsMedicCar(GetPlayerVehicleID(playerid)) && PlayerInfo[playerid][pMember] == MEDIC_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься в служебном транспорте");
		if(!IsPatrulCar(GetPlayerVehicleID(playerid)) && PlayerInfo[playerid][pMember] == PATRUL_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься в служебном транспорте");
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: (/m)egafon [ текст ]");
		f(string, "{FFEE00}[ рупор ] %s: {FFFBBD}%s", PlayerNameEx[playerid], result);
		SendDistanceChat(playerid, 50.0, string);
		return true;
	}

	else if(!strcmp(cmd, "/ticket", true))
	{
		if(!IsPlayerCop(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата или дорожного патруля");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь выписывать штрафы");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /ticket [ id игрока ] [ штраф ] [ нарушение ]");
		giveplayerid = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /ticket [ id игрока ] [ штраф ] [ нарушение ]");
		new price = strval(tmp);
		if(price < 100 || price > 10000) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верный штраф. Используй штраф от 100$ до 10000$");
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /ticket [ id игрока ] [ штраф ] [ нарушение ]");
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(IsPlayerCop(giveplayerid)) return MSG_COPACT(playerid);
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			if(price > GetPlayerMoneyEx(giveplayerid)) return SendClientMessage(playerid, COLOR_GREEN, "Нарушителю не хватает денег на оплату штрафа");
			f(string, "Ты выписал штраф игроку {9DDAF2}%s{FFFFFF} на {9DDAF2}%d${FFFFFF} по причине: {9DDAF2}%s", PlayerNameEx[giveplayerid], price, result);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "\
			Полицейский %s выписал тебе штраф на %d$\n\
			Нарушение: %s\n\
			Оплатить штраф?\
			", PlayerNameEx[playerid], price, result);
			ShowDialog(giveplayerid, TICKET_ID, DIALOG_STYLE_MSGBOX, "Штраф", string, "Да", "Нет");
			GetPlayerTransfer[giveplayerid] = playerid;
			GetPlayerOption[giveplayerid] = price;
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/suspect", true) || !strcmp(cmd, "/su", true))
	{
		if(!IsPlayerCop(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата или дорожного патруля");
		if(PlayerInfo[playerid][pRank] < 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть третьего ранга, чтобы давать звёзды");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь давать звёзды");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: (/su)spect [ id игрока ] [ количество звёзд ] [ причина ]");
		giveplayerid = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: (/su)spect [ id игрока ] [ количество звёзд ] [ причина ]");
		new wanted = strval(tmp);
		if(wanted < 0 || wanted > 6) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верное количество звёзд. Используй количество от 0 до 6");
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: (/su)spect [ id игрока ] [ количество звёзд ] [ причина ]");
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(IsPlayerCop(giveplayerid)) return MSG_COPACT(playerid);
			f(string, "Ты дал {9DDAF2}%d{FFFFFF} звёзд игроку {9DDAF2}%s", wanted, PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			SetPlayerCriminal(giveplayerid, wanted, result, playerid);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/clear", true))
	{
		if(PlayerInfo[playerid][pMember] != PATRUL_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата");
		if(PlayerInfo[playerid][pRank] < 4) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть четвёртого ранга, чтобы очищать уровень розыска");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь очищать уровень розыска");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /clear [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(IsPlayerCop(giveplayerid)) return MSG_COPACT(playerid);
			if(GetPlayerWantedLevel(giveplayerid) == 0) return SendClientMessage(playerid, COLOR_GREEN, "У этого игрока нет уровеня розыска");
			f(string, "Ты очистил уровень розыска У гражданина {9DDAF2}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Полицейский {9DDAF2}%s{FFFFFF} очистил твой уровень розыска.", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
			SetPlayerWantedLevel(giveplayerid, 0);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}
	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/number", true))
	{
		if(PlayerInfo[playerid][pPhBook] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не приобрёл телефонную книжку");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "На время пребывания в тюрьме, твоя телефонная книжка была изъята");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /number [ id игрока ]");
		giveplayerid = strval(tmp);
		if(giveplayerid == playerid) return MSG_NOMEACT(playerid);
		if(IsPlayerConnected(giveplayerid))
		{
			if(PlayerInfo[giveplayerid][pPhNumber] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Данный игрок не имеет телефона");
			f(string, "Игрок: {9DDAF2}%s{FFFFFF} Номер телефона: {9DDAF2}%d", PlayerNameEx[giveplayerid], PlayerInfo[giveplayerid][pPhNumber]);
			SendClientMessage(playerid, COLOR_WHITE, string);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/phone", true))
	{
		if(PlayerInfo[playerid][pPhNumber] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не приобрёл сотовый телефон");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "На время пребывания в тюрьме, твой телефон был изъят");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /phone [ вид телефона ]");
		new type = strval(tmp);
		if(type < 1 || type > 10) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верный вид телефона. Используй вид от 1 до 10");
		switch(type)
		{
		case 1: PlayerInfo[playerid][pPhStyle] = 18865;
		case 2: PlayerInfo[playerid][pPhStyle] = 18866;
		case 3: PlayerInfo[playerid][pPhStyle] = 18867;
		case 4: PlayerInfo[playerid][pPhStyle] = 18868;
		case 5: PlayerInfo[playerid][pPhStyle] = 18869;
		case 6: PlayerInfo[playerid][pPhStyle] = 18870;
		case 7: PlayerInfo[playerid][pPhStyle] = 18871;
		case 8: PlayerInfo[playerid][pPhStyle] = 18872;
		case 9: PlayerInfo[playerid][pPhStyle] = 18873;
		case 10: PlayerInfo[playerid][pPhStyle] = 18874;
		}
		SendClientMessage(playerid, COLOR_WHITE, "Ты успешно сменил вид телефона");
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/sms", true))
	{
		if(PlayerInfo[playerid][pPhNumber] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не приобрёл сотовый телефон");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "На время пребывания в тюрьме, твой телефон был изъят");
		if(BusinessInfo[PHONE_BIZZ][bFunds] < 1) return SendClientMessage(playerid, COLOR_GREEN, "В бизнесе мобильной связи не хватает сырья");
		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь писать сообщения");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /sms [ номер телефона ] [ текст ]");
		new phone = strval(tmp);
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /sms [ номер телефона ] [ текст ]");
		if(PlayerInfo[playerid][pPhNumber] == phone) return SendClientMessage(playerid, COLOR_GREEN, "Ты не можешь отослать sms самому себе");
		giveplayerid = 999;
		for(new i=0; i<GetMaxPlayers(); i++)
		{
			if(IsPlayerConnected(i))
			{
				if(PlayerInfo[i][pPhNumber] == phone && phone != 0)
				{
					giveplayerid = i;
					break;
				}
			}
		}
		if(giveplayerid != 999)
		{
			if(PlayerInfo[playerid][pPhBalance] < 1) return SendClientMessage(playerid, COLOR_GREEN, "Не достаточно денег на телефоне");
			if(PlayerInfo[giveplayerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Этот абонент временно не доступен");
			PlayerInfo[playerid][pPhBalance] -= 1;
			BusinessInfo[PHONE_BIZZ][bBalance] += 1;
			BusinessInfo[PHONE_BIZZ][bFunds] -= 1;
			f(string, "SMS: {4AC1F0}%s{09A3E0} [ получатель: {4AC1F0}%s{09A3E0} | т. {4AC1F0}%d{09A3E0} ]", result, PlayerNameEx[giveplayerid], phone);
			SendClientMessage(playerid, 0x09A3E0FF, string);
			f(string, "SMS: {4AC1F0}%s{09A3E0} [ отправитель: {4AC1F0}%s{09A3E0} | т. {4AC1F0}%d{09A3E0} ]", result, PlayerNameEx[playerid], PlayerInfo[playerid][pPhNumber]);
			SendClientMessage(giveplayerid, 0x09A3E0FF, string);
			SetPlayerChatBubble(giveplayerid, "Получил смс", COLOR_AQUA, 30.0, 5000);
			SetPlayerChatBubble(playerid, "Отправил смс", COLOR_AQUA, 30.0, 5000);
		}
		else
		{
			SendClientMessage(playerid, COLOR_GREEN, "Игрок с указанным тобой телефоном не найден");
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/call", true))
	{
		if(PlayerInfo[playerid][pPhNumber] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не приобрёл сотовый телефон");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "На время пребывания в тюрьме, твой телефон был изъят");
		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь звонить на телефоны");
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /call [ номер телефона ]");
		if(PlayerInfo[playerid][pPhNumber] == strval(result)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не можешь позвонить самому себе");
		if(!strcmp(result, "100", true) || !strcmp(result, "*100#", true))
		{
			f(string, "На твоём счету телефона {9DDAF2}%s", ConvertMoney(PlayerInfo[playerid][pPhBalance]));
			SendClientMessage(playerid, COLOR_WHITE, string);
			return true;
		}
		if(!strcmp(result, "110", true) || !strcmp(result, "*110#", true))
		{
			new hours, minutes, seconds, year, month, day;
			gettime(hours, minutes, seconds);
			getdate(year, month, day);
			f(string, "Точная дата: {9DDAF2}%s%d/%s%d/%d", (day < 10) ? ("0") : (""), day, (month < 10) ? ("0") : (""), month, year);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Точное время: {9DDAF2}%s%d:%s%d:%s%d", (hours < 10) ? ("0") : (""), hours, (minutes < 10) ? ("0") : (""), minutes, (seconds < 10) ? ("0") : (""), seconds);
			SendClientMessage(playerid, COLOR_WHITE, string);
			return true;
		}
		if(!strcmp(result, "911", true) || !strcmp(result, "*911#", true))
		{
			PlayerUsePhone(playerid, true);
			ShowDialog(playerid, CALL_ID, DIALOG_STYLE_LIST, "Выберите кому звонить:", "\
			[1] Механики\n\
			[2] Нет\n\
			[3] Больница Red Country\n\
			[4] Полиция Red Country\n\
			[5] Пожарная часть\n\
			[6] Такси\
			", "Выбрать", "Отмена");
			return true;
		}
		if(strlen(result) < 6)
		{
			ShowDialog(playerid, 00000, DIALOG_STYLE_MSGBOX, "Справочноя", "{FF0000}\
			Ты указал не корректный номер!\n\n\
			{94E01B}*911#{FFFFD4} - звонок в службу спасения\n\
			{94E01B}*100#{FFFFD4} - проверить баланс телефона\n\
			{94E01B}*110#{FFFFD4} - узнать точное время и дату\
			", "Закрыть", "");
			return true;
		}
		new phone = strval(result);
		if(phone == 555555)
		{
			if(PlayerInfo[playerid][pPhBalance] < 1) return SendClientMessage(playerid, COLOR_GREEN, "Не достаточно денег на телефоне");
			if(PlayerCalledEx[playerid] || PlayerCalled[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже кому-то звонишь");
			SendClientMessage(playerid, COLOR_PINK, "Ты успешно вызвал такси. Дождись принятия вызова");
			f(string, "[ вызов ] Игрок {D8F2DC}%s{C0EDC8} вызывает такси [ район: {D8F2DC}%s{C0EDC8} | id: {D8F2DC}%d {C0EDC8}]", PlayerNameEx[playerid], GetPlayerZone(playerid), playerid);
			PlayerCalledTaxi[playerid] = true;
			SetTimerEx("RemovePlayerCallTaxi", 120000, false, "i", playerid);
			for(new i=0; i<GetMaxPlayers(); i++)
			{
				if(IsPlayerConnected(i))
				{
					if(PlayerInfo[i][pJob] == TAXI_JOB && TaxiJobStarted[i])
					{
						SendClientMessage(i, 0xC0EDC8FF, string);
						SendClientMessage(i, COLOR_GRAY, "Чтобы принять вызов используй команду {FFFFFF}/acctaxi");
					}
				}
			}
			return true;
		}
		giveplayerid = 999;
		for(new i=0; i<GetMaxPlayers(); i++)
		{
			if(IsPlayerConnected(i))
			{
				if(PlayerInfo[i][pPhNumber] == phone && phone != 0)
				{
					giveplayerid = i;
					break;
				}
			}
		}
		if(giveplayerid != 999)
		{
			if(PlayerInfo[playerid][pPhBalance] < 1) return SendClientMessage(playerid, COLOR_GREEN, "Не достаточно денег на телефоне");
			if(PlayerCalledEx[playerid] || PlayerCalled[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже кому-то звонишь");
			if(PlayerInfo[giveplayerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Этот абонент временно не доступен");
			GetPlayerCalled[playerid] = giveplayerid;
			GetPlayerCalled[giveplayerid] = playerid;
			PlayerCallMode[playerid] = 1;
			PlayerCallMode[giveplayerid] = 1;
			PlayerCalledEx[playerid] = true;
			SetPlayerChatBubble(playerid, "Звонит кому-то", COLOR_AQUA, 30.0, 5000);
			PlayerUsePhone(playerid, true);
			f(string, "Ты звонишь игроку {9DDAF2}%s{FFFFFF} на телефон {9DDAF2}%d", PlayerNameEx[giveplayerid], phone);
			SendClientMessage(playerid, COLOR_WHITE, string);
			SendClientMessage(playerid, COLOR_GRAY, "Чтобы положить трубку используй команду {FFFFFF}/h {DEDEDE}| чтобы взять {FFFFFF}/p");
			f(string, "Тебе звонить игрок {9DDAF2}%s{FFFFFF} с телефона {9DDAF2}%d", PlayerNameEx[playerid], PlayerInfo[playerid][pPhNumber]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
			SendClientMessage(giveplayerid, COLOR_GRAY, "Чтобы положить трубку используй команду {FFFFFF}/h {DEDEDE}| чтобы взять {FFFFFF}/p");
		}
		else
		{
			SendClientMessage(playerid, COLOR_GREEN, "Игрок с указанным тобой телефоном не найден");
		}
		return true;
	}

	//------------------------------------------------------------------------------
    else if(!strcmp(cmd, "/mp3", true))
	{
		if(PlayerInfo[playerid][pRPlayer] == 0) return SendClientMessage(playerid, COLOR_GREEN, "У тебя нет плеера его можна приобрести в магазине 24/7");
		PlayAudioStreamForPlayer(playerid,"http://listen2.myradio24.com:9000/8000");
		ApplyAnimation(playerid,"goggles","goggles_put_on",4.1,0,0,0,0,0,1);
		SetPlayerAttachedObject(playerid, 8, 19422, 2, 0.030000, -0.017000, -0.004000, -90.199958, 6.199999, -95.299995, 0.996999, 1.003000, 0.862999);
		f(string, "{B17FC8}%s надел наушники", PlayerNameEx[playerid]);
		SendDistanceChat(playerid, 20.0, string);
		f(string, "{B17FC8}%s включил музыку в плеере", PlayerNameEx[playerid]);
		SendDistanceChat(playerid, 20.0, string);
		return true;
	}
	else if(!strcmp(cmd, "/mp3off", true))
	{
		if(PlayerInfo[playerid][pRPlayer] == 0) return SendClientMessage(playerid, COLOR_GREEN, "У тебя нет плеера его можна приобрести в магазине 24/7");
		StopAudioStreamForPlayer(playerid);
		RemovePlayerAttachedObject(playerid, 0);
		f(string, "{B17FC8}%s выключил музыку в плеере", PlayerNameEx[playerid]);
		SendDistanceChat(playerid, 20.0, string);
		return true;
	}
	//--------------------------------------------------------------------------
	else if(!strcmp(cmd, "/p", true))
	{
		if(PlayerInfo[playerid][pPhNumber] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не приобрёл сотовый телефон");
		if(GetPlayerCalled[playerid] == INVALID_PLAYER_ID || GetPlayerCalled[playerid] == 911
				|| GetPlayerCalled[playerid] == 1000 || GetPlayerCalled[playerid] == 2000) return SendClientMessage(playerid, COLOR_GREEN, "Тебе никто не звонил");
		if(PlayerCalledEx[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже кому-то звонишь");
		giveplayerid = GetPlayerCalled[playerid];
		PlayerCalled[giveplayerid] = true;
		PlayerUsePhone(playerid, true);
		f(string, "Разговор с игроком {9DDAF2}%s{FFFFFF} начался.", PlayerNameEx[giveplayerid]);
		SendClientMessage(playerid, COLOR_WHITE, string);
		SendClientMessage(playerid, COLOR_GRAY, "Чтобы сказать по телефону используй команду {FFFFFF}/t");
		f(string, "Разговор с игроком {9DDAF2}%s{FFFFFF} начался.", PlayerNameEx[playerid]);
		SendClientMessage(giveplayerid, COLOR_WHITE, string);
		SendClientMessage(giveplayerid, COLOR_GRAY, "Чтобы сказать по телефону используй команду {FFFFFF}/t");
		PlayerCallMode[playerid] = 2;
		PlayerCallMode[giveplayerid] = 2;
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/h", true))
	{
		if(PlayerInfo[playerid][pPhNumber] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не приобрёл сотовый телефон");
		if(GetPlayerCalled[playerid] == INVALID_PLAYER_ID || GetPlayerCalled[playerid] == 911) return SendClientMessage(playerid, COLOR_GREEN, "Тебе никто не звонил");
		giveplayerid = GetPlayerCalled[playerid];
		PlayerCalled[giveplayerid] = false;
		PlayerCalledEx[giveplayerid] = false;
		PlayerCalled[playerid] = false;
		PlayerCalledEx[playerid] = false;
		GetPlayerCalled[giveplayerid] = INVALID_PLAYER_ID;
		GetPlayerCalled[playerid] = INVALID_PLAYER_ID;
		if(PlayerCallMode[playerid] == 2)
		{
			SendClientMessage(playerid, COLOR_WHITE, "Ты положил трубку");
			f(string, "Игрок {9DDAF2}%s{FFFFFF} положил трубку.", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
		}
		else
		{
			SendClientMessage(playerid, COLOR_WHITE, "Ты отклонил звонок");
			f(string, "Игрок {9DDAF2}%s{FFFFFF} отклонил звонок.", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
		}
		PlayerUsePhone(playerid, false);
		PlayerUsePhone(giveplayerid, false);
		PlayerCallMode[playerid] = 0;
		PlayerCallMode[giveplayerid] = 0;
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/t", true))
	{
		if(PlayerInfo[playerid][pPhNumber] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не приобрёл сотовый телефон");
		if(GetPlayerCalled[playerid] == INVALID_PLAYER_ID || GetPlayerCalled[playerid] == 911) return SendClientMessage(playerid, COLOR_GREEN, "Тебе никто не звонил");
		if(PlayerCallMode[playerid] == 1) return SendClientMessage(playerid, COLOR_GREEN, "Те ещё не взял трубку");
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /t [ текст ]");
		giveplayerid = GetPlayerCalled[playerid];
		if(PlayerCallMode[playerid] == 2)
		{
			f(string, "[ телефон ] %s:{E069BB} %s", PlayerNameEx[playerid], result);
			SendClientMessage(playerid, 0xD41E9AFF, string);
			f(string, "[ телефон ] %s:{E069BB} %s", PlayerNameEx[playerid], result);
			SendClientMessage(giveplayerid, 0xD41E9AFF, string);
			SetPlayerChatBubble(playerid, "Сказал что-то по телефону", COLOR_AQUA, 30.0, 5000);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/gps", true))
	{
		if(EnableJobCheckpoint(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен сначала закончить работу");
