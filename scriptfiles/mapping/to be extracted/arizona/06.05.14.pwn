		case 5: ApplyAnimation(playerid, "DANCING", "dnce_M_b", 4.0, 1, 0, 0, 0, 0), TextDrawShowForPlayer(playerid, StopAnimation), PlayerLoopingAnim[playerid] = true;
		case 6: ApplyAnimation(playerid, "DANCING", "dnce_M_d", 4.0, 1, 0, 0, 0, 0), TextDrawShowForPlayer(playerid, StopAnimation), PlayerLoopingAnim[playerid] = true;
