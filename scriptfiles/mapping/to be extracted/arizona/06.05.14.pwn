					if(GetPlayerMoneyEx(playerid) < 8000) return SendClientMessage(playerid, COLOR_GREEN, "У тебя не достаточно денег. Нужно{5BD93B} 8000$");
					SendClientMessage(playerid, COLOR_WHITE, "Ты успешно приобрёл новую дверь");
