			new stringx[2024],stats[256],house_text[64],medkart_text[64],carlic_text[64],
			sex_text[64];
			if(PlayerInfo[playerid][pHouse] != 0) house_text = "Имеется";
			else if(PlayerInfo[playerid][pRent] != 0) house_text = "Имеется (аренда)";
			else house_text = "Не имеется";
			if(PlayerInfo[playerid][pMedKart] == 0) medkart_text = "Не имеется";
