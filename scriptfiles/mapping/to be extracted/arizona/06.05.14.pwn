			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Игрок {9DDAF2}%s{FFFFFF} принял предложение освободиться из тюрьмы за {9DDAF2}%d$", PlayerNameEx[playerid], price);
			SendClientMessage(giverid, COLOR_WHITE, string);
			GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~UNJAILED", 3000, 3);
			KillTimer(JailTimer[playerid]);
			PlayerInfo[playerid][pJailTime] = 99999;
			OnPlayerSpawn(playerid);
			GivePlayerMoneyEx(playerid, -price);
			GivePlayerMoneyEx(giverid, price);
			GetPlayerTransfer[playerid] = INVALID_PLAYER_ID;
			GetPlayerOption[playerid] = 0;
		}
		else
		{
			f(string, "Ты отказался от предложения игрока {9DDAF2}%s{FFFFFF} освободиться из тюрьмы за {9DDAF2}%d$", PlayerNameEx[giverid], price);
			SendClientMessage(playerid, COLOR_WHITE, string);
