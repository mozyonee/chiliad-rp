	if(CountPlayerFind[playerid] == 0 || !PlayerFinded[playerid])
	{
		GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~REDMARKER DONE", 3000, 4);
		DisablePlayerRaceCheckpoint(playerid);
		PlayerFinded[playerid] = false;
		return true;
	}
	if(CountPlayerFind[playerid] > 3) f(string, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~%d", CountPlayerFind[playerid]);
	else f(string, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~%d", CountPlayerFind[playerid]);
	GameTextForPlayer(playerid, string, 700, 4);
	CountPlayerFind[playerid] -= 1;
	SetTimerEx("CheckCheckpoint", 1000, false, "i", playerid);
	return true;
}

