public GivePlayerMedKart(playerid)
{
	PlayerUsePickup[playerid] = false;
	TogglePlayerControllable(playerid, true);
	if(GetPlayerDrunkLevel(playerid) > 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не получил медкарту, так как находишься не в трезвом состоянии");
	if(PlayerInfo[playerid][pDepend] > 30) return SendClientMessage(playerid, COLOR_GREEN, "Ты не получил медкарту, так как имеешь наркозависимость! {CCCCCC}(вылечиться можно у медика)");
	SendClientMessage(playerid, COLOR_WHITE, "Осмотр окончен. Ты успешно получил медкарту");
	PlayerInfo[playerid][pMedKart] = 1;
	return true;
}

public GivePlayerBankKart(playerid)
{
	new string[64];
	PlayerUsePickup[playerid] = false;
	TogglePlayerControllable(playerid, true);
	SendClientMessage(playerid, COLOR_WHITE, "Регистрация окончена. Ты успешно получил банковскую карту");
	SendClientMessage(playerid, COLOR_GRAY, "Номер лицевого счёта можно узнать в своей статистике");
	PlayerInfo[playerid][pBankKart] = LastBank;
	f(string, "bank/%d.ini", LastBank);
	new GetFile = ini_createFile(string);
	ini_setString(GetFile, "OWNER", PlayerName[playerid]);
	ini_setInteger(GetFile, "PASSWORD", 0);
	ini_setInteger(GetFile, "BALANCE", 0);
	ini_closeFile(GetFile);
	LastBank += 1;
	return true;
}

