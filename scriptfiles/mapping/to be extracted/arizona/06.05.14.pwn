 ////////////////////

	//------------------------------------------------------------------------------

	else if(dialogid == BUYCAR_ID)
	{
		if(response)
		{
			new vehicleid = BuyVehicle[playerid];
			if(PlayerInfo[playerid][pPasport] == 0)
			{
				SendClientMessage(playerid, COLOR_GREEN, "У тебя нет паспорта! {CCCCCC}(( /gps --> Гос. Организации ))");
				ShowMenuForPlayer(VehicleMenu, playerid);
				return true;
			}
			if(PlayerInfo[playerid][pVehicle] != INVALID_VEHICLE_ID)
			{
				SendClientMessage(playerid, COLOR_GREEN, "У тебя уже есть купленная машина");
				SendClientMessage(playerid, COLOR_GRAY, "Продать её можно в меню управления машиной. {FFFFFF}(/vehicle)");
				ShowMenuForPlayer(VehicleMenu, playerid);
				return true;
			}
			if(GetPlayerMoneyEx(playerid) < VehicleInfo[vehicleid][vPrice])
			{
				f(string, "У тебя не достаточно денег. Нужно{5BD93B} %d$", VehicleInfo[vehicleid][vPrice]);
				SendClientMessage(playerid, COLOR_GREEN, string);
				ShowMenuForPlayer(VehicleMenu, playerid);
				return true;
			}
			new model,price,color = random(127);
			switch(pInShop[playerid])
			{
			case 1: model = carsA[pPressed[playerid]][0], price = carsA[pPressed[playerid]][1];
			case 2: model = carsB[pPressed[playerid]][0], price = carsB[pPressed[playerid]][1];
			case 3: model = carsC[pPressed[playerid]][0], price = carsC[pPressed[playerid]][1];
			case 4: model = carsD[pPressed[playerid]][0], price = carsD[pPressed[playerid]][1];
			case 5: model = carsE[pPressed[playerid]][0], price = carsE[pPressed[playerid]][1];
			}
			GivePlayerMoneyEx(playerid, -VehicleInfo[vehicleid][vPrice]);
			BusinessInfo[CARS_BIZZ][bBalance] += 15000;
			vehicleid = CreateVehicle(model, -524.7137, -553.7875, 25.7599, 359.0777, color , color, -1);
			DestroyVehicle(BuyVehicle[playerid]);
			SetVehicleNumber(vehicleid);
			SetVehicleToRespawn(vehicleid);
			VehicleLock[vehicleid] = false;
			BootVehicleLock[vehicleid] = true;
			new engine,lights,alarm,doors,bonnet,boot,objective;
			GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
			SetVehicleParamsEx(vehicleid,engine,lights,alarm,false,bonnet,boot,objective);
			TogglePlayerControllable(playerid, true);
			SetPlayerInterior(playerid, 0);
			SetPlayerVirtualWorld(playerid, 0);
			SetCameraBehindPlayer(playerid);
			SetPlayerPos(playerid, -543.3920,-531.5029,25.7859);
			SetPlayerFacingAngle(playerid, 3.2711);
			PlayerInfo[playerid][pVehicle] = vehicleid;
			VehicleInfo[vehicleid][vBuyed] = 1;
			VehicleInfo[vehicleid][vColor] = color;
			VehicleInfo[vehicleid][vModel] = model;
			VehicleInfo[vehicleid][vPrice] = price;
			VehicleInfo[vehicleid][vLocked][1] = 1;
			VehicleInfo[vehicleid][vSpw][0] = -524.7137;
			VehicleInfo[vehicleid][vSpw][1] = -553.7875;
			VehicleInfo[vehicleid][vSpw][2] = 25.7599;
			VehicleInfo[vehicleid][vSpw][3] = 359.0777;
			SendClientMessage(playerid, COLOR_RED, "Поздравляем тебя! Ты успешно купил машину. Закрыть/открыть используй: (( /lock 3 ))");
			SendClientMessage(playerid, COLOR_RED, "Чтобы открыть меню управления машиной используй команду {FFFFFF}(/v)ehicle");
			settext(VehicleInfo[vehicleid][vOwner], PlayerName[playerid]);
  			 f(string, "Владелец: {FFFFFF}%s\n Номер: %d", PlayerNameEx[playerid], random(101));
			OWNER[vehicleid] = CreateDynamic3DTextLabel(string, 0xC6DE83FF, 0.0, 0.0, 0.5, 5.0, INVALID_PLAYER_ID, vehicleid, 1);
			pInShop[playerid] = 0;
		}
		else
		{
			ShowMenuForPlayer(VehicleMenu, playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(dialogid == BUYCAR_ID+1)
	{
		if(response)
		{
			new vehicleid = PlayerInfo[playerid][pVehicle],Float:POS[4];
			GetVehiclePos(vehicleid, POS[0], POS[1], POS[2]);
			new engine,lights,alarm,doors,bonnet,boot,blink,objective,fuel,Float:health;
			new seat = -1,bool:enge,bool:ligt;
			switch(listitem)
			{
			case 0:
				{
					if(IsPlayerInVehicle(playerid, vehicleid)) seat = GetPlayerVehicleSeat(playerid);
					if(VehicleEngine[vehicleid]) enge = true;
					if(VehicleLights[vehicleid]) ligt = true;
					if(GetStrobesMode[vehicleid] != 0) blink = GetStrobesMode[vehicleid];
					fuel = VehicleFuel[vehicleid];
					GetVehicleHealth(vehicleid, health);
					GetVehiclePos(vehicleid, POS[0], POS[1], POS[2]);
					GetVehicleZAngle(vehicleid, POS[3]);
					SendClientMessage(playerid, COLOR_WHITE, "Весь тюнинг твоей купленной машины был удалён");
					RemoveVehicleTuning(vehicleid);
					SetVehicleToRespawn(vehicleid);
					SetVehiclePos(vehicleid, POS[0], POS[1], POS[2]);
					SetVehicleZAngle(vehicleid, POS[3]);
					if(enge)
					{
						VehicleEngine[vehicleid] = true;
						GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
						SetVehicleParamsEx(vehicleid,true,lights,alarm,doors,bonnet,boot,objective);
					}
					if(ligt)
					{
						VehicleLights[vehicleid] = true;
						GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
						SetVehicleParamsEx(vehicleid,engine,true,alarm,doors,bonnet,boot,objective);
					}
					VehicleFuel[vehicleid] = fuel;
					SetVehicleHealth(vehicleid, health);
					if(seat != -1) PutPlayerInVehicle(playerid, vehicleid, seat);
					if(blink != 0) GetStrobesMode[vehicleid] = blink;
				}
			case 1:
				{
					GetVehiclePos(vehicleid, POS[0], POS[1], POS[2]);
					GetVehicleZAngle(vehicleid, POS[3]);
					VehicleInfo[vehicleid][vSpw][0] = POS[0];
					VehicleInfo[vehicleid][vSpw][1] = POS[1];
					VehicleInfo[vehicleid][vSpw][2] = POS[2];
					VehicleInfo[vehicleid][vSpw][3] = POS[3];
					VehicleInfo[vehicleid][vParked] = 1;
					SendClientMessage(playerid, COLOR_WHITE, "Машина успешно припаркована");
				}
			case 2:
				{
					new stringcolor[2000];
					f(stringcolor, "Введи желаемый номер цвета для вашей машины\n\n\
{FFFFFF}%s%s%s%s%s%s%s\n\n\
{FFFFFF}Стоимость смены цвета машины стоит 200$\
", carcolors[0], carcolors[1], carcolors[2], carcolors[3], carcolors[4], carcolors[5], carcolors[6]);
					ShowDialog(playerid, BUYCAR_ID+2, DIALOG_STYLE_INPUT, "Смена цвета машины", stringcolor, "Ок", "Отмена");
				}
			case 3:
				{
     f(string, "\
Ты действительно хочешь продать свою машину за %d$?\
", floatround(VehicleInfo[vehicleid][vPrice]/100*30));
					ShowDialog(playerid, BUYCAR_ID+3, DIALOG_STYLE_MSGBOX, "Продажа машины", string, "Да", "Нет");
				}
			}
		}
		return true;
	}
	//////////////////////////////////////////////////////////

	//////////////////////////////////////////////////////////////
	else if(dialogid == BUYCAR_ID+2)
	{
		if(response)
