	else if(!strcmp(cmd, "/items", true))
	{
		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь смотерть начиличие корманов");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь смотерть начиличие корманов");
		ShowPlayerItemsDialog(playerid);
		return true;
	}

	else if(!strcmp(cmd, "/break", true))
	{
		if(IsPlayerInAnyVehicle(playerid)) return MSG_INVEHICLE(playerid);
		if(PlayerInfo[playerid][pJemmy] == 0) return SendClientMessage(playerid, COLOR_GREEN, "У тебя нету отмычки для взлома! {CCCCCC}(купить её можно у автомеханика)");
		new vehicleid = INVALID_VEHICLE_ID;
		new Float:POS[3];
		for(new i=0; i<MAX_VEHICLES; i++)
		{
			GetVehiclePos(i, POS[0], POS[1], POS[2]);
			if(PlayerToPoint(playerid, 3.0, POS[0], POS[1], POS[2]) && !IsBmx(i) && !IsRcCar(i))
			{
				vehicleid = i;
				break;
			}
		}
		if(vehicleid == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_GREEN, "Ты находишься далеко от какой-либо машины");
		if(!VehicleLock[vehicleid]) return SendClientMessage(playerid, COLOR_GREEN, "Ближайщая машина не закрыта на ключ");
		if(IsPlayersFromPlayer(playerid, PlayerInfo[playerid][pMember], true)) SetPlayerCriminal(playerid, 1, "взлом машины");
		SetTimerEx("OnPlayerRobCar", 3000+random(3000), false, "ii", playerid, vehicleid);
		SetPlayerChatBubble(playerid, "Взламывает машину", COLOR_AQUA, 30.0, 5000);
		SendClientMessage(playerid, COLOR_WHITE, "Взлом этой машины начался...");
		TogglePlayerControllable(playerid, false);
		return true;
	}

	else if(!strcmp(cmd, "/breakboot", true))
	{
		if(IsPlayerInAnyVehicle(playerid)) return MSG_INVEHICLE(playerid);
		if(PlayerInfo[playerid][pJemmy] == 0) return SendClientMessage(playerid, COLOR_GREEN, "У тебя нету отмычки для взлома! {CCCCCC}(купить её можно у автомеханика)");
		new vehicleid = INVALID_VEHICLE_ID;
		new Float:POS[3];
		for(new i=0; i<MAX_VEHICLES; i++)
		{
			GetCoordBootVehicle(i, POS[0], POS[1], POS[2]);
			if(PlayerToPoint(playerid, 1.0, POS[0], POS[1], POS[2]) && !IsBmx(i) && !IsRcCar(i) && !IsMoto(i))
			{
				vehicleid = i;
				break;
			}
		}
		if(vehicleid == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_GREEN, "Ты находишься далеко от багажника машины");
		if(!BootVehicleLock[vehicleid]) return SendClientMessage(playerid, COLOR_GREEN, "Багажник ближайщей машины не закрыт на ключ");
		if(IsPlayersFromPlayer(playerid, PlayerInfo[playerid][pMember], true)) SetPlayerCriminal(playerid, 1, "взлом машины");
		SetTimerEx("OnPlayerRobBoot", 3000+random(3000), false, "ii", playerid, vehicleid);
		SetPlayerChatBubble(playerid, "Взламывает машину", COLOR_AQUA, 30.0, 5000);
		SendClientMessage(playerid, COLOR_WHITE, "Взлом багажника этой машины начался...");
		TogglePlayerControllable(playerid, false);
		return true;
	}

    else if(!strcmp(cmd, "/boot", true))
	{
		if(IsPlayerInAnyVehicle(playerid)) return MSG_INVEHICLE(playerid);
		new bool:counter = true;
		new Float:POS[3];
		for(new i=0; i<MAX_VEHICLES; i++)
		{
			GetCoordBootVehicle(i, POS[0], POS[1], POS[2]);
			if(PlayerToPoint(playerid, 1.0, POS[0], POS[1], POS[2]) && !IsBmx(i) && !IsRcCar(i) && !IsMoto(i))
			{
				PlayerBootCar[playerid] = i;
				counter = false;
				break;
			}
		}
		if(counter) return SendClientMessage(playerid, COLOR_GREEN, "Ты находишься далеко от багажника машины");
		if(BootVehicleLock[PlayerBootCar[playerid]]) return SendClientMessage(playerid, COLOR_GREEN, "Багажник ближайщей машины закрыт на ключ");
		ShowDialog(playerid, BOOT_ID, DIALOG_STYLE_LIST, "Багажник машины", "\
		[1] Посмотреть\n\
		[2] Забрать\n\
		[3] Положить\
		", "Выбрать", "Отмена");
	  	return 1;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/drop", true))
	{
		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь выкидывать оружие");
		if(GetPlayerWeapon(playerid) < 1)  return SendClientMessage(playerid, COLOR_GREEN, "У тебя в руках нет оружия");
		SetPlayerChatBubble(playerid, "Выбросил оружие", COLOR_AQUA, 30.0, 5000);
