public PlayerEndFisher(playerid)
{
	switch(random(8))
	{
	case 0..2: SendClientMessage(playerid, COLOR_WHITE, "К сожелению ты нечего не поймал");
	case 3..8:
		{
			new string[64],getfish = random(sizeof(fishes));
			PlayerInfo[playerid][pBait] -= 1;
			PlayerInfo[playerid][pFish] += 1;
			f(string, "Поймал рыбу {9DDAF2}%s{FFFFFF}", fishes[getfish]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			if(PlayerInfo[playerid][pBait] <= 0) SendClientMessage(playerid, COLOR_WHITE, "У тебя кончилась наживка");
			f(string, "Поймал рыбу %s", fishes[getfish]);
			SetPlayerChatBubble(playerid, string, COLOR_AQUA, 30.0, 5000);
		}
	}
	PlayerUsePickup[playerid] = false;
	TogglePlayerControllable(playerid, true);
	DeleteAnimation(playerid);
	return true;
}
