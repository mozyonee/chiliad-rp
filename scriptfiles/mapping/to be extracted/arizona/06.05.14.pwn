public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	SendClientMessage(playerid, COLOR_WHITE, "Чтобы завести двигатель нажмите кнопку {00FF00}CTRL");
	if(ispassenger && GetVehicleModel(vehicleid) == 519)
	{
		PlayerInShamal[playerid] = vehicleid;
		SetPlayerPos(playerid, 1.9173, 30.1166, 1199.5938);
		SetPlayerFacingAngle(playerid, 0);
		SetCameraBehindPlayer(playerid);
		SetPlayerInterior(playerid, 1);
		SetPlayerVirtualWorld(playerid, SHML_MIR+vehicleid);
	}
	return true;
}

//==============================================================================
// СТАНДАРТНЫЕ ПАБЛИКИ СВЯЗАННЫЕ С МАШИНАМИ
//==============================================================================

public OnVehicleDamageStatusUpdate(vehicleid, playerid)
{
	new Float:health;
	GetVehicleHealth(vehicleid, health);
	if(OldVehicleHealth[vehicleid] - health >= 200 && VehicleEngine[vehicleid])
	{
		new engine,lights,alarm,doors,bonnet,boot,objective;
		GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
		SetVehicleParamsEx(vehicleid,false,lights,alarm,doors,bonnet,boot,objective);
		VehicleEngine[vehicleid] = false;
		VehicleCrashed[vehicleid] = true;
		SendClientMessage(playerid, COLOR_GREEN, "Двигатель заглох...");
	}
	if(OldVehicleHealth[vehicleid]-health >= 100)
	{
		for(new i=0; i<GetMaxPlayers(); i++)
		{
			if(IsPlayerConnected(i))
			{
				if(!PlayerOnRemen[i] && IsPlayerInVehicle(i, vehicleid))
				{
					new Float:dmg = (OldVehicleHealth[vehicleid]-health)/(10+random(5));
					GetPlayerHealth(i, health);
					SetPlayerHealthEx(i, health-floatround(dmg));
				}
			}
		}
	}
	return true;
}

public OnVehicleMod(playerid, vehicleid, componentid)
{
	new vehicleide = GetVehicleModel(vehicleid);
	new modok = islegalcarmod(vehicleide, componentid);

	if (!modok) {
//		Действие, если паренек спалился
		Kick(playerid);
	}
	if(vehicleid >= 1 && vehicleid <= 137)
    {
        new Varz=InitComponents(componentid);
        switch (Varz)
        {
            case 1: { TuneCar[vehicleid][mod1]=componentid; }
            case 2: { TuneCar[vehicleid][mod2]=componentid; }
            case 3: { TuneCar[vehicleid][mod3]=componentid; }
            case 4: { TuneCar[vehicleid][mod4]=componentid; }
            case 5: { TuneCar[vehicleid][mod5]=componentid; }
            case 6: { TuneCar[vehicleid][mod6]=componentid; }
            case 7: { TuneCar[vehicleid][mod7]=componentid; }
            case 8: { TuneCar[vehicleid][mod8]=componentid; }
            case 9: { TuneCar[vehicleid][mod9]=componentid; }
            case 10: { TuneCar[vehicleid][mod10]=componentid; }
            case 11: { TuneCar[vehicleid][mod11]=componentid; }
            case 12: { TuneCar[vehicleid][mod12]=componentid; }
            case 13: { TuneCar[vehicleid][mod13]=componentid; }
            case 14: { TuneCar[vehicleid][mod14]=componentid; }
            case 15: { TuneCar[vehicleid][mod15]=componentid; }
            case 16: { TuneCar[vehicleid][mod16]=componentid; }
            case 17: { TuneCar[vehicleid][mod17]=componentid; }
        }
        printf("Component Added: %d",componentid);
        SaveModsForAll(vehicleid);
    }
	if(!Tuning(playerid))
	{
		RemoveVehicleComponent(vehicleid,componentid);
		SetVehicleToRespawn(vehicleid);
		SendClientMessage(playerid, COLOR_RED, "Античит: Ты был(а) кикнут(а) за тюнинг хак.");
		Kick(playerid);
		return true;
	}
	if(GetPlayerInterior(playerid) == 0 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		SendClientMessage(playerid, COLOR_RED, "Ты кикнут за использование tuning-hack");
		return Kick(playerid);
	}
	if(GetVehicleHouse[vehicleid] != 0 || VehicleInfo[vehicleid][vBuyed] == 1)
	{
		for(new i=0; i<14; i++)
		{
			if(GetVehicleComponentInSlot(vehicleid, i) != 0) TuningInfo[vehicleid][i] = GetVehicleComponentInSlot(vehicleid, i);
		}
	}
	return true;
}

public OnVehicleRespray(playerid, vehicleid, color1, color2)
{
	if(GetVehicleHouse[vehicleid] != 0) HouseInfo[GetVehicleHouse[vehicleid]][hColor] = color1;
	else if(VehicleInfo[vehicleid][vBuyed] == 1) VehicleInfo[vehicleid][vColor] = color1;
	return true;
}

public OnVehiclePaintjob(playerid, vehicleid, paintjobid)
{
	if(GetVehicleHouse[vehicleid] != 0 || VehicleInfo[vehicleid][vBuyed] == 1) TuningInfo[vehicleid][14] = paintjobid+1;
	return true;
}

public OnVehicleSpawn(vehicleid)
{
	new engine,lights,alarm,doors,bonnet,boot,objective;
	for(new i=0; i<4; i++)
	if(vehicleid >= 1 && vehicleid <= 137)
    {
        LoadModsForAll(vehicleid);
        TuneThisCar(vehicleid);
    }
	if(IsEngineCar(vehicleid))
	{
		VehicleEngine[vehicleid] = false;
		GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
		SetVehicleParamsEx(vehicleid,false,false,alarm,doors,bonnet,boot,objective);
	}
	else
	{
		VehicleEngine[vehicleid] = true;
		GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
		SetVehicleParamsEx(vehicleid,true,false,alarm,doors,bonnet,boot,objective);
	}
	if(IsFuelCar(vehicleid)) VehicleFuel[vehicleid] = 50+random(50);
	else VehicleFuel[vehicleid] = 100;
	VehicleLights[vehicleid] = false;
	RefuelVehicle[vehicleid] = false;
	VehicleCrashed[vehicleid] = false;
	VehicleEndeng[vehicleid] = true;
	GetRouteBus[vehicleid] = 0;
	VehicleRadio[vehicleid] = 0;
	GetInfoMode[vehicleid] = 0;
	GetStrobesMode[vehicleid] = 0;
	for(new i=0; i<8; i++)
	{
		VehiclePassenger[vehicleid][i] = INVALID_PLAYER_ID;
	}
	if(IsSchoolCar(vehicleid)) VehicleLimitSpeed[vehicleid] = true;
	else VehicleLimitSpeed[vehicleid] = false;
	if(VehicleInfo[vehicleid][vBuyed] == 1)
	{
		SetVehiclePos(vehicleid, VehicleInfo[vehicleid][vSpw][0], VehicleInfo[vehicleid][vSpw][1], VehicleInfo[vehicleid][vSpw][2]);
		SetVehicleZAngle(vehicleid, VehicleInfo[vehicleid][vSpw][3]);
	}
	if(GetVehicleHouse[vehicleid] != 0 || VehicleInfo[vehicleid][vBuyed] == 1) OnTuning(vehicleid);
	if(GetVehicleHouse[vehicleid] != 0)
	{
		VehicleLock[vehicleid] = true;
		BootVehicleLock[vehicleid] = true;
		GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
		SetVehicleParamsEx(vehicleid,engine,lights,alarm,true,bonnet,boot,objective);
	}
	else
	{
		if(IsBuildCar(vehicleid))
		{
			VehicleLock[vehicleid] = true;
			BootVehicleLock[vehicleid] = true;
			GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
			SetVehicleParamsEx(vehicleid,engine,lights,alarm,true,bonnet,boot,objective);
		}
		else
		{
			if(random(100) < 50 && IsCityCar(vehicleid) && IsLockedCar(vehicleid))
			{
				VehicleLock[vehicleid] = true;
				BootVehicleLock[vehicleid] = true;
				GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
				SetVehicleParamsEx(vehicleid,engine,lights,alarm,true,bonnet,boot,objective);
			}
			else
			{
				if(VehicleInfo[vehicleid][vLocked][0] == 1)
				{
					VehicleLock[vehicleid] = true;
					GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
					SetVehicleParamsEx(vehicleid,engine,lights,alarm,true,bonnet,boot,objective);
				}
				else
				{
					VehicleLock[vehicleid] = false;
					GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
					SetVehicleParamsEx(vehicleid,engine,lights,alarm,false,bonnet,boot,objective);
				}
				if(VehicleInfo[vehicleid][vLocked][1] == 1) BootVehicleLock[vehicleid] = true;
				else BootVehicleLock[vehicleid] = false;
			}
		}
	}
	VehicleInfo[vehicleid][vDrugs] = 0;
	VehicleInfo[vehicleid][vMoney] = 0;
	VehicleInfo[vehicleid][vGun][0] = 0;
	VehicleInfo[vehicleid][vGun][1] = 0;
	VehicleInfo[vehicleid][vGun][2] = 0;
	VehicleInfo[vehicleid][vGun][3] = 0;
	VehicleInfo[vehicleid][vGun][4] = 0;
	VehicleInfo[vehicleid][vMats] = 0;
	VehicleInfo[vehicleid][vArmour] = 0.0;
	return true;
}

public OnPlayerExitVehicle(playerid, vehicleid)
{
	if(IsTaxiCar(GetPlayerVehicleID(playerid)) && GetJobVehicle[playerid] == GetPlayerVehicleID(playerid) && TaxiJobStarted[playerid])
	{
		ExitCount[playerid] = 15;
		SendClientMessage(playerid, COLOR_ORANGE, "Вернись обратно в такси");
		ExitCarTimer[playerid] = SetTimerEx("OnPlayerExitCar", 1000, true, "i", playerid);
		return true;
	}
	if(vehicleid >= 1 && vehicleid <= 137)
    {
        SaveModsForAll(vehicleid);
    }
	if(IsBusCar(GetPlayerVehicleID(playerid)) && GetJobVehicle[playerid] == GetPlayerVehicleID(playerid))
	{
		ExitCount[playerid] = 15;
		SendClientMessage(playerid, COLOR_ORANGE, "Вернись обратно в автобус");
		ExitCarTimer[playerid] = SetTimerEx("OnPlayerExitCar", 1000, true, "i", playerid);
		return true;
	}
	if(IsFarmerCar(GetPlayerVehicleID(playerid)) && GetJobVehicle[playerid] == GetPlayerVehicleID(playerid))
	{
		ExitCount[playerid] = 15;
		SendClientMessage(playerid, COLOR_ORANGE, "Вернись обратно в трактор");
		ExitCarTimer[playerid] = SetTimerEx("OnPlayerExitCar", 1000, true, "i", playerid);
		return true;
	}
		if(IsFarmerCar1(GetPlayerVehicleID(playerid)) && GetJobVehicle[playerid] == GetPlayerVehicleID(playerid))
	{
		ExitCount[playerid] = 15;
		SendClientMessage(playerid, COLOR_ORANGE, "Вернись обратно в комбайн!");
		ExitCarTimer[playerid] = SetTimerEx("OnPlayerExitCar", 1000, true, "i", playerid);
		return true;
	}
	if(GetPlayerVehicleID(playerid) == GetPlayerVehicleID(GetDriverTaxi[playerid])) KillTimer(TaxiCountTimer[GetDriverTaxi[playerid]]);
	return true;
}

public OnVehicleDeath(vehicleid, killerid)
{
	if(GetStrobesMode[vehicleid] != 0)
	{
		GetStrobesMode[vehicleid] = 0;
		DestroyObject(StrobModels[vehicleid][0]);
		DestroyObject(StrobModels[vehicleid][1]);
		DestroyObject(StrobModels[vehicleid][2]);
		DestroyObject(StrobModels[vehicleid][3]);
	}
	for(new i=0; i<GetMaxPlayers(); i++)
	{
		if(IsPlayerConnected(i))
		{
			if(vehicleid == GiveAdminVehicle[i])
			{
				DestroyVehicle(GiveAdminVehicle[i]);
				GiveAdminVehicle[i] = INVALID_VEHICLE_ID;
				break;
			}
			else if(vehicleid == GetJobVehicle[i])
			{
				EndPlayerCasualJob(i);
				SendClientMessage(i, COLOR_WHITE, "Твой рабочий транспорт был уничтожен. Работа завершена");
				break;
			}
			else if(vehicleid == GetPlayerLimusin[i])
			{
				LimusinReRent[i] = false;
				DestroyVehicle(vehicleid);
				LimusinColor[i] = -1;
				LimusinTime[i] = -1;
				DestroyDynamic3DTextLabel(OWNER[vehicleid]);
				GetPlayerLimusin[i] = INVALID_VEHICLE_ID;
				break;
			}
			else if(vehicleid == PlayerInShamal[i])
			{
				SetPlayerHealthEx(i, 0);
				SetPlayerInterior(i, 0);
				SetPlayerVirtualWorld(i, 0);
				PlayerInShamal[i] = INVALID_VEHICLE_ID;
				SendClientMessage(i, COLOR_PINK, "Ты попал в авиокатострофу");
				break;
			}
		}
	}
	return true;
}

