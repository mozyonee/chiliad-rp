			if(!IsPlayerConnected(strval(inputtext))) return ShowDialog(playerid, ORGAN_ID+3, DIALOG_STYLE_INPUT, "Принять игрока", "\
Введи id игрока которго ты хочешь принять в свою организацию:\n\
{FF0000}Игрок с указанным тобой id не найден!\
", "Ок", "Назад");
			if(GetDistancePlayers(playerid, strval(inputtext)) > 3.0) return ShowDialog(playerid, ORGAN_ID+3, DIALOG_STYLE_INPUT, "Принять игрока", "\
Введи id игрока которго ты хочешь принять в свою организацию:\n\
{FF0000}Ты находишься слишком далеко от этого игрока!\
", "Ок", "Назад");
			GetPlayerTransfer[playerid] = strval(inputtext);
			f(string, "\
Ты действиетльно хочешь принять в свою организацию игрока %s?\
", PlayerNameEx[strval(inputtext)]);
			ShowDialog(playerid, ORGAN_ID+4, DIALOG_STYLE_MSGBOX, "Принять игрока", string, "Принять", "Назад");
		}
		else
