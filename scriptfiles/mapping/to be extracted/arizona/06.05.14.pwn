1 грамм наркотиков стоит 70$\n\
Максимально: 100 грамм\n\
Введи количество грамм наркотиков:\n\
{FF0000}У тебя нет места для такого количества наркотиков!\
", "Купить", "Отмена");
			if(GetPlayerMoneyEx(playerid) < drugprice) return ShowDialog(playerid, DRUGS_ID, DIALOG_STYLE_INPUT, "Покупка наркотиков", "\
1 грамм наркотиков стоит 70$\n\
Максимально: 100 грамм\n\
Введи количество грамм наркотиков:\n\
{FF0000}У тебя нет денег для такого количества наркотиков!\
", "Купить", "Отмена");
			GivePlayerMoneyEx(playerid, -drugprice);
			PlayerInfo[playerid][pGrib] += drg;
			f(string, "Ты успешно купил {9DDAF2}%d {FFFFFF}грамм наркотиков за {9DDAF2}%d$", drg, drugprice);
			SendClientMessage(playerid, COLOR_WHITE, string);
			SendClientMessage(playerid, COLOR_WHITE, "Чтобы использовать наркоту используй команду {9DDAF2}/items");
		}
		return true;
