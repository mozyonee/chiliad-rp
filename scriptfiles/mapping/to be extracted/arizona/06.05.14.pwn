		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /setmed [ цена ]");
		new price = strval(tmp);
		if(price < 1 || price > 100) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верную цену. Используй цену от 1 до 100");
		GetMedPrice = price;
		f(string, "Ты установил цену за одно лечение на {9DDAF2}%d$", price);
