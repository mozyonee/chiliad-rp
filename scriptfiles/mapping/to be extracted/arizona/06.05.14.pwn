		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			new Float:POS[3];
			if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
			{
				new vehicleid = GetPlayerVehicleID(playerid);
				GetPlayerPos(giveplayerid, POS[0], POS[1], POS[2]);
				SetVehiclePos(vehicleid, POS[0], POS[1]+1, POS[2]);
				LinkVehicleToInterior(vehicleid, GetPlayerInterior(giveplayerid));
				SetVehicleVirtualWorld(vehicleid, GetPlayerVirtualWorld(giveplayerid));
				SetPlayerInterior(playerid, GetPlayerInterior(giveplayerid));
				SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(giveplayerid));
			}
			else
			{
				GetPlayerPos(giveplayerid, POS[0], POS[1], POS[2]);
				SetPlayerPos(playerid, POS[0], POS[1]+1, POS[2]);
				SetPlayerInterior(playerid, GetPlayerInterior(giveplayerid));
				SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(giveplayerid));
			}
			SetCameraBehindPlayer(playerid);
			f(string, "Ты телепортировался к игроку {F0EFD8}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_CREAM, string);
			SetPlayerStreetWorld(playerid);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/itto", true) || !strcmp(cmd, "/gethere", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 2) return MSG_NOADMIN1(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /itto [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			new Float:POS[3];
			if(GetPlayerState(giveplayerid) == PLAYER_STATE_DRIVER)
			{
				new vehicleid = GetPlayerVehicleID(giveplayerid);
				GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
				SetVehiclePos(vehicleid, POS[0], POS[1]+1, POS[2]);
				LinkVehicleToInterior(vehicleid, GetPlayerInterior(playerid));
				SetVehicleVirtualWorld(vehicleid, GetPlayerVirtualWorld(playerid));
				SetPlayerInterior(vehicleid, GetPlayerInterior(playerid));
				SetPlayerVirtualWorld(vehicleid, GetPlayerVirtualWorld(playerid));
			}
			else
			{
				GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
				SetPlayerPos(giveplayerid, POS[0], POS[1]+1, POS[2]);
				SetPlayerInterior(giveplayerid, GetPlayerInterior(playerid));
				SetPlayerVirtualWorld(giveplayerid, GetPlayerVirtualWorld(playerid));
			}
			SetCameraBehindPlayer(giveplayerid);
			if(strcmp(PlayerName[playerid], "Max_Brown", false))
			{
				f(string, "Ты был телепортирован к администратору {F0EFD8}%s", PlayerNameEx[playerid]);
				SendClientMessage(giveplayerid, COLOR_CREAM, string);
			}
			SetPlayerStreetWorld(giveplayerid);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/jail", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 2) return MSG_NOADMIN2(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /jail [ id игрока ] [ время в минутах ]");
		giveplayerid = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /jail [ id игрока ] [ время в минутах ]");
		new setjailtime = strval(tmp);
		if(setjailtime < 0 || setjailtime > 60) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верное время. Используй время от 0 до 60");
		if(IsPlayerConnected(giveplayerid))
		{
			if(setjailtime > 0)
			{
				if(PlayerInfo[giveplayerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок уже находиться в тюрьме");
				PlayerInfo[giveplayerid][pJailed] += 1;
				PlayerInfo[giveplayerid][pJailTime] = setjailtime*60;
				JailTimer[giveplayerid] = SetTimerEx("CountPlayerUnJail", 1000, true, "i", giveplayerid);
				SpawnPlayerInJail(giveplayerid);
				f(string, "Ты был посажен в тюрьму администратором {F0EFD8}%s{FFFEBF} на {F0EFD8}%d{FFFEBF} минут.", PlayerNameEx[playerid], setjailtime);
				SendClientMessage(giveplayerid,COLOR_CREAM, string);
				f(string, "В тюрьму посадили игрока {F0EFD8}%s{FFFEBF} на {F0EFD8}%d{FFFEBF} минут.", PlayerNameEx[giveplayerid], setjailtime);
				SendClientMessageToAll(COLOR_CREAM, string);
			}
			else
			{
				if(PlayerInfo[giveplayerid][pJailTime] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок не находиться в тюрьме");
				GameTextForPlayer(giveplayerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~UNJAILED", 3000, 3);
				KillTimer(JailTimer[giveplayerid]);
				PlayerInfo[giveplayerid][pJailTime] = 99999;
				OnPlayerSpawn(giveplayerid);
				f(string, "Ты был выпущен из тюрьмы администратором {F0EFD8}%s", PlayerNameEx[playerid]);
				SendClientMessage(giveplayerid, COLOR_CREAM, string);
			}
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/fixcar", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 1) return MSG_NOADMIN1(playerid);
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return MSG_NODRIVER(playerid);
		new Float:Angle;
		GetVehicleZAngle(GetPlayerVehicleID(playerid), Angle);
		SetVehicleZAngle(GetPlayerVehicleID(playerid), Angle);
		RepairVehicle(GetPlayerVehicleID(playerid));
		PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);
		return true;
	}
	else if(!strcmp(cmd, "/remont", true))
	{
        if(IsPlayerInRangeOfPoint(playerid,7,2217.5461,-1146.5481,1025.7969)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не на шиномонтаже");
        if(PlayerInfo[playerid][pMoney] < 1000) return SendClientMessage(playerid, COLOR_GREEN, "У вас слишком мало денег");
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return MSG_NODRIVER(playerid);
		new Float:Angle;
		GetVehicleZAngle(GetPlayerVehicleID(playerid), Angle);
		SetVehicleZAngle(GetPlayerVehicleID(playerid), Angle);
		RepairVehicle(GetPlayerVehicleID(playerid));
        GivePlayerMoneyEx(playerid, -1000);
		PlayerPlaySound(playerid, 1133, 0.0, 0.0, 0.0);
		return true;
	}
	else if(!strcmp(cmd, "/Разгрузить", true))
	{
	if(PlayerInfo[playerid][pMember] != ARMY_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции Пограничники");
 	{
		if(PlayerInfo[playerid][pMats] < 300) return SendClientMessage(playerid, COLOR_GREEN, "У вас в руках нет материалов!");
		PlayerInfo[playerid][pMoney] += 50;
		PlayerInfo[playerid][pMats] -= 300;
		SendClientMessage(playerid, COLOR_GREEN, "Ты сдал 300 материалов и получил 50$");
		DisablePlayerRaceCheckpoint(playerid);
		return true;
	}
	}
	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/warn", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 2) return MSG_NOADMIN1(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /warn [ id игрока ] [ причина ]");
		giveplayerid = strval(tmp);
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /warn [ id игрока ] [ причина ]");
		if(IsPlayerConnected(giveplayerid))
		{
			if(PlayerInfo[giveplayerid][pAdmin] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не можешь приминить это действие к администратору");
			f(string, "Администратор {DB8484}%s{FF0000} дал warn игроку {DB8484}%s{FF0000} | причина: {DB8484}%s", PlayerNameEx[playerid], PlayerNameEx[giveplayerid], result);
			SendClientMessageToAll(COLOR_RED, string);
			PlayerInfo[giveplayerid][pWarns] += 1;
			if(PlayerInfo[giveplayerid][pWarns] >= 5)
			{
				SendClientMessage(giveplayerid, COLOR_RED, "Ты был забанен по причине максимального количетсва предупреждений");
				Kick(giveplayerid);
			}
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/resetwarns", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 3) return MSG_NOADMIN1(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /resetwarns [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(PlayerInfo[giveplayerid][pAdmin] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не можешь приминить это действие к администратору");
			f(string, "Администратор {F0EFD8}%s{FFFEBF} снял тебе все предупреждения.", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_CREAM, string);
			f(string, "Ты снял все предупреждения игроку {F0EFD8}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_CREAM, string);
			PlayerInfo[giveplayerid][pWarns] = 0;
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/ban", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 2) return MSG_NOADMIN1(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
		{
			SendClientMessage(playerid, COLOR_GREEN, "» Использование: /ban [ id игрока ] [ тип ] [ значение ] [ причина ]");
			SendClientMessage(playerid, COLOR_GRAY, "| 1: Минуты | 2: Часы | 3: Дни");
			return true;
		}
		giveplayerid = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
		{
			SendClientMessage(playerid, COLOR_GREEN, "» Использование: /ban [ id игрока ] [ тип ] [ значение ] [ причина ]");
			SendClientMessage(playerid, COLOR_GRAY, "| 1: Минуты | 2: Часы | 3: Дни");
			return true;
		}
		new type = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
		{
			SendClientMessage(playerid, COLOR_GREEN, "» Использование: /ban [ id игрока ] [ тип ] [ значение ] [ причина ]");
			SendClientMessage(playerid, COLOR_GRAY, "| 1: Минуты | 2: Часы | 3: Дни");
			return true;
		}
		new chislo = strval(tmp);
		result = strrest(cmdtext, idx);
		if(!strlen(result))
		{
			SendClientMessage(playerid, COLOR_GREEN, "» Использование: /ban [ id игрока ] [ тип ] [ значение ] [ причина ]");
			SendClientMessage(playerid, COLOR_GRAY, "| 1: Минуты | 2: Часы | 3: Дни");
			return true;
		}
		if(type < 1 || type > 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верный тип. Используй тип от 1 до 3");
		if(IsPlayerConnected(giveplayerid))
		{
			new totalban;
			switch(type)
			{
			case 1: totalban = 60*chislo;
			case 2: totalban = 3600*chislo;
			case 3: totalban = 86400*chislo;
			}
			f(string, "banlist/%s.ini", PlayerName[giveplayerid]);
			new OpenBan = ini_createFile(string);
			ini_setInteger(OpenBan, "BAN_TIME", gettime());
			ini_setInteger(OpenBan, "UN_BAN_TIME", gettime()+totalban);
			ini_setString(OpenBan, "GET_BANNED", PlayerNameEx[playerid]);
			ini_setString(OpenBan, "REASON", result);
			ini_closeFile(OpenBan);
			f(string, "Админ %s забанил игрока %s по причине: %s", PlayerNameEx[playerid], PlayerNameEx[giveplayerid], result);
			log("bans", string);
			switch(type)
			{
			case 1: f(string, "Администратор {DB8484}%s{FF0000} забанил игрока {DB8484}%s{FF0000} на {DB8484}%d{FF0000} минут | причина: {DB8484}%s", PlayerNameEx[playerid], PlayerNameEx[giveplayerid], chislo, result);
			case 2: f(string, "Администратор {DB8484}%s{FF0000} забанил игрока {DB8484}%s{FF0000} на {DB8484}%d{FF0000} часов | причина: {DB8484}%s", PlayerNameEx[playerid], PlayerNameEx[giveplayerid], chislo, result);
			case 3: f(string, "Администратор {DB8484}%s{FF0000} забанил игрока {DB8484}%s{FF0000} на {DB8484}%d{FF0000} дней | причина: {DB8484}%s", PlayerNameEx[playerid], PlayerNameEx[giveplayerid], chislo, result);
			}
			SendClientMessageToAll(COLOR_RED, string);
			SendClientMessage(giveplayerid, COLOR_GREEN, "Заявку на разбан можно подать на форуме: vk.com/arizonaarp");
			SendClientMessage(giveplayerid, COLOR_GREEN, "Нажми F8, и предоставь скрин в подтверждении своей не виновности");
			Kick(giveplayerid);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/unban", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 3) return MSG_NOADMIN3(playerid);
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /unban [ логин игрока ]");
		f(string, "users/%s.ini", result);
		if(fexist(string))
		{
			f(string, "banlist/%s.ini", result);
			if(fexist(string))
			{
				fremove(string);
				f(string, "Администратор {DB8484}%s{FF0000} разбанил игрока {DB8484}%s", PlayerNameEx[playerid], pNickText(result));
				SendClientMessageToAll(COLOR_RED, string);
				f(string, "Админ %s разбанил игрока %s", PlayerNameEx[playerid], pNickText(result));
				log("bans", string);
			}
			else
			{
				SendClientMessage(playerid, COLOR_GREEN, "Игрок с указанным тобой логином не забанен");
			}
		}
		else
		{
			SendClientMessage(playerid, COLOR_GREEN, "Игрок с указанным тобой логином не найден");
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/lastlogin", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 1) return MSG_NOADMIN1(playerid);
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /lastlogin [ логин игрока ]");
		f(string, "users/%s.ini", result);
		if(fexist(string))
		{
			new login[128];
			new GetFile = ini_openFile(string);
			ini_getString(GetFile, "LASTLOGIN", login);
			ini_closeFile(GetFile);
			f(string, "Последний заход игрока {F0EFD8}%s{FFFEBF} в игру: {F0EFD8}%s{FFFEBF}", pNickText(result), login);
			SendClientMessage(playerid, COLOR_CREAM, string);
		}
		else
		{
			SendClientMessage(playerid, COLOR_GREEN, "Игрок с указанным тобой логином не найден");
		}
		return true;
	}

	else if(!strcmp(cmd, "/kick", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 1) return MSG_NOADMIN1(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /kick [ id игрока ] [ причина ]");
		giveplayerid = strval(tmp);
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /kick [ id игрока ] [ причина ]");
		if(IsPlayerConnected(giveplayerid))
		{
			if(PlayerInfo[giveplayerid][pAdmin] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не можешь приминить это действие к администратору");
			f(string, "Администратор {DB8484}%s{FF0000} кикнул игрока {DB8484}%s{FF0000} | причина: {DB8484}%s", PlayerNameEx[playerid], PlayerNameEx[giveplayerid], result);
			SendClientMessageToAll(COLOR_RED, string);
			Kick(giveplayerid);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/setname", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 2) return MSG_NOADMIN2(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /setname [ id игрока ] [ новый никнэйм ]");
		giveplayerid = strval(tmp);
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /setname [ id игрока ] [ новый никнэйм ]");
		if(!IsRpNick(result)) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл nonRP никнэйм");
		if(PlayerInfo[giveplayerid][pAdmin] >= 1) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок является администратором");
		if(PlayerInfo[giveplayerid][pHelper] >= 1) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок является хелпером");
		if(PlayerInfo[giveplayerid][pLeader] >= 1) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок является лидером фракции");
		if(IsPlayerConnected(giveplayerid))
		{
			f(string, "users/%s.ini", result);
			if(fexist(string)) return SendClientMessage(playerid, COLOR_GREEN, "Этот никнэйм уже используется на сервере");
			new oldname[32];
			GetPlayerName(giveplayerid, oldname, 32);
			f(string, "Администратор {F0EFD8}%s{FFFEBF} сменил твой никнэйм на {F0EFD8}%s", PlayerNameEx[playerid], pNickText(result));
			SendClientMessage(giveplayerid, COLOR_CREAM, string);
			f(string, "Ты сменил никнэйм игрока {F0EFD8}%s{FFFEBF} на {F0EFD8}%s", pNickText(oldname), pNickText(result));
			SendClientMessage(playerid, COLOR_CREAM, string);
			f(string, "users/%s.ini", PlayerName[giveplayerid]);
			fremove(string);
			f(string, "Админ %s сменил никнэйм игрока %s на %s", PlayerNameEx[playerid], pNickText(oldname), pNickText(result));
			log("renames", string);
			SetPlayerName(giveplayerid, result);
			f(string, "users/%s.ini", result);
			new GetFile = ini_createFile(string);
			ini_setString(GetFile, "PASSWORD", PlayerInfo[giveplayerid][pPassword]);
			ini_closeFile(GetFile);
			GetName(giveplayerid);
			SavePlayerAccaunt(giveplayerid);
			if(PlayerInfo[giveplayerid][pLeader] != 0) settext(FractionInfo[PlayerInfo[giveplayerid][pLeader]][fLeader], PlayerName[giveplayerid]);
			for(new i=0; i<MAX_VEHICLES; i++)
			{
				if(VehicleInfo[i][vBuyed] == 1 && !strcmp(VehicleInfo[i][vOwner], oldname, true))
				{
					f(string, "Владелец: {FFFFFF}%s\n Номер: %d", PlayerNameEx[giveplayerid], random(101));
					UpdateDynamic3DTextLabelText(OWNER[i], 0xC6DE83FF, string);
					settext(VehicleInfo[i][vOwner], PlayerName[giveplayerid]);
					break;
				}
			}
			if(PlayerInfo[giveplayerid][pBizz] != 0) settext(BusinessInfo[PlayerInfo[giveplayerid][pBizz]][bOwner], PlayerName[giveplayerid]);
			if(PlayerInfo[giveplayerid][pHouse] != 0) settext(HouseInfo[PlayerInfo[giveplayerid][pHouse]][hOwner], PlayerName[giveplayerid]);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/listleader", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 3) return MSG_NOADMIN2(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /listleader [ порядковый номер фракции ] [ лидер ]");
		new org = strval(tmp);
		if(org < 1 || org > MAX_ORGANS)
		{
			f(string, "Ты ввёл не верный порядковый номер. Используй номер от 1 до %d", MAX_ORGANS);
			SendClientMessage(playerid, COLOR_GREEN, string);
			return true;
		}
		org -= 1;
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /listleader [ порядковый номер фракции ] [ лидер ]");
		if(org >= 0 && org <= 7) org = org+10;
		else if(org >= 8 && org <= 12) org = org+12;
		else if(org >= 13 && org <= 15) org = org+17;
		settext(FractionInfo[org][fLeader], result);
		f(string, "Во фракции {F0EFD8}%s{FFFEBF} новым лидером (в списке) является {F0EFD8}%s", GetOrganizationName(org), pNickText(result));
		SendClientMessage(playerid, COLOR_CREAM, string);
		return true;
	}

	else if(!strcmp(cmd, "/makeleader", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 4) return MSG_NOADMIN4(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
		{
			SendClientMessage(playerid, COLOR_GREEN, "» Использование: /makeleader [ id игрока ] [ id фракции ]");
			SendClientMessage(playerid, COLOR_GRAY, "[ фракции ] | 1: Сельсовет | 2: Хитманы | 3: Министерство ТС | 4: Пожарная часть");
			SendClientMessage(playerid, COLOR_GRAY, "[ фракции ] | 5:  News | 6: Пограничники | 7: Больница Red Country | 8: Полиция Red Country");
			SendClientMessage(playerid, COLOR_GRAY, "[ банды ] | 9: Гопники | 10: Фермеры | 11: Скинхеды | 12: Rifa Gang | 13: Вагос");
			SendClientMessage(playerid, COLOR_GRAY, "[ мафии ] | 14: Байкеры | 15: Asia Boys | 16: Не трогать");
			SendClientMessage(playerid, COLOR_GRAY, "[ информация ] | 0: Убрать фракцию/банду/мафию у игрока");
			return true;
		}
		giveplayerid = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
		{
			SendClientMessage(playerid, COLOR_GREEN, "» Использование: /makeleader [ id игрока ] [ id фракции ]");
			SendClientMessage(playerid, COLOR_GRAY, "[ фракции ] | 1: Сельсовет | 2: Russian Mafia | 3: Министерство ТС | 4: Пожарная часть");
			SendClientMessage(playerid, COLOR_GRAY, "[ фракции ] | 5:  News | 6: Пограничники | 7: Больница Red Country | 8: Полиция Red Country");
			SendClientMessage(playerid, COLOR_GRAY, "[ банды ] | 9: Гопники | 10: Фермеры | 11: Скинхеды | 12: Vagos | 13: Вагос");
			SendClientMessage(playerid, COLOR_GRAY, "[ мафии ] | 14: Байкеры | 15: Не трогать | 16: Не трогать");
			SendClientMessage(playerid, COLOR_GRAY, "[ информация ] | 0: Убрать фракцию/банду/мафию у игрока");
			return true;
		}
		new setorg = strval(tmp);
		if(setorg < 0 || setorg > 16) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верный id фракции. Используй id от 0 до 16");
		if(IsPlayerConnected(giveplayerid))
		{
			if(setorg != 0)
			{
				switch(setorg)
				{
				case 1: setorg = MERIA_ORG;
				case 2: setorg = HITMAN_ORG;
				case 3: setorg = TRANSPORT_ORG;
				case 4: setorg = ADVOKAT_ORG;
				case 5: setorg = REPORTER_ORG;
				case 6: setorg = ARMY_ORG;
				case 7: setorg = MEDIC_ORG;
				case 8: setorg = PATRUL_ORG;
				case 9: setorg = GROOVE_GANG;
				case 10: setorg = BALLAS_GANG;
				case 11: setorg = VAGOS_GANG;
				case 12: setorg = RIFA_GANG;
				case 13: setorg = AZTECAS_GANG;
				case 14: setorg = NOSTRA_MAFIA;
				case 15: setorg = YAKUZA_MAFIA;
				case 16: setorg = RUSSIAN_MAFIA;
				}
				if(PlayerInfo[giveplayerid][pLeader] == setorg) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок уже находиться в указанной тобой организации");
				if(PlayerInfo[giveplayerid][pLeader] != 0) settext(FractionInfo[PlayerInfo[giveplayerid][pLeader]][fLeader], "none");
				PlayerInfo[giveplayerid][pLeader] = setorg;
				PlayerInfo[giveplayerid][pRank] = 9;
				PlayerInfo[giveplayerid][pMember] = setorg;
				PlayerInfo[giveplayerid][pZam] = 0;
				settext(FractionInfo[setorg][fLeader], PlayerName[giveplayerid]);
				SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
				if(GetOrganizationType(setorg) == 2)
				{
					f(string, "Администратор {F0EFD8}%s{FFFEBF} сделал тебя лидером банды {F0EFD8}%s", PlayerNameEx[playerid], GetOrganizationName(setorg));
					SendClientMessage(giveplayerid, COLOR_CREAM, string);
					f(string, "Новый лидер банды {F0EFD8}%s{FFFEBF} игрок {F0EFD8}%s", GetOrganizationName(setorg), PlayerNameEx[giveplayerid]);
					SendClientMessageToAll(COLOR_CREAM, string);
					SendClientMessage(giveplayerid, COLOR_YELLOW, "Чтобы переодется в служебную форму [/переодется]");
				}
				if(GetOrganizationType(setorg) == 1)
				{
					f(string, "Администратор {F0EFD8}%s{FFFEBF} сделал тебя лидером фракции {F0EFD8}%s", PlayerNameEx[playerid], GetOrganizationName(setorg));
					SendClientMessage(giveplayerid, COLOR_CREAM, string);
					f(string, "Новый лидер фракции {F0EFD8}%s{FFFEBF} игрок {F0EFD8}%s", GetOrganizationName(setorg), PlayerNameEx[giveplayerid]);
					SendClientMessage(giveplayerid, COLOR_YELLOW, "Чтобы переодется в служебную форму [/переодется]");
					SendClientMessageToAll(COLOR_CREAM, string);
				}
				if(GetOrganizationType(setorg) == 3)
				{
					f(string, "Администратор {F0EFD8}%s{FFFEBF} сделал тебя лидером мафии {F0EFD8}%s", PlayerNameEx[playerid], GetOrganizationName(setorg));
					SendClientMessage(giveplayerid, COLOR_CREAM, string);
					f(string, "Новый лидер мафии {F0EFD8}%s{FFFEBF} игрок {F0EFD8}%s", GetOrganizationName(setorg), PlayerNameEx[giveplayerid]);
					SendClientMessage(giveplayerid, COLOR_YELLOW, "Чтобы переодется в служебную форму [/переодется]");
					SendClientMessageToAll(COLOR_CREAM, string);
				}
				RemovePlayerAllWeaponEx(giveplayerid);
				GetPlayerSavedPos(giveplayerid);
				GetPlayerSavedCar(giveplayerid);
				}
			else
			{
				if(PlayerInfo[giveplayerid][pLeader] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок не находиться в какой-либо организации");
				new oldorg = PlayerInfo[giveplayerid][pMember];
				PlayerInfo[giveplayerid][pLeader] = 0;
				PlayerInfo[giveplayerid][pMember] = 0;
				PlayerInfo[giveplayerid][pZam] = 0;
				PlayerInfo[giveplayerid][pRank] = 0;
				if(PlayerInfo[giveplayerid][pHouse] != 0) PlayerInfo[giveplayerid][pSpawn] = 1;
				else PlayerInfo[giveplayerid][pSpawn] = 0;
				settext(FractionInfo[oldorg][fLeader], "none");
				if(GetOrganizationType(oldorg) == 2)
				{
					f(string, "Администратор {F0EFD8}%s{FFFEBF} убрал у тебя лидерку банды {F0EFD8}%s", PlayerNameEx[playerid], GetOrganizationName(oldorg));
					SendClientMessage(giveplayerid, COLOR_CREAM, string);
					f(string, "С лидерки банды {F0EFD8}%s{FFFEBF} был убран игрок {F0EFD8}%s", GetOrganizationName(oldorg), PlayerNameEx[giveplayerid]);
					SendClientMessageToAll(COLOR_CREAM, string);
				}
				if(GetOrganizationType(oldorg) == 1)
				{
					f(string, "Администратор {F0EFD8}%s{FFFEBF} убрал у тебя лидерку фракции {F0EFD8}%s", PlayerNameEx[playerid], GetOrganizationName(oldorg));
					SendClientMessage(giveplayerid, COLOR_CREAM, string);
					f(string, "С лидерки фракции {F0EFD8}%s{FFFEBF} был убран игрок {F0EFD8}%s", GetOrganizationName(oldorg), PlayerNameEx[giveplayerid]);
					SendClientMessageToAll(COLOR_CREAM, string);
				}
				if(GetOrganizationType(oldorg) == 3)
				{
					f(string, "Администратор {F0EFD8}%s{FFFEBF} убрал у тебя лидерку мафии {F0EFD8}%s", PlayerNameEx[playerid], GetOrganizationName(oldorg));
					SendClientMessage(giveplayerid, COLOR_CREAM, string);
					f(string, "С лидерки мафии {F0EFD8}%s{FFFEBF} был убран игрок {F0EFD8}%s", GetOrganizationName(oldorg), PlayerNameEx[giveplayerid]);
					SendClientMessageToAll(COLOR_CREAM, string);
				}
				RemovePlayerAllWeaponEx(giveplayerid);
				GetPlayerSavedPos(giveplayerid);
				GetPlayerSavedCar(giveplayerid);
				if(PlayerInfo[giveplayerid][pSex] == 1)
				{
					SelectCharSkin[giveplayerid] = 1;
					SetPlayerSkin(giveplayerid, ClassMan[0]);
				}
				else if(PlayerInfo[giveplayerid][pSex] == 2)
				{
					SelectCharSkin[giveplayerid] = 1;
					SetPlayerSkin(giveplayerid, ClassWoman[0]);
				}
				ShowMenuForPlayer(SkinMenu, giveplayerid);
				SetPlayerInterior(giveplayerid, 5);
				SetPlayerArmourEx(giveplayerid, 0);
				SetPlayerHealthEx(giveplayerid, 100);
				PlayerInClothing[giveplayerid] = true;
				SetPlayerCameraLookAt(giveplayerid, 208.800, -1.0000, 1001.2100);
				SetPlayerCameraPos(giveplayerid, 208.800, -4.0000, 1001.2000);
				SetPlayerPos(giveplayerid, 208.800, -1.7000, 1001.2100);
				SetPlayerFacingAngle(giveplayerid, 180.0);
				TogglePlayerControllable(giveplayerid, false);
				SetPlayerVirtualWorld(giveplayerid, SKIN_MIR+giveplayerid);
			}
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}
	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/sethp", true))
	{
		new health;
		if(PlayerInfo[playerid][pAdmin] < 2) return MSG_NOADMIN1(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /sethp [ id игрока ] [ количество жизней ]");
		giveplayerid = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /sethp [ id игрока ] [ количество жизней ]");
		health = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(health < 0 || health > 100) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верное количество жизней. Используй количество от 0 до 100");
			SetPlayerHealthEx(giveplayerid, health);
			f(string, "Администратор {F0EFD8}%s{FFFEBF} поставил твои жизни на {F0EFD8}%d", PlayerNameEx[playerid], health);
			SendClientMessage(giveplayerid, COLOR_CREAM, string);
			f(string, "Ты поставил жизни игрока {F0EFD8}%s{FFFEBF} на {F0EFD8}%d", PlayerNameEx[giveplayerid], health);
			SendClientMessage(playerid, COLOR_CREAM, string);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/setlevel", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 4) return MSG_NOADMIN3(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /setlevel [ id игрока ] [ уровень ]");
		giveplayerid = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /setlevel [ id игрока ] [ уровень ]");
		new setlevel = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(setlevel < 1 || setlevel > 100) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верный уровень. Используй уровень от 1 до 100");
			PlayerInfo[giveplayerid][pLevel] = setlevel;
			SetPlayerScore(giveplayerid, setlevel);
			f(string, "Администратор {F0EFD8}%s{FFFEBF} поставил твой уровень на {F0EFD8}%d", PlayerNameEx[playerid], setlevel);
			SendClientMessage(giveplayerid,COLOR_CREAM, string);
			f(string, "Ты поставил игроку {F0EFD8}%s{FFFEBF} уровень на {F0EFD8}%d", PlayerNameEx[giveplayerid], setlevel);
			SendClientMessage(playerid,COLOR_CREAM, string);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------
    if(strcmp(cmd, "/eat", true) == 0)
    {
        if(IsPlayerConnected(playerid))
        {
            if(GetPVarInt(playerid,"respeat")== 0) return SendClientMessage(playerid, COLOR_YELLOW, "У вас нету еды в руках!");
            PlayerInfo[playerid][pSitosti] += 20;
            PlayerInfo[playerid][pJajda] += 20;
            SetProgressBarValue(playerid, sitosti[playerid], PlayerInfo[playerid][pSitosti]);
    		UpdateProgressBar(sitosti[playerid], playerid);
    		SetProgressBarValue(playerid, Voda[playerid], PlayerInfo[playerid][pJajda]);
    		UpdateProgressBar(Voda[playerid], playerid);
            ApplyAnimation(playerid,"FOOD","EAT_Burger",4.1,0,1,1,1,1);
            ClearAnimations(playerid,1);
            if(IsPlayerAttachedObjectSlotUsed(playerid,5)) RemovePlayerAttachedObject(playerid,5);
            SetPlayerHealthEx(playerid, 100);
            SetPVarInt(playerid,"respeat",0);
            ClearAnimations(playerid);
            return 1;
        }
        return 1;
    }
	//------------------------------------------------------------------------------
	else if(!strcmp(cmd, "/makeadmin", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 5) return MSG_NOADMIN4(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /makeadmin [ id игрока ] [ уровень админки ]");
		giveplayerid = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /makeadmin [ id игрока ] [ уровень админки ]");
		new setadmin = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(setadmin < 0 || setadmin > 4) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верный уровень админки. Используй уровень от 0 до 3");
			if(PlayerInfo[giveplayerid][pAdmin] == setadmin) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок уже имеет указанный тобой уровень администратора");
			if(setadmin == 0)
			{
				PlayerInfo[giveplayerid][pAdmin] = setadmin;
				f(string, "Администратор {F0EFD8}%s{FFFEBF} отобрал у тебя админку.", PlayerNameEx[playerid]);
				SendClientMessage(giveplayerid, COLOR_CREAM, string);
				f(string, "Ты отобрал админку у игрока {F0EFD8}%s", PlayerNameEx[giveplayerid]);
				SendClientMessage(playerid, COLOR_CREAM, string);
			}
			else
			{
				new admin_text[120];
				if(setadmin == 1)
				{
					f(string, "Администратор {F0EFD8}%s{FFFEBF} сделал тебя обычным админом.", PlayerNameEx[playerid]);
					SendClientMessage(giveplayerid, COLOR_CREAM, string);
					f(string, "Ты сделал игрока {F0EFD8}%s{FFFEBF} обычным админом.", PlayerNameEx[giveplayerid]);
					SendClientMessage(playerid, COLOR_CREAM, string);
					admin_text = "Обычный";
				}
				else
				{
					f(string, "Администратор {F0EFD8}%s{FFFEBF} сделал тебя главным админом.", PlayerNameEx[playerid]);
					SendClientMessage(giveplayerid, COLOR_CREAM, string);
					f(string, "Ты сделал игрока {F0EFD8}%s{FFFEBF} главным админом.", PlayerNameEx[giveplayerid]);
					SendClientMessage(playerid, COLOR_CREAM, string);
					admin_text = "Главный";
				}
				if(PlayerInfo[giveplayerid][pAdmin] == 0)
				{
					f(string, "Твой пароль администратора: {CEF024}%d {FAC341}(Обязательно запомни этот пароль)", SERVER_PASS);
					SendClientMessage(giveplayerid, 0xFFAE00FF, string);
				}
				PlayerInfo[giveplayerid][pAdmin] = setadmin;
			}
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/makehelper", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 4) return MSG_NOADMIN3(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /makehelper [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(PlayerInfo[giveplayerid][pHelper] == 0)
			{
				PlayerInfo[giveplayerid][pHelper] = 1;
				f(string, "Администратор {F0EFD8}%s{FFFEBF} сделал тебя хэлпером сервера", PlayerNameEx[playerid]);
				SendClientMessage(giveplayerid, COLOR_CREAM, string);
				f(string, "Ты сделал хэлпером сервера игрока {F0EFD8}%s", PlayerNameEx[giveplayerid]);
				SendClientMessage(playerid, COLOR_CREAM, string);
			}
			else
			{
				PlayerInfo[giveplayerid][pHelper] = 0;
				f(string, "Администратор {F0EFD8}%s{FFFEBF} убрал у тебя статус хэлпера сервера", PlayerNameEx[playerid]);
				SendClientMessage(giveplayerid, COLOR_CREAM, string);
				f(string, "Ты убрал статус хэлпера сервера у игрока {F0EFD8}%s", PlayerNameEx[giveplayerid]);
				SendClientMessage(playerid, COLOR_CREAM, string);
			}
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/setskin", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 2) return MSG_NOADMIN1(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /setskin [ id игрока ] [ id скина ]");
		giveplayerid = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /setskin [ id игрока ] [ id скина ]");
		new skin = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(skin < 0 || skin > 299) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верный id скина. Используй id от 0 до 299");
			if(PlayerInfo[giveplayerid][pMember] != 0) return SendClientMessage(playerid, COLOR_GREEN, "Игроку находящемуся во фракции нельзя сменить скин");
			PlayerInfo[giveplayerid][pSkin] = skin;
			SetPlayerSkin(giveplayerid, skin);
			f(string, "Администратор {F0EFD8}%s{FFFEBF} установил скин {F0EFD8}%d", PlayerNameEx[playerid], skin);
			SendClientMessage(giveplayerid, COLOR_CREAM, string);
			f(string, "Ты установил игроку {F0EFD8}%s{FFFEBF} скин {F0EFD8}%d", PlayerNameEx[giveplayerid], skin);
			SendClientMessage(playerid, COLOR_CREAM, string);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/glic", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 1) return MSG_NOADMIN1(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
		{
			SendClientMessage(playerid, COLOR_GREEN, "» Использование: /glic [ id игрока ] [ номер лицензии ]");
			SendClientMessage(playerid, COLOR_GRAY, "| 1: Оружие | 2: Рыбалка");
			SendClientMessage(playerid, COLOR_GRAY, "| 3: Наземный трансопрт");
			SendClientMessage(playerid, COLOR_GRAY, "| 4: Водный трансопрт");
			SendClientMessage(playerid, COLOR_GRAY, "| 5: Воздушный трансопрт");
			return true;
		}
		giveplayerid = strval(tmp);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
		{
			SendClientMessage(playerid, COLOR_GREEN, "» Использование: /glic [ id игрока ] [ номер лицензии ]");
			SendClientMessage(playerid, COLOR_GRAY, "| 1: Оружие | 2: Рыбалка");
			SendClientMessage(playerid, COLOR_GRAY, "| 3: Наземный транспорт");
			SendClientMessage(playerid, COLOR_GRAY, "| 4: Водный транспорт");
			SendClientMessage(playerid, COLOR_GRAY, "| 5: Воздушный транспорт");
			SendClientMessage(playerid, COLOR_GRAY, "| 6: Добыча золота");
			return true;
		}
		new licenses = strval(tmp);
		if(licenses < 1 || licenses > 5) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верный номер лицензии. Используй номер от 1 до 5");
		if(IsPlayerConnected(giveplayerid))
		{
			new lic_text[64];
			if(licenses == 1)
			{
				PlayerInfo[giveplayerid][pLicGun] = 1;
				lic_text = "оружие";
			}
			if(licenses == 2)
			{
				PlayerInfo[giveplayerid][pLicFish] = 1;
				lic_text = "рыбалку";
			}
			if(licenses == 3)
			{
				PlayerInfo[giveplayerid][pLicCar] = 1;
				lic_text = "наземный транспорт";
			}
			if(licenses == 4)
			{
				PlayerInfo[giveplayerid][pLicBoat] = 1;
				lic_text = "водный транспорт";
			}
			if(licenses == 5)
			{
				PlayerInfo[giveplayerid][pLicFly] = 1;
				lic_text = "воздушный транспорт";
			}
			if(licenses == 6)
			{
				PlayerInfo[giveplayerid][pLicGold] = 1;
				lic_text = "добыча золота";
			}
			f(string, "Администратор {F0EFD8}%s{FFFEBF} выдал тебе лицензию на {F0EFD8}%s", PlayerNameEx[playerid], lic_text);
			SendClientMessage(giveplayerid, COLOR_CREAM, string);
			f(string, "Ты выдал лицензию на {F0EFD8}%s{FFFEBF} игроку {F0EFD8}%s", lic_text, PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_CREAM, string);
