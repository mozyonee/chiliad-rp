			else f(stats, "{DAF04F}Телефон: {FFFFFF}%d\n", PlayerInfo[playerid][pPhNumber]);
			strcat(stringx, stats);
			f(stats, "{DAF04F}Количество убийств: {FFFFFF}%d\n", PlayerInfo[playerid][pKills]);
			strcat(stringx, stats);
			f(stats, "{DAF04F}Количество арестов: {FFFFFF}%d\n", PlayerInfo[playerid][pJailed]);
			strcat(stringx, stats);
			f(stats, "{DAF04F}Законопослушность: {FFFFFF}%d%%\n", PlayerInfo[playerid][pZakon]);
			strcat(stringx, stats);
			f(stats, "{DAF04F}Лет в Деревни: {FFFFFF}%d\n", PlayerInfo[playerid][pLevel]);
			strcat(stringx, stats);
			strcat(stringx, "{A0BA1E}____________________________\n\n");
			f(stats, "{DAF04F}Дом: {FFFFFF}%s\n", house_text);
			strcat(stringx, stats);
			f(stats, "{DAF04F}Фракция: {FFFFFF}%s\n", GetOrganizationName(PlayerInfo[playerid][pMember]));
			strcat(stringx, stats);
			f(stats, "{DAF04F}Медкарта: {FFFFFF}%s\n", medkart_text);
			strcat(stringx, stats);
			f(stats, "{DAF04F}Регистрация Авто: {FFFFFF}%s\n", carlic_text);
			strcat(stringx, stats);
			f(stats, "{DAF04F}Работа: {FFFFFF}%s\n", gJobInfo[PlayerInfo[playerid][pJob]][JOB_NAME]);
			strcat(stringx, stats);
			if(PlayerInfo[playerid][pSex] == 2) f(stats, "{DAF04F}Муж: {FFFFFF}%s\n", PlayerInfo[playerid][pMarriage]);
			else f(stats, "{DAF04F}Жена: {FFFFFF}%s\n", PlayerInfo[playerid][pMarriage]);
			strcat(stringx, stats);
			strcat(stringx, "{A0BA1E}____________________________");
			ShowDialog(giveplayerid, 00000, DIALOG_STYLE_MSGBOX, "Просмотр паспорта", stringx, "Закрыть", "");
			SetPlayerChatBubble(playerid, "Показал паспорт", COLOR_AQUA, 30.0, 5000);
