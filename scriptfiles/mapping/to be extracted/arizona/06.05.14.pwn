			{
			case 0:
				{
					if(IsPlayerInAnyVehicle(playerid))
					{
						MSG_INVEHICLE(playerid);
						ShowPlayerItemsDialog(playerid);
						return true;
					}
					if(PlayerInfo[playerid][pWine] == 0) return ShowPlayerItemsDialog(playerid);
