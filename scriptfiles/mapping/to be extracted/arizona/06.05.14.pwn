		new goldsnum = strval(tmp);
		if(goldsnum > PlayerInfo[playerid][pGold]) return SendClientMessage(playerid, COLOR_GREEN, "У тебя нет столько драгоценностей");
		if(goldsnum < 1) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верное количество драгоценностей");
		new moneyfrom = (goldsnum * (random(10)+100));
		f(string, "Ты продал {9DDAF2}%d{FFFFFF} шт. золотых изделей", goldsnum);
		SendClientMessage(playerid, COLOR_WHITE, string);
		GivePlayerMoneyEx(playerid, moneyfrom);
		PlayerInfo[playerid][pGold] -= goldsnum;
		return true;
	}

	else if(!strcmp(cmd, "/cookfish", true))
	{
		if(!IsEatery(playerid) && !IsInPlayerHouse[playerid][PlayerInfo[playerid][pHouse]]) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен находиться в закусочной или у себя дома");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /cookfish [ количество рыбы ]");
		new fishnum = strval(tmp);
		if(fishnum > PlayerInfo[playerid][pFish]) return SendClientMessage(playerid, COLOR_GREEN, "У тебя нет столько рыбы");
		if(fishnum < 1) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верное количество рыбы");
		PlayerInfo[playerid][pFish] -= fishnum;
		PlayerInfo[playerid][pCfish] += fishnum;
		f(string, "Ты приготовил {9DDAF2}%d{FFFFFF} шт. рыбы.", fishnum);
		SendClientMessage(playerid, COLOR_WHITE, string);
		return true;
	}

	else if(!strcmp(cmd, "/setpass", true))
	{
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /setpass [ новый пароль ]");
		settext(PlayerInfo[playerid][pPassword], result);
		f(string, "Изменения вступили в силу! Твой новый пароль {9DDAF2}%s", result);
		SendClientMessage(playerid, COLOR_WHITE, string);
		return true;
	}

	else if(!strcmp(cmd, "/engine", true) || !strcmp(cmd, "/en", true))
	{
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return MSG_NODRIVER(playerid);
		new vehicleid = GetPlayerVehicleID(playerid);
		if(IsEngineCar(vehicleid))
		{
			if(RefuelVehicle[vehicleid]) return SendClientMessage(playerid, COLOR_GREEN, "Ты не можешь пользоваться ключом зажигания во время заправки машины");
			if(!VehicleEndeng[vehicleid]) return true;
			if(!VehicleEngine[vehicleid])
			{
				VehicleEndeng[vehicleid] = false;
				SetTimerEx("EnginePlayerVehicle", 2000, false, "ii", playerid, vehicleid);
				GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~ENGINE STARTING...", 2000, 3);
			}
			else
			{
				new engine,lights,alarm,doors,bonnet,boot,objective;
				GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
				SetVehicleParamsEx(vehicleid,false,lights,alarm,doors,bonnet,boot,objective);
				VehicleEngine[vehicleid] = false;
				SetPlayerChatBubble(playerid, "Заглушил двигатель", COLOR_AQUA, 30.0, 5000);
				GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~ENGINE OFF", 3000, 3);
			}
		}
		else
		{
			SendClientMessage(playerid, COLOR_GREEN, "В данном транспорте нельзя завести/заглушить двигатель");
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/lights", true) || !strcmp(cmd, "/light", true))
	{
		new vehicleid = GetPlayerVehicleID(playerid);
		if(!IsBmx(vehicleid) && !IsRcCar(vehicleid))
		{
			new engine,lights,alarm,doors,bonnet,boot,objective;
			if(!VehicleLights[vehicleid])
			{
				GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~LIGHTS ON", 3000, 3);
				GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
				SetVehicleParamsEx(vehicleid,engine,true,alarm,doors,bonnet,boot,objective);
				VehicleLights[vehicleid] = true;
			}
			else
			{
				GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~LIGHTS OFF", 3000, 3);
				GetVehicleParamsEx(vehicleid,engine,lights,alarm,doors,bonnet,boot,objective);
				SetVehicleParamsEx(vehicleid,engine,false,alarm,doors,bonnet,boot,objective);
				VehicleLights[vehicleid] = false;
			}
		}
		else
		{
			SendClientMessage(playerid, COLOR_GREEN, "В данном транспорте нельзя включить/выключить фары");
		}
		return true;
	}
	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/limit", true))
	{
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return MSG_NODRIVER(playerid);
		if(PlayerStartSchool[playerid] != 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты временно не можешь использовать эту команду");
		new vehicleid = GetPlayerVehicleID(playerid);
		if(IsEngineCar(vehicleid))
		{
			if(!VehicleLimitSpeed[vehicleid])
			{
				GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~LIMIT ON", 3000, 3);
				VehicleLimitSpeed[vehicleid] = true;
			}
			else
			{
				GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~LIMIT OFF", 3000, 3);
				VehicleLimitSpeed[vehicleid] = false;
			}
		}
		else
		{
			SendClientMessage(playerid, COLOR_GREEN, "В данном транспорте нельзя установить лимит скорости");
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/bezopas", true))
	{
		if(!IsPlayerInAnyVehicle(playerid)) return MSG_NOVEHICLE(playerid);
		if(IsEngineCar(GetPlayerVehicleID(playerid)))
		{
			if(!PlayerOnRemen[playerid])
			{
				if(IsMoto(GetPlayerVehicleID(playerid)))
				{
					SendClientMessage(playerid, COLOR_WHITE, "Ты одел защитный шлем");
					SetPlayerChatBubble(playerid, "Одел защитный шлем", COLOR_AQUA, 30.0, 5000);
				}
				else
				{
					SendClientMessage(playerid, COLOR_WHITE, " Вы пристегнули ремень безопасности");
					SetPlayerChatBubble(playerid, "Одел ремень безопасности", COLOR_AQUA, 30.0, 5000);
				}
			}
			else
			{
				if(IsMoto(GetPlayerVehicleID(playerid)))
				{
					SendClientMessage(playerid, COLOR_WHITE, "Ты снял защитный шлем");
					SetPlayerChatBubble(playerid, "Снял защитный шлем", COLOR_AQUA, 30.0, 5000);
				}
				else
				{
					SendClientMessage(playerid, COLOR_WHITE, "Ты снял ремень безопасности");
					SetPlayerChatBubble(playerid, "Снял ремень безопасности", COLOR_AQUA, 30.0, 5000);
				}
			}
			PlayerPlaySound(playerid, 1145, 0.0, 0.0, 0.0);
			PlayerOnRemen[playerid] = !PlayerOnRemen[playerid];
		}
		else
		{
			SendClientMessage(playerid, COLOR_GREEN, "В данном транспорте нет ремня безопасности");
		}
		return true;
	}

	else if(!strcmp(cmd, "/vehicle", true) || !strcmp(cmd, "/v", true))
	{
		if(PlayerInfo[playerid][pVehicle] == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_GREEN, "Ты не владеешь собственной машиной");
		new Float:POS[3];
		GetVehiclePos(PlayerInfo[playerid][pVehicle], POS[0], POS[1], POS[2]);
		if(!PlayerToPoint(playerid, 5, POS[0], POS[1], POS[2])) return SendClientMessage(playerid, COLOR_GREEN, "Ты находишься слишком далеко от своей машины");
		ShowDialog(playerid, BUYCAR_ID+1, DIALOG_STYLE_LIST, "Управление машиной", "\
[1] Убрать тюнинг\n\
[2] Припарковаться\n\
[3] Сменить цвет\n\
[4] Продать машину\n\
[4] Продать машину игроку\
", "Выбрать", "Отмена");
		return true;
	}
	
	else if(!strcmp(cmd, "/unload", true))
	{
		if(PlayerInfo[playerid][pJob] != TRUCK_JOB
				&& PlayerInfo[playerid][pJob] != COLLECTOR_JOB
				&& PlayerInfo[playerid][pJob] != GASTRUCK_JOB
				&& PlayerInfo[playerid][pJob] != AMMO_JOB
				&& PlayerInfo[playerid][pJob] != STICK_JOB) return SendClientMessage(playerid, COLOR_GREEN, "Ты не устроился на ту работу, где можно использовать эту команду");
		if(PlayerInfo[playerid][pJob] == TRUCK_JOB)
		{
			if(IsTruckCar(GetPlayerVehicleID(playerid)))
			{
				if(Checkpoint[TRUCK_JOB][playerid] == 999) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже разгружаешь грузовик");
				if(Checkpoint[TRUCK_JOB][playerid] == 1 || !IsPlayerInRaceCheckpoint(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не достиг места разгрузки");
				if(Checkpoint[TRUCK_JOB][playerid] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не начал работу развозчика товаров");
				if(Checkpoint[TRUCK_JOB][playerid] == 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже разгрузил грузовик");
				if(Checkpoint[TRUCK_JOB][playerid] == 2)
				{
					DisablePlayerRaceCheckpoint(playerid);
					TogglePlayerControllable(playerid, false);
					SendClientMessage(playerid, COLOR_WHITE, "Разгрузка грузовика началась...");
					SetTimerEx("RazgruzTruck", 20000, false, "i", playerid);
					Checkpoint[TRUCK_JOB][playerid] = 999;
					return true;
				}
			}
			else
			{
				SendClientMessage(playerid, COLOR_GREEN, "Ты должен находиться в грузовике и быть за рулём");
			}
			return true;
		}
		if(PlayerInfo[playerid][pJob] == AMMO_JOB)
		{
			if(IsAmmoCar(GetPlayerVehicleID(playerid)))
			{
				if(Checkpoint[AMMO_JOB][playerid] == 999) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже разгружаешь фургон");
				if(Checkpoint[AMMO_JOB][playerid] == 1 || Checkpoint[AMMO_JOB][playerid] == 2 || Checkpoint[AMMO_JOB][playerid] == 3 || Checkpoint[AMMO_JOB][playerid] == 888 || !IsPlayerInRaceCheckpoint(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не достиг места разгрузки");
				if(Checkpoint[AMMO_JOB][playerid] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не начал работу гандиллера");
				if(Checkpoint[AMMO_JOB][playerid] == 5) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже разгрузил фургон");
				if(Checkpoint[AMMO_JOB][playerid] == 4)
				{
					DisablePlayerRaceCheckpoint(playerid);
					TogglePlayerControllable(playerid, false);
					SendClientMessage(playerid, COLOR_WHITE, "Разгрузка фургона началась...");
					SetTimerEx("RazgruzAmmo", 15000, false, "i", playerid);
					Checkpoint[AMMO_JOB][playerid] = 999;
					return true;
				}
			}
			else
			{
				SendClientMessage(playerid, COLOR_GREEN, "Ты должен находиться в фургоне и быть за рулём");
			}
			return true;
		}
		if(PlayerInfo[playerid][pJob] == STICK_JOB)
		{
			if(IsStickCar(GetPlayerVehicleID(playerid)))
			{
				if(Checkpoint[STICK_JOB][playerid] == 999) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже разгружаешь фургон");
				if(Checkpoint[STICK_JOB][playerid] == 1 || Checkpoint[STICK_JOB][playerid] == 101 || Checkpoint[STICK_JOB][playerid] == 2 || Checkpoint[STICK_JOB][playerid] == 102 || Checkpoint[STICK_JOB][playerid] == 3 || Checkpoint[STICK_JOB][playerid] == 103 || Checkpoint[STICK_JOB][playerid] == 888 || !IsPlayerInRaceCheckpoint(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не достиг места разгрузки");
				if(Checkpoint[STICK_JOB][playerid] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не начал работу мебельера");
				if(Checkpoint[STICK_JOB][playerid] == 5 || Checkpoint[STICK_JOB][playerid] == 105) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже разгрузил фургон");
				if(Checkpoint[STICK_JOB][playerid] == 4)
				{
					DisablePlayerRaceCheckpoint(playerid);
					TogglePlayerControllable(playerid, false);
					SendClientMessage(playerid, COLOR_WHITE, "Разгрузка фургона началась...");
					SetTimerEx("RazgruzStick1", 15000, false, "i", playerid);
					Checkpoint[STICK_JOB][playerid] = 999;
					return true;
				}
				if(Checkpoint[STICK_JOB][playerid] == 104)
				{
					DisablePlayerRaceCheckpoint(playerid);
					TogglePlayerControllable(playerid, false);
					SendClientMessage(playerid, COLOR_WHITE, "Разгрузка фургона началась...");
					SetTimerEx("RazgruzStick2", 15000, false, "i", playerid);
					Checkpoint[STICK_JOB][playerid] = 999;
					return true;
				}
			}
			else
			{
				SendClientMessage(playerid, COLOR_GREEN, "Ты должен находиться в фургоне и быть за рулём");
