stock LoadGangZones()
{
	if(!fexist("gzones.cfg")) return printf("file 'gzones.cfg' not found");
	new arrCoords[5][64],strFromFile[256],i;
	new File:GetFile = fopen("gzones.cfg");
	while(fread(GetFile, strFromFile))
	{
		if(!strlen(strFromFile)) break;
		split(strFromFile, arrCoords, '|');
		GangZoneInfo[i][gzPos][0] = floatstr(arrCoords[0]);
		GangZoneInfo[i][gzPos][1] = floatstr(arrCoords[1]);
		GangZoneInfo[i][gzPos][2] = floatstr(arrCoords[2]);
		GangZoneInfo[i][gzPos][3] = floatstr(arrCoords[3]);
		GangZoneInfo[i][gzGang] = strval(arrCoords[4]);
		GangZoneInfo[i][gzZone] = GangZoneCreate(GangZoneInfo[i][gzPos][0], GangZoneInfo[i][gzPos][1], GangZoneInfo[i][gzPos][2], GangZoneInfo[i][gzPos][3]);
		ZoneOnBattle[i] = false;
		SafeTime[i] = 0;
		i += 1;
	}
	fclose(GetFile);
	return true;
}

