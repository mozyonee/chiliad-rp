	else if(!strcmp(cmd, "/tie", true))
	{
		if(GetOrganizationType(PlayerInfo[playerid][pMember]) != 2 && GetOrganizationType(PlayerInfo[playerid][pMember]) != 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты не состоишь в какой-либо банде или мафии");
		if(PlayerInfo[playerid][pRank] < 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть третьего ранга, чтобы связывать игроков");
		if(PlayerInDuel[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь на дуэли, ты не можешь связывать игроков");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь связывать игроков");
		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь связывать игроков");
		if(!IsPlayerInAnyVehicle(playerid)) return MSG_NOVEHICLE(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /tie [ id игрока ]");
		giveplayerid = strval(tmp);
		if(!IsPlayerConnected(giveplayerid)) return MSG_NOTPLAYER(playerid);
		if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
		if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
		if(PlayerTied[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "Указанный тобой игрок уже связан");
		if(!IsPlayerInVehicle(giveplayerid, GetPlayerVehicleID(playerid))) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок не сидит в твоей машине");
		f(string, "Ты связал игрока {9DDAF2}%s", PlayerNameEx[giveplayerid]);
		SendClientMessage(playerid, COLOR_WHITE, string);
		f(string, "Игрок {9DDAF2}%s{FFFFFF} связал тебя.", PlayerNameEx[playerid]);
		SendClientMessage(giveplayerid, COLOR_WHITE, string);
		GameTextForPlayer(giveplayerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~TIED", 3000, 3);
		PlayerTied[giveplayerid] = true;
		TogglePlayerControllable(giveplayerid, false);
		return true;
	}

	else if(!strcmp(cmd, "/untie", true))
	{
		if(GetOrganizationType(PlayerInfo[playerid][pMember]) != 2 && GetOrganizationType(PlayerInfo[playerid][pMember]) != 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты не состоишь в какой-либо банде или мафии");
		if(PlayerInfo[playerid][pRank] < 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть третьего ранга, чтобы развязывать игроков");
		if(PlayerInDuel[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь на дуэли, ты не можешь развязывать игроков");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь развязывать игроков");
		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь развязывать игроков");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /untie [ id игрока ]");
		giveplayerid = strval(tmp);
		if(!IsPlayerConnected(giveplayerid)) return MSG_NOTPLAYER(playerid);
		if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
		if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
		if(!PlayerTied[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "Указанный тобой игрок не связан");
		f(string, "Ты развязал игрока {9DDAF2}%s", PlayerNameEx[giveplayerid]);
		SendClientMessage(playerid, COLOR_WHITE, string);
		f(string, "Игрок {9DDAF2}%s{FFFFFF} развязал тебя.", PlayerNameEx[playerid]);
		SendClientMessage(giveplayerid, COLOR_WHITE, string);
		GameTextForPlayer(giveplayerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~UNTIED", 3000, 3);
