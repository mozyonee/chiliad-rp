		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь забрать ключ от дома");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /takekey [ id игрока ]");
		giveplayerid = strval(tmp);
		if(!IsPlayerConnected(giveplayerid)) return MSG_NOTPLAYER(playerid);
		if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
		if(GetDistancePlayers(playerid, giveplayerid) > 2.0) return MSG_BIGDIST(playerid);
		if(PlayerInfo[giveplayerid][pRent] != PlayerInfo[playerid][pHouse]) return SendClientMessage(playerid, COLOR_GREEN, "Ты не довал этому игроку ключ от своего дома");
		f(string, "Ты забрал ключ от своего дома у гражданина {9DDAF2}%s", PlayerNameEx[giveplayerid]);
		SendClientMessage(playerid, COLOR_WHITE, string);
		f(string, "Игрок {9DDAF2}%s{FFFFFF} забрал у тебя ключ от своего дома", PlayerNameEx[playerid]);
		SendClientMessage(giveplayerid, COLOR_WHITE, string);
		PlayerInfo[giveplayerid][pRent] = 0;
		return true;
	}

	else if(!strcmp(cmd, "/donate", true) || !strcmp(cmd, "/donat", true))
	{
		ShowDialog(playerid, DONAT_ID, DIALOG_STYLE_LIST, "Меню доната", "\
		[1] Приобрести деньги\n\
		[2] Приобрести уровень\n\
		[3] Сменить никнэйм\n\
		[4] Информация по донату\n\
		[5] Проверка баланса\
		", "Выбрать", "Отмена");
		return 1;
	}

	else if(!strcmp(cmd, "/fill", true))
	{
		if(!IsGasStation(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен находиться на бензозаправке");
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return MSG_NODRIVER(playerid);
		new vehicleid = GetPlayerVehicleID(playerid);
		if(!IsFuelCar(vehicleid)) return SendClientMessage(playerid, COLOR_GREEN, "Это транспортное средство не требует заправки");
		if(RefuelVehicle[vehicleid]) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже заправляешь эту машину");
		if(VehicleEngine[vehicleid]) return SendClientMessage(playerid, COLOR_GREEN, "Чтобы начать заправлять машину, ты должен заглушить двигатель");
		new bensinnum = 100-VehicleFuel[vehicleid];
		if(bensinnum < 1) return SendClientMessage(playerid, COLOR_GREEN, "Бензобак твоей машины уже полон");
		if(BusinessInfo[GAS_BIZZ][bFunds] < bensinnum) return SendClientMessage(playerid, COLOR_GREEN, "На бензоправке нет столько бензина");
		GetPlayerOption[playerid] = bensinnum;
		ShowDialog(playerid, FUEL_ID+1, DIALOG_STYLE_LIST, "Заправка машины", "\
		{FFFFFF}[1] Топливо 80\t\t| {CFCFCF}4$ за 1 литр\n\
		{FFFFFF}[2] Топливо 92\t\t| {CFCFCF}5$ за 1 литр\n\
		{FFFFFF}[3] Топливо 95\t\t| {CFCFCF}6$ за 1 литр\n\
		{FFFFFF}[4] Дизельный\t\t| {CFCFCF}3$ за 1 литр\
		", "Выбрать", "Отмена");
		return 1;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/cfill", true))
	{
		if(IsPlayerInAnyVehicle(playerid)) return MSG_INVEHICLE(playerid);
		if(PlayerInfo[playerid][pFuel] == 0) return SendClientMessage(playerid, COLOR_GREEN, "У тебя нет канистры с топливом");
		new vehicleid = INVALID_VEHICLE_ID;
		new Float:POS[3];
		for(new i=0; i<MAX_VEHICLES; i++)
		{
			GetVehiclePos(i, POS[0], POS[1], POS[2]);
			if(PlayerToPoint(playerid, 3.0, POS[0], POS[1], POS[2]))
			{
				vehicleid = i;
				break;
			}
		}
		if(vehicleid == INVALID_VEHICLE_ID) return SendClientMessage(playerid, COLOR_GREEN, "Ты находишься далеко от машины");
		if(!IsFuelCar(vehicleid)) return SendClientMessage(playerid, COLOR_GREEN, "Близжайщее транспортное средство не требует заправки");
		if(IsDiesel(vehicleid) && PlayerInfo[playerid][pFuel] != 1) return SendClientMessage(playerid, COLOR_GREEN, "Бензин твоей канистры не походит для двигателя этой машины");
		if(Is80Fuel(vehicleid) && PlayerInfo[playerid][pFuel] != 80) return SendClientMessage(playerid, COLOR_GREEN, "Бензин твоей канистры не походит для двигателя этой машины");
		if(Is92Fuel(vehicleid) && PlayerInfo[playerid][pFuel] != 92) return SendClientMessage(playerid, COLOR_GREEN, "Бензин твоей канистры не походит для двигателя этой машины");
		if(Is95Fuel(vehicleid) && PlayerInfo[playerid][pFuel] != 95) return SendClientMessage(playerid, COLOR_GREEN, "Бензин твоей канистры не походит для двигателя этой машины");
		SendClientMessage(playerid, COLOR_WHITE, "Ты успешно заправил машину на {9DDAF2}20{FFFFFF} литров");
		VehicleFuel[vehicleid] += 20;
		if(VehicleFuel[vehicleid] > 100) VehicleFuel[vehicleid] = 100;
		PlayerInfo[playerid][pFuel] = 0;
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/fuel", true))
	{
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return MSG_NODRIVER(playerid);
		new vehicleid = GetPlayerVehicleID(playerid);
		if(!IsFuelCar(vehicleid)) return SendClientMessage(playerid, COLOR_GREEN, "Близжайщее транспортное средство не требует заправки");
		new toplivo[32];
		if(IsDiesel(vehicleid)) toplivo = "Дизельный";
		else if(Is80Fuel(vehicleid)) toplivo = "Топливо 80";
		else if(Is92Fuel(vehicleid)) toplivo = "Топливо 92";
		else if(Is95Fuel(vehicleid)) toplivo = "Топливо 95";
		f(string, "Вид топлива данного автомобиля: {9DDAF2}%s", toplivo);
		SendClientMessage(playerid, COLOR_WHITE, string);
		return true;
	}

	//------------------------------------------------------------------------------

		else if(!strcmp(cmd, "/buyfuel", true))
	{
		if(!IsGasStation(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен находиться на бензозаправке");
		if(PlayerInfo[playerid][pFuel] != 0) return SendClientMessage(playerid, COLOR_GREEN, "У тебя уже есть канистра с топливом");
		if(BusinessInfo[GAS_BIZZ][bFunds] < 20) return SendClientMessage(playerid, COLOR_GREEN, "На бензоправке нет бензина");
		ShowDialog(playerid, FUEL_ID, DIALOG_STYLE_LIST, "Покупка канистры", "\
		{FFFFFF}[1] Топливо 80\t\t| {CFCFCF}80$ за 20 литров\n\
		{FFFFFF}[2] Топливо 92\t\t| {CFCFCF}100$ за 20 литров\n\
		{FFFFFF}[3] Топливо 95\t\t| {CFCFCF}120$ за 20 литров\n\
		{FFFFFF}[4] Дизельный\t| {CFCFCF}60$ за 20 литров\
		", "Выбрать", "Отмена");
