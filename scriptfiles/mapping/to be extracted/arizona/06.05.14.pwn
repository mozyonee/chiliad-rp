					{
						MSG_INVEHICLE(playerid);
						ShowPlayerItemsDialog(playerid);
						return true;
					}
					if(PlayerInfo[playerid][pSprunk] == 0) return ShowPlayerItemsDialog(playerid);
					PlayerInfo[playerid][pSprunk] -= 1;
					SetPlayerSpecialAction(playerid, SPECIAL_ACTION_DRINK_SPRUNK);
					SetPlayerChatBubble(playerid, "Пьёт газировку", COLOR_AQUA, 30.0, 5000);
				}
			case 4:
				{
					if(PlayerInfo[playerid][pPolicai] == 0) return ShowPlayerItemsDialog(playerid);
					PlayerInfo[playerid][pPolicai] -= 1;
					SetPlayerDrunkLevel(playerid, 0);
					if(PlayerDrugEffect[playerid] != 0)
					{
						PlayerDrugEffect[playerid] = 0;
						UpdatePlayerDrugEffect(playerid, true);
					}
					SetPlayerChatBubble(playerid, "Использует антиполицай", COLOR_AQUA, 30.0, 5000);
					ShowPlayerItemsDialog(playerid);
				}
			case 5:
				{
					if(PlayerInfo[playerid][pMedkit] == 0) return ShowPlayerItemsDialog(playerid);
					GetPlayerHealth(playerid, health);
					if(health >= 100) return SendClientMessage(playerid, COLOR_GREEN, "Ты не можешь использовать аптечку, так как твоё здоровье полное");
					PlayerInfo[playerid][pMedkit] -= 1;
					SetPlayerHealthEx(playerid, health+20);
					GetPlayerHealth(playerid, health);
					if(health > 100) SetPlayerHealthEx(playerid, 100);
					SetPlayerChatBubble(playerid, "Использует аптечку", COLOR_AQUA, 30.0, 5000);
					ShowPlayerItemsDialog(playerid);
				}
