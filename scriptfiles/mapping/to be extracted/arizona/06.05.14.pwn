public OnSkladUpdate()
{
	new string[64];
	GetGunsOnSklad += 20;
	f(string, "На складе {FFFF00}%d {FFFFFF}шт. материалов", GetGunsOnSklad);
	UpdateDynamic3DTextLabelText(GunsText, 0xFFFFFFFF, string);
	GetWoodsOnSklad += 30;
	f(string, "На складе {FFFF00}%d {FFFFFF}кг. дерева", GetWoodsOnSklad);
	UpdateDynamic3DTextLabelText(WoodsText, 0xFFFFFFFF, string);
	if(GetMaterialsOnSklad < 10)
	{
		GetMaterialsOnSklad -= 10;
		GetStickOnSklad += 10;
	}
	else
	{
		GetStickOnSklad += GetMaterialsOnSklad;
		GetMaterialsOnSklad = 0;
	}
	if(GetMaterialsOnSklad < 0) GetMaterialsOnSklad = 0;
	if(GetStickOnSklad < 0) GetStickOnSklad = 0;
	f(string, "На складе {FFFF00}%d {FFFFFF}дерева", GetMaterialsOnSklad);
	UpdateDynamic3DTextLabelText(MaterialsText, 0xFFFFFFFF, string);
	f(string, "На складе {FFFF00}%d {FFFFFF}мебели", GetStickOnSklad);
	UpdateDynamic3DTextLabelText(StickText, 0xFFFFFFFF, string);
	return true;
}

public GlobalServerTimer()
{
	new string[128],hours,minutes,seconds,Float:health;
	CheckGangZones();
	gettime(hours, minutes, seconds);
	if((minutes == 30 || minutes == 0) && seconds == 0)
	{
		PromoteBusiness(ADV_BIZZ, 500+random(300), 700+random(300));
		PromoteBusiness(PHONE_BIZZ, 800+random(200), 900+random(100));
		PromoteBusiness(KART_BIZZ, 100+random(50), 200+random(50));
	}
	if((minutes == 15 || minutes == 25 || minutes == 35 || minutes == 45 || minutes == 55 || minutes == 5) && seconds == 0)
	{
		SendClientMessageToAll(0xFF0000FF, "=======================================================================================");
		SendClientMessageToAll(0xFFEE00FF, "Возникли вопросы ?? Пиши нам ((/report)) .");
		SendClientMessageToAll(0xFFEE00FF, "Наш сайт : http://villeage.bl.ee/ ");
		SendClientMessageToAll(0xFFEE00FF, "Также вы можете приобрести VIP . Ее достоинства /viphelp");
		SendClientMessageToAll(0xFFEE00FF, "50% скидка на донат , временно через скайп : kucklovod99");
		SendClientMessageToAll(0xFF0000FF, "=======================================================================================");
	}
	if(minutes == 0 && !GetPayDay)
	{
		GivePlayersPayDay(true);
		GetPayDay = true;
	}
	if(minutes == 5 && seconds == 0) GetPayDay = false;
	for(new i=0; i<MAX_GANGZONE; i++)
	{
		if(SafeTime[i] > 0)
		{
			SafeTime[i] -= 1;
			if(SafeTime[i] == 60)
			{
				SendFamilyMessage(GangZoneInfo[i][gzNapad], COLOR_ORANGE, "У вас осталось одна минута на подготовку к атаке");
				SendFamilyMessage(GangZoneInfo[i][gzGang], COLOR_ORANGE, "У вас осталось одна минута на подготовку к защите");
			}
			else if(SafeTime[i] == 120)
			{
				SendFamilyMessage(GangZoneInfo[i][gzNapad], COLOR_ORANGE, "У вас осталось две минуты на подготовку к атаке");
				SendFamilyMessage(GangZoneInfo[i][gzGang], COLOR_ORANGE, "У вас осталось две минуты на подготовку к защите");
			}
			else if(SafeTime[i] == 180)
			{
				SendFamilyMessage(GangZoneInfo[i][gzNapad], COLOR_ORANGE, "У вас осталось три минуты на подготовку к атаке");
				SendFamilyMessage(GangZoneInfo[i][gzGang], COLOR_ORANGE, "У вас осталось три минуты на подготовку к защите");
			}
			else if(SafeTime[i] == 240)
			{
				SendFamilyMessage(GangZoneInfo[i][gzNapad], COLOR_ORANGE, "У вас осталось четыре минуты на подготовку к атаке");
				SendFamilyMessage(GangZoneInfo[i][gzGang], COLOR_ORANGE, "У вас осталось четыре минуты на подготовку к защите");
			}
			else if(SafeTime[i] == 0)
			{
				SendFamilyMessage(GangZoneInfo[i][gzNapad], COLOR_ORANGE, "Время на подготовку к атаке вышло");
				SendFamilyMessage(GangZoneInfo[i][gzNapad], COLOR_ORANGE, "Если у противника нет ни одного солдата на поле боя, то территория автоматически переходит к вам");
				SendFamilyMessage(GangZoneInfo[i][gzGang], COLOR_ORANGE, "Время на подготовку к защите вышло");
				SendFamilyMessage(GangZoneInfo[i][gzGang], COLOR_ORANGE, "Если у вас нет ни одного солдата на поле боя, то территория автоматически переходит к противнику");
			}
		}
	}
	for(new i=0; i<sizeof(GangSide); i++)
	{
		if(GangSide[i] > 0)
		{
			GangSide[i] -= 1;
			if(GangSide[i] == 0) SendFamilyMessage(i, COLOR_ORANGE, "Вы снова можете учавствовать в захвате территорий");
		}
	}
	if(KartingPlayers >= 2 && !KartingStarted && !KartingPrepare)
	{
		KartingPrepare = true;
		SetTimer("PrepareKarting", 10000, false);
	}
	if(!KartingPrepare && KartingStarted && KartingPlayers < 2)
	{
		KartingStarted = false;
		KartingPlayers = 0;
	}
	if(AdvertiseWaitChat > 0) AdvertiseWaitChat -= 1;
	for(new i=0; i<GetMaxPlayers(); i++)
	{
		if(IsPlayerConnected(i))
		{
			if(seconds == 5 || seconds == 10 || seconds == 15 || seconds == 20 || seconds == 25 || seconds ==30
					|| seconds == 35 || seconds == 40 || seconds == 45 || seconds == 50 || seconds == 55 || seconds == 0)
			{
				OldDeath[i] = 0;
			}
			if(GetPlayerMoney(i) != PlayerInfo[i][pMoney])
			{
				ResetPlayerMoney(i);
				GivePlayerMoney(i, PlayerInfo[i][pMoney]);
			}
			if(PlayerInfo[i][pJailTime] > 0 && PlayerInfo[i][pJailTime] != 300 && !PlayerToPoint(i, 10.0, 1608.2272,-1630.4746,2583.8660))
			{
				SetPlayerPos(i, 1608.2272,-1630.4746,2583.8660);
				SetPlayerInterior(i, 1);
				SetPlayerVirtualWorld(i, POLC_MIR);
				SetCameraBehindPlayer(i);
			}
			if(PlayerConvoi[i]) OnPlayerInConvoi(i);
			PlayerGetCrashed(i);
			UpdatePlayerAnticheat(i);
			f(string, "%s%d:%s%d:%s%d", (hours < 10) ? ("0") : (""), hours, (minutes < 10) ? ("0") : (""), minutes, (seconds < 10) ? ("0") : (""), seconds);
			if(!PlayerStarting[i]) return true;
			if(PlayerFreezTime[i] > 0)
			{
				TogglePlayerControllable(i, false);
				PlayerFreezTime[i] -= 1;
				if(PlayerFreezTime[i] < 1) TogglePlayerControllable(i, true);
			}
			if(PlayerOnElectro[i] > 0)
			{
				TogglePlayerControllable(i, false);
				PlayerOnElectro[i] -= 1;
				if(PlayerOnElectro[i] < 1)
				{
					DeleteAnimation(i);
					TogglePlayerControllable(i, true);
				}
			}
			if((PlayerCuffed[i] && !PlayerConvoi[i]) || PlayerTied[i]) TogglePlayerControllable(i, false);
			if(PlayerWhaitCommand[i] > 0) PlayerWhaitCommand[i] -= 1;
			if(RobHouseTime[i] > 0) RobHouseTime[i] -= 1;
			if(PlayerInfo[i][pMuteTime] > 0) PlayerInfo[i][pMuteTime] -= 1;
			if(PlayerWaitChat[i] > 0) PlayerWaitChat[i] -= 1;
   if(PlayerWaitReport[i] > 0) PlayerWaitReport[i] -= 1;
			if(PlayerUseElectro[i] > 0) PlayerUseElectro[i] -= 1;
			if(PlayerRubbish[i] > 0) PlayerRubbish[i] -= 1;
			if(seconds == 0)
			{
				if(PlayerDrugEffect[i] != 0) UpdatePlayerDrugEffect(i, true);
				GetPlayerHealth(i, health);
				if(PlayerNeedDrugs[i] != 0) SetPlayerHealthEx(i, health-5);
				else SetPlayerHealthEx(i, health-1);
				if(StatusInfo[i][sVar] < 300) PlayerInfo[i][pPayTime] += 1;
				if(RealTime && !PlayerInInterior[i]) SetPlayerTime(i, hours, minutes);
				if(PlayerCheater[i]) PlayerCheater[i] = false;
			}
			if(seconds == 0 || seconds == 10 || seconds == 20 || seconds == 30 || seconds == 40 || seconds == 50)
			{
				if(PlayerCalled[i])
				{
					PlayerInfo[i][pPhBalance] -= 1;
					BusinessInfo[PHONE_BIZZ][bBalance] += 1;
					BusinessInfo[PHONE_BIZZ][bFunds] -= 1;
				}
			}
			if(PlayerInfo[i][pDepend] != 0)
			{
				if((minutes == 0  && seconds == 0)
						|| (minutes == 20 && seconds == 0)
						|| (minutes == 40 && seconds == 0))
				{
					switch(PlayerInfo[i][pDepend])
					{
					case 30..60: PlayerNeedDrugs[i] += 1;
					case 61..80: PlayerNeedDrugs[i] += 2;
					case 91..120: PlayerNeedDrugs[i] += 3;
					case 121..150: PlayerNeedDrugs[i] += 4;
					case 151..999: PlayerNeedDrugs[i] += 5;
					}
					if(PlayerInfo[i][pDepend] >= 30) SendClientMessage(i, COLOR_ORANGE, "Тебе нужна доза наркотиков, иначе твоё здоровье будет ухудшаться");
				}
			}
			if(StatusInfo[i][sChek] < StatusInfo[i][sTick])
			{
				if(StatusInfo[i][sAfk] == 1)
				{
					StatusInfo[i][sVar] = 0;
					StatusInfo[i][sAfk] = 0;
				}
			}
			if(KartingPrepare && PlayerKarting[i] && PlayerInKart[i] && KartingMessage[i])
			{
				SendClientMessage(i, COLOR_PINK, "Гонку на картингах объявят через 10 секунд");
				KartingMessage[i] = false;
			}
			if(StatusInfo[i][sAfk] == 1) StatusInfo[i][sVar] += 1;
			if(StatusInfo[i][sVar] > 0)
			{
				f(string, "AFK: %s", ConvertTime(StatusInfo[i][sVar]));
				SetPlayerChatBubble(i, string, 0xFFFFFF00, 30.0, 1200);
			}
			if(StatusInfo[i][sVar] == 30 && PlayerInBattleZone(i))
			{
				SendClientMessage(i, COLOR_RED, "Ты был кикнут за AFK во время сражения за территорию");
				Kick(i);
			}
		}
	}
	return true;
}

//==============================================================================
// НОВЫЕ СТОКИ
//==============================================================================

stock CheckGangZones()
{
	new string[128];
	for(new i=0; i<MAX_GANGZONE; i++)
	{
		if(ZoneOnBattle[i] && SafeTime[i] == 0)
		{
			new napadenie = GangZoneInfo[i][gzNapad];
			new oborona = GangZoneInfo[i][gzGang];
			ZoneTimer[i] -= 1;
			if(ZoneTimer[i] == 0)
			{
				SendFamilyMessage(napadenie, COLOR_ORANGE, "Время на захват территории вышло. Ничья");
				SendFamilyMessage(oborona, COLOR_ORANGE, "Время на оборону территории вышло. Ничья");
				ZoneOnBattle[i] = false;
				GangNapadenie[napadenie] = false;
				GangZoneStopFlashForAll(GangZoneInfo[i][gzZone]);
			}
			else
			{
				GangOnZone[i][oborona] = false;
				for(new x=0; x<GetMaxPlayers(); x++)
				{
					if(IsPlayerConnected(x))
					{
						if(PlayerInfo[x][pMember] == oborona && PlayerInBox(x, GangZoneInfo[i][gzPos][0], GangZoneInfo[i][gzPos][1], GangZoneInfo[i][gzPos][2], GangZoneInfo[i][gzPos][3])) GangOnZone[i][oborona] = true;
					}
				}
				GangOnZone[i][napadenie] = false;
				for(new x=0; x<GetMaxPlayers(); x++)
				{
					if(IsPlayerConnected(x))
					{
						if(PlayerInfo[x][pMember] == napadenie && PlayerInBox(x, GangZoneInfo[i][gzPos][0], GangZoneInfo[i][gzPos][1], GangZoneInfo[i][gzPos][2], GangZoneInfo[i][gzPos][3])) GangOnZone[i][napadenie] = true;
					}
				}
				if(!GangOnZone[i][oborona] && GangOnZone[i][napadenie])
				{
					f(string, "Вы завоевали территорию банды {EDCA6B}%s", GetOrganizationName(oborona));
					SendFamilyMessage(napadenie, COLOR_ORANGE, string);
					f(string, "Банда {EDCA6B}%s{FFBB00} завоёвывает вашу территорию.", GetOrganizationName(napadenie));
					SendFamilyMessage(oborona, COLOR_ORANGE, string);
					ZoneOnBattle[i] = false;
					GangNapadenie[napadenie] = false;
					GangZoneInfo[i][gzGang] = napadenie;
					GangZoneInfo[i][gzNapad] = 0;
					GangInfo[napadenie][gEsteem] += 2;
					if(GangInfo[napadenie][gEsteem] > 100) GangInfo[napadenie][gEsteem] = 100;
					if(GangInfo[oborona][gEsteem] > 0) GangInfo[oborona][gEsteem] -= 1;
					GangZoneStopFlashForAll(GangZoneInfo[i][gzZone]);
					GangZoneHideForAll(GangZoneInfo[i][gzZone]);
					GangZoneShowForAll(GangZoneInfo[i][gzZone], GetGangZoneColor(i));
					return true;
				}
				if(!GangOnZone[i][napadenie] && GangOnZone[i][oborona])
				{
					f(string, "Вы не смогли завоевать территорию банды {EDCA6B}%s", GetOrganizationName(oborona));
					SendFamilyMessage(napadenie, COLOR_ORANGE, string);
					f(string, "Вы отстояли свою территорию в борьбе с бандой {EDCA6B}%s", GetOrganizationName(napadenie));
					SendFamilyMessage(oborona, COLOR_ORANGE, string);
					ZoneOnBattle[i] = false;
					GangNapadenie[napadenie] = false;
					GangZoneInfo[i][gzNapad] = 0;
					if(GangInfo[napadenie][gEsteem] > 0) GangInfo[napadenie][gEsteem] -= 1;
					if(GangInfo[oborona][gEsteem] < 100) GangInfo[oborona][gEsteem] += 1;
					GangZoneStopFlashForAll(GangZoneInfo[i][gzZone]);
					GangZoneHideForAll(GangZoneInfo[i][gzZone]);
					GangZoneShowForAll(GangZoneInfo[i][gzZone], GetGangZoneColor(i));
					return true;
				}
			}
		}
	}
	return true;
}

stock GetOrganizationName(orgid)
{
	new frak_text[64];
	switch(orgid)
	{
	case 0: frak_text = "Не имеется";
	case REPORTER_ORG: frak_text = "Fort Carson News";
	case ARMY_ORG: frak_text = "Пограничники";
	case MEDIC_ORG: frak_text = "Больница Fort Carson";
	case ADVOKAT_ORG: frak_text = "Пожарная часть";
	case MERIA_ORG: frak_text = "Сельсовет";
	case HITMAN_ORG: frak_text = "Хитманы";
	case TRANSPORT_ORG: frak_text = "Министрество ТС";
	case PATRUL_ORG: frak_text = "Полиция Fort Carson";
	case VAGOS_GANG: frak_text = "Скинхеды";
	case GROOVE_GANG: frak_text = "Гопники";
	case RIFA_GANG: frak_text = "The Rifa Gang";
	case BALLAS_GANG: frak_text = "Фермеры.";
	case AZTECAS_GANG: frak_text = "Вагос";
	case NOSTRA_MAFIA: frak_text = "Байкеры";
	case YAKUZA_MAFIA: frak_text = "Asia Boyz";
	case RUSSIAN_MAFIA: frak_text = "Нет временно";
	}
	return frak_text;
}

stock GetLeaderStatus(string[])
{
	new status[64],nick[MAX_PLAYER_NAME],bool:stat;
	f(nick, "%s", string);
	for(new i=0; i<GetMaxPlayers(); i++)
	{
		if(IsPlayerConnected(i))
		{
			if(!strcmp(PlayerName[i], nick, true))
			{
				stat = true;
				settext(status, "{AFE01B}online");
				break;
			}
		}
	}
	if(!stat) settext(status, "{DE353E}offline");
	return status;
}

stock GiveWeapon(player,weapid,ammo)
{
	Weapons[player][weapid]= 1;
	GivePlayerWeapon(player,weapid,ammo);
	return ;
}

stock SetPlayerCuffed(playerid, bool:type)
{
	if(type)
	{
		SetPlayerAttachedObject(playerid, ATT_CUFF, 19418, 6, -0.011, 0.028, -0.022, -15.600, -33.699, -81.700, 0.891, 1.000, 1.168);
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CUFFED);
	}
	else
	{
		RemovePlayerAttachedObject(playerid, ATT_CUFF);
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	}
	return true;
}

stock LoopingAnimation(playerid, animlib[], animname[], bool:looping = true)
{
	DeleteAnimation(playerid);
	ApplyAnimation(playerid, animlib, animname, 4.0, 1, 0, 0, 0, 0, 1);
	if(looping)
	{
		TextDrawShowForPlayer(playerid, StopAnimation);
		PlayerLoopingAnim[playerid] = true;
	}
	return true;
}

stock SeccureAnimation(playerid, animlib[], animname[])
{
	DeleteAnimation(playerid);
	ApplyAnimation(playerid, animlib, animname, 4.0, 0, 0, 0, 0, 0, 1);
	return true;
}

stock ToggleAnimation(playerid, animlib[], animname[], bool:looping = false)
{
	DeleteAnimation(playerid);
	if(!strcmp(animlib, "CARRY", true) && !strcmp(animname, "crry_prtial", true))
	{
		ApplyAnimation(playerid, animlib, animname, 4.0, 1, 0, 0, 1, 1, 1);
		ApplyAnimation(playerid, animlib, animname, 4.0, 1, 0, 0, 1, 1, 1);
	}
	else
	{
		ApplyAnimation(playerid, animlib, animname, 4.0, 0, 0, 0, 1, 1, 1);
	}
	if(looping)
	{
		TextDrawShowForPlayer(playerid, StopAnimation);
		PlayerLoopingAnim[playerid] = true;
	}
	return true;
}

stock DeleteAnimation(playerid)
{
	PlayerLoopingAnim[playerid] = false;
	SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 0, 0);
	ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 0, 0);
	TogglePlayerControllable(playerid, false);
	TogglePlayerControllable(playerid, true);
	ClearAnimations(playerid);
	return true;
}

stock ReloadAnimation(playerid, animlib[])
{
	ApplyAnimation(playerid, animlib, "null", 0.0, 0, 0, 0, 0, 0, 0);
	return true;
}

stock log(filename[], stringname[])
{
	new hours,minutes,seconds,year,month,day;
	new file[64],string[256];
	gettime(hours, minutes, seconds);
	getdate(year, month, day);
	f(file, "logs/%s.log", filename);
	if(fexist(file))
	{
		new File:hFile = fopen(file, io_append);
		f(string, "[%s%d/%s%d/%d][%s%d:%s%d:%s%d][ %s ]\r\n", (day < 10) ? ("0") : (""), day, (month < 10) ? ("0") : (""), month, year, (hours < 10) ? ("0") : (""), hours, (minutes < 10) ? ("0") : (""), minutes, (seconds < 10) ? ("0") : (""), seconds, stringname);
		for(new i=0; i<strlen(string); i++) fputchar(hFile, string[i], false);
		fclose(hFile);
	}
	return true;
}
stock DeletePlayerStrip(playerid)
{
	new i = GetPlayerStrip[playerid];
	SpikesInfo[i][ssCreated] = 0;
	SpikesInfo[i][ssPos][0] = 0.0;
	SpikesInfo[i][ssPos][1] = 0.0;
	SpikesInfo[i][ssPos][2] = 0.0;
	DestroyObject(SpikesInfo[i][ssObject]);
	GetPlayerStrip[playerid] = -1;
	return true;
}

stock PlayerInBattleZone(playerid)
{
	for(new i=0; i<MAX_GANGZONE; i++)
	{
		if(PlayerInBox(playerid, GangZoneInfo[i][gzPos][0], GangZoneInfo[i][gzPos][1], GangZoneInfo[i][gzPos][2], GangZoneInfo[i][gzPos][3]) && GangZoneInfo[i][gzGang] == PlayerInfo[playerid][pMember] && ZoneOnBattle[i]) return true;
	}
	return false;
}

stock GetOrganizationType(orgid)
{
	if(orgid >= 10 && orgid < 18) return true;
	else if(orgid >= 20 && orgid < 25) return 2;
	else if(orgid >= 30 && orgid < 33) return 3;
	return false;
}

stock GivePlayerSavedWeapons(playerid)
{
	RemovePlayerAllWeaponEx(playerid);
	for(new i=0; i<13; i++) GivePlayerWeaponEx(playerid, PlayerInfo[playerid][pGuns][i], PlayerInfo[playerid][pAmmo][i]);
	return true;
}

stock SetPlayerCheckpointEx(playerid, Float:x, Float:y, Float:z, type)
{
	if(type == CHECKPOINT_PLAYER) SetPlayerRaceCheckpoint(playerid, 2, Float:x, Float:y, Float:z, Float:x, Float:y, Float:z, 2.0);
	else if(type == CHECKPOINT_VEHICLE) SetPlayerRaceCheckpoint(playerid, 2, Float:x, Float:y, Float:z, Float:x, Float:y, Float:z, 5.0);
	return true;
}

stock SetPlayerAngleToPlayer(playerid, targetid)
{
	new Float:POS[2][3];
	GetPlayerPos(targetid, POS[0][0], POS[0][1], POS[0][2]);
	GetPlayerPos(playerid, POS[1][0], POS[1][1], POS[1][2]);
	new Float:ANGLE = 180-atan2(POS[1][0]-POS[0][0], POS[1][1]-POS[0][1]);
	SetPlayerFacingAngle(playerid, ANGLE);
	return true;
}

stock GetPlayerAllWeapons(playerid)
{
	for(new i=0; i<13; i++)
	{
		GetPlayerWeaponData(playerid, i, PlayerInfo[playerid][pGuns][i], PlayerInfo[playerid][pAmmo][i]);
		if(i == 1 && PlayerInfo[playerid][pGuns][i] == 9) PlayerInfo[playerid][pGuns][i] = 0;
	}
	return true;
}

stock OnPlayerInConvoi(playerid)
{
	new convedid = GetPlayerConvoi[playerid];
	if(!IsPlayerConnected(convedid))
	{
		GetPlayerConvoi[playerid] = INVALID_PLAYER_ID;
		SendClientMessage(playerid, COLOR_AQUA, "Ты свободен, так как твой конвоир покинул сервер");
		PlayerConvoi[playerid] = false;
		PlayerCuffed[playerid] = false;
		TogglePlayerControllable(playerid, true);
		DeleteAnimation(playerid);
		return true;
	}
	if(!IsPlayerConnected(playerid)) return SendClientMessage(convedid, COLOR_AQUA, "Арестованный покинул сервер");
	if(!PlayerCuffed[playerid])
	{
		GetPlayerConvoi[playerid] = INVALID_PLAYER_ID;
		SendClientMessage(convedid, COLOR_AQUA, "На арестованном не обнаружены наручники. Конвой прекращён");
		PlayerConvoi[playerid] = false;
		TogglePlayerControllable(playerid, true);
		DeleteAnimation(playerid);
		return true;
	}
	if(IsPlayerInAnyVehicle(playerid))
	{
		GetPlayerConvoi[playerid] = INVALID_PLAYER_ID;
		SendClientMessage(convedid, COLOR_AQUA, "Арестованный находится в машине. Конвой прекращён");
		PlayerConvoi[playerid] = false;
		TogglePlayerControllable(playerid, true);
		DeleteAnimation(playerid);
		return true;
	}
	new bool:current;
	if(GetPlayerVirtualWorld(convedid) != GetPlayerVirtualWorld(playerid)
			|| GetPlayerInterior(convedid) != GetPlayerInterior(playerid))
	{
		new Float:POS[3];
		GetPlayerPos(convedid, POS[0], POS[1], POS[2]);
		SetPlayerPos(playerid, POS[0], POS[1], POS[2]);
		SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(convedid));
		SetPlayerInterior(playerid, GetPlayerInterior(convedid));
		current = true;
	}
	if(GetDistancePlayers(playerid, convedid) < 0.9)
	{
		SetPlayerAngleToPlayer(playerid, convedid);
		TogglePlayerControllable(playerid, false);
	}
	else if(GetDistancePlayers(playerid, convedid) > 10.0)
	{
		if(!current)
		{
			GetPlayerConvoi[playerid] = INVALID_PLAYER_ID;
			SendClientMessage(convedid, COLOR_AQUA, "Ты ушёл слишком далеко. Конвой закончен");
			SendClientMessage(playerid, COLOR_AQUA, "Твой конвоир ушёл слишком далеко. Конвой закончен");
			//SetPlayerCuffed(playerid, true);
			PlayerConvoi[playerid] = false;
			TogglePlayerControllable(playerid, true);
			DeleteAnimation(playerid);
		}
		else
		{
			current = false;
		}
	}
	else
	{
		TogglePlayerControllable(playerid, true);
		SetPlayerAngleToPlayer(playerid, convedid);
		ApplyAnimation(playerid, "ped", "WALK_civi", 6.0, 1, 1, 1, 1, 0, 1);
	}
	return true;
}

stock PlayerUsePhone(playerid, bool:type)
{
	if(type)
	{
		SetPlayerAttachedObject(playerid, ATT_PHONE, PlayerInfo[playerid][pPhStyle], 6, 0.105, 0.005, -0.012, 93.350, 181.872, 7.479, 1.0, 1.0, 1.0);
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_USECELLPHONE);
	}
	else
	{
		SetTimerEx("RemovePlayerPhone", 1500, false, "i", playerid);
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_STOPUSECELLPHONE);
	}
	return true;
}

stock GetClosestPlayer(playerid)
{
	new player = INVALID_PLAYER_ID,Float:distance,Float:getdis = 99999.99;
	for(new i=0; i<GetMaxPlayers(); i++)
	{
		if(IsPlayerConnected(i))
		{
			if(i != playerid)
			{
				distance = GetDistancePlayers(i, playerid);
				if(distance < getdis)
				{
					getdis = distance;
					player = i;
				}
			}
		}
	}
	return player;
}

stock GetBanPlayer(playerid)
{
	new string[256];
	f(string, "banlist/%s.ini", PlayerName[playerid]);
	if(fexist(string))
	{
		new bantime, unbantime, banned[MAX_PLAYER_NAME], reason[128];
		new OpenBan = ini_openFile(string);
		ini_getInteger(OpenBan, "BAN_TIME", bantime);
		ini_getInteger(OpenBan, "UN_BAN_TIME", unbantime);
		ini_getString(OpenBan, "GET_BANNED", banned);
		ini_getString(OpenBan, "REASON", reason);
		ini_closeFile(OpenBan);
		if(gettime() >= unbantime) return fremove(string);
		f(string, "\
{FFFF00}Дата бана: {FFFFFF}%s\n\
{FFFF00}Дата разбана: {FFFFFF}%s\n\
{FFFF00}Кто забанил: {FFFFFF}%s\n\
{FFFF00}Причина бана: {FFFFFF}%s",
		date("%dd.%mm.%yyyy в %hh:%ii:%ss", bantime),
		date("%dd.%mm.%yyyy в %hh:%ii:%ss", unbantime),
		banned, reason);
		ShowDialog(playerid, 00000, DIALOG_STYLE_MSGBOX, "Информация о бане", string, "Закрыть", "");
		Kick(playerid);
	}
	return true;
}

stock GetHouseZone(houseid)
{
	new zone[32],bool:getzone;
	for(new i=0; i<sizeof(gZoneInfo); i++)
	{
		if(HouseInfo[houseid][hEnterX] >= gZoneInfo[i][SAZONE_AREA][0] && HouseInfo[houseid][hEnterX] <= gZoneInfo[i][SAZONE_AREA][3]
				&& HouseInfo[houseid][hEnterY] >= gZoneInfo[i][SAZONE_AREA][1] && HouseInfo[houseid][hEnterY] <= gZoneInfo[i][SAZONE_AREA][4])
		{
			settext(zone, gZoneInfo[i][SAZONE_NAME]);
			getzone = true;
			break;
		}
	}
	if(!getzone) zone = "Неизвестно";
	return zone;
}

stock GetPlayerZone(playerid)
{
	new Float:POS[3],zone[32],bool:getzone;
	GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
	for(new i=0; i<sizeof(gZoneInfo); i++)
	{
		if(POS[0] >= gZoneInfo[i][SAZONE_AREA][0] && POS[0] <= gZoneInfo[i][SAZONE_AREA][3] && POS[1] >= gZoneInfo[i][SAZONE_AREA][1] && POS[1] <= gZoneInfo[i][SAZONE_AREA][4])
		{
			settext(zone, gZoneInfo[i][SAZONE_NAME]);
			getzone = true;
			break;
		}
	}
	if(!getzone) zone = "Неизвестно";
	return zone;
}

stock GetCoordBootVehicle(vehicleid, &Float:x, &Float:y, &Float:z)
{
	new Float:angle,Float:distance;
	GetVehicleModelInfo(GetVehicleModel(vehicleid), 1, x, distance, z);
	distance = distance/2 + 0.1;
	GetVehiclePos(vehicleid, x, y, z);
	GetVehicleZAngle(vehicleid, angle);
	x += (distance * floatsin(-angle+180, degrees));
	y += (distance * floatcos(-angle+180, degrees));
	return true;
}

