stock split(const strsrc[], strdest[][], delimiter)
{
	new idx,li,num,len;
	while(idx <= strlen(strsrc))
	{
		if(strsrc[idx] == delimiter || idx == strlen(strsrc))
		{
			len = strmid(strdest[num], strsrc, li, idx, 128);
			strdest[num][len] = 0;
			li = idx+1;
			num += 1;
		}
		idx += 1;
	}
	return true;
}

stock OnPlayerSelectedEat(playerid, price, bool:mode = false) //
{
	if(PlayerInfo[playerid][pSitosti] > 80 ) return SendClientMessage(playerid, COLOR_GREEN, "Вы не хотите есть!");
	if(GetPlayerMoneyEx(playerid) < price)
	{
		new string[128];
		f(string, "У тебя не достаточно денег. Нужно{5BD93B} %d$", price);
		SendClientMessage(playerid, COLOR_GREEN, string);
		return true;
	}
	GivePlayerMoneyEx(playerid, -price);        //PlayerInfo[playerid],Sitosti+healthgain);
	PlayerInfo[playerid][pSitosti] += 20;
	SetProgressBarValue(playerid, sitosti[playerid], PlayerInfo[playerid][pSitosti]);
    UpdateProgressBar(sitosti[playerid], playerid);

	if(mode)
	{
		BusinessInfo[RUSTY_BIZZ][bBalance] += price;
		BusinessInfo[RUSTY_BIZZ][bFunds] -= 1;
	}
	else
	{
		BusinessInfo[EATERY_BIZZ][bBalance] += price;
		BusinessInfo[EATERY_BIZZ][bFunds] -= 1;
	}
	return true;
}

stock PlayerGetCrashed(playerid)
{
	if(GetPlayerSurfingVehicleID(playerid) == INVALID_VEHICLE_ID) return true;
	if(IsBoat(GetPlayerSurfingVehicleID(playerid))) return true;
	if(GetPlayerSpeed(playerid) < 60) return true;
	new Float:POS[3],Float:health;
	GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
	SetPlayerPos(playerid, POS[0], POS[1], POS[2]+0.5);
	SeccureAnimation(playerid, "ped", "BIKE_fallR");
	GetPlayerHealth(playerid, health);
	SetPlayerHealthEx(playerid, health-5.0);
	SetTimerEx("PlayerCrashedItCar", 1100, false, "i", playerid);
	return true;
}

stock RemovePlayerWeapon(playerid, weaponid)
{
	new pGUNS[13],pAMMO[13],settings[2];
	for(new s=0; s<13; s++)
	{
		GetPlayerWeaponData(playerid, s, settings[0], settings[1]);
		if(settings[0] != weaponid && settings[1] != 0) GetPlayerWeaponData(playerid, s, pGUNS[s], pAMMO[s]);
	}
	RemovePlayerAllWeaponEx(playerid);
	for(new s=0; s<13; s++) if(pGUNS[s] != 0) GivePlayerWeaponEx(playerid, pGUNS[s], pAMMO[s]);
	return true;
}

stock GetBaddingText(string[])
{
	if(strfind(string, "!", true) != -1
			|| strfind(string, "\"", true) != -1
			|| strfind(string, "№", true) != -1
			|| strfind(string, ";", true) != -1
			|| strfind(string, "%", true) != -1
			|| strfind(string, ":", true) != -1
			|| strfind(string, "?", true) != -1
			|| strfind(string, "*", true) != -1
			|| strfind(string, "(", true) != -1
			|| strfind(string, ")", true) != -1
			|| strfind(string, "-", true) != -1
			|| strfind(string, "@", true) != -1
			|| strfind(string, "#", true) != -1
			|| strfind(string, "$", true) != -1
			|| strfind(string, "^", true) != -1
			|| strfind(string, "&", true) != -1
			|| strfind(string, "=", true) != -1
			|| strfind(string, "+", true) != -1
			|| strfind(string, "'", true) != -1
			|| strfind(string, "`", true) != -1
			|| strfind(string, "~", true) != -1) return true;
	return false;
}

stock GetTextAdvertising(string[])
{
	if(strfind(string, ".ua", true) != -1
			|| strfind(string, ". ua", true) != -1
			|| strfind(string, ".ru", true) != -1
			|| strfind(string, ". ru", true) != -1
			|| strfind(string, ".net", true) != -1
			|| strfind(string, ". net", true) != -1
			|| strfind(string, ".com", true) != -1
			|| strfind(string, ". com", true) != -1
			|| strfind(string, ".kz", true) != -1
			|| strfind(string, ". kz", true) != -1
			|| strfind(string, ".biz", true) != -1
			|| strfind(string, ". biz", true) != -1
			|| strfind(string, ".рф", true) != -1
			|| strfind(string, ". рф", true) != -1
			|| strfind(string, ".su", true) != -1
			|| strfind(string, ". su", true) != -1
			|| strfind(string, "www.", true) != -1
			|| strfind(string, "www .", true) != -1) return true;
	new is1 = 0,r = 0;
	while(strlen(string[is1]))
	{
		if('0' <= string[is1] <= '9')
		{
			new is2 = is1+1, p=0;
			while(p == 0)
			{
				if('0' <= string[is2] <= '9' && strlen(string[is2])) is2 += 1;
				else
				{
					strmid(AdvertisingString[r], string, is1, is2, 255);
					if(strval(AdvertisingString[r]) < 255) r += 1;
					is1 = is2;
					p = 1;
				}
			}
		}
		is1 += 1;
	}
	if(r >= 4) return true;
	return false;
}

stock GetBadSizeText(string[])
{
	new len;
	for(new i=0; i<strlen(string); i++)
	{
		switch(string[i])
		{
		case ' ', '\t', '\r', '\n': len += 1;
		}
	}
	if(len == strlen(string)) return true;
	return false;
}

stock SpaceGroupsToSpaces(string[])
{
	new b, len = strlen(string);
	for(; b<len; b++)
	{
		switch(string[b])
		{
		case ' ', '\t', '\r', '\n': continue;
		default:
			{
				if(b != 0)
				{
					strmid(string, string, b, len, len);
				}
				break;
			}
		}
	}
	for(b=len-b-1; b>=0; b--)
	{
		switch(string[b])
		{
		case ' ', '\t', '\r', '\n': continue;
		default:
			{
				string[b+1] = 0;
				break;
			}
		}
	}
	new lenx = strlen(string), c = len - 1, spaces;
	for(; c>=0; c--)
	{
		switch(string[c])
		{
		case ' ', '\t', '\r', '\n': spaces += 1;
		default:
			{
				if(spaces > 1)
				{
					memcpy(string, string[c+spaces+1], (c+2) *4, (lenx - c - spaces - 1) *4, lenx);
					len -= spaces - 1;
				}

				if(spaces > 0)
				{
					string[c+1] = ' ';
					spaces =  0;
				}
			}
		}
	}
	if(spaces > 1)
	{
		memcpy(string, string[c+spaces+1], (c+2) *4, (lenx - c - spaces - 1) *4, lenx);
		len -= spaces - 1;
	}
	if(spaces > 0) string[c+1] = ' ';
	string[len] = 0;
}

stock IncorrectCmdAttempt(string[])
{
	switch(string[0])
	{
	case '.', '?':
		{
			switch(string[1])
			{
			case 65..90,97..122,192..255: return true;
			}
		}
	}
	return false;
}

stock ConvertTime(number)
{
	new hours = 0, mins = 0, secs = 0, string[128];
	hours = floatround(number/3600);
	mins = floatround((number/60) - (hours * 60));
	secs = floatround(number - ((hours * 3600)+(mins * 60)));
	if(hours > 0) f(string, "%d:%02d:%02d", hours, mins, secs);
	else f(string, "%d:%02d", mins, secs);
	return string;
}

stock GetGangZoneColor(gangzone)
{
	switch(GangZoneInfo[gangzone][gzGang])
	{
	case GROOVE_GANG: 	return 0x00FF1465;
	case BALLAS_GANG: 	return 0xFF00EB65;
	case VAGOS_GANG: 	return 0xFFD90065;
	case RIFA_GANG: 	return 0x1900FF65;
	case AZTECAS_GANG: 	return 0x57F2FF65;
	}
	return false;
}

stock GetGangZoneColorEx(getgang)
{
	switch(getgang)
	{
	case GROOVE_GANG: 	return 0x00FF1465;
	case BALLAS_GANG: 	return 0xFF00EB65;
	case VAGOS_GANG: 	return 0xFFD90065;
	case RIFA_GANG: 	return 0x1900FF65;
	case AZTECAS_GANG: 	return 0x57F2FF65;
	}
	return false;
}

stock IsPlayerGangOnline(gangid)
{
	for(new i=0; i<GetMaxPlayers(); i++) if(IsPlayerConnected(i) && PlayerInfo[i][pMember] == gangid && PlayerInfo[i][pJailTime] == 0) return true;
	return false;
}

stock GetVehicleComponents(vehicleid)
{
	for(new i=0; i<14; i++) if(GetVehicleComponentInSlot(vehicleid, i) != 0) return true;
	if(TuningInfo[vehicleid][14] != 0) return true;
	return false;
}

stock GetPlayerDrunkChat(playerid)
{
	new drunk = 100,getdrunk = GetPlayerDrunkLevel(playerid);
	if(getdrunk >= 1000 && getdrunk <= 5000) drunk = random(100);
	else if(getdrunk > 5000 && getdrunk <= 10000) drunk = random(90);
	else if(getdrunk > 10000 && getdrunk <= 15000) drunk = random(80);
	else if(getdrunk > 15000 && getdrunk <= 20000) drunk = random(70);
	else if(getdrunk > 20000 && getdrunk <= 25000) drunk = random(60);
	else if(getdrunk > 25000 && getdrunk <= 30000) drunk = random(50);
	else if(getdrunk > 30000 && getdrunk <= 35000) drunk = random(40);
	else if(getdrunk > 35000 && getdrunk <= 40000) drunk = random(30);
	else if(getdrunk > 40000 && getdrunk <= 45000) drunk = random(20);
	return drunk;
}

stock LoadFraction()
{
	new string[32],GetFile,file[10][128],z;
 	for(new i=0; i<MAX_ORGANS; i++)
