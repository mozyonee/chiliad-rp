			GetPlayerTransfer[giveplayerid] = playerid;
			GetPlayerOption[giveplayerid] = price;
			f(string, "Ты предложил игроку {9DDAF2}%s{FFFFFF} воостановить своё здоровие за {9DDAF2}%d$", PlayerNameEx[giveplayerid], price);
