		if(response)
		{
			PlayerInfo[playerid][pMember] = PlayerInfo[frakid][pMember];
			PlayerInfo[playerid][pLeader] = 0;
			PlayerInfo[playerid][pZam] = 0;
			PlayerInfo[playerid][pRank] = 1;
