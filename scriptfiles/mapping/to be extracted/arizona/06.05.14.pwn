	else if(dialogid == ORGAN_ID+90)
	{
		if(response)
		{
			ShowPlayerLeaderDialog(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(dialogid == DUEL_ID)
	{
		new dueledid = GetPlayerTransfer[playerid];
		if(response)
		{
			if(PlayerInfo[playerid][pJailTime] > 0)
			{
				SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме ты не можешь участвовать в дуэли");
				SendClientMessage(dueledid, COLOR_GREEN, "При соглашении на участие в дуэли произошла ошибка");
				GetPlayerTransfer[playerid] = INVALID_PLAYER_ID;
				GetPlayerOption[playerid] = 0;
				return true;
			}
			if(EnableJobCheckpoint(playerid))
			{
				SendClientMessage(playerid, COLOR_GREEN, "Ты должен сначала закончить работу");
				SendClientMessage(dueledid, COLOR_GREEN, "При соглашении на участие в дуэли произошла ошибка");
				GetPlayerTransfer[playerid] = INVALID_PLAYER_ID;
				GetPlayerOption[playerid] = 0;
				return true;
			}
			if(PlayerInDuel[playerid])
			{
				SendClientMessage(playerid, COLOR_GREEN, "Ты уже участвуешь в дуэли");
				SendClientMessage(dueledid, COLOR_GREEN, "При соглашении на участие в дуэли произошла ошибка");
				GetPlayerTransfer[playerid] = INVALID_PLAYER_ID;
				GetPlayerOption[playerid] = 0;
				return true;
			}
			if(PlayerInfo[dueledid][pJailTime] > 0)
			{
				SendClientMessage(playerid, COLOR_GREEN, "Игрок, отославший тебе приглашение, находится в тюрьме");
				SendClientMessage(dueledid, COLOR_GREEN, "При соглашении на участие в дуэли произошла ошибка");
				GetPlayerTransfer[playerid] = INVALID_PLAYER_ID;
				GetPlayerOption[playerid] = 0;
				return true;
			}
			if(PlayerInDuel[dueledid])
			{
				SendClientMessage(playerid, COLOR_GREEN, "Игрок, отославший тебе приглашение, уже участвует в дуэли");
				SendClientMessage(dueledid, COLOR_GREEN, "При соглашении на участие в дуэли произошла ошибка");
				GetPlayerTransfer[playerid] = INVALID_PLAYER_ID;
				GetPlayerOption[playerid] = 0;
				return true;
			}
			if(IsPlayerConnected(dueledid))
			{
				PlayerInDuel[playerid] = true;
				PlayerInDuel[dueledid] = true;
				GetPlayerDuel[playerid] = dueledid;
				GetPlayerDuel[dueledid] = playerid;
				SetCameraBehindPlayer(playerid);
				SetCameraBehindPlayer(dueledid);
				TogglePlayerControllable(playerid, false);
				TogglePlayerControllable(dueledid, false);
				StartingDuel[playerid] = 6;
				StartingDuel[dueledid] = 6;
				CountDuelTimer[playerid] = SetTimerEx("DuelStarting", 1000, true, "i", playerid);
				CountDuelTimer[dueledid] = SetTimerEx("DuelStarting", 1000, true, "i", dueledid);
				GetPriceOnDuel[playerid] = GetPlayerOption[playerid];
				GetPriceOnDuel[dueledid] = GetPlayerOption[playerid];
				GetPlayerTransfer[playerid] = INVALID_PLAYER_ID;
				GetPlayerOption[playerid] = 0;
			}
			else
			{
				SendClientMessage(playerid, COLOR_GREEN, "Игрок, отославший тебе приглашение, отсоеденился");
				GetPlayerTransfer[playerid] = INVALID_PLAYER_ID;
				GetPlayerOption[playerid] = 0;
			}
		}
		else
		{
			f(string, "Ты отказался на участие в дуэли с игроком {9DDAF2}%s", PlayerNameEx[dueledid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Игрок {9DDAF2}%s{FFFFFF} отказался на участие в дуэли с тобой!", PlayerNameEx[playerid]);
			SendClientMessage(dueledid, COLOR_WHITE, string);
			GetPlayerOption[playerid] = 0;
			GetPlayerTransfer[playerid] = INVALID_PLAYER_ID;
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(dialogid == HELP_ID)
	{
		if(response)
		{
			switch(listitem)
			{
			case 0:
				{
					ShowDialog(playerid, HELP_ID+1, DIALOG_STYLE_LIST, "Команды сервера", "\
[1] Команды для телефона\n\
[2] Команды для работы\n\
[3] Команды для машин\n\
[4] Команды для фракций\n\
[5] Команды для аккаунта\n\
[6] Команды для чата\n\
[7] Команды для анимаций\n\
