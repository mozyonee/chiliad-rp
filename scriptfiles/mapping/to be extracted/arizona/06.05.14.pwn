			SendClientMessage(giverid, COLOR_GRAY, "Чтобы сказать в микрофон используй команду {FFFFFF}/n");
			SendClientMessage(playerid, COLOR_GRAY, "Чтобы сказать в микрофон используй команду {FFFFFF}/n");
