public CheckPlayerKeys(playerid)
{
	new keys, updown, leftright, boost;
	GetPlayerKeys(playerid, keys, updown, leftright);
	if(!PlayerUseMap[playerid]) return true;
	if(updown == KEY_UP)
	{
		if(keys == KEY_WALK)
		{
			if(CameraPos[playerid][2] >= 35.0)
			{
				CameraPos[playerid][2] = CameraPos[playerid][2] - 10.0;
				Altitude[playerid] -= 1;
			}
		}
		else
		{
			if(CameraPos[playerid][2] < 75.0) boost = 2;
			else if(CameraPos[playerid][2] < 150.0) boost = 5;
			else if(CameraPos[playerid][2] < 300.0) boost = 10;
			else if(CameraPos[playerid][2] <= 505.0) boost = 20;
		}
		CameraPos[playerid][0] = CameraPos[playerid][0]+(boost * floatsin(-Degrees[playerid], degrees));
		CameraPos[playerid][1] = CameraPos[playerid][1]+(boost * floatcos(-Degrees[playerid], degrees));
		MovePlayerRadar(playerid);
	}
	else if(updown == KEY_DOWN)
	{
		if(keys == KEY_WALK)
		{
			if(CameraPos[playerid][2] < 500.0)
			{
				CameraPos[playerid][2] = CameraPos[playerid][2]+10.0;
				Altitude[playerid] += 1;
			}
		}
		else
		{
			if(CameraPos[playerid][2] < 75.0) boost = 2;
			else if(CameraPos[playerid][2] < 150.0) boost = 5;
			else if(CameraPos[playerid][2] < 300.0) boost = 10;
			else if(CameraPos[playerid][2] <= 505.0) boost = 20;
		}
		CameraPos[playerid][0] = CameraPos[playerid][0] - (boost * floatsin(-Degrees[playerid], degrees));
		CameraPos[playerid][1] = CameraPos[playerid][1] - (boost * floatcos(-Degrees[playerid], degrees));
		MovePlayerRadar(playerid);
	}
	if(leftright == KEY_LEFT)
	{
		if(keys == KEY_WALK)
		{
			Degrees[playerid] = Degrees[playerid]+5.0;
			if(Degrees[playerid] == 360) Degrees[playerid] = 0;
		}
		else
		{
			if(CameraPos[playerid][2] < 75.0) boost = 2;
			else if(CameraPos[playerid][2] < 150.0) boost = 5;
			else if(CameraPos[playerid][2] < 300.0) boost = 10;
			else if(CameraPos[playerid][2] <= 505.0) boost = 20;
		}
		CameraPos[playerid][0] = CameraPos[playerid][0]+(boost * floatsin(-Degrees[playerid] - 90.0, degrees));
		CameraPos[playerid][1] = CameraPos[playerid][1]+(boost * floatcos(-Degrees[playerid] - 90.0, degrees));
		MovePlayerRadar(playerid);
	}
	else if(leftright == KEY_RIGHT)
	{
		if(keys == KEY_WALK)
		{
			Degrees[playerid] = Degrees[playerid] - 5.0;
			if(Degrees[playerid] < 0) Degrees[playerid] = 355;
		}
		else
		{
			if(CameraPos[playerid][2] < 75.0) boost = 2;
			else if(CameraPos[playerid][2] < 150.0) boost = 5;
			else if(CameraPos[playerid][2] < 300.0) boost = 10;
			else if(CameraPos[playerid][2] <= 505.0) boost = 20;
		}
		CameraPos[playerid][0] = CameraPos[playerid][0]+(boost * floatsin(-Degrees[playerid]+90.0, degrees));
		CameraPos[playerid][1] = CameraPos[playerid][1]+(boost * floatcos(-Degrees[playerid]+90.0, degrees));
		MovePlayerRadar(playerid);
	}
	MovePlayerRadar(playerid);
	return true;
}

