public CasinoUpdateObjects(playerid, objectid, position)
{
	new Float:POS[3], string[128];
	GetObjectRot(CasinoOb[objectid], POS[0], POS[1], POS[2]);
	switch(PosCasinoOb[objectid])
	{
	case 0: PosCasinoOb[objectid] += 1, POS[0] = 36;
	case 1: PosCasinoOb[objectid] += 1, POS[0] = 54;
	case 2: PosCasinoOb[objectid] += 1, POS[0] = 71;
	case 3: PosCasinoOb[objectid] += 1, POS[0] = 89.3;
	case 4: PosCasinoOb[objectid] += 1, POS[0] = 107;
	case 5: PosCasinoOb[objectid] += 1, POS[0] = 123.5;
	case 6: PosCasinoOb[objectid] += 1, POS[0] = 0;
	}
	if(PosCasinoOb[objectid] == 6) PosCasinoOb[objectid] = 0;
	SetObjectRot(CasinoOb[objectid], POS[0], POS[1], POS[2]);
	if(position != 0) SetTimerEx("CasinoUpdateObjects", 50, 0, "iii", playerid, objectid, position-1);
	if(position == 0 && objectid == 2) CasinoAllow = 0;
	if(position == 0 && objectid == 2 && PosCasinoOb[0] == PosCasinoOb[1] && PosCasinoOb[1] == PosCasinoOb[2])
	{
		new randpay = 200+random(200);
		f(string, "Поздравляем! Ты выиграл в игровом автомате {9DDAF2}%d$", randpay);
		SendClientMessage(playerid, COLOR_WHITE, string);
		GivePlayerMoneyEx(playerid, randpay);
	}
	return true;
}

