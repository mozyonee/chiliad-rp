		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /showlic [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			new stats[128],fish_text[64],fly_text[64],car_text[64],gun_text[64],boat_text[64],gold_text[64];
			if(PlayerInfo[playerid][pLicFly] == 0) fly_text = "Не имеется";
			else fly_text = "Имеется";
			if(PlayerInfo[playerid][pLicCar] == 0) car_text = "Не имеется";
			else car_text = "Имеется";
			if(PlayerInfo[playerid][pLicGun] == 0) gun_text = "Не имеется";
			else gun_text = "Имеется";
			if(PlayerInfo[playerid][pLicBoat] == 0) boat_text = "Не имеется";
			else boat_text = "Имеется";
			if(PlayerInfo[playerid][pLicFish] == 0) fish_text = "Не имеется";
			else fish_text = "Имеется";
			if(PlayerInfo[playerid][pLicFish] == 0) gold_text = "Не имеется";
			else gold_text = "Имеется";
			f(stats, "{9DDAF2}Добыча золота: {FFFFFF}%s\n", gold_text); strcat(string, stats);
			f(stats, "{9DDAF2}Рыбалка: {FFFFF}%s\n", fish_text); strcat(string, stats);
			f(stats, "{9DDAF2}Оружие: {FFFFFF}%s\n", gun_text); strcat(string, stats);
			f(stats, "{9DDAF2}Лётный тс: {FFFFFF}%s\n", fly_text); strcat(string, stats);
			f(stats, "{9DDAF2}Водный тс: {FFFFFF}%s\n", boat_text); strcat(string, stats);
			f(stats, "{9DDAF2}Права: {FFFFFF}%s", car_text); strcat(string, stats);
			f(stats, "Лицензии игрока {FFFFFF}%s", PlayerNameEx[playerid]);
			ShowDialog(giveplayerid, 00000, DIALOG_STYLE_MSGBOX, stats, string, "Закрыть", "");
			SetPlayerChatBubble(playerid, "Показал лицензии", COLOR_AQUA, 30.0, 5000);
			f(string, "Ты показал свои лицензии игроку {9DDAF2}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/wedding", true))
	{
		if(!PlayerInWedding[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься у алтаря");
		if(strcmp(PlayerInfo[playerid][pMarriage], "None", false)) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже помолвлен");
		if(PlayerInfo[playerid][pSex] == 2) return SendClientMessage(playerid, COLOR_GREEN, "Только мужчина может предложить выйти за него замуж");
		if(WeddingStart) return SendClientMessage(playerid, COLOR_GREEN, "Алтарь занят другой парой");
		if(PlayerToPoint(playerid, 1.0, 1235.1146, -1565.8447, 3277.454)) return SendClientMessage(playerid, COLOR_GREEN, "Это место для невесты");
		if(WeddingPlace[0] == playerid && WeddingPlace[1] != INVALID_PLAYER_ID)
		{
			new marriage = WeddingPlace[1];
			if(PlayerInfo[marriage][pSex] == PlayerInfo[playerid][pSex]) return SendClientMessage(playerid, COLOR_GREEN, "У нас в штате запрещён однополый брак");
			WeddingStart = true;
			f(string, "\
%s предлагает тебе выйти за него замуж.\n\
Ты согласна?", PlayerNameEx[playerid]);
			ShowDialog(marriage, WEDDING_ID+5, DIALOG_STYLE_MSGBOX, "Бракосочетание", string, "Да", "Нет");
			f(string, "Ты предложил {9DDAF2}%s {FFFFFF}выйти за тебя замуж.", PlayerNameEx[marriage]);
			SendClientMessage(playerid, COLOR_WHITE, string);
		}
		else
		{
			SendClientMessage(playerid, COLOR_GREEN, "Твоя невеста не находится у алтаря");
		}
		return true;
	}

	else if(!strcmp(cmd, "/divorce", true))
	{
		if(!PlayerToPoint(playerid, 50, 1235.1146, -1565.8447, 3277.454)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься в салоне бракосочетания");
		if(!strcmp(PlayerInfo[playerid][pMarriage], "None", true)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не помолвлен");
		new marriage = INVALID_PLAYER_ID;
		for(new i=0; i<GetMaxPlayers(); i++)
		{
			if(IsPlayerConnected(i))
			{
				if(!strcmp(PlayerInfo[playerid][pMarriage], PlayerName[i], true))
				{
					marriage = i;
					break;
				}
			}
		}
		if(marriage == INVALID_PLAYER_ID)
		{
			if(PlayerInfo[playerid][pSex] == 1) SendClientMessage(playerid, COLOR_GREEN, "Твоей невесты нет на сервере");
			else SendClientMessage(playerid, COLOR_GREEN, "Твоего жениха нет на сервере");
			return true;
		}
		if(!PlayerToPoint(marriage, 100, 1235.1146, -1565.8447, 3277.454))
		{
			if(PlayerInfo[playerid][pSex] == 1) SendClientMessage(playerid, COLOR_GREEN, "Твоя невеста не находится в салоне бракосочетания");
			else SendClientMessage(playerid, COLOR_GREEN, "Твой жених не находится в салоне бракосочетания");
			return true;
		}
		if(PlayerInfo[playerid][pSex] == 1)
		{
			f(string, "Жених {9DDAF2}%s {FFFFFF} развелся с тобой. Теперь вы не пара.", PlayerNameEx[playerid]);
			SendClientMessage(marriage, COLOR_WHITE, string);
			f(string, "Ты развелся с невестой {9DDAF2}%s {FFFFFF}. Теперь вы не пара.", PlayerNameEx[marriage]);
			SendClientMessage(playerid, COLOR_WHITE, string);
		}
		else
		{
			f(string, "Невеста {9DDAF2}%s {FFFFFF} развелась с тобой. Теперь вы не пара.", PlayerNameEx[marriage]);
			SendClientMessage(marriage, COLOR_WHITE, string);
			f(string, "Ты развелась с женихом {9DDAF2}%s {FFFFFF}. Теперь вы не пара.", PlayerNameEx[playerid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
		}
		settext(PlayerInfo[playerid][pMarriage], "None");
		settext(PlayerInfo[marriage][pMarriage], "None");
		return true;
	}

	else if(!strcmp(cmd, "/stats", true))
	{
		ShowPlayerStats(playerid, playerid);
		return true;
