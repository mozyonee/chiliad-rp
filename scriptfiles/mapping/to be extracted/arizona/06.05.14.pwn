			SendClientMessage(playerid, COLOR_WHITE, "Регистрация банковской карты началась. Подожди некоторое время...");
			SetTimerEx("GivePlayerBankKart", 20000, false, "i", playerid);
			TogglePlayerControllable(playerid, false);
