		if(strcmp(PlayerName[playerid], "Max_Brown", false)) f(string, "Администратор %s: {F2D1AC}%s", PlayerNameEx[playerid], result);
		else f(string, "Администратор: {F2D1AC}%s", result);
		SendClientMessageToAll(0xF0C392AA, string);
		return true;
	}
	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/b", true))
	{
		result = strrest(cmdtext, idx);
		if(!strlen(result) && !strcmp(cmd, "/b", true)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /b [ текст ]");
		if(GetPlayerDrunkChat(playerid) < 20)
		{
   if(!PlayerMasked[playerid]) f(string, "- %s что-то бормочет", PlayerNameEx[playerid]);
			else f(string, "- Незнакомец что-то бормочет");
			SendDistanceChat(playerid, 20.0, string);
			SetPlayerChatBubble(playerid, "что-то бормочет", COLOR_AQUA, 30.0, 5000);
		}
 	else
		{
			if(!PlayerMasked[playerid]) f(string, "- %s [OOC чат]: (( %s ))", PlayerNameEx[playerid], result);
			else f(string, "- Незнакомец говорит [OOC чат]: (( %s ))", result);
			SendDistanceChat(playerid, 20.0, string);
			f(string, "%s", result);
			SetPlayerChatBubble(playerid, string, COLOR_BTEXT, 30.0, 5000);
		}
		printf("%s: (( %s ))", PlayerName[playerid], result);
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/s", true) || !strcmp(cmd, "/shout", true))
	{
		if(PlayerInfo[playerid][pMuteTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Твоё время молчанки ещё не истекло");
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: (/s)hout [ текст ]");
		if(GetPlayerDrunkChat(playerid) < 20)
		{
   if(!PlayerMasked[playerid]) f(string, "- %s что-то бормочет", PlayerNameEx[playerid]);
			else f(string, "- Незнакомец что-то бормочет");
			SendDistanceChat(playerid, 30.0, string);
			SetPlayerChatBubble(playerid, "что-то бормочет", COLOR_AQUA, 30.0, 5000);
		}
		else
		{
   if(!PlayerMasked[playerid]) f(string, "- %s кричит: %s", PlayerNameEx[playerid], result);
			else f(string, "- Незнакомец кричит: %s", result);
			SendDistanceChat(playerid, 30.0, string);
			f(string, "%s", result);
			SetPlayerChatBubble(playerid, string, COLOR_BTEXT, 30.0, 5000);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/map", true))
	{
		if(PlayerInfo[playerid][pMember] != REPORTER_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции новостного агентсва");
		if(PlayerInfo[playerid][pRank] < 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть третьего ранга, чтобы пользоваться спутником");
		if(!PlayerUseMap[playerid])
		{
			if(IsReporterCar(GetPlayerVehicleID(playerid)))
			{
				GetPlayerSavedPos(playerid);
				GetPlayerSavedCar(playerid);
				MapTimer[playerid] = SetTimerEx("CheckPlayerKeys", 100, 1, "i", playerid);
				new Float:POS[3];
				SetPlayerInterior(playerid, 0);
				Altitude[playerid] = 8;
				GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
				SetPlayerPos(playerid, POS[0], POS[1], POS[2]-50.0);
				SetPlayerCameraPos(playerid, POS[0], POS[1], POS[2]+1500.0);
				SetPlayerCameraLookAt(playerid, POS[0], POS[2]+0.1, POS[2]);
				CameraPos[playerid][0] = POS[0];
				CameraPos[playerid][1] = POS[1];
				CameraPos[playerid][2] = POS[1]+1500.0;
				TogglePlayerControllable(playerid, false);
				MovePlayerTimer[playerid] = SetTimerEx("OnPlayerMoveRadar", 500, true, "i", playerid);
				PlayerUseMap[playerid] = true;
			}
			else
			{
				SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься в служебном транспорте");
			}
		}
		else
		{
			TogglePlayerControllable(playerid, true);
			SetPlayerSavedPos(playerid);
			SetPlayerSavedCar(playerid);
			KillTimer(MapTimer[playerid]);
			KillTimer(MovePlayerTimer[playerid]);
			PlayerUseMap[playerid] = false;
		}
		return true;
	}

	//------------------------------------------------------------------------------

		else if(!strcmp(cmd, "/live", true))
	{
	    if(PlayerInfo[playerid][pMember] != REPORTER_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции новостного агентсва");
		if(PlayerInfo[playerid][pRank] < 4) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть четвёртого ранга, чтобы брать интервью");
		if(LiveStarted && !PlayerUseLive[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Кто-то из новостного агентсва уже берёт интервью");
		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь брать интервью");
	  	if(!PlayerUseLive[playerid])
	 	{
		 	tmp = strtok(cmdtext, idx);
 			if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /live [ id игрока ]");
	  		giveplayerid = strval(tmp);
	  		if(IsPlayerConnected(giveplayerid))
	  		{
				if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
		  		if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
				if(PlayerInfo[giveplayerid][pMember] == REPORTER_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не можешь брать интервью у репортёра");
				if(PlayerUseLive[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "У этого игрока уже кто-то берёт интервью");
		        f(string, "Ты предложил игроку {9DDAF2}%s{FFFFFF} взять у него интервью.", PlayerNameEx[giveplayerid]);
		        SendClientMessage(playerid, COLOR_WHITE, string);
		        f(string, "\
				Игрок %s предлагает взять у тебя интервью\
				", PlayerNameEx[playerid]);
		        ShowDialog(giveplayerid, INTERV_ID, DIALOG_STYLE_MSGBOX, "Предложение", string, "Да", "Нет");
	        	GetIntervGiver[giveplayerid] = playerid;
			}
		  	else
	  		{
			  	MSG_NOTPLAYER(playerid);
		  	}
	    }
	    else
	    {
            new giverid = GetIntervEx;
			f(string, "[ прямой эфир ] Репортёр {F5DE9A}%s{F0CC60} закончил интервью у игрока {F5DE9A}%s", PlayerNameEx[playerid], PlayerNameEx[giverid]);
			SendClientMessageToAll(0xF0CC60FF, string);
			LiveStarted = false;
            PlayerUseLive[giverid] = false;
            PlayerUseLive[playerid] = false;
            GetIntervGiver[playerid] = INVALID_PLAYER_ID;
            GetIntervEx = INVALID_PLAYER_ID;
	    }
	    return 1;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/n", true) || !strcmp(cmd, "/nnc", true))
	{
		if(PlayerInfo[playerid][pMember] == REPORTER_ORG)
		{
			if(!PlayerUseLive[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Ты не у кого не берёшь интервью");
			result = strrest(cmdtext, idx);
			if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: (/n)nc [ текст ]");
			f(string, "[ интервью ] Репортёр %s: {F5E5B8}%s", PlayerNameEx[playerid], result);
			SendClientMessageToAll(0xE3D2A1FF, string);
		}
		else
		{
			if(!PlayerUseLive[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "У тебя не кто не берёт интервью");
			result = strrest(cmdtext, idx);
			if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: (/n)nc [ текст ]");
			f(string, "[ интервью ] %s: {F5E5B8}%s", PlayerNameEx[playerid], result);
			SendClientMessageToAll(0xE3D2A1FF, string);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/news", true))
	{
		if(PlayerInfo[playerid][pMember] != REPORTER_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции новостного агентсва");
		if(PlayerInfo[playerid][pRank] < 2) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть второго ранга, чтобы размещать новости");
		if(PlayerInfo[playerid][pMuteTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Твоё время молчанки ещё не истекло");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь размещать новости");
		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь размещать новости");
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /news [ текст ]");
		f(string, "[  Новости ] %s: {E4F5BF}%s", PlayerNameEx[playerid], result);
		SendClientMessageToAll(0xBDDE76FF, string);
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/read", true))
	{
		if(!PlayerPaper[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "У тебя нет с собой газеты");
		new paper_text[256];
		f(paper_text, "{FFFFFF}Газета: {9DDAF2}%s {FFFFFF}| Издатель: {9DDAF2}%s{FFFFFF}\n\n", PaperNameB[playerid], PaperIssuer[playerid]);
		strcat(string, paper_text);
		f(paper_text, "%s\n", PaperListB[playerid][0]);
		strcat(string, paper_text);
		f(paper_text, "%s\n", PaperListB[playerid][1]);
		strcat(string, paper_text);
		f(paper_text, "%s\n", PaperListB[playerid][2]);
		strcat(string, paper_text);
		f(paper_text, "%s\n", PaperListB[playerid][3]);
		strcat(string, paper_text);
		f(paper_text, "%s\n", PaperListB[playerid][4]);
		strcat(string, paper_text);
		f(paper_text, "%s\n", PaperListB[playerid][5]);
		strcat(string, paper_text);
		f(paper_text, "%s\n", PaperListB[playerid][6]);
		strcat(string, paper_text);
		f(paper_text, "%s\n", PaperListB[playerid][7]);
		strcat(string, paper_text);
		f(paper_text, "%s\n", PaperListB[playerid][8]);
		strcat(string, paper_text);
		f(paper_text, "%s\n", PaperListB[playerid][9]);
		strcat(string, paper_text);
		ShowDialog(playerid, 00000, DIALOG_STYLE_MSGBOX, "Чтение газеты", string, "Закрыть", "");
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/paper", true))
	{
		if(PlayerInfo[playerid][pMember] != REPORTER_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции новостного агентсва");
		if(GetPlayerVirtualWorld(playerid) != NEWS_MIR) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен находиться в здании новостного агенства");
		strcat(string, "{FFFFFF}Заголовок: {9DDAF2}пусто {C4D696}\n\n");
		strcat(string, "---\n");
		strcat(string, "---\n");
		strcat(string, "---\n");
		strcat(string, "---\n");
		strcat(string, "---\n");
		strcat(string, "---\n");
		strcat(string, "---\n");
		strcat(string, "---\n");
		strcat(string, "---\n");
		strcat(string, "---\n\n");
		strcat(string, "{FAE54B}- Введи заголовок газеты:");
		ShowDialog(playerid, PAPER_ID, DIALOG_STYLE_INPUT, "Издание газеты", string, "Ок", "Отмена");
		PaperNumber[playerid] = 0;
		settext(PaperNameA[playerid], "---");
		for(new i=0; i<10; i++)
		{
			settext(PaperListA[playerid][i], "---");
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/sellpaper", true))
	{
	    if(PlayerInfo[playerid][pMember] != REPORTER_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции новостного агентсва");
		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь продовать газеты");
	  	if(!PlayerPaper[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "У тебя нет с собой изданной газеты");
	  	tmp = strtok(cmdtext, idx);
	  	if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /sellpaper [ id игрока ] [ стоимость ]");
	  	giveplayerid = strval(tmp);
	  	tmp = strtok(cmdtext, idx);
	  	if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /sellpaper [ id игрока ] [ стоимость ]");
	  	new price = strval(tmp);
	  	if(price < 10 || price > 1000) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верную цену. Используй цену от 10$ до 1000$");
	  	if(!IsPlayerConnected(giveplayerid)) return MSG_NOTPLAYER(playerid);
	  	if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
	    if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
     	if(price > GetPlayerMoneyEx(giveplayerid)) return SendClientMessage(playerid, COLOR_GREEN, "Твоему пукапателю не хватает денег на покупку");
		GetPlayerTransfer[giveplayerid] = playerid;
  	    GetPlayerOption[giveplayerid] = price;
       	f(string, "Ты предложил игроку {9DDAF2}%s{FFFFFF} купить у тебя газету за {9DDAF2}%d$", PlayerNameEx[giveplayerid], price);
  	    SendClientMessage(playerid, COLOR_WHITE, string);
  		f(string, "\
		Игрок %s предлагает тебе купить у него газету.\n\
		Стоимость: %d$\
		", PlayerNameEx[playerid], price);
	    ShowDialog(giveplayerid, PAPER_ID+3, DIALOG_STYLE_MSGBOX, "Предложение", string, "Да", "Нет");
	  	return 1;
	}

	//------------------------------------------------------------------------------


   	else if(!strcmp(cmd, "/advertise", true) || !strcmp(cmd, "/ad", true)) 
	{
      	if(PlayerInfo[playerid][pLevel] < 3) return SendClientMessage(playerid, COLOR_GREEN, "Тебе нужен уровень 3, чтобы разместить объявление");
		//if(GetPlayerVirtualWorld(playerid) != NEWS_MIR) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен находиться в здании новостного агенства");
		if(AdvertiseWaitChat > 0)
 		{
 		    f(string, "Подавать объявление можно через %d секунд!", AdvertiseWaitChat);
		 	SendClientMessage(playerid, 0xF4FCC7FF, string);
		 	return 1;
 		}
		if(PlayerInfo[playerid][pMuteTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Твоё время молчанки ещё не истекло");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь размещать объявление");
		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь размещать объявление");
 		result = strrest(cmdtext, idx);
	  	if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: (/ad)vertise [ текст ]");
	  	if(strlen(result) > 90) return SendClientMessage(playerid, COLOR_GREEN, "Привышен допустимый лимит длины текста");
	  	new payout = idx*3;
	  	if(GetPlayerMoneyEx(playerid) < payout)
		{
			f(string, "У тебя не достаточно денег. Нужно{5BD93B} %d$", payout);
	    	SendClientMessage(playerid, COLOR_GREEN, string);
			return 1;
		}
	  	if(BusinessInfo[ADV_BIZZ][bFunds] < idx) return SendClientMessage(playerid, COLOR_GREEN, "В рекламном бизнесе не хватает сырья");
		GivePlayerMoneyEx(playerid, -payout);
		if(PlayerInfo[playerid][pPhNumber] == 0) f(string, "[Реклама]{FFBB00} %s: {E5F7AD}%s", PlayerNameEx[playerid], result);
	  	else f(string, "[Реклама]{FFBB00} %s: {FFFFFF}{E5F7AD}%s | {FFBB00}Телефон:{FFFFFF} %d", PlayerNameEx[playerid], result, PlayerInfo[playerid][pPhNumber]);
	  	SendClientMessageToAll(0xCCF060FF, string);
		BusinessInfo[ADV_BIZZ][bBalance] += payout;
		BusinessInfo[ADV_BIZZ][bFunds] -= idx;
		AdvertiseWaitChat = 60;
	  	return 1;
	}

	//------------------------------------------------------------------------------

    else if(!strcmp(cmd, "/board", true))
	{
      	if(PlayerInfo[playerid][pLevel] < 2) return SendClientMessage(playerid, COLOR_GREEN, "Тебе нужен уровень 2, чтобы разместить рекламу");
		//if(GetPlayerVirtualWorld(playerid) != NEWS_MIR) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен находиться в здании новостного агенства");
		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь размещать рекламу");
		tmp = strtok(cmdtext, idx);
	  	if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /board [ место ] [ время в часах ] [ текст ]");
	  	new place = strval(tmp);
	  	if(place < 1 || place > MAX_ADVERT)
  		{
		  	f(string, "Ты ввёл не верное место. Используй место от 1 до %d", MAX_ADVERT);
			SendClientMessage(playerid, COLOR_GREEN, string);
		  	return 1;
		}
	  	place -= 1;
 		tmp = strtok(cmdtext, idx);
	  	if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /board [ место ] [ время в часах ] [ текст ]");
	  	new time = strval(tmp);
	  	if(time < 1 || time > 5) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верное время. Используй время от 1 до 5");
 		result = strrest(cmdtext, idx);
	  	if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /board [ место ] [ время в часах ] [ текст ]");
	  	new payout = (idx*50)+(time*2000);
	  	if(GetPlayerMoneyEx(playerid) < payout)
		{
			f(string, "У тебя не достаточно денег. Нужно{5BD93B} %d$", payout);
	    	SendClientMessage(playerid, COLOR_GREEN, string);
			return 1;
		}
	  	if(BusinessInfo[ADV_BIZZ][bFunds] < idx) return SendClientMessage(playerid, COLOR_GREEN, "В рекламном бизнесе не хватает сырья");
		if(AdvertOwned[place]) return SendClientMessage(playerid, COLOR_GREEN, "Это рекламное место уже занято");
		GivePlayerMoneyEx(playerid, -payout);
		AdvertOwned[place] = true;
		SetTimerEx("DeleteTextBoard", time*3600000, false, "ii", playerid, place);
		f(string, "[ рекламный щит №%d ]\n{FFFFFF}%s", place+1, result);
  		UpdateDynamic3DTextLabelText(AdvertText[place], COLOR_AQUA, string);
		BusinessInfo[ADV_BIZZ][bBalance] += payout;
		BusinessInfo[ADV_BIZZ][bFunds] -= idx;
		f(string, "Ты успешно арендовал рекламное место №%d", place+1);
		SendClientMessage(playerid, COLOR_WHITE, string);
	  	return 1;
	}
	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/me", true))
	{
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /me [ текст ]");
		if(!PlayerMasked[playerid]) f(string, "{B17FC8}Игрок %s %s", PlayerNameEx[playerid], result);
		else f(string, "{B17FC8}Незнакомец %s", result);
		SendDistanceChat(playerid, 20.0, string);
		f(string, "%s", result);
		SetPlayerChatBubble(playerid, string, COLOR_AQUA, 30.0, 5000);
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/do", true))
	{
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /do [ текст ]");
		if(!PlayerMasked[playerid]) f(string, "{B17FC8}%s ((%s))", result, PlayerNameEx[playerid]);
		else f(string, "{B17FC8}%s ((Незнакомец))", result);
		SendDistanceChat(playerid, 20.0, string);
		f(string, "%s", result);
		SetPlayerChatBubble(playerid, string, COLOR_AQUA, 30.0, 5000);
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/try", true))
	{
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /try [ текст ]");
		if(!PlayerMasked[playerid])
		{
			if(random(10) >= 5) f(string, "{B17FC8}У гражданина %s получается %s", PlayerNameEx[playerid], result);
			else f(string, "{B17FC8}У гражданина %s не получается %s", PlayerNameEx[playerid], result);
		}
		else
		{
			if(random(10) >= 5) f(string, "{B17FC8}У незнакомца получается %s", result);
			else f(string, "{B17FC8}У незнакомца не получается %s", result);
		}
		SendDistanceChat(playerid, 20.0, string);
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/whisper", true) || !strcmp(cmd, "/w", true))
	{
		if(PlayerInfo[playerid][pMuteTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Твоё время молчанки ещё не истекло");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: (/w)hisper [ id игрока ] [ текст ]");
		giveplayerid = strval(tmp);
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: (/w)hisper [ id игрока ] [ текст ]");
		if(IsPlayerConnected(giveplayerid))
		{
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			if(!PlayerMasked[playerid]) f(string, "- %s шепчет: %s", PlayerNameEx[playerid], result);
			else f(string, "- Незнакомец шепчет: %s", result);
			SendClientMessage(giveplayerid, 0xBBAEC2FF, string);
			SendClientMessage(playerid, 0xBBAEC2FF, string);
			new str[128];
			if(!PlayerMasked[playerid]) f(str, "%s что-то шепчет", PlayerNameEx[playerid]);
			else f(str, "Незнакомец что-то шепчет");
			for(new i=0; i<GetMaxPlayers(); i++)
			{
				if(IsPlayerConnected(i) && GetDistancePlayers(playerid, i) < 5.0 && i != playerid && i != giveplayerid) SendClientMessage(i, 0xB17FC8FF, str);
			}
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/f", true) || !strcmp(cmd, "/family", true))
	{
		if(GetOrganizationType(PlayerInfo[playerid][pMember]) != 2 && GetOrganizationType(PlayerInfo[playerid][pMember]) != 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты не состоишь в какой-либо банде или мафии");
		if(PlayerInfo[playerid][pMuteTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Твоё время молчанки ещё не истекло");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь писать в чат мафии/банды");
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: (/f)amily [ текст ]");
		if(GetOrganizationType(PlayerInfo[playerid][pMember]) == 3) f(string, "[ чат мафии ] %s %s: {DEDA62}%s", GetPlayerRank(playerid), PlayerNameEx[playerid], result);
		else f(string, "[ чат банды ] %s %s: {DEDA62}%s", GetPlayerRank(playerid), PlayerNameEx[playerid], result);
		SendFamilyMessage(PlayerInfo[playerid][pMember], 0xBFB900FF, string);
		return true;
	}
	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/eject", true))
	{
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER) return MSG_NODRIVER(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /eject [ id игрока ]");
		giveplayerid = strval(tmp);
		if(!IsPlayerConnected(giveplayerid)) return MSG_NOTPLAYER(playerid);
		if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
		if(!IsPlayerInVehicle(giveplayerid, GetPlayerVehicleID(playerid))) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок не сидит в твоей машине");
		RemovePlayerFromVehicleEx(giveplayerid);
		f(string, "Ты выбросил из машины игрока {9DDAF2}%s", PlayerNameEx[giveplayerid]);
		SendClientMessage(playerid, COLOR_WHITE, string);
		SetPlayerChatBubble(playerid, "Выбросил пассажира", COLOR_AQUA, 30.0, 5000);
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/ukaz", true))
	{
		if(PlayerInfo[playerid][pMember] != MERIA_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции правительства штата");
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /ukaz [ текст ]");
		f(string, "[ Сельсовет ] Мэр {47D1AA}%s{0AC48F} издал указ: {47D1AA}%s", PlayerNameEx[playerid], result);
		SendClientMessageToAll(0x0AC48FFF, string);
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/wage", true))
	{
		if(PlayerInfo[playerid][pMember] != MERIA_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции правительства штата");
		if(PlayerInfo[playerid][pRank] < 4) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть четвёртого ранга, чтобы менять среднюю зарплату");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /wage [ зарплата ]");
		new wage = strval(tmp);
		if(wage < 100 || wage > 400) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верную зарплату. Используй зарплату от 100$ до 400$");
		GetWage = wage;
		f(string, "[ Сельсовет ] Мэр {47D1AA}%s{0AC48F} установил среднюю зарплату жителей на {47D1AA}%d$", PlayerNameEx[playerid], wage);
		SendClientMessageToAll(0x0AC48FFF, string);
		return true;
	}

	else if(!strcmp(cmd, "/nalog", true))
	{
		if(PlayerInfo[playerid][pMember] != MERIA_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции правительства штата");
		if(PlayerInfo[playerid][pRank] < 4) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть четвёртого ранга, чтобы менять налоги");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /nalog [ налоги ]");
		new nalog = strval(tmp);
		if(nalog < 1 || nalog > 30) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верное значение налогов. Используй значение от 1%% до 30%%");
		GetNalog = nalog;
		f(string, "[ Сельсовет ] Мэр {47D1AA}%s{0AC48F} установил налоги жителей на {47D1AA}%d%s", PlayerNameEx[playerid], nalog, "%%");
