	else if(dialogid == HOUSE_ID+3)
	{
		if(response)
		{
			new houseid = PlayerInfo[playerid][pHouse];
			new intnum = PlayerInteriorView[playerid]-1;
			if(intnum == 0)
			{
				intnum = 9;
			}
			if(intnum == -1)
			{
				intnum = 1;
			}
			new intprice = PlayerInteriorPrice[playerid];
			if(BusinessInfo[HOUSE_BIZZ][bFunds] < intnum)
			{
				ShowMenuForPlayer(HouseMenu, playerid);
				SendClientMessage(playerid, COLOR_GREEN, "В магазине 'Всё для дома' не хватает мебели");
				return true;
			}
			if(HouseInfo[houseid][hInterior] == intnum)
			{
				ShowMenuForPlayer(HouseMenu, playerid);
				SendClientMessage(playerid, COLOR_GREEN, "У тебя уже есть этот интерьер дома");
				return true;
			}
			if(GetPlayerMoneyEx(playerid) < intprice)
			{
				ShowMenuForPlayer(HouseMenu, playerid);
				f(string, "У тебя не достаточно денег. Нужно{5BD93B} %d$", intprice);
				SendClientMessage(playerid, COLOR_GREEN, string);
				return true;
			}
			KillTimer(InteriorView[playerid]);
			GetPlayerInteriorView[playerid] = false;
			PlayerInteriorView[playerid] = 0;
			TogglePlayerControllable(playerid, true);
			GameTextForPlayer(playerid, "~n~", 1000, 3);
			SetCameraBehindPlayer(playerid);
			GivePlayerMoneyEx(playerid, -intprice);
			HouseInfo[houseid][hInterior] = intnum;
			BusinessInfo[HOUSE_BIZZ][bBalance] += intprice;
			BusinessInfo[HOUSE_BIZZ][bFunds] -= intnum;
			f(string, "Ты купил новый интерьер за {9DDAF2}%d$", intprice);
			SendClientMessage(playerid, COLOR_WHITE, string);
			DestroyDynamicPickup(HousePickupInt[houseid]);
			CreateHouseExitPickup(houseid);
			for(new i=0; i<GetMaxPlayers(); i++)
			{
				if(IsPlayerConnected(i))
				{
					if(IsInPlayerHouse[i][houseid])
					{
						SetPlayerHouseInterior(i, houseid);
					}
				}
			}
		}
		else
		{
			ShowMenuForPlayer(HouseMenu, playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(dialogid == HOUSE_ID+4)
	{
		if(response)
		{
			new houseid = PlayerInfo[playerid][pHouse];
			if(BusinessInfo[HOUSE_BIZZ][bFunds] < 1) return SendClientMessage(playerid, COLOR_GREEN, "В магазине 'Всё для дома' не хватает сырья");
			switch(listitem)
			{
			case 0:
				{
					if(HouseInfo[houseid][hHealth] == 1) return SendClientMessage(playerid, COLOR_GREEN, "У тебя уже есть аптечка");
					if(GetPlayerMoneyEx(playerid) < 7000) return SendClientMessage(playerid, COLOR_GREEN, "У тебя не достаточно денег. Нужно{5BD93B} 7000$");
					SendClientMessage(playerid, COLOR_WHITE, "Ты успешно приобрёл аптечку");
					SendClientMessage(playerid, COLOR_GRAY, "После каждого посещения дома, твоё здоровие будет по максимуму");
					HouseInfo[houseid][hHealth] = 1;
					GivePlayerMoneyEx(playerid, -7000);
					BusinessInfo[HOUSE_BIZZ][bBalance] += 700;
					BusinessInfo[HOUSE_BIZZ][bFunds] -= 1;
				}
			case 1:
				{
					if(HouseInfo[houseid][hSave] == 1) return SendClientMessage(playerid, COLOR_GREEN, "У тебя уже есть обычный сейф");
					if(GetPlayerMoneyEx(playerid) < 5000) return SendClientMessage(playerid, COLOR_GREEN, "У тебя не достаточно денег. Нужно{5BD93B} 5000$");
					SendClientMessage(playerid, COLOR_WHITE, "Ты успешно приобрёл обычный сейф");
					SendClientMessage(playerid, COLOR_GRAY, "Теперь ты сможешь хранить в нём свои деньги");
					SendClientMessage(playerid, COLOR_GRAY, "Этот сейф могут взломать. Максимальное количество денег - 100.000$");
					HouseInfo[houseid][hSave] = 1;
					GivePlayerMoneyEx(playerid, -5000);
					BusinessInfo[HOUSE_BIZZ][bBalance] += 500;
					BusinessInfo[HOUSE_BIZZ][bFunds] -= 1;
				}
			case 2:
				{
					if(HouseInfo[houseid][hSave] == 2) return SendClientMessage(playerid, COLOR_GREEN, "У тебя уже есть железный сейф");
					if(GetPlayerMoneyEx(playerid) < 10000) return SendClientMessage(playerid, COLOR_GREEN, "У тебя не достаточно денег. Нужно{5BD93B} 10000$");
					SendClientMessage(playerid, COLOR_WHITE, "Ты успешно приобрёл железный сейф");
					SendClientMessage(playerid, COLOR_GRAY, "Теперь ты сможешь хранить в нём свои деньги");
					SendClientMessage(playerid, COLOR_GRAY, "Этот сейф никто не сможет взломать. Максимальное количество денег - 1.000.000$");
					HouseInfo[houseid][hSave] = 2;
					GivePlayerMoneyEx(playerid, -10000);
					BusinessInfo[HOUSE_BIZZ][bBalance] += 800;
					BusinessInfo[HOUSE_BIZZ][bFunds] -= 1;
				}
			case 3:
				{
					if(HouseInfo[houseid][hClooth] == 1) return SendClientMessage(playerid, COLOR_GREEN, "У тебя уже есть гардероб");
					if(GetPlayerMoneyEx(playerid) < 5000) return SendClientMessage(playerid, COLOR_GREEN, "У тебя не достаточно денег. Нужно{5BD93B} 5000$");
					SendClientMessage(playerid, COLOR_WHITE, "Ты успешно приобрёл гардероб");
					SendClientMessage(playerid, COLOR_GRAY, "С помощью гардероба ты сможешь одеть на себя шляпу или бандану");
