	else if(!strcmp(cmd, "/skill", true))
	{
		new status[11][256];
		new weapon[11];
		for(new i=0; i<11; i++)
		{
			if(PlayerSkills[playerid][i] >= 10) weapon[i] = floatround(PlayerSkills[playerid][i]/10);
			else weapon[i] = 0;
		}
		for(new i=0; i<11; i++)
		{
			format(status[i], 256, "{66C1E8}%d%s\t{FFFFFF}[ ", weapon[i], "%");
			for(new x=0; x<10; x++)
			{
				if(x < floatround(weapon[i]/10)) strcat(status[i], "|");
				else strcat(status[i], " ");
			}
			strcat(status[i], " ]");
		}
		new stringskill[3000];
		f(stringskill, "\
{FFE100}PISTOL\t\t%s\n\
{FFE100}PISTOL S\t%s\n\
{FFE100}DEAGLE\t%s\n\
{FFE100}SHOTGUN\t%s\n\
{FFE100}SAWNOFF\t%s\n\
{FFE100}SPAS12\t%s\n\
{FFE100}MICRO UZI\t%s\n\
{FFE100}MP5\t\t%s\n\
{FFE100}AK47\t\t%s\n\
{FFE100}M4\t\t%s\n\
{FFE100}SNIPER\t\t%s\
", status[0],status[1],status[2],status[3],
		status[4],status[5],status[6],status[7],
		status[8],status[9],status[10]);
		ShowDialog(playerid, 00000, DIALOG_STYLE_MSGBOX, "Навыки владения оружием", stringskill, "Закрыть", "");
		return true;
	}

	else if(!strcmp(cmd, "/bizz", true))
