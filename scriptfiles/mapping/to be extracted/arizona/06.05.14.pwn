stock ShowPlayerStats(playerid, togplayerid)
{
	new stringx[2024],
	stats[256],
	admin_text[64],
	house_text[64],
	medkart_text[64],
	pasport_text[64],
	zam_text[64],
	bizz_text[64],
	sex_text[64],
	spawn_text[64],
	rod_text[64],
	lop_text[64],
	book_text[64],
	leader_text[64],
	help_text[64];
	////////////////////////////////////////////////////////////////////////////
	if(PlayerInfo[playerid][pHelper] == 0) help_text = "Не имеется";
	else help_text = "Имеется";
	if(PlayerInfo[playerid][pHouse] != 0) house_text = "Имеется";
	else if(PlayerInfo[playerid][pRent] != 0) house_text = "Имеется (аренда)";
	else house_text = "Не имеется";
	if(PlayerInfo[playerid][pPasport] == 0) pasport_text = "Не имеется";
	else pasport_text = "Имеется";
	if(PlayerInfo[playerid][pMedKart] == 0) medkart_text = "Не имеется";
	else medkart_text = "Имеется";
	if(PlayerInfo[playerid][pSpawn] == 0) spawn_text = "Отель Fort Carson";
	else if(PlayerInfo[playerid][pSpawn] == 1) spawn_text = "Личный/арендованный дом";
	else if(PlayerInfo[playerid][pSpawn] == 2) spawn_text = "База организации";
	if(PlayerInfo[playerid][pBizz] == 0) bizz_text = "Не имеется";
	else bizz_text = "Имеется";
	if(PlayerInfo[playerid][pLeader] == 0) leader_text = "Не имеется";
	else leader_text = "Имеется";
	if(PlayerInfo[playerid][pZam] == 0) zam_text = "Не имеется";
	else zam_text = "Имеется";
	if(PlayerInfo[playerid][pSex] == 1) sex_text = "Мужчина";
	else sex_text = "Женщина";
	if(PlayerInfo[playerid][pRod] == 1) rod_text = "Имеется";
	else rod_text = "Не имеется";
	if(PlayerInfo[playerid][pLop] == 1) lop_text = "Имеется";
	else lop_text = "Не имеется";
	if(PlayerInfo[playerid][pPhBook] == 1) book_text = "Имеется";
	else book_text = "Не имеется";
	////////////////////////////////////////////////////////////////////////////
	strcat(stringx, "{A0BA1E}____________________________\n\n");
	f(stats, "{DAF04F}Имя: {FFFFFF}%s\n", pName(playerid)); strcat(stringx, stats);
	f(stats, "{DAF04F}Фамилия: {FFFFFF}%s\n", pFamily(playerid)); strcat(stringx, stats);
	strcat(stringx, "{A0BA1E}____________________________\n\n");
	f(stats, "{DAF04F}Наличные: {FFFFFF}%s\n", ConvertMoney(GetPlayerMoneyEx(playerid))); strcat(stringx, stats);
	f(stats, "{DAF04F}Банк: {FFFFFF}%s\n", ConvertMoney(PlayerInfo[playerid][pBalance])); strcat(stringx, stats);
	strcat(stringx, "{A0BA1E}____________________________\n\n");
	if(PlayerInfo[playerid][pPhNumber] == 0) f(stats, "{DAF04F}Телефон: {FFFFFF}-\n");
	else f(stats, "{DAF04F}Телефон: {FFFFFF}%d\n", PlayerInfo[playerid][pPhNumber]);
	strcat(stringx, stats);
	if(PlayerInfo[playerid][pBankKart] == 0) f(stats, "{DAF04F}Лицевой счёт: {FFFFFF}-\n");
	else f(stats, "{DAF04F}Лицевой счёт: {FFFFFF}%d\n", PlayerInfo[playerid][pBankKart]);
	strcat(stringx, stats);
	f(stats, "{DAF04F}Купленный донат: {FFFFFF}%d\n", PlayerInfo[playerid][pDonat]); strcat(stringx, stats);
	f(stats, "{DAF04F}Количество убийств: {FFFFFF}%d\n", PlayerInfo[playerid][pKills]); strcat(stringx, stats);
	f(stats, "{DAF04F}Количество арестов: {FFFFFF}%d\n", PlayerInfo[playerid][pJailed]); strcat(stringx, stats);
	f(stats, "{DAF04F}Законопослушность: {FFFFFF}%d%%\n", PlayerInfo[playerid][pZakon]); strcat(stringx, stats);
	f(stats, "{DAF04F}Лет в Деревни: {FFFFFF}%d\n", PlayerInfo[playerid][pLevel]); strcat(stringx, stats);
	f(stats, "{DAF04F}Еморес : {FFFFFF}%d/10000\n", PlayerInfo[playerid][pPozor]);
	strcat(stringx, stats);
	f(stats, "{DAF04F}Уважение: {FFFFFF}%d/%d\n", PlayerInfo[playerid][pPayDay], (PlayerInfo[playerid][pLevel]+1)*4); strcat(stringx, stats);
	f(stats, "{DAF04F}Warns: {FFFFFF}%d/5\n", PlayerInfo[playerid][pWarns]); strcat(stringx, stats);
	strcat(stringx, "{A0BA1E}____________________________\n\n");
	f(stats, "{DAF04F}Админка: {FFFFFF}%s\n", admin_text); strcat(stringx, stats);
	f(stats, "{DAF04F}Хэлперка: {FFFFFF}%s\n", help_text); strcat(stringx, stats);
	f(stats, "{DAF04F}Дом: {FFFFFF}%s\n", house_text); strcat(stringx, stats);
	f(stats, "{DAF04F}Фракция: {FFFFFF}%s\n", GetOrganizationName(PlayerInfo[playerid][pMember])); strcat(stringx, stats);
	if(PlayerInfo[playerid][pMember] != 0)
	{
		f(stats, "{DAF04F}Должность лидера: {FFFFFF}%s\n", leader_text); strcat(stringx, stats);
		f(stats, "{DAF04F}Должность зама: {FFFFFF}%s\n", zam_text); strcat(stringx, stats);
		f(stats, "{DAF04F}Ранг: {FFFFFF}%s\n", GetPlayerRank(playerid)); strcat(stringx, stats);
		f(stats, "{DAF04F}Выговоры: {FFFFFF}%d\n", PlayerInfo[playerid][pVigovors]); strcat(stringx, stats);
	}
	f(stats, "{DAF04F}Паспорт: {FFFFFF}%s\n", pasport_text); strcat(stringx, stats);
	f(stats, "{DAF04F}Медкарта: {FFFFFF}%s\n", medkart_text); strcat(stringx, stats);
	f(stats, "{DAF04F}Работа: {FFFFFF}%s\n", gJobInfo[PlayerInfo[playerid][pJob]][JOB_NAME]); strcat(stringx, stats);
	f(stats, "{DAF04F}Бизнес: {FFFFFF}%s\n", bizz_text); strcat(stringx, stats);
	if(PlayerInfo[playerid][pSex] == 2) f(stats, "{DAF04F}Муж: {FFFFFF}%s\n", PlayerInfo[playerid][pMarriage]);
	else f(stats, "{DAF04F}Жена: {FFFFFF}%s\n", PlayerInfo[playerid][pMarriage]);
	strcat(stringx, stats);
	strcat(stringx, "{A0BA1E}____________________________\n\n");
	f(stats, "{CCE01B}Удочка: {FFFFFF}%s\n", rod_text); strcat(stringx, stats);
	f(stats, "{CCE01B}Совок: {FFFFFF}%s\n", lop_text); strcat(stringx, stats);
	f(stats, "{CCE01B}Книжка: {FFFFFF}%s\n", book_text); strcat(stringx, stats);
	strcat(stringx, "{A0BA1E}____________________________");
	////////////////////////////////////////////////////////////////////////////
	ShowDialog(togplayerid, 00000, DIALOG_STYLE_MSGBOX, "Личная статистика", stringx, "Закрыть", "");
	return true;
}

