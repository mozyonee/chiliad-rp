stock logs(log[], string[])
{
        new write[200], day, mes, god, hour, minn, sec;
        getdate(god, mes, day);
        gettime(hour, minn, sec);
        format(write, sizeof(write), "[%d.%d.%d|%d:%d:%d]%s\r\n", day, mes, god, hour, minn, sec, string);
        new File:hFile = fopen(log, io_append);
        for(new io = 0; io < strlen(write); io++) fputchar(hFile, write[io], false);
        fclose(hFile);
}
stock GN(playerid) { new name[MAX_PLAYER_NAME]; GetPlayerName(playerid, name, sizeof(name)); return name; }
public HP(playerid)
{
    new string[312];
    for(new i = 0; i < MAX_PLAYERS; i++)
    if(PlayerInfo[i][pKouka1] == 1 || PlayerInfo[i][pKouka2] == 1
    || PlayerInfo[i][pKouka3] == 1 || PlayerInfo[i][pKouka4] == 1)
    {
        new Float:health;
        GetPlayerHealth(i, health);
        if (health < 95)
        {
            SetPlayerHealthEx(i, health + 5.0);
            format(string, sizeof(string), "+5 HP");
            GameTextForPlayer(i, string, 1000, 3);
        }
        else
        {
            if(PlayerInfo[i][pKouka1] == 1 || PlayerInfo[i][pKouka2] == 1
            || PlayerInfo[i][pKouka3] == 1 || PlayerInfo[i][pKouka4] == 1)
            {
                SendClientMessage(playerid, COLOR_GREY, "Вы здоровы!");
                PlayerInfo[i][pKouka1] = 0;
                PlayerInfo[i][pKouka2] = 0;
                PlayerInfo[i][pKouka3] = 0;
                PlayerInfo[i][pKouka4] = 0;
                for(new d; d < 4; d++)
                {
                    if(HospitalBed[d] != playerid) continue;
                    else
                    {
                        HospitalBed[d] = INVALID_PLAYER_ID;
                        break;
                    }
                }
            }
        }
    }
    return 1;
}
public OnPlayerClickTextDraw(playerid, Text:clickedid)
{
	if(clickedid == KeySS[3])
	{
        OnPlayerCommandText(playerid,"/stats");
	}
	if(clickedid == KeySS[2])
	{
	    ShowPlayerDialog(playerid, REPORTANSWER_ID, DIALOG_STYLE_LIST, "Выберите тип запроса", "[1] Жалоба\n[2] Вопрос", "Выбрать","Закрыть");
	}
	if(clickedid == KeySS[1])
	{
        OnPlayerCommandText(playerid,"/skill");
	}
	if(clickedid == KeySS[0])
	{
	    OnPlayerCommandText(playerid,"/donate");
	}
	if(clickedid == KeySS[4])
	{
	    SavePlayerAccaunt(playerid);
		SendClientMessage(playerid, COLOR_WHITE, "Аккаунт успешно сохранён");
	}
	if(clickedid == KeySS[5])
	{
	    OnPlayerCommandText(playerid,"/helpers");
	}
	if(clickedid == KeySS[6])
	{
	    OnPlayerCommandText(playerid,"/lic");
	}
	if(clickedid == KeySS[7])
	{
	   OnPlayerCommandText(playerid,"/items");
	}
	if(clickedid == KeySS[8])
	{
	   OnPlayerCommandText(playerid,"/help");
	}
	if(clickedid == KeySS[9])
	{
    OnPlayerCommandText(playerid,"/fskill");
	}
	if(clickedid == KeySS[10])
	{
        OnPlayerCommandText(playerid,"/gps");
	}
	if(!(_:clickedid ^ 0xFFFF))
    {
    TextDrawHideForPlayer(playerid,MySkin[playerid]);
    for(new i = 0; i < 11; i++) TextDrawHideForPlayer(playerid,KeySS[i]);
	for(new i = 0; i < 11; i++) TextDrawHideForPlayer(playerid,Nope[i]);
    TextDrawHideForPlayer(playerid,Close[0]);
    TextDrawHideForPlayer(playerid,Close[1]);
    TextDrawHideForPlayer(playerid,MyBox);
	SendClientMessage(playerid, -1, "Вы нажали ESC");
    }
	if(clickedid == Close[1])
	{
        SetPVarInt(playerid,"KEY",0);
		TextDrawHideForPlayer(playerid,MySkin[playerid]);
		for(new i = 0; i < 11; i++) TextDrawHideForPlayer(playerid,KeySS[i]);
		for(new i = 0; i < 11; i++) TextDrawHideForPlayer(playerid,Nope[i]);
		TextDrawHideForPlayer(playerid,Close[0]);
		TextDrawHideForPlayer(playerid,Close[1]);
		TextDrawHideForPlayer(playerid,MyBox);
		CancelSelectTextDraw(playerid);
	}
	return true;
}
forward SitostiTimer(playerid);
public  SitostiTimer(playerid)
{
    PlayerInfo[playerid][pSitosti] -=1;
    SetProgressBarValue(playerid, sitosti[playerid], PlayerInfo[playerid][pSitosti]);
    UpdateProgressBar(sitosti [playerid], playerid);
    new Float:health;
    if(PlayerInfo[playerid][pSitosti] <= 30)
    {
          GetPlayerHealth(playerid, health);
          SetPlayerHealth(playerid, health - 3.0);
          if(PlayerInfo[playerid][pSitosti] > 100)
        {
            PlayerInfo[playerid][pSitosti] = 90;
        }
        else if(PlayerInfo[playerid][pSitosti] < 8)
        {
        PlayerInfo[playerid][pSitosti] = 10;
        SetProgressBarValue(playerid, sitosti[playerid], PlayerInfo[playerid][pSitosti]);
    	UpdateProgressBar(sitosti [playerid], playerid);
        }
    }
    return true;
}
