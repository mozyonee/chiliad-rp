			for(new n=0; n<MAX_AMMO; n++)
			{
				if(PlayerToPoint(playerid, 1.0, ammoenter[n][0], ammoenter[n][1], ammoenter[n][2]))
				{
					SetPlayerVirtualWorld(playerid, AMMO_MIR+n);
					SetPlayerInterior(playerid, 7);
					SetPlayerPos(playerid, 315.4647, -142.0953, 999.6016);
					SetPlayerFacingAngle(playerid, 19.0);
					SetCameraBehindPlayer(playerid);
					PlayerInInterior[playerid] = true;
					CurrentPlayerTime(playerid);
					break;
				}
				if(PlayerToPoint(playerid, 1.0, 315.81, -143.65, 999.60))
				{
					if(GetPlayerVirtualWorld(playerid) == AMMO_MIR+n)
					{
						SetPlayerPos(playerid, ammoexit[n][0], ammoexit[n][1], ammoexit[n][2]);
						SetPlayerVirtualWorld(playerid, 0);
						TogglePlayerControllable(playerid, false);
						PlayerFreezTime[playerid] = 2;
						SetPlayerInterior(playerid, 0);
						SetCameraBehindPlayer(playerid);
						PlayerInInterior[playerid] = false;
						CurrentPlayerTime(playerid);
						break;
					}
				}
			}
			////////////////////////////////////////////////////////////////////
			if(PlayerToPoint(playerid, 1.0, 1719.8695,-1650.6017,1001.9860))
			{
				ShowPlayerBusinessDialog(playerid);
				return true;
			}
			////////////////////////////////////////////////////////////////////
			for(new houseid=1; houseid<LastHouse+1; houseid++)
			{
				if(PlayerToPoint(playerid, 1.0, HouseInfo[houseid][hEnterX], HouseInfo[houseid][hEnterY], HouseInfo[houseid][hEnterZ]))
				{
					if(!strcmp(HouseInfo[houseid][hOwner], "None", true))
					{
						if(HouseInfo[houseid][hLevel] >= 99)
						{
							f(string, "\
{FFFF00}Название: {FFFFFF}%s\n\
{FFFF00}Стоимость: {FFFFFF}99 доната\n\
{FFFF00}Номер дома: {FFFFFF}%d\n\
{FFFF00}Район: {FFFFFF}%s",
							HouseInfo[houseid][hName], houseid, GetHouseZone(houseid));
							ShowDialog(playerid, HOUSE_ID+1, DIALOG_STYLE_MSGBOX, "Покупка дома", string, "Купить", "Отмена");
							GetDialogHouse[playerid] = houseid;
						}
						else
						{
							f(string, "\
{FFFF00}Название: {FFFFFF}%s\n\
{FFFF00}Стоимость: {FFFFFF}%d$\n\
{FFFF00}Уровень: {FFFFFF}%d\n\
{FFFF00}Номер дома: {FFFFFF}%d\n\
{FFFF00}Район: {FFFFFF}%s",
							HouseInfo[houseid][hName], HouseInfo[houseid][hCost], HouseInfo[houseid][hLevel], houseid, GetHouseZone(houseid));
							ShowDialog(playerid, HOUSE_ID+1, DIALOG_STYLE_MSGBOX, "Покупка дома", string, "Купить", "Отмена");
							GetDialogHouse[playerid] = houseid;
						}
						break;
					}
					else if(PlayerInfo[playerid][pHouse] == houseid || HouseOpen[houseid] || PlayerInfo[playerid][pMember] == PATRUL_ORG || PlayerInfo[playerid][pRent] == houseid)
					{
						SetPlayerHouseInterior(playerid, houseid);
						IsInPlayerHouse[playerid][houseid] = true;
						GetPlayerHouse[playerid] = houseid;
						PlayerInInterior[playerid] = true;
						CurrentPlayerTime(playerid);
						SetCameraBehindPlayer(playerid);
						if(PlayerInfo[playerid][pHouse] == houseid) SendClientMessage(playerid, COLOR_WHITE, "Чтобы посмотреть меню дома используй команду {9DDAF2}/house");
						if(HouseInfo[houseid][hHealth] == 1 && (PlayerInfo[playerid][pHouse] == houseid || PlayerInfo[playerid][pRent] == houseid)) SetPlayerHealthEx(playerid, 100);
						break;
					}
					else if(!HouseOpen[houseid])
					{
						f(string, "\
{FFFF00}Название: {FFFFFF}%s\n\
{FFFF00}Владелец: {FFFFFF}%s\n\
{FFFF00}Номер дома: {FFFFFF}%d\n\
{FFFF00}Район: {FFFFFF}%s",
						HouseInfo[houseid][hName], HouseInfo[houseid][hOwner], houseid, GetHouseZone(houseid));
						ShowDialog(playerid, 00000, DIALOG_STYLE_MSGBOX, "Информация о доме", string, "Закрыть", "");
						break;
					}
				}
			}
			////////////////////////////////////////////////////////////////////
			new houseid = GetPlayerHouse[playerid];
			new Float:INT[3];
			switch(HouseInfo[houseid][hInterior])
			{
			case 1: INT[0] = 2282.990, INT[1] = -1140.28, INT[2] = 1050.89;
			case 2: INT[0] = 2233.690, INT[1] = -1115.26, INT[2] = 1050.88;
			case 3: INT[0] = 2218.390, INT[1] = -1076.21, INT[2] = 1050.48;
			case 4: INT[0] = 2196.840, INT[1] = -1204.36, INT[2] = 1049.02;
			case 5: INT[0] = 2496.000, INT[1] = -1692.08, INT[2] = 1014.74;
			case 6: INT[0] = 2365.250, INT[1] = -1135.58, INT[2] = 1050.88;
			case 7: INT[0] = 2317.770, INT[1] = -1026.76, INT[2] = 1050.21;
			case 8: INT[0] = 2324.410, INT[1] = -1149.54, INT[2] = 1050.71;
			case 9: INT[0] = 140.2800, INT[1] = 1365.920, INT[2] = 1083.85;
			}
			if(PlayerToPoint(playerid, 1.0, INT[0], INT[1], INT[2]))
			{
				if(PlayerRobSafe[playerid][houseid]) PlayerRobSafe[playerid][houseid] = false;
				GetPlayerHouse[playerid] = -1;
				SetPlayerPos(playerid, HouseInfo[houseid][hSpawnX], HouseInfo[houseid][hSpawnY], HouseInfo[houseid][hSpawnZ]);
				SetPlayerFacingAngle(playerid, HouseInfo[houseid][hSpawnA]);
				SetPlayerInterior(playerid, 0);
				SetPlayerVirtualWorld(playerid, 0);
				IsInPlayerHouse[playerid][houseid] = false;
				PlayerInInterior[playerid] = false;
				CurrentPlayerTime(playerid);
				SetCameraBehindPlayer(playerid);
				return true;
			}
		}
	}
	return true;
}

public OnPlayerSpawn(playerid)
{
	new string[128];
	if(!PlayerLogged[playerid]) return true;
	SetPlayerVirtualWorld(playerid, 0);
 	if(PlayerInfo[playerid][pAdmin] >= 1 && AdminDuty[playerid] == 1)
    {Attach3DTextLabelToPlayer(AdminText3D[playerid],playerid,0.0,0.0,0.4);}
	SetPlayerInterior(playerid, 0);
	if(PlayerInfo[playerid][pAdmin] >= 1 && AdminDuty[playerid] == 1)
	{
		AdminText3D[playerid] = Create3DTextLabel("{00FF00}Администратор\n{0000FF}на дежурстве",COLOR_RED, 30.0, 40.0, 50.0, 40.0, 0);
		Attach3DTextLabelToPlayer(AdminText3D[playerid],playerid,0.0,0.0,0.4);
	}
	SetPlayerHealthEx(playerid, 100);
	StatusInfo[playerid][sSpawn] = 1;
	PlayerTied[playerid] = false;
	PlayerCuffed[playerid] = false;
	switch(PlayerInfo[playerid][pMember])
	{
	case REPORTER_ORG: SetPlayerColor(playerid, COLOR_YELLOW), GivePlayerWeaponEx(playerid, 43, 99999);
	case ARMY_ORG: SetPlayerColor(playerid, COLOR_GREEN);
	case MEDIC_ORG: SetPlayerColor(playerid, COLOR_RED);
	case HITMAN_ORG: SetPlayerColor(playerid, COLOR_WHITE);
	case ADVOKAT_ORG: SetPlayerColor(playerid, COLOR_WHITE);
	case PATRUL_ORG: SetPlayerColor(playerid, COLOR_WHITE);
	case TRANSPORT_ORG: SetPlayerColor(playerid, COLOR_AQUA);
	case MERIA_ORG:
		{
			SetPlayerColor(playerid, COLOR_PINK);
			if(PlayerInfo[playerid][pRank] == 1)
			{
				GivePlayerWeaponEx(playerid, 3);
				GivePlayerWeaponEx(playerid, 24);
			}
		}
	case GROOVE_GANG: SetPlayerColor(playerid, COLOR_PL_GROOVE), GivePlayerWeaponEx(playerid, 5);
	case BALLAS_GANG: SetPlayerColor(playerid, COLOR_PL_BALLAS), GivePlayerWeaponEx(playerid, 6);
	case VAGOS_GANG: SetPlayerColor(playerid, COLOR_PL_AZTECAS), GivePlayerWeaponEx(playerid, 5);
	case AZTECAS_GANG: SetPlayerColor(playerid, COLOR_PL_VAGOS), GivePlayerWeaponEx(playerid, 5);
	case RIFA_GANG: SetPlayerColor(playerid, COLOR_PL_RIFA), GivePlayerWeaponEx(playerid, 5);
	case NOSTRA_MAFIA: SetPlayerColor(playerid, COLOR_PL_NOSTRA);
	case YAKUZA_MAFIA: SetPlayerColor(playerid, COLOR_RED), GivePlayerWeaponEx(playerid, 8);
	case RUSSIAN_MAFIA: SetPlayerColor(playerid, COLOR_RED), GivePlayerWeaponEx(playerid, 1);
	default: SetPlayerColor(playerid, COLOR_WHITE);
	}
	SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
	if(!PlayerStarting[playerid])
	{
		LoadingPlayerAnimations(playerid);
		GivePlayerSavedWeapons(playerid);
		if(PlayerInfo[playerid][pBandana] != 0) SetPlayerBandana(playerid, PlayerInfo[playerid][pBandana]);
		if(PlayerInfo[playerid][pHat] != 0) SetPlayerHat(playerid, PlayerInfo[playerid][pHat]);
		CurrentPlayerTime(playerid);
	}
	if(PlayerInfo[playerid][pJailTime] == 99999)
	{
		if(PlayerInfo[playerid][pLevel] < 25) SetPlayerHealthEx(playerid, 45+PlayerInfo[playerid][pLevel]*5);
		else SetPlayerHealthEx(playerid, 50);
		SetPlayerPos(playerid, 611.1799,-583.9139,18.0174);
		SetPlayerFacingAngle(playerid, 90.0);
		PlayerInfo[playerid][pSitosti] = 100;
	    PlayerInfo[playerid][pJajda] = 100;
		PlayerInfo[playerid][pJailTime] = 0;
		return true;
	}
	else if(PlayerInfo[playerid][pJailTime] == 9999)
	{
		PlayerInfo[playerid][pJailTime] = GetPlayerWantedLevel(playerid)*300;
		SendClientMessage(playerid, COLOR_ORANGE, "Ты посажен в тюрьму за выход при аресте");
		PlayerInfo[playerid][pSitosti] = 100;
	    PlayerInfo[playerid][pJajda] = 100;
		return true;
	}
	else if(PlayerInfo[playerid][pJailTime] > 0)
	{
		JailTimer[playerid] = SetTimerEx("CountPlayerUnJail", 1000, true, "i", playerid);
		SpawnPlayerInJail(playerid);
		if(!DeathArrest[playerid]) SendClientMessage(playerid, COLOR_ORANGE, "Ты еще не досидел свой срок. Возвращайся в тюрьму");
		DeathArrest[playerid] = false;
		PlayerStarting[playerid] = true;
		return true;
	}
	if(!PlayerRegister[playerid])
	{
		if(!PlayerStarting[playerid])
		{
			PlayerStarting[playerid] = true;
				if(PlayerInfo[playerid][pSpawn] == 0) //SetPlayerPos(playerid, -89.8337,1228.2867,19.7422);
			{
				switch(random(2))
				{
					case 0:
					{
						SetPlayerPos(playerid, 663.4076,-450.2482,16.3359);
						SetPlayerFacingAngle(playerid, 180.0);
					}
					case 1:
					{
						SetPlayerPos(playerid, -2191.8196,-2258.6226,30.6682);
						SetPlayerFacingAngle(playerid, 180.0);
					}
				}
			}
			if(PlayerInfo[playerid][pSpawn] == 1)
			{
				SetPlayerHealthEx(playerid, PlayerInfo[playerid][pHealth]);
				new houseid;
				if(PlayerInfo[playerid][pHouse] != 0) houseid = PlayerInfo[playerid][pHouse];
				else houseid = PlayerInfo[playerid][pRent];
				IsInPlayerHouse[playerid][houseid] = true;
				GetPlayerHouse[playerid] = houseid;
				SetPlayerHouseInterior(playerid, houseid);
				PlayerInInterior[playerid] = true;
				CurrentPlayerTime(playerid);
				if(PlayerInfo[playerid][pHouse] != 0) SendClientMessage(playerid, COLOR_WHITE, "Чтобы посмотреть меню дома используй команду {9DDAF2}/house");
				if(HouseInfo[houseid][hHealth] == 1) SetPlayerHealthEx(playerid, 100);
			}
			if(PlayerInfo[playerid][pSpawn] == 2)
			{
				SetPlayerHealthEx(playerid, PlayerInfo[playerid][pHealth]);
				SetPlayerOrganizationSpawn(playerid);
			}
		}
		else
		{
			if(PlayerSavedPositions[playerid])
			{
				SetPlayerSavedPos(playerid);
				SetPlayerSavedCar(playerid);
			}
			if(!PlayerSavedPositions[playerid])
			{
				if(PlayerInfo[playerid][pSpawn] == 0)
				{
					if(PlayerInfo[playerid][pLevel] < 1) SetPlayerHealthEx(playerid, 45+PlayerInfo[playerid][pLevel]*5);
					else SetPlayerHealthEx(playerid, 20);
					SetPlayerPos(playerid, 1151.9868, -1332.1412, -0.8598);
					SetPlayerFacingAngle(playerid, 270.0);
					SetPlayerVirtualWorld(playerid, MEDD_MIR);
					if(GetPlayerMoneyEx(playerid) >= GetMedPrice)
					{
						f(string, "За спасение доктор взял с тебя {9DDAF2}%d$", GetMedPrice);
						new inform[2000];
						strcat(inform, "{FFFFFF}Вы попали в больницу\n\n");
						strcat(inform, "{00FF00}Вам нужно пройти курс лечения!\n");
						strcat(inform, "{00FF00}Вы можете обратиться к доктору\n");
						strcat(inform, "{00FF00}или воспользоваться койкой\n");
						ShowDialog(playerid, HELP_ID+39, DIALOG_STYLE_MSGBOX, "Василий", inform, "Принять", "");
						SendClientMessage(playerid, COLOR_WHITE, string);
						PlayerInfo[playerid][pSitosti] = 100;
						PlayerInfo[playerid][pJajda] = 100;
						GivePlayerMoneyEx(playerid, -GetMedPrice);
					}
					else
					{
						f(string, "За лечения доктор взял с тебя {9DDAF2}%d$", GetPlayerMoneyEx(playerid));
						new inform[2000];
						strcat(inform, "{FFFFFF}Вы попали в больницу\n\n");
						strcat(inform, "{00FF00}Вам нужно пройти курс лечения!\n");
						strcat(inform, "{00FF00}Вы можете обратиться к доктору\n");
						strcat(inform, "{00FF00}или воспользоваться койкой\n");
						ShowDialog(playerid, HELP_ID+39, DIALOG_STYLE_MSGBOX, "Василий", inform, "Принять", "");
						SendClientMessage(playerid, COLOR_WHITE, string);
						ResetPlayerMoneyEx(playerid);
					}
				}
    if(PlayerInfo[playerid][pSpawn] == 1)
				{
					if(PlayerInfo[playerid][pLevel] < 1) SetPlayerHealthEx(playerid, 45+PlayerInfo[playerid][pLevel]*5);
					else SetPlayerHealthEx(playerid, 20);
					SetPlayerPos(playerid, 1151.9868, -1332.1412, -0.8598);
					SetPlayerFacingAngle(playerid, 270.0);
					SetPlayerVirtualWorld(playerid, MEDD_MIR);
					if(GetPlayerMoneyEx(playerid) >= GetMedPrice)
					{
						f(string, "За спасение доктор взял с тебя {9DDAF2}%d$", GetMedPrice);
						new inform[2000];
						strcat(inform, "{FFFFFF}Вы попали в больницу\n\n");
						strcat(inform, "{00FF00}Вам нужно пройти курс лечения!\n");
						strcat(inform, "{00FF00}Вы можете обратиться к доктору\n");
						strcat(inform, "{00FF00}или воспользоваться койкой\n");
						ShowDialog(playerid, HELP_ID+39, DIALOG_STYLE_MSGBOX, "Василий", inform, "Принять", "");
						PlayerInfo[playerid][pSitosti] = 100;
						PlayerInfo[playerid][pJajda] = 100;
						SendClientMessage(playerid, COLOR_WHITE, string);
						GivePlayerMoneyEx(playerid, -GetMedPrice);
					}
					else
					{
						f(string, "За лечения доктор взял с тебя {9DDAF2}%d$", GetPlayerMoneyEx(playerid));
						new inform[2000];
						strcat(inform, "{FFFFFF}Вы попали в больницу\n\n");
						strcat(inform, "{00FF00}Вам нужно пройти курс лечения!\n");
						strcat(inform, "{00FF00}Вы можете обратиться к доктору\n");
						strcat(inform, "{00FF00}или воспользоваться койкой\n");
						ShowDialog(playerid, HELP_ID+39, DIALOG_STYLE_MSGBOX, "Василий", inform, "Принять", "");
						SendClientMessage(playerid, COLOR_WHITE, string);
						ResetPlayerMoneyEx(playerid);
					}
				}
				if(PlayerInfo[playerid][pSpawn] == 2)
				{
					if(PlayerInfo[playerid][pLevel] < 1) SetPlayerHealthEx(playerid, 45+PlayerInfo[playerid][pLevel]*5);
					else SetPlayerHealthEx(playerid, 20);
					SetPlayerPos(playerid, 1151.9868, -1332.1412, -0.8598);
					SetPlayerFacingAngle(playerid, 270.0);
					SetPlayerVirtualWorld(playerid, MEDD_MIR);
					if(GetPlayerMoneyEx(playerid) >= GetMedPrice)
					{
						f(string, "За спасение доктор взял с тебя {9DDAF2}%d$", GetMedPrice);
						new inform[2000];
						strcat(inform, "{FFFFFF}Вы попали в больницу\n\n");
						strcat(inform, "{00FF00}Вам нужно пройти курс лечения!\n");
						strcat(inform, "{00FF00}Вы можете обратиться к доктору\n");
						strcat(inform, "{00FF00}или воспользоваться койкой\n");
						ShowDialog(playerid, HELP_ID+39, DIALOG_STYLE_MSGBOX, "Василий", inform, "Принять", "");
						PlayerInfo[playerid][pSitosti] = 100;
						PlayerInfo[playerid][pJajda] = 100;
						GivePlayerMoneyEx(playerid, -GetMedPrice);
					}
					else
					{
						f(string, "За лечения доктор взял с тебя {9DDAF2}%d$", GetPlayerMoneyEx(playerid));
						new inform[2000];
						strcat(inform, "{FFFFFF}Вы попали в больницу\n\n");
						strcat(inform, "{00FF00}Вам нужно пройти курс лечения!\n");
						strcat(inform, "{00FF00}Вы можете обратиться к доктору\n");
						strcat(inform, "{00FF00}или воспользоваться койкой\n");
						ShowDialog(playerid, HELP_ID+39, DIALOG_STYLE_MSGBOX, "Василий", inform, "Принять", "");
						SendClientMessage(playerid, COLOR_WHITE, string);
						ResetPlayerMoneyEx(playerid);
					}
				}
			}
			else
			{
				PlayerSavedPositions[playerid] = false;
			}
		}
	}
	else
	{
		PlayerStarting[playerid] = true;
 	if(PlayerInfo[playerid][pSpawn] == 0) //SetPlayerPos(playerid, -89.8337,1228.2867,19.7422);
			{
       switch(random(2))
				{
					case 0:
					{
						SetPlayerPos(playerid, 663.4076,-450.2482,16.3359);
						SetPlayerFacingAngle(playerid, 180.0);
					}
					case 1:
					{
						SetPlayerPos(playerid, -2191.8196,-2258.6226,30.6682);
						SetPlayerFacingAngle(playerid, 180.0);
					}
				}
			}
		SetPlayerFacingAngle(playerid, 0.0);
		ShowDialog(playerid, 00000, DIALOG_STYLE_MSGBOX, "Информация", "{FFFF00}\
 	  С удачным приездом в Red Country!\n\n\
		{AEE800}Чтобы легче ориентироваться в посёлках используйте gps {00FF00}[/gps]\n\
		{AEE800}На ферме вы сможете начать свою карьеру , прокачать умение и устроится в престижную организацию [/fskill]\n\
		{AEE800} Если у вас возникнут трудности,используй команду {00FF00}[/help]\n\
		{FFFFFF}Для связи с администраццией: [/report]\n\
		", "Закрыть", "");
		SetPlayerHealthEx(playerid, 100);
		PlayerRegister[playerid] = false;
	}
	SetCameraBehindPlayer(playerid);
	sitosti[playerid] = CreateProgressBar(playerid,500.00, 103.00, 104.50, 1.50, 771686655, 100.0);
	SetProgressBarValue(playerid, sitosti[playerid], PlayerInfo[playerid][pSitosti]);
	UpdateProgressBar(sitosti[playerid], playerid);
	
	Voda[playerid] = CreateProgressBar(playerid,500.00, 110.00, 104.50, 1.50, 3407871, 100.0);
	SetProgressBarValue(playerid, Voda[playerid], PlayerInfo[playerid][pJajda]);
	UpdateProgressBar(Voda[playerid], playerid);
	
	Nyzda[playerid] = CreateProgressBar(playerid,500.00, 117.00, 104.50, 1.50, -8060673, 100.0);
	SetProgressBarValue(playerid, Nyzda[playerid], PlayerInfo[playerid][pJajda]);
	UpdateProgressBar(Nyzda[playerid], playerid);
	
	return true;
}

public OnPlayerDeath(playerid, killerid, reason)
{
	new string[256];
	RemovePlayerAllWeaponEx(playerid);
	DisablePlayerRaceCheckpoint(playerid);
	TextDrawHideForPlayer(playerid, DrawHealth[playerid]);
	TextDrawHideForPlayer(playerid, DrawFuel[playerid]);
	TextDrawHideForPlayer(playerid, DrawVehicle[playerid]);
	TextDrawHideForPlayer(playerid, DrawSpeed[playerid]);
	TextDrawHideForPlayer(playerid, DrawEngine[playerid]);
	StatusInfo[playerid][sSpawn] = 0;
	PlayerInShamal[playerid] = INVALID_VEHICLE_ID;
	SetPlayerStreetWorld(playerid, false);
	EndPlayerCasualJob(playerid);
	if(PlayerConvoi[playerid])
	{
		GetPlayerConvoi[playerid] = INVALID_PLAYER_ID;
		SendClientMessage(GetPlayerConvoi[playerid], COLOR_AQUA, "Арестованный погиб. Конвой прекращён");
		PlayerConvoi[playerid] = false;
		TogglePlayerControllable(playerid, true);
		DeleteAnimation(playerid);
	}
	if(PlayerLoopingAnim[playerid]) PlayerLoopingAnim[playerid] = false;
	if(GetPlayerCalled[playerid] != INVALID_PLAYER_ID && GetPlayerCalled[playerid] != 911)
	{
		new giveplayerid = GetPlayerCalled[playerid];
		PlayerCalled[giveplayerid] = false;
		PlayerCalledEx[giveplayerid] = false;
		PlayerCalled[playerid] = false;
		PlayerCalledEx[playerid] = false;
		GetPlayerCalled[giveplayerid] = INVALID_PLAYER_ID;
		GetPlayerCalled[playerid] = INVALID_PLAYER_ID;
		f(string, "Разговор с игроком {9DDAF2}%s{FFFFFF} оборвался.", PlayerNameEx[giveplayerid]);
		SendClientMessage(playerid, COLOR_WHITE, string);
		f(string, "Разговор с игроком {9DDAF2}%s{FFFFFF} оборвался.", PlayerNameEx[playerid]);
		SendClientMessage(giveplayerid, COLOR_WHITE, string);
		PlayerUsePhone(playerid, false);
		PlayerUsePhone(giveplayerid, false);
		PlayerCallMode[playerid] = 0;
		PlayerCallMode[giveplayerid] = 0;
	}
	if(PlayerKarting[playerid] && PlayerInKart[playerid])
	{
		KartingPlayers -= 1;
		PlayerKarting[playerid] = false;
		PlayerInKart[playerid] = false;
	}
	if(PlayerInDuel[killerid] && PlayerInDuel[playerid])
	{
		PlayerInDuel[playerid] = false;
		PlayerInDuel[killerid] = false;
		GivePlayerMoneyEx(killerid, GetPriceOnDuel[killerid]);
		GivePlayerMoneyEx(playerid, -GetPriceOnDuel[killerid]);
		GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~YOU LOSE", 3000, 3);
		GameTextForPlayer(killerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~YOU WIN", 3000, 3);
		GetPlayerDuel[playerid] = INVALID_PLAYER_ID;
		GetPlayerDuel[killerid] = INVALID_PLAYER_ID;
		return true;
	}
	PlayerInfo[killerid][pKills] += 1;
	PlayerInfo[playerid][pDeath] += 1;
	OldDeath[playerid] += 1;
	if(OldDeath[playerid] > 5)
	{
		SendClientMessage(playerid, COLOR_RED, "Ты кикнут за использование fake-death");
		return Kick(playerid);
	}
	SetupPlayerWeaponSkill(killerid, reason);
	if(PlayerChanger[killerid])
	{
		PlayerChangerSkin[killerid] = GetPlayerSkin(playerid);
		SetTimerEx("OnPlayerChangerSkin", 1000, false, "i", killerid);
	}
	if(IsPlayersFromPlayer(killerid, playerid, false)) SetPlayerCriminal(killerid, 1, "убийство");
	return true;
}

public OnRconLoginAttempt(ip[], password[], success)
{
	new getip[32],string[128];
	if(!success)
	{
		for(new i=0; i<GetMaxPlayers(); i++)
		{
			GetPlayerIp(i, getip, sizeof(getip));
			if(!strcmp(ip, getip, true))
			{
				f(string, "Игрок {DB8484}%s{FF0000} был кикнут за попытку взлома rcon-пароля", PlayerNameEx[i]);
				SendAdminMessage(COLOR_RED, string);
				SendClientMessage(i, COLOR_RED, "Ты был кикнут за попытку взлома rcon-пароля");
				Kick(i);
				break;
			}
		}
	}
	return true;
}

