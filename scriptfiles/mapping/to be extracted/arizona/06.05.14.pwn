				f(string, "[ рация ] преступление: выращивание наркотиков | преступник: {FAA039}%s | сообщил: {FAA039}Неизвестный", PlayerNameEx[playerid]);
				SendFamilyMessage(PATRUL_ORG, 0xFF8800FF, string);
				f(string, "Ты совершил преступление: выращивание наркотиков", PlayerNameEx[playerid]);
				SendClientMessage(playerid, COLOR_YELLOW, string);
				if(PlayerInfo[playerid][pZakon]-1 >= 0) PlayerInfo[playerid][pZakon] -= 1;
				else PlayerInfo[playerid][pZakon] = 0;
				if(GetPlayerWantedLevel(playerid) < 6) SetPlayerWantedLevel(playerid, GetPlayerWantedLevel(playerid)+0);
				return true;
			}
			if(IsFishPlace(playerid))
			{
				if(PlayerInfo[playerid][pRod] <= 0) return SendClientMessage(playerid, COLOR_GREEN, "У тебя нет удочки");
				if(PlayerInfo[playerid][pFish] >= 30) return SendClientMessage(playerid, COLOR_GREEN, "У тебя уже есть максимальное количество рыбы");
				if(PlayerInfo[playerid][pBait] <= 0) return SendClientMessage(playerid, COLOR_GREEN, "У тебя нет приманки");
				if(PlayerInfo[playerid][pLicFish] == 0 && IsPlayersFromPlayer(playerid, playerid, false)) SetPlayerCriminal(playerid, 1, "рыбалка без лицензии");
				SetTimerEx("PlayerEndFisher", 10000+random(10000), false, "i", playerid);
				SendClientMessage(playerid, COLOR_WHITE, "Ты забросил удочку. Подожди некоторое время...");
				TogglePlayerControllable(playerid, false);
				PlayerUsePickup[playerid] = true;
				ToggleAnimation(playerid, "SWORD", "sword_block");
				return true;
			}
			if(IsGoldPlace(playerid))
			{
				if(PlayerInfo[playerid][pLop] <= 0) return SendClientMessage(playerid, COLOR_GREEN, "У тебя нет совка, купи его в магазине");
				if(PlayerInfo[playerid][pGold] >= 100) return SendClientMessage(playerid, COLOR_GREEN, "У тебя уже есть максимальное золото");
				if(PlayerInfo[playerid][pLicGold] == 0 && IsPlayersFromPlayer(playerid, playerid, false)) SetPlayerCriminal(playerid, 1, "добыча золота без лицензии");
				SetTimerEx("PlayerEndGolder", 10000+random(10000), false, "i", playerid);
				SendClientMessage(playerid, COLOR_WHITE, "Ты что-то ищишь. Подожди некоторое время...");
				TogglePlayerControllable(playerid, false);
