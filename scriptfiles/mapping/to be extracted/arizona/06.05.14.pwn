	else if(!strcmp(cmd, "/ramsafe", true))
	{
		if(GetOrganizationType(PlayerInfo[playerid][pMember]) != 2 && GetOrganizationType(PlayerInfo[playerid][pMember]) != 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты не состоишь в какой-либо банде или мафии");
		if(PlayerInfo[playerid][pRank] < 2) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть второго ранга, чтобы взламывать дверь дома");
		if(GetPlayerHouse[playerid] == -1) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находешься в каком-либо доме");
		if(HouseInfo[GetPlayerHouse[playerid]][hSave] == 0) return SendClientMessage(playerid, COLOR_GREEN, "В этом доме нет сейфа");
		if(PlayerInfo[playerid][pHouse] == GetPlayerHouse[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Ты не можешь взломать сейф своего дома");
		if(PlayerRobSafe[playerid][GetPlayerHouse[playerid]]) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже взламывал сейф этого дома");
		SetTimerEx("OnPlayerRobSafe", 10000+random(10000), false, "ii", playerid, GetPlayerHouse[playerid]);
		SetPlayerChatBubble(playerid, "Взламывает сейф", COLOR_AQUA, 30.0, 5000);
		SendClientMessage(playerid, COLOR_WHITE, "Взлом сейфа этого дома начался...");
		TogglePlayerControllable(playerid, false);
		return true;
	}

	else if(!strcmp(cmd, "/ram", true))
	{
		if(GetOrganizationType(PlayerInfo[playerid][pMember]) != 2 && GetOrganizationType(PlayerInfo[playerid][pMember]) != 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты не состоишь в какой-либо банде или мафии");
		if(PlayerInfo[playerid][pRank] < 2) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть второго ранга, чтобы взламывать дверь дома");
		if(RobHouseTime[playerid] != 0) return SendClientMessage(playerid, COLOR_GREEN, "Нельзя слишком часто пытаться взламывать дома");
		new bool:nothouse = true;
		for(new houseid=1; houseid<LastHouse+1; houseid++)
		{
			if(PlayerToPoint(playerid, 1.0, HouseInfo[houseid][hEnterX], HouseInfo[houseid][hEnterY], HouseInfo[houseid][hEnterZ]))
			{
				nothouse = false;
				if(PlayerInfo[playerid][pHouse] == houseid) return SendClientMessage(playerid, COLOR_GREEN, "Ты не можешь взломать дверь своего дома");
				if(!strcmp(HouseInfo[houseid][hOwner], "None", true)) return SendClientMessage(playerid, COLOR_GREEN, "В этом доме никто не проживает");
				RobHouseTime[playerid] = 300;
				if(IsPlayersFromPlayer(playerid, PlayerInfo[playerid][pMember], true)) SetPlayerCriminal(playerid, 1, "ограбление дома");
				SetTimerEx("OnPlayerRobHouse", 5000+random(10000), false, "ii", playerid, houseid);
				SetPlayerChatBubble(playerid, "Взламывает дверь", COLOR_AQUA, 30.0, 5000);
				SendClientMessage(playerid, COLOR_WHITE, "Взлом двери этого дома начался...");
				TogglePlayerControllable(playerid, false);
				break;
			}
		}
		if(nothouse) SendClientMessage(playerid, COLOR_GREEN, "Ты не находешься возле двери дома");
		return true;
	}

	else if(!strcmp(cmd, "/licenses", true) || !strcmp(cmd, "/lic", true))
	{
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "На время пребывания в тюрьме, твои лицензии были изъяты");
		new stats[128],fish_text[64],fly_text[64],car_text[64],gun_text[64],boat_text[64],gold_text[64];
		if(PlayerInfo[playerid][pLicFly] == 0) fly_text = "Не имеется";
		else fly_text = "Имеется";
		if(PlayerInfo[playerid][pLicCar] == 0) car_text = "Не имеется";
		else car_text = "Имеется";
		if(PlayerInfo[playerid][pLicGun] == 0) gun_text = "Не имеется";
		else gun_text = "Имеется";
		if(PlayerInfo[playerid][pLicBoat] == 0) boat_text = "Не имеется";
		else boat_text = "Имеется";
		if(PlayerInfo[playerid][pLicFish] == 0) fish_text = "Не имеется";
		else fish_text = "Имеется";
		if(PlayerInfo[playerid][pLicGold] == 0) gold_text = "Не имеется";
		else gold_text = "Имеется";
		f(stats, "{9DDAF2}Добыча золотo: {FFFFFF}%s\n", gold_text); strcat(string, stats);
		f(stats, "{9DDAF2}Рыбалка: {FFFFFF}%s\n", fish_text); strcat(string, stats);
		f(stats, "{9DDAF2}Оружие: {FFFFFF}%s\n", gun_text); strcat(string, stats);
		f(stats, "{9DDAF2}Лётный тс: {FFFFFF}%s\n", fly_text); strcat(string, stats);
		f(stats, "{9DDAF2}Водный тс: {FFFFFF}%s\n", boat_text); strcat(string, stats);
		f(stats, "{9DDAF2}Права: {FFFFFF}%s", car_text); strcat(string, stats);
		ShowDialog(playerid, 00000, DIALOG_STYLE_MSGBOX, "Просмотр лицензий", string, "Закрыть", "");
		return true;
	}

