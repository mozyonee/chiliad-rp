			if(amount > PlayerInfo[playerid][pBalance]) return ShowDialog(playerid, BANK_ID+2, DIALOG_STYLE_INPUT, "Меню банка", "\
Введи сумму которую ты хочешь снять с банковского счёта:\n\
{FF0000}У тебя нет такой суммы на банковском счёту!\
", "Ок", "Назад");
			if(amount < 1) return ShowDialog(playerid, BANK_ID+2, DIALOG_STYLE_INPUT, "Меню банка", "\
Введи сумму которую ты хочешь снять с банковского счёта:\n\
{FF0000}Ты указал не верную сумму!\
", "Ок", "Назад");
			GivePlayerMoneyEx(playerid, amount);
			PlayerInfo[playerid][pBalance] -= amount;
			f(string, "Ты успешно снял со счёта {9DDAF2}%d$", amount);
			SendClientMessage(playerid, COLOR_WHITE, string);
			ShowPlayerBankDialog(playerid);
		}
		else
		{
			ShowPlayerBankDialog(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(dialogid == BANK_ID+3)
	{
		if(response)
		{
			GetPlayerTransfer[playerid] = strval(inputtext);
			if(GetPlayerTransfer[playerid] == PlayerInfo[playerid][pBankKart]) return ShowDialog(playerid, BANK_ID+3, DIALOG_STYLE_INPUT, "Меню банка", "\
Введи лицевой счёт игрока, которому ты хочешь перевести деньги:\n\
{FF0000}Ты не можешь применить это действие к самому себе!\
", "Ок", "Назад");
			f(string, "bank/%d.ini", GetPlayerTransfer[playerid]);
			if(!fexist(string)) return ShowDialog(playerid, BANK_ID+3, DIALOG_STYLE_INPUT, "Меню банка", "\
Введи лицевой счёт игрока, которому ты хочешь перевести деньги:\n\
{FF0000}Ты ввёл не существующий лицевой счёт!\
", "Ок", "Назад");
			f(string, "\
Введи сумму которую ты хочешь перевести на счёт: %d\
", GetPlayerTransfer[playerid]);
			ShowDialog(playerid, BANK_ID+4, DIALOG_STYLE_INPUT, "Меню банка", string, "Ок", "Назад");
		}
		else
		{
			ShowPlayerBankDialog(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(dialogid == BANK_ID+4)
	{
		if(response)
		{
			new amount = strval(inputtext);
			new giverid = GetPlayerTransfer[playerid];
			if(PlayerInfo[playerid][pBalance] < amount)
			{
				f(string, "\
Введи сумму которую ты хочешь перевести на счёт: %d\n\
{FF0000}У тебя нет такой суммы на банковском счёту!\
", giverid);
				ShowDialog(playerid, BANK_ID+4, DIALOG_STYLE_INPUT, "Меню банка", string, "Ок", "Назад");
				return true;
			}
			if(amount < 1)
			{
				f(string, "\
Введи сумму которую ты хочешь перевести на счёт: %d\n\
{FF0000}Ты указал не верную сумму!\
", giverid);
				ShowDialog(playerid, BANK_ID+4, DIALOG_STYLE_INPUT, "Меню банка", string, "Ок", "Назад");
				return true;
			}
			new bool:offline = true;
			for(new i; i<GetMaxPlayers(); i++)
			{
				if(IsPlayerConnected(i) && PlayerInfo[i][pBankKart] == giverid)
				{
					offline = false;
					PlayerInfo[i][pBalance] += amount;
					break;
				}
			}
			if(offline)
			{
				f(string, "bank/%d.ini", giverid);
				new oldbalance;
				new GetFile = ini_openFile(string);
				ini_getInteger(GetFile, "BALANCE", oldbalance);
				ini_setInteger(GetFile, "BALANCE", oldbalance+amount);
				ini_closeFile(GetFile);
			}
			PlayerInfo[playerid][pBalance] -= amount;
			f(string, "Ты первёл на банковский счёт {9DDAF2}%d {FFFFFF}сумму в размере {9DDAF2}%d$", giverid, amount);
			SendClientMessage(playerid, COLOR_WHITE, string);
			GetPlayerTransfer[playerid] = INVALID_PLAYER_ID;
			ShowPlayerBankDialog(playerid);
		}
		else
		{
			ShowDialog(playerid, BANK_ID+3, DIALOG_STYLE_INPUT, "Меню банка", "\
Введи id игрока, которому ты хочешь перевести деньги:\
", "Ок", "Назад");
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(dialogid == BANK_ID+5)
	{
		if(response)
		{
			ShowPlayerBankDialog(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------


	else if(dialogid == BANK_ID+6)
	{
		if(response)
		{
			if(strlen(inputtext) != 6 && strlen(inputtext) != 0) return ShowDialog(playerid, BANK_ID+6, DIALOG_STYLE_INPUT, "Смена PIN-кода", "\
			{39DE0B}Введи новый PIN-код:\n\n\
			{FFFFFF}Примечания:\n\
			- Длина PIN-кода должна быть ровно 6 цифр.\n\
			- PIN-код должен состоять только из цифр.\n\n\
	 		Если ты хочешь снять PIN-код, то\n\
	 		используй его значения равное нулю.\n\
	 		{FF0000}Введён не корректный PIN-код!\
			", "Ок", "Назад");
			if(strlen(inputtext) != 0)
			{
				f(string, "Ты обновил PIN-код от банковского счёта. Новый PIN-код: {9DDAF2}%d", strval(inputtext));
				SendClientMessage(playerid, COLOR_WHITE, string);
			}
			else
			{
				SendClientMessage(playerid, COLOR_WHITE, "Ты снял PIN-код от банковского счёта");
			}
			PlayerInfo[playerid][pBankPass] = strval(inputtext);
		}
		else
		{
			ShowPlayerBankDialog(playerid);
		}
		return 1;
	}



	//------------------------------------------------------------------------------

	else if(dialogid == BANK_ID+88)
	{
	    if(response)
