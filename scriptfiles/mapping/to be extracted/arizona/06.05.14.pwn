	for(new i=0; i<MAX_VEHICLES; i++)
	{
		if(IsArenaBike(i))
		{
			LinkVehicleToInterior(i, 14);
			SetVehicleVirtualWorld(i, MOTO_MIR);
		}
		SetVehicleNumber(i);
		SetVehicleToRespawn(i);
		SetTimerEx("ReductionVehicleFuel", 20000, true, "i", i);
		SetTimerEx("GetOldVehicleHealth", 500, true, "i", i);
	}
