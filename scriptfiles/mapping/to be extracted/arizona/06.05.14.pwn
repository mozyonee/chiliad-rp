	else if(!strcmp(cmd, "/towcar", true))
	{
		if(PlayerInfo[playerid][pJob] != MECHANIC_JOB) return SendClientMessage(playerid, COLOR_GREEN, "Ты не устроился на работу автомеханика");
		new vehicle = GetPlayerVehicleID(playerid);
		if(GetPlayerState(playerid) != PLAYER_STATE_DRIVER || !IsTowCar(vehicle)) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен находиться в буксире и быть за рулём");
		new Float:pPOS[2][3],getveh = INVALID_VEHICLE_ID;
		GetVehiclePos(vehicle, pPOS[0][0], pPOS[0][1], pPOS[0][2]);
		for(new i=0; i<MAX_VEHICLES; i++)
		{
			GetVehiclePos(i, pPOS[1][0], pPOS[1][1], pPOS[1][2]);
			if(floatabs(pPOS[0][0]-pPOS[1][0]) < 7.5 && floatabs(pPOS[0][1]-pPOS[1][1]) < 7.5 && floatabs(pPOS[0][2]-pPOS[1][2]) < 7.5 && i != vehicle)
			{
				getveh = i;
				if(IsTrailerAttachedToVehicle(vehicle)) DetachTrailerFromVehicle(vehicle);
				else AttachTrailerToVehicle(getveh, vehicle);
				break;
			}
		}
		if(getveh == INVALID_VEHICLE_ID) SendClientMessage(playerid, COLOR_GREEN, "Рядом с тобой нет машины, которую можно подцепить");
		return true;
	}

