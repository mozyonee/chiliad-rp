		if(strcmp(PlayerName[playerid], "Max_Brown", false)) f(string, "{00FF00}[ ответ для id: %d ] {FFFFFF}%s: %s", giveplayerid, PlayerNameEx[playerid], result);
		else f(string, "[ {00FF00}ответ для id: %d ] {FFFFFF}: %s", giveplayerid, result);
