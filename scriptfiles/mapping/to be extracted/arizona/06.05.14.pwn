stock GetPlayerSavedCar(playerid)
{
	if(IsPlayerInAnyVehicle(playerid))
	{
		OldPlayerVehicle[playerid] = GetPlayerVehicleID(playerid);
		OldPlayerSeat[playerid] = GetPlayerVehicleSeat(playerid);
	}
	return true;
}

stock SetPlayerSavedCar(playerid)
{
	if(OldPlayerVehicle[playerid] != INVALID_VEHICLE_ID)
	{
		PutPlayerInVehicle(playerid, OldPlayerVehicle[playerid], OldPlayerSeat[playerid]);
		OldPlayerVehicle[playerid] = INVALID_VEHICLE_ID;
	}
	return true;
}

stock GetPlayerSavedPos(playerid)
{
	GetPlayerPos(playerid, PlayerInfo[playerid][pPosX], PlayerInfo[playerid][pPosY], PlayerInfo[playerid][pPosZ]);
	GetPlayerFacingAngle(playerid, PlayerInfo[playerid][pPosA]);
	PlayerInfo[playerid][pMir] = GetPlayerVirtualWorld(playerid);
	PlayerInfo[playerid][pInt] = GetPlayerInterior(playerid);
	GetPlayerHealth(playerid, PlayerInfo[playerid][pHealth]);
	GetPlayerArmour(playerid, PlayerInfo[playerid][pArmour]);
	return true;
}

stock SetPlayerSavedPos(playerid)
{
	SetPlayerPos(playerid, PlayerInfo[playerid][pPosX], PlayerInfo[playerid][pPosY], PlayerInfo[playerid][pPosZ]);
	SetPlayerFacingAngle(playerid, PlayerInfo[playerid][pPosA]);
	SetPlayerVirtualWorld(playerid, PlayerInfo[playerid][pMir]);
	SetPlayerInterior(playerid, PlayerInfo[playerid][pInt]);
	SetPlayerHealthEx(playerid, PlayerInfo[playerid][pHealth]);
	SetPlayerArmourEx(playerid, PlayerInfo[playerid][pArmour]);
	return true;
}

stock CreatePickupEx(model, Float:x, Float:y, Float:z, string[] = "[none]", mir = -1)
{
	CreateDynamicPickup(model, 23, x, y, z, mir);
	if(strcmp(string, "[none]", false))
	{
		if(model == 1239) CreateDynamic3DTextLabel(string, COLOR_3DTEXT, x, y, z+0.6, 60.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, mir);
		else CreateDynamic3DTextLabel(string, COLOR_3DTEXT, x, y, z+0.8, 60.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 1, mir);
	}
	return true;
}

stock CurrentPlayerTime(playerid)
{
	if(!PlayerInInterior[playerid])
	{
		if(RealTime)
		{
			new hours, minutes, seconds;
			gettime(hours, minutes, seconds);
			SetPlayerTime(playerid, hours, minutes);
		}
		else
		{
			SetPlayerTime(playerid, GeneralTime, 0);
		}
	}
	else
	{
		SetPlayerTime(playerid, 13, 0);
	}
	return true;
}

stock IsPlayerAreaJob(playerid)
{
	new job = PlayerInfo[playerid][pJob]+1;
	if(!PlayerToPoint(playerid, 80.0, gJobInfo[job][JOB_POS][0], gJobInfo[job][JOB_POS][1], gJobInfo[job][JOB_POS][2])) return true;
	return false;
}

stock IsRpNick(const plname[])
{
	for(new i=0; i<strlen(plname); i++) if(!((plname[i] >= 'a' && plname[i] <= 'z') || (plname[i] >= 'A' && plname[i] <= 'Z') || plname[i] == '_')) return false;
	new d = strfind(plname, "_");
	if(d == -1) return false;
	if(strfind(plname, "_", false, d+1) != -1) return false;
	new name[10],surname[10];
	strmid(name, plname, 0, d, sizeof(name));
	strmid(surname, plname, d+1, strlen(plname), sizeof(surname));
	if((strlen(name) < 3 || strlen(name) > 9) || (strlen(surname) < 3 || strlen(surname) > 9) || (!(name[0] >= 'A' && name[0] <= 'Z')) || (!(surname[0] >= 'A' && surname[0] <= 'Z'))) return false;
	for(new i=1; i<strlen(name); i++) if(!(name[i] >= 'a' && name[i] <= 'z')) return false;
	for(new i=1; i<strlen(surname); i++) if(!(surname[i] >= 'a' && surname[i] <= 'z')) return false;
	return true;
}

stock IsMushroom(playerid)
{
	for(new i=0; i<MAX_MUSHROOM; i++)
	{
		if(PlayerToPoint(playerid, 1.0, gGribPoint[i][0], gGribPoint[i][1], gGribPoint[i][2]) && GRIB[i] != -1 && PlayerOnGrib[playerid] != i)
		{
			PlayerOnGrib[playerid] = i;
			break;
		}
		else PlayerOnGrib[playerid] = -1;
	}
	if(PlayerOnGrib[playerid] != -1) return true;
	return false;
}

stock IsBankomat(playerid)
{
	for(new i=0; i<MAX_ATMBANK; i++) if(PlayerToPoint(playerid, 1.0, gAtmPoint[i][0], gAtmPoint[i][1], gAtmPoint[i][2])) return true;
	return false;
}

stock IsEatery(playerid)
{
	if((GetPlayerVirtualWorld(playerid) >= CHCK_MIR && GetPlayerVirtualWorld(playerid) < CHCK_MIR+MAX_CHICKEN)
			|| (GetPlayerVirtualWorld(playerid) >= PIZZ_MIR && GetPlayerVirtualWorld(playerid) < PIZZ_MIR+MAX_PIZZA)
			|| (GetPlayerVirtualWorld(playerid) >= BURG_MIR && GetPlayerVirtualWorld(playerid) < BURG_MIR+MAX_BURGER)) return true;
	return false;
}

