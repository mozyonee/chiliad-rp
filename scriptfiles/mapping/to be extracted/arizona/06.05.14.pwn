		else PromoteBusiness(RUSTY_BIZZ, 80+random(40), 100+random(50));
		switch(random(6))
		{
		case 0,1:
			{
				new randx = random(sizeof(burgerenter));
				if(CheckpointPizza[0][playerid] == randx)
				{
					if(randx > 0) randx = randx-1;
					else randx = randx+1;
				}
				SetPlayerCheckpointEx(playerid, burgerenter[randx][0], burgerenter[randx][1], burgerenter[randx][2], CHECKPOINT_VEHICLE);
				CheckpointPizza[0][playerid] = randx;
			}
		case 2,3:
			{
				new randx = random(sizeof(chickenenter));
				if(CheckpointPizza[1][playerid] == randx)
				{
					if(randx > 0) randx = randx-1;
					else randx = randx+1;
				}
				SetPlayerCheckpointEx(playerid, chickenenter[randx][0], chickenenter[randx][1], chickenenter[randx][2], CHECKPOINT_VEHICLE);
				CheckpointPizza[1][playerid] = randx;
			}
		case 4,5:
			{
				new randx = random(sizeof(pizzaenter));
				if(CheckpointPizza[2][playerid] == randx)
				{
					if(randx > 0) randx = randx-1;
					else randx = randx+1;
