stock IsPlayersFromPlayer(playerid, key, bool:mode)
{
	new Float:POS[3];
	GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
	if(PlayerMasked[playerid]) return false;
	if(mode)
	{
		for(new i=0; i<GetMaxPlayers(); i++) if(IsPlayerConnected(i) && PlayerToPoint(i, 30, POS[0], POS[1], POS[2]) && PlayerInfo[i][pMember] != key && i != playerid) return true;
	}
	else
	{
		for(new i=0; i<GetMaxPlayers(); i++) if(IsPlayerConnected(i) && PlayerToPoint(i, 30, POS[0], POS[1], POS[2]) && i != key && i != playerid) return true;
	}
	return false;
}

stock EnableJobCheckpoint(playerid)
{
	new bool:status;
	for(new i=0; i<MAX_JOBS; i++)
	{
		if(Checkpoint[i][playerid] != 0)
		{
			status = true;
			break;
		}
	}
	if(status) return true;
	return false;
}

stock ClearDialog(playerid)
{
	ShowPlayerDialog(playerid, 00000, 0, "", "", "", "");
	return true;
}

stock settext(string[], const text[])
{
	strmid(string, text, 0, strlen(text), 255);
	return true;
}

stock strrest(const string[], &index)
{
	new length = strlen(string);
	while((index < length) && (string[index] <= ' ')) index += 1;
	new offset = index;
	new result[128];
	while((index < length) && ((index-offset) < (sizeof(result)-1))) result[index - offset] = string[index], index += 1;
	result[index-offset] = EOS;
	return result;
}

stock strtok(const string[], &index)
{
	new length = strlen(string);
	while((index < length) && (string[index] <= ' ')) index += 1;
	new offset = index;
	new result[20];
	while((index < length) && (string[index] > ' ') && ((index-offset) < (sizeof(result)-1))) result[index - offset] = string[index], index += 1;
	result[index-offset] = EOS;
	return result;
}

stock SetPlayerHealthEx(playerid, Float:health)
{
	PlayerInfo[playerid][pHealth] = health;
	SetPlayerHealth(playerid, health);
	return true;
}

stock SetPlayerArmourEx(playerid, Float:armour)
{
	PlayerInfo[playerid][pArmour] = armour;
	SetPlayerArmour(playerid, armour);
	return true;
}

stock ResetPlayerMoneyEx(playerid)
{
	PlayerInfo[playerid][pMoney] = 0;
	return true;
}

stock GetPlayerMoneyEx(playerid)
{
	return PlayerInfo[playerid][pMoney];
}

stock SetPlayerMoneyEx(playerid, money)
{
	PlayerInfo[playerid][pMoney] = money;
	return true;
}

stock GivePlayerMoneyEx(playerid, money)
{
	new string[32];
	if(money > 0) f(string, "~g~+%d$", money);
	else if(money < 0) f(string, "~r~%d$", money);
	GameTextForPlayer(playerid, string, 1000, 1);
	PlayerInfo[playerid][pMoney] += money;
	return true;
}

stock GivePlayerWeaponEx(playerid, weaponid, ammo = -1)
{
	GetPlayerWeaponEx[playerid][weaponid] = true;
	if(ammo != -1) return GivePlayerWeapon(playerid, weaponid, ammo);
	switch(weaponid)
	{
	case 22,23: GivePlayerWeapon(playerid, weaponid, 200);
	case 24,25: GivePlayerWeapon(playerid, weaponid, 50);
	case 28,29: GivePlayerWeapon(playerid, weaponid, 350);
	case 30,31: GivePlayerWeapon(playerid, weaponid, 300);
	case 34: GivePlayerWeapon(playerid, weaponid, 30);
	case 41,42: GivePlayerWeapon(playerid, weaponid, 500);
	case 43: GivePlayerWeapon(playerid, weaponid, 100);
	case 1..15,46: GivePlayerWeapon(playerid, weaponid, 1);
	}
	return true;
}

stock RemovePlayerAllWeaponEx(playerid)
{
	for(new i=0; i<47; i++) GetPlayerWeaponEx[playerid][i] = false;
	ResetPlayerWeapons(playerid);
	return true;
}

stock SetPlayerOrganizationSpawn(playerid)    
{
	new Float:POS[4],world,interior;
	switch(PlayerInfo[playerid][pMember])   
	{
	case REPORTER_ORG: world = NEWS_MIR, POS[0] = 363.6555, POS[1] = 122.2610, POS[2] = 1131.9860, POS[3] = 80;
    case ARMY_ORG: POS[0] = -1063.7567, POS[1] = -696.6785, POS[2] = 35.4406, POS[3] = 0.0;
	case PATRUL_ORG: POS[0] = 611.1799, POS[1] = -583.9139, POS[2] = 18.0174, POS[3] = 179.7591;
	case MEDIC_ORG: world = MEDD_MIR, POS[0] = 1166.537, POS[1] = -1331.28, POS[2] = -0.8598, POS[3] = 270.0;
	case TRANSPORT_ORG: interior = 3 ,world = TRAN_MIR, POS[0] = 350.4474, POS[1] = 165.4389, POS[2] = 1019.9844, POS[3] = 270.0;
	case HITMAN_ORG: POS[0] = 414.7241, POS[1] = 2531.1443, POS[2] = 19.1720;
	case ADVOKAT_ORG: interior = 0, POS[0] = 558.6524, POS[1] = 1652.9618, POS[2] = 6.9922, POS[3] = 215.1376;
	case MERIA_ORG: world = MERI_MIR, POS[0] = 1709.6409, POS[1] = -1640.8645, POS[2] = 1001.9860, POS[3] = 270;
	case GROOVE_GANG: interior = 3, world = GANG_MIR+GROOVE_GANG, POS[0] = 2495.869, POS[1] =  -1702.8, POS[2] = 1014.7422;
	case BALLAS_GANG: interior = 5, world = GANG_MIR+BALLAS_GANG, POS[0] = 322.8180, POS[1] =  1120.14, POS[2] = 1083.8828, POS[3] = 90;
	case AZTECAS_GANG: interior = 5,world = GANG_MIR+AZTECAS_GANG, POS[0] = 1522.6187, POS[1] = -66.2266, POS[2] = 554.1859, POS[3] = 307.5002;
	case RIFA_GANG: interior = 10, world = GANG_MIR+RIFA_GANG, POS[0] = 2256.857, POS[1] = -1211.93, POS[2] = 1049.0234, POS[3] = 270;
	case VAGOS_GANG: interior = 6, world = GANG_MIR+VAGOS_GANG, POS[0] = 2190.857, POS[1] = -1202.75, POS[2] = 1049.0234, POS[3] = 270;
 	case NOSTRA_MAFIA: world = GANG_MIR+NOSTRA_MAFIA, POS[0] = 33.9851, POS[1] = -2652.3745, POS[2] = 40.5359, POS[3] = 180;
	case YAKUZA_MAFIA:  POS[0] = -913.5244, POS[1] = 2684.7222, POS[2] = 42.3703, POS[3] = 317.2137;
	case RUSSIAN_MAFIA:  world = RUSSIAN_MAFIA, POS[0] = -315.4319, POS[1] = 1773.8994, POS[2] =  1773.8994, POS[3] = 185.7443;
	}
	if(PlayerInfo[playerid][pMember] != HITMAN_ORG)
	{
		PlayerInInterior[playerid] = true;
		CurrentPlayerTime(playerid);
	}
	SetPlayerInterior(playerid, interior);
	SetPlayerPos(playerid, POS[0], POS[1], POS[2]);
	SetPlayerFacingAngle(playerid, POS[3]);
	SetPlayerVirtualWorld(playerid, world);
	return true;
}

stock UpdatePlayerDrugEffect(playerid, bool:decline)
{
	if(PlayerDrugEffect[playerid] > 0 && PlayerDrugEffect[playerid] < 5) SetPlayerDrunkLevel(playerid, 10000);
	else if(PlayerDrugEffect[playerid] >= 5 && PlayerDrugEffect[playerid] < 10) SetPlayerDrunkLevel(playerid, 20000);
	else if(PlayerDrugEffect[playerid] >= 10)
	{
		SetPlayerWeather(playerid, -66);
		SetPlayerDrunkLevel(playerid, 30000);
	}
	if(decline)
	{
		PlayerDrugEffect[playerid] -= 1;
		if(PlayerDrugEffect[playerid] < 1)
		{
			SetPlayerWeather(playerid, 3);
			SetPlayerDrunkLevel(playerid, 0);
			PlayerDrugEffect[playerid] = 0;
		}
	}
	return true;
}

stock UpdatePlayerAnticheat(playerid)
{
	if(StatusInfo[playerid][sSpawn] == 0 || !PlayerLogged[playerid] && !ServerRestarted) return true;
	new Float:health,Float:armour,string[128];
	new weapon = GetPlayerWeapon(playerid);
	GetPlayerHealth(playerid, health);
	if(health > PlayerInfo[playerid][pHealth]) SetPlayerHealthEx(playerid, PlayerInfo[playerid][pHealth]);
	else PlayerInfo[playerid][pHealth] = health;
	GetPlayerArmour(playerid, armour);
	if(armour > PlayerInfo[playerid][pArmour]) SetPlayerArmourEx(playerid, PlayerInfo[playerid][pArmour]);
	else PlayerInfo[playerid][pArmour] = armour;
	if(PlayerInfo[playerid][pAdmin] == 0 && weapon > 34 && weapon < 40)
	{
		SendClientMessage(playerid, COLOR_RED, "Ты кикнут за использование weapon-hack");
		return Kick(playerid);
	}
	if(weapon != 0 && weapon != 9 && weapon != 46 && !GetPlayerWeaponEx[playerid][weapon])
	{
		if(!PlayerCheater[playerid])
		{
			f(string, "Игрок {DB8484}%s{FF0000} подозревается в использовании weapon-hack", PlayerNameEx[playerid]);
			SendAdminMessage(COLOR_RED, string);
			PlayerCheater[playerid] = true;
		}
		RemovePlayerWeapon(playerid, weapon);
	}
	if(!IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) != PLAYER_STATE_SPECTATING)
	{
		new Float:POS[3],animlib[30],animname[30];
		GetAnimationName(GetPlayerAnimationIndex(playerid), animlib, 32, animname, 32);
		GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
		if(GetPlayerAnimationIndex(playerid) == -1 && POS[2] > 0) DeleteAnimation(playerid);
		if(POS[2] >= 2 && !strcmp(animlib, "SWIM", true) && !strcmp(animname, "SWIM_crawl", true) && !PlayerCheater[playerid])
		{
			f(string, "Игрок {DB8484}%s{FF0000} подозревается в использовании fly-hack", PlayerNameEx[playerid]);
			SendAdminMessage(COLOR_RED, string);
			PlayerCheater[playerid] = true;
		}
	}
	if(PlayerInfo[playerid][pAdmin] == 0 && !PlayerCheater[playerid] && GetPlayerSpeed(playerid) > 200 && GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
	{
		f(string, "Игрок {DB8484}%s{FF0000} кикнут за использование speed-hack | cкорость: {DB8484}%d{FF0000} км/ч", PlayerNameEx[playerid], GetPlayerSpeed(playerid));
		SendAdminMessage(COLOR_RED, string);
		SendClientMessage(playerid, COLOR_RED, "Ты кикнут за использование speed-hack");
		return Kick(playerid);
	}
	if(GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_USEJETPACK)
	{
		f(string, "Игрок {DB8484}%s{FF0000} кикнут за использование jetpack", PlayerNameEx[playerid]);
		SendAdminMessage(COLOR_RED, string);
		SendClientMessage(playerid, COLOR_RED, "Ты кикнут за использование jetpack");
		return Kick(playerid);
	}
	return true;
}

stock ConvertMoney(amount)
{
	new txt[64];
	f(txt, "%d$", amount);
	switch(strlen(txt)-1)
	{
	case 4: strins(txt, ".", 1);
	case 5: strins(txt, ".", 2);
	case 6: strins(txt, ".", 3);
	case 7: strins(txt, ".", 1), strins(txt, ".", 5);
	case 8: strins(txt, ".", 2), strins(txt, ".", 6);
	case 9: strins(txt, ".", 3), strins(txt, ".", 7);
	case 10: strins(txt, ".", 1), strins(txt, ".", 6), strins(txt, ".", 9);
	case 11: strins(txt, ".", 2), strins(txt, ".", 7), strins(txt, ".", 10);
	case 12: strins(txt, ".", 3), strins(txt, ".", 8), strins(txt, ".", 11);
	}
	return txt;
}




stock IsVehicleOccupied(vehicleid)
{
	for(new i; i<GetMaxPlayers(); i++) if(IsPlayerInVehicle(i, vehicleid)) return true;
	return false;
}

