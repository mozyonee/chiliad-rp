		new fishnum = strval(tmp);
		if(fishnum > PlayerInfo[playerid][pFish]) return SendClientMessage(playerid, COLOR_GREEN, "У тебя нет столько рыбы");
		if(fishnum < 1) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верное количество рыбы");
		new moneyfrom = (fishnum * (random(10)+10));
		f(string, "Ты продал {9DDAF2}%d{FFFFFF} шт. сырой рыбы.", fishnum);
		SendClientMessage(playerid, COLOR_WHITE, string);
