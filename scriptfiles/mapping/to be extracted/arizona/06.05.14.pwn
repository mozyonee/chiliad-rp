	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/gov", true) || !strcmp(cmd, "/goverment", true))
	{
		if(GetOrganizationType(PlayerInfo[playerid][pMember]) != 1) return SendClientMessage(playerid, COLOR_GREEN, "Ты не состоишь в какой-либо фракции");
		if(PlayerInfo[playerid][pLeader] == 0 && PlayerInfo[playerid][pZam] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть лидером или замом фракции, чтобы разместить гос.новость");
  if(PlayerInfo[playerid][pMember] == HITMAN_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Вам запрещено размещать гос.новости");
		if(PlayerInfo[playerid][pMuteTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Твоё время молчанки ещё не истекло");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь разместить гос.новость");
		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь разместить гос.новость");
		PlayerGoverments[playerid][0] = "---";
		PlayerGoverments[playerid][1] = "---";
		PlayerGoverments[playerid][2] = "---";
		PlayerGovermentList[playerid] = 0;
		strcat(string, "{FFFFFF}Государственная новость:\n\n");
		strcat(string, "1. ---\n");
		strcat(string, "2. ---\n");
		strcat(string, "3. ---\n\n");
