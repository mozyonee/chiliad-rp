			if(PlayerInfo[giveplayerid][pZam] == 1) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок уже имеет должность зама");
			f(string, "Ты назначил замом игрока {9DDAF2}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Лидер {9DDAF2}%s{FFFFFF} назначил тебя замом", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
			PlayerInfo[giveplayerid][pZam] = 1;
