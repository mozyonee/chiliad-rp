", "Выбрать", "Назад");
				}
			case 1:
				{
					new inform[2000];
					strcat(inform, "{FF6347}На нашем сервере запрещено:\n\n{FFFFFF}");
					strcat(inform, "Использование любых программ скриптов читов и т.п. дающие нечестное преймущество в игре.\n");
					strcat(inform, "Использование багов (ошибок, неисправностей мода)\n");
					strcat(inform, "Использовать ESC в целях ухода от погони или смерти.\n");
					strcat(inform, "Убивать игроков на спавне (место возрождения)\n");
					strcat(inform, "Убивать игроков при помощи транспорта (давить, стрелять с водительского места, сбивать)\n");
					strcat(inform, "Убийство или нанесение физического вреда игрокам без причины (Death Match)\n");
					strcat(inform, "Злоупотребление игровыми возможностями для создания неудобств игрокам.\n\n");
					strcat(inform, "Ругательство, оскорбления или нецензурная речь.\n");
					strcat(inform, "Угрозы игрокам (не относящиеся к игровому процессу)\n");
					strcat(inform, "Писать сообщения в верхнем регистре (Caps Lock)\n");
					strcat(inform, "Писать в чат объявлений сообщения не относящихся к игре.\n");
					strcat(inform, "Писать одно и тоже сообщение слишком часто.\n");
					strcat(inform, "Обсуждать, критиковать действия администрации.\n");
					strcat(inform, "Рекламировать сторонние ресурсы.\n\n");
					strcat(inform, "{FFA500}Администрация сервера:\n\n{FFFFFF}");
					strcat(inform, "Запрещено препятствовать администрации в работе.\n");
					strcat(inform, "Необходимо сообщать администрации о каких-либо нарушениях из данных правил (/report)\n");
					strcat(inform, "Администрация самостоятельно выбирает штрафные санкции для каждого из случаев.\n");
					strcat(inform, "Решение администрации является окончательным и не подлежит обсуждению.\n");
					strcat(inform, "Штрафные санкции могут применяться как непосредственно после нарушения, так и через некоторое время.\n\n");
					strcat(inform, "{FFA500}Незнание правил не освобождает вас от ответственности");
					ShowDialog(playerid, HELP_ID+3, DIALOG_STYLE_MSGBOX, "Правила сервера", inform, "Назад", "Закрыть");
				}
			case 2:
				{
					ShowDialog(playerid, HELP_ID+6, DIALOG_STYLE_LIST, "Помощь по системам", "\
[1] Вороство материалов\n\
[2] Перевозка материалов\n\
[3] Продвижение по ферме[1]\n\
[3] Продвижение по ферме[2]\
", "Выбрать", "Назад");
				}
			case 3:
				{
					ShowDialog(playerid, HELP_ID+4, DIALOG_STYLE_LIST, "Помощь по развитию", "\
[1] С чего начать игру\n\
[2] Приобретение лицензий\n\
[3] Устройство на работу\n\
[4] Покупка вещей в магазине\n\
[5] Банковский счёт\n\
