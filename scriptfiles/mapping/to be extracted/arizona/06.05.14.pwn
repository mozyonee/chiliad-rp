{
	RemovePlayerAttachedObject(playerid, ATT_HAT);
	if(mode) PlayerInfo[playerid][pHat] = 0;
	return true;
}

stock SetPlayerStreetWorld(playerid, bool:interior=true)
{
	if(GetPlayerHouse[playerid] != -1)
	{
		IsInPlayerHouse[playerid][GetPlayerHouse[playerid]] = false;
		GetPlayerHouse[playerid] = -1;
	}
	SetCameraBehindPlayer(playerid);
	if(interior)
	{
		PlayerInInterior[playerid] = false;
		CurrentPlayerTime(playerid);
	}
	return true;
}

stock GetClosestBankomat(playerid)
{
	new bank;
	for(new i=0; i<MAX_ATMBANK; i++)
	{
		if(PlayerToPoint(playerid, 2.0, gAtmPoint[i][0], gAtmPoint[i][1], gAtmPoint[i][2]))
		{
			bank = i;
			break;
		}
	}
	return bank;
}
stock ShowPlayerferms(playerid, togplayerid)
{
    new stringx[2024],
    stats[256];
    f(stats, "{CCE01B}Скилл фермы: {FFFFFF}%d очк.\n", PlayerInfo[playerid][pfskill]); strcat(stringx, stats);
