stock PlayVehicleRadioForPlayer(playerid, online)
{
	StopAudioStreamForPlayer(playerid);
	for(new i=0; i<MAX_RADIO; i++)
	{
		if(online == i+1)
		{
			PlayAudioStreamForPlayer(playerid, StationUrl[i]);
			GameTextForPlayer(playerid, StationTitle[i], 3000, 3);
			break;
		}
	}
	WaitChooseRadio[playerid] = true;
	SetTimerEx("NonChangeRadio", 2000, false, "i", playerid);
	return true;
}

stock SetPlayerBandana(playerid, bandana)
{
	SetPlayerAttachedObject(playerid, ATT_BANDANA, bandana, 2, 0.07, 0.04, -0.00, 268.97, 1.53, 269.22);
	PlayerInfo[playerid][pBandana] = bandana;
	return true;
}

