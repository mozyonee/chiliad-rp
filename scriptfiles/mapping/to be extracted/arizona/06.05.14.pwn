public OnPlayerTaxi(playerid)
{
	new driverid = GetDriverTaxi[playerid];
	if(GetPlayerMoneyEx(playerid) < PlayerAmountPack[driverid])
	{
		new string[128];
		RemovePlayerFromVehicleEx(playerid);
		f(string, "У пассажира %s закончились деньги.", PlayerNameEx[playerid]);
		SendClientMessage(driverid, COLOR_AQUA, string);
		SendClientMessage(playerid, COLOR_AQUA, "У тебя закончились деньги на проезд");
	}
	else
	{
		GivePlayerMoneyEx(playerid, -PlayerAmountPack[driverid]);
		GivePlayerMoneyEx(driverid, PlayerAmountPack[driverid]);
	}
	return ;
}

