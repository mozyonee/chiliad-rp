		if(PlayerInfo[playerid][pLeader] == 0 && PlayerInfo[playerid][pZam] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть лидером или замом, чтобы использовать меню лидера");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь использовать меню лидера");
