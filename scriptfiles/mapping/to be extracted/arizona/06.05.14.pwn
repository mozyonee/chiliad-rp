			case 1: SendClientMessage(playerid, COLOR_WHITE, "Ты достал из мусорки {9DDAF2}тухлую рыбу {FFFFFF}и съел её");
			case 2: SendClientMessage(playerid, COLOR_WHITE, "Ты достал из мусорки {9DDAF2}кефир {FFFFFF}и выпил его");
			case 3: SendClientMessage(playerid, COLOR_WHITE, "Ты достал из мусорки {9DDAF2}салат {FFFFFF}и съел его");
			case 4: SendClientMessage(playerid, COLOR_WHITE, "Ты достал из мусорки {9DDAF2}кусок хлеба {FFFFFF}и съел его");
			case 5: return ShowPlayerRubbishDialog(playerid), SetPlayerChatBubble(playerid, "Роется в мусорке", COLOR_AQUA, 30.0, 5000);
			}
			if(PlayerRubbish[playerid] >= 15+random(10))
			{
				SendClientMessage(playerid, COLOR_WHITE, "Ты наелся слишком много помойных отходов");
				SeccureAnimation(playerid, "FOOD", "EAT_Vomit_P");
			}
			else
			{
				SetPlayerHealthEx(playerid, health+3);
				PlayerRubbish[playerid] += 10;
				if(health > 100) SetPlayerHealthEx(playerid, 100);
				ShowPlayerRubbishDialog(playerid);
			}
		}
		return true;
	}

