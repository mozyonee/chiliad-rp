		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь осматривать игроков");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: (/ex)plore [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			new Float:health,medkart[64],name[128];
			if(PlayerInfo[giveplayerid][pMedKart] == 1)
			{
				medkart = "Имеется";
			}
			else
			{
				medkart = "Не имеется";
			}
			GetPlayerHealth(giveplayerid, health);
			f(string, "\
			{FFFF00}Сост. здоровия: {FFFFFF}%d%%\n\
			{FFFF00}Наркозависимость: {FFFFFF}%d\n\
			{FFFF00}Медкарта: {FFFFFF}%s",
			floatround(health), PlayerInfo[giveplayerid][pDepend], medkart);
			f(name, "Состояние %s", PlayerNameEx[giveplayerid]);
			ShowDialog(playerid, 00000, DIALOG_STYLE_MSGBOX, name, string, "Закрыть", "");
			f(string, "Медик {9DDAF2}%s{FFFFFF} осмотрел тебя.", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

