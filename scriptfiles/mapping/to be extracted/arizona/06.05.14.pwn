				SendClientMessage(playerid, COLOR_WHITE, string);
				f(string, "Игрок {9DDAF2}%s{FFFFFF} принял твоё приглашения вступить в мафию {9DDAF2}%s", PlayerNameEx[playerid], GetOrganizationName(PlayerInfo[playerid][pMember]));
				SendClientMessage(frakid, COLOR_WHITE, string);
			}
