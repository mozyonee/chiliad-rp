		TogglePlayerControllable(giveplayerid, true);
		return true;
	}
	else if(!strcmp(cmd, "/blind", true))
	{
		if(GetOrganizationType(PlayerInfo[playerid][pMember]) != 2 && GetOrganizationType(PlayerInfo[playerid][pMember]) != 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты не состоишь в какой-либо банде или мафии");
		if(PlayerInfo[playerid][pRank] < 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть второго ранга, чтобы надевать мешки на игроков");
		if(PlayerInDuel[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь на дуэли, ты не можешь надевать мешки на игроков");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь надевать мешки на игроков");
		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь надевать мешки на игроков");
		if(!IsPlayerInAnyVehicle(playerid)) return MSG_NOVEHICLE(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /blind [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			if(PlayerBlinded[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "На указанном тобой игроке уже надет мешок");
			if(!IsPlayerInVehicle(giveplayerid, GetPlayerVehicleID(playerid))) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок не сидит в твоей машине");
			f(string, "Ты надел мешок на игрока {9DDAF2}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Игрок {9DDAF2}%s{FFFFFF} надел на тебя мешок.", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
			GameTextForPlayer(giveplayerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~BLINDED", 3000, 3);
			PlayerBlinded[giveplayerid] = true;
			GangZoneShowForPlayer(giveplayerid, ZoneBlind[0], 0x000000AA);
			GangZoneShowForPlayer(giveplayerid, ZoneBlind[1], 0x000000AA);
			GangZoneShowForPlayer(giveplayerid, ZoneBlind[2], 0x000000AA);
			GangZoneShowForPlayer(giveplayerid, ZoneBlind[3], 0x000000AA);
			GangZoneShowForPlayer(giveplayerid, ZoneBlind[4], 0x000000AA);
			TextDrawShowForPlayer(giveplayerid, DrawBlind[0]);
			TextDrawShowForPlayer(giveplayerid, DrawBlind[1]);
			TextDrawShowForPlayer(giveplayerid, DrawBlind[2]);
			TextDrawShowForPlayer(giveplayerid, DrawBlind[3]);
			TextDrawShowForPlayer(giveplayerid, DrawBlind[4]);
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	else if(!strcmp(cmd, "/unblind", true))
	{
		if(GetOrganizationType(PlayerInfo[playerid][pMember]) != 2 && GetOrganizationType(PlayerInfo[playerid][pMember]) != 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты не состоишь в какой-либо банде или мафии");
		if(PlayerInfo[playerid][pRank] < 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть третьего ранга, чтобы снимать мешки с игроков");
		if(PlayerInDuel[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь на дуэли, ты не можешь снимать мешки с игроков");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь снимать мешки с игроков");
		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь снимать мешки с игроков");
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /unblind [ id игрока ]");
		giveplayerid = strval(tmp);
		if(IsPlayerConnected(giveplayerid))
		{
			if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
			if(GetDistancePlayers(playerid, giveplayerid) > 3.0) return MSG_BIGDIST(playerid);
			if(!PlayerBlinded[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "На указанном тобой игроке не надет мешок");
			f(string, "Ты снял мешок с игрока {9DDAF2}%s", PlayerNameEx[giveplayerid]);
