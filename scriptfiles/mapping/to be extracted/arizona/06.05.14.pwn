			{
				GangZoneStopFlashForAll(GangZoneInfo[i][gzZone]);
				GangZoneInfo[i][gzGang] = gang;
				GangZoneHideForAll(GangZoneInfo[i][gzZone]);
				GangZoneShowForAll(GangZoneInfo[i][gzZone], GetGangZoneColor(i));
				notgangzone = false;
				break;
			}
		}
		if(notgangzone) SendClientMessage(playerid, COLOR_GREEN, "Ты не находешься на той территории, банду которой ты можешь сменить");
		return true;
	}

	f(string, "{FFFFFF}Команда {00FF00}%s{FFFFFF} не найдена. Используй команду {00FF00}/help{FFFFFF} чтобы узнать команды сервера!", cmdtext);
	return SendClientMessage(playerid, 0xB3B3B3FF, string);
}
public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
	new string[256];
	new vehicleid = GetPlayerVehicleID(playerid);
	if(PRESSED(KEY_SPRINT) && PlayerLoopingAnim[playerid])
	{
		DeleteAnimation(playerid);
		TextDrawHideForPlayer(playerid, StopAnimation);
	}
	if(newkeys & KEY_SPRINT && newkeys & KEY_JUMP && GetPlayerState(playerid) != 2)
	{
		ClearAnimations(playerid); ApplyAnimation(playerid,"FAT","IDLE_tired",4.0,0,0,0,0,0);
	}
	if(newkeys == 512)
	{
		OnPlayerCommandText(playerid, "/lights");
	}
	if(newkeys == 65536)
	{
	if(!IsPlayerInAnyVehicle(playerid))
	{
	OnPlayerCommandText(playerid, "/menu");
	}
	}
    if(newkeys & KEY_FIRE || (newkeys & KEY_SPRINT && newkeys & KEY_SECONDARY_ATTACK) || (newkeys & 128  && newkeys & 16) || (newkeys & KEY_SPRINT && newkeys & KEY_FIRE ))
    {
        if(IsAAntidm(playerid))
    {
    if(!IsPlayerInAnyVehicle(playerid))
    {
                ShowPlayerDialog(playerid,26322, DIALOG_STYLE_MSGBOX, "Уведомление","{228B22}Безопасный район - {FFFFFF} Тут запрещенно драться, стрелять и т.д.", "Ok", "");
                ApplyAnimation(playerid,"PED","IDLE_tired",4.1,0,1,1,0,4000,1);
                return true;
    }
    }
    }
	if(GetPlayerAct[playerid] != INVALID_PLAYER_ID && !IsPlayerInAnyVehicle(playerid))
	{
		if(PRESSED(65536))
		{
			new Float:POS[4],psexedid = GetPlayerAct[playerid];
			GetPlayerPos(GetPlayerAct[playerid], POS[0], POS[1], POS[2]);
			GetPlayerAct[playerid] = INVALID_PLAYER_ID;
			if(PlayerToPoint(playerid, 3, POS[0], POS[1], POS[2]))
			{
				SetPlayerAngleToPlayer(playerid, psexedid);
				SetPlayerAngleToPlayer(psexedid, playerid);
				SeccureAnimation(psexedid, "KISSING", "Grlfrd_Kiss_03");
				SeccureAnimation(playerid, "KISSING", "Grlfrd_Kiss_03");
			}
		}
		if(PRESSED(131072))
		{
			f(string, "Ты отказался от поцелуя с игроком {9DDAF2}%s", PlayerNameEx[GetPlayerAct[playerid]]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			GetPlayerAct[playerid] = INVALID_PLAYER_ID;
		}
	}
	if(PRESSED(KEY_SECONDARY_ATTACK))
	{
		if(PlayerInShamal[playerid] != INVALID_VEHICLE_ID)
		{
			new Float:POS[3];
			GetVehiclePos(PlayerInShamal[playerid], POS[0], POS[1], POS[2]);
			SetPlayerPos(playerid, POS[0]+4, POS[1], POS[2]);
			SetPlayerInterior(playerid, 0);
			SetPlayerVirtualWorld(playerid, 0);
			PlayerInShamal[playerid] = INVALID_VEHICLE_ID;
			return true;
		}
		if(PlayerToPoint(playerid, 1.5, 512, -73, 999))
		{
			if(GetPlayerMoneyEx(playerid) < 7) return SendClientMessage(playerid, COLOR_GREEN, "У тебя не достаточно денег. Нужно{5BD93B} 7$");
			if(CasinoAllow == playerid+1) return true;
			if(CasinoAllow > 0) return SendClientMessage(playerid, COLOR_GREEN, "Игровой автомат уже кем-то используется");
			CasinoAllow = playerid+1;
			DeleteAnimation(playerid);
			SeccureAnimation(playerid, "CASINO", "Slot_Plyr");
			PlayerPlaySound(playerid, 1158, 0.0, 0.0, 0.0);
			SetPlayerFacingAngle(playerid, 270);
			GivePlayerMoneyEx(playerid, -7);
			for(new i; i<3; i++)
			{
				new randcasino;
				switch(i)
				{
				case 0: randcasino = 10;
				case 1: randcasino = 15;
				case 2: randcasino = 20;
				}
				CasinoUpdateObjects(playerid, i, randcasino += random(5));
			}
			return true;
		}
	}
//------------------------------------------------------------------------------
	if(PRESSED(KEY_FIRE))
	{
		if(GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_DRINK_WINE || GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_DRINK_BEER)
		{
            	PlayerInfo[playerid][pJajda] += 10;
            	PlayerInfo[playerid][pNyzda] += 3;
            	SetProgressBarValue(playerid, Voda[playerid], PlayerInfo[playerid][pJajda]);
    			UpdateProgressBar(Voda[playerid], playerid);
    			SetProgressBarValue(playerid, Nyzda[playerid], PlayerInfo[playerid][pNyzda]);
    			UpdateProgressBar(Nyzda[playerid], playerid);
		}
		else if(GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_DRINK_SPRUNK || GetPlayerSpecialAction(playerid) == SPECIAL_ACTION_SMOKE_CIGGY)
		{
			    PlayerInfo[playerid][pJajda] += 10;
            	PlayerInfo[playerid][pNyzda] += 3;
            	SetProgressBarValue(playerid, Voda[playerid], PlayerInfo[playerid][pJajda]);
    			UpdateProgressBar(Voda[playerid], playerid);
    			SetProgressBarValue(playerid, Nyzda[playerid], PlayerInfo[playerid][pNyzda]);
    			UpdateProgressBar(Nyzda[playerid], playerid);
		}
			if(Checkpoint[PORTER_JOB][playerid] == 2 && !PlayerToPoint(playerid, 3.0, 1918.2263,172.6311,37.2574))
		{
			SendClientMessage(playerid, COLOR_WHITE, "Ты уронил сено");
			DisablePlayerRaceCheckpoint(playerid);
			RemovePlayerAttachedObject(playerid, ATT_PACK);
			SetPlayerCheckpointEx(playerid, 1918.2263,172.6311,37.2574, CHECKPOINT_PLAYER);
			Checkpoint[PORTER_JOB][playerid] = 1;
			DeleteAnimation(playerid);
			return true;
		}
 	if(Checkpoint[BUILD_JOB][playerid] == 2 && !PlayerToPoint(playerid, 3.0, -46.1833,1354.0594,12.1406))
		{
			SendClientMessage(playerid, COLOR_WHITE, "Ты уронил стройматериалы");
			DisablePlayerRaceCheckpoint(playerid);
			RemovePlayerAttachedObject(playerid, ATT_PACK);
			SetPlayerCheckpointEx(playerid, -46.1833,1354.0594,12.1406, CHECKPOINT_PLAYER);
			Checkpoint[BUILD_JOB][playerid] = 1;
			DeleteAnimation(playerid);
			return true;
		}
  if(Checkpoint[FOREST_JOB][playerid] == 2)
		{
			SendClientMessage(playerid, COLOR_WHITE, "Ты уронил брёвна");
			DisablePlayerRaceCheckpoint(playerid);
			RemovePlayerAttachedObject(playerid, ATT_PACK);
			Checkpoint[FOREST_JOB][playerid] = 1;
			new rand = random(sizeof(gForestPoint));
			SetPlayerCheckpointEx(playerid, gForestPoint[rand][0], gForestPoint[rand][1], gForestPoint[rand][2], CHECKPOINT_PLAYER);
			DeleteAnimation(playerid);
			return true;
		}
		if(Checkpoint[PIZZA_JOB][playerid] == 3)
		{
			new Float:POS[3];
			SendClientMessage(playerid, COLOR_WHITE, "Ты уронил пиццу");
			DisablePlayerRaceCheckpoint(playerid);
			GetVehiclePos(GetJobVehicle[playerid], POS[0], POS[1], POS[2]);
			SetPlayerCheckpointEx(playerid, POS[0], POS[1], POS[2], CHECKPOINT_VEHICLE);
			RemovePlayerAttachedObject(playerid, ATT_PACK);
			Checkpoint[PIZZA_JOB][playerid] = 2;
			DeleteAnimation(playerid);
			return true;
		}
			if(PlayerSteal[playerid] == 2)
		{
			SendClientMessage(playerid, COLOR_WHITE, "Ты уронил материалы");
			DisablePlayerRaceCheckpoint(playerid);
			RemovePlayerAttachedObject(playerid, ATT_PACK);
			PlayerSteal[playerid] = 1;
			SetPlayerCheckpointEx(playerid, -1022.5657,-732.4492,24.8891, CHECKPOINT_PLAYER);
			DeleteAnimation(playerid);
			return true;
		}
		if(PlayerSteal2[playerid] == 2)
		{
			SendClientMessage(playerid, COLOR_WHITE, "Ты уронил материалы");
			DisablePlayerRaceCheckpoint(playerid);
			RemovePlayerAttachedObject(playerid, ATT_PACK);
			PlayerSteal2[playerid] = 1;
			SetPlayerCheckpointEx(playerid, -1902.1361,-1678.0259,23.0156, CHECKPOINT_PLAYER);
			DeleteAnimation(playerid);
			return true;
		}
	}
//---------------[Подносы]------------------------------------------------------
    if(newkeys & KEY_SPRINT && newkeys & KEY_JUMP || newkeys == KEY_FIRE || newkeys & KEY_SECONDARY_ATTACK  || (newkeys & KEY_SUBMISSION  && newkeys & KEY_SECONDARY_ATTACK))
    {
        if(GetPVarInt(playerid, "respeat") == 1)
        {
            SendClientMessage(playerid, COLOR_WHITE, "Вы уронили поднос с едой!");
            RemovePlayerAttachedObject(playerid,5);
            SetPVarInt(playerid, "respeat",0);
        }
    }
//------------------------------------------------------------------------------
	if(PRESSED(KEY_ENGINE))
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			if(IsEngineCar(vehicleid) && VehicleEndeng[vehicleid])
			{
				if(RefuelVehicle[vehicleid]) return SendClientMessage(playerid, COLOR_GREEN, "Ты не можешь пользоваться ключом зажигания во время заправки машины");
				if(!VehicleEngine[GetPlayerVehicleID(playerid)])
				{
					VehicleEndeng[vehicleid] = false;
					SetTimerEx("EnginePlayerVehicle", 2000, false, "ii", playerid, GetPlayerVehicleID(playerid));
					GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~ENGINE STARTING...", 2000, 3);
					return true;
				}
				else
				{
					new engine,lights,alarm,doors,bonnet,boot,objective;
					GetVehicleParamsEx(GetPlayerVehicleID(playerid),engine,lights,alarm,doors,bonnet,boot,objective);
					SetVehicleParamsEx(GetPlayerVehicleID(playerid),false,lights,alarm,doors,bonnet,boot,objective);
					VehicleEngine[GetPlayerVehicleID(playerid)] = false;
					SetPlayerChatBubble(playerid, "Заглушил двигатель", COLOR_AQUA, 30.0, 5000);
					GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~ENGINE OFF", 3000, 3);
					return true;
				}
			}
		}
	}
	if(PRESSED(KEY_CROUCH))
	{
  if(PlayerInfo[playerid][pMember] == PATRUL_ORG)
