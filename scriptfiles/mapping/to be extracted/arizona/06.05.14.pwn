			PlayerInfo[giverid][pBizz] = 0;
			GivePlayerMoneyEx(playerid, -amount);
			GivePlayerMoneyEx(giverid, amount);
			f(string, "Ты успешно продал свой бизнес игроку {9DDAF2}%s{FFFFFF} за {9DDAF2}%d$", PlayerNameEx[playerid], amount);
