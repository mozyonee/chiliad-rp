				PutPlayerInVehicle(playerid, GetPlayerVehicleID(playerid), 0);
				RemovePlayerHat(playerid, false);
				RemovePlayerBandana(playerid, false);
				GetJobVehicle[playerid] = GetPlayerVehicleID(playerid);
			}
			else
			{
				SendClientMessage(playerid, COLOR_GREEN, "Ты должен находиться в мопеде и быть за рулём");
			}
		}
		else
		{
			if(PlayerAmountPack[playerid] <= 0)
			{
				SendClientMessage(playerid, COLOR_WHITE, "Ты ничего не заработал");
				GivePlayerMoneyEx(playerid, -200);
			}
			else
			{
				new zarplata = PlayerAmountPack[playerid]*PIZZA_ZARP;
				GivePlayerMoneyEx(playerid, zarplata);
				f(string, "Ты развёз пиццу и получил зарплату в размере {9DDAF2}%d$", zarplata);
				SendClientMessage(playerid, COLOR_WHITE, string);
			}
			GetJobVehicle[playerid] = INVALID_VEHICLE_ID;
			Checkpoint[PIZZA_JOB][playerid] = 0;
			PlayerAmountPack[playerid] = 0;
			SetPlayerSkin(playerid, PlayerInfo[playerid][pSkin]);
			DisablePlayerRaceCheckpoint(playerid);
			DeleteAnimation(playerid);
			RemovePlayerAttachedObject(playerid, ATT_PACK);
			if(PlayerInfo[playerid][pBandana] != 0)
			{
				SetPlayerBandana(playerid, PlayerInfo[playerid][pBandana]);
			}
			if(PlayerInfo[playerid][pHat] != 0)
			{
				SetPlayerHat(playerid, PlayerInfo[playerid][pHat]);
			}
		}
		return true;
	}

