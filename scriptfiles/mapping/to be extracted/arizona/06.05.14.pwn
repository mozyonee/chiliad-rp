	if(CheckpointFarmer1[0][playerid] >= 2800 && CheckpointFarmer[0][playerid] <= 2842)
	{
 	if(IsFarmerCar1(GetPlayerVehicleID(playerid)))
		{
			if(CheckpointFarmer1[0][playerid] == 2842)
			{
				DisablePlayerRaceCheckpoint(playerid);
				SetPlayerCheckpointEx(playerid, FR00[0][0], FR00[0][1], FR00[0][2], CHECKPOINT_VEHICLE);
				CheckpointFarmer1[0][playerid] = 2800;
				CheckpointFarmer1[1][playerid] = 26;
				PlayerAmountPack[playerid] += 1;
				TogglePlayerControllable(playerid, false);
				SendClientMessage(playerid, COLOR_WHITE, "Пожалуйста подожди...");
				SendClientMessage(playerid, COLOR_AQUA, "Начался следующий рейс");
				SetTimerEx("UnfreezeDriver1", 10000, false, "i", playerid);
				return true;
			}
			DisablePlayerRaceCheckpoint(playerid);
			CheckpointFarmer1[0][playerid] += 1;
			CheckpointFarmer1[1][playerid] -= 1;
			new setbusCP = 25-CheckpointFarmer1[1][playerid];
			SetPlayerCheckpointEx(playerid, FR00[setbusCP][0], FR00[setbusCP][1], FR00[setbusCP][2], CHECKPOINT_VEHICLE);
			PlayerAmountPack[playerid] += 1;
			PlayerInfo[playerid][pfskill] += 1;
		}
		return true;
	}
	////////////////////////////////////
	if(CheckpointBus[0][playerid] >= 300 && CheckpointBus[0][playerid] <= 348)
	{
		if(IsBusCar(GetPlayerVehicleID(playerid)))
		{
			if(CheckpointBus[0][playerid] == 306
					|| CheckpointBus[0][playerid] == 322
					|| CheckpointBus[0][playerid] == 323
					|| CheckpointBus[0][playerid] == 336
					|| CheckpointBus[0][playerid] == 341)
			{
				TogglePlayerControllable(playerid, false);
				f(string, "Водитель маршутки: {B17FC8}%s отъезжает через 10 секунд", PlayerNameEx[playerid]);
				SendDistanceChat(playerid, 32.0, string);
				SetTimerEx("UnfreezeDriver", 10000, false, "i", playerid);
			}
			if(CheckpointBus[0][playerid] == 348)
			{
				DisablePlayerRaceCheckpoint(playerid);
				SetPlayerCheckpointEx(playerid, VLS3[0][0], VLS3[0][1], VLS3[0][2], CHECKPOINT_VEHICLE);
				CheckpointBus[0][playerid] = 300;
				CheckpointBus[1][playerid] = 45;
				PlayerAmountPack[playerid] += 1;
				TogglePlayerControllable(playerid, false);
				SendClientMessage(playerid, COLOR_WHITE, "Пожалуйста подожди...");
				SendClientMessage(playerid, COLOR_AQUA, "Начался следующий рейс");
				SetTimerEx("UnfreezeDriver", 10000, false, "i", playerid);
				return true;
			}
			DisablePlayerRaceCheckpoint(playerid);
			CheckpointBus[0][playerid] += 1;
			CheckpointBus[1][playerid] -= 1;
			new setbusCP = 44-CheckpointBus[1][playerid];
			SetPlayerCheckpointEx(playerid, VLS3[setbusCP][0], VLS3[setbusCP][1], VLS3[setbusCP][2], CHECKPOINT_VEHICLE);
			PlayerAmountPack[playerid] += 1;
		}
		return true;
	}
	if(CheckpointBus[0][playerid] >= 200 && CheckpointBus[0][playerid] <= 258)
	{
		if(IsBusCar(GetPlayerVehicleID(playerid)))
		{
			if(CheckpointBus[0][playerid] == 207
					|| CheckpointBus[0][playerid] == 209
					|| CheckpointBus[0][playerid] == 212
					|| CheckpointBus[0][playerid] == 219
					|| CheckpointBus[0][playerid] == 228
					|| CheckpointBus[0][playerid] == 234
					|| CheckpointBus[0][playerid] == 237
					|| CheckpointBus[0][playerid] == 249)
			{
				TogglePlayerControllable(playerid, false);
				f(string, "Водитель маршутки: {B17FC8}%s отъезжает через 10 секунд", PlayerNameEx[playerid]);
				SendDistanceChat(playerid, 32.0, string);
				SetTimerEx("UnfreezeDriver", 10000, false, "i", playerid);
			}
			if(CheckpointBus[0][playerid] == 257)
			{
				DisablePlayerRaceCheckpoint(playerid);
				SetPlayerCheckpointEx(playerid, VLS2[0][0], VLS2[0][1], VLS2[0][2], CHECKPOINT_VEHICLE);
				CheckpointBus[0][playerid] = 200;
				CheckpointBus[1][playerid] = 30;
				PlayerAmountPack[playerid] += 1;
				TogglePlayerControllable(playerid, false);
				SendClientMessage(playerid, COLOR_WHITE, "Пожалуйста подожди...");
				SendClientMessage(playerid, COLOR_AQUA, "Начался следующий рейс");
				SetTimerEx("UnfreezeDriver", 10000, false, "i", playerid);
				return true;
			}
			DisablePlayerRaceCheckpoint(playerid);
			CheckpointBus[0][playerid] += 1;
			CheckpointBus[1][playerid] -= 1;
			new setbusCP = 29-CheckpointBus[1][playerid];
			SetPlayerCheckpointEx(playerid,VLS2[setbusCP][0],VLS2[setbusCP][1],VLS2[setbusCP][2], CHECKPOINT_VEHICLE);
			PlayerAmountPack[playerid] += 1;
		}
		return true;
	}
	if(CheckpointBus[0][playerid] >= 100 && CheckpointBus[0][playerid] <= 154)
	{
		if(IsBusCar(GetPlayerVehicleID(playerid)))
		{
			if(CheckpointBus[0][playerid] == 105
					|| CheckpointBus[0][playerid] == 115
					|| CheckpointBus[0][playerid] == 117
					|| CheckpointBus[0][playerid] == 122
					|| CheckpointBus[0][playerid] == 135)
			{
				TogglePlayerControllable(playerid, false);
				f(string, "Водитель маршутки: {B17FC8}%s отъезжает через 10 секунд", PlayerNameEx[playerid]);
				SendDistanceChat(playerid, 32.0, string);
				SetTimerEx("UnfreezeDriver", 10000, false, "i", playerid);
			}
			if(CheckpointBus[0][playerid] == 153)
			{
				DisablePlayerRaceCheckpoint(playerid);
				SetPlayerCheckpointEx(playerid, VLS1[0][0], VLS1[0][1], VLS1[0][2], CHECKPOINT_VEHICLE);
				CheckpointBus[0][playerid] = 100;
				CheckpointBus[1][playerid] = 40;
				PlayerAmountPack[playerid] += 1;
				TogglePlayerControllable(playerid, false);
				SendClientMessage(playerid, COLOR_WHITE, "Пожалуйста подожди...");
				SendClientMessage(playerid, COLOR_AQUA, "Начался следующий рейс");
				SetTimerEx("UnfreezeDriver", 10000, false, "i", playerid);
				return true;
			}
			DisablePlayerRaceCheckpoint(playerid);
			CheckpointBus[0][playerid] += 1;
			CheckpointBus[1][playerid] -= 1;
			new setbusCP = 39-CheckpointBus[1][playerid];
			SetPlayerCheckpointEx(playerid, VLS1[setbusCP][0], VLS1[setbusCP][1], VLS1[setbusCP][2], CHECKPOINT_VEHICLE);
			PlayerAmountPack[playerid] += 1;
		}
		return true;
	}

	//------------------------------------------------------------------------------

	if(KartingPoint[playerid] != 0)
	{
		if(KartingPoint[playerid] != 1)
		{
			DisablePlayerRaceCheckpoint(playerid);
			DisablePlayerCheckpoint(playerid);
		}
		switch(KartingPoint[playerid])
		{
		case 1: return GameTextForPlayer(playerid, "~w~Wait others racers", 5000, 3);
		case 2: SetPlayerRaceCheckpoint(playerid, 0, 2228.011962,-2436.930664,12.986888, 2230.281494,-2656.630615,12.976380, 10);
		case 3: SetPlayerRaceCheckpoint(playerid, 0, 2230.281494,-2656.630615,12.976380, 2476.890625,-2658.881347,13.144293, 10);
		case 4: SetPlayerRaceCheckpoint(playerid, 0, 2476.890625,-2658.881347,13.144290, 2491.605712,-2509.923095,13.153931, 10);
		case 5: SetPlayerRaceCheckpoint(playerid, 0, 2491.605712,-2509.923095,13.153931, 2753.989501,-2498.490234,13.153425, 10);
		case 6: SetPlayerRaceCheckpoint(playerid, 0, 2753.989501,-2498.490234,13.153425, 2752.949951,-2409.202392,13.102889, 10);
		case 7: SetPlayerRaceCheckpoint(playerid, 0, 2752.949951,-2409.202392,13.102889, 2615.263671,-2404.581787,13.138293, 10);
		case 8: SetPlayerRaceCheckpoint(playerid, 0, 2615.263671,-2404.581787,13.138293, 2536.681640,-2372.682861,13.051286, 10);
		case 9: SetPlayerRaceCheckpoint(playerid, 0, 2536.681640,-2372.682861,13.051286, 2438.978515,-2448.599121,13.051859, 10);
		case 10: SetPlayerRaceCheckpoint(playerid, 0, 2438.978515,-2448.599121,13.051859, 2317.194580,-2343.608398,12.975331, 10);
		case 11: SetPlayerRaceCheckpoint(playerid, 1, 2317.194580,-2343.608398,12.975331, 2317.194580,-2343.608398,12.975331, 10);
		}
		if(KartingPoint[playerid] != 1 && KartingPoint[playerid] != 13) KartingPoint[playerid] += 1;
		if(KartingPoint[playerid] == 13)
		{
			KartingPoint[playerid] = 0;
			if(KartWinner1 == INVALID_PLAYER_ID)
			{
				KartWinner1 = playerid;
				for(new i=0; i<GetMaxPlayers(); i++)
				{
					if(IsPlayerConnected(i))
					{
						if(PlayerKarting[i])
						{
							f(string, "Игрок {E9CEF5}%s {D3AFE3}финишировал первый в гонке.", PlayerNameEx[playerid]);
							SendClientMessage(i, COLOR_PINK, string);
							if(KartingPlayers < 2)
							{
								SendClientMessage(i, 0xBF97D1FF, "Гонка окончена. Поздравляем победителей");
								KartingPoint[i] = 0;
								DisablePlayerRaceCheckpoint(i);
								KartingMessage[i] = true;
								PlayerKarting[i] = false;
								new veh = GetPlayerVehicleID(i);
								SetVehicleToRespawn(veh);
								PutPlayerInVehicle(i, veh, 0);
								RemovePlayerFromVehicleEx(i);
								DisablePlayerRaceCheckpoint(i);
							}
						}
					}
				}
				if(KartingPlayers < 2)
				{
					KartingStarted = false;
					KartingPrepare = false;
					KartingPlayers = 0;
					KartWinner1 = INVALID_PLAYER_ID;
					KartWinner2 = INVALID_PLAYER_ID;
					KartWinner3 = INVALID_PLAYER_ID;
				}
				return true;
			}
			if(KartWinner2 == INVALID_PLAYER_ID)
			{
				KartWinner2 = playerid;
				for(new i=0; i<GetMaxPlayers(); i++)
				{
					if(IsPlayerConnected(i))
					{
						if(PlayerKarting[i])
						{
							f(string, "Игрок {E9CEF5}%s {D3AFE3}финишировал второй в гонке.", PlayerNameEx[playerid]);
							SendClientMessage(i, COLOR_PINK, string);
							if(KartingPlayers < 3)
							{
								SendClientMessage(i, 0xBF97D1FF, "Гонка окончена. Поздравляем победителей");
								KartingPoint[i] = 0;
								DisablePlayerRaceCheckpoint(i);
								KartingMessage[i] = true;
								PlayerKarting[i] = false;
								new veh = GetPlayerVehicleID(i);
								SetVehicleToRespawn(veh);
								PutPlayerInVehicle(i, veh, 0);
								RemovePlayerFromVehicleEx(i);
								DisablePlayerRaceCheckpoint(i);
							}
						}
					}
				}
				if(KartingPlayers < 3)
				{
					KartingStarted = false;
					KartingPrepare = false;
					KartingPlayers = 0;
					KartWinner1 = INVALID_PLAYER_ID;
					KartWinner2 = INVALID_PLAYER_ID;
					KartWinner3 = INVALID_PLAYER_ID;
				}
				return true;
			}
			if(KartWinner3 == INVALID_PLAYER_ID)
			{
				KartWinner3 = playerid;
				for(new i=0; i<GetMaxPlayers(); i++)
				{
					if(IsPlayerConnected(i))
					{
						if(PlayerKarting[i])
						{
							f(string, "Игрок {E9CEF5}%s {D3AFE3}финишировал третий в гонке.", PlayerNameEx[playerid]);
							SendClientMessage(i, COLOR_PINK, string);
							SendClientMessage(i, 0xBF97D1FF, "Гонка окончена. Поздравляем победителей");
							KartingPoint[i] = 0;
							DisablePlayerRaceCheckpoint(i);
							KartingMessage[i] = true;
							PlayerKarting[i] = false;
							new veh = GetPlayerVehicleID(i);
							SetVehicleToRespawn(veh);
							PutPlayerInVehicle(i, veh, 0);
							RemovePlayerFromVehicleEx(i);
							DisablePlayerRaceCheckpoint(i);
						}
					}
				}
				KartingStarted = false;
				KartingPrepare = false;
				KartingPlayers = 0;
				KartWinner1 = INVALID_PLAYER_ID;
				KartWinner2 = INVALID_PLAYER_ID;
				KartWinner3 = INVALID_PLAYER_ID;
				return true;
			}
		}
		return true;
	}

	//------------------------------------------------------------------------------

	if(PlayerStartSchool[playerid] == 1 && IsSchoolCar(GetPlayerVehicleID(playerid)))
	{
		if(PlayerSchoolCp[playerid] > 0) PlayerSchoolCp[playerid] += 1;
		switch(PlayerSchoolCp[playerid])
		{
		case 2: return SetPlayerRaceCheckpoint(playerid, 0, 860.2162,-566.9641,17.2286, 889.4169,-556.4756,21.2201, 10); // 2
		case 3: return SetPlayerRaceCheckpoint(playerid, 0, 889.4169,-556.4756,21.2201, 1050.0936,-452.1823,50.8696, 10); // 3
		case 4: return SetPlayerRaceCheckpoint(playerid, 0, 1050.0936,-452.1823,50.8696, 1228.1447,-421.8378,4.5752, 10); // 4
		case 5: return SetPlayerRaceCheckpoint(playerid, 0, 1228.1447,-421.8378,4.5752, 1258.6753,-371.5785,2.1646, 10); // 5
		case 6: return SetPlayerRaceCheckpoint(playerid, 0, 1258.6753,-371.5785,2.1646, 1201.4574,-201.2255,36.3023, 10); // 6
		case 7: return SetPlayerRaceCheckpoint(playerid, 0, 1201.4574,-201.2255,36.3023, 1220.3162,-145.1619,39.3639, 10); // 7
		case 8: return SetPlayerRaceCheckpoint(playerid, 0, 1220.3162,-145.1619,39.3639, 1299.5825,-85.9106,36.1933, 10); // 8
		case 9: return SetPlayerRaceCheckpoint(playerid, 0, 1299.5825,-85.9106,36.1933, 1271.7307,-35.4019,30.9310, 10); // 9
		case 10: return SetPlayerRaceCheckpoint(playerid, 0, 1271.7307,-35.4019,30.9310, 1261.7590,178.3972,19.0574, 10); // 10
		case 11: return SetPlayerRaceCheckpoint(playerid, 0, 1261.7590,178.3972,19.0574, 1310.7964,288.5836,19.0612, 10); // 11
		case 12: return SetPlayerRaceCheckpoint(playerid, 0, 1310.7964,288.5836,19.0612, 1294.3030,325.9213,19.0590, 10); // 12
		case 13: return SetPlayerRaceCheckpoint(playerid, 0, 1294.3030,325.9213,19.0590, 1203.3451,367.3308,19.1954, 10); // 13
		case 14: return SetPlayerRaceCheckpoint(playerid, 0, 1203.3451,367.3308,19.1954, 1084.3290,450.7843,22.9820, 10); // 14
		case 15: return SetPlayerRaceCheckpoint(playerid, 0, 1084.3290,450.7843,22.9820, 998.9796,435.6434,19.5360, 10); // 15
		case 16: return SetPlayerRaceCheckpoint(playerid, 0, 998.9796,435.6434,19.5360, 710.4306,320.4819,19.5383, 10); // 16
		case 17: return SetPlayerRaceCheckpoint(playerid, 0, 710.4306,320.4819,19.5383, 571.9363,286.0135,17.3680, 10); // 17
		case 18: return SetPlayerRaceCheckpoint(playerid, 0, 571.9363,286.0135,17.3680, 513.7897,180.4003,20.0078, 10); // 18
		case 19: return SetPlayerRaceCheckpoint(playerid, 0, 513.7897,180.4003,20.0078, 526.8226,-96.3049,36.3277, 10); // 19
		case 20: return SetPlayerRaceCheckpoint(playerid, 0, 526.8226,-96.3049,36.3277, 476.6778,-364.9731,29.7243, 10); // 20
		case 21: return SetPlayerRaceCheckpoint(playerid, 0, 476.6778,-364.9731,29.7243, 532.1748,-416.1631,28.2196, 10); // 21
		case 22: return SetPlayerRaceCheckpoint(playerid, 0, 532.1748,-416.1631,28.2196, 638.8242,-468.4788,15.8425, 10); // 22
		case 23: return SetPlayerRaceCheckpoint(playerid, 0, 638.8242,-468.4788,15.8425, 735.7583,-532.6588,15.8397, 10); // 23
		case 24: return SetPlayerRaceCheckpoint(playerid, 0, 735.7583,-532.6588,15.8397, 809.5746,-533.0790,15.8420, 10); // 24
		case 25: return SetPlayerRaceCheckpoint(playerid, 0, 809.5746,-533.0790,15.8420, 842.5734,-571.9197,15.9983, 10); // 25 ( finish )
		case 26: return SetPlayerRaceCheckpoint(playerid, 0, 842.5734,-571.9197,15.9983, 860.3425,-591.5379,17.5965, 10); // 26конец
		case 27: return SetPlayerRaceCheckpoint(playerid, 1, 860.3425,-591.5379,17.5965, 0,0,0, 10); // 26конец
		case 28:
			{
				DisablePlayerRaceCheckpoint(playerid);
				PlayerStartSchool[playerid] = 0;
				PlayerSchoolCp[playerid] = 0;
				PlayerInfo[playerid][pLicCar] = 1;
				SendClientMessage(playerid, COLOR_WHITE, "Ты успешно получил водительские права");
				RemovePlayerFromVehicleEx(playerid);
				return true;
			}
		}
		return true;
	}
	return true;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
	new string[1024];
	if(GetPlayerDialog[playerid] != dialogid)
	{
		GivePlayerMoneyEx(playerid, -5);
	}
    if(dialogid == REPORTANSWER_ID)
	{
		if(!response) return DeletePVar(playerid,"KEY");
		switch(listitem)
		{
			case 0: ShowPlayerDialog(playerid, REPORTANSWER_ID+1, DIALOG_STYLE_INPUT, "Отправить жалобу", "Введите ID нарушителя и причину\nПример: ID:30, DM\n\nЗа оффтоп вы будете наказаны!", "Отправить", "Назад");
			case 1: ShowPlayerDialog(playerid, REPORTANSWER_ID+2, DIALOG_STYLE_INPUT, "Отправить вопрос", "Сформулируйте вопрос четко и кратко\nИ введите его в окошко\n\nЗа оффтоп последует наказание!", "Отправить", "Назад");
		}
        return 1;
    }
    if(dialogid == REPORTANSWER_ID+1)
	{
		if(!response) return ShowPlayerDialog(playerid, REPORTANSWER_ID, DIALOG_STYLE_LIST, "Выберите тип запроса", "[1] Жалоба\n[2] Вопрос", "Выбрать","Закрыть");
		if(PlayerWaitReport[playerid] > 0 ) return SendClientMessage(playerid, 0xF4FCC7FF, "Писать жалобу можно только раз в 60 секунд");
		if(PlayerInfo[playerid][pMuteTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Твоё время молчанки ещё не истекло");
		f(string, "{ff0000}[ Жалоба от ID: %d ]{dc143c} %s: {ff0000}%s", playerid, PlayerNameEx[playerid], inputtext);
		SendHelperMessage(0xFFEF40FF, string);
		SendClientMessage(playerid, 0xFFEF40FF, string);
		PlayerWaitReport[playerid] = 60;
        return 1;
    }
    if(dialogid == REPORTANSWER_ID+2)
	{
		if(!response) return ShowPlayerDialog(playerid, REPORTANSWER_ID, DIALOG_STYLE_LIST, "Выберите тип запроса", "[1] Жалоба\n[2] Вопрос", "Выбрать","Закрыть");
		if(PlayerInfo[playerid][pMuteTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Твоё время молчанки ещё не истекло");
		f(string, "{FACA46}[ Вопрос от ID: %d ]{FFBB00} %s: {FACA46}%s", playerid, PlayerNameEx[playerid], inputtext);
		SendHelperMessage(0xFFEF40FF, string);
		SendClientMessage(playerid, 0xFFEF40FF, string);
        return 1;
    }
	else if(dialogid == RENT_ID)
	{
		new price = GetPlayerOption[playerid];
		new giverid = GetPlayerTransfer[playerid];
		if(response)
		{
			PlayerInfo[playerid][pRent] = PlayerInfo[giverid][pHouse];
			PlayerInfo[playerid][pRentPrice] = price;
			f(string, "Ты принял предложение от игрока {9DDAF2}%s{FFFFFF} арендовать его дом за {9DDAF2}%d$", PlayerNameEx[giverid], price);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Игрок {9DDAF2}%s{FFFFFF} принял предложение арендовать у тебя дом за {9DDAF2}%d$", PlayerNameEx[playerid], price);
			SendClientMessage(giverid, COLOR_WHITE, string);
			GetPlayerTransfer[playerid] = INVALID_PLAYER_ID;
			GetPlayerOption[playerid] = 0;
		}
		else
		{
			f(string, "Ты отказался от предложения игрока {9DDAF2}%s{FFFFFF} арендовать его дом за {9DDAF2}%d$", PlayerNameEx[giverid], price);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Игрок {9DDAF2}%s{FFFFFF} отказался от предложения арендовать у тебя дом за {9DDAF2}%d$", PlayerNameEx[playerid], price);
			SendClientMessage(giverid, COLOR_WHITE, string);
			GetPlayerTransfer[playerid] = INVALID_PLAYER_ID;
			GetPlayerOption[playerid] = 0;
		}
		return true;
	}
    else if(dialogid == MEDKIT_ID)
	{
		if(response)
		{
			if(PlayerInfo[playerid][pMember] != MEDIC_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции службы спасения");
			SendClientMessage(playerid, COLOR_WHITE, "Подождите, сейчас вы получите аптечки.");
			SetTimerEx("GivePlayerMedKit", 5000, false, "i", playerid);
			TogglePlayerControllable(playerid, false);
			PlayerUsePickup[playerid] = true;
		}
		return true;
	}
	else if(dialogid == MEDKIT_ID+1)
	{
		if(response)
		{
			if(PlayerInfo[playerid][pMember] != MEDIC_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции службы спасения");
