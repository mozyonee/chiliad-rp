				if(Checkpoint[STICK_JOB][playerid] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не начал работу мебельера");
				if(Checkpoint[STICK_JOB][playerid] == 3 || Checkpoint[STICK_JOB][playerid] == 103 || Checkpoint[STICK_JOB][playerid] == 4 || Checkpoint[STICK_JOB][playerid] == 104 || Checkpoint[STICK_JOB][playerid] == 5 || Checkpoint[STICK_JOB][playerid] == 105 || Checkpoint[STICK_JOB][playerid] == 999) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже загрузил фургон");
				if(Checkpoint[STICK_JOB][playerid] == 2)
				{
					if(GetWoodsOnSklad < 300)
