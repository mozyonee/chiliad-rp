	else if(!strcmp(cmd, "/realtime", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 1) return MSG_NOADMIN1(playerid);
		new hours, minutes, seconds;
		gettime(hours, minutes, seconds);
		RealTime = true;
		for(new i=0; i<GetMaxPlayers(); i++)
		{
			if(IsPlayerConnected(i))
			{
				if(!PlayerInInterior[i])
				{
					SetPlayerTime(i, hours, minutes);
				}
			}
		}
		return true;
	}
	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/spec", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 1) return MSG_NOADMIN1(playerid);
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /spec [ id игрока ]");
		giveplayerid = strval(tmp);
		if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
		if(IsPlayerConnected(giveplayerid))
		{
			if(PlayerSpectate[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок за кем-то наблюдает");
			if(!PlayerSpectate[playerid])
			{
				GetPlayerSavedCar(playerid);
				GetPlayerSavedPos(playerid);
				GetPlayerAllWeapons(playerid);
			}
			SetPlayerInterior(playerid, GetPlayerInterior(giveplayerid));
			SetPlayerVirtualWorld(playerid, GetPlayerVirtualWorld(giveplayerid));
			TogglePlayerSpectating(playerid, true);
			GetSpectate[playerid] = giveplayerid;
			PlayerSpectate[playerid] = true;
			if(IsPlayerInAnyVehicle(giveplayerid))
			{
				PlayerSpectateVehicle(playerid, GetPlayerVehicleID(giveplayerid));
			}
			else
			{
				PlayerSpectatePlayer(playerid, giveplayerid);
			}
			SendClientMessage(playerid, COLOR_WHITE, "Ты успешно начал наблюдение");
			SendClientMessage(playerid, COLOR_GRAY, "Чтобы закончить наблюдение используй команду {FFFFFF}/specoff");
		}
		else
		{
			MSG_NOTPLAYER(playerid);
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/specoff", true))
	{
		if(PlayerInfo[playerid][pAdmin] < 1) return MSG_NOADMIN1(playerid);
		if(!PlayerSpectate[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Ты не за кем не наблюдаешь");
		PlayerSavedPositions[playerid] = true;
		TogglePlayerSpectating(playerid, false);
		GetSpectate[playerid] = INVALID_PLAYER_ID;
		SendClientMessage(playerid, COLOR_WHITE, "Ты успешно закончил наблюдение");
