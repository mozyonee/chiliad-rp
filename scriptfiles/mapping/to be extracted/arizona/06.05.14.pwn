	else if(!strcmp(cmd, "/getmedkit", true))
	{
		if(PlayerInfo[playerid][pMember] != MEDIC_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции службы спасения");
		if(PlayerInfo[playerid][pRank] < 2) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть второго ранга, чтобы брать медицинские аптечеки");
		if(IsMedicCar(GetPlayerVehicleID(playerid)))
		{
			if(PlayerInfo[playerid][pRank] > 4)
			{
				if(PlayerMedicine[playerid] >= 20) return SendClientMessage(playerid, COLOR_GREEN, "У тебя уже есть медицинские аптечеки");
				PlayerMedicine[playerid] = 20;
			}
			else if(PlayerInfo[playerid][pRank] > 2)
			{
				if(PlayerMedicine[playerid] >= 15) return SendClientMessage(playerid, COLOR_GREEN, "У тебя уже есть медицинские аптечеки");
				PlayerMedicine[playerid] = 15;
			}
