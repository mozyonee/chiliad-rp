stock PlayerInBox(playerid, Float:min_x, Float:min_y, Float:max_x, Float:max_y)
{
	new Float:POS[3];
	GetPlayerPos(playerid, POS[0], POS[1], POS[2]);
	if((POS[0] <= max_x && POS[0] >= min_x) && (POS[1] <= max_y && POS[1] >= min_y)) return true;
	return false;
}

