public SetViewPlayer(playerid)
{
	new Float:X,Float:Y,Float:Z,Float:X2,Float:Y2;
	GetPlayerPos(playerid, X, Y, Z);
	GetXYInFrontOfPlayer(playerid, X2, Y2, 0.4);
	SetPlayerCameraPos(playerid, X2, Y2, Z+0.9);
	GetXYInFrontOfPlayer(playerid, X2, Y2, 5.0);
	SetPlayerCameraLookAt(playerid, X2, Y2, Z);
	return true;
}
public DeleteTextBoard(playerid, place)
{
	new string[256];
    AdvertOwned[place] = false;
    f(string, "[ рекламный щит №%d ]\n{DEDEDE}Чтобы преобрести это место\nиспользуй команду /board", place+1);
	UpdateDynamic3DTextLabelText(AdvertText[place], COLOR_AQUA, string);
	f(string, "Аренда рекламного щита №%d истекла.", place+1);
	SendClientMessage(playerid, COLOR_PINK, string);
	return 1;
}
public OnPlayerExitCar(playerid)
{
	new string[128];
	if(ExitCount[playerid] > 3 && ExitCount[playerid] < 16)
	{
		f(string, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~w~%d", ExitCount[playerid]);
		GameTextForPlayer(playerid, string, 900, 3);
	}
	if(ExitCount[playerid] > 0 && ExitCount[playerid] < 4)
	{
		f(string, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~%d", ExitCount[playerid]);
		GameTextForPlayer(playerid, string, 900, 3);
	}
	if(ExitCount[playerid] == 0)
	{
		if(PlayerInfo[playerid][pJob] == TAXI_JOB)
		{
			new vehicleid = GetJobVehicle[playerid];
			SendClientMessage(playerid, COLOR_GREEN, "Ты закончили свой маршрут");
			KillTimer(ExitCarTimer[playerid]);
			DestroyDynamic3DTextLabel(INFO[vehicleid]);
			PlayerAmountPack[playerid] = 0;
			KillTimer(TaxiCountTimer[playerid]);
			GetJobVehicle[playerid] = INVALID_VEHICLE_ID;
			TaxiJobStarted[playerid] = false;
			SetVehicleToRespawn(vehicleid);
			GetPlayerRentTaxi[playerid] = -1;
		}
		else
		{
			new vehicleid = GetJobVehicle[playerid];
			KillTimer(ExitCarTimer[playerid]);
			SetVehicleToRespawn(vehicleid);
			RemovePlayerFromVehicleEx(playerid);
			DisablePlayerRaceCheckpoint(playerid);
			TogglePlayerControllable(playerid, true);
			GetRouteBus[vehicleid] = 0;
			GetInfoMode[vehicleid] = 0;
			PlayerAmountPack[playerid] = 0;
			CheckpointBus[0][playerid] = 0;
			CheckpointBus[1][playerid] = 0;
			GetJobVehicle[playerid] = INVALID_VEHICLE_ID;
			DestroyDynamic3DTextLabel(INFO[vehicleid]);
			GetPlayerRentBus[playerid] = -1;
		}
		{
			new vehicleid = GetJobVehicle[playerid];
   			SendClientMessage(playerid, COLOR_GREEN, "Вы закончили свой маршрут");
			KillTimer(ExitCarTimer[playerid]);
			SetVehicleToRespawn(vehicleid);
			RemovePlayerFromVehicleEx(playerid);
			DisablePlayerRaceCheckpoint(playerid);
			TogglePlayerControllable(playerid, true);
			GetRouteBus[vehicleid] = 0;
			GetInfoMode[vehicleid] = 0;
			PlayerAmountPack[playerid] = 0;
			CheckpointFarmer[0][playerid] = 0;
			CheckpointFarmer[1][playerid] = 0;
			GetJobVehicle[playerid] = INVALID_VEHICLE_ID;
			DestroyDynamic3DTextLabel(INFO[vehicleid]);
			GetPlayerRentFarmer[playerid] = -1;
		}
	}
	else
	{
		ExitCount[playerid] -= 1;
	}
	return true;
}

