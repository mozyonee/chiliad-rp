	PlayerInfo[playerid][pJailTime] -= 1;
	f(string, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~JAILED: ~w~%s", ConvertTime(PlayerInfo[playerid][pJailTime]));
	GameTextForPlayer(playerid, string, 1000, 3);
	SetPlayerHealthEx(playerid, 100);
	if(PlayerInfo[playerid][pHealth] <= 10)
	{
		ToggleAnimation(playerid, "CRACK", "crckdeth2");
	}
	if(PlayerInfo[playerid][pJailTime] == 0)
	{
		GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~y~UNJAILED", 3000, 3);
		KillTimer(JailTimer[playerid]);
		PlayerInfo[playerid][pJailTime] = 99999;
		OnPlayerSpawn(playerid);
	}
	return true;
