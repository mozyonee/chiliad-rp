			case AZTECAS_GANG: SetPlayerSkin(playerid, AztecasSkins[0]);
			case NOSTRA_MAFIA: SetPlayerSkin(playerid, NostraSkins[0]);
			case YAKUZA_MAFIA: SetPlayerSkin(playerid, YakuzaSkins[0]);
			case RUSSIAN_MAFIA: SetPlayerSkin(playerid, RussianSkins[0]);
