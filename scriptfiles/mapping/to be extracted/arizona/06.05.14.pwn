			case REPORTER_ORG: SetPlayerSkin(playerid, ReporterSkins[0]);
			case GROOVE_GANG: SetPlayerSkin(playerid, GroveSkins[0]);
			case BALLAS_GANG: SetPlayerSkin(playerid, BallasSkins[0]);
			case RIFA_GANG: SetPlayerSkin(playerid, RifaSkins[0]);
