{
	SetPlayerAttachedObject(playerid, ATT_HAT, hat, 2, 0.15, 0.0, 0.0, 180.0, 0.0, 10.0);
	PlayerInfo[playerid][pHat] = hat;
	return true;
}

stock RemovePlayerBandana(playerid, bool:mode)
{
	RemovePlayerAttachedObject(playerid, ATT_BANDANA);
	if(mode) PlayerInfo[playerid][pBandana] = 0;
	return true;
