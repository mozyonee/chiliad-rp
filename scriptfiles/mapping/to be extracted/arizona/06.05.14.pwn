		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /sellbizz [ id бизнеса ]");
		new id = strval(tmp);
		if(id < 1 || id > MAX_BUSINESS-1)
		{
			f(string, "Ты ввёл не верный id бизнеса. Используй id от 1 до %d", MAX_BUSINESS-1);
			SendClientMessage(playerid, COLOR_GREEN, string);
			return true;
		}
		if(!strcmp("None", BusinessInfo[id][bOwner], true)) return SendClientMessage(playerid, COLOR_GREEN, "У этого бизнеса нет владельца");
		for(new i=0; i<GetMaxPlayers(); i++)
		{
			if(IsPlayerConnected(i) && !strcmp(PlayerName[i], BusinessInfo[id][bOwner], true))
			{
				PlayerInfo[i][pBizz] = 0;
				f(string, "Администратор {9DDAF2}%s{FFFFFF} продал твой бизнес.", PlayerNameEx[playerid]);
				SendClientMessage(i, COLOR_YELLOW, string);
				break;
			}
		}
		settext(BusinessInfo[id][bOwner], "None");
		BusinessInfo[id][bUpload] = 0;
		BusinessInfo[id][bFunds] = 1000;
		BusinessInfo[id][bBalance] = 0;
		f(string, "Бизнес {9DDAF2}%s{FFFFFF} был успешно продан.", BusinessInfo[id][bName]);
		SendClientMessage(playerid, COLOR_WHITE, string);
		return true;
