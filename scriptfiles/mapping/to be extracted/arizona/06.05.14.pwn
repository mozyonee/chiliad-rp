	{
		if(PlayerInfo[playerid][pJob] != BUSDRIVER2_JOB) return SendClientMessage(playerid, COLOR_GREEN, "Ты не устроился на работу комбайнера");
		if(PlayerKarting[playerid] && PlayerInKart[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Участвуя в гонках на картинге, ты не можешь начать работу");
		new vehicleid = GetPlayerVehicleID(playerid);
		if(!IsFarmerCar1(vehicleid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен находиться в комбайне и быть за рулём");
		if(CheckpointFarmer1[0][playerid] == 0)
		{
			PlayerAmountPack[playerid] = 0;
			ShowDialog(playerid, FARMER_ID+4, DIALOG_STYLE_LIST, "Выбор маршрута", "\
			[1] Собрать урожай\
			", "Выбрать", "Отмена");
		}
		else
		{
		    new repairprice,Float:health;
			GetVehicleHealth(vehicleid, health);
			repairprice = floatround(floatsub(1000.0, health))*4;
			f(string, "Ты закончил работу и получил зарплату в размере {9DDAF2}%d${FFFFFF} | Оплата за ремонт: {9DDAF2}%d$", PlayerAmountPack[playerid]*TractorZarp, repairprice);
			SendClientMessage(playerid, COLOR_WHITE, string);
			SetVehicleToRespawn(vehicleid);
			RemovePlayerFromVehicleEx(playerid);
			GivePlayerMoneyEx(playerid, PlayerAmountPack[playerid]*TractorZarp-repairprice);
			DisablePlayerRaceCheckpoint(playerid);
			TogglePlayerControllable(playerid, true);
			//GetRouteBus[vehicleid] = 0;
			GetInfoMode[vehicleid] = 0;
			PlayerAmountPack[playerid] = 0;
			CheckpointFarmer1[0][playerid] = 0;
			CheckpointFarmer1[1][playerid] = 0;
			GetJobVehicle[playerid] = INVALID_VEHICLE_ID;
			DestroyDynamic3DTextLabel(INFO[vehicleid]);
			GetPlayerRentFarmer[playerid] = -1;
		}
		return true;
	}
	////

		else if(!strcmp(cmd, "/findcar", true))
	{
		if(PlayerInfo[playerid][pMember] != PATRUL_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты не находишься во фракции полиции штата или дорожного патруля");
		if(PlayerInfo[playerid][pRank] < 2 && PlayerInfo[playerid][pMember] == PATRUL_ORG) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть второго ранга, чтобы искать машины");
		if(PlayerInfo[playerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в тюрьме, ты не можешь искать машины");
		if(PlayerFind[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже ведёшь за кем-то наблюдение");
		result = strrest(cmdtext, idx);
		if(!strlen(result)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /findcar [ номер машины ]");
		new carid = -1;
		for(new i=0; i<MAX_VEHICLES; i++)
		{
			if(!strcmp(result, NumberVehicle[i], true) && strcmp(result, "[none]", false))
			{
				carid = i;
				break;
			}
		}
		if(carid == -1)
		{
			f(string, "Машина с номером {5BD93B}%s {27C400}не найдена!", result);
			SendClientMessage(playerid, COLOR_GREEN, string);
		}
		else
		{
    	f(string, "Машина с номером {9DDAF2}%s {FFFFFF}успешно найдена!", result);
   		 SendClientMessage(playerid, COLOR_WHITE, string);
    	SendClientMessage(playerid, COLOR_GRAY, "Чтобы закончить наблюдение используй команду {FFFFFF}/findoff");
    	PlayerFind[playerid] = true;
    	GetPlayerFindCar[playerid] = carid;
    	new Float:vehx, Float:vehy, Float:vehz;
    	GetVehiclePos(carid, vehx, vehy, vehz);
    	SetPlayerCheckpoint(playerid, vehx, vehy, vehz, 3.0);
		}
		return true;
	}
	else if(!strcmp(cmd, "/findoff", true))
	{
		DisablePlayerRaceCheckpoint(playerid);
		SendClientMessage(playerid, COLOR_WHITE, "Ты успешно закончил наблюдение");
		return true;
	}
	else if(strcmp(cmd, "/time", true) == 0)
        {
        if(IsPlayerConnected(playerid))
        {
            if(PlayerInfo[playerid][pTimechasi] == 0) return SendClientMessage(playerid, COLOR_GREEN, "У тебя нету часов их можно приобрести в магазине 24/7");
            if(GetPlayerState(playerid) == PLAYER_STATE_ONFOOT) ApplyAnimation(playerid, "COP_AMBIENT", "Coplook_watch",4.1,0,0,0,0,0);
      		SetPlayerChatBubble(playerid, "Взглянул на часы", COLOR_AQUA, 30.0, 5000);
            new mtext[32];
            new year, month,day;
            getdate(year, month, day);
            if(month == 1) { mtext = "January"; }
            else if(month == 2) { mtext = "February"; }
            else if(month == 3) { mtext = "March"; }
            else if(month == 4) { mtext = "April"; }
            else if(month == 5) { mtext = "May"; }
            else if(month == 6) { mtext = "June"; }
            else if(month == 7) { mtext = "July"; }
            else if(month == 8) { mtext = "August"; }
            else if(month == 9) { mtext = "September"; }
            else if(month == 10) { mtext = "October"; }
            else if(month == 11) { mtext = "November"; }
            else if(month == 12) { mtext = "December"; }
            new hour, minuite, second;
            gettime(hour, minuite, second);
			if(minuite < 10) format(string, sizeof(string), "~y~%d %s~n~~g~~w~%d:0%d~n~~g~Red Country", day, mtext, hour, minuite);
            else format(string, sizeof(string), "~y~%d %s~n~~g~~w~%d:%d~n~~g~Red Country-~g~R~g~p", day, mtext, hour, minuite);
            GameTextForPlayer(playerid, string, 5000, 1);
        }
        return true;
        }
