	//------------------------------------------------------------------------------

	else if(dialogid == ORGAN_ID+4)
	{
		if(response)
		{
			new giveplayerid = GetPlayerTransfer[playerid];
			if(PlayerInfo[giveplayerid][pMember] != 0) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок уже состоит в организации");
			if(PlayerInfo[giveplayerid][pLevel] < 1) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок не проживает в штате один год");
			if(PlayerInfo[giveplayerid][pJailTime] > 0) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок находится в тюрьме");
			if(PlayerInDuel[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок находится на дуэли");
			if(PlayerInfo[giveplayerid][pMember] == PlayerInfo[playerid][pMember]) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок уже состоит в твоей организации");
			if(GetOrganizationType(PlayerInfo[playerid][pMember]) == 1 && PlayerInfo[giveplayerid][pPasport] == 0) return SendClientMessage(playerid, COLOR_GREEN, "У этого игрока нет паспорта");
			if(PlayerCuffed[giveplayerid] || PlayerTied[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок находится в наручниках или он связан");
			if(PlayerConvoi[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок находится под конвоем");
			GetPlayerTransfer[giveplayerid] = playerid;
			if(GetOrganizationType(PlayerInfo[playerid][pMember]) == 2)
			{
				f(string, "Ты отослал приглашение вступить в банду {9DDAF2}%s{FFFFFF} игроку {9DDAF2}%s", GetOrganizationName(PlayerInfo[playerid][pMember]), PlayerNameEx[giveplayerid]);
				SendClientMessage(playerid, COLOR_WHITE, string);
				f(string, "\
Игрок %s приглашает тебя в банду %s\
", PlayerNameEx[playerid], GetOrganizationName(PlayerInfo[playerid][pMember]));
				ShowDialog(giveplayerid, ORGAN_ID+5, DIALOG_STYLE_MSGBOX, "Приглашение в банду", string, "Да", "Нет");
			}
			if(GetOrganizationType(PlayerInfo[playerid][pMember]) == 1)
			{
				f(string, "Ты отослал приглашение вступить во фракцию {9DDAF2}%s{FFFFFF} игроку {9DDAF2}%s", GetOrganizationName(PlayerInfo[playerid][pMember]), PlayerNameEx[giveplayerid]);
