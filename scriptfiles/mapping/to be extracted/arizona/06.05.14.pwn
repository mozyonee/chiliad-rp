					ShowDialog(playerid, HOUSE_ID+2, DIALOG_STYLE_INPUT, "Смена названия", "\
Введи новое название для дома:\
", "Ок", "Назад");
				}
			case 2:
				{
					GetPlayerInteriorView[playerid] = true;
					SetPlayerPos(playerid, 2282.990, -1140.28, 1050.89);
					SetPlayerInterior(playerid, 11);
					SetPlayerFacingAngle(playerid, 358.000);
					GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~PRICE: ~w~20000$", 10000, 3);
					PlayerInteriorView[playerid] = -1;
					InteriorView[playerid] = SetTimerEx("SetViewPlayer", 100, true, "i", playerid);
					ShowMenuForPlayer(HouseMenu, playerid);
					TogglePlayerControllable(playerid, false);
				}
			case 3:
				{
					f(string, "\
[1] Аптечка\t\t{F09F1D}7000$\n\
[2] Обычный сейф\t{F09F1D}5000$\n\
[3] Железный сейф\t{F09F1D}10000$\n\
[4] Гардероб\t\t{F09F1D}5000$\n\
[5] Новая дверь\t{F09F1D}8000$\
");
					ShowDialog(playerid, HOUSE_ID+4, DIALOG_STYLE_LIST, "Меню улучшений дома", string, "Купить", "Назад");
				}
			case 4:
				{
					if(HouseOpen[houseid])
					{
						HouseOpen[houseid] = false;
						GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~r~house locked", 3000, 3);
						PlayerPlaySound(playerid,1145,0.0,0.0,0.0);
					}
					else
					{
						HouseOpen[houseid] = true;
						GameTextForPlayer(playerid, "~n~~n~~n~~n~~n~~n~~n~~n~~n~~n~~g~house unlocked", 3000, 3);
						PlayerPlaySound(playerid,1145,0.0,0.0,0.0);
					}
				}
			case 5:
				{
					if(HouseInfo[houseid][hClooth] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не приобрёл гардероб для своего дома");
					ShowDialog(playerid, HOUSE_ID+5, DIALOG_STYLE_LIST, "Гардероб дома", "\
[1] Одеть бандану\n\
[2] Одеть шляпу\n\
[3] Взять портфель/сумку\n\
[4] Снять аксессуары\
", "Выбрать", "Назад");
				}
			case 6:
				{
					ShowDialog(playerid, HOUSE_ID+8, DIALOG_STYLE_INPUT, "Выгнать игрока", "\
Введи id игрока кторого ты хочешь выгнать из своего дома\
", "Ок", "Назад");
				}
			case 7:
				{
					if(HouseInfo[houseid][hSave] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не приобрёл сейф для своего дома");
					ShowDialog(playerid, HOUSE_ID+9, DIALOG_STYLE_LIST, "Управление бюджетом", "\
[1] Проверить баланс\n\
[2] Забрать деньги\n\
[3] Положить деньги\
", "Выбрать", "Назад");
				}
			case 8:
				{
					new Float:POS[3];
					GetVehiclePos(HouseVehicle[houseid], POS[0], POS[1], POS[2]);
					new Float:dist = floatsqroot(floatpower(floatabs(floatsub(HouseInfo[houseid][hCarX],POS[0])),2)
					+floatpower(floatabs(floatsub(HouseInfo[houseid][hCarY],POS[1])),2)
					+floatpower(floatabs(floatsub(HouseInfo[houseid][hCarZ],POS[2])),2));
					if(dist > 20.0) return SendClientMessage(playerid, COLOR_GREEN, "Твоя машина слишком далеко от дома");
					new ctr[256];
					for(new i=0; i<MAX_HOUSECARS; i++)
					{
						f(ctr, "[%d] %s\t%d$\n", i+1, VehicleNames[HouseCars[i][0]-400], HouseCars[i][1]);
						strcat(string, ctr);
					}
					ShowDialog(playerid, HOUSE_ID+12, DIALOG_STYLE_LIST, "Смена модели машины", string, "Выбрать", "Назад");
				}
			case 9:
				{
					new Float:POS[3];
					GetVehiclePos(HouseVehicle[houseid], POS[0], POS[1], POS[2]);
					new Float:dist = floatsqroot(floatpower(floatabs(floatsub(HouseInfo[houseid][hCarX],POS[0])),2)
					+floatpower(floatabs(floatsub(HouseInfo[houseid][hCarY],POS[1])),2)
					+floatpower(floatabs(floatsub(HouseInfo[houseid][hCarZ],POS[2])),2));
					if(dist > 20.0) return SendClientMessage(playerid, COLOR_GREEN, "Твоя машина слишком далеко от дома");
					new stringcolor[2000];
					f(stringcolor, "Введи желаемый номер цвета для вашей машины\n\n\
{FFFFFF}%s%s%s%s%s%s%s\n\n\
{FFFFFF}Стоимость смены цвета машины стоит 200$\
", carcolors[0], carcolors[1], carcolors[2], carcolors[3], carcolors[4], carcolors[5], carcolors[6]);
					ShowDialog(playerid, HOUSE_ID+13, DIALOG_STYLE_INPUT, "Смена цвета машины", stringcolor, "Ок", "Назад");
				}
			case 10:
				{
					new Float:POS[3];
					GetVehiclePos(HouseVehicle[houseid], POS[0], POS[1], POS[2]);
					new Float:dist = floatsqroot(floatpower(floatabs(floatsub(HouseInfo[houseid][hCarX],POS[0])),2)
					+floatpower(floatabs(floatsub(HouseInfo[houseid][hCarY],POS[1])),2)
					+floatpower(floatabs(floatsub(HouseInfo[houseid][hCarZ],POS[2])),2));
					if(dist > 20.0) return SendClientMessage(playerid, COLOR_GREEN, "Твоя машина слишком далеко от дома");
					SendClientMessage(playerid, COLOR_WHITE, "Весь тюнинг твоей домашней машины был удалён");
					RemoveVehicleTuning(HouseVehicle[houseid]);
					SetVehicleToRespawn(HouseVehicle[houseid]);
				}
			case 11:
				{
					ShowDialog(playerid, HOUSE_ID+14, DIALOG_STYLE_LIST, "Продажа своего дома", "\
[1] Продать государству\n\
[2] Продать игроку\
", "Выбрать", "Назад");
				}
			}
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(dialogid == HOUSE_ID+1)
	{
		if(response)
		{
			new houseid = GetDialogHouse[playerid];
			if(PlayerInfo[playerid][pPasport] == 0) return SendClientMessage(playerid, COLOR_GREEN, "У тебя нет паспорта! {CCCCCC}(( /gps --> Гос. Организации ))");
			if(PlayerInfo[playerid][pHouse] != 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже владеешь домом. Продай свой дом для покупки нового");
			if(HouseInfo[houseid][hLevel] >= 99)
			{
				if(PlayerInfo[playerid][pDonat] < 99) return SendClientMessage(playerid, COLOR_GREEN, "Тебе нужно 99 доната, чтобы купить этот дом");
				PlayerInfo[playerid][pDonat] -= 99;
				PlayerInfo[playerid][pHouse] = houseid;
				settext(HouseInfo[houseid][hOwner], PlayerName[playerid]);
				SendClientMessage(playerid, COLOR_WHITE, "Ты успешно купил новый дом за {9DDAF2}99 {FFFFFF}доната");
				GetPlayerHouseVehicle[playerid] = HouseVehicle[houseid];
				UpdateHousePickup(houseid);
				GetDialogHouse[playerid] = -1;
				PlayerInfo[playerid][pSpawn] = 1;
				return true;
			}
			else
			{
				if(PlayerInfo[playerid][pLevel] < HouseInfo[houseid][hLevel] && HouseInfo[houseid][hLevel] == 5) return SendClientMessage(playerid, COLOR_GREEN, "Тебе нужен пятый уровень, чтобы купить дом");
				if(PlayerInfo[playerid][pLevel] < HouseInfo[houseid][hLevel] && HouseInfo[houseid][hLevel] == 6) return SendClientMessage(playerid, COLOR_GREEN, "Тебе нужен шестой уровень, чтобы купить дом");
				if(PlayerInfo[playerid][pLevel] < HouseInfo[houseid][hLevel] && HouseInfo[houseid][hLevel] == 7) return SendClientMessage(playerid, COLOR_GREEN, "Тебе нужен седьмой уровень, чтобы купить дом");
				new money = HouseInfo[houseid][hCost];
				if(GetPlayerMoneyEx(playerid) < money)
				{
					f(string, "У тебя не достаточно денег. Нужно{5BD93B} %d$", money);
					SendClientMessage(playerid, COLOR_GREEN, string);
					return true;
				}
				GivePlayerMoneyEx(playerid, -money);
				PlayerInfo[playerid][pHouse] = houseid;
				PlayerInfo[playerid][pRent] = 0;
				settext(HouseInfo[houseid][hOwner], PlayerName[playerid]);
				f(string, "Ты успешно купил новый дом за{9DDAF2} %d$", HouseInfo[houseid][hCost]);
				SendClientMessage(playerid, COLOR_WHITE, string);
				GetPlayerHouseVehicle[playerid] = HouseVehicle[houseid];
				UpdateHousePickup(houseid);
				GetDialogHouse[playerid] = -1;
			}
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(dialogid == HOUSE_ID+2)
	{
		if(response)
		{
			new houseid = PlayerInfo[playerid][pHouse];
			if(GetBaddingText(inputtext)) return ShowDialog(playerid, HOUSE_ID+2, DIALOG_STYLE_INPUT, "Смена названия", "\
Введи новое название для дома:\n\
{FF0000}Ты указал не корректное название дома!\
", "Ок", "Назад");
			if(strlen(inputtext) < 3 || strlen(inputtext) > 30) return ShowDialog(playerid, HOUSE_ID+2, DIALOG_STYLE_INPUT, "Смена названия", "\
Введи новое название для дома:\n\
{FF0000}Неправильная длина названия дома!\
", "Ок", "Назад");
