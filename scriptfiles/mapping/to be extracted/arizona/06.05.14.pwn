}

stock SendAdminMessage(color, string[])
{
	for(new i=0; i<GetMaxPlayers(); i++) if(IsPlayerConnected(i) && PlayerInfo[i][pAdmin] > 0) SendClientMessage(i, color, string);
	return true;
}

stock SendHelperMessage(color, string[])
{
	for(new i=0; i<GetMaxPlayers(); i++) if(IsPlayerConnected(i) && PlayerInfo[i][pHelper] > 0) SendClientMessage(i, color, string);
	return true;
}

stock SendFamilyMessage(family, color, string[])
{
	for(new i=0; i<GetMaxPlayers(); i++) if(IsPlayerConnected(i) && PlayerInfo[i][pMember] == family) SendClientMessage(i, color, string);
	return true;
}

stock SetPlayerCriminal(playerid, wanted, prest[], policid = INVALID_PLAYER_ID)
{
	if(IsPlayerCop(playerid)) return true;
	new string[128];
	if(policid == INVALID_PLAYER_ID) f(string, "[ рация ] преступление: {FAA039}%s {FF8800}| преступник: {FAA039}%s | сообщил: {FAA039}Неизвестный", prest, PlayerNameEx[playerid]);
	else f(string, "[ рация ] преступление: {FAA039}%s {FF8800}| преступник: {FAA039}%s | сообщил: {FAA039}%s", prest, PlayerNameEx[playerid], PlayerNameEx[policid]);
	SendFamilyMessage(PATRUL_ORG, 0xFF8800FF, string);
	f(string, "Ты совершил преступление: {F5EFA4}%s", prest, PlayerNameEx[playerid]);
	SendClientMessage(playerid, COLOR_YELLOW, string);
	if(PlayerInfo[playerid][pZakon]-wanted >= 0) PlayerInfo[playerid][pZakon] -= wanted;
	else PlayerInfo[playerid][pZakon] = 0;
	if(GetPlayerWantedLevel(playerid) < 6) SetPlayerWantedLevel(playerid, GetPlayerWantedLevel(playerid)+wanted);
	return true;
}

