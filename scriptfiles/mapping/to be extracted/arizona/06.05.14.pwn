				{
					f(string, "\
{FFFF00}Название: {FFFFFF}%s\n\
{FFFF00}Владелец: {FFFFFF}%s\n\
{FFFF00}Номер дома: {FFFFFF}%d\n\
{FFFF00}Район: {FFFFFF}%s",
					HouseInfo[houseid][hName], HouseInfo[houseid][hOwner], houseid, GetHouseZone(houseid));
