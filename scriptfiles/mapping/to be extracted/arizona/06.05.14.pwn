			if(PlayerInfo[giveplayerid][pZam] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок не имеет должность зама");
			f(string, "Ты уволил с должности зама игрока {9DDAF2}%s", PlayerNameEx[giveplayerid]);
			SendClientMessage(playerid, COLOR_WHITE, string);
			f(string, "Лидер {9DDAF2}%s{FFFFFF} уволил тебя с должности зама", PlayerNameEx[playerid]);
			SendClientMessage(giveplayerid, COLOR_WHITE, string);
