			SetPlayerCameraPos(playerid, 208.800, -4.0000, 1001.2000);
			SetPlayerPos(playerid, 208.800, -1.7000, 1001.2100);
			SetPlayerFacingAngle(playerid, 180.0);
			TogglePlayerControllable(playerid, false);
			SetPlayerVirtualWorld(playerid, SKIN_MIR+playerid);
			if(GetOrganizationType(PlayerInfo[playerid][pMember]) == 2)
			{
				f(string, "Ты принял приглашение от игрока {9DDAF2}%s{FFFFFF} вступить в банду {9DDAF2}%s", PlayerNameEx[frakid], GetOrganizationName(PlayerInfo[playerid][pMember]));
				SendClientMessage(playerid, COLOR_WHITE, string);
				f(string, "Игрок {9DDAF2}%s{FFFFFF} принял твоё приглашения вступить в банду {9DDAF2}%s", PlayerNameEx[playerid], GetOrganizationName(PlayerInfo[playerid][pMember]));
				SendClientMessage(frakid, COLOR_WHITE, string);
