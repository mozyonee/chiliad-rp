				CheckpointPizza[2][playerid] = randx;
			}
		case 6:
			{
				if(CheckpointPizza[3][playerid] == 1)
				{
					new randx = random(sizeof(pizzaenter));
					if(CheckpointPizza[2][playerid] == randx)
					{
						if(randx > 0) randx = randx-1;
						else randx = randx+1;
					}
					SetPlayerCheckpointEx(playerid, pizzaenter[randx][0], pizzaenter[randx][1], pizzaenter[randx][2], CHECKPOINT_VEHICLE);
					CheckpointPizza[2][playerid] = randx;
					CheckpointPizza[0][playerid] = 0;
				}
				else
				{
					SetPlayerCheckpointEx(playerid, 1038.2194, -1340.2275, 13.7389, CHECKPOINT_VEHICLE);
					CheckpointPizza[3][playerid] = 1;
				}
			}
		}
		return true;
