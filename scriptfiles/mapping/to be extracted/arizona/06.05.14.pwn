stock ShowPlayerMembersList(playerid, title[], id, bool:mode = false)
{
	new string[512],member_text[256],members;
	if(PlayerInfo[playerid][pLeader] == 0)
	{
		for(new i=0; i<GetMaxPlayers(); i++)
		{
			if(IsPlayerConnected(i))
			{
				if(!mode)
				{
					if(PlayerInfo[i][pMember] == PlayerInfo[playerid][pMember] && PlayerInfo[i][pZam] == 0 && PlayerInfo[i][pLeader] == 0 && i != playerid)
					{
						PlayerMemberName[playerid][members] = i;
						members += 1;
						f(member_text, "[%d] %s\n", members, PlayerNameEx[i]);
						strcat(string, member_text);
					}
				}
				else
				{
					if(PlayerInfo[i][pMember] == PlayerInfo[playerid][pMember] && PlayerInfo[i][pLeader] == 0)
					{
						if(PlayerInfo[i][pZam] != 0 && i == playerid)
						{
							PlayerMemberName[playerid][members] = i;
							members += 1;
							f(member_text, "[%d] %s\n", members, PlayerNameEx[i]);
							strcat(string, member_text);
						}
						else if(PlayerInfo[i][pZam] == 0)
						{
							PlayerMemberName[playerid][members] = i;
							members += 1;
							f(member_text, "[%d] %s\n", members, PlayerNameEx[i]);
							strcat(string, member_text);
						}
					}
				}
			}
		}
	}
	else
	{
		for(new i=0; i<GetMaxPlayers(); i++)
		{
			if(IsPlayerConnected(i))
			{
				if(!mode)
				{
					if(PlayerInfo[i][pMember] == PlayerInfo[playerid][pMember] && i != playerid)
					{
						PlayerMemberName[playerid][members] = i;
						members += 1;
						f(member_text, "[%d] %s\n", members, PlayerNameEx[i]);
						strcat(string, member_text);
					}
				}
				else
				{
					if(PlayerInfo[i][pMember] == PlayerInfo[playerid][pMember])
					{
						PlayerMemberName[playerid][members] = i;
						members += 1;
						f(member_text, "[%d] %s\n", members, PlayerNameEx[i]);
						strcat(string, member_text);
					}
				}
			}
		}
	}
	if(members == 0)
	{
		f(string, "{FF0000}Членов фракции онлайн не найдено");
		PlayerMembersList[playerid] = false;
	}
	else
	{
		PlayerMembersList[playerid] = true;
	}
	ShowDialog(playerid, ORGAN_ID+id, DIALOG_STYLE_LIST, title, string, "Выбрать", "Назад");
	return true;
}

