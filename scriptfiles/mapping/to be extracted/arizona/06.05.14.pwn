stock LoadTuning()
{
	if(!fexist("tunings.cfg")) return printf("file 'tunings.cfg' not found");
	new arrCoords[16][64],strFromFile[256],car;
	new File:GetFile = fopen("tunings.cfg");
	while(fread(GetFile, strFromFile))
	{
		if(!strlen(strFromFile)) break;
		split(strFromFile, arrCoords, '|');
		car = strval(arrCoords[0]);
		for(new i=0; i<15; i++) TuningInfo[car][i] = strval(arrCoords[i+1]);
	}
	fclose(GetFile);
	return true;
}

stock SaveTuning()
{
	if(!fexist("tunings.cfg")) return printf("file 'tunings.cfg' not found");
	new string[256],File:GetFile = fopen("tunings.cfg", io_write);
	for(new i=0; i<MAX_VEHICLES; i++)
	{
		if(VehicleInfo[i][vBuyed] == 0 && GetVehicleHouse[i] == 0) continue;
		if(!GetVehicleComponents(i)) continue;
		f(string, "%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d\n",i,
