				{
					strcat(text, "{FFFFFF}Для начала поставки,вам нужно сесть в грузовик и ввести команду /carm.\n");
					strcat(text, "после чего появится красный маркер,езжайте к нему.\n");
					strcat(text, "По приезду,вам нужно выйти из грузовика и зайти в ангар направляясь к маркеру.\n");
					strcat(text, "Там вы получите ящик с материалами,вам нужно его отнести к грузовику. \n");
					strcat(text, "Как только вы набрали нужное количество маттериалов,повторно введите команду /carm.\n");
					strcat(text, "После чего отправляйтесь на базу куда вам и показывает маркер.\n");
					strcat(text, "По прибытию начните выгружать грузовик.\n");
					strcat(text, "Подойдите к задней части грузовика и введите команду /boot. Берите минимум 300 материалов!\n");
					ShowDialog(playerid, HELP_ID+43, DIALOG_STYLE_MSGBOX, "Поставка материалов для Армии.", text, "Назад", "Закрыть");
				}
				case 2:
				{
					strcat(text, "{FFFFFF}Для начала карьеры вам предстоит начать с самых низов,а именно начать работу по сбору сена.\n");
					strcat(text, "Собирая сено вы зарабатываете не только деньги но очки для карьеры.\n");
					strcat(text, "После того как вы наберете достаточное количество очко, для следуещего повышения,\n");
					strcat(text, "вы сможете работать трактористом или комбайнером,где зарплата уже выше.\n");
					strcat(text, "Так же существует фракция Фермеры,она следит за работой фермы,в нее вы так же можете вступить.\n");
					strcat(text, "А теперь о процесе выполнения: ((Смотрите в следующей теме))");
					ShowDialog(playerid, HELP_ID+44, DIALOG_STYLE_MSGBOX, "Карьера фермера[1].", text, "Назад", "Закрыть");
				}
				case 3:
				{
					strcat(text, "1. Для начала сборки сена вам следует устроится на работу фермера,далее пройдите в раздевалку и переоденьтесь.\n");
					strcat(text, "После чего бегите к красному маркеру собрать сено,после несите его на сеновал.\n");
					strcat(text, "Для завершения работы,просто зайдите в раздевалку и переоденьтесь.\n");
					strcat(text, "2. Для начала работы тракторист,вам требуется 500 очков фермерства,их можно посмотреть в меню ''y''.\n");
					strcat(text, "Далее устраиваетесь трактористом,садитесь в трактор и вводите команду /tractor,после чего следуете\n");
					strcat(text, "по красным маркерам.Что бы закончить работу,введите команду /tractor. Когда вы сделаете впечатление , вас смогут принять в фракцию");
					ShowDialog(playerid, HELP_ID+44, DIALOG_STYLE_MSGBOX, "Карьера фермера[2].", text, "Назад", "Закрыть");
				}
			}
		}
		else
