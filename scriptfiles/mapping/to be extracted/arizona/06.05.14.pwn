				if(Checkpoint[AMMO_JOB][playerid] == 1 || !IsPlayerInRaceCheckpoint(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не достиг места загрузки");
				if(Checkpoint[AMMO_JOB][playerid] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не начал работу гандиллера");
				if(Checkpoint[AMMO_JOB][playerid] == 3 || Checkpoint[AMMO_JOB][playerid] == 4 || Checkpoint[AMMO_JOB][playerid] == 5 || Checkpoint[AMMO_JOB][playerid] == 999) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже загрузил фургон");
				if(Checkpoint[AMMO_JOB][playerid] == 2)
