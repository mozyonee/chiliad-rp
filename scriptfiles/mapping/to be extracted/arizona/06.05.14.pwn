			new vehicleid = PlayerInfo[playerid][pVehicle];
			if(strval(inputtext) < 0 || strval(inputtext) > 127) return SendClientMessage(playerid, COLOR_GREEN, "Ты указал не корректный цвет машины");
			if(GetPlayerMoneyEx(playerid) < 200) return SendClientMessage(playerid, COLOR_GREEN, "У тебя не достаточно денег. Нужно{5BD93B} 200$");
			GivePlayerMoneyEx(playerid, -200);
			VehicleInfo[vehicleid][vColor] = strval(inputtext);
