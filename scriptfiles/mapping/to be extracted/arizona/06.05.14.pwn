						if(Checkpoint[GASTRUCK_JOB][playerid] == 1 || !IsPlayerInRaceCheckpoint(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты не достиг места разгрузки");
						if(Checkpoint[GASTRUCK_JOB][playerid] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не начал работу бензовозчика");
						if(Checkpoint[GASTRUCK_JOB][playerid] == 3) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже разгрузил прицеп");
						if(Checkpoint[GASTRUCK_JOB][playerid] == 2)
						{
							DisablePlayerRaceCheckpoint(playerid);
							TogglePlayerControllable(playerid, false);
							SendClientMessage(playerid, COLOR_WHITE, "Разгрузка прицепа началась...");
							SetTimerEx("RazgruzGasTruck", 20000, false, "i", playerid);
