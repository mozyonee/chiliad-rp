	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/load", true))
	{
		if(PlayerInfo[playerid][pJob] != COLLECTOR_JOB
				&& PlayerInfo[playerid][pJob] != AMMO_JOB
				&& PlayerInfo[playerid][pJob] != STICK_JOB) return SendClientMessage(playerid, COLOR_GREEN, "Ты не устроился на ту работу, где можно использовать эту команду");
