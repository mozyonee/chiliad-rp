					DisablePlayerRaceCheckpoint(playerid);
					TogglePlayerControllable(playerid, false);
					SendClientMessage(playerid, COLOR_WHITE, "Загрузка фургона началась...");
					SetTimerEx("ZagruzStick1", 10000, false, "i", playerid);
					Checkpoint[STICK_JOB][playerid] = 888;
					return true;
				}
				if(Checkpoint[STICK_JOB][playerid] == 102)
				{
					if(GetStickOnSklad < 300)
					{
						EndPlayerCasualJob(playerid);
						SendClientMessage(playerid, COLOR_GREEN, "На складе не хватает мебели");
						return true;
					}
					DisablePlayerRaceCheckpoint(playerid);
					TogglePlayerControllable(playerid, false);
					SendClientMessage(playerid, COLOR_WHITE, "Загрузка фургона началась...");
					SetTimerEx("ZagruzStick2", 10000, false, "i", playerid);
					Checkpoint[STICK_JOB][playerid] = 888;
					return true;
				}
			}
			else
			{
				SendClientMessage(playerid, COLOR_GREEN, "Ты должен находиться в фургоне и быть за рулём");
			}
			return true;
		}
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/setspawn", true))
	{
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
		{
			SendClientMessage(playerid, COLOR_GREEN, "» Использование: /setspawn [ тип спавна ]");
			SendClientMessage(playerid, COLOR_GRAY, "| 1: Отель Fort Carson ");
			SendClientMessage(playerid, COLOR_GRAY, "| 2: Личный/арендованный дом");
			SendClientMessage(playerid, COLOR_GRAY, "| 3: База организации");
			return true;
		}
		new spawn = strval(tmp);
		if(spawn < 1 || spawn > 4) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верный тип спавна. Используй тип от 1 до 3");
		if(PlayerInfo[playerid][pSpawn] == spawn-1) return SendClientMessage(playerid, COLOR_GREEN, "У тебя уже установлено это место спавна");
		if(spawn == 1)
		{
			SendClientMessage(playerid, COLOR_WHITE, "Твоё новое место спавна: {9DDAF2}Автовокзал Red Country");
			PlayerInfo[playerid][pSpawn] = 0;
		}
		else if(spawn == 2)
		{
			if(PlayerInfo[playerid][pHouse] == 0 && PlayerInfo[playerid][pRent] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не имеешь личного или арендованого дома");
			SendClientMessage(playerid, COLOR_WHITE, "Твоё новое место спавна: {9DDAF2}Личный/арендованный");
			PlayerInfo[playerid][pSpawn] = 1;
		}
		else if(spawn == 3)
		{
			if(PlayerInfo[playerid][pMember] == 0) return SendClientMessage(playerid, COLOR_GREEN, "Ты не состоишь в какой-либо фракции");
			SendClientMessage(playerid, COLOR_WHITE, "Твоё новое место спавна: {9DDAF2}База организации");
			PlayerInfo[playerid][pSpawn] = 2;
		}
		return true;
	}

