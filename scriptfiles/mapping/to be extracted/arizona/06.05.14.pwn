		if(PlayerInfo[playerid][pLeader] == 0 && PlayerInfo[playerid][pRank] < 6) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен быть лидером или замом, чтобы использовать меню лидера");
		SendClientMessage(playerid, COLOR_GREEN, "» Использование: /lmenu > Уволить игрока");
		return true;
	}

	//------------------------------------------------------------------------------

	else if(!strcmp(cmd, "/duel", true))
	{
		if(PlayerCuffed[playerid] || PlayerTied[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Находясь в наручниках или связанным, ты не можешь пригласить игрока на дуэль");
		if(EnableJobCheckpoint(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Ты должен сначала закончить работу");
		if(PlayerInDuel[playerid]) return SendClientMessage(playerid, COLOR_GREEN, "Ты уже участвуешь в дуэли");
		tmp = strtok(cmdtext, idx);
	  	if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /duel [ id игрока ] [ ставка ]");
	  	giveplayerid = strval(tmp);
	  	tmp = strtok(cmdtext, idx);
	  	if(!strlen(tmp)) return SendClientMessage(playerid, COLOR_GREEN, "» Использование: /duel [ id игрока ] [ ставка ]");
	  	new price = strval(tmp);
	  	if(price < 1 || price > 100000) return SendClientMessage(playerid, COLOR_GREEN, "Ты ввёл не верную сумму ставки. Используй сумму от 1$ до 100000$");
	  	if(price > GetPlayerMoneyEx(playerid)) return SendClientMessage(playerid, COLOR_GREEN, "Тебе не хватает на ставку. Укажи другую сумму");
		if(IsPlayerConnected(giveplayerid))
	  	{
	  	    if(playerid == giveplayerid) return MSG_NOMEACT(playerid);
	        if(GetDistancePlayers(playerid, giveplayerid) > 5.0) return MSG_BIGDIST(playerid);
		  	if(PlayerInDuel[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок уже участвует в дуэли");
	  	    if(price > GetPlayerMoneyEx(giveplayerid)) return SendClientMessage(playerid, COLOR_GREEN, "Твоему противнику не хватает на ставку. Укажи другую сумму");
			if(PlayerCuffed[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок находится в наручниках");
			if(PlayerTied[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок связан");
	  		if(PlayerConvoi[giveplayerid]) return SendClientMessage(playerid, COLOR_GREEN, "Этот игрок находится под конвоем");
		 	GetPlayerTransfer[giveplayerid] = playerid;
			GetPlayerOption[giveplayerid] = price;
	        f(string, "Ты успешно пригласил игрока {9DDAF2}%s{FFFFFF} на дуэль! Дождись ответа.", PlayerNameEx[giveplayerid]);
	        SendClientMessage(playerid, COLOR_WHITE, string);
	        f(string, "\
			Игрок %s приглашает тебя на дуэль.\n\
			Ставка: %d$\
			", PlayerNameEx[playerid], price);
	        ShowDialog(giveplayerid, DUEL_ID, DIALOG_STYLE_MSGBOX, "Приглашение на дуэль", string, "Да", "Нет");
      	}
	  	else
  		{
		  	MSG_NOTPLAYER(playerid);
	  	}
	  	return 1;
	}

	else if(!strcmp(cmd, "/licon", true))
	{
		new lic_text[256],bool:licons;
		for(new i=0; i<GetMaxPlayers(); i++)
