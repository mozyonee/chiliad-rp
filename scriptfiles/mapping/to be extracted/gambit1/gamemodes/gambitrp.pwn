forward WoodsPlayer(playerid,wood,selected);
public WoodsPlayer(playerid,wood,selected) {
	new j = GetPVarInt(playerid,"WoodDrop");
	switch(selected) {//-462.9798,-88.4665,59.9006
	    case 0: {
	        WD::[j][woodIsDrop] = true;
	        WD::[j][woodUse] = false;
	        MoveDynamicObject(WD::[j][woodObject],WoodsDrop[j][0],WoodsDrop[j][1],WoodsDrop[j][2] - 0.05, 0.05, WoodsDrop[j][3],WoodsDrop[j][4],WoodsDrop[j][5]);
	        SendClientMessage(playerid,C_GRAY,""gbInfo"Чтобы напилить ещё дров, подойдите к основанию дерева.");
            RemovePlayerAttachedObject(playerid,9);
			SetPlayerAttachedObject(playerid,9,1463,5,0.073999,0.186000,0.105998,95.299972,-175.499984,-72.199935,0.540999,0.350999,0.610999);
	        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
			SetPVarInt(playerid,"PlayerUseBox",5);
            WD::[j][woodCount] -= 25;
			SetPVarInt(playerid,"WoodCheckpointTop",_:SetPlayerCheckpoint(playerid,-462.9798,-88.4665,59.9006,1.0));
	    }
	    case 1: {
            RemovePlayerAttachedObject(playerid,9);
			SetPlayerAttachedObject(playerid,9,1463,5,0.073999,0.186000,0.105998,95.299972,-175.499984,-72.199935,0.540999,0.350999,0.610999);
	        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
	        SetPVarInt(playerid,"PlayerUseBox",5);
	        SetPVarInt(playerid,"WoodCheckpointTop",_:SetPlayerCheckpoint(playerid,-462.9798,-88.4665,59.9006,1.0));
	        if(WD::[j][woodCount] == 0) {
		   		DestroyDynamicObject(WD::[j][woodObject]);
    		}
	    }
	}
	togglePlayerControllable(playerid,true);
	DeletePVar(playerid,"WoodDrop");
	return 1;
}

