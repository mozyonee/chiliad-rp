				mysql_tquery(1, query, "ListForFrac", "dd", playerid, listitem);
			}
			else {
				SetPVarInt(playerid,"pageFrac",GetPVarInt(playerid,"pageFrac") + 1);
				new list = GetPVarInt(playerid,"pageFrac") * 10;
				format(query,sizeof(query),"SELECT uName,uRank FROM gb_users WHERE uMember = '%d' LIMIT %d,10",Player[playerid][uMember],list);
