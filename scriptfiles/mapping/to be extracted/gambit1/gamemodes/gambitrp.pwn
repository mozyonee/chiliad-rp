				}
			}
		}
		if(i >= sherifcar[0] && i <= sherifcar[1] || i >= sasd_car[0] && i <= sasd_car[1] ) {
			V::[i][vHealth] = 1000.0;
			V::[i][vFuel] = MaxVehicleFuel[GetVehicleModel(i) - 400];
			switch(GetVehicleModel(i)) {
				case 599: {
					V::[i][vInvSlot][0] = 434,V::[i][vInvSlot][1] = 435,V::[i][vInvSlot][2] = 436,V::[i][vInvSlot][3] = 437;
					V::[i][vInvSlotKol][0] = 1,V::[i][vInvSlotKol][1] = 1,V::[i][vInvSlotKol][2] = 1,V::[i][vInvSlotKol][3] = 1;
				}
				case 598:
				{
				    V::[i][vInvSlot][0] = 433,V::[i][vInvSlot][1] = 433,V::[i][vInvSlot][2] = 434,V::[i][vInvSlot][3] = 435,V::[i][vInvSlot][4] = 436,V::[i][vInvSlot][5] = 437;
					V::[i][vInvSlotKol][0] = 1,V::[i][vInvSlotKol][1] = 1,V::[i][vInvSlotKol][2] = 1,V::[i][vInvSlotKol][3] = 1,V::[i][vInvSlotKol][4] = 1,V::[i][vInvSlotKol][5] = 1;
				    //439
				}
				default: {
					V::[i][vInvSlot][0] = 434,V::[i][vInvSlot][1] = 435,V::[i][vInvSlot][2] = 436,V::[i][vInvSlot][3] = 437;
					V::[i][vInvSlotKol][0] = 1,V::[i][vInvSlotKol][1] = 1,V::[i][vInvSlotKol][2] = 1,V::[i][vInvSlotKol][3] = 1;
				}
			}
		}
		if(i >= medicalcar[0] && i <= medicalcar[1])
		{
			V::[i][vHealth] = 1000.0;
			V::[i][vFuel] = MaxVehicleFuel[GetVehicleModel(i) - 400];
			switch(GetVehicleModel(i))
			{
				case 416, 426, 482:
				{
					V::[i][vInvSlot][0] = 451,V::[i][vInvSlot][1] = 451,V::[i][vInvSlot][2] = 451,
					V::[i][vInvSlot][3] = 435,V::[i][vInvSlot][4] = 435,V::[i][vInvSlot][5] = 435,
					V::[i][vInvSlot][6] = 450,V::[i][vInvSlot][7] = 442;

					V::[i][vInvSlotKol][0] = 1,V::[i][vInvSlotKol][1] = 1,V::[i][vInvSlotKol][2] = 1,
					V::[i][vInvSlotKol][3] = 1,V::[i][vInvSlotKol][4] = 1,V::[i][vInvSlotKol][5] = 1,
					V::[i][vInvSlotKol][6] = 1,V::[i][vInvSlotKol][7] = 1;
				}
			}
		}
		if(i >= smicars[0] && i <= smicars[1]) {
			V::[i][vHealth] = 1000.0;
			V::[i][vFuel] = MaxVehicleFuel[GetVehicleModel(i) - 400];
			switch(GetVehicleModel(i)) {
				case 551: {
					V::[i][vInvSlot][0] = 341,V::[i][vInvSlot][1] = 341,V::[i][vInvSlot][2] = 341,V::[i][vInvSlot][3] = 341,V::[i][vInvSlot][4] = 434,V::[i][vInvSlot][5] = 435,V::[i][vInvSlot][6] = 437;
					V::[i][vInvSlotKol][0] = 100,V::[i][vInvSlotKol][1] = 100,V::[i][vInvSlotKol][2] = 100,V::[i][vInvSlotKol][3] = 100,V::[i][vInvSlotKol][4] = 2,V::[i][vInvSlotKol][5] = 1,V::[i][vInvSlotKol][6] = 1;
				}
				case 582: {
					V::[i][vInvSlot][0] = 341,V::[i][vInvSlot][1] = 341,V::[i][vInvSlot][2] = 434,V::[i][vInvSlot][3] = 435,V::[i][vInvSlot][4] = 437;
					V::[i][vInvSlotKol][0] = 100,V::[i][vInvSlotKol][1] = 100,V::[i][vInvSlotKol][2] = 2,V::[i][vInvSlotKol][3] = 1,V::[i][vInvSlotKol][4] = 1;
				}
			}
		}
		if(i >= meria[0] && i <= meria[1]) {
		    V::[i][vHealth] = 1000.0;
			V::[i][vFuel] = MaxVehicleFuel[GetVehicleModel(i) - 400];
		}
		if(i >= comm[0] && i <= comm[1]) {
		    V::[i][vHealth] = 1000.0;
			V::[i][vFuel] = MaxVehicleFuel[GetVehicleModel(i) - 400];
		}
		V::[i][vRentCar][0] = -1;
		if(i >= carsalon[0][0] && i <= carsalon[1][0]) {
		    V::[i][vRentCar][0] = 0;
		    V::[i][vHealth] = 1000.0;
			V::[i][vFuel] = MaxVehicleFuel[GetVehicleModel(i) - 400];
		}
        if(i >= carsalon[0][1] && i <= carsalon[1][1]) {
		    V::[i][vRentCar][0] = 0;
		    V::[i][vHealth] = 1000.0;
			V::[i][vFuel] = MaxVehicleFuel[GetVehicleModel(i) - 400];
		}
		if(i >= carsalon[0][2] && i <= carsalon[1][2]) {
		    V::[i][vRentCar][0] = 0;
		    V::[i][vHealth] = 1000.0;
			V::[i][vFuel] = MaxVehicleFuel[GetVehicleModel(i) - 400];
		}
		if(i >= carsalon[0][3] && i <= carsalon[1][3]) {
		    V::[i][vRentCar][0] = 0;
		    V::[i][vHealth] = 1000.0;
			V::[i][vFuel] = MaxVehicleFuel[GetVehicleModel(i) - 400];
		}
		V::[i][vBuyingCar] = -1;
		GetVehicleParamsEx(i,eng,light,other1,other2,other3,other4,other5);
		SetVehicleParamsEx(i,false,light,other1,other2,other3,other4,other5);
	}
	
	//mysql_tquery(1, "SELECT * FROM `gb_cars` ORDER BY `cID`", "MySQLQuery", "dd", 0, 6);
	mysql_tquery(1, "SELECT * FROM `gb_frac` ORDER BY `fID`", "MySQLQuery", "dd", 0, 7);
	mysql_tquery(1, "SELECT * FROM `gb_others`", "MySQLQuery", "dd", 0, 8);

	format(gb_string,sizeof(gb_string),"Древесина\n{ffffff}%d кг.",S::[0][wsWoods]);
	S::[0][wsWoodsT] = CreateDynamic3DTextLabel(gb_string,C_BLUE,-1969.3164,-2397.6604,774.8055,10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
	format(gb_string,sizeof(gb_string),"Обработанная древесина\n{ffffff}%d кг.",S::[0][wsWoodsSklad]);
	S::[0][wsWoodsTS][0] = CreateDynamic3DTextLabel(gb_string,C_BLUE,-1964.4370,-2407.4546,773.8900,10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
	format(gb_string,sizeof(gb_string),"Обработанная древесина\n{ffffff}%d кг.",S::[0][wsWoodsSklad]);
	S::[0][wsWoodsTS][1] = CreateDynamic3DTextLabel(gb_string,C_BLUE,-496.0325,-82.4771,61.2981,10.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);

	format(gb_string,sizeof(gb_string),"Завод мебели\n\n{ffffff}Мебель: %d ед.\nДревесины: %d ед.",MebelZavod,WoodsZavod);
	InfoFermText[7] = CreateDynamic3DTextLabel(gb_string,C_BLUE,-18.9291,-273.3552,5.4297,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
	format(gb_string,sizeof(gb_string),"Нефтеперерабатывающий завод\n\n{ffffff}Топливо: %d л.",ToplivoZavod);
	InfoFermText[8] = CreateDynamic3DTextLabel(gb_string,C_BLUE,248.2978,1420.6721,10.5727,20.0,INVALID_PLAYER_ID,INVALID_VEHICLE_ID,1);
	
    //#include "../include/object1s.inc"
    //LoadObjectList();
    #include "../include/textdraws.inc"
	return 1;
}

