public OnPlayerPressButton(playerid,buttonid) {
	if(buttonid == gDoorsButton[0] || buttonid == gDoorsButton[1]) {
		if(Player[playerid][uMember] != 2) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет ключа для открытия данной двери!");
		MoveDynamicObject(gDoors[0], 1552.25488, -1671.65527, 1099.50562, 1.0,0.00000, 0.00000, 0.00000);
		SetTimerEx("CloseDoors",10000,false,"i",0);
	}
	if(buttonid == gDoorsButton[2] || buttonid == gDoorsButton[3]) {
		if(Player[playerid][uMember] != 2) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет ключа для открытия данной двери!");
		MoveDynamicObject(gDoors[1], 1552.23499, -1682.53528, 1099.50562, 1.0,0.00000, 0.00000, 0.00000);
		SetTimerEx("CloseDoors",10000,false,"i",1);
	}
	if(buttonid == gDoorsButton[4] || buttonid == gDoorsButton[5]) {
		if(Player[playerid][uMember] != 2) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет ключа для открытия данной двери!");
		MoveDynamicObject(gDoors[2], 1552.85889, -1686.27502, 1098.23999, 1.0, 0.00000, 0.00000, 90.00000);
		SetTimerEx("CloseDoors",10000,false,"i",2);
	}
	if(buttonid == gDoorsButton[8] || buttonid == gDoorsButton[9]) {
		if(Player[playerid][uMember] != 2) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет ключа для открытия данной двери!");
		MoveDynamicObject(gDoors[4], 1577.08997, -1686.29504, 1098.23999, 1.0, 0.00000, 0.00000, 90.00000);
		SetTimerEx("CloseDoors",10000,false,"i",4);
	}
	if(buttonid == gDoorsButton[6] || buttonid == gDoorsButton[7]) {
