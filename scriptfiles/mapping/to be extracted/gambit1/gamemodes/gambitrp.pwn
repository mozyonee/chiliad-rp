				case 1: showPlayerDialog(playerid,d_frac + 6,1," ","{ffffff}Введите ID человека которого хотите уволить из организации:\n\n","Далее","Закрыть");
				case 2: showPlayerDialog(playerid,d_frac + 7,1," ","{ffffff}Введите ID человека которого хотите повысить в должности:\n\n","Далее","Закрыть");
				case 3: {
					format(query,sizeof(query),"SELECT uName,uRank FROM gb_users WHERE uMember = '%d' LIMIT 10",Player[playerid][uMember]);
