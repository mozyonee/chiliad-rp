stock showPhone(playerid)
{
    switch(_itemsInfo[Inv[playerid][invSlot][55]][invObject])
	{
        case 18874: TextDrawShowForPlayer(playerid,phoneFonOne[0]);
        case 18871: TextDrawShowForPlayer(playerid,phoneFonOne[1]);
        case 18872: TextDrawShowForPlayer(playerid,phoneFonOne[2]);
        case 18869: TextDrawShowForPlayer(playerid,phoneFonTwo[0]);
        case 18870: TextDrawShowForPlayer(playerid,phoneFonTwo[1]);
        case 18866: TextDrawShowForPlayer(playerid,phoneFonTwo[2]);
        case 18865: TextDrawShowForPlayer(playerid,phoneFonThree[0]);
        case 18868: TextDrawShowForPlayer(playerid,phoneFonThree[1]);
        case 18867: TextDrawShowForPlayer(playerid,phoneFonThree[2]);
        default: return SendClientMessage(playerid,C_GRAY,""gbError"Простите, но у Вас нет телефона!");
    }
    switch(_itemsInfo[Inv[playerid][invSlot][55]][invObject]) {
        case 18874,18871,18872: for(new i = 1; i != 28; i++) TextDrawShowForPlayer(playerid,phoneOne[i]);
        case 18869,18870,18866: for(new i = 1; i != 19; i++) TextDrawShowForPlayer(playerid,phoneTwo[i]);
        case 18865,18868,18867: for(new i = 1; i != 19; i++) TextDrawShowForPlayer(playerid,phoneThree[i]);
    }
    new y,m,d,string[11];
    getdate(y,m,d);
    format(string,sizeof(string),"%02d/%02d/%d",d,m,y);
    TextDrawSetString(phoneThree[7],string);
    TextDrawSetString(phoneOne[22],string);
    SetPVarInt(playerid,"PlayerMenuShow",5);
    SelectTextDraw(playerid, 0xd3d3d3FF);
    SetPlayerSpecialAction(playerid,SPECIAL_ACTION_USECELLPHONE);
	SetPlayerAttachedObject(playerid,3,_itemsInfo[Inv[playerid][invSlot][55]][invObject],6,0.107999,0.015000,-0.016000,97.100006,-165.800048,-3.000013);
	MeAction(playerid,"достал(-а) сотовый телефон",1);
	return 1;
}

stock PhoneStatus(playerid,bool:status) {
	if(status == true) {
		if(GetPVarInt(playerid,"PlayerMenuShow") == 5) CancelSelectTextDraw(playerid);
		else {
			SetPlayerSpecialAction(playerid,SPECIAL_ACTION_USECELLPHONE);
			SetPlayerAttachedObject(playerid,3,_itemsInfo[Inv[playerid][invSlot][55]][invObject],6,0.107999,0.015000,-0.016000,97.100006,-165.800048,-3.000013);
			MeAction(playerid,"достал(-а) сотовый телефон",1);
		}
	}
	else {
		if(GetPVarInt(playerid,"PlayerMenuShow") == 5) SelectTextDraw(playerid, 0xd3d3d3FF);
		else {
			SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
	        RemovePlayerAttachedObject(playerid,3);
		}
	}
}

stock hidePhone(playerid) {
	switch(_itemsInfo[Inv[playerid][invSlot][55]][invObject]) {
        case 18874: TextDrawHideForPlayer(playerid,phoneFonOne[0]);
        case 18871: TextDrawHideForPlayer(playerid,phoneFonOne[1]);
        case 18872: TextDrawHideForPlayer(playerid,phoneFonOne[2]);
        case 18869: TextDrawHideForPlayer(playerid,phoneFonTwo[0]);
        case 18870: TextDrawHideForPlayer(playerid,phoneFonTwo[1]);
        case 18866: TextDrawHideForPlayer(playerid,phoneFonTwo[2]);
        case 18865: TextDrawHideForPlayer(playerid,phoneFonThree[0]);
        case 18868: TextDrawHideForPlayer(playerid,phoneFonThree[1]);
        case 18867: TextDrawHideForPlayer(playerid,phoneFonThree[2]);
        default: return SendClientMessage(playerid,C_GRAY,""gbError"Простите, но у Вас нет телефона!");
    }
    switch(_itemsInfo[Inv[playerid][invSlot][55]][invObject]) {
        case 18874,18871,18872: for(new i = 1; i != 28; i++) TextDrawHideForPlayer(playerid,phoneOne[i]);
        case 18869,18870,18866: for(new i = 1; i != 19; i++) TextDrawHideForPlayer(playerid,phoneTwo[i]);
        case 18865,18868,18867: for(new i = 1; i != 19; i++) TextDrawHideForPlayer(playerid,phoneThree[i]);
    }
    SetPVarInt(playerid,"PlayerMenuShow",0);
    SetPlayerSpecialAction(playerid,SPECIAL_ACTION_STOPUSECELLPHONE);
	RemovePlayerAttachedObject(playerid,3);
    CancelSelectTextDraw(playerid);
    MeAction(playerid,"убрал(-а) сотовый телефон",1);
    return 1;
}

stock Hunger(playerid,type) {
	switch(type) {
	    case 0: {
			TextDrawShowForPlayer(playerid,HungerFon[0]);
			TextDrawShowForPlayer(playerid,HungerFon[1]);
			PlayerTextDrawTextSize(playerid,HungerProgres[playerid], 549.5 + Player[playerid][uHunger] / 100.0 * 54.5, 40.000000);
			PlayerTextDrawShow(playerid,HungerProgres[playerid]);
		}
		case 1: {
			PlayerTextDrawHide(playerid,HungerProgres[playerid]);
			TextDrawHideForPlayer(playerid,HungerFon[0]);
			TextDrawHideForPlayer(playerid,HungerFon[1]);
		}
	}
}

stock SaveAllProducts() 
{
	format:vb_string( "UPDATE gb_others SET sProducts = %d,MebelZavod = %d,WoodsZavod = %d,ToplivoZavod = %d,wsWoodsSklad = %d,wsWoods = %d",
	S::[0][sProducts],MebelZavod,WoodsZavod,ToplivoZavod,S::[0][wsWoodsSklad],S::[0][wsWoods]);
	mysql_tquery(1, vb_string, "", "");
	return 1;
}

stock showInventory(playerid) {
	clear_massive();
	if(GetPVarInt(playerid,"PlayerMenuShow") != 0) return 1;
	if(GetPVarInt(playerid,"PlayerCameraHouse") != 0) return 1;
	new Float:X, Float:Y, Float:Z, Float:R, Float:X2, Float:Y2,Float:health,Float:armour,bool:camera = true,string[128],Float:p[4];
	if(IsPlayerInAnyVehicle(playerid))
	{
		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER)
		{
			if(Player[playerid][uSettings][0] == 1)
			{
				for(new i; i != 3; i++) TextDrawHideForPlayer(playerid, SpeedFon[i]);
				for(new i; i != 8; i++) PlayerTextDrawHide(playerid,Speed[i][playerid]);
			}
		}
		camera = false;
	}
	SetPVarInt(playerid,"PlayerMenuShow",4);
	GetPlayerHealth(playerid,health);
	GetPlayerArmour(playerid,armour);
	SelectTextDraw(playerid,0xd3d3d3FF);
	new Float:kg;
	for(new i; i != 56; i++) kg += _itemsInfo[Inv[playerid][invSlot][i]][invKg];
	format(string,sizeof(string),"~y~%s~n~~w~%.1f/%.0f.0kg",Player[playerid][uName],kg,MAX_PLAYER_KG + Player[playerid][uJobDouble][6]);
	PlayerTextDrawSetString(playerid,invSPlayer[playerid][58],string);
	format(string,sizeof(string),"%.0f%",health);
	PlayerTextDrawSetString(playerid,invSPlayer[playerid][59],string);
	format(string,sizeof(string),"%.0f%",armour);
	PlayerTextDrawSetString(playerid,invSPlayer[playerid][60],string);
	PlayerTextDrawTextSize(playerid,invSPlayer[playerid][56], 224.4+health/100.0*190.0, -31.000000);
	PlayerTextDrawTextSize(playerid,invSPlayer[playerid][57], 224.4+armour/100.0*190.0, -31.000000);
	for(new i; i < 56; i++) {
		if(Inv[playerid][invSlot][i] == 0) PlayerTextDrawSetPreviewModel(playerid, invSPlayer[playerid][i], 19464),PlayerTextDrawSetPreviewRot(playerid, invSPlayer[playerid][i], 0.000000, 0.000000, 90.000000, 0.100000),PlayerTextDrawBackgroundColor(playerid,invSPlayer[playerid][i], 255);
		else PlayerTextDrawSetPreviewModel(playerid,invSPlayer[playerid][i], _itemsInfo[Inv[playerid][invSlot][i]][invObject]),PlayerTextDrawSetPreviewRot(playerid, invSPlayer[playerid][i], _itemsInfo[Inv[playerid][invSlot][i]][invP][0], _itemsInfo[Inv[playerid][invSlot][i]][invP][1], _itemsInfo[Inv[playerid][invSlot][i]][invP][2], _itemsInfo[Inv[playerid][invSlot][i]][invP][3]),PlayerTextDrawBackgroundColor(playerid,invSPlayer[playerid][i], 0xd3d3d3FF);
	}
	PlayerTextDrawSetSelectable(playerid,invSPlayer[playerid][52], 1);
 	if(Player[playerid][uIsPlayerJob][0] == 1 || Player[playerid][uIsPlayerJob][1] == 1 || Player[playerid][uIsPlayerJob][2] == 1 || D::[playerid][dWoodsDuty] != 0 ) PlayerTextDrawSetSelectable(playerid,invSPlayer[playerid][52], 0);
	checkHouseInventory( playerid );
	if( getData( playerid, "HInv:ID" ) ) camera = false;
	//общаки мафий!

	for(new i; i < MAX_VEHICLES; i++ ) 
	{
 		if( !IsValidVehicle( i ) ) 
			continue;
			
 		if( GetPlayerVirtualWorld(playerid) != GetVehicleVirtualWorld( i ) ) 
			continue;
			
		if( !IsVehicleStreamedIn( i, playerid ) )
			continue;
		
		if( V::[i][vNoBag] == true ) 
			continue;
			
 		if( V::[i][vLock] == true ) 
			continue;
		
    	if(IsPlayerInAnyVehicle(playerid)) continue;
 		GetCoordBootVehicle(i, p[0], p[1], p[2]);
		if(IsPlayerInRangeOfPoint(playerid, 3.0, p[0], p[1], p[2])) {
		    if(GetVehicleBag(i) == 0) continue;
		    if(i >= lspdcars[0] && i <= lspdcars[1] || i >= sherifcar[0] && i <= sherifcar[1] || i >= sheriffandpolice[0] && i <= sheriffandpolice[1]) {
		    	if(Player[playerid][uIsPlayerJob][0] == 0) continue;
		    }
		    if(i >= medicalcar[0] && i <= medicalcar[1]) {
		    	if(Player[playerid][uIsPlayerJob][1] == 0) continue;
		    }
		    if(i >= smicars[0] && i <= smicars[1]) {
		    	if(Player[playerid][uMember] != 4) continue;
		    }
		    if(i >= fd_cars[0] && i <= fd_cars[1]) {
		    	if(Player[playerid][uIsPlayerJob][2] == 0) continue;
		    }
		    if(i >= meria[0] && i <= meria[1]) {
		    	if(Player[playerid][uMember] != 6) continue;
		    }
		    if(i >= comm[0] && i <= comm[1]) {
		    	if(Player[playerid][uMember] != 7) continue;
		    }
			if( i >= sasd_car[0] && i <= sasd_car[1] ) {
				if(Player[playerid][uMember] != 8) continue;
			}
 			SetPVarInt(playerid,"PlayerVehicleID",i);
 			ShowUseSlots(playerid,1);
 			camera = false;
 			break;
		}
	}
	if(IsPlayerInRangeOfPoint(playerid,3.0,379.3506,-190.4740,1000.6328) || IsPlayerInRangeOfPoint(playerid,3.0,375.5897,-118.8041,1001.4995) ||
	IsPlayerInRangeOfPoint(playerid,3.0,377.4535,-67.4345,1001.5078) || IsPlayerInRangeOfPoint(playerid,3.0,369.6813,-6.0225,1001.8589) ||
	IsPlayerInRangeOfPoint(playerid,3.0,498.0475,-76.0367,998.7578) || IsPlayerInRangeOfPoint(playerid,3.0,1207.2336,-29.0828,1000.9531) || IsPlayerInRangeOfPoint(playerid,3.0,-784.1971,500.0738,1371.7422) ||
	IsPlayerInRangeOfPoint(playerid,3.0,203.8694,-43.2627,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,207.0882,-129.1814,1003.5078) || IsPlayerInRangeOfPoint(playerid,3.0,161.4221,-83.2581,1001.8047) ||
	IsPlayerInRangeOfPoint(playerid,3.0,206.3741,-8.1361,1001.2109) || IsPlayerInRangeOfPoint(playerid,3.0,204.3264,-159.3523,1000.5234) || IsPlayerInRangeOfPoint(playerid,3.0,-2237.1565,130.1796,1035.4141) ||
	IsPlayerInRangeOfPoint(playerid,3.0,207.6243,-100.3268,1005.2578) || IsPlayerInRangeOfPoint(playerid,3.0,210.1204,-102.2575,1005.2578) || IsPlayerInRangeOfPoint(playerid,3.0,210.5399,-34.1924,1001.9297) || IsPlayerInRangeOfPoint(playerid,3.0,206.9977,-135.6739,1002.8744) ||
	IsPlayerInRangeOfPoint(playerid,3.0,150.9207,-75.5895,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,211.3265,-9.5800,1001.2109) || IsPlayerInRangeOfPoint(playerid,3.0,198.8070,-157.5421,1000.5234) ||
	IsPlayerInRangeOfPoint(playerid,3.0,205.2868,-102.2578,1005.2578) || IsPlayerInRangeOfPoint(playerid,3.0,208.5928,-33.9872,1001.9297) || IsPlayerInRangeOfPoint(playerid,3.0,209.9369,-135.1686,1002.8672) ||
	IsPlayerInRangeOfPoint(playerid,3.0,149.3744,-78.7390,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,208.4021,-7.5041,1001.2109) || IsPlayerInRangeOfPoint(playerid,3.0,198.6052,-166.8229,1000.5234) ||
	IsPlayerInRangeOfPoint(playerid,3.0,212.4442,-96.4369,1005.2578) || IsPlayerInRangeOfPoint(playerid,3.0,197.3729,-40.3967,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,199.3410,-138.7777,1003.5078) ||
	IsPlayerInRangeOfPoint(playerid,3.0,147.4459,-72.5470,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,226.1939,-11.2933,1002.2109) || IsPlayerInRangeOfPoint(playerid,3.0,202.4432,-166.7652,1000.5234) ||
	IsPlayerInRangeOfPoint(playerid,3.0,205.0045,-96.9579,1005.2578) || IsPlayerInRangeOfPoint(playerid,3.0,210.7852,-44.9170,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,215.7504,-137.4998,1003.5078) ||
	IsPlayerInRangeOfPoint(playerid,3.0,166.4640,-80.5297,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,226.2144,-5.1318,1002.2109) || IsPlayerInRangeOfPoint(playerid,3.0,210.0818,-166.7970,1000.5234) ||
	IsPlayerInRangeOfPoint(playerid,3.0,202.5804,-96.4468,1005.2578) || IsPlayerInRangeOfPoint(playerid,3.0,197.3730,-48.3824,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,216.1559,-132.9930,1003.5078) ||
	IsPlayerInRangeOfPoint(playerid,3.0,156.3242,-80.4837,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,215.5925,-9.6650,1001.2109) || IsPlayerInRangeOfPoint(playerid,3.0,206.6252,-166.7522,1000.5306) ||
	IsPlayerInRangeOfPoint(playerid,3.0,274.8398,1085.8550,1913.8648) || IsPlayerInRangeOfPoint(playerid,3.0,295.5261,-38.5112,1001.5156) || IsPlayerInRangeOfPoint(playerid,3.0,499.9670,-20.7732,1000.6797) ||
	IsPlayerInRangeOfPoint(playerid,3.0,-81.9160,-1597.5673,2860.2357)) {
		for(new i; i != cBizz; i++) {
			if(IsPlayerInRangeOfPoint(playerid,50.0,Bizz::[i][bEnter][4],Bizz::[i][bEnter][5],Bizz::[i][bEnter][6]) && GetPlayerVirtualWorld(playerid) == Bizz::[i][bID]) {
				SetPVarInt(playerid,"PlayerBizzID",i);
				break;
			}
		}
		ShowUseSlots(playerid,3);
		camera = false;
	}
	//
	if(
		IsPlayerInRangeOfPoint(playerid,3.0,629.8479,196.1600,2001.0836) 
		|| IsPlayerInRangeOfPoint(playerid,3.0,392.9364,-1882.3732,2501.0859) 
		|| IsPlayerInRangeOfPoint(playerid,3.0,-134.7845,-1897.9773,2501.0859) 
		|| IsPlayerInRangeOfPoint(playerid,3.0,907.3466,-1845.6542,2501.0859) 
		|| IsPlayerInRangeOfPoint(playerid,3.0,312.5520,-166.1330,999.6010)) //
	{
	    if(GetPlayerVirtualWorld(playerid) == 1 || GetPlayerVirtualWorld(playerid) == 110 || GetPlayerVirtualWorld( playerid ) == 8 ) {
			if(Player[playerid][uIsPlayerJob][0] == 1)
			{
				ShowUseSlots(playerid,4);
				camera = false;
			}
		}
		if(GetPlayerVirtualWorld(playerid) == 3)
		{
		    if(Player[playerid][uIsPlayerJob][2] == 1)
			{
				ShowUseSlots(playerid,4);
				camera = false;
			}
		}
	}
	if(	IsPlayerInRangeOfPoint( playerid, 5.0, 624.3196,-562.0367,2594.0859 ) || // SADoC
		IsPlayerInRangeOfPoint( playerid, 5.0, -141.9430,-1878.3663,3001.0859) || // GHETTO
		IsPlayerInRangeOfPoint( playerid, 5.0, 1374.8418,-1733.8414,2949.9790)|| // LSFD
		IsPlayerInRangeOfPoint( playerid, 5.0, 1178.4286,-1315.2794,2804.5207)|| // MEDIC
		IsPlayerInRangeOfPoint( playerid, 5.0, 1667.0906,-1628.2998,4698.9728) || 
		IsPlayerInRangeOfPoint( playerid, 5.0, 1309.8645,-891.4843,3001.0859 ) || // FD
		IsPlayerInRangeOfPoint( playerid, 5.0, -925.2145,-563.7732,3001.0859 )) 
	{ 
        switch(Player[playerid][uMember]) 
		{
	        case 1,2,3,4,5,8: {
				ShowUseSlots(playerid,8);
				camera = false;
			}
		}
	}
	if( IsPlayerInRangeOfPoint( playerid, 3.0, 71.2379,-342.3935,2101.0859 ) ) {
        ShowUseSlots( playerid, 9 );// Еда в тюрьме
		camera = false;
	}
	if(camera == true)
	{
		GetPlayerPos(playerid,X,Y,Z);
		GetPlayerFacingAngle(playerid,R);
		X2 = X - 3.5 * floatsin(R, degrees );
		Y2 = Y + 3.5 * floatcos(R, degrees );
		InterpolateCameraPos(playerid,X,Y,Z,X2,Y2,Z,600,1000);
		InterpolateCameraLookAt(playerid,X,Y,Z,X,Y,Z,600,1000);
 	}
 	for(new i; i != 22; i++) 
	{
		if( i == 21 )
			continue;
		
		TextDrawShowForPlayer(playerid,invPlayer[i]);
	}
	for(new s; s != 61; s++) PlayerTextDrawShow(playerid,invSPlayer[playerid][s]);
	return 1;
}

stock GetIDPlayer(name[])
{
	foreach(new i: Player) if(GetPVarInt(i, "uLogin") == 1) if(!strcmp(name,Player[i][uName],true)) return i;
	return 0;
}

stock showSettings(playerid) {
	new spawn[90],walk[25],talk[25],style[25], radio[30];

	switch(Player[playerid][uSettings][1])
	{
	    case 0: spawn = ""cGREEN"Стандарт. спавн";
	    case 1: spawn = ""cGREEN"Фракция";
	    case 2: spawn = ""cGREEN"Дом";
	    case 3: spawn = ""cGREEN"Квартира";
		case 4: spawn = ""cGREEN"Там где вышел";
	}
	switch(Player[playerid][uSettings][6]) {
		case 0: walk = ""cGREEN"Стандартная";
	    default: format(walk,sizeof(walk),""cGREEN"Походка %d",Player[playerid][uSettings][6]);
	}
	switch(Player[playerid][uSettings][7]) {
		case 0 : talk = ""cGREEN"Стандартный";
		case 7 : talk = ""cGREEN"Нет";
	    default: format(talk,sizeof(talk),""cGREEN"Стиль %d",Player[playerid][uSettings][7]);
	}
	switch(Player[playerid][uChangeStyle]) {
		case 0: style = ""cGREEN"Стандартный";
	    case 1: style = ""cGREEN"Бокс";
	    case 2: style = ""cGREEN"Кунг-Фу";
	    case 3: style = ""cGREEN"Кик-Бокс";
	}
	switch(Player[playerid][uSettings][8])
	{
	    case 0: radio = ""cRED"Выкл";
	    case 1: radio = ""cGREEN"Вкл";
	}
	format:vb_string( "{FFFFFF}1. Спидометр транспортного средства - %s\n2. Полоска сытости - %s\n3. Скрывать ники игроков - %s\n4. Показывать действия администрации - %s\n\
	{ffffff}5. Место спавна персонажа - %s\n6. Стиль походки - %s\n7. Стиль разговора - %s\n8. Стиль боя - %s\n9. Скрывать OOC чат в /b - %s\n\
	{ffffff}10. Скрывать OOC чат в /ro - %s\n11. Скрывать личные сообщения - %s\n12. Полоска очков - %s\n13. Отображение рации - %s\n\
	14. Отображение эфиров - %s\n\
	15. Установка кода безопасности",
		Player[playerid][uSettings][0] ? (""cGREEN"Вкл") : (""cRED"Выкл"),
		Player[playerid][uSettings][2] ? (""cGREEN"Вкл") : (""cRED"Выкл"),
		Player[playerid][uSettings][3] ? (""cGREEN"Да") : (""cRED"Нет"),
		Player[playerid][uSettings][5] ? (""cGREEN"Да") : (""cRED"Нет"),
		spawn,walk,talk,style,
		Player[playerid][uOOC] ? (""cGREEN"Вкл") : (""cRED"Выкл"),
		Player[playerid][uRO] ? (""cGREEN"Вкл") : (""cRED"Выкл"),
		Player[playerid][uPM] ? (""cGREEN"Вкл") : (""cRED"Выкл"),
		Player[playerid][uShowJobValue] ? (""cGREEN"Вкл") : (""cRED"Выкл"),
		radio,
		Player[playerid][uEther] ? (""cGREEN"Вкл") : (""cRED"Выкл")
	);
	
    showPlayerDialog(playerid,d_menu,2," ",vb_string,"Далее","Закрыть");
    return 1;
}



stock split(const strsrc[], strdest[][], delimiter) {
    new i, li;
    new aNum;
    new len;
    while(i <= strlen(strsrc)) {
        if(strsrc[i] == delimiter || i == strlen(strsrc)) {
            len                = strmid(strdest[aNum], strsrc, li, i, 128);
            strdest[aNum][len] = 0;
            li                 = i+1;
            aNum++;
        }
        i++;
    }
    return 1;
}
