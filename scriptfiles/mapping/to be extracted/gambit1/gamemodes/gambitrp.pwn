		if(GetPVarInt(i,"CountBackDaln") != 0) {
		    SetPVarInt(i,"CountBackDaln",GetPVarInt(i,"CountBackDaln") - 1);
		    format(string,sizeof(string),"%d",GetPVarInt(i,"CountBackDaln"));
		 	GameTextForPlayer(i, string, 1000, 6);
			if(GetPVarInt(i,"CountBackDaln") == 0) {
			    if(GetPlayerVehicleID(i) >= dalncars[0] && GetPlayerVehicleID(i) <= dalncars[1]) {
			        if(V::[GetPlayerVehicleID(i)][vDalnDriver] == i && D::[i][dDalnKey] == GetPlayerVehicleID(i)) {
		                V::[GetPlayerVehicleID(i)][vDalnDriver] = -1;
		                D::[i][dDalnKey] = -1;
						DisablePlayerCheckpoint(i);
						D::[i][dDalnDuty] = false;
						if(PlayerTrailer[i] != -1) {
							V::[PlayerTrailer[i]][vWoods] = 0;
							V::[PlayerTrailer[i]][vMebel] = 0;
							V::[PlayerTrailer[i]][vToplivo] = 0;
							
							if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[i]][vTextTrailer]))
							{
								DestroyDynamic3DTextLabel(V::[PlayerTrailer[i]][vTextTrailer]);
								V::[PlayerTrailer[i]][vTextTrailer] = Text3D: INVALID_3DTEXT_ID;
