			    if(GetPVarInt(i,"ACPlayerTuning") == 0 && GetPVarInt(i,"playerUsePaynSpray") == 0) SetVehicleHealth(GetPlayerVehicleID(i),V::[GetPlayerVehicleID(i)][vHealth]);
				if(GetPVarInt(i,"ACPlayerTuning") != 0) setVehicleHealth(GetPlayerVehicleID(i),1000.0);
				if(GetPVarInt(i,"playerUsePaynSpray") != 0 && GetPlayerState(i) == PLAYER_STATE_DRIVER) {
				    setVehicleHealth(GetPlayerVehicleID(i),1000.0);
