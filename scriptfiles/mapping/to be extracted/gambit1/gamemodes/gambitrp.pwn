					if(cMembers == 9) {
						SetPVarInt(playerid,"pageFrac",0);
						strcat(vb_string,"Далее >>");
					}
				}
				showPlayerDialog(playerid,d_frac + 12,2," ",vb_string,"Далее","Закрыть");
			}
		}
		case 20:
		{
		   	new namel[MAX_PLAYER_NAME],rank;
		    if(!Rows) SendClientMessage(playerid,-1,"Ошибка №1");
			else {
    			for(new cMembers; cMembers != Rows; cMembers++) {
                	rank = cache_get_field_content_int(cMembers, "uRank");
					cache_get_field_content(cMembers, "uName", data, mysql), sscanf(data,"s[32]",namel);
					format( gb_string, sizeof( gb_string ),"{ffffff}%i. {d3d3d3}%s - %s\n",cMembers + 1,namel,FRank[Player[playerid][uMember]][rank - 1]);
					strcat( vb_string, gb_string );
					if(cMembers == 9) {
						strcat( vb_string,"Далее >>");
					}
				}
				showPlayerDialog(playerid,d_frac + 12,2," ", vb_string,"Далее","Закрыть");
			}
		}
		case 31:
		{
		    if(Rows) {
		        Player[playerid][uID] = cache_get_field_content_int(0, "uID");
		        return Player[playerid][uID];
		    }
		}
		case 32:
		{
		    new id;
		    if(Rows) id = cache_get_field_content_int(0, "uID");
			return id;
		}
		case 33:
		{
		    if(Rows) {
		        new money = cache_get_field_content_int(0, "Money");
		        new id = cache_get_field_content_int(0, "BizzID");
		        SendClientMessage(playerid,C_GRAY,""gbInfo"Оповещаем Вас о том, что ваш бизнес был продан!");
		        Player[playerid][uMoney] += money;

				format(string, sizeof(string), ""gbAccess"Вам возвращено %d$ с вашего бизнеса", money);
				SendClientMessage(playerid,C_GRAY,string);

				format(string,sizeof(string),"DELETE FROM gb_business_money WHERE BINARY Name = '%s'", Player[playerid][uName]);
				mysql_tquery(1, string, "", "");

				mysql_format(1, string, sizeof(string),"UPDATE gb_users SET uMoney = '%d' WHERE BINARY uName = '%s'",Player[playerid][uMoney],Player[playerid][uName]);
				mysql_tquery(1, string, "", "");

				for(new i; i != MAX_SLOTS; i ++) {
					switch(Inv[playerid][invSlot][i]) {
						case 377,410 .. 413,421 .. 425: {
							if(Inv[playerid][invSlotKol][i] == id) {
								Inv[playerid][invSlot][i] = 0;
                        		Inv[playerid][invSlotKol][i] = 0;
							}
						}
					}
				}

		    }
		    else return 1;
		}
		case 8: {
            Fields = cache_get_field_count(mysql);
			f_mysql_fetch_row_format(0, query, Fields);
		    sscanf(query,"p<|>iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiia<i>[13]i",S::[0][sFerm][0],S::[0][sFerm][1],S::[0][sFerm][2],S::[0][sFerm][3],S::[0][sFerm][4],S::[0][sFerm][5],S::[0][sFerm][6],S::[0][sProducts],
			MebelZavod,ToplivoZavod,WoodsZavod,S::[0][wsWoods],S::[0][wsWoodsSklad],adminsPanel[0],adminsPanel[1],adminsPanel[2],adminsPanel[3],adminsPanel[4],adminsPanel[5],
			S::[0][sMeria][0],S::[0][sMeria][1],S::[0][sMeria][2],S::[0][sMeria][3],S::[0][sMeria][4],S::[0][sMeria][5],S::[0][sMeria][6],S::[0][sMeria][7],S::[0][sMeria][8],S::[0][sMeria][9],
			S::[0][sHouses],S::[0][sBusiness],adminsPanel[6],adminsPanel[7],adminsPanel[8],adminsPanel[9],adminsPanel[10],adminsPanel[11],S::[0][sNalog],adminsPanel[12]);
			printf( "[SYSTEM] Зарплаты загружены" );
		}	
	}
	return 1;
}

stock f_mysql_fetch_row_format(row, destination[], fields, max_len = sizeof(destination)) {
	clear_massive();
    strdel(destination, 0, max_len);
    for(new f=0; f < fields; f++) {
        if(f != 0)strcat(destination, "|", max_len);
        cache_get_row(row, f, gb_string, mysql);
        if(!f)strins(destination, gb_string, 0, max_len);
        else strcat(destination, gb_string, max_len);
    }
    return true;
}

function PhoneMessageOne(playerid, listitem) {
    new Rows, Fields;
    cache_get_data(Rows, Fields);
    if(!Rows) return SendClientMessage(playerid,C_GRAY,""gbError"Не удалось прочитать сообщение, неполадки в SA-Telecome.");
	else {
		for(new cMessage; cMessage != Rows; cMessage++) {
			if(cMessage == listitem) {
			    new id = cache_get_field_content_int(cMessage, "mID");
			    SetPVarInt(playerid,"phoneSelectMessage", id);
				break;
			}
		}
		showPlayerDialog(playerid,d_phone + 9,2," ","1. "cGRAY"Прочитать сообщение{ffffff}\n2. "cGRAY"Удалить сообщение","Далее","Закрыть");
	}
	return 1;
}

function ListForFrac(playerid, listitem) {
	clear_massive();
    new Rows, Fields;
    cache_get_data(Rows, Fields);
    new name[MAX_PLAYER_NAME], rank;
	if(Rows) {
		for(new cMembers; cMembers != Rows; cMembers++) {
			if(cMembers == listitem) {
				rank = cache_get_field_content_int(cMembers, "uRank");
				cache_get_field_content(cMembers, "uName", gb_string, mysql), sscanf(gb_string,"s[32]",name);
				SetPVarInt(playerid,"playerSelectFracID", cache_get_field_content_int(cMembers, "uID"));
				format( gb_string,sizeof(gb_string),"%s - %s",name,FRank[Player[playerid][uMember]][rank - 1]);
				showPlayerDialog(playerid,d_frac + 13,2, gb_string,"1. "cGRAY"Уволить человека из организации","Далее","Закрыть");
				break;
			}
		}
	}
	return 1;
}
