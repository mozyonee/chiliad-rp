				playertextid != invSPlayer[playerid][51] || playertextid != invSPlayer[playerid][52] || playertextid != invSPlayer[playerid][53] || playertextid != invSPlayer[playerid][54] ||
				playertextid != invSPlayer[playerid][55]) {
					switch(GetPVarInt(playerid,"changeSlot")) {
						case 48: RemovePlayerAttachedObject(playerid, 0);
						case 49: RemovePlayerAttachedObject(playerid, 1);
						case 50: RemovePlayerWeapon(playerid,GetWeaponToObject(_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"changeSlot")]][invObject]));
						case 51: RemovePlayerWeapon(playerid,GetWeaponToObject(_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"changeSlot")]][invObject]));
						case 52: {
							if(_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"changeSlot")]][invObject] != 0) {
							    if(Player[playerid][uSex] == 1) {
									if(Player[playerid][uColor] == 1) SetPlayerSkin(playerid,18);
									else if(Player[playerid][uColor] == 2) SetPlayerSkin(playerid,154);
								}
								else if(Player[playerid][uSex] == 2) {
								    if(Player[playerid][uColor] == 1) SetPlayerSkin(playerid,139);
									else if(Player[playerid][uColor] == 2) SetPlayerSkin(playerid,138);
								}
							}
							//else SetPlayerSkin(playerid,_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"changeSlot")]][invObject]);
							// Изменить
						}
						case 53: RemovePlayerAttachedObject(playerid, 2);
						case 54: setPlayerArmour(playerid,0);
					}
				}
				if(Inv[playerid][invSlot][GetPVarInt(playerid,"changeSlot")] != 0) {
                    PlayerTextDrawSetPreviewModel(playerid, invSPlayer[playerid][GetPVarInt(playerid,"changeSlot")], 19464);
					PlayerTextDrawSetPreviewRot(playerid, invSPlayer[playerid][GetPVarInt(playerid,"changeSlot")], 0.000000, 0.000000, 90.000000, 0.100000);
					PlayerTextDrawBackgroundColor(playerid,invSPlayer[playerid][GetPVarInt(playerid,"changeSlot")], 255);
					PlayerTextDrawSetPreviewModel(playerid,invSPlayer[playerid][GetPVarInt(playerid,"selectSlot")], _itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"changeSlot")]][invObject]);
                    PlayerTextDrawSetPreviewRot(playerid, invSPlayer[playerid][GetPVarInt(playerid,"selectSlot")], _itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"changeSlot")]][invP][0], _itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"changeSlot")]][invP][1], _itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"changeSlot")]][invP][2], _itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"changeSlot")]][invP][3]);
					PlayerTextDrawBackgroundColor(playerid,invSPlayer[playerid][GetPVarInt(playerid,"selectSlot")], 0xd3d3d3FF);
					PlayerTextDrawShow(playerid,invSPlayer[playerid][GetPVarInt(playerid,"selectSlot")]);
					PlayerTextDrawShow(playerid,invSPlayer[playerid][GetPVarInt(playerid,"changeSlot")]);
                }
	            if(Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")] == 0) {
                    Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")] = Inv[playerid][invSlot][GetPVarInt(playerid,"changeSlot")];
                    Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")] = Inv[playerid][invSlotKol][GetPVarInt(playerid,"changeSlot")];
                    Inv[playerid][invSlot][GetPVarInt(playerid,"changeSlot")] = 0;
                    Inv[playerid][invSlotKol][GetPVarInt(playerid,"changeSlot")] = 0;
                    SaveInventory(playerid);
                }
                SetPVarInt(playerid,"changeSlot",-1);
                SetPVarInt(playerid,"selectSlot",-1);
                return 1;
			}
        }
    }
	return 1;
}

public OnPlayerEnterVehicle(playerid, vehicleid, ispassenger)
{
	return 1;
}

public OnPlayerAttachTrailer(playerid,vehicleid,trailerid) {
    if(D::[playerid][dDalnDuty] == true && trailerid != PlayerTrailer[playerid]) {
        SendClientMessage(playerid,C_GRAY,""gbError"Этот прицеп выдан в аренду не вам.");
        return DetachTrailerFromVehicle(vehicleid);
    }
    else {
        if(GetPVarInt(playerid,"dettachTrailer") != 0) SetPVarInt(playerid,"dettachTrailer",0);
    }
	return 1;
}

public OnPlayerDeattachTrailer(playerid,vehicleid,trailerid) {
	if(trailerid == PlayerTrailer[playerid]) {
	    SetPVarInt(playerid,"dettachTrailer",120);
	}
	return 1;
}

stock HideInventory( playerid ) 
{
	CancelSelectTextDraw(playerid);
	SetPVarInt(playerid,"PlayerMenuShow",0);
	SetCameraBehindPlayer(playerid);
	for(new i; i != 22; i++) TextDrawHideForPlayer(playerid,invPlayer[i]);
	for(new s; s != 61; s++) PlayerTextDrawHide(playerid,invSPlayer[playerid][s]);
	SetPVarInt(playerid,"changeSlot",-1);
	SetPVarInt(playerid,"selectSlot",-1);

	switch(GetPVarInt(playerid,"UseSlots")) {
		case 0,1,7: {
			for(new i; i != 18; i++) PlayerTextDrawHide(playerid,slotUse[i][playerid]);
			for(new i; i != 3; i++) PlayerTextDrawHide(playerid,iconUse[i][playerid]);
 		}
 		case 2,3,4,5,8,9: {
			for(new i; i != 16; i ++) {
				TextDrawHideForPlayer(playerid,buyingShopFon[i]);
				PlayerTextDrawHide(playerid,buyingShopItems[i][playerid]);
				PlayerTextDrawHide(playerid,buyingShopInfo[i][playerid]);
 			}
  		}
  		case 6:
  		{
    		for(new i; i != 30; i ++) PlayerTextDrawHide(playerid,Warehouse[i][playerid]);
		    for(new i; i != 3; i++) PlayerTextDrawHide(playerid,iconUse[i][playerid]);
  		}
  	}
  	for(new i = 48; i != 56; i++) PlayerTextDrawSetSelectable(playerid,invSPlayer[playerid][i], 1);
  	for(new i; i != 8; i ++) PlayerTextDrawHide(playerid,infoIPlayer[playerid][i]);
  	SetPVarInt(playerid,"UseSlots",-1);
  	if(GetPVarInt(playerid,"PlayerVehicleID") != -1) {
		GetVehicleParamsEx(GetPVarInt(playerid,"PlayerVehicleID"),eng,light,other1,other2,other3,other4,other5);
  		SetVehicleParamsEx(GetPVarInt(playerid,"PlayerVehicleID"),eng,light,other1,other2,other3,0,other5);
    	SetPVarInt(playerid,"PlayerVehicleID",-1);
   	}
   	if(IsPlayerInAnyVehicle(playerid) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
		if(Player[playerid][uSettings][0] == 1) {
			for(new i; i != 3; i++) TextDrawShowForPlayer(playerid, SpeedFon[i]);
			for(new i; i != 8; i++) PlayerTextDrawShow(playerid,Speed[i][playerid]);
			UpdateFuelBar(playerid,GetPlayerVehicleID(playerid));
		}
	}
	return true;
}


public OnPlayerClickTextDraw(playerid, Text:clickedid) {
	new string[1024],warningtext[50];
	warningtext = "";

    if(_:clickedid == INVALID_TEXT_DRAW) {
		switch( getData( playerid, "PlayerMenuShow" ) ) {
		    case 1: {
			    for(new i; i != 21; i ++) TextDrawHideForPlayer(playerid,MenuPlayer[i]);
			    for(new i; i != 3; i ++) PlayerTextDrawHide(playerid,menuPlayer[i][playerid]);
            	setData( playerid, "PlayerMenuShow", 0 );
            	CancelSelectTextDraw(playerid);
            	SetCameraBehindPlayer(playerid);
		    }
		    case 2: {
		        SetPVarInt(playerid,"PlayerMenuShow",0);
		        CancelSelectTextDraw(playerid);
		    	TextDrawHideForPlayer(playerid, FermFon[0]);
		    	TextDrawHideForPlayer(playerid, FermFon[1]);
				PlayerTextDrawHide(playerid, FermSelectSkin[0][playerid]);
				PlayerTextDrawHide(playerid, FermSelectSkin[1][playerid]);
				PlayerTextDrawHide(playerid, FermSelectSkin[2][playerid]);
		    }
			case 3: {
			    SetPVarInt(playerid,"PlayerMenuShow",0);
			    
				for(new i; i != 9; i ++) 
				{
					if( i == 5 )
						continue; 
						
					TextDrawHideForPlayer(playerid, dalnmenu[i]);
		    	}
				
				PlayerTextDrawHide(playerid,dalnmenuplayer[playerid]);
			}
			case 4: {
				HideInventory( playerid );
				
			    
			}
			case 5: {
				if(D::[playerid][dPhone] == true) return 1;
			    hidePhone(playerid);
			    SetPVarInt(playerid,"PlayerMenuShow",0);
			}
			case 6: {
			    for(new i; i != 6; i ++) TextDrawHideForPlayer(playerid, furnitureBuy[i]);
				PlayerTextDrawHide(playerid, furniturePrice[playerid]);
			    SetPVarInt(playerid,"PlayerMenuShow",0);
			    SetCameraBehindPlayer(playerid);
			    CancelSelectTextDraw(playerid);
			    togglePlayerControllable(playerid,true);
			}
			case 7: {
				HideTuneList( playerid );
			}
			case 9:
			{
			    CancelSelectTextDraw(playerid);
			    for(new i; i != 13; i++) PlayerTextDrawHide(playerid, NewSkinSelect[i][playerid]);
			    SetPVarInt(playerid,"PlayerMenuShow",0);
			}
		}
    }
	
	
    if(clickedid == MenuPlayer[15])
	{
        if( IsMute( playerid, TYPE_OOC )) 
			return SendClientMessage( playerid, C_WHITE, !PLAYER_MUTED );
			
		showPlayerDialog( playerid, d_a_menu + 1, 1, "Связь с администрацией",
			""gbInfo"Введите запрос администрации или операторам поддержки:\n\n\
			"cRED"| Если Вы указываете жалобу, не забудьте указать ID игрока на которого жалуетесь.\n\
			"cRED"| Запрос не должен содержать в себе оффтоп.",
			"Далее", "Закрыть"
		);
	}
    if(clickedid == MenuPlayer[16]) showHelp( playerid, 0 );
    if(clickedid == MenuPlayer[17]) showSettings(playerid);
    if(clickedid == MenuPlayer[18]) showHelp( playerid, 1 );
	if(clickedid == MenuPlayer[19]) {
        string = "";
        strcat(string,"{ffffff}Проект "cBLUE"Gambit Role Play {ffffff}был основан в июле 2014 года разработчиками нашумевшего "cBLUE"State 99{ffffff}.\n");
        strcat(string,"Свое название проект получил от известного шахматного хода, так как разработчики пожертвовали одним сервером, \nчто бы дать игрокам будущее спустя год.\n\n");
        strcat(string,"Основной целью проекта является, удаление стереотипов серверов в SA:MP индустрии\n");
        strcat(string,"и поворот шаблонности в новое русло, так как разработчиками был замечен фактор\n");
        strcat(string,"повторения внутреннего строения сервера, которое берет свое начало с гигантов SA:MP индустрии.");
		showPlayerDialog(playerid,9999,0,"Информация о сервере",string,"Закрыть","");
	}
    if(clickedid == MenuPlayer[20]) {
        string = "";
        strcat(string,"{ffffff}| Чтобы воспользоваться донат услугами на нашем сервере, Вам необходимо:\n\n");
        strcat(string,"{ffffff}1. "cGRAY"Не находиться на сервере, в момент использования услугами доната;\n");
        strcat(string,"{ffffff}2. "cGRAY"Авторизироваться на сайте проекта (g-rp.su) под своим игровым аккаунтом;\n");
        strcat(string,"{ffffff}3. "cGRAY"Перейти в раздел \"Магазин\";");
		showPlayerDialog(playerid,9999,0,"Донат",string,"Закрыть","");
	}
    if(clickedid == invPlayer[18])
	{
		if(GetPVarInt(playerid,"selectSlot") != -1 && Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")] != 0) {
			new bool:keycar = false;
			switch(_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invID]) {
				case 1 .. 22,35 .. 40: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:"cGRAY"\n\n%s\n\nКоличество - 1\nПатроны - %d\nВес - %.1fkg",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")],_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invKg]),keycar = true;
			    case 23: {
			    	for(new i; i != MAX_CARS_BUY; i++) {
			    	    if(Car::[i][cID] == 0 || Car::[i][cModel] == 0) continue;
						if(Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")] == Car::[i][cID]) {
							format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"Ключ от машины\n\nИнформация - %s\n\nМашина - %s(%d)",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],CarNames[Car::[i][cModel] - 400],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]);
							keycar = true;
							break;
						}
					}
			    }
			    case 24: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"Ключ от дома\n\nИнформация - %s\n\nНомер дома - %d",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]),keycar = true;
			    case 25: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"Ключ от закусочной\n\nИнформация - %s\n\nНомер закусочной - %d",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]),keycar = true;
		    	case 49: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"Ключ от бара\n\nИнформация - %s\n\nНомер бара - %d",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]),keycar = true;
		    	case 50: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"Ключ от ресторана\n\nИнформация - %s\n\nНомер ресторана - %d",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]),keycar = true;
		    	case 51: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"Ключ от магазины одежды\n\nИнформация - %s\n\nНомер магазина одежды - %d",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]),keycar = true;
		    	case 52: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"Ключ от магазина электроники\n\nИнформация - %s\n\nНомер магазина электроники - %d",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]),keycar = true;
		    	case 60: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"Ключ от автосалона\n\nИнформация - %s\n\nНомер автосалона - %d",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]),keycar = true;
		    	case 61: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"Ключ от магазина оружия\n\nИнформация - %s\n\nНомер магазина оружия - %d",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]),keycar = true;
		    	case 62: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"Ключ от магазина одежды\n\nИнформация - %s\n\nНомер магазина одежды - %d",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]),keycar = true;
		    	case 63: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"Ключ от клуба\n\nИнформация - %s\n\nНомер клуба - %d",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]),keycar = true;
		    	case 64: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"Ключ от заправки\n\nИнформация - %s\n\nНомер заправки - %d",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]),keycar = true;
				case 123: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"Ключ от магазина Все для отдыха\n\nИнформация - %s\n\nНомер магазина - %d",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]),keycar = true;
				case 126: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"Ключ от магазина Аренда транспорта\n\nИнформация - %s\n\nНомер магазина - %d",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]),keycar = true;
				case 127: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"Ключ от Спортзала\n\nИнформация - %s\n\nНомер магазина - %d",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]),keycar = true;
				case 145:
				{
				    if(Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")] == -1)
				    {
				    	format(string, sizeof(string), "{ffffff}| Информация о данном предмете:\n\n"cGRAY"Гильза от оружия\n\nНомер оружия: Неизвестно", Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]), keycar = true;
					}
					else
					{
                        format(string, sizeof(string), "{ffffff}| Информация о данном предмете:\n\n"cGRAY"Гильза от оружия\n\nНомер оружия: %d", Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]), keycar = true;
					}
				}
				case 148: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"Ключ от квартиры\n\nИнформация - %s\n\nНомер квартиры - %d",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")]),keycar = true;
				default: format(string,sizeof(string),"{ffffff}| Информация о данном предмете:\n\n"cGRAY"%s\n\nКоличество - %d\nВес - %.1fkg",_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invText],Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")],_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invKg]),keycar = true;
		    }
		    if(keycar != false) showPlayerDialog(playerid,9999,0,_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invName],string,"Закрыть","");
			else SendClientMessage(playerid,C_GRAY,""gbError"Простите, но информацию о данном ключе посмотреть нельзя!");
		}
	}
	if(clickedid == invPlayer[20])
	{
		if( GetPVarInt(playerid,"selectSlot") == -1 )
			return 1;
			
		if(GetPVarInt(playerid,"selectSlot") == 48 || GetPVarInt(playerid,"selectSlot") == 49 || GetPVarInt(playerid,"selectSlot") == 50 ||
		GetPVarInt(playerid,"selectSlot") == 51 || GetPVarInt(playerid,"selectSlot") == 52 || GetPVarInt(playerid,"selectSlot") == 53 ||
		GetPVarInt(playerid,"selectSlot") == 54 || GetPVarInt(playerid,"selectSlot") == 55) return SendClientMessage(playerid,C_GRAY,""gbError"Сначала снимите предмет с используемого слота!");
		switch(_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invID]) 
		{
      		case 158: {
            	if( GetPVarInt( playerid, "use_slot_9" ) == 158 ) return SendClientMessage( playerid, C_GRAY, ""gbError"Вы не можете удалить предмет вы его используете!" );
			}
			case 156: {
            	if( GetPVarInt( playerid, "use_slot_9" ) == 156 ) return SendClientMessage( playerid, C_GRAY, ""gbError"Вы не можете удалить предмет вы его используете!" );
			}
		}
		if(Inv[playerid][invSlotKol][GetPVarInt(playerid,"selectSlot")] != 0 || Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")] != 0) {
			showPlayerDialog(playerid,d_inventory + 1, 0, " ","{ffffff}Вы уверены, что хотите удалить данный предмет:\n\n"gbError"После удаления предмет нельзя восстановить.","Согласен","Нет");

		}
	}
	/*
	if(clickedid == invPlayer[21]) {
	    if(GetPVarInt(playerid,"selectSlot") == 48 || GetPVarInt(playerid,"selectSlot") == 49 || GetPVarInt(playerid,"selectSlot") == 50 ||
		GetPVarInt(playerid,"selectSlot") == 51 || GetPVarInt(playerid,"selectSlot") == 52 || GetPVarInt(playerid,"selectSlot") == 53 ||
		GetPVarInt(playerid,"selectSlot") == 54 || GetPVarInt(playerid,"selectSlot") == 55) return SendClientMessage(playerid,C_GRAY,""gbError"Сначала снимите предмет с используемого слота!");
 		switch(_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"selectSlot")]][invID])
	 	{
