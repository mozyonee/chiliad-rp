stock random_values_array(array_input[], const array_size)
{
    for (new i = 0; i < array_size; i++)
	{
        array_input[i] = random(array_size);

        for (new j = 0; j < array_size; j++) {
            if (i != j && array_input[i] == array_input[j]) {
                j = -1;
                array_input[i] = random(array_size);
            }
        }
    }
}

public OnGameModeExit() {
	foreach (new i : Player) {
		if(GetPVarInt(i, "uLogin") == 1) {
   			showPlayerDialog(i,-1,DIALOG_STYLE_MSGBOX,"1","1","1","1");
		}
	}
	SaveAllProducts();
	mysql_close();
	return 1;
}

public OnPlayerConnect(playerid) 
{
	if( closeserver == true ) 
	{
	    SendClientMessage( playerid, C_ORANGE, "Вы не можете подключиться к серверу, выполняется технический рестарт." );
	    KickEx(playerid);
	    return 1;
	}
	
    if(IsPlayerNPC(playerid)) 
		return BanEx(playerid, "Fake NPC");
		
    PlayerKey[playerid] = "";
    D::[playerid][dRentVehicleID] = -1;
	ac_dialog[playerid] = 0;
    SetPVarInt(playerid, "NarkEffect", 0);
    SetPVarInt(playerid, "HouseFurniture", 0);
    for(new uInfo:i; i < uInfo; ++i) Player[playerid][i] = 0;
    for(new pData:i; i < pData; ++i) D::[playerid][i] = 0;
    for(new invInfo:i; i < invInfo; ++i) Inv[playerid][i] = 0;


    playerFlags[playerid] = Flags:0;

    D::[playerid][dTaxiKey] = -1;
    D::[playerid][dBusKey] = -1;
    D::[playerid][dDalnKey] = -1;
    PlayerTrailer[playerid] = -1;
    PlayerTrailerTime[playerid] = -1;

	PlayerUseDrink[playerid] = 0;
	PlayerCountMinute[playerid] = 0;

    SetPVarInt(playerid,"BusToGo",-1);
    SetPVarInt(playerid,"changeSlot",-1);
	SetPVarInt(playerid,"selectSlot",-1);
	SetPVarInt(playerid,"changeSlotUse",-1);
	SetPVarInt(playerid,"selectSlotUse",-1);
	SetPVarInt(playerid,"PlayerVehicleID",-1);
	SetPVarInt(playerid,"uLogin",0);
	SetPVarInt(playerid,"UseSlots",-1);

	SetPVarInt(playerid, "BlockID",INVALID_PLAYER_ID);
	SetPVarInt(playerid, "phoneCaller",INVALID_PLAYER_ID);
	SetPVarInt(playerid, "phoneCalled",INVALID_PLAYER_ID);
	SetPVarInt(playerid, "follow",INVALID_PLAYER_ID);
	SetPVarInt(playerid, "medicalCall",INVALID_PLAYER_ID);

	SetPVarInt(playerid, "TimerCountWoods",0);
	SetPVarInt(playerid, "CountBackTaxi",0);
	SetPVarInt(playerid, "CountBackDaln",0);
	SetPVarInt(playerid, "CountBackToBus",0);
	//SetPVarInt(playerid,"timerHospital",0);
	SetPVarInt(playerid, "dettachTrailer",0);
	SetPVarInt(playerid, "playerFreezing",1);
	SetPVarInt(playerid, "PlayerHandshake", -1);
	SetPVarInt(playerid, "PlayerFrisk", -1);
	SetPVarInt(playerid, "PlayerEvict", -1);
	SetPVarInt(playerid, "PlayerOCC", -1);
	SetPVarInt(playerid, "PlayerRO", -1);

	SetPVarInt(playerid, "PlayerHouse", -1);

	SetPVarInt(playerid,"AdvertID",-1);

    SetPlayerColor(playerid,FracColor[0]);

	Player[playerid][uHP] = 100.0;

	YNText[playerid][0] = CreatePlayerTextDraw(playerid,281.000000, 120.000000, "_");
	PlayerTextDrawBackgroundColor(playerid,YNText[playerid][0], 255);
	PlayerTextDrawFont(playerid,YNText[playerid][0], 1);
	PlayerTextDrawLetterSize(playerid,YNText[playerid][0], 0.500000, 0.799997);
	PlayerTextDrawColor(playerid,YNText[playerid][0], -1);
	PlayerTextDrawSetOutline(playerid,YNText[playerid][0], 0);
	PlayerTextDrawSetProportional(playerid,YNText[playerid][0], 1);
	PlayerTextDrawSetShadow(playerid,YNText[playerid][0], 1);
	PlayerTextDrawUseBox(playerid,YNText[playerid][0], 1);
	PlayerTextDrawBoxColor(playerid,YNText[playerid][0], 1182971135);
	PlayerTextDrawTextSize(playerid,YNText[playerid][0], 374.000000, -10.000000);
	PlayerTextDrawSetSelectable(playerid,YNText[playerid][0], 0);

	YNText[playerid][1] = CreatePlayerTextDraw(playerid,288.000000, 119.000000, "PRESS Y");
	PlayerTextDrawBackgroundColor(playerid,YNText[playerid][1], 255);
	PlayerTextDrawFont(playerid,YNText[playerid][1], 2);
	PlayerTextDrawLetterSize(playerid,YNText[playerid][1], 0.500000, 0.799998);
	PlayerTextDrawColor(playerid,YNText[playerid][1], -1);
	PlayerTextDrawSetOutline(playerid,YNText[playerid][1], 0);
	PlayerTextDrawSetProportional(playerid,YNText[playerid][1], 1);
	PlayerTextDrawSetShadow(playerid,YNText[playerid][1], 1);
	PlayerTextDrawSetSelectable(playerid,YNText[playerid][1], 0);
	
	
	
	RemoveServerObject( playerid );
    #include "../include/textdrawsplayer.inc"
    GetPlayerIp( playerid, Player[playerid][uIP], 32 );
	format( query, sizeof query, "SELECT * FROM gb_ipbans WHERE uIP = '%s'", Player[playerid][uIP] );
	mysql_tquery( mysql, query, "OnPlayerCheckBan", "d", playerid );
	return 1;
}

public OnPlayerSpawn( playerid ) 
{

// Job	
	if(GetPVarInt(playerid,"TimerStanok")) {
		KillTimer(GetPVarInt(playerid,"TimerStanok"));
		DeletePVar(playerid,"TimerStanok");
	}
    if(GetPVarInt(playerid,"WoodsPlayer")) {
		KillTimer(GetPVarInt(playerid,"WoodsPlayer"));
		DeletePVar(playerid,"WoodsPlayer");
	}

	if(GetPVarInt(playerid,"CountBackTaxi") != 0) SetPVarInt(playerid,"CountBackTaxi",0);
	if(GetPVarInt(playerid,"CountBackToBus") != 0) SetPVarInt(playerid,"CountBackToBus",0);
	if(GetPVarInt(playerid,"TimerCountWoods") != 0) SetPVarInt(playerid,"TimerCountWoods",0);
	if(GetPVarInt(playerid,"CountBackDaln") != 0) SetPVarInt(playerid,"CountBackDaln",0);
	if(GetPVarInt(playerid,"follow") != INVALID_PLAYER_ID) SetPVarInt(GetPVarInt(playerid,"follow"),"follow",INVALID_PLAYER_ID);
//
	//TogglePlayerControllable( playerid, true );
	//setPlayerHealth( playerid, 100 );
	return true;
}	

function OnPlayerCheckLicense( playerid )
{
    if( !cache_get_row_count() ) 
		return SendClientMessage(playerid, C_GRAY, ""gbInfo"Лицензия не найдена.");
		
    new 
		licenses	[ 4 ],
		name		[ MAX_PLAYER_NAME ];

	gb_string[0] = EOS;
    cache_get_field_content( 0, "uLicenses", gb_string, mysql ); 
	sscanf( gb_string, "p<|>a<d>[4]", licenses );
    
	if( licenses[3] != 1 ) 
		return SendClientMessage(playerid, C_GRAY, ""gbInfo"Лицензия не найдена.");
	
    cache_get_field_content(0, "uName", name, mysql);
	format:vb_string( ""gbInfo"Информация.\n\n\
		Имя: "cBLUE"%s"cWHITE"\n\
		Пол: "cBLUE"%s"cWHITE"\n\
		Цвет: "cBLUE"%s"cWHITE"\n\
		Нация: "cBLUE"%s"cWHITE"\n\
		Возраст: "cBLUE"%d"cWHITE"\
	", 
		name,
		users_sex[ cache_get_field_content_int( 0, "uSex", mysql ) ], 
		users_color[ cache_get_field_content_int(0, "uColor", mysql) ], 
		users_nation[ cache_get_field_content_int(0, "uNation", mysql) ], 
		cache_get_field_content_int( 0, "uAge", mysql )
	);
	
	showPlayerDialog( playerid,9999, 0," ",vb_string, "Закрыть","" );
	
	return 1;
}

forward OnPlayerGetStat(playerid);
public OnPlayerGetStat(playerid)
{
    new Rows, Fields;
    cache_get_data(Rows, Fields);
    
    new regdate, ids;
    if(Rows)
	{
	    cache_get_field_content_int(0, "uID", ids);
	    cache_get_field_content_int(0, "uRegDate", regdate);
	    
	}
	return true;
}

public OnPlayerEnterDynamicArea(playerid, areaid) {
	clear_massive();
	if(PaynSpray[0] <= areaid <= PaynSpray[MAX_PAYNSPRAY-1]) {
		SetPVarInt(playerid,"playerUsePaynSpray",1);
	}
	if(WD::[0][woodZone] <= areaid <= WD::[MAX_WOODS - 1][woodZone]) {
	    new j = areaid - WD::[0][woodZone];
	    if(D::[playerid][dWoodsDuty] == 1) {
	    	new s = GetPlayerSkin(playerid);
			if(s == 16 || s == 27 || s == 260 || s == 13 || s == 56 || s == 131) {
			    if(GetPVarInt(playerid,"PlayerUseBox") == 4) {
			        if(WD::[j][woodUse] == false) {
			            if(WD::[j][woodIsDrop] == false) {
			                if(WD::[j][woodCount] != 0) {
			                	WD::[j][woodUse] = true;
			                	SetPVarInt(playerid,"WoodDrop",j);
								SetTimerEx("WoodsPlayer",10000,false,"ddd",playerid,j,0);
								ClearAnimations(playerid);
								togglePlayerControllable(playerid,false);
								ApplyAnimation(playerid,"CHAINSAW","WEAPON_csaw",1.0,1,0,0,0,10000,0);
								MeAction(playerid,"пилит дерево",1);
							}
						}
		            	else {
		            	    if(WD::[j][woodCount] > 0) {
		            	        WD::[j][woodCount] -= 25;
								SetPVarInt(playerid,"WoodDrop",j);
								SetTimerEx("WoodsPlayer",10000,false,"ddd",playerid,j,1);
								togglePlayerControllable(playerid,false);
								ApplyAnimation(playerid,"CHAINSAW","CSAW_G",1.0,1,0,0,0,10000,0);
								MeAction(playerid,"пилит дерево",1);
		            	    }
		            	}
   					}
   					else SendClientMessage(playerid,C_GRAY,""gbError"Простите, но это дерево уже кто-то пилит.");
				}
			}
			else SendClientMessage(playerid,C_GRAY,""gbError"Вы должны быть в рабочей одежде, для того чтобы пилить дерево.");
	    }
	}
	if(areaid == strZones[10]) {
		if(D::[playerid][dWoodsDuty] != 0) SetPVarInt(playerid,"TimerCountWoods",0);
	}
	if(areaid == strZones[6]) {
	    if(D::[playerid][dWoodsDuty] == 2) {
	        new s = GetPlayerSkin(playerid);
			if(s == 16 || s == 27 || s == 260 || s == 13 || s == 56 || s == 131) {
	        	if(GetPVarInt(playerid,"PlayerUseBox") == 0 && !GetPVarInt(playerid,"TimerStanok") && GetPVarInt(playerid,"PlayerStanok") != 1) {
	            	if(S::[0][wsWoods] <= 0) return SendClientMessage(playerid,C_GRAY,""gbError"На конвеере недостаточно древесины для переработки.");
	            	RemovePlayerAttachedObject(playerid,9);
					SetPlayerAttachedObject(playerid,9,1463,5,0.073999,0.186000,0.105998,95.299972,-175.499984,-72.199935,0.540999,0.350999,0.610999);
	        		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
					SetPVarInt(playerid,"PlayerUseBox",5);
					S::[0][wsWoods] -= 25;
					format( gb_string,sizeof( gb_string ),"Древесина\n{ffffff}%d кг.",S::[0][wsWoods]);
    				UpdateDynamic3DTextLabelText(S::[0][wsWoodsT],C_BLUE, gb_string);
					SendClientMessage(playerid,C_GRAY,""gbError"Теперь отнесите древесину на станок для переработки.");
					MeAction(playerid,"взял(-а) древесину",1);
	        	}
			}
	    }
	    else SendClientMessage(playerid,C_GRAY,""gbError"На вас должна быть рабочая одежда для работы в цеху.");
	}
	if(areaid == strZones[7]) {
	    if(GetPVarInt(playerid,"PlayerUseBox") == 5 && D::[playerid][dWoodsDuty] == 2) {
			SetPVarInt(playerid,"PlayerUseBox",0);
			RemovePlayerAttachedObject(playerid,9);
			new obj = CreateDynamicObject(1463,-468.38101, -73.43010, 774.27722,0.00,0.00,-90.00);
			MoveDynamicObject(obj,-468.38101, -86.69010, 774.27722,1,0.00,0.00,-90.00);
	        SetGVarInt("WoodStanok",1,obj);
	        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	        SetPVarInt(playerid,"TimerStanok",_:SetTimerEx("WoodStanok",15000,false,"d",playerid));
	        SendClientMessage(playerid,C_GRAY,""gbInfo"Дождитесь пока ваша древесина пройдёт обработку.");
	    }
	}
	if(areaid == strZones[8]) {
	    if(GetPVarInt(playerid,"PlayerStanok") == 1) {
	        SetPVarInt(playerid,"PlayerUseBox",7);
	        SetPlayerAttachedObject(playerid,8,2468,5,0.102999,-0.018998,0.105998,95.299972,-175.499984,-164.200012,0.540997,0.761999,0.610997);
			SetPlayerAttachedObject(playerid,9,2468,5,-0.104000,-0.031999,0.105998,95.299972,-175.499984,15.699944,0.540998,0.761999,0.610998);
	        DeletePVar(playerid,"PlayerStanok");
	        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_CARRY);
	        SendClientMessage(playerid,C_GRAY,""gbInfo"Отнесите готовую заготовку на конвеер склада.");
	        MeAction(playerid,"взял(-а) заготовку",1);
	    }
	}
	if(areaid == strZones[9]) {
	    if(GetPVarInt(playerid,"PlayerUseBox") == 7) {
	        RemovePlayerAttachedObject(playerid,9);
	        RemovePlayerAttachedObject(playerid,8);
	        SetPVarInt(playerid,"PlayerUseBox",0);
	        
	        new obj = CreateDynamicObject(2468,-470.67337, -97.64543, 773.79999, 0.00, 0.00, 90.00);
	        new obj2 = CreateDynamicObject(2468,-470.74451, -98.02264, 773.79999,0.00,0.00,-90.00);
			MoveDynamicObject(obj,-470.67340, -104.42540, 773.79999,1,0.00,0.00,90.00);
			MoveDynamicObject(obj2,-470.74451, -104.80260, 773.79999,1,0.00,0.00,-90.00);
			
	        SetGVarInt("WoodGoSklad",1,obj);
	        SetGVarInt("WoodGoSklad2",1,obj2);
	        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	        if(JobValueNow(playerid, 2, 34, -1) != 0) { }
			else
			{
			    SendClientMessage(playerid, -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
		     	showPlayerDialog(playerid, 9999, 0, " ", "{ffffff}Ваш рабочий день закончен.\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке", "Закрыть", "");
				D::[playerid][dWoodsDuty] = 0;
				DeletePVar(playerid,"PlayerUseBox");
				DeletePVar(playerid,"PlayerStanok");
    			GetBackSkin(playerid);
				RemovePlayerAttachedObject(playerid,9);
			}
	    }
	}
	foreach(new i: Player)
	{
	    if(!GetPVarInt(playerid,"uLogin")) continue;
		if(areaid == GetPVarInt(i, "BBArea"))
  		{
    		GetPVarString(i, "BBStation", gb_string, sizeof( gb_string ));
   			PlayAudioStreamForPlayer(playerid, gb_string, GetPVarFloat(i, "BBX"), GetPVarFloat(i, "BBY"), GetPVarFloat(i, "BBZ"), 10.0, 1);
    		break;
    	}
	}
	return 1;
}

public OnPlayerLeaveDynamicArea(playerid, areaid) {
    foreach(new i: Player) {
        if(!GetPVarInt(playerid,"uLogin")) continue;
		if(areaid == GetPVarInt(i, "BBArea"))
		{
			StopAudioStreamForPlayer(playerid);
			break;
		}
	}
    
    if(PaynSpray[0] <= areaid <= PaynSpray[MAX_PAYNSPRAY-1]) SetPVarInt(playerid,"playerUsePaynSpray",0);
    if(areaid == strZones[10]) {
		if(D::[playerid][dWoodsDuty] != 0) {
			SendClientMessage(playerid,C_GRAY,""gbInfo"Вернитесь на территорию лесопилки, иначе Ваш рабочий день будет закончен.");
			SetPVarInt(playerid,"TimerCountWoods",MAX_COUNT_WOOD_ZONE);
		}
    }
    if(areaid == strZones[4]) {
        if(PlayerTrailer[playerid] != -1) {
            if(GetVehicleTrailer(GetPlayerVehicleID(playerid)) != PlayerTrailer[playerid]) {
            	V::[PlayerTrailer[playerid]][vWoods] = 0;
				V::[PlayerTrailer[playerid]][vMebel] = 0;
				V::[PlayerTrailer[playerid]][vToplivo] = 0;
				
				if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]))
	    			DestroyDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]);
				
            	DestroyVehicle(PlayerTrailer[playerid]);
            
	    			
	    		SetPVarInt(playerid,"dettachTrailer",0);
        		PlayerTrailer[playerid] = -1;
				DisablePlayerCheckpoint(playerid);
        		return SendClientMessage(playerid,C_GRAY,""gbError"Вы оставили свой прицеп на месте аренды.");
        	}
        }
    }
    if(areaid == strZones[5]) {
        if(PlayerTrailer[playerid] != -1 && V::[GetPlayerVehicleID(playerid)][vDalnDriver] == playerid) {
            if(GetPVarInt(playerid,"PlayerSelectTrailerTwo") == 2) {
                if(GetPVarInt(playerid,"SelectedToplivoMarsh") == 0) {
              		V::[PlayerTrailer[playerid]][vWoods] = 0;
					V::[PlayerTrailer[playerid]][vMebel] = 0;
					V::[PlayerTrailer[playerid]][vToplivo] = 0;
					
					if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]))
	    				DestroyDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]);
						
                    DestroyVehicle(PlayerTrailer[playerid]);
        
	    			
	    			SetPVarInt(playerid,"dettachTrailer",0);
        			PlayerTrailer[playerid] = -1;
					DisablePlayerCheckpoint(playerid);
        			return SendClientMessage(playerid,C_GRAY,""gbError"Вы не выбрали ни одного маршрута для доставки топлива.");
                }
            }
        }
    }
	return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[]) {
	strreplace(inputtext, '%', '#');
	strreplace(inputtext, '\n', '#');
	clear_massive();
    new string[1024], str[512];
  
	antiDialogHider( playerid, dialogid );
	if( dialog_cheat_use[playerid] == true ) return true;
	switch(dialogid) {
		case d_create: {
			if( !response ) return true;
			switch( listitem ) {
				case 0: {// Падик
					showPlayerDialog( playerid, d_create + 1, DIALOG_STYLE_INPUT, "Создание подъезда",
						"{ffffff}Укажите тип подъезда цифрой от 1 до 2", "Ввод", "Назад" );
					setData( playerid, "Player:ADMCreate", 1 );	
				}
				case 1: {
					showPlayerDialog( playerid, d_create + 1, DIALOG_STYLE_INPUT, "Создание дома",
						"{ffffff}Укажите интерьер дома и цену на дом\nПример: 1 10000", "Ввод", "Назад" );
					setData( playerid, "Player:ADMCreate", 2 );	
				}
			}
		}
		case d_create + 1: {
			if( !response ) return CallLocalFunction( "cmd_create", "d", playerid );
			switch( getData( playerid, "Player:ADMCrate" ) ) {
				case 1: CallLocalFunction( "cmd_addhostel", "ds", playerid, inputtext );
				case 2: CallLocalFunction( "cmd_addhouse", "ds", playerid, inputtext );
			}
			delData( playerid, "Player:ADMCrate" );
		}
