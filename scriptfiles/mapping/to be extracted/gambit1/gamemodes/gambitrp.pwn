public OnVehicleSpawn(vehicleid) 
{
    if( vehiclecallsign[vehicleid] == 1 )
	{
  		if( IsValidDynamic3DTextLabel( vehicle3Dtext[vehicleid] ) )
	    {
			DestroyDynamic3DTextLabel( vehicle3Dtext[vehicleid] );
			vehicle3Dtext[vehicleid] = Text3D: INVALID_3DTEXT_ID;
		   	vehiclecallsign[vehicleid] = 0;
		}
	}
	if(V::[vehicleid][vRentCar][0] == 1 && D::[V::[vehicleid][vRentCar][1]][dRentVehicleID] == vehicleid)
	{
		V::[vehicleid][vRentCar][0] = 0;
		D::[V::[vehicleid][vRentCar][1]][dRentVehicleID] = -1;
		D::[V::[vehicleid][vRentCar][1]][dRentVehicleTime] = 0;
		V::[vehicleid][vRentCar][1] = 0;
		V::[vehicleid][vHealth] = 1000.0;
		V::[vehicleid][vFuel] = MaxVehicleFuel[GetVehicleModel(vehicleid) - 400];
	}
    for(new i; i != 18; i ++) V::[vehicleid][vInvSlot][i] = 0,V::[vehicleid][vInvSlotKol][i] = 0;
    V::[vehicleid][vHealth] = 1000.0;
	V::[vehicleid][vWoods] = 0;
	V::[vehicleid][vMebel] = 0;
	V::[vehicleid][vToplivo] = 0;
	GetVehicleParamsEx(vehicleid,eng,light,other1,other2,other3,other4,other5);
	if(vehicleid >= ataxils[0] && vehicleid <= ataxils[1]) {
		SetPVarInt(V::[vehicleid][vTaxiDriver],"CountBackTaxi",0);
		DeletePVar(V::[vehicleid][vTaxiDriver],"CheckpointBack");
		SendClientMessage(V::[vehicleid][vTaxiDriver], -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
		showPlayerDialog(V::[vehicleid][vTaxiDriver],9999,0," ","{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке","Закрыть","");
		D::[V::[vehicleid][vTaxiDriver]][dTaxiKey] = -1;
    	D::[V::[vehicleid][vTaxiDriver]][dTaxiDuty] = false;
    	GiveTaxiMoney(V::[vehicleid][vTaxiDriver]);
		V::[vehicleid][vTaxiDriver] = -1;
		if(V::[vehicleid][vTaxiText] != -1) {
        	DestroyDynamicObject(V::[vehicleid][vTaxiText]);
        	V::[vehicleid][vTaxiText] = -1;
		}
		V::[vehicleid][vFuel] = MaxVehicleFuel[GetVehicleModel(vehicleid) - 400];
		SetVehicleParamsEx(vehicleid,false,0,other1,1,other3,other4,other5);
	}
	if(vehicleid >= buscars[0] && vehicleid <= buscars[1]) {
	    SendClientMessage(V::[vehicleid][vBusDriver], -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
		showPlayerDialog(V::[vehicleid][vBusDriver],9999,0," ","{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке","Закрыть","");
		D::[V::[vehicleid][vBusDriver]][dBusKey] = -1;
    	D::[V::[vehicleid][vBusDriver]][dBusDuty] = false;
    	SetPVarInt(V::[vehicleid][vBusDriver],"CountBackToBus",0);
    	SetPVarInt(V::[vehicleid][vBusDriver],"BusToGo",-1);
    	V::[vehicleid][vBusDriver] = -1;
    	SetVehicleParamsEx(vehicleid,false,0,other1,1,other3,other4,other5);
    	V::[vehicleid][vFuel] = MaxVehicleFuel[GetVehicleModel(vehicleid) - 400];
		if(V::[vehicleid][vBusText]) 
		{
			if (IsValidDynamic3DTextLabel(V::[vehicleid][vBusText]))
			{
				DestroyDynamic3DTextLabel(V::[vehicleid][vBusText]);
				V::[vehicleid][vBusText] = Text3D: INVALID_3DTEXT_ID;
			}
		}
	}
	if(vehicleid >= dalncars[0] && vehicleid <= dalncars[1]) {
    	SetPVarInt(V::[vehicleid][vDalnDriver],"CountBackDaln",0);
    	if(PlayerTrailer[V::[vehicleid][vDalnDriver]] != -1) {
    		V::[PlayerTrailer[V::[vehicleid][vDalnDriver]]][vWoods] = 0;
			V::[PlayerTrailer[V::[vehicleid][vDalnDriver]]][vMebel] = 0;
			V::[PlayerTrailer[V::[vehicleid][vDalnDriver]]][vToplivo] = 0;
			
			if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[V::[vehicleid][vDalnDriver]]][vTextTrailer]))
			{
				DestroyDynamic3DTextLabel(V::[PlayerTrailer[V::[vehicleid][vDalnDriver]]][vTextTrailer]);
				V::[PlayerTrailer[V::[vehicleid][vDalnDriver]]][vTextTrailer] = Text3D: INVALID_3DTEXT_ID;
			}
			
    		DestroyVehicle(PlayerTrailer[V::[vehicleid][vDalnDriver]]);
    		
    		PlayerTrailer[V::[vehicleid][vDalnDriver]] = -1;
			DisablePlayerCheckpoint(V::[vehicleid][vDalnDriver]);
			SetPVarInt(V::[vehicleid][vDalnDriver],"dettachTrailer",0);
		}
		if(V::[vehicleid][vProducts] != 0) {
		    V::[vehicleid][vProducts] = 0;
		    Product::[V::[vehicleid][vProductsID]][pStatus] = false;
		    V::[vehicleid][vProductsID] = 0;
		    if (IsValidDynamic3DTextLabel(V::[vehicleid][vProductsText]))
			{
		    	DestroyDynamic3DTextLabel(V::[vehicleid][vProductsText]);
				V::[vehicleid][vProductsText] = Text3D: INVALID_3DTEXT_ID;
			}
		}
		DeletePVar(V::[vehicleid][vDalnDriver],"CheckpointBackDaln");
		SendClientMessage(V::[vehicleid][vDalnDriver], -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
		showPlayerDialog(V::[vehicleid][vDalnDriver],9999,0," ","{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке","Закрыть","");
		D::[V::[vehicleid][vDalnDriver]][dDalnKey] = -1;
    	D::[V::[vehicleid][vDalnDriver]][dDalnDuty] = false;
    	for(new s;s<10;s++)
		{
			if(gTruckLoadTurn[0][s] == V::[vehicleid][vDalnDriver]) gTruckLoadTurn[0][s] = INVALID_PLAYER_ID;
		}

    	V::[vehicleid][vDalnDriver] = -1;
    	V::[vehicleid][vFuel] = MaxVehicleFuel[GetVehicleModel(vehicleid) - 400];
    	SetVehicleParamsEx(vehicleid, false, 0, other1,1,other3,other4,other5);
    	SetVehicleVirtualWorld(vehicleid, 0);

