				}
				case 4:
				{
				    showPlayerDialog(playerid,d_frac + 20,1," ","{ffffff}Введите ID человека которому хотите изменить подфракцию\n\n","Далее","Закрыть");
				}
			}
		}
		case d_frac + 20:
		{
		    if(!response) return 1;
			if(!strlen(inputtext)) return showPlayerDialog(playerid,d_frac + 20,1," ","{ffffff}Введите ID человека которому хотите изменить подфракцию\n\n","Далее","Закрыть");
			if(!isNumeric(inputtext)) return showPlayerDialog(playerid,d_frac + 20,1," ","{ffffff}Введите ID человека которому хотите изменить подфракцию\n\n","Далее","Закрыть");
			if(!IsPlayerConnected(strval(inputtext))) return showPlayerDialog(playerid,d_frac + 20,1," ","{ffffff}Введите ID человека которому хотите изменить подфракцию\n\n"gbError"Игрок вышел из игры","Далее","Закрыть");
			if(Player[strval(inputtext)][uMember] == 0) return showPlayerDialog(playerid,d_frac + 20,1," ","{ffffff}Введите ID человека которому хотите изменить подфракцию\n\n"gbError"Игрок не находится в организации","Далее","Закрыть");
			if(Player[strval(inputtext)][uMember] != Player[playerid][uMember]) showPlayerDialog(playerid,d_frac + 20,1," ","{ffffff}Введите ID человека которому хотите изменить подфракцию\n\n"gbError"Игрок не из Вашей организации","Далее","Закрыть");
			SetPVarInt(playerid,"ChangeIDSubFrac", strval(inputtext));
			showPlayerDialog(playerid,d_frac + 21,1," ","{ffffff}Введите ID подфракции\n\nЧисло от 1 до 4","Далее","Закрыть");

			//format(string, sizeof(string), "%s %s изменил Вашу подфракцию на %d", FRank[Player[playerid][uMember]][Player[playerid][uRank] - 1], Player[playerid][uName], );
			//SendClientMessage

		}
		case d_frac + 21:
		{
		    if(!response) return 1;
		    if(!strlen(inputtext)) showPlayerDialog(playerid,d_frac + 21,1," ","{ffffff}Введите ID подфракции\n\nЧисло от 1 до 4","Далее","Закрыть");
		    if(!isNumeric(inputtext)) showPlayerDialog(playerid,d_frac + 21,1," ","{ffffff}Введите ID подфракции\n\nЧисло от 1 до 4","Далее","Закрыть");
		    if(strval(inputtext) < 0 || strval(inputtext) > 4) showPlayerDialog(playerid,d_frac + 21,1," ","{ffffff}Введите ID подфракции\n\nЧисло от 1 до 4."gbError"Вы ввели некорректное число.","Далее","Закрыть");
			new changeID = GetPVarInt(playerid, "ChangeIDSubFrac");
