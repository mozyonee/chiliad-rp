			            }
					}
			    }
			}
		}
		case PLAYER_STATE_ONFOOT: {
		    for(new i; i != 3; i++) TextDrawHideForPlayer(playerid, SpeedFon[i]);
			for(new i; i != 8; i++) PlayerTextDrawHide(playerid,Speed[i][playerid]);
		}
		case PLAYER_STATE_PASSENGER: {
			if(car >= ataxils[0] && car <= ataxils[1]) {
				if(V::[car][vTaxiDriver] != -1 && IsPlayerInAnyVehicle(V::[car][vTaxiDriver]) && GetPlayerVehicleSeat(V::[car][vTaxiDriver]) == 0) {
					if(Player[playerid][uMoney] < D::[V::[car][vTaxiDriver]][dTaxiFare]) return removePlayerFromVehicle(playerid),SendClientMessage(playerid,C_GRAY,""gbError"У вас недостаточно средств для проезда в этом такси.");
					Player[playerid][uMoney] -= D::[V::[car][vTaxiDriver]][dTaxiFare];
                    nowUpdateInfo(playerid , "d" , "gb_users" , "uName" , "uMoney" , Player[playerid][uMoney]);
					Player[V::[car][vTaxiDriver]][uMoney] += D::[V::[car][vTaxiDriver]][dTaxiFare];
					nowUpdateInfo(V::[car][vTaxiDriver] , "d" , "gb_users" , "uName" , "uMoney" , Player[V::[car][vTaxiDriver]][uMoney]);
                    showPlayerDialog(playerid,9999,0," ","{ffffff}Укажите водителю маршрут, по которому вы хотите ехать.\n\n"cGREEN"ESC - Карта - ПКМ","Закрыть","");
					if(D::[V::[car][vTaxiDriver]][dTaxiFare] == 0) return SendClientMessage(playerid,C_GRAY,""gbAccess"Вы сели в бесплатное такси.");
					format(string,sizeof(string),""gbAccess"Вы отдали водителю такси $%d за проезд.",D::[V::[car][vTaxiDriver]][dTaxiFare]);
					SendClientMessage(playerid,C_GREEN,string);
					format(string,sizeof(string),""gbInfo"Пассажир отдал Вам $%d за проезд.",D::[V::[car][vTaxiDriver]][dTaxiFare]);
					SendClientMessage(V::[car][vTaxiDriver],C_GREEN,string);
				}
			}
			if(car >= buscars[0] && car <= buscars[1]) {
			    if(V::[car][vBusDriver] != -1 && IsPlayerInAnyVehicle(V::[car][vBusDriver]) && GetPlayerVehicleSeat(V::[car][vBusDriver]) == 0) {
			        if(Player[playerid][uMoney] < S::[0][sMeria][1]) {
			        	SendClientMessage(playerid,C_GRAY,""gbError"У Вас недостаточно средств для проезда в автобусе.");
			        	return removePlayerFromVehicle(playerid);
			        }
			        Player[playerid][uMoney] -= S::[0][sMeria][1];
			        S::[0][sMeria][0] += S::[0][sMeria][1];
			        nowUpdateInfo(playerid , "d" , "gb_users" , "uName" , "uMoney" , Player[playerid][uMoney]);
			        MeAction(playerid,"заплатил(-а) за проезд",1);
			        format(string,sizeof(string),"UPDATE gb_others SET sMeria0 = %d",S::[0][sMeria][0]);
					mysql_tquery(1, string, "", "");
			    }
			}
		}
    }

    return 1;
}

public OnPlayerGiveDamage(playerid, damagedid, Float: amount, weaponid) {
	new string[128];
	if(damagedid != INVALID_PLAYER_ID) {
		switch(random(10)) {
			case 0 .. 4: {
				if(weaponid == 3 && _itemsInfo[Inv[playerid][invSlot][50]][invID] == 65) {
					if(Player[damagedid][uMember] == 8 || Player[damagedid][uMember] == 1 || Player[damagedid][uMember] == 2) return 1;
					togglePlayerControllable(damagedid,false);
					SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);
					SendClientMessage(playerid,C_GRAY,""gbAccess"Вы сильно ударили и оглушили данного человека.");
					SendClientMessage(damagedid,C_GRAY,""gbInfo"Ваc сильно ударили и вы потеряли сознание на 10 секунд.");
					ApplyAnimation(damagedid, "CRACK", "crckdeth2", 4.0, 0, 1, 1, 1, 0, 1);
					format(string,sizeof(string),"оглушил(-а) %s",Player[damagedid][uName]);
					MeAction(playerid,string,1);
					MeAction(damagedid,"оглушен(-а)",1);
				}
			}
			case 5 .. 9: {}
		}
	}
	if (weaponid == 23 && GetPVarInt(playerid, "Tazer") >= 1 && GetPVarInt(damagedid, "Stunned") <= 0)
 	{
		if (GetPlayerState(damagedid) != PLAYER_STATE_ONFOOT)
  			return SendClientMessage(playerid, -1,""gbError"Игрок должен находиться не в авто.");
		if (GetDistanceBetweenPlayers(playerid, damagedid) > 10.0)
  			return SendClientMessage(playerid, -1,""gbError"Вы промохнулись, потому что игрок далеко.");
		SetPVarInt(damagedid, "Stunned", 60);
		togglePlayerControllable(damagedid, false);
		SendClientMessage(damagedid,C_GRAY,""gbInfo"Вы были оглушены тазером на 60 секунд.");
		format(string,sizeof(string),"оглушил(-а) %s",Player[damagedid][uName]);
		MeAction(playerid,string,1);
		MeAction(damagedid,"оглушен(-а)",1);
		ApplyAnimation(damagedid, "CRACK", "crckdeth4", 4.0, 0, 0, 0, 1, 0, 1);
   }
    return 1;
}

public OnVehicleDeath(vehicleid, killerid)
{
	return 1;
}

public OnPlayerDeath(playerid, killerid, reason)
{
	if(GetPVarInt(playerid, "ObjectFireStatus") >= 1)
	{
	    DestroyDynamicObject(GetPVarInt(playerid, "ObjectFireOne"));
	    DestroyDynamicObject(GetPVarInt(playerid, "ObjectFireTwo"));
	    DeletePVar(playerid, "ObjectFireOne");
	    DeletePVar(playerid, "ObjectFireTwo");
	    DeletePVar(playerid, "ObjectFireStatus");

	    DeletePVar(playerid, "ObjectFireX");
	    DeletePVar(playerid, "ObjectFireY");
	    DeletePVar(playerid, "ObjectFireZ");
	}
	
	switch( getData( playerid, "PlayerMenuShow" ) ) {
		case 1: {
			for( new i; i != 21; i++ ) TextDrawHideForPlayer( playerid, MenuPlayer[i] );
			for( new i; i != 3; i++ ) PlayerTextDrawHide( playerid, menuPlayer[i][playerid] );
		}
		case 2: {
			TextDrawHideForPlayer(playerid, FermFon[0]);
		    TextDrawHideForPlayer(playerid, FermFon[1]);
			PlayerTextDrawHide(playerid, FermSelectSkin[0][playerid]);
			PlayerTextDrawHide(playerid, FermSelectSkin[1][playerid]);
			PlayerTextDrawHide(playerid, FermSelectSkin[2][playerid]);
		}
		case 3: {
			for(new i; i != 9; i ++) 
			{
				if( i == 5 )
					continue;
					
				TextDrawHideForPlayer(playerid, dalnmenu[i]);
			}
			PlayerTextDrawHide(playerid,dalnmenuplayer[playerid]);
		}
		case 4: {
		    for(new i; i != 22; i++) 
			{		
				TextDrawHideForPlayer(playerid,invPlayer[i]);
            }
			for(new s; s != 61; s++) PlayerTextDrawHide(playerid,invSPlayer[playerid][s]);
            SetPVarInt(playerid,"changeSlot",-1);
	        SetPVarInt(playerid,"selectSlot",-1);
	        switch(GetPVarInt(playerid,"UseSlots"))
			{
	        	case 0,1: {
	        		for(new i; i != 18; i++) PlayerTextDrawHide(playerid,slotUse[i][playerid]);
            		for(new i; i != 3; i++) PlayerTextDrawHide(playerid,iconUse[i][playerid]);
            		
	        	}
	        	case 2,3,8,9: {// Пончики тоже
	        		for(new i; i != 16; i ++) {
	        			TextDrawHideForPlayer(playerid,buyingShopFon[i]);
	        			PlayerTextDrawHide(playerid,buyingShopItems[i][playerid]);
	        			PlayerTextDrawHide(playerid,buyingShopInfo[i][playerid]);
	        		}
	        	}
	        	case 6:
	        	{
	        	    for(new i; i != 30; i++) PlayerTextDrawHide(playerid,Warehouse[i][playerid]);
	        	    for(new i; i != 3; i++) PlayerTextDrawHide(playerid,iconUse[i][playerid]);
	        	}
	        	case 7:
	        	{
	        	    for(new i; i != 18; i++) PlayerTextDrawHide(playerid,slotUse[i][playerid]);
            		for(new i; i != 3; i++) PlayerTextDrawHide(playerid,iconUse[i][playerid]);
	        	}
	        }
            for(new i = 48; i != 56; i++) PlayerTextDrawSetSelectable(playerid,invSPlayer[playerid][i], 1);
		}
		case 9: {
			for(new i; i != 13; i++) PlayerTextDrawHide(playerid, NewSkinSelect[i][playerid]);
		}

	}
	SetPVarInt(playerid,"PlayerMenuShow",0);
	SetPVarInt(playerid,"UseSlots",-1);
    CancelSelectTextDraw(playerid);
    SetCameraBehindPlayer(playerid);

    if(GetPVarInt(playerid,"TimerStanok")) {
		KillTimer(GetPVarInt(playerid,"TimerStanok"));
		DeletePVar(playerid,"TimerStanok");
	}
	if(GetPVarInt(playerid,"EffectGone")) {
		KillTimer(GetPVarInt(playerid,"EffectGone"));
		DeletePVar(playerid,"EffectGone");
	}
    if(GetPVarInt(playerid,"WoodsPlayer")) {
		KillTimer(GetPVarInt(playerid,"WoodsPlayer"));
		DeletePVar(playerid,"WoodsPlayer");
	}

	if(GetPVarInt(playerid,"CountBackTaxi") != 0) SetPVarInt(playerid,"CountBackTaxi",0);
	if(GetPVarInt(playerid,"CountBackToBus") != 0) SetPVarInt(playerid,"CountBackToBus",0);
	if(GetPVarInt(playerid,"TimerCountWoods") != 0) SetPVarInt(playerid,"TimerCountWoods",0);
	if(GetPVarInt(playerid,"CountBackDaln") != 0) SetPVarInt(playerid,"CountBackDaln",0);

	if(GetPVarInt(playerid,"BizzBuyingCamera")) { DeletePVar(playerid,"BizzBuyingCamera"); Bizz::[GetPVarInt(playerid,"BizzBuyingCamera")][bCamera] = false; }
	if(GetPVarInt(playerid,"follow") != INVALID_PLAYER_ID) SetPVarInt(GetPVarInt(playerid,"follow"),"follow",INVALID_PLAYER_ID);
	if(GetPVarInt(playerid,"PlayerCameraHouse") == 1) {
		Player[playerid][uP][0] = GetPVarFloat(playerid,"HouseBuyX");
		Player[playerid][uP][1] = GetPVarFloat(playerid,"HouseBuyY");
		Player[playerid][uP][2] = GetPVarFloat(playerid,"HouseBuyZ");
		Player[playerid][uInt][0] = 1;
		Player[playerid][uInt][1] = 0;
		togglePlayerControllable(playerid,false);
		DeletePVar(playerid,"PlayerCameraHouse");
	}
	if(GetPVarInt(playerid,"PlayerSelectedProducts") != 0) Product::[GetPVarInt(playerid,"PlayerSelectedProducts") - 1][bStatus] = false;
	if(GetPVarInt(playerid,"AdvertID") != -1) AD::[GetPVarInt(playerid,"AdvertID")][adUsed] = false;

	if(newsLeaderEther == playerid) {
		newsLeaderEther = INVALID_PLAYER_ID;
		EtherStatus = false;
	}
	if(newsClientEther == playerid) newsClientEther = INVALID_PLAYER_ID;

	if(D::[playerid][dTaxiKey] != -1) {
		D::[playerid][dTaxiDuty] = false;
		SetPVarInt(playerid,"CountBackTaxi",0);
		DeletePVar(playerid,"CheckpointBack");
		SetVehicleToRespawn(D::[playerid][dTaxiKey]);
	}
	if(D::[playerid][dDalnKey] != -1) {
		D::[playerid][dDalnDuty] = false;
		SetPVarInt(playerid,"CountBackDaln",0);
		DeletePVar(playerid,"CheckpointBackDaln");
		SetVehicleToRespawn(D::[playerid][dDalnKey]);
	}
	if(D::[playerid][dBusKey] != -1) {
		D::[playerid][dBusDuty] = false;
		DisablePlayerRaceCheckpoint(playerid);
		SetPVarInt(playerid,"CountBackToBus",0);
		SetPVarInt(playerid,"BusToGo",-1);
		SetVehicleToRespawn(D::[playerid][dBusKey]);
	}
	foreach(new i: Player)
	{
		if(Player[i][uAdmin] >= 1) SendDeathMessageToPlayer(i, killerid, playerid, reason);
	}
	return 1;
}

