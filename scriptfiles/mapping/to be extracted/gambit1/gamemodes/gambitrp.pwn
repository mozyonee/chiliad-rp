			if(!strlen(inputtext)) return showPlayerDialog(playerid,d_frac + 6,1," ","{ffffff}Введите ID человека которого хотите уволить из организации:\n\n","Далее","Закрыть");
			if(!isNumeric(inputtext)) return showPlayerDialog(playerid,d_frac + 6,1," ","{ffffff}Введите ID человека которого хотите уволить из организации:\n\n","Далее","Закрыть");
			if(!IsPlayerConnected(strval(inputtext))) return showPlayerDialog(playerid,d_frac + 6,1," ","{ffffff}Введите ID человека которого хотите уволить из организации:\n\n","Далее","Закрыть");
			if(Player[strval(inputtext)][uMember] != Player[playerid][uMember]) return showPlayerDialog(playerid,d_frac + 6,1," ","{ffffff}Введите ID человека которого хотите уволить из организации:\n\n","Далее","Закрыть");
			if(playerid == strval(inputtext)) return SendClientMessage(playerid,C_GRAY,""gbError"Вы не можете уволить самого себя из организации!");
			if(F::[Player[playerid][uMember]][fRank][1] > Player[playerid][uRank] || Player[strval(inputtext)][uRank] > Player[playerid][uRank]) return showPlayerDialog(playerid,d_frac + 6,1," ","{ffffff}Введите ID человека которого хотите уволить из организации:\n\n","Далее","Закрыть");


			new id = strval(inputtext);
			Player[id][uMember] = 0;
			Player[id][uRank] = 0;
			format(query,sizeof(query),"UPDATE gb_users SET uMember = '%d',uRank = '%d' WHERE BINARY uName = '%s'",Player[id][uMember],Player[id][uRank],Player[id][uName]);
			mysql_tquery(1, query, "", "");
