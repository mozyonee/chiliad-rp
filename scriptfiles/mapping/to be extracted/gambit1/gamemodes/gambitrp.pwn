    SetPlayerAttachedObject(playerid,index,modelid,boneid,fOffsetX,fOffsetY,fOffsetZ,fRotX,fRotY,fRotZ,fScaleX,fScaleY,fScaleZ);
    printf("%d, %d, %f, %f, %f,  %f, %f, %f, %f, %f, %f", modelid,boneid,fOffsetX,fOffsetY,fOffsetZ,fRotX,fRotY,fRotZ,fScaleX,fScaleY,fScaleZ);
	return true;
}

stock OnPlayerRentVeh( playerid, time ) 
{
    new 
		veh = GetPVarInt(playerid, "rent_veh"),
		price = GetPVarInt(playerid, "rent_price");
		
	foreach(new x: Player) 
	{
		if( !GetPVarInt(playerid, "uLogin") ) 
			continue;
			
		if(D::[x][dRentVehicleID] != veh || x == playerid)
			continue;
		
		removePlayerFromVehicle(playerid);
		
		if( D::[playerid][dRentVehicleID] )
		{
			SetVehicleToRespawn(GetPlayerVehicleID(playerid));
		}
		return 1;
	}
	
	SetPVarInt(playerid, "rent_time", time);

	format:vb_string( "{ffffff}Вы действительно хотите арендовать данное транспортное средство\nна "cGREEN"%i{ffffff} минут за "cGREEN"$%i{ffffff}?", time, price * time );
	showPlayerDialog(playerid, d_bizz + 35, DIALOG_STYLE_MSGBOX, "Аренда транспорта", vb_string, "Нет", "Да");
	return 1;
}

function OnPlayerRentTimeOut( playerid )
{
	if( IsPlayerInAnyVehicle( playerid ) )
	{
		removePlayerFromVehicle( playerid );
		
		if( D::[playerid][dRentVehicleID] ) 
		{
			SetVehicleToRespawn( D::[playerid][dRentVehicleID] );
		}
	}
	
	KillTimer( player_rent_timer[playerid] );
	return 1;
}


stock OnPlayerRentAccept(playerid) {
	new string[120];
    new veh = GetPVarInt(playerid, "rent_veh"), time = GetPVarInt(playerid, "rent_time"), price = GetPVarInt(playerid, "rent_price"), id = GetPVarInt(playerid, "rent_bizz");
    new cost = price * time;
	
	KillTimer( player_rent_timer[playerid] );
    if(Player[playerid][uMoney] < cost) {
		SendClientMessage(playerid, -1, ""gbError"Простите, но у Вас недостаточно денег для аренды транспорта");
        removePlayerFromVehicle(playerid);
        if(D::[playerid][dRentVehicleID]) SetVehicleToRespawn(GetPlayerVehicleID(playerid));
		return 1;
	}
	foreach(new x: Player) {
		if(!GetPVarInt(playerid, "uLogin")) continue;
		if(D::[x][dRentVehicleID] != veh || x == playerid) continue;
		removePlayerFromVehicle(playerid);
		if(D::[playerid][dRentVehicleID]) SetVehicleToRespawn(GetPlayerVehicleID(playerid));
		return 1;
	}
	if(Bizz::[id][bSettings][3] < cost)
	{
	    removePlayerFromVehicle(playerid);
		if(D::[playerid][dRentVehicleID]) SetVehicleToRespawn(GetPlayerVehicleID(playerid));
		if(Bizz::[id][bRating] > 0) Bizz::[id][bRating]--;
		SetBizzInt(Bizz::[id][bID],"bRate", Bizz::[id][bRating]);
		return SendClientMessage(playerid,C_GRAY,""gbError"В бизнесе закончились товары!");
	}
	
	
	Player[playerid][uMoney] -= cost;
 	mysql_format(1, string, sizeof(string),"UPDATE gb_users SET uMoney = '%d' WHERE BINARY uName = '%s'",Player[playerid][uMoney],Player[playerid][uName]);
	mysql_tquery(1, string, "", "");

	Bizz::[id][bSettings][3] -= cost;
	Bizz::[id][bSettings][6] += cost;
	if(Bizz::[id][bRating] < 5000) Bizz::[id][bRating]++;
	SetBizzInt(Bizz::[id][bID],"bRate", Bizz::[id][bRating]);
	format(string,sizeof(string),"%d|%d|%d|%d|%d|%d|%d|%d",Bizz::[id][bSettings][0],Bizz::[id][bSettings][1],Bizz::[id][bSettings][2],
	Bizz::[id][bSettings][3],Bizz::[id][bSettings][4],Bizz::[id][bSettings][5],Bizz::[id][bSettings][6],Bizz::[id][bSettings][7]);
	SetBizzStr(Bizz::[id][bID],"bSettings",string);
	
	if(GetVehicleModel(veh) != 442) ChangeVehicleColor(veh, random(150), random(150));
	
	V::[veh][vRentCar][0] = 1;
	V::[veh][vRentCar][1] = playerid;
	D::[playerid][dRentVehicleID] = veh;
	D::[playerid][dRentVehicleTime] = time;
	SendClientMessage(playerid, -1, ""gbAccess"Вы успешно арендовали транспорт!");
	SendClientMessage(playerid, -1, ""gbInfo"Для открытия / закрытия центрального замка, введите команду "cGREEN"\"/lock 5\".");
	
	
	return 1;
}
stock Getinic(name[]) //Инициалы
{
    new str[MAX_PLAYER_NAME],i;
    format(str,MAX_PLAYER_NAME,name);
    while(i<strlen(str)) { if(str[i]=='_') break; i++; }
    strdel(str,i+2,strlen(str)), strdel(str,1,i+1);
    return str;
}

stock SetPlayerFightingStyleEx( playerid ) {
    new Style[10];
	switch(Player[playerid][uChangeStyle]) {
	    case 0: SetPlayerFightingStyle(playerid, FIGHT_STYLE_NORMAL);
	    case 1: {
	        switch(Player[playerid][uStyle][0]) {
  				case 1000: for(new A; A != 7; A++) Style[A] = 1;
	     		case 800..999: for(new A; A != 6; A++) Style[A] = 1;
			    case 640..799: for(new A; A != 5; A++) Style[A] = 1;
	    	 	case 480..639: for(new A; A != 4; A++) Style[A] = 1;
			    case 320..479: for(new A; A != 3; A++) Style[A] = 1;
			    case 160..319: for(new A; A != 2; A++) Style[A] = 1;
			    case 1..159: Style[0] = 1;
			}
			new ChooseStyle = random(8);
			for(new A; A != 7; A++) if(A == ChooseStyle && Style[A] == 1) return SetPlayerFightingStyle(playerid, FIGHT_STYLE_BOXING);
	    }
	    case 2: {
	        switch(Player[playerid][uStyle][1]) {
			    case 1000: for(new A; A != 4; A++) Style[A] = 1;
			    case 600..999: for(new A; A != 3; A++) Style[A] = 1;
			    case 300..599: for(new A; A != 2; A++) Style[A] = 1;
			    case 1..299: Style[0] = 1;
			}
			new ChooseStyle = random(5);
			for(new A; A != 4; A++) if(A == ChooseStyle && Style[A] == 1) return SetPlayerFightingStyle(playerid, FIGHT_STYLE_KUNGFU);
	    }
	    case 3: {
	        switch(Player[playerid][uStyle][4]) {
			    case 1000: for(new A; A != 4; A++) Style[A] = 1;
			    case 600..999: for(new A; A != 3; A++) Style[A] = 1;
			    case 300..599: for(new A; A != 2; A++) Style[A] = 1;
			    case 1..299: Style[0] = 1;
			}
			new ChooseStyle = random(5);
			for(new A; A != 4; A++) if(A == ChooseStyle && Style[A] == 1) return SetPlayerFightingStyle(playerid, FIGHT_STYLE_KNEEHEAD);
	    }
	}
	return 1;
}

stock LaunchPlayerGym(playerid, gym) {
	
	if(!IsPlayerInDynamicArea(playerid, GymData[gym][gymAreaID])) return 0;
	if(GymData[gym][gymStatus] != playerid && GymData[gym][gymStatus] != INVALID_PLAYER_ID) return SendClientMessage(playerid, -1, ""gbError"Данный тренажер уже занят.");
	else if(GymData[gym][gymStatus] == INVALID_PLAYER_ID) {
	    if(Player[playerid][uValueSt] >= 200) return SendClientMessage(playerid, -1, ""gbError"Вы слишком устали, приходите завтра.");
	    
	    SetPVarInt(playerid, "gym_id", gym + 1);
	    GymData[gym][gymStatus] = playerid;
	    SetPlayerPos(playerid, GymData[gym][gymPosX], GymData[gym][gymPosY], GymData[gym][gymPosZ]);
	    SetPlayerFacingAngle(playerid, GymData[gym][gymPosA]);
	   	D::[playerid][dGymTimer] = SetTimerEx("GymTimer", 50, true, "i", playerid);
	    switch(GymData[gym][gymType]) {
	    	case GYM_TYPE_VELO: {
	    	    ApplyAnimation(playerid, "GYMNASIUM", "gym_bike_geton", 4.0, 0, 0, 0, 1, 0, 1);
			}
			case GYM_TYPE_TRACK: {
			    ApplyAnimation(playerid, "GYMNASIUM", "gym_tread_geton", 4, 0, 0, 0, 1, 0, 1);
			}
			case GYM_TYPE_BENCH: {
			    ApplyAnimation(playerid, "benchpress", "gym_bp_geton", 4, 0, 0, 0, 1, 0, 1);
			    RemovePlayerAttachedObject(playerid, 2);
			}
			case GYM_TYPE_BARB: {
			    ApplyAnimation(playerid, "Freeweights", "gym_free_pickup", 4, 0, 0, 0, 1, 0, 1);
			    RemovePlayerAttachedObject(playerid, 2);
			}
			default: return 0;
		}
		//for(new i; i < 2; i ++) PlayerTextDrawShow(playerid, TextDrawForBar[i][playerid]);
		universalbar[playerid] = CreatePlayerProgressBar(playerid, 618.411,145.083,5.647,106.166, 786038783, 5);
		UpdatePlayerProgressBar(playerid, universalbar[playerid]);
		ShowPlayerProgressBar(playerid, universalbar[playerid]);
		SetPlayerProgressBarMaxValue(playerid, universalbar[playerid], 70);
		SetPlayerProgressBarValue(playerid, universalbar[playerid], 0);
		UpdatePlayerProgressBar(playerid, universalbar[playerid]);
		
		SetPVarInt(playerid, "gym_value", 0);
		SetPVarInt(playerid, "gym_bar_show", 1);
		
		
		//PlayerTextDrawSetString(playerid, TextDrawForBar[1][playerid], "Прогресс:");
	}
	else if(GymData[gym][gymStatus] == playerid) {
	    DeletePVar(playerid, "gym_id");
	    DeletePVar(playerid, "gym_tick");
	    GymData[gym][gymStatus] = INVALID_PLAYER_ID;
	    SetCameraBehindPlayer(playerid);
	    KillTimer(D::[playerid][dGymTimer]);
		switch(GymData[gym][gymType]) {
			case GYM_TYPE_VELO: {
			    ApplyAnimation(playerid, "GYMNASIUM", "gym_bike_getoff", 4.0, 0, 0, 0, 0, 0, 1);
			}
			case GYM_TYPE_TRACK: {
			    ApplyAnimation(playerid, "GYMNASIUM", "gym_tread_getoff", 4, 0, 0, 0, 0, 0);
			}
			case GYM_TYPE_BENCH: {
			    ApplyAnimation(playerid, "benchpress", "gym_bp_getoff", 4, 0, 0, 0, 0, 0);
			    RemovePlayerAttachedObject(playerid, 2);
			}
			case GYM_TYPE_BARB: {
			    ApplyAnimation(playerid, "Freeweights", "gym_free_putdown", 4, 0, 0, 0, 0, 0);
			    RemovePlayerAttachedObject(playerid, 2);
			}
		}
		//for(new i; i < 2; i ++) PlayerTextDrawHide(playerid, TextDrawForBar[i][playerid]);
		if(GetPVarInt(playerid, "gym_bar_show") >= 1) {
			HidePlayerProgressBar(playerid, universalbar[playerid]);
			DestroyPlayerProgressBar(playerid, universalbar[playerid]);
			SetPVarInt(playerid, "gym_bar_show", 0);
		}

	}
	return 1;
}

stock EngageInGym(playerid) {
	new
	    b_gym = GetPVarInt(playerid, "gym_id")
	;
	if(!b_gym) return 0;
	if(b_gym < 1 || b_gym > sizeof(GymData)) return 0;
	if(GymData[b_gym - 1][gymStatus] != playerid) return 0;
	if(!IsPlayerInDynamicArea(playerid, GymData[b_gym - 1][gymAreaID])) return 0;
	new
	    b_tick = GetTickCount() - GetPVarInt(playerid, "gym_tick")
	;
	switch(GymData[b_gym - 1][gymType]) {
		case GYM_TYPE_VELO: {
			if(b_tick >= 1000) ApplyAnimation(playerid,"GYMNASIUM","gym_bike_pedal", 4.0, 0, 0, 0, 1, -1, 1);
			else if(b_tick >= 500) ApplyAnimation(playerid,"GYMNASIUM","gym_bike_fast", 4.0, 0, 0, 0, 1, -1, 1);
			else if(GetPVarInt(playerid, "gym_tick")) ApplyAnimation(playerid,"GYMNASIUM","gym_bike_faster", 4.0, 0, 0, 0, 1, -1, 1);
		}
		case GYM_TYPE_TRACK: {
		    if(b_tick >= 1000) ApplyAnimation(playerid,"GYMNASIUM","gym_tread_walk", 4.0, 0, 0, 0, 1, -1, 1);
			else if(b_tick >= 500) ApplyAnimation(playerid,"GYMNASIUM","gym_tread_jog", 4.0, 0, 0, 0, 1, -1, 1);
			else if(GetPVarInt(playerid, "gym_tick")) ApplyAnimation(playerid,"GYMNASIUM","gym_tread_sprint", 4.0, 0, 0, 0, 1, -1, 1);
		    //if(b_tick >= 1000) ApplyAnimation(playerid, "GYMNASIUM", "gym_tread_jog", 4, 0, 0, 0, 1, 0);
		}
		case GYM_TYPE_BENCH: {
		    if(b_tick >= 1000) ApplyAnimation(playerid, "benchpress", "gym_bp_up_smooth", 4, 0, 0, 0, 1, 0);
			else if(b_tick >= 500) ApplyAnimation(playerid, "benchpress", "gym_bp_up_smooth", 4, 0, 0, 0, 1, 0);
			else if(GetPVarInt(playerid, "gym_tick")) ApplyAnimation(playerid, "benchpress", "gym_bp_up_smooth", 4, 0, 0, 0, 1, 0);
			if(!IsPlayerAttachedObjectSlotUsed(playerid, 2)) SetPlayerAttachedObject(playerid, 2, 2913, 6, 0.033000, 0.028000, -0.104999, 5.699995, -1.999999, 0.500062, 1.000000, 1.000000, 1.000000);
		}
		case GYM_TYPE_BARB: {
		    if(b_tick >= 1000) ApplyAnimation(playerid,"Freeweights","gym_free_celebrate", 4, 0, 0, 0, 1, 0);
			else if(b_tick >= 500) ApplyAnimation(playerid,"Freeweights","gym_free_up_smooth", 4, 0, 0, 0, 1, 0);
			else if(GetPVarInt(playerid, "gym_tick")) ApplyAnimation(playerid,"Freeweights","gym_free_up_smooth", 4, 0, 0, 0, 1, 0);
			if(!IsPlayerAttachedObjectSlotUsed(playerid, 2)) SetPlayerAttachedObject(playerid, 2, 2915, 6, 0.083999, 0.000000, -0.039999, -7.199998, -87.000038, -3.199999, 1.000000, 1.000000, 1.000000);
		}
	}

	SetPVarInt(playerid, "gym_value", GetPVarInt(playerid, "gym_value") + 1);
	if(GetPVarInt(playerid, "gym_bar_show") >= 1)
	{
 		SetPlayerProgressBarValue(playerid, universalbar[playerid], GetPVarInt(playerid, "gym_value"));
 		UpdatePlayerProgressBar(playerid, universalbar[playerid]);
	}
	if(GetPVarInt(playerid, "gym_value") >= 70)
	{
	    if(Player[playerid][uValueSt] >= 200)
	    {
	        DeletePVar(playerid, "gym_id");
		    DeletePVar(playerid, "gym_tick");
		    GymData[b_gym - 1][gymStatus] = INVALID_PLAYER_ID;
		    SetCameraBehindPlayer(playerid);
		    KillTimer(D::[playerid][dGymTimer]);
			switch(GymData[b_gym - 1][gymType]) {
				case GYM_TYPE_VELO: {
				    ApplyAnimation(playerid, "GYMNASIUM", "gym_bike_getoff", 4.0, 0, 0, 0, 0, 0, 1);
				}
				case GYM_TYPE_TRACK: {
				    ApplyAnimation(playerid, "GYMNASIUM", "gym_tread_getoff", 4, 0, 0, 0, 0, 0);
				}
				case GYM_TYPE_BENCH: {
				    ApplyAnimation(playerid, "benchpress", "gym_bp_getoff", 4, 0, 0, 0, 0, 0);
				    RemovePlayerAttachedObject(playerid, 2);
				}
				case GYM_TYPE_BARB: {
				    ApplyAnimation(playerid, "Freeweights", "gym_free_putdown", 4, 0, 0, 0, 0, 0);
				    RemovePlayerAttachedObject(playerid, 2);
				}
			}
			//for(new i; i < 2; i ++) PlayerTextDrawHide(playerid, TextDrawForBar[i][playerid]);
			if(GetPVarInt(playerid, "gym_bar_show") >= 1) {
				HidePlayerProgressBar(playerid, universalbar[playerid]);
				DestroyPlayerProgressBar(playerid, universalbar[playerid]);
				SetPVarInt(playerid, "gym_bar_show", 0);
			}
	        return 1;
	    }
        switch(GymData[b_gym - 1][gymType]) {
			case GYM_TYPE_VELO, GYM_TYPE_TRACK: {
                Player[playerid][uStyle][2]++;
                Player[playerid][uValueSt]++;
				GameTextForPlayer(playerid, "~w~Endurance ~g~+", 500, 1);
				nowUpdateInfo(playerid, "d" , "gb_users" , "uName" , "StyleThree" , Player[playerid][uStyle][2]);
				nowUpdateInfo(playerid, "d" , "gb_users" , "uName" , "ValueSt" , Player[playerid][uValueSt]);
			}
			case GYM_TYPE_BENCH, GYM_TYPE_BARB: {
		        Player[playerid][uStyle][3]++;
		        Player[playerid][uValueSt]++;
				GameTextForPlayer(playerid, "~w~Streight ~g~+", 500, 1);
				nowUpdateInfo(playerid, "d" , "gb_users" , "uName" , "StyleFour" , Player[playerid][uStyle][3]);
				nowUpdateInfo(playerid, "d" , "gb_users" , "uName" , "ValueSt" , Player[playerid][uValueSt]);
			}
		}
		SetPlayerProgressBarValue(playerid, universalbar[playerid], 1);
		UpdatePlayerProgressBar(playerid, universalbar[playerid]);
		SetPVarInt(playerid, "gym_value", 0);
	}
	SetPVarInt(playerid, "gym_tick", GetTickCount());
	return 1;
}

public OnPlayerSelectDynamicObject(playerid, objectid, modelid, Float:x, Float:y, Float:z) {
	//SendClientMessage( playerid, -1, "ОБЪЕКТ КЛИКНУЛ" );
	if( GetPVarInt( playerid, "d_select" ) ) {
		for( new i; i < MAX_OBJECT ; i++ ) {
		    if(ObjList[i][oID]) {
		        if( ObjList[i][oObject] == objectid ) {
		            DestroyDynamicObject( objectid );
		            //DestroyDynamicObject(ObjList[i][oObject]);
					
					if( IsValidDynamic3DTextLabel( ObjList[i][o3DText] ) )
					{
						DestroyDynamic3DTextLabel( ObjList[i][o3DText] );
						ObjList[i][o3DText] = Text3D: INVALID_3DTEXT_ID;
			      	}
					
					ObjList[i][Obj_X] = 0, ObjList[i][Obj_Y] = 0,ObjList[i][Obj_Z] = 0;
			      	ObjList[i][ObjRx] = 0, ObjList[i][ObjRy] = 0, ObjList[i][ObjRz] = 0;
			      	ObjList[i][oModel] = 0, ObjList[i][oID] = 0;
			      	DeletePVar( playerid, "d_select" );
					SetPVarInt( playerid, "FDObject:Select", 0 );
			      	CancelEdit( playerid );
			      	SendClientMessage(playerid, -1, ""gbAccess"Вы убрали объект.");
			      	cObjectS--;
			      	break;
		        }
		    }
		}
	}
	return true;
}

forward GymTimer(playerid);
public GymTimer(playerid) {
	new
	    b_gym = GetPVarInt(playerid, "gym_id")
	;
	if(!b_gym) { KillTimer(D::[playerid][dGymTimer]); return 0; }
	if(b_gym < 1 || b_gym > sizeof(GymData)) { KillTimer(D::[playerid][dGymTimer]); return 0; }
	if(GymData[b_gym - 1][gymStatus] != playerid) { KillTimer(D::[playerid][dGymTimer]); return 0; }
	if(!IsPlayerInDynamicArea(playerid, GymData[b_gym - 1][gymAreaID]))
	{
	    //for(new i; i < 2; i ++) PlayerTextDrawHide(playerid, TextDrawForBar[i][playerid]);
		if(GetPVarInt(playerid, "gym_bar_show") >= 1) {
			HidePlayerProgressBar(playerid, universalbar[playerid]);
			DestroyPlayerProgressBar(playerid, universalbar[playerid]);
			SetPVarInt(playerid, "gym_bar_show", 0);
		}
		if(IsPlayerAttachedObjectSlotUsed(playerid, 2)) RemovePlayerAttachedObject(playerid, 2);
		SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
  		ClearAnimations(playerid);
		KillTimer(D::[playerid][dGymTimer]);
		DeletePVar(playerid, "gym_id");
	    DeletePVar(playerid, "gym_tick");
	    GymData[b_gym - 1][gymStatus] = INVALID_PLAYER_ID;
	    SetCameraBehindPlayer(playerid);
		return 0;
	}
	new
	    b_tick = GetTickCount() - GetPVarInt(playerid, "gym_tick")
	;
	switch(GymData[b_gym - 1][gymType]) {
		case GYM_TYPE_VELO: {
			if(GetPVarInt(playerid, "gym_tick") && b_tick >= 1000) ApplyAnimation(playerid,"GYMNASIUM","gym_bike_pedal", 4.0, 0, 0, 0, 1, -1, 1);
			else if(GetPVarInt(playerid, "gym_tick") && b_tick >= 500) ApplyAnimation(playerid,"GYMNASIUM","gym_bike_fast", 4.0, 0, 0, 0, 1, -1, 1);
			else if(GetPVarInt(playerid, "gym_tick")) ApplyAnimation(playerid,"GYMNASIUM","gym_bike_faster", 4.0, 0, 0, 0, 1, -1, 1);
		}
		case GYM_TYPE_TRACK: {
			if(GetPVarInt(playerid, "gym_tick") && b_tick >= 1000) ApplyAnimation(playerid,"GYMNASIUM","gym_tread_walk", 4.0, 0, 0, 0, 1, -1, 1);
			else if(GetPVarInt(playerid, "gym_tick") && b_tick >= 500) ApplyAnimation(playerid,"GYMNASIUM","gym_tread_jog", 4.0, 0, 0, 0, 1, -1, 1);
			else if(GetPVarInt(playerid, "gym_tick")) ApplyAnimation(playerid,"GYMNASIUM","gym_tread_sprint", 4.0, 0, 0, 0, 1, -1, 1);
		}
		case GYM_TYPE_BENCH: {
			if(GetPVarInt(playerid, "gym_tick") && b_tick >= 1000) ApplyAnimation(playerid, "benchpress", "gym_bp_up_smooth", 4, 0, 0, 0, 1, 0);
			else if(GetPVarInt(playerid, "gym_tick") && b_tick >= 500) ApplyAnimation(playerid, "benchpress", "gym_bp_up_smooth", 4, 0, 0, 0, 1, 0);
			else if(GetPVarInt(playerid, "gym_tick")) ApplyAnimation(playerid, "benchpress", "gym_bp_up_smooth", 4, 0, 0, 0, 1, 0);
			if(!IsPlayerAttachedObjectSlotUsed(playerid, 2)) SetPlayerAttachedObject(playerid, 2, 2913, 6, 0.033000, 0.028000, -0.104999, 5.699995, -1.999999, 0.500062, 1.000000, 1.000000, 1.000000);
		}
		case GYM_TYPE_BARB: {
		    if(GetPVarInt(playerid, "gym_tick") && b_tick >= 1000) ApplyAnimation(playerid,"Freeweights","gym_free_up_smooth", 4, 0, 0, 0, 1, 0);
			else if(GetPVarInt(playerid, "gym_tick") && b_tick >= 500) ApplyAnimation(playerid,"Freeweights","gym_free_up_smooth", 4, 0, 0, 0, 1, 0);
			else if(GetPVarInt(playerid, "gym_tick")) ApplyAnimation(playerid,"Freeweights","gym_free_up_smooth", 4, 0, 0, 0, 1, 0);
		    if(!IsPlayerAttachedObjectSlotUsed(playerid, 2)) SetPlayerAttachedObject(playerid, 2, 2915, 6, 0.083999, 0.000000, -0.039999, -7.199998, -87.000038, -3.199999, 1.000000, 1.000000, 1.000000);
		}
	}
	return 1;
}
stock SpeedPed(playerid)
{
    new Float:x, Float:y, Float:z;
    GetPlayerVelocity(playerid, x, y, z);
    return floatround(floatsqroot(x*x+y*y)*100);
}
stock GetBizNalog(bizid)
{
	new typeids;
	switch(Bizz::[bizid][bSettings][7] - 1)
	{
	    case 1: typeids = S::[0][sNalog][1];
	    case 2: typeids = S::[0][sNalog][2];
	    case 3: typeids = S::[0][sNalog][3];
	    case 4: typeids = S::[0][sNalog][4];
	    case 5: typeids = S::[0][sNalog][5];
	    case 6: typeids = S::[0][sNalog][6];
	    case 7: typeids = S::[0][sNalog][7];
	    case 8: typeids = S::[0][sNalog][8];
	    case 9: typeids = S::[0][sNalog][9];
	    case 10: typeids = S::[0][sNalog][10];
	    case 11: typeids = S::[0][sNalog][11];
	    case 12: typeids = S::[0][sNalog][12];
	    case 13: typeids = S::[0][sNalog][13];
	    //case 14: typeids = S::[0][sNalog][13];
	}
	return typeids;
}
public OnPlayerCommandReceived( playerid, cmdtext[] ) 
{
	clear_massive();
	
	if( !getData( playerid, "uLogin" ) ) 
	{
		SendMes( playerid, C_WHITE, ""gbError"Для использования чата, Вам необходимо авторизоваться." );
		return 0;
	}	
	
	return 1;
}

public OnPlayerCommandPerformed( playerid, cmdtext[], success ) 
{
	
	if( !success ) 
		return SendClientMessage( playerid, C_WHITE,""gbError"Команда не найдена. Используйте "cBLUE"Y{ffffff} для помощи." );

	return 1;
}
