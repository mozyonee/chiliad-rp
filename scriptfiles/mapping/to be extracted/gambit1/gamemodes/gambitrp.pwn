					for(new i; i != 15; i ++) 
					{
					    if( Fuel::[i][bCount] != 0 )
						{
							count = true;
							break;
					    }
					}
					
					if( !count ) 
					{
						return SendClientMessage(playerid, C_WHITE,""gbError"Простите, но нет заказов на развозку топлива!");
					}
	        	}
				case 4: if(S::[0][wsWoodsSklad] == 0) return SendClientMessage(playerid,C_GRAY,""gbError"На лесопилке кончилось дерево.");
	        	default: return 0;
	    	}
			for(new i;i<10;i++)
			{
				if(gTruckLoadTurn[0][i] == INVALID_PLAYER_ID)
				{
					gTruckLoadTurn[0][i] = playerid;
					format(string,sizeof(string),"Вы номер %d в очереди на загрузку",i+1);
					SendClientMessage(playerid, -1, string);
					SetPVarInt(playerid,"truckonroad",0);
					SetPVarInt(playerid,"waitgruz",0);
					break;
				}
			}
		}
		else return SendClientMessage(playerid,C_GRAY,""gbError"Транспортное средство выданное вам должно быть рядом.");
	}
	if(clickedid == phoneOne[23] || clickedid == phoneTwo[11] || clickedid == phoneThree[10])  {
		if(Player[playerid][uNumber] == 0) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет сим-карты в вашем телефоне!");
		new str[128];
		string = "";
		for(new i; i != 10; i ++) {
			if(Player[playerid][uContacts][i] != 0) {
				format(str,sizeof(str),"%i. "cGRAY"%s Номер: %d\n",i + 1,phoneName[playerid][i],Player[playerid][uContacts][i]);
				strcat(string,str);
			}
			else strcat(string,"{d3d3d3}- Пусто\n");
		}
		showPlayerDialog(playerid,d_phone + 2,2,"Контакты",string,"Далее","Закрыть");
	}
	if(clickedid == phoneOne[24] || clickedid == phoneTwo[9] || clickedid == phoneThree[9]) {
		format(string,sizeof(string),"{ffffff}1. "cGRAY"Показывать объявления - %s\n{ffffff}2. "cGRAY"Радио - %s",Player[playerid][uSettings][4] ? (""cGREEN"Да") : (""cRED"Нет"), Player[playerid][uRadio] ? (""cGREEN"Да") : (""cRED"Нет"));
		showPlayerDialog(playerid,d_phone + 14,2,"Настройки",string,"Далее","Закрыть");
	}
	if(clickedid == phoneOne[25] || clickedid == phoneTwo[10] || clickedid == phoneThree[12]) {
		if(Player[playerid][uNumber] == 0) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет сим-карты в вашем телефоне!");
		showPlayerDialog(playerid,d_phone + 6,2,"Сообщения","1. "cGRAY"Входящие сообщения{ffffff}\n2. "cGRAY"Исходящие сообщения{ffffff}\n3. "cGRAY"Отправить сообщение","Далее","Закрыть");
	}
	if(clickedid == phoneOne[26] || clickedid == phoneTwo[8] || clickedid == phoneThree[11]) {
		if(Player[playerid][uNumber] == 0) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет сим-карты в вашем телефоне!");
		showPlayerDialog(playerid,d_phone,2,"Набрать номер","1. "cGRAY"Набрать новый номер{ffffff}\n2. "cGRAY"Номера сервисных служб\n{ffffff}3. "cGRAY"Телефонная книга","Далее","Закрыть");
	}
	if(clickedid == phoneOne[27] || clickedid == phoneTwo[12] || clickedid == phoneThree[17]) hidePhone(playerid);
	
	
   	
	return 1;
}


