			if(Player[strval(inputtext)][uMember] != Player[playerid][uMember]) return showPlayerDialog(playerid,d_frac + 7,1," ","{ffffff}Введите ID человека которого хотите повысить в должности:\n\n","Далее","Закрыть");
            if(F::[Player[playerid][uMember]][fRank][2] > Player[playerid][uRank] || Player[strval(inputtext)][uRank] > Player[playerid][uRank]) return showPlayerDialog(playerid,d_frac + 7,1," ","{ffffff}Введите ID человека которого хотите повысить в должности:\n\n","Далее","Закрыть");

