			SendClientMessage(playerid,C_GRAY,""gbAccess"Вы установили новый скин для этого ранга!");
			format(query,sizeof(query),"UPDATE gb_frac SET fSkins = '%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d' WHERE fID = '%d'",
			F::[Player[playerid][uLeader]][fSkins][0],F::[Player[playerid][uLeader]][fSkins][1],F::[Player[playerid][uLeader]][fSkins][2],F::[Player[playerid][uLeader]][fSkins][3],
			F::[Player[playerid][uLeader]][fSkins][4],F::[Player[playerid][uLeader]][fSkins][5],F::[Player[playerid][uLeader]][fSkins][6],F::[Player[playerid][uLeader]][fSkins][7],
			F::[Player[playerid][uLeader]][fSkins][8],F::[Player[playerid][uLeader]][fSkins][9],F::[Player[playerid][uLeader]][fSkins][10],F::[Player[playerid][uLeader]][fSkins][11],
			F::[Player[playerid][uLeader]][fSkins][12],F::[Player[playerid][uLeader]][fSkins][13],F::[Player[playerid][uLeader]][fSkins][14],Player[playerid][uLeader]);
			mysql_tquery(1, query, "", "");
