				Player[playerid][uJob] = 0;
				format(query,sizeof(query),"UPDATE gb_users SET uMember = '%d',uRank = '%d',uJob = '%d' WHERE BINARY uName = '%s'",Player[playerid][uMember],Player[playerid][uRank],Player[playerid][uJob],Player[playerid][uName]);
				mysql_tquery(1, query, "", "");
