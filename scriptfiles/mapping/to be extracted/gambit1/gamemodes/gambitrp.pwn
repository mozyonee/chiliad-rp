stock GetPlayerID(Name[])
{
	foreach(new i : Player)
	{
		if(!strcmp(Name, Player[i][uName])) return i;
	}
	return -1;
}

forward BackupClear(playerid, calledbytimer);
public BackupClear(playerid, calledbytimer)
{
	if(IsPlayerConnected(playerid))
	{
		if(Player[playerid][uMember] == 8 || Player[playerid][uMember] == 1 || Player[playerid][uMember] == 2 || Player[playerid][uMember] == 5)
		{
   			if(GetPVarInt(playerid, "BKONFORPLAYER") == 1)
			{
				foreach(new i: Player) if(Player[i][uMember] == 1 || Player[i][uMember] == 2 || Player[i][uMember] == 5) SetPlayerMarkerForPlayer(i, playerid, FracColor[Player[playerid][uMember]]);
				if(calledbytimer != 1) SendClientMessage(playerid, -1, ""gbAccess"Ваш запрос о поддержке был отменён");
				else SendClientMessage(playerid, -1, ""gbAccess"Ваш запрос о поддержке автоматически отменён");
				SetPVarInt(playerid, "BKONFORPLAYER", 0);
			}
			else if(calledbytimer != 1) SendClientMessage(playerid, -1, ""gbError"Вы не запрашивали поддержку!");
		}
		else if(calledbytimer != 1) SendClientMessage(playerid, -1, ""gbError"Вы не состоите во фракции!");
	}
	return 1;
}

