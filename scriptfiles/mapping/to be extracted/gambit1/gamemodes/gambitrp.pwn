				    format(str,sizeof(str),"12. "cGRAY"Аренда транспорта - "cGREEN"%d%\n",S::[0][sNalog][11]),strcat(string,str);
				    format(str,sizeof(str),"13. "cGRAY"Спортзал - "cGREEN"%d%\n",S::[0][sNalog][12]),strcat(string,str);
				    showPlayerDialog(playerid,d_meria + 3,2,"Настройка налогов",string,"Далее","Закрыть");
				}
			}
		}
		case d_meria + 2: {
		    if(!response) return 1;
		    if(!strlen(inputtext)) return showPlayerDialog(playerid,d_meria + 2,1,"Налог за бизнес ( 1 день )","{ffffff}Введите цену за 1 день оплаты налогов бизнеса:\n\n"cGREEN"| Минимальный налог $200, максимальный $500","Далее","Закрыть");
		    if(!isNumeric(inputtext)) return showPlayerDialog(playerid,d_meria + 2,1,"Налог за бизнес ( 1 день )","{ffffff}Введите цену за 1 день оплаты налогов дома:\n\n"cGREEN"| Минимальный налог $100, максимальный $300","Далее","Закрыть");
		    if(strval(inputtext) < 100 || strval(inputtext) > 300) return showPlayerDialog(playerid,d_meria + 2,1,"Налог за дом ( 1 день )","{ffffff}Введите цену за 1 день оплаты налогов дома:\n\n"cGREEN"| Минимальный налог $100, максимальный $300","Далее","Закрыть");
		    S::[0][sHouses] = strval(inputtext);
		    format(query,sizeof(query),"UPDATE gb_others SET sHouses = %d",S::[0][sHouses]);
			mysql_tquery(1, query, "", "");
			SendClientMessage(playerid,C_GRAY,""gbAccess"Вы установили новый налог 1 день оплаты дома!");
		}
		case d_meria + 3: {
		    if(!response) return 1;
		    new nName[30];
			SetPVarInt(playerid,"playerSelectNalog",listitem);
			switch(listitem)
			{
			    case 0: nName = "Закусочную";
			    case 1: nName = "Бар";
			    case 2: nName = "Ресторан";
			    case 3: nName = "Магазин одежды";
			    case 4: nName = "Магазин электроники";
			    case 5: nName = "Автосалон";
			    case 6: nName = "Магазин оружия";
			    case 7: nName = "Магазин мебели";
			    case 8: nName = "Клуб";
			    case 9: nName = "Заправку";
			    case 10: nName = "Все для отдыха";
			    case 11: nName = "Аренда транспорта";
				case 12: nName = "Спортзал";
			}
			format(string, sizeof(string), "{ffffff}Введите новый налог на "cBLUE"%s\n\n"gbAccess"Минимальный процент 2, а максимальный 20.", nName);
			showPlayerDialog(playerid,d_meria + 14,1," ",string,"Далее","Закрыть");
		}
		case d_meria + 14: {
		    if(!response) return 1;
		    new nName[30];
			new id = GetPVarInt(playerid, "playerSelectNalog");
			switch(id)
			{
			    case 0: nName = "Закусочную";
			    case 1: nName = "Бар";
			    case 2: nName = "Ресторан";
			    case 3: nName = "Магазин одежды";
			    case 4: nName = "Магазин электроники";
			    case 5: nName = "Автосалон";
			    case 6: nName = "Магазин оружия";
			    case 7: nName = "Магазин мебели";
			    case 8: nName = "Клуб";
			    case 9: nName = "Заправку";
			    case 10: nName = "Все для отдыха";
			    case 11: nName = "Аренда транспорта";
			    case 12: nName = "Спортзал";
			}
			format(string, sizeof(string), "{ffffff}Введите новый налог на "cBLUE"%s\n\n"gbAccess"Минимальный процент 2, а максимальный 20.", nName);

		    if(!strlen(inputtext)) return showPlayerDialog(playerid,d_meria + 14,1," ",string,"Далее","Закрыть");
		    if(!isNumeric(inputtext)) return showPlayerDialog(playerid,d_meria + 14,1," ",string,"Далее","Закрыть");
		    if(strval(inputtext) < 2 || strval(inputtext) > 20) return showPlayerDialog(playerid,d_meria + 14,1," ",string,"Далее","Закрыть");
			S::[0][sNalog][id] = strval(inputtext);
			format(string,sizeof(string),"%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d|%d",S::[0][sNalog][0],S::[0][sNalog][1],S::[0][sNalog][2],
 			S::[0][sNalog][3],S::[0][sNalog][4],S::[0][sNalog][5],S::[0][sNalog][6],S::[0][sNalog][7],S::[0][sNalog][8],S::[0][sNalog][9],S::[0][sNalog][10],S::[0][sNalog][11],S::[0][sNalog][12]);
   			format(query,sizeof(query),"UPDATE gb_others SET Nalog = '%s'",string);
			mysql_tquery(1, query, "", "");
			//-------------------[]-----------------------------
			string = "";
		  	format(str,sizeof(str),"1. "cGRAY"Закусочная - "cGREEN"%d%\n",S::[0][sNalog][0]),strcat(string,str);
	    	format(str,sizeof(str),"2. "cGRAY"Бар - "cGREEN"%d%\n",S::[0][sNalog][1]),strcat(string,str);
	    	format(str,sizeof(str),"3. "cGRAY"Ресторан - "cGREEN"%d%\n",S::[0][sNalog][2]),strcat(string,str);
	    	format(str,sizeof(str),"4. "cGRAY"Магазин одежды - "cGREEN"$%d%\n",S::[0][sNalog][3]),strcat(string,str);
	    	format(str,sizeof(str),"5. "cGRAY"Магазин электроники - "cGREEN"%d%\n",S::[0][sNalog][4]),strcat(string,str);
	    	format(str,sizeof(str),"6. "cGRAY"Автосалон - "cGREEN"%d%\n",S::[0][sNalog][5]),strcat(string,str);
	    	format(str,sizeof(str),"7. "cGRAY"Магазин оружия - "cGREEN"%d%\n",S::[0][sNalog][6]),strcat(string,str);
	    	format(str,sizeof(str),"8. "cGRAY"Магазин мебели - "cGREEN"%d%\n",S::[0][sNalog][7]),strcat(string,str);
	    	format(str,sizeof(str),"9. "cGRAY"Клуб - "cGREEN"%d%\n",S::[0][sNalog][8]),strcat(string,str);
   	 		format(str,sizeof(str),"10. "cGRAY"Заправка - "cGREEN"%d%\n",S::[0][sNalog][9]),strcat(string,str);
   	 		format(str,sizeof(str),"11. "cGRAY"Все для отдыха - "cGREEN"%d%\n",S::[0][sNalog][10]),strcat(string,str);
   	 		format(str,sizeof(str),"12. "cGRAY"Аренда транспорта - "cGREEN"%d%\n",S::[0][sNalog][11]),strcat(string,str);
   	 		format(str,sizeof(str),"13. "cGRAY"Спортзал - "cGREEN"%d%\n",S::[0][sNalog][12]),strcat(string,str);
	    	showPlayerDialog(playerid,d_meria + 3,2,"Настройка налогов",string,"Далее","Закрыть");


		}
		case d_meria + 5: {
		    if(!response) return 1;
		    switch(listitem) {
		        case 0: showPlayerDialog(playerid,d_meria + 6,1,"Цена за проезд в автобусе","{ffffff}Введите новую цену за проезд в автобусе:\n\n"cRED"| Минимальная цена $1, а максимальная $20","Далее","Закрыть");
		    }
		}

		case d_meria + 6: {
		    if(!response) return 1;
			if(!strlen(inputtext)) return showPlayerDialog(playerid,d_meria + 6,1,"Цена за проезд в автобусе","{ffffff}Введите новую цену за проезд в автобусе:\n\n"cRED"| Минимальная цена $1, а максимальная $20","Далее","Закрыть");
		    if(!isNumeric(inputtext)) return showPlayerDialog(playerid,d_meria + 6,1,"Цена за проезд в автобусе","{ffffff}Введите новую цену за проезд в автобусе:\n\n"cRED"| Минимальная цена $1, а максимальная $20","Далее","Закрыть");
		    if(strval(inputtext) < 1 || strval(inputtext) > 20) return showPlayerDialog(playerid,d_meria + 6,1,"Цена за проезд в автобусе","{ffffff}Введите новую цену за проезд в автобусе:\n\n"cRED"| Минимальная цена $1, а максимальная $20","Далее","Закрыть");
			S::[0][sMeria][1] = strval(inputtext);
			format(query,sizeof(query),"UPDATE gb_others SET sMeria1 = %d",S::[0][sMeria][1]);
			mysql_tquery(1, query, "", "");
			SendClientMessage(playerid,C_GRAY,""gbAccess"Вы установили новую цену за проезд в автобусе!");
		}
		case d_meria + 7: {
		    if(!response) return 1;
			SetPVarInt(playerid,"playerSelectMeria",listitem);
			showPlayerDialog(playerid,d_meria + 8,1,F::[listitem + 1][fName],"{ffffff}Введите новую зарплату в этой организации за ранг:\n\n"cRED"| Минимальная зарплата $100, а максимальная $500","Далее","Закрыть");
		}
		case d_meria + 8: {
		    new id = GetPVarInt(playerid,"playerSelectMeria") + 2;
		    DeletePVar(playerid,"playerSelectMeria");
		    if(!response) return 1;
		    if(!strlen(inputtext)) return showPlayerDialog(playerid,d_meria + 8,1,F::[GetPVarInt(playerid,"playerSelectMeria") + 1][fName],"{ffffff}Введите новую зарплату в этой организации за ранг:\n\n"cRED"| Минимальная зарплата $100, а максимальная $500","Далее","Закрыть");
		    if(!isNumeric(inputtext)) return showPlayerDialog(playerid,d_meria + 8,1,F::[GetPVarInt(playerid,"playerSelectMeria") + 1][fName],"{ffffff}Введите новую зарплату в этой организации за ранг:\n\n"cRED"| Минимальная зарплата $100, а максимальная $500","Далее","Закрыть");
		    if(strval(inputtext) < 100 || strval(inputtext) > 700) return showPlayerDialog(playerid,d_meria + 8,1,F::[GetPVarInt(playerid,"playerSelectMeria") + 1][fName],"{ffffff}Введите новую зарплату в этой организации за ранг:\n\n"cRED"| Минимальная зарплата $100, а максимальная $500","Далее","Закрыть");
			S::[0][sMeria][id] = strval(inputtext);
			format(query,sizeof(query),"UPDATE gb_others SET sMeria%d = %d",id,S::[0][sMeria][id]);
			mysql_tquery(1, query, "", "");
			SendClientMessage(playerid,C_GRAY,""gbAccess"Вы установили новую зарплату данной организации!");
		}
		case d_meria + 9: {
		    if(!response) return 1;
            GivePlayerItem(playerid,452,1);
            SendClientMessage(playerid,C_GRAY,""gbAccess"Поздравляем, Вы получили документы.");
            MeAction(playerid,"получил(-а) документы",1);
		}
		case d_target: {
		    if(!response) return 1;
			switch(listitem) {
			    case 0: {
			        CallLocalFunction( "cmd_pass", "ii", playerid, GetPVarInt(playerid,"playerTarget") );
			        format(string,sizeof(string),"показал(-а) паспорт %s'y",Player[GetPVarInt(playerid,"playerTarget")][uName]);
					MeAction(playerid,string,1);
			        DeletePVar(playerid,"playerTarget");
			    }
			    case 1: {
				    if(Player[playerid][uRegDate] + (172800) >= gettime()) return SendClientMessage(playerid,C_GRAY,""gbError"Для передачи денег вы должны отыграть 2 дня.");
					showPlayerDialog(playerid,d_target + 1,1," ","{ffffff}Введите сумму которую хотите передать:","Далее","Закрыть");
				}
				case 2: {
				    SetPVarInt(GetPVarInt(playerid,"playerTarget"), "PlayerHandshake", playerid);
					format(string, sizeof(string), ""gbInfo"Вы предложили игроку "cBLUE"%s"cWHITE" пожать вам руку.", Player[GetPVarInt(playerid,"playerTarget")][uName]);
					SendClientMessage(playerid, -1, string);
					format(string, sizeof(string), ""gbInfo"Игрок "cBLUE"%s"cWHITE" предложил вам пожать ему руку.", Player[playerid][uName]);
					SendClientMessage(GetPVarInt(playerid,"playerTarget"), -1, string);
					SendClientMessage(GetPVarInt(playerid,"playerTarget"), -1, ""gbInfo"Нажмите {33AA33}Y"cWHITE", чтобы согласиться или {FF6347}N"cWHITE", чтобы отказаться." );
				}
				case 3: {
				   	SetPVarInt(GetPVarInt(playerid,"playerTarget"), "PlayerFrisk", playerid);
					format(string, sizeof(string), ""gbInfo"Вы предложили игроку %s обыскать его", Player[GetPVarInt(playerid,"playerTarget")][uName]);
					SendClientMessage(playerid, -1, string);
					format(string, sizeof(string), ""gbInfo"Игрок %s хочет обыскать вас", Player[playerid][uName]);
					SendClientMessage(GetPVarInt(playerid,"playerTarget"), -1, string);
					SendClientMessage(GetPVarInt(playerid,"playerTarget"), -1, ""gbInfo"Нажмите {33AA33}Y"cWHITE", чтобы согласиться или {FF6347}N"cWHITE", чтобы отказаться." );

				}
			}
		}
		case d_target + 1: 
		{
		    if(!response) return 1;
		    if(Player[playerid][uMoney] < strval(inputtext)) return SendClientMessage(playerid,C_GRAY,""gbError"Недостаточно денег для передачи такой суммы!");
		    if(strval(inputtext) < 1 || strval(inputtext) > 1000000) return SendClientMessage(playerid,C_GRAY,""gbError"Минимальная сумма передачи - $1 | Максимальная - $100.000");
			if(GetDistanceBetweenPlayers(playerid, GetPVarInt(playerid,"playerTarget") ) > 3.0 
				|| GetPlayerVirtualWorld(playerid) != GetPlayerVirtualWorld( GetPVarInt(playerid,"playerTarget") )) 
				return SendClientMessage(playerid,C_GRAY,""gbError"Данного игрока нет рядом с вами!");
				
			Player[playerid][uMoney] -= strval(inputtext);
			Player[GetPVarInt(playerid,"playerTarget")][uMoney] += strval(inputtext);

			format(query,sizeof(query),"UPDATE gb_users SET uMoney = '%d' WHERE BINARY uName = '%s'",Player[playerid][uMoney],Player[playerid][uName]);
			mysql_tquery(1, query, "", "");
			format(query,sizeof(query),"UPDATE gb_users SET uMoney = '%d' WHERE BINARY uName = '%s'",Player[GetPVarInt(playerid,"playerTarget")][uMoney],Player[GetPVarInt(playerid,"playerTarget")][uName]);
			mysql_tquery(1, query, "", "");

			format(string,sizeof(string),""gbAccess"Вы передали %s - "cGREEN"$%d",Player[GetPVarInt(playerid,"playerTarget")][uName],strval(inputtext));
			SendClientMessage(playerid,C_GRAY,string);
			format(string,sizeof(string),""gbAccess"%s передал(-а) вам - "cGREEN"$%d",Player[playerid][uName],strval(inputtext));
			SendClientMessage(GetPVarInt(playerid,"playerTarget"),C_GRAY,string);

			format(string,sizeof(string),"передал(-а) деньги %s'y",Player[GetPVarInt(playerid,"playerTarget")][uName]);
			MeAction(playerid,string,1);
			
			format:gb_string( "[A] %s[%d][%s] передал деньги %s[%d][%s] - $%d", 
				Player[playerid][uName], 
				playerid, 
				Player[playerid][uIP], 
				Player[GetPVarInt( playerid,"playerTarget" )][uName], 
				GetPVarInt( playerid,"playerTarget"), 
				Player[ GetPVarInt(playerid,"playerTarget" )][uIP],
				strval( inputtext )
			);
			
			SendAdminLog( playerid, gb_string );
			
			ApplyAnimation(playerid,"DEALER", "shop_pay",4.0, 0, 1, 1, 0, 0, 1);

			DeletePVar(playerid,"playerTarget");
		}
	}
	
	return 1;
}

public OnPlayerEnterCheckpoint(playerid) {
	clear_massive();
	DisablePlayerCheckpoint(playerid);
	if(GetPVarInt(playerid,"playerUseGPS") == 1) {
	    SendClientMessage(playerid,C_GRAY,""gbAccess"Вы достигли места назначения!");
	    SetPVarInt(playerid,"playerUseGPS",0);
	}

	if(GetPVarInt(playerid, "CallInfoGPS") == 1)
	{
	    new id = GetPVarInt(playerid, "CallInfoIndex");
 	    CallInfo[id][cStatus] = false;
	    DeletePVar(playerid,"CallInfoGPS");
	    DisablePlayerCheckpoint(playerid);
	}
	if(GetPVarInt(playerid,"WoodCheckpointTop")) {
	    if(D::[playerid][dWoodsDuty] == 0) {
	        DeletePVar(playerid,"WoodCheckpointTop");
	        DisablePlayerCheckpoint(playerid);
	    }
	    if(IsPlayerInRangeOfPoint(playerid,3.0,-462.9798,-88.4665,59.9006)) {
	        ClearAnimations(playerid);
	        RemovePlayerAttachedObject(playerid,9);
	        DisablePlayerCheckpoint(playerid);
	        DeletePVar(playerid,"WoodCheckpointTop");
	        SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
	        SetPlayerAttachedObject(playerid,9,341,6);
	        new obj = CreateDynamicObject(1463,-462.97189, -87.00266, 60.04498,0.00000, 0.00000, -90.00000);
	        SetGVarInt("WoodConv",1,obj);
	        MoveDynamicObject(obj,-462.97189, -77.84270, 60.04500,1,0.00000, 0.00000, -90.00000);
	        SetPVarInt(playerid,"PlayerUseBox",4);
	        MeAction(playerid,"положил(-а) древесину на конвеер",1);
         	if(JobValueNow(playerid, 2, 34, -1) != 0) { }
			else {
			    SendClientMessage(playerid, -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
			    showPlayerDialog(playerid, 9999, 0, " ", "{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке", "Закрыть", "");
    			D::[playerid][dWoodsDuty] = 0;
				DeletePVar(playerid,"PlayerUseBox");
				DeletePVar(playerid,"PlayerStanok");
    			GetBackSkin(playerid);
				RemovePlayerAttachedObject(playerid,9);
				SetPlayerSpecialAction(playerid, SPECIAL_ACTION_NONE);
			}
	    }
	}
	if(GetPVarInt(playerid,"PlayerDriverCheckpoint")) {
	    new v = PlayerTrailer[playerid];
	    switch(GetPVarInt(playerid,"PlayerSelectTrailerTwo")) {
	        case 1: {
	            if(IsPlayerInRangeOfPoint(playerid,5.0,-18.9291,-273.3552,5.4297)) {
					if(V::[v][vMebel] >= MAX_MEBEL_IN_VEHICLE) return SendClientMessage(playerid,C_GRAY,""gbError"В прицепе нет места для загрузки мебели в него.");

					if(MebelZavod <= 0) {
					    SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
					    SendClientMessage(playerid,C_GRAY,""gbInfo"На заводе мебели больше нет мебели, верните прицеп на склад!");
					}
					else if(MebelZavod > 0) {
					    if(MebelZavod < MAX_MEBEL_IN_VEHICLE) {
					        V::[v][vMebel] = MebelZavod;
					        MebelZavod = 0;
					    }
					    else {
					        V::[v][vMebel] = MAX_MEBEL_IN_VEHICLE;
                            MebelZavod -= MAX_MEBEL_IN_VEHICLE;
					    }
					    format(gb_string,sizeof(gb_string),"Мебель\n{ffffff}%d/%d ед.",V::[v][vMebel],MAX_MEBEL_IN_VEHICLE);
      					UpdateDynamic3DTextLabelText(V::[v][vTextTrailer],C_BLUE,gb_string);
	            		format(gb_string,sizeof(gb_string),"Завод мебели\n\n{ffffff}Мебель: %d ед.\nДревесины: %d ед.",MebelZavod,WoodsZavod);
						UpdateDynamic3DTextLabelText(InfoFermText[7],C_BLUE,gb_string);
						SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
						SendClientMessage(playerid,C_GRAY,""gbInfo"Вам в прицеп загрузили мебель, отвезите её на общий склад.");
					}

					togglePlayerControllable(playerid,false);
					SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);
	            }
	            if(IsPlayerInRangeOfPoint(playerid,5.0,1061.2046,-322.2485,73.9851)) 
				{
	                S::[0][sProducts] += V::[v][vMebel];
	                V::[v][vMebel] = 0;
					
					if(IsValidDynamic3DTextLabel(V::[v][vTextTrailer]))
						DestroyDynamic3DTextLabel(V::[v][vTextTrailer]);
						
	                DestroyVehicle(v);
	                
	                SetPVarInt(playerid,"dettachTrailer",0);
	                PlayerTrailer[playerid] = -1;
					if(Player[playerid][uDalnSkill] != 150) Player[playerid][uDalnSkill] ++;
					if(JobValueNow(playerid, 10, 300,Player[playerid][uJob]) != 0) { }
					else
					{
					    D::[playerid][dDalnDuty] = false;
		                if(D::[playerid][dDalnKey] != -1) SetVehicleToRespawn(D::[playerid][dDalnKey]);
						DisablePlayerCheckpoint(playerid);
					}
					format(gb_string,sizeof(gb_string),"UPDATE gb_users SET uDalnSkill = '%d' WHERE BINARY uName = '%s'",Player[playerid][uDalnSkill],Player[playerid][uName]);
					mysql_tquery(1, gb_string, "", "");
	            }
	        }
	        case 2: {
	        	if(IsPlayerInRangeOfPoint(playerid,5.0,248.2978,1420.6721,10.5727)) {
	        	    if(V::[v][vToplivo] >= MAX_FUEL_IN_VEHICLE) return showPlayerDialog(playerid,d_daln + 2,2,"Выбор маршрута","1. "cGRAY"Отвозить топливо по бизнесам","Далее","Закрыть");
	        	    if(ToplivoZavod == 0) return SendClientMessage(playerid,C_GRAY,""gbError"На заводе закончилось топливо.");

	        	    if(ToplivoZavod <= 0) {
	        	        SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
	        	        SendClientMessage(playerid,C_GRAY,""gbInfo"На заводе закончилось топливо, верните прицеп на склад!");
	        	    }
	        	    else if(ToplivoZavod > 0) {
	        	        if(ToplivoZavod < MAX_FUEL_IN_VEHICLE) {
	        	            V::[v][vToplivo] = ToplivoZavod;
	        	            ToplivoZavod = 0;
	        	        }
	        	        else {
	        	            V::[v][vToplivo] = MAX_FUEL_IN_VEHICLE;
	        	            ToplivoZavod -= MAX_FUEL_IN_VEHICLE;
	        	        }
	        	        format(gb_string,sizeof(gb_string),"Топливо\n{ffffff}%d/%d л.",V::[v][vToplivo],MAX_FUEL_IN_VEHICLE);
			            UpdateDynamic3DTextLabelText(V::[v][vTextTrailer],C_BLUE,gb_string);
			            format(gb_string,sizeof(gb_string),"Нефтеперерабатывающий завод\n\n{ffffff}Топливо: {ffffff}%d л.",ToplivoZavod);
			            UpdateDynamic3DTextLabelText(InfoFermText[8],C_BLUE,gb_string);
	        	        showPlayerDialog(playerid,d_daln + 2,2,"Выбор маршрута","1. "cGRAY"Отвозить топливо по бизнесам","Далее","Закрыть");
	        	    }

					togglePlayerControllable(playerid,false);
					SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);
	            }
				if(IsPlayerInRangeOfPoint(playerid,5.0,1061.2046,-322.2485,73.9851)) 
				{
					if (IsValidDynamic3DTextLabel(V::[v][vTextTrailer]))
				    	DestroyDynamic3DTextLabel(V::[v][vTextTrailer]);
						
				    DestroyVehicle(v);
				    	
				    if(Player[playerid][uDalnSkill] != 150) Player[playerid][uDalnSkill] ++;
        			
        			if(JobValueNow(playerid, 20, 500,Player[playerid][uJob]) != 0) { }
					else
					{
					    D::[playerid][dDalnDuty] = false;
		                if(D::[playerid][dDalnKey] != -1) SetVehicleToRespawn(D::[playerid][dDalnKey]);
						DisablePlayerCheckpoint(playerid);
					}
        			
        			SetPVarInt(playerid,"dettachTrailer",0);
				    PlayerTrailer[playerid] = -1;
				    format(gb_string,sizeof(gb_string),"UPDATE gb_users SET uDalnSkill = '%d' WHERE BINARY uName = '%s'",Player[playerid][uDalnSkill],Player[playerid][uName]);
					mysql_tquery(1, gb_string, "", "");
				}
	        }
	        case 4: {
	            if(IsPlayerInRangeOfPoint(playerid,5.0,-496.0325,-82.4771,61.2981)) {
	                if(S::[0][wsWoodsSklad] == 0) {
						if(V::[v][vWoods] == 0) {
	                		SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
							return SendClientMessage(playerid,C_GRAY,""gbInfo"На лесопилке закончилась древесина, верните прицеп обратно.");
						}
						else if(V::[v][vWoods] != 0) {
						    SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,-18.9291,-273.3552,5.4297,5.0));
							return SendClientMessage(playerid,C_GRAY,""gbInfo"На лесопилке закончилась древесина, отвезите всё что у вас есть на завод мебели.");
						}
					}
					if(V::[v][vWoods] >= MAX_WOODS_IN_VEHICLE) return SendClientMessage(playerid,C_GRAY,""gbError"В прицепе недостаточно места для загрузки урожая.");
					if(S::[0][wsWoodsSklad] <= 0) {
					    SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
					    SendClientMessage(playerid,C_GRAY,""gbInfo"На лесопилке больше нет древесины, отвезите прицеп на склад!");
					}
					else if(S::[0][wsWoodsSklad] > 0) {
					    if(S::[0][wsWoodsSklad] < MAX_WOODS_IN_VEHICLE) {
					        V::[v][vWoods] = S::[0][wsWoodsSklad];
					        S::[0][wsWoodsSklad] = 0;
					    }
					    else {
					        V::[v][vWoods] = MAX_WOODS_IN_VEHICLE;
                            S::[0][wsWoodsSklad] -= MAX_WOODS_IN_VEHICLE;
					    }
					}
					format(gb_string,sizeof(gb_string),"Древесина\n{ffffff}%d/%d кг.",V::[v][vWoods],MAX_WOODS_IN_VEHICLE);
					UpdateDynamic3DTextLabelText(V::[v][vTextTrailer],C_BLUE,gb_string);
					format(gb_string,sizeof(gb_string),"Обработанная древесина\n{ffffff}%d кг.",S::[0][wsWoodsSklad]);
		    		UpdateDynamic3DTextLabelText(S::[0][wsWoodsTS][0],C_BLUE,gb_string);
		    		UpdateDynamic3DTextLabelText(S::[0][wsWoodsTS][1],C_BLUE,gb_string);
					togglePlayerControllable(playerid,false);
					SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);
					SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,-18.9291,-273.3552,5.4297,5.0));
					SendClientMessage(playerid,C_GRAY,""gbInfo"Вам в прицеп загрузили древесину, отвезите её на завод мебели.");
	            }
	            if(IsPlayerInRangeOfPoint(playerid,5.0,-18.9291,-273.3552,5.4297)) {
	                WoodsZavod += V::[v][vWoods];
	                V::[v][vWoods] = 0;
	                SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
	                format(gb_string,sizeof(gb_string),"Древесина\n{ffffff}%d/%d кг.",V::[v][vWoods],MAX_WOODS_IN_VEHICLE);
					UpdateDynamic3DTextLabelText(V::[v][vTextTrailer],C_BLUE,gb_string);
					format(gb_string,sizeof(gb_string),"Завод мебели\n\n{ffffff}Мебель: %d ед.\nДревесины: %d ед.",MebelZavod,WoodsZavod);
					UpdateDynamic3DTextLabelText(InfoFermText[7],C_BLUE,gb_string);
					SendClientMessage(playerid,C_GRAY,""gbInfo"Вы отвезли древесину на завод, верните прицеп обратно.");
					togglePlayerControllable(playerid,false);
					SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);
	            }
	            if(IsPlayerInRangeOfPoint(playerid,5.0,1061.2046,-322.2485,73.9851)) 
				{
					if(IsValidDynamic3DTextLabel(V::[v][vTextTrailer]))
						DestroyDynamic3DTextLabel(V::[v][vTextTrailer]);
				
	                DestroyVehicle(v);
	             
	                
	                SetPVarInt(playerid,"dettachTrailer",0);
	                PlayerTrailer[playerid] = -1;
	                if(Player[playerid][uDalnSkill] != 150) Player[playerid][uDalnSkill] ++;
	                
	                if(JobValueNow(playerid, 10, 300,Player[playerid][uJob]) != 0) { }
					else
					{
					    D::[playerid][dDalnDuty] = false;
		                if(D::[playerid][dDalnKey] != -1) SetVehicleToRespawn(D::[playerid][dDalnKey]);
						DisablePlayerCheckpoint(playerid);
					}
	                
	                format(gb_string,sizeof(gb_string),"UPDATE gb_users SET uDalnSkill = '%d' WHERE BINARY uName = '%s'",Player[playerid][uDalnSkill],Player[playerid][uName]);
					mysql_tquery(1, gb_string, "", "");
	            }
	        }
	    }
	}
	if(GetPVarInt(playerid,"CheckpointBack")) {
		if(IsPlayerInRangeOfPoint(playerid,5.0,1099.9902,-1242.7791,15.3823)) {
        	DisablePlayerCheckpoint(playerid);
        	new car = GetPlayerVehicleID(playerid);
        	SetVehicleToRespawn(car);
        	SetPVarInt(playerid,"CountBackTaxi",0);
			DeletePVar(playerid,"CheckpointBack");
			D::[playerid][dTaxiDuty] = false;
			SendClientMessage(playerid, -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
			showPlayerDialog(playerid,9999,0," ","{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке","Закрыть","");
		}
	}
	if(GetPVarInt(playerid,"CheckpointBackDaln")) {
		if(IsPlayerInRangeOfPoint(playerid,5.0,2209.2693,-2220.6868,14.1527)) {
        	DisablePlayerCheckpoint(playerid);
        	new car = GetPlayerVehicleID(playerid);
        	SetVehicleToRespawn(car);
        	if(PlayerTrailer[playerid] != -1) {
	        	V::[PlayerTrailer[playerid]][vWoods] = 0;
				V::[PlayerTrailer[playerid]][vMebel] = 0;
				V::[PlayerTrailer[playerid]][vToplivo] = 0;
				
				if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]))
			    	DestroyDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]);
				
			    DestroyVehicle(PlayerTrailer[playerid]);
			    
		        PlayerTrailer[playerid] = -1;
		        SetPVarInt(playerid,"dettachTrailer",0);
	        }
        	SetPVarInt(playerid,"CountBackDaln",0);
			DeletePVar(playerid,"CheckpointBackDaln");
		}
	}
	if(GetPVarInt(playerid,"ProductsCheckpoint")) {
		new id = GetPVarInt(playerid,"PlayerSelectedProducts") - 1;
		if(IsPlayerInRangeOfPoint(playerid,5.0,Bizz::[Product::[id][bID]][bEnter][0],Bizz::[Product::[id][bID]][bEnter][1],Bizz::[Product::[id][bID]][bEnter][2]) && (dalncars[0] <= GetPlayerVehicleID(playerid) <= dalncars[1])) {
			if(Product::[id][bCount] <= 0) return SendClientMessage(playerid,C_GRAY,""gbError"Этот заказ уже был выполнен. Для того, чтобы взять другой, используйте - "cBLUE"/job{ffffff}.");
			if(V::[GetPlayerVehicleID(playerid)][vProducts] == 0) {
				if(GetPVarInt(playerid,"PlayerSelectedProducts") != 0) Product::[GetPVarInt(playerid,"PlayerSelectedProducts") - 1][bStatus] = false;
				DeletePVar(playerid,"ProductsCheckpoint");
				return DisablePlayerCheckpoint(playerid);
			}
			new i = Product::[id][bID];

			if(V::[GetPlayerVehicleID(playerid)][vProducts] < Product::[id][bCount]) {
				if(Bizz::[i][bSettings][6] < V::[GetPlayerVehicleID(playerid)][vProducts]) return SendClientMessage(playerid,C_GRAY,""gbError"В данном бизнесе недостаточно денег для оплаты заказа!");
				Bizz::[i][bSettings][3] += V::[GetPlayerVehicleID(playerid)][vProducts];
				Bizz::[i][bSellHour] = 0;
				SetBizzStr(Bizz::[i][bID],"bSellHour",Bizz::[i][bSellHour]);
				Product::[id][bCount] -= V::[GetPlayerVehicleID(playerid)][vProducts];
				if(V::[GetPlayerVehicleID(playerid)][vProducts] >= 450) 
				{
		            if(JobValueNow(playerid, 10, 300, Player[playerid][uJob]) != 0) { }
					else
					{
                        D::[playerid][dJobMarsh] = 0;
						D::[playerid][dDalnDuty] = false;
		    			if(D::[playerid][dDalnKey] != -1) SetVehicleToRespawn(D::[playerid][dDalnKey]);
						MeAction(playerid,"закончил(-а) рабочий день",1);
						DisablePlayerCheckpoint(playerid);
					}
				}
				else SendClientMessage(playerid,C_GRAY,""gbError"У вас с собой слишком мало продуктов для выдачи денег Вам!");
				Bizz::[i][bSettings][6] -= V::[GetPlayerVehicleID(playerid)][vProducts];
                V::[GetPlayerVehicleID(playerid)][vProducts] = 0;
			}
			else if(V::[GetPlayerVehicleID(playerid)][vProducts] >= Product::[id][bCount]) {
				if(Bizz::[i][bSettings][6] < Product::[id][bCount]) return SendClientMessage(playerid,C_GRAY,""gbError"В данном бизнесе недостаточно денег для оплаты заказа!");
				Bizz::[i][bSettings][3] += Product::[id][bCount];
				Bizz::[i][bSellHour] = 0;
				//SetBizzStr(Bizz::[i][bID],"bSellHour",Bizz::[i][bSellHour]);
				SetBizzStr(Bizz::[i][bID],"bSellHour",Bizz::[i][bSellHour]);
				if(V::[GetPlayerVehicleID(playerid)][vProducts] >= 450)
				{
				    if(JobValueNow(playerid, 10, 300, Player[playerid][uJob]) != 0) { }
					else
					{
                        D::[playerid][dJobMarsh] = 0;
						D::[playerid][dDalnDuty] = false;
		    			if(D::[playerid][dDalnKey] != -1) SetVehicleToRespawn(D::[playerid][dDalnKey]);
						MeAction(playerid,"закончил(-а) рабочий день",1);
						DisablePlayerCheckpoint(playerid);
					}
				}
				else SendClientMessage(playerid,C_GRAY,""gbError"У вас с собой слишком мало продуктов для выдачи денег Вам!");
				V::[GetPlayerVehicleID(playerid)][vProducts] -= Product::[id][bCount];
				Bizz::[i][bSettings][6] -= Product::[id][bCount];
				Product::[id][bID] = 0;
		        Product::[id][bCount] = 0;
		        Bizz::[i][bProds] = false;
			}
            Product::[id][pStatus] = false;
            
			SetPVarInt(playerid, "LoadNow", 0);

			SendClientMessage(playerid,C_GRAY,""gbAccess"Вы выполнили заказ на развозку товаров!");

			if(GetPVarInt(playerid,"PlayerSelectedProducts") != 0) Product::[GetPVarInt(playerid,"PlayerSelectedProducts") - 1][bStatus] = false;
			DeletePVar(playerid,"PlayerSelectedProducts");

			if(V::[GetPlayerVehicleID(playerid)][vProducts] != 0) {
				format(gb_string,sizeof(gb_string),"Товары:\n{ffffff}%d/%d ед.",V::[GetPlayerVehicleID(playerid)][vProducts],MAX_PRODUCTS_INCAR);
				UpdateDynamic3DTextLabelText(V::[GetPlayerVehicleID(playerid)][vProductsText],C_BLUE,gb_string);
			}
			else
			{
			    if (IsValidDynamic3DTextLabel(V::[GetPlayerVehicleID(playerid)][vProductsText]))
					DestroyDynamic3DTextLabel(V::[GetPlayerVehicleID(playerid)][vProductsText]);
			}

			format(gb_string,sizeof(gb_string),"%d|%d|%d|%d|%d|%d|%d|%d",Bizz::[i][bSettings][0],Bizz::[i][bSettings][1],Bizz::[i][bSettings][2],
			Bizz::[i][bSettings][3],Bizz::[i][bSettings][4],Bizz::[i][bSettings][5],Bizz::[i][bSettings][6],Bizz::[i][bSettings][7]);
			SetBizzStr(Bizz::[i][bID],"bSettings",gb_string);

			DeletePVar(playerid,"ProductsCheckpoint");
			togglePlayerControllable(playerid,false);
			SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);

			DisablePlayerCheckpoint(playerid);
			return 1;
		}
	}
	if(GetPVarInt(playerid,"FuelsCheckpoint")) {
		new id = GetPVarInt(playerid,"PlayerSelectedFuels") - 1;
		if(IsPlayerInRangeOfPoint(playerid,10.0,Bizz::[Fuel::[id][bID]][bEnter][0],Bizz::[Fuel::[id][bID]][bEnter][1],Bizz::[Fuel::[id][bID]][bEnter][2]) && PlayerTrailer[playerid] != -1 && (dalncars[0] <= GetPlayerVehicleID(playerid) <= dalncars[1])) {
            if(Fuel::[id][bCount] <= 0) {
                showPlayerDialog(playerid,d_daln + 2,2,"Выбор маршрута","1. "cGRAY"Отвозить топливо по бизнесам","Далее","Закрыть");
				DeletePVar(playerid,"FuelsCheckpoint");
				return SendClientMessage(playerid,C_GRAY,""gbError"Этот заказ уже был выполнен, возьмите другой.");
			}
			if(GetVehicleTrailer(GetPlayerVehicleID(playerid)) != PlayerTrailer[playerid]) {
				if(GetPVarInt(playerid,"PlayerSelectedFuels") != 0) Fuel::[GetPVarInt(playerid,"PlayerSelectedFuels") - 1][bStatus] = false;
				DeletePVar(playerid,"FuelsCheckpoint");
				DisablePlayerCheckpoint(playerid);
				return SendClientMessage(playerid,C_GRAY,""gbError"У вашего тягача должна быть цистерна с топливом!");
			}
			if(V::[PlayerTrailer[playerid]][vToplivo] == 0 && GetVehicleTrailer(GetPlayerVehicleID(playerid)) == PlayerTrailer[playerid]) {
				if(GetPVarInt(playerid,"PlayerSelectedFuels") != 0) Fuel::[GetPVarInt(playerid,"PlayerSelectedFuels") - 1][bStatus] = false;
				SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
				DeletePVar(playerid,"FuelsCheckpoint");
				return SendClientMessage(playerid,C_GRAY,""gbInfo"В вашей цистерне закончилось топливо, верните цистерну обратно!");
			}

			new i = Fuel::[id][bID];

			if(V::[PlayerTrailer[playerid]][vToplivo] < Fuel::[id][bCount]) {
				if(Bizz::[i][bSettings][6] < V::[PlayerTrailer[playerid]][vToplivo]) {
					showPlayerDialog(playerid,d_daln + 2,2,"Выбор маршрута","1. "cGRAY"Отвозить топливо по бизнесам","Далее","Закрыть");
					DeletePVar(playerid,"FuelsCheckpoint");
					return SendClientMessage(playerid,C_GRAY,""gbError"В данном бизнесе недостаточно денег для оплаты заказа!");
				}
				Bizz::[i][bSettings][3] += V::[PlayerTrailer[playerid]][vToplivo];
				Bizz::[i][bSellHour] = 0;
				SetBizzStr(Bizz::[i][bID],"bSellHour",Bizz::[i][bSellHour]);
				Fuel::[id][bCount] -= V::[PlayerTrailer[playerid]][vToplivo];
				
				JobValueNow(playerid, 20, 500, Player[playerid][uJob]);
				//GiveJobMoney(playerid,Player[playerid][uJob],V::[PlayerTrailer[playerid]][vToplivo]);
				Bizz::[i][bSettings][6] -= V::[PlayerTrailer[playerid]][vToplivo];
				V::[PlayerTrailer[playerid]][vToplivo] = 0;
			}
			else if(V::[PlayerTrailer[playerid]][vToplivo] >= Fuel::[id][bCount]) {
				if(Bizz::[i][bSettings][6] < Product::[id][bCount]) {
					showPlayerDialog(playerid,d_daln + 2,2,"Выбор маршрута","1. "cGRAY"Отвозить топливо по бизнесам","Далее","Закрыть");
					DeletePVar(playerid,"FuelsCheckpoint");
					return SendClientMessage(playerid,C_GRAY,""gbError"В данном бизнесе недостаточно денег для оплаты заказа!");
				}
				Bizz::[i][bSettings][3] += Fuel::[id][bCount];
				Bizz::[i][bSellHour] = 0;
				SetBizzStr(Bizz::[i][bID],"bSellHour",Bizz::[i][bSellHour]);
                JobValueNow(playerid, 20, 500, Player[playerid][uJob]);
				//GiveJobMoney(playerid,Player[playerid][uJob],Fuel::[id][bCount]);
				V::[PlayerTrailer[playerid]][vToplivo] -= Fuel::[id][bCount];
				Bizz::[i][bSettings][6] -= Fuel::[id][bCount];
				Fuel::[id][bID] = 0;
		        Fuel::[id][bCount] = 0;
			}

			SendClientMessage(playerid,C_GRAY,""gbAccess"Вы выполнили заказ на развозку топлива!");
			if(GetPVarInt(playerid,"PlayerSelectedFuels") != 0) Fuel::[GetPVarInt(playerid,"PlayerSelectedFuels") - 1][bStatus] = false;
			DeletePVar(playerid,"PlayerSelectedFuels");

			format(gb_string,sizeof(gb_string),"Топливо\n{ffffff}%d/%d л.",V::[PlayerTrailer[playerid]][vToplivo],MAX_FUEL_IN_VEHICLE);
			UpdateDynamic3DTextLabelText(V::[PlayerTrailer[playerid]][vTextTrailer],C_BLUE,gb_string);

			format(gb_string,sizeof(gb_string),"%d|%d|%d|%d|%d|%d|%d|%d",Bizz::[i][bSettings][0],Bizz::[i][bSettings][1],Bizz::[i][bSettings][2],
			Bizz::[i][bSettings][3],Bizz::[i][bSettings][4],Bizz::[i][bSettings][5],Bizz::[i][bSettings][6],Bizz::[i][bSettings][7]);
			SetBizzStr(Bizz::[i][bID],"bSettings",gb_string);

			DisablePlayerCheckpoint(playerid);

			togglePlayerControllable(playerid,false);
			SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_J);

			if(V::[PlayerTrailer[playerid]][vToplivo] == 0) {
				SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,1061.2046,-322.2485,73.9851,5.0));
				SendClientMessage(playerid,C_GRAY,""gbInfo"В вашей цистерне закончилось топливо, верните цистерну обратно!");
				DeletePVar(playerid,"FuelsCheckpoint");
			}
			else {
				DeletePVar(playerid,"FuelsCheckpoint");
				showPlayerDialog(playerid,d_daln + 2,2,"Выбор маршрута","1. "cGRAY"Отвозить топливо по бизнесам","Далее","Закрыть");
			}
		}
	}
	return 1;
}

public OnDynamicObjectMoved(objectid)
{
	new string[128];
    if(GetGVarType("WoodConv2",objectid) == GLOBAL_VARTYPE_INT) {
    	DeleteGVar("WoodConv2",objectid);
    	DestroyDynamicObject(objectid);
    	S::[0][wsWoods] += 25;
    	format(string,sizeof(string),"Древесина\n{ffffff}%d кг.",S::[0][wsWoods]);
    	UpdateDynamic3DTextLabelText(S::[0][wsWoodsT],C_BLUE,string);
	}
	if(GetGVarType("WoodStanok2",objectid) == GLOBAL_VARTYPE_INT) {
	    DeleteGVar("WoodStanok2",objectid);
	    DestroyDynamicObject(objectid);
	}
	if(GetGVarType("WoodStanok3",objectid) == GLOBAL_VARTYPE_INT) {
	    DeleteGVar("WoodStanok3",objectid);
	    DestroyDynamicObject(objectid);
	}
	if(GetGVarType("WoodGoSklad",objectid) == GLOBAL_VARTYPE_INT) {
	    DeleteGVar("WoodGoSklad",objectid);
	    DestroyDynamicObject(objectid);
	    S::[0][wsWoodsSklad] += 10;
	    format(string,sizeof(string),"Обработанная древесина\n{ffffff}%d кг.",S::[0][wsWoodsSklad]);
	    UpdateDynamic3DTextLabelText(S::[0][wsWoodsTS][0],C_BLUE,string);
	    UpdateDynamic3DTextLabelText(S::[0][wsWoodsTS][1],C_BLUE,string);
	}
	if(GetGVarType("WoodGoSklad2",objectid) == GLOBAL_VARTYPE_INT) {
	    DeleteGVar("WoodGoSklad2",objectid);
	    DestroyDynamicObject(objectid);
	}
	if(GetGVarType("WoodConv",objectid) == GLOBAL_VARTYPE_INT) {
    	DeleteGVar("WoodConv",objectid);
    	DestroyDynamicObject(objectid);
    	new obj = CreateDynamicObject(1463,-456.91119, -94.95390, 774.12469,0.00000, 0.00000, 0.00000);
	    SetGVarInt("WoodConv2",1,obj);
	    MoveDynamicObject(obj,-464.57120, -94.95390, 774.12469,1,0.00000, 0.00000, 0.00000);
    }
	if(GetGVarType("WoodStanok",objectid) == GLOBAL_VARTYPE_INT) {
	    DeleteGVar("WoodStanok",objectid);
	    DestroyDynamicObject(objectid);
	    
	    new obj = CreateDynamicObject(2468,-468.29230, -86.36710, 773.94043,0.00,0.00,90.00);
	    new obj2 = CreateDynamicObject(2468, -468.35901, -86.75980, 773.94043,0.00,0.00,-90.00);
	    MoveDynamicObject(obj,-468.29230, -90.60710, 773.94043,1,0.00,0.00,90.00);
	    MoveDynamicObject(obj2,-468.35898, -90.97980, 773.94043,1,0.00,0.00,-90.00);
	    
	    SetGVarInt("WoodStanok2",1,obj);
	    SetGVarInt("WoodStanok3",1,obj2);
	}
	return 1;
}

public OnPlayerEnterRaceCheckpoint(playerid) 
{
	return 1;
