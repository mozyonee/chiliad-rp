					V::[i][vInvSlotKol][0] = 1,V::[i][vInvSlotKol][1] = 1,V::[i][vInvSlotKol][2] = 1,
					V::[i][vInvSlotKol][3] = 1,V::[i][vInvSlotKol][4] = 100,V::[i][vInvSlotKol][5] = 100,
