			if(!isNumeric(inputtext)) return showPlayerDialog(playerid,d_frac + 5,1," ","{ffffff}Введите ID человека которого хотите принять в организацию:\n\n","Далее","Закрыть");
			if(!IsPlayerConnected(strval(inputtext))) return showPlayerDialog(playerid,d_frac + 5,1," ","{ffffff}Введите ID человека которого хотите принять в организацию:\n\n"gbError"Игрок вышел из игры","Далее","Закрыть");
			if(Player[strval(inputtext)][uMember] != 0) return showPlayerDialog(playerid,d_frac + 5,1," ","{ffffff}Введите ID человека которого хотите принять в организацию:\n\n"gbError"Игро состоит уже во фракции","Далее","Закрыть");
            if(Player[strval(inputtext)][uCrimeM] != 0) return showPlayerDialog(playerid,d_frac + 5,1," ","{ffffff}Введите ID человека которого хотите принять в организацию:\n\n"gbError"Игрок состоит в банде","Далее","Закрыть");
			if(F::[Player[playerid][uMember]][fRank][0] > Player[playerid][uRank]) return showPlayerDialog(playerid,d_frac + 5,1," ","{ffffff}Введите ID человека которого хотите принять в организацию:\n\n"gbError"Не достаточно полномочий","Далее","Закрыть");

			SetPVarInt(strval(inputtext),"playerInviteFrac",Player[playerid][uMember]);
