							V::[PlayerTrailer[i]][vWoods] = 0;
							V::[PlayerTrailer[i]][vMebel] = 0;
							V::[PlayerTrailer[i]][vToplivo] = 0;
							
							if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[i]][vTextTrailer]))
							{
								DestroyDynamic3DTextLabel(V::[PlayerTrailer[i]][vTextTrailer]);
								V::[PlayerTrailer[i]][vTextTrailer] = Text3D: INVALID_3DTEXT_ID;
							}
							
							DestroyVehicle(PlayerTrailer[i]);
					
							
							PlayerTrailer[i] = -1;
							SetPVarInt(i,"dettachTrailer",0);
						}
					}
			    }
			}
		}
		if(GetPVarInt(i,"CountBackToBus") != 0) {
		    SetPVarInt(i,"CountBackToBus",GetPVarInt(i,"CountBackToBus") - 1);
		    format(string,sizeof(string),"%d",GetPVarInt(i,"CountBackToBus"));
    		GameTextForPlayer(i, string, 2000, 6);
		    if(GetPVarInt(i,"CountBackToBus") == 0) SetVehicleToRespawn(D::[i][dBusKey]);
		}
		if(GetPVarInt(i,"TimerCountWoods") != 0) {
		    SetPVarInt(i,"TimerCountWoods",GetPVarInt(i,"TimerCountWoods") - 1);
		    format(string,sizeof(string),"%d",GetPVarInt(i,"TimerCountWoods"));
    		GameTextForPlayer(i, string, 2000, 6);
    		if(GetPVarInt(i,"TimerCountWoods") == 0) {
    		    DeletePVar(i,"PlayerWoodsLimit");
    			SendClientMessage(i, -1, ""gbAccess"Ваша зарплата перечислена на чековую книжку, обналичить ее можно в банке");
    		    showPlayerDialog(i, 9999, 0, " ", "{ffffff}Ваш рабочий день закончен!\n\n"cGREEN"| Ваша зарплата перечислена на чековую книжку.\n"gbError"Снять деньги с чековой книжки можно в банке", "Закрыть", "");
				D::[i][dWoodsDuty] = 0;
