stock UpdateVehicleHud(playerid)
{
    new vehicleid = GetPlayerVehicleID(playerid);
    GetVehicleParamsEx(vehicleid,eng,light,other1,other2,other3,other4,other5);
    if(eng == 1) PlayerTextDrawSetString(playerid,Speed[0][playerid],"~w~ENG");
    else PlayerTextDrawSetString(playerid,Speed[0][playerid],"~l~ENG");
    if(light == 1) PlayerTextDrawSetString(playerid,Speed[2][playerid],"~w~lamp");
    else PlayerTextDrawSetString(playerid,Speed[2][playerid],"~l~lamp");
    if(other2 == 1) PlayerTextDrawSetString(playerid,Speed[3][playerid],"~w~lock");
    else PlayerTextDrawSetString(playerid,Speed[3][playerid],"~l~lock");
    if(V::[vehicleid][vLimit] == true) PlayerTextDrawSetString(playerid,Speed[1][playerid],"~w~lim");
    else PlayerTextDrawSetString(playerid,Speed[1][playerid],"~l~lim");
    UpdateFuelBar(playerid,GetPlayerVehicleID(playerid));
	return 1;
}

stock CheckEngine(playerid) {
	//new string[30];
    new vehicleid = GetPlayerVehicleID(playerid),Float:hp;
    GetVehicleParamsEx(vehicleid,eng,light,other1,other2,other3,other4,other5);
    GetVehicleHealth(vehicleid,hp);
    if(hp <= 400.0) return SendClientMessage(playerid,C_GRAY,""gbError"Данная машина не способна завестись!");
    if(eng!=1)
	{
        if(IsPlayerInAnyVehicle(playerid))
		{
        	if(V::[GetPlayerVehicleID(playerid)][vFuel] == 0) return SendClientMessage(playerid,C_GRAY,""gbError"В данном транспорте закончилось топливо!");
        	
        	if(vehicleid >= ataxils[0] && vehicleid <= ataxils[1]) {
			    if(Player[playerid][uJob] != 1) return SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
			    if(V::[vehicleid][vTaxiDriver] != playerid || D::[playerid][dTaxiKey] != vehicleid) return SendClientMessage(playerid,C_GRAY,"У Вас нет ключей от данного транспорта!");
			}
			if( V::[vehicleid][vCrime] ) {
				if( Player[playerid][uCrimeM] != V::[vehicleid][vCrime] ) {
					return SendMes( playerid, C_GRAY, "У Вас нет ключей от данного транспорта!" );
				}
				else if( !Player[playerid][uCrimeSet][CRIME_USECAR] && !getRankSettings( playerid, CRIME_USECAR ) ) {
					return SendMes( playerid, C_GRAY, "У Вас нет ключей от данного транспорта!" );			
				}
			}
			if(vehicleid >= buscars[0] && vehicleid <= buscars[1]) {
			    if(Player[playerid][uJob] != 2) return SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
			    if(D::[playerid][dBusDuty] != true) return SendClientMessage(playerid,C_GRAY,""gbError"Вы не начали свой рабочий день!");
			    if(V::[vehicleid][vBusDriver] != playerid || D::[playerid][dBusKey] != vehicleid) return SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
			    if(GetVehicleModel(vehicleid) == 437 && Player[playerid][uBusSkill] < 50) return SendClientMessage(playerid,C_GRAY,""gbError"Простите, но Ваш стаж водителя слишком мал для этого транспорта.");
			}
			if(vehicleid >= dalncars[0] && vehicleid <= dalncars[1]) {
			    if(Player[playerid][uJob] != 3) return SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
			    if(D::[playerid][dDalnDuty] != true) return SendClientMessage(playerid,C_GRAY,""gbError"Вы не начали свой рабочий день!");
			    if(V::[vehicleid][vDalnDriver] != playerid || D::[playerid][dDalnKey] != vehicleid) return SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
			    if(GetVehicleModel(vehicleid) == 514 && Player[playerid][uDalnSkill] < 50) return SendClientMessage(playerid,C_GRAY,""gbError"Простите, но Ваш стаж водителя слишком мал для этого транспорта.");
			    if(GetVehicleModel(vehicleid) == 515 && Player[playerid][uDalnSkill] < 100) return SendClientMessage(playerid,C_GRAY,""gbError"Простите, но Ваш стаж водителя слишком мал для этого транспорта.");
			}
			
			if(vehicleid >= sheriffandpolice[0] && vehicleid <= sheriffandpolice[1]) {
				if( (Player[playerid][uMember] != 2 || Player[playerid][uIsPlayerJob][0] == 0) && (Player[playerid][uMember] != 8 || Player[playerid][uIsPlayerJob][0] == 0)) return SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
			}
			if(vehicleid >= lspdcars[0] && vehicleid <= lspdcars[1]) {
				if(Player[playerid][uMember] != 2 || Player[playerid][uIsPlayerJob][0] == 0) return SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
			}
			if(vehicleid >= sherifcar[0] && vehicleid <= sherifcar[1]) {
				if(Player[playerid][uMember] != 1 || Player[playerid][uIsPlayerJob][0] == 0) return SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
			}
			if(vehicleid >= sasd_car[0] && vehicleid <= sasd_car[1]) {
				if(Player[playerid][uMember] != 8 || Player[playerid][uIsPlayerJob][0] == 0) return SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
			}
			if(vehicleid >= medicalcar[0] && vehicleid <= medicalcar[1]) {
				if(Player[playerid][uMember] != 3 || Player[playerid][uIsPlayerJob][1] == 0) return SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
			}
			if(vehicleid >= smicars[0] && vehicleid <= smicars[1]) {
				if(Player[playerid][uMember] != 4) return SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
			}
			if(vehicleid >= fd_cars[0] && vehicleid <= fd_cars[1]) 
			{
				if(Player[playerid][uMember] != 5 || Player[playerid][uIsPlayerJob][2] == 0) return SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
			}
			if(vehicleid >= meria[0] && vehicleid <= meria[1]) {
				if(Player[playerid][uMember] != 6) return SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
			}
			if(vehicleid >= comm[0] && vehicleid <= comm[1]) {
				if(Player[playerid][uMember] != 7) return SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
			}
			if(V::[GetPlayerVehicleID(playerid)][vRentCar][0] == 1 && D::[playerid][dRentVehicleID] == GetPlayerVehicleID(playerid))
			{
			    SetVehicleParamsEx(vehicleid,1,light,other1,other2,other3,other4,other5);
	 			PlayerTextDrawSetString(playerid,Speed[0][playerid],"~w~ENG");
	 			return 1;
			}
			
			if( IsBuyingCar( vehicleid ) )
			{
				new 
					bool: count = false;
				
                for(new g; g != 48; g++) 
				{
                    switch( _itemsInfo[ Inv[playerid][invSlot][g] ][invID] ) 
					{
                        case 23: 
						{
                            if( Car::[ vehicleid ][cID] == Inv[playerid][invSlotKol][g] ) 
							{
								count = true;
								break;
							}
                        }
                    }
				}
				
				if( !count)
				{
					return SendMes(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
				}
			}
			
			SetVehicleParamsEx(vehicleid,1,light,other1,other2,other3,other4,other5);
 			PlayerTextDrawSetString(playerid,Speed[0][playerid],"~w~ENG");
		}
    }
    else {
	    SetVehicleParamsEx(vehicleid,0,light,other1,other2,other3,other4,other5);
	    PlayerTextDrawSetString(playerid,Speed[0][playerid],"~l~ENG");
	}
	return 1;
}

stock SetVehicleSpeed(vehicleid, Float:speed) {
    new Float:x1, Float:y1, Float:z1, Float:x2, Float:y2, Float:z2, Float:a;
    GetVehicleVelocity(vehicleid, x1, y1, z1);
    GetVehiclePos(vehicleid, x2, y2, z2);
    GetVehicleZAngle(vehicleid, a); a = 360 - a;
    x1 = (floatsin(a, degrees) * (speed/100) + floatcos(a, degrees) * 0 + x2) - x2;
    y1 = (floatcos(a, degrees) * (speed/100) + floatsin(a, degrees) * 0 + y2) - y2;
    SetVehicleVelocity(vehicleid, x1, y1, z1);
}

stock CheckDoor(playerid) {
    new vehicleid = GetPlayerVehicleID(playerid);
    GetVehicleParamsEx(vehicleid,eng,light,other1,other2,other3,other4,other5);
    if(other2 != 1) {
        if(IsPlayerInAnyVehicle(playerid)) {
		    SetVehicleParamsEx(vehicleid,eng,light,other1,1,other3,other4,other5);
		    PlayerTextDrawSetString(playerid,Speed[3][playerid],"~w~lock");
		}
		else SetVehicleParamsEx(vehicleid,eng,light,other1,1,other3,other4,other5);
		GameTextForPlayer(playerid, "~r~LOCK", 3000, 3);
		V::[vehicleid][vLock] = true;
    }
    else {
        if(IsPlayerInAnyVehicle(playerid)) {
	    	SetVehicleParamsEx(vehicleid,eng,light,other1,0,other3,other4,other5);
	    	PlayerTextDrawSetString(playerid,Speed[3][playerid],"~l~lock");
		}
		else SetVehicleParamsEx(vehicleid,eng,light,other1,0,other3,other4,other5);
		GameTextForPlayer(playerid, "~g~UNLOCK", 3000, 3);
		V::[vehicleid][vLock] = false;
	}
}

stock CheckLight(playerid) {
    new vehicleid = GetPlayerVehicleID(playerid);
    GetVehicleParamsEx(vehicleid,eng,light,other1,other2,other3,other4,other5);
    if(light!=1) {
        if(IsPlayerInAnyVehicle(playerid)) {
		    SetVehicleParamsEx(vehicleid,eng,1,other1,other2,other3,other4,other5);
		    PlayerTextDrawSetString(playerid,Speed[2][playerid],"~w~lamp");
		}
    }
    else {
	    SetVehicleParamsEx(vehicleid,eng,0,other1,other2,other3,other4,other5);
	    PlayerTextDrawSetString(playerid,Speed[2][playerid],"~l~lamp");
	}
}

stock IsPlane(carid) {
	switch(GetVehicleModel(carid)) { case 417,425,447,460,469,467,476,487,488,497,511,512,513,519,520,548,553,563,577,592,593: return true; }
	return false;
