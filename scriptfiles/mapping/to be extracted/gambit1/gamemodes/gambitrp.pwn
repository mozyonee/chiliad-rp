public OnVehicleDamageStatusUpdate( vehicleid, playerid ) 
{
	for(new i; i != MAX_CARS_BUY; i++) 
	{
	    if( !IsBuyingCar( i ) ) 
			continue;
			
		if( i == vehicleid ) 
		{
    		GetVehicleDamageStatus(vehicleid,  Car::[i][cDamage][0], Car::[i][cDamage][1], Car::[i][cDamage][2], Car::[i][cDamage][3]);
    		GetVehicleHealth(vehicleid, Car::[i][cFloating][2]);
			break;
		}
	}
	return 1;
}

public OnEnterExitModShop(playerid, enterexit, interiorid) {
    if(enterexit == 1) SetPVarInt(playerid,"ACPlayerTuning",1);
    else DeletePVar(playerid,"ACPlayerTuning");
    return 1;
}

public OnPlayerUpdate(playerid)
{
    new string[256];
    if(GetPVarInt(playerid,"uLogin") == 0) return Kick(playerid);

    if(GetPVarInt(playerid,"PlayerAFKUse") >= 1) SetPVarInt(playerid,"PlayerAFKUse",0);
	SetPVarInt(playerid,"PlayerAFK",0);

	if(GetPVarInt(playerid,"CreateBarForPlayer") >= 1)
	{
 		if(GetPlayerProgressBarValue(playerid, universalbar[playerid]) >= 10)
 		{
    		SetPlayerProgressBarValue(playerid, universalbar[playerid], GetPlayerProgressBarValue(playerid, universalbar[playerid])-2);
			UpdatePlayerProgressBar(playerid, universalbar[playerid]);
		}
		else
		{
		    playerFlags[playerid] ^= YN;
		    KeyYN{playerid} = 0;
			for(new i; i < 2; i++) PlayerTextDrawHide(playerid, YNText[playerid][i]);
			HidePlayerProgressBar(playerid, universalbar[playerid]);
	   		DestroyPlayerProgressBar(playerid, universalbar[playerid]);
	   		SetPVarInt(playerid, "CreateBarForPlayer", 0);

	   		RemovePlayerAttachedObject(playerid, 5);
	  		SetPVarInt(playerid, "FishingStart", 0);
			ClearAnimations(playerid);
			ApplyAnimation(playerid,"ped","IDLE_chat",4.1,1,0,0,0,1,1);
		}
	}
	if(GetPlayerMoney(playerid) != Player[playerid][uMoney]) ResetPlayerMoney(playerid), GivePlayerMoney(playerid,Player[playerid][uMoney]);
	
	if(IsPlayerInAnyVehicle(playerid))
	{
	    switch(GetPlayerWeapon(playerid))
		{
		    case 24: SetPlayerArmedWeapon(playerid,0);
		    case 25: SetPlayerArmedWeapon(playerid,0);
		    case 33: SetPlayerArmedWeapon(playerid,0);
		}
	}

	if(IsPlayerInAnyVehicle(playerid)) {
  		if(GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
  			foreach(new i : Player) {
  				if(Border::[i][bStatus] == false) continue;
  				if(IsPlayerInRangeOfPoint(playerid, 3.0, Border::[i][bP][0], Border::[i][bP][1], Border::[i][bP][2]) && Border::[i][bObject] == 2899) {
	  				new panels, doors, lights, tires;
		            GetVehicleDamageStatus(GetPlayerVehicleID(playerid), panels, doors, lights, tires);
		            if(tires == 0) {
			            UpdateVehicleDamageStatus(GetPlayerVehicleID(playerid), panels, doors, lights, 15);
			            if(SpeedVehicle(GetPlayerVehicleID(playerid)) > 40.0) {
			            	new Float:angle;
			            	GetVehicleZAngle(GetPlayerVehicleID(playerid),angle);
			            	switch(random(2)) {
			            		case 0: SetVehicleZAngle(GetPlayerVehicleID(playerid),angle + random(30));
			            		case 1: SetVehicleZAngle(GetPlayerVehicleID(playerid),angle - random(30));
			            		default: SetVehicleZAngle(GetPlayerVehicleID(playerid),angle + random(30));
			            	}
			            }
		        	}
		            break;
  				}
  			}
  		}
		if(V::[GetPlayerVehicleID(playerid)][vLimit] == true) {
		    if(GetPlayerVehicleSeat(playerid) == 0) {
				if(SpeedVehicle(GetPlayerVehicleID(playerid)) >= 60) SetVehicleSpeed(GetPlayerVehicleID(playerid),59);
			}
		}
		if(Player[playerid][uSettings][0] == 1) {
			switch(SpeedVehicle(GetPlayerVehicleID(playerid))) {
				case 0 .. 1: PlayerTextDrawSetString(playerid,Speed[6][playerid],"");
			    case 2 .. 5: PlayerTextDrawSetString(playerid,Speed[6][playerid],"I");
			    case 6 .. 10: PlayerTextDrawSetString(playerid,Speed[6][playerid],"II");
			    case 11 .. 15: PlayerTextDrawSetString(playerid,Speed[6][playerid],"III");
			    case 16 .. 20: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIII");
			    case 21 .. 25: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIII");
			    case 26 .. 30: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIII");
			    case 31 .. 35: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIII");
			    case 36 .. 40: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIII");
			    case 41 .. 50: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIIII");
			    case 51 .. 60: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIIIII");
			    case 61 .. 70: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIIIIII");
			    case 71 .. 75: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIIIIIII");
			    case 76 .. 80: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIIIIIIII");
			    case 81 .. 85: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIIIIIIIII");
			    case 86 .. 90: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIIIIIIIIII");
			    case 91 .. 95: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIIIIIIIIIII");
			    case 96 .. 100: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIIIIIIIIIIII");
			    case 101 .. 105: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIIIIIIIIIIIII");
			    case 106 .. 110: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIIIIIIIIIIIIII");
			    case 111 .. 120: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIIIIIIIIIIIIIII");
			    case 121 .. 125: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIIIIIIIIIIIIIIII");
			    case 126 .. 130: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIIIIIIIIIIIIIIIII");
			    case 131 .. 140: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIIIIIIIIIIIIIIIIII");
			    case 141 .. 999: PlayerTextDrawSetString(playerid,Speed[6][playerid],"IIIIIIIIIIIIIIIIIIIIIIII");
			}
			format(string,sizeof(string),"%d mp/h",SpeedVehicle(GetPlayerVehicleID(playerid)));
			PlayerTextDrawSetString(playerid,Speed[5][playerid],string);
		}
	}
	return 1;
}

public OnObjectMoved(objectid) {
    return 1;
}

public OnPlayerKeyStateChange(playerid, newkeys, oldkeys) {
	clear_massive();
	new car = GetPlayerVehicleID(playerid),string[2048];
	if(newkeys & 128 && oldkeys & 128 && newkeys & KEY_SECONDARY_ATTACK)
	{
		if(GetPVarInt(playerid, "StartTraining") == 1 && GetPVarInt(playerid, "StartTrainingTwo") == 1)
	    {
			if(IsPlayerInRangeOfPoint(playerid, 1, 767.1263, -3.2047, 1000.7186)
			|| IsPlayerInRangeOfPoint(playerid, 1, 769.4302, -3.2047, 1000.7236)
			|| IsPlayerInRangeOfPoint(playerid, 1, 771.1208, 15.6786, 1000.6957)
			|| IsPlayerInRangeOfPoint(playerid, 1, 768.7616, 15.6708, 1000.6974))
			{
				if(Player[playerid][uStyle][0] < 1000)
				{
				    if(Player[playerid][uStyle][2] >= 750 && Player[playerid][uStyle][3] >= 900) {
						if(GetPVarInt(playerid, "ClickStyle") == 20)
						{
							Player[playerid][uStyle][0]++;
							GameTextForPlayer(playerid, "~w~Boxing Style ~g~+1", 500, 1);
							nowUpdateInfo(playerid, "d" , "gb_users" , "uName" , "StyleOne" , Player[playerid][uStyle][0]);
							SetPVarInt(playerid, "ClickStyle", 0);
						}
						else SetPVarInt(playerid, "ClickStyle", GetPVarInt(playerid, "ClickStyle") + 1);
					}
				}
			}
			else if(IsPlayerInRangeOfPoint(playerid, 1, 777.9382, -28.2814, 999.7972)
			|| IsPlayerInRangeOfPoint(playerid, 1, 777.8989, -38.8177, 999.8017)
			|| IsPlayerInRangeOfPoint(playerid, 1, 777.8768, -41.9620, 999.7386)
			|| IsPlayerInRangeOfPoint(playerid, 1, 777.9240, -24.4624, 999.7827))
			{
                if(Player[playerid][uStyle][1] < 1000)
				{
				    if(Player[playerid][uStyle][2] >= 900 && Player[playerid][uStyle][3] >= 700) {
						if(GetPVarInt(playerid, "ClickStyle") == 20)
						{
							Player[playerid][uStyle][1]++;
							GameTextForPlayer(playerid, "~w~Kung Fu Style ~g~+1", 500, 1);
							nowUpdateInfo(playerid, "d" , "gb_users" , "uName" , "StyleTwo" , Player[playerid][uStyle][1]);
							SetPVarInt(playerid, "ClickStyle", 0);
						}
						else SetPVarInt(playerid, "ClickStyle", GetPVarInt(playerid, "ClickStyle") + 1);
					}
				}
			}
			else if(IsPlayerInRangeOfPoint(playerid, 1, 773.5189,-59.1922,1000.7184)
			|| IsPlayerInRangeOfPoint(playerid, 1, 773.3441,-61.8451,1000.7184)
			|| IsPlayerInRangeOfPoint(playerid, 1, 776.0648,-64.7381,1000.7184)
			|| IsPlayerInRangeOfPoint(playerid, 1, 773.9121,-64.7556,1000.7184))
			{
                if(Player[playerid][uStyle][4] < 1000)
				{
				    if(Player[playerid][uStyle][2] >= 850 && Player[playerid][uStyle][3] >= 800) {
						if(GetPVarInt(playerid, "ClickStyle") == 20)
						{
							Player[playerid][uStyle][4]++;
							GameTextForPlayer(playerid, "~w~Kickbox ~g~+1", 500, 1);
							nowUpdateInfo(playerid, "d" , "gb_users" , "uName" , "StyleFive" , Player[playerid][uStyle][4]);
							SetPVarInt(playerid, "ClickStyle", 0);
						}
						else SetPVarInt(playerid, "ClickStyle", GetPVarInt(playerid, "ClickStyle") + 1);
					}
				}
			}
		}
		else SetPlayerFightingStyleEx(playerid);
	}


    if(HOLDING(KEY_CTRL_BACK | KEY_HANDBRAKE)) {
        new target = GetPlayerTargetPlayer(playerid);
        if(target != INVALID_PLAYER_ID) {
			if(GetDistanceBetweenPlayers(playerid,target) < 3.0) {
			    format(string,sizeof(string),"1. "cGRAY"Показать "cBLUE"%s"cGRAY" паспорт\n{ffffff}2. "cGRAY"Передать "cBLUE"%s"cGRAY" деньги\n{ffffff}3. "cGRAY"Поздароваться с "cBLUE"%s\n{ffffff}4. "cGRAY"Обыскать "cBLUE"%s",
			    Player[target][uName],Player[target][uName],Player[target][uName],Player[target][uName]);
			    showPlayerDialog(playerid,d_target,2," ",string,"Далее","Закрыть");
			    SetPVarInt(playerid,"playerTarget",target);
			}
        }
    }
	if(PRESSED(KEY_SUBMISSION) && GetPlayerState(playerid) == PLAYER_STATE_DRIVER) {
		if(!IsVelo(car) && !IsPlane(car)) {
			if(V::[car][vLimit] == false) V::[car][vLimit] = true,SendClientMessage(playerid,C_GREEN,""gbAccess"Вы включили ограничитель скорости!");
			else V::[car][vLimit] = false,SendClientMessage(playerid,C_RED,""gbAccess"Вы выключили ограничитель скорости!");
		}
		UpdateVehicleHud(playerid);
	}
	if(PRESSED(KEY_SPRINT)) {
	    EngageInGym(playerid);
	}

	if(GetPVarInt(playerid, "FishingStart") >= 1)
	{
		//Y-N
		if((playerFlags[playerid] & YN))
		{
			if(GetPlayerProgressBarValue(playerid, universalbar[playerid]) < 200)
			{
				switch(KeyYN{playerid})
				{
					case 0:
					{
						if(newkeys & KEY_NO)
						{
	       					KeyYN{playerid} = RandomEx(0, 2);
							switch(KeyYN{playerid})
							{
								case 0: PlayerTextDrawSetString(playerid, YNText[playerid][1], "PRESS ~r~N");
								case 1: PlayerTextDrawSetString(playerid, YNText[playerid][1], "PRESS ~r~Y");
							}
							PlayerTextDrawHide(playerid, YNText[playerid][1]);
							PlayerTextDrawShow(playerid, YNText[playerid][1]);
							SetPlayerProgressBarValue(playerid, universalbar[playerid], GetPlayerProgressBarValue(playerid, universalbar[playerid])+10);
				   			UpdatePlayerProgressBar(playerid, universalbar[playerid]);
				   			if(!IsPlayerInAnyVehicle(playerid)) ApplyAnimation(playerid,"SWORD","sword_block",50.0 ,0,1,0,1,1);
							return 1;
						}
						else if(newkeys & KEY_YES)
						{
							KeyYN{playerid} = RandomEx(0, 2);
							switch(KeyYN{playerid})
							{
								case 0: PlayerTextDrawSetString(playerid, YNText[playerid][1], "PRESS ~r~N");
								case 1: PlayerTextDrawSetString(playerid, YNText[playerid][1], "PRESS ~r~Y");
							}
							PlayerTextDrawHide(playerid, YNText[playerid][1]);
							PlayerTextDrawShow(playerid, YNText[playerid][1]);
	      					SetPlayerProgressBarValue(playerid, universalbar[playerid], GetPlayerProgressBarValue(playerid, universalbar[playerid])-15);
				   			UpdatePlayerProgressBar(playerid, universalbar[playerid]);
				   			if(!IsPlayerInAnyVehicle(playerid)) ApplyAnimation(playerid,"SWORD","sword_block",50.0 ,0,1,0,1,1);
							return 1;
						}
					}
					case 1:
					{
						if(newkeys & KEY_YES)
						{
	       					KeyYN{playerid} = RandomEx(0, 2);
							switch(KeyYN{playerid})
							{
								case 0: PlayerTextDrawSetString(playerid, YNText[playerid][1], "PRESS ~r~N");
								case 1: PlayerTextDrawSetString(playerid, YNText[playerid][1], "PRESS ~r~Y");
							}
							PlayerTextDrawHide(playerid, YNText[playerid][1]);
							PlayerTextDrawShow(playerid, YNText[playerid][1]);
	      					SetPlayerProgressBarValue(playerid, universalbar[playerid], GetPlayerProgressBarValue(playerid, universalbar[playerid])+10);
				   			UpdatePlayerProgressBar(playerid, universalbar[playerid]);
				   			if(!IsPlayerInAnyVehicle(playerid)) ApplyAnimation(playerid,"SWORD","sword_block",50.0 ,0,1,0,1,1);
							return 1;
						}
						else if(newkeys & KEY_NO)
						{
							KeyYN{playerid} = RandomEx(0, 2);
							switch(KeyYN{playerid})
							{
								case 0: PlayerTextDrawSetString(playerid, YNText[playerid][1], "PRESS ~r~N");
								case 1: PlayerTextDrawSetString(playerid, YNText[playerid][1], "PRESS ~r~Y");
							}
							PlayerTextDrawHide(playerid, YNText[playerid][1]);
							PlayerTextDrawShow(playerid, YNText[playerid][1]);
	      					SetPlayerProgressBarValue(playerid, universalbar[playerid], GetPlayerProgressBarValue(playerid, universalbar[playerid])-15);
				   			UpdatePlayerProgressBar(playerid, universalbar[playerid]);
				   			if(!IsPlayerInAnyVehicle(playerid)) ApplyAnimation(playerid,"SWORD","sword_block",50.0 ,0,1,0,1,1);
							return 1;
						}
					}
				}
			}
			else
			{
			    new test;
			    switch(random(5))
			    {
			        case 0: GivePlayerItem(playerid, 481, 1), test = 1;
			        case 1: GivePlayerItem(playerid, 482, 1), test = 1;
			        case 2: GivePlayerItem(playerid, 483, 1), test = 1;
			        case 3: test = 0;
			        case 4: test = 0;
			    }
			    RemovePlayerAttachedObject(playerid, 5);
			    SetPVarInt(playerid, "FishingStart", 0);
				SetPVarInt(playerid, "CreateBarForPlayer", 0);
				ClearAnimations(playerid);
				ApplyAnimation(playerid,"ped","IDLE_chat",4.1,1,0,0,0,1,1);

				if(test != 0) SendClientMessage(playerid, -1, ""gbAccess"Вы успешно поймали рыбку");
				else SendClientMessage(playerid, -1, ""gbAccess"Вы не чего не поймали");
				// Авто взломанно
				KeyYN{playerid} = 0;
				playerFlags[playerid] ^= YN;
				for(new i; i < 2; i++) PlayerTextDrawHide(playerid, YNText[playerid][i]);
				HidePlayerProgressBar(playerid, universalbar[playerid]);
		    	DestroyPlayerProgressBar(playerid, universalbar[playerid]);
				return 1;
			}
		}
	}
	//


	if(PRESSED(KEY_YES)) {
		if(newsClientEther == playerid) return SendClientMessage(playerid,C_GRAY,""gbError"Вы не можете ответить на звонок пока находитесь в эфире!");
		if(GetPVarInt(playerid,"phoneCalled") != INVALID_PLAYER_ID && GetPVarInt(playerid,"phoneCaller") != INVALID_PLAYER_ID && D::[playerid][dPhone] == false) {
			new id = GetPVarInt(playerid,"phoneCaller");
			if(GetPVarInt(id,"phoneCalled") != playerid) {
				SetPVarInt(playerid,"phoneCalled",INVALID_PLAYER_ID);
				SetPVarInt(playerid,"phoneCaller",INVALID_PLAYER_ID);
				PhoneStatus(playerid,false);
				return SendClientMessage(playerid,C_GRAY,""gbInfo"Абонент вне зоны действия сети ...");
			}
			SendClientMessage(id,C_GRAY,""gbAccess"Собеседник ответил(-а) на ваш входящий звонок, говорите ...");
			SendClientMessage(playerid,C_GRAY,""gbInfo"Вы ответили на звонок, чтобы положить трубку нажмите "cBLUE"N");
			D::[playerid][dPhone] = true;
			PhoneStatus(playerid,true);
			return 1;
		}
		if(GetPVarInt(playerid, "PlayerFrisk") != -1)
		{
		    new GivePlayerID = GetPVarInt(playerid, "PlayerFrisk");
		    SetPVarInt(GivePlayerID, "PlayerFrisk", -1);
			SetPVarInt(playerid, "PlayerFrisk", -1);

			vb_string[0] = EOS;
			format:gb_string( ""gbInfo"Наличные: "cGREEN"$%d"cWHITE".\n\n", Player[ playerid ][uMoney] );
			strcat( vb_string, gb_string );
			for(new i; i != 48; i++) {
				switch(Inv[playerid][invSlot][i])
				{
				    //case 329..338: { }
					case 0: continue;
				}
				format:gb_string( ""gbInfo"%s\t%d{ffffff}\n",_itemsInfo[Inv[playerid][invSlot][i]][invName], Inv[playerid][invSlotKol][i]);
				strcat( vb_string, gb_string );
			}
			showPlayerDialog( GivePlayerID, 9999,0, ""gbAccess"При обыске найдено:", vb_string, "Закрыть", "" );
			return 1;
		}
		if(GetPVarInt(playerid, "PlayerHandshake") != -1)
	    {
      		new GivePlayerID = GetPVarInt(playerid, "PlayerHandshake");
			SetPVarInt(GivePlayerID, "PlayerHandshake", -1);
			SetPVarInt(playerid, "PlayerHandshake", -1);
			if(!IsPlayerConnected(GivePlayerID)) return SendClientMessage(playerid, -1, ""gbError"Такого игрока нет на сервере");
			if(GetDistanceBetweenPlayers(playerid, GivePlayerID) > 3.0) return SendClientMessage(playerid, -1, ""gbError"Вы слишком далеко");
			if(IsPlayerInAnyVehicle(playerid)) return SendClientMessage(playerid, -1, ""gbError"Нельзя использовать в машине");
			TurnPlayerFaceToPlayer(playerid, GivePlayerID);
			TurnPlayerFaceToPlayer(GivePlayerID, playerid);
			ApplyAnimation(playerid, "GANGS", "hndshkfa", 4.0, 0, 0, 0, 0, 0, 0);
			ApplyAnimation(GivePlayerID, "GANGS", "hndshkfa", 4.0, 0, 0, 0, 0, 0, 0);
			format(string,sizeof(string),"поздаровался(-ась) с %s",Player[GivePlayerID][uName]);
			MeAction(playerid,string,1);
			format(string,sizeof(string),"поздаровался(-ась) с %s",Player[playerid][uName]);
			MeAction(GivePlayerID,string,1);
			return 1;
		}
	    if(GetPVarInt(playerid,"PlayerMenuShow") != 0) return 1;
	    // ИЗМЕНИТЬ if(GetPVarInt(playerid,"timerHospital") >= 2) return 1;
		if( getData( playerid, "HTx:Use" ) ) return true;
	    showPlayerDialog(playerid,d_a_menu,2," ","1. "cGRAY"Посмотреть игровое меню{ffffff}\n2. "cGRAY"Открыть свой инвентарь{ffffff}\
		\n3. "cGRAY"Достать сотовый телефон{ffffff}\n{ffffff}4. "cGRAY"Открыть GPS{ffffff}\n5. "cGRAY"Характеристики{ffffff}\
		\n6. "cGRAY"Избранные анимации{ffffff}","Далее","Закрыть");
	}
	if(PRESSED(KEY_NO)) {
		if(D::[playerid][dPhone] == true) {
			if(newsClientEther == playerid) {
				SendClientMessage(playerid,C_GRAY,""gbAccess"Вы положили трубку и покинули эфир!");
				newsClientEther = INVALID_PLAYER_ID;
				SendClientMessage(newsLeaderEther,C_GRAY,""gbInfo"Человек сидевший с вами в эфире, покинул эфир!");
				if(D::[playerid][dPhone] == true) PhoneStatus(playerid,false);
				D::[playerid][dPhone] = false;
				return 1;
			}
		}
		if(GetPVarInt(playerid,"phoneCalled") != INVALID_PLAYER_ID && GetPVarInt(playerid,"phoneCaller") != INVALID_PLAYER_ID) {
			new id;
			if(GetPVarInt(playerid,"phoneCaller") == playerid) id = GetPVarInt(playerid,"phoneCalled");
			else if(GetPVarInt(playerid,"phoneCalled") == playerid) id = GetPVarInt(playerid,"phoneCaller");
			SetPVarInt(playerid,"phoneCalled",INVALID_PLAYER_ID);
			SetPVarInt(playerid,"phoneCaller",INVALID_PLAYER_ID);
			SetPVarInt(id,"phoneCalled",INVALID_PLAYER_ID);
			SetPVarInt(id,"phoneCaller",INVALID_PLAYER_ID);
			SendClientMessage(playerid,C_GRAY,""gbAccess"Вы положили трубку или сбросили входящий вызов ...");
			SendClientMessage(id,C_GRAY,""gbInfo"Собеседник положил трубку или сбросил ваш входящий вызов ...");
			if(D::[playerid][dPhone] == true) PhoneStatus(playerid,false);
			if(D::[id][dPhone] == true) PhoneStatus(id,false);
			D::[playerid][dPhone] = false;
			D::[id][dPhone] = false;
		}
		if(GetPVarInt(playerid, "PlayerHandshake") != -1)
		{
			SetPVarInt(playerid, "PlayerHandshake", -1);
			SendClientMessage(playerid, -1, ""gbAccess"Вы отказали игроку");
		}
		if(GetPVarInt(playerid, "PlayerFrisk") != -1)
		{
			SetPVarInt(playerid, "PlayerFrisk", -1);
			SendClientMessage(playerid, -1, ""gbAccess"Вы отказали игроку");
		}
	}
	if(PRESSED(KEY_AIM)) {
		if(PlayerUseDrink[playerid] == 0) return 1;

		if(GetPVarInt(playerid,"PlayerDrinking") != 5) {
			SetPVarInt(playerid,"PlayerDrinking", GetPVarInt(playerid,"PlayerDrinking") + 1);
			switch(_itemsInfo[PlayerUseDrink[playerid]][invObject]) {
				case 1546: Player[playerid][uHunger] += 5;
				case 1951: Player[playerid][uHunger] += 10;
				case 1669, 1667: Player[playerid][uHunger] += 15;
				case 1668: Player[playerid][uHunger] += 20;
				case 1544: Player[playerid][uHunger] += 15;
				case 1543: Player[playerid][uHunger] += 15;
				case 1520: Player[playerid][uHunger] += 20;
				case 1664: Player[playerid][uHunger] += 20;
