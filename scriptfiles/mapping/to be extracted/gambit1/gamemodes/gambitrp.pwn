	//легальное оружие!
	{9,"Кольт 1911",346,"Самозарядный пистолет под патрон .45 ACP.\n\n"gbInfo"Используемые патроны: 9mm", 2.0,{0.000000, -30.000000, 0.000000, 1.500000}}, // 329
	{10,"Кольт 1911 с глушителем",347,"Самозарядный пистолет под патрон .45 ACP.с глушителем\n\n"gbInfo"Используемые патроны: 9mm",2.1,{0.000000, -30.000000, 0.000000, 1.500000}}, // 330
	{11,"Пуст. орел",348,"Самозарядный пистолет большого калибра (до 12,7 мм).\nПозиционируется как охотничье оружие и оружие для самозащиты от диких зверей и гражданских лиц.\n\n"gbInfo"Используемые патроны: .50 Action", 3.0,{0.000000, -30.000000, 0.000000, 1.500000}}, // 331
	{12,"Дробовик",349,"Гладкоствольное огнестрельное оружие, использующее энергию фиксированного снаряда \nдля стрельбы некоторым количеством небольших круглых шариков (дробью), либо пулями.\n\n"gbInfo"Используемые патроны: 12mm", 5.0,{0.000000, -30.000000, 0.000000, 1.500000}}, // 332
	{13,"UZI",352,"Cемейство пистолет-пулемётов, выпускаемых израильским концерном Israel Military Industries\n\n"gbInfo"Используемые патроны: 9.19mm",3.0,{0.000000, -30.000000, 0.000000, 1.500000}}, // 333
	{14,"MP5",353,"Cемейство пистолетов-пулемётов, разработанных немецким \nпроизводителем стрелкового оружия, фирмой Heckler & Koch\n\n"gbInfo"Используемые патроны: 9.19mm", 4.0,{0.000000, -30.000000, 0.000000, 1.500000}}, // 334
	{15,"АК-47",355,"Автомат, принятый на вооружение в СССР в 1949 году\n\n"gbInfo"Используемые патроны: 7.62mm",5.4,{0.000000, -30.000000, 0.000000, 1.500000}}, // 335
	{16,"М4А1",356,"Автомат, созданный в США на основе М16А2 изначально для \nвооружения экипажей боевых машин и расчетов техники.\n\n"gbInfo"Используемые патроны: 5.56mm",5.0,{0.000000, -30.000000, 0.000000, 1.500000}}, // 336
	{17,"TEC-9",372,"Самозарядный 9-мм пистолет, разработанный в Швеции в 1980-х годах.\nПопулярен в преступном мире из за возможности переделки для ведения автоматического огня\n\n"gbInfo"Используемые патроны: 9.19mm",3.0,{0.000000, -30.000000, 0.000000, 1.500000}}, // 337
	{18,"Винтовка",357,"Нарезное стрелковое оружие, конструктивно предназначенное для удержания и \nуправления при стрельбе двумя руками с упором приклада в плечо\n\n"gbInfo"Используемые патроны: 7.62mm", 5.0,{0.000000, -30.000000, 0.000000, 1.500000}}, // 338
