			        SendClientMessage(playerid, C_GRAY, ""gbError"Данное транспортное средство нельзя зарегистрировать.");
			        return 1;
			    }
			    default:
			    {
			        format( string, sizeof(string), "[%s%d%s]", str, Car::[i][cID], Getinic( Player[playerid][uName] )) ;
					strmid( Car::[i][cNumber], string, 0, strlen(string), 255 );
					
					if( IsValidDynamic3DTextLabel( Car::[i][cNumberLabel] ) )
					{
						UpdateDynamic3DTextLabelText( Car::[i][cNumberLabel], 0xFFFFFF60, string );
					}
					
					SetCarStr( Car::[i][cID], "cNumber", Car::[i][cNumber]);
					SetVehicleNumberPlate( i, Car::[i][cNumber] );
			    }
			}
			Player[playerid][uMoney] -= 300;
			mysql_format(1, string, sizeof(string),"UPDATE gb_users SET uMoney = '%d' WHERE BINARY uName = '%s'",Player[playerid][uMoney],Player[playerid][uName]);
			mysql_tquery(1, string, "", "");
			SendClientMessage(playerid, -1, ""gbAccess"Ваше транспортное средство успешно зарегистрировано.");
			DeletePVar(playerid, "SelectOrignFor");
			DeletePVar(playerid, "SelectOrign");
		}
