	//SetPVarInt(playerid,"ACPlayerCarID",vehicle);
	//GetVehiclePos(vehicle,vehPos[vehicle][0],vehPos[vehicle][1],vehPos[vehicle][2]);
	PutPlayerInVehicle(playerid,vehicle,seat);
	SetPVarInt(playerid, "PutHacking", 1);

}

stock GetPlayerSpeed(playerid) {
    new Float:Coord[4];
    GetPlayerVelocity(playerid, Coord[0], Coord[1], Coord[2]);
    Coord[3] = floatsqroot(floatpower(floatabs(Coord[0]), 2.0) + floatpower(floatabs(Coord[1]), 2.0) + floatpower(floatabs(Coord[2]), 2.0)) * 213.3;
    return floatround(Coord[3]);
}

stock SendRadioMessageForSubChanel(chanel, subchanel, text[])
{
    foreach(new i: Player)
	{

	    if(!IsPlayerConnected(i)) continue;
		//GetPVarInt(i,"uLogin") == 0)) continue;
	    if(Player[i][uRadioChanel] == chanel && Player[i][uRadioSubChanel] == subchanel) SendClientMessage(i, 0xE6E6B8AA, text);
	}
}

stock SendRadioMessage(chanel, text[])
{
	foreach(new i: Player)
	{
	
	    if(!IsPlayerConnected(i)) continue;
  		//GetPVarInt(i,"uLogin") == 0)) continue;
	    if(Player[i][uRadioChanel] == chanel) SendClientMessage(i, 0xFFFFCCAA, text);
	}
}

