			default: {
				V::[vehicleid][vInvSlot][0] = 433,V::[vehicleid][vInvSlot][1] = 433,V::[vehicleid][vInvSlot][2] = 434,V::[vehicleid][vInvSlot][3] = 435,V::[vehicleid][vInvSlot][4] = 436,V::[vehicleid][vInvSlot][5] = 437;
				V::[vehicleid][vInvSlotKol][0] = 1,V::[vehicleid][vInvSlotKol][1] = 1,V::[vehicleid][vInvSlotKol][2] = 1,V::[vehicleid][vInvSlotKol][3] = 1,V::[vehicleid][vInvSlotKol][4] = 1,V::[vehicleid][vInvSlotKol][5] = 1;
			}
		}
	}
	if(vehicleid >= medicalcar[0] && vehicleid <= medicalcar[1])
	{
		V::[vehicleid][vHealth] = 1000.0;
		V::[vehicleid][vFuel] = MaxVehicleFuel[GetVehicleModel(vehicleid) - 400];
		switch(GetVehicleModel(vehicleid))
		{
			case 416, 426, 482:
			{
				V::[vehicleid][vInvSlot][0] = 451,V::[vehicleid][vInvSlot][1] = 451,V::[vehicleid][vInvSlot][2] = 451,
				V::[vehicleid][vInvSlot][3] = 435,V::[vehicleid][vInvSlot][4] = 435,V::[vehicleid][vInvSlot][5] = 435,
				V::[vehicleid][vInvSlot][6] = 450,V::[vehicleid][vInvSlot][7] = 442;

				V::[vehicleid][vInvSlotKol][0] = 1,V::[vehicleid][vInvSlotKol][1] = 1,V::[vehicleid][vInvSlotKol][2] = 1,
				V::[vehicleid][vInvSlotKol][3] = 1,V::[vehicleid][vInvSlotKol][4] = 1,V::[vehicleid][vInvSlotKol][5] = 1,
				V::[vehicleid][vInvSlotKol][6] = 1,V::[vehicleid][vInvSlotKol][7] = 1;
			}
		}
	}
	
	if(vehicleid >= smicars[0] && vehicleid <= smicars[1]) {
		V::[vehicleid][vHealth] = 1000.0;
		V::[vehicleid][vFuel] = MaxVehicleFuel[GetVehicleModel(vehicleid) - 400];
		switch(GetVehicleModel(vehicleid)) {
			case 551: {
				V::[vehicleid][vInvSlot][0] = 341,V::[vehicleid][vInvSlot][1] = 341,V::[vehicleid][vInvSlot][2] = 341,V::[vehicleid][vInvSlot][3] = 341,V::[vehicleid][vInvSlot][4] = 434,V::[vehicleid][vInvSlot][5] = 435,V::[vehicleid][vInvSlot][6] = 437;
				V::[vehicleid][vInvSlotKol][0] = 100,V::[vehicleid][vInvSlotKol][1] = 100,V::[vehicleid][vInvSlotKol][2] = 100,V::[vehicleid][vInvSlotKol][3] = 100,V::[vehicleid][vInvSlotKol][4] = 2,V::[vehicleid][vInvSlotKol][5] = 1,V::[vehicleid][vInvSlotKol][6] = 1;
			}
			case 582: {
				V::[vehicleid][vInvSlot][0] = 341,V::[vehicleid][vInvSlot][1] = 341,V::[vehicleid][vInvSlot][2] = 434,V::[vehicleid][vInvSlot][3] = 435,V::[vehicleid][vInvSlot][4] = 437;
				V::[vehicleid][vInvSlotKol][0] = 100,V::[vehicleid][vInvSlotKol][1] = 100,V::[vehicleid][vInvSlotKol][2] = 2,V::[vehicleid][vInvSlotKol][3] = 1,V::[vehicleid][vInvSlotKol][4] = 1;
			}
		}
	}
	if(vehicleid >= meria[0] && vehicleid <= meria[1]) {
	    V::[vehicleid][vHealth] = 1000.0;
		V::[vehicleid][vFuel] = MaxVehicleFuel[GetVehicleModel(vehicleid) - 400];
	}
	if(vehicleid >= comm[0] && vehicleid <= comm[1])
	{
	    V::[vehicleid][vHealth] = 1000.0;
		V::[vehicleid][vFuel] = MaxVehicleFuel[GetVehicleModel(vehicleid) - 400];
	}
	SetVehicleParamsEx(vehicleid,eng,0,other1,other2,other3,other4,other5);

	return 1;
}

public OnPlayerDisconnect(playerid,reason)
{
    if( IsPlayerNPC( playerid ) ) 
		return 1;
		
    if( !GetPVarInt( playerid,"uLogin" ) ) 
		return 1;
	
    for(new i = 0; i < 17; i++)
	{
		PlayerTextDrawDestroy(playerid, AloginTextDraw[playerid][i]);
	}
	
    new Float:p[3];
	if(D::[playerid][dRentVehicleID]) SetVehicleToRespawn(D::[playerid][dRentVehicleID]), D::[playerid][dRentVehicleID] = -1;
	if( getData( playerid, "gym_id" ) ) {
	    GymData[ getData( playerid, "gym_id" ) - 1 ][gymStatus] = INVALID_PLAYER_ID;
	    delData( playerid, "gym_id" );
	}
	    
	if(GetPVarInt(playerid,"PutBoombox") >= 1) {
	  	foreach(new j: Player)
	  	{
	 		if(!GetPVarInt(j, "uLogin")) continue;
			if(IsPlayerInDynamicArea(j, GetPVarInt(playerid, "BBArea"))) StopAudioStreamForPlayer(j);
		}
		SetPVarInt(playerid, "PutBoombox", 0);
		DeletePVar(playerid, "BBArea");
		DeletePVar(playerid, "BBX"); DeletePVar(playerid, "BBY"); DeletePVar(playerid, "BBZ");
		DeletePVar(playerid, "BBStation");
		DeletePVar(playerid, "PutBoombox");
		DestroyDynamicObject(_objectInfo[GetPVarInt(playerid,"PutBoomboxID") - 1][objObject]);
	   	GivePlayerItem(playerid, _objectInfo[GetPVarInt(playerid,"PutBoomboxID") - 1][objDrop][0], _objectInfo[GetPVarInt(playerid,"PutBoomboxID") - 1][objDrop][1]);
	   	
	   	if (IsValidDynamic3DTextLabel(_objectInfo[GetPVarInt(playerid,"PutBoomboxID") - 1][objText]))
		{
	   		DestroyDynamic3DTextLabel(_objectInfo[GetPVarInt(playerid,"PutBoomboxID") - 1][objText]);
			_objectInfo[GetPVarInt(playerid,"PutBoomboxID") - 1][objText] = Text3D: INVALID_3DTEXT_ID;
		}
		
	   	DeletePVar(playerid, "PutBoomboxID");
		BoxUse[GetPVarInt(playerid,"PutBoomboxID")] = 0;
	}
    for(new i = 0; i < 20; i ++)
	{
	   	if(CallInfoList[i][cPlayerID] != playerid) continue;
 		CallInfoList[i][cPlayerID] = -1;
   		CallInfoList[i][cStatus] = false;
	  	break;
	}
	if(GetPVarInt(playerid, "ObjectFireStatus") >= 1)
	{
	    DestroyDynamicObject(GetPVarInt(playerid, "ObjectFireOne"));
	    DestroyDynamicObject(GetPVarInt(playerid, "ObjectFireTwo"));
	    DeletePVar(playerid, "ObjectFireOne");
	    DeletePVar(playerid, "ObjectFireTwo");
	    DeletePVar(playerid, "ObjectFireStatus");

	    DeletePVar(playerid, "ObjectFireX");
	    DeletePVar(playerid, "ObjectFireY");
	    DeletePVar(playerid, "ObjectFireZ");
	}
   
    HidePlayerProgressBar(playerid, universalbar[playerid]);
    DestroyPlayerProgressBar(playerid, universalbar[playerid]);
	if( Player[playerid][uSuspect] != 0 && GetPVarInt(playerid,"playerCuffed") != 0 || GetPVarInt(playerid,"follow") != INVALID_PLAYER_ID) {
        Player[playerid][uJail] = 2;
        Player[playerid][uJailTime] = Player[playerid][uSuspect] * 600;
        Player[playerid][uSuspect] = 0;
	}
    if(D::[playerid][dTaxiKey] != -1 && V::[D::[playerid][dTaxiKey]][vTaxiDriver] == playerid) {
        if(D::[playerid][dTaxiDuty] == true && D::[playerid][dArendTaxi] == 0 || D::[playerid][dArendTaxi] == -1) Player[playerid][uTaxiNoZp] = gettime();
		SetVehicleToRespawn(D::[playerid][dTaxiKey]);
    }
    if(D::[playerid][dDalnKey] != -1 && V::[D::[playerid][dDalnKey]][vDalnDriver] == playerid) {
        if(D::[playerid][dDalnDuty] == true && D::[playerid][dArendDaln] == 0 || D::[playerid][dArendDaln] == -1) Player[playerid][uDalnNoZp] = gettime();
		SetVehicleToRespawn(D::[playerid][dDalnKey]);
		for(new i;i<10;i++)
		{
			if(gTruckLoadTurn[0][i] == playerid) gTruckLoadTurn[0][i] = INVALID_PLAYER_ID;
		}
    }
    if(D::[playerid][dWoodsDuty] != 0) {
        RemovePlayerAttachedObject(playerid,9);
        D::[playerid][dWoodsDuty] = 0;
	    SetPVarInt(playerid,"TimerCountWoods",0);
        if(GetPVarInt(playerid,"WoodDrop")) {
        	new j = GetPVarInt(playerid,"WoodDrop");
            if(WD::[j][woodIsDrop] == false) {
        		WD::[j][woodIsDrop] = true;
         		WD::[j][woodUse] = false;
         		MoveDynamicObject(WD::[j][woodObject],WoodsDrop[j][0],WoodsDrop[j][1],WoodsDrop[j][2] - 0.05, 0.05, WoodsDrop[j][3],WoodsDrop[j][4],WoodsDrop[j][5]);
         	}
        }
    }
    if(PlayerTrailer[playerid] != -1) {
        V::[PlayerTrailer[playerid]][vWoods] = 0;
		V::[PlayerTrailer[playerid]][vMebel] = 0;
		V::[PlayerTrailer[playerid]][vToplivo] = 0;
	
		if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]))
		{
			DestroyDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]);
			V::[PlayerTrailer[playerid]][vTextTrailer] = Text3D: INVALID_3DTEXT_ID;
		}
		
    	DestroyVehicle(PlayerTrailer[playerid]);
			
		PlayerTrailer[playerid] = -1;
		SetPVarInt(playerid,"dettachTrailer",0);


	}
	
	if(Border::[playerid][bStatus] == true) {
		DestroyDynamicObject(Border::[playerid][bObjects]);
		Border::[playerid][bP][0] = 0.0;
		Border::[playerid][bP][1] = 0.0;
		Border::[playerid][bP][2] = 0.0;
		Border::[playerid][bStatus] = false;
		Border::[playerid][bMember] = 0;
	}
	if(GetPVarInt(playerid,"EffectGone")) KillTimer(GetPVarInt(playerid,"EffectGone"));
    if(GetPVarInt(playerid,"TimerStanok")) KillTimer(GetPVarInt(playerid,"TimerStanok"));
    if(GetPVarInt(playerid,"WoodsPlayer")) KillTimer(GetPVarInt(playerid,"WoodsPlayer"));

    if(GetPVarInt(playerid,"CountBackTaxi") != 0) SetPVarInt(playerid,"CountBackTaxi",0);
    if(GetPVarInt(playerid,"CountBackToBus") != 0) SetPVarInt(playerid,"CountBackToBus",0);
    if(GetPVarInt(playerid,"TimerCountWoods") != 0) SetPVarInt(playerid,"TimerCountWoods",0);
	if(GetPVarInt(playerid,"CountBackDaln") != 0) SetPVarInt(playerid,"CountBackDaln",0);

	if(GetPVarInt(playerid,"BizzBuyingCamera")) Bizz::[GetPVarInt(playerid,"BizzBuyingCamera")][bCamera] = false;
	if(GetPVarInt(playerid,"follow") != INVALID_PLAYER_ID) SetPVarInt(GetPVarInt(playerid,"follow"),"follow",INVALID_PLAYER_ID);
	if(GetPVarInt(playerid,"PlayerCameraHouse") == 1) {
		Player[playerid][uP][0] = GetPVarFloat(playerid,"HouseBuyX");
		Player[playerid][uP][1] = GetPVarFloat(playerid,"HouseBuyY");
		Player[playerid][uP][2] = GetPVarFloat(playerid,"HouseBuyZ");
		Player[playerid][uInt][0] = 1;
		Player[playerid][uInt][1] = 0;
		togglePlayerControllable(playerid,false);
	}
	if(GetPVarInt(playerid,"PlayerSelectedProducts") != 0) Product::[GetPVarInt(playerid,"PlayerSelectedProducts") - 1][bStatus] = false;
	if(GetPVarInt(playerid,"AdvertID") != -1) AD::[GetPVarInt(playerid,"AdvertID")][adUsed] = false;

	if(newsLeaderEther == playerid) {
		newsLeaderEther = INVALID_PLAYER_ID;
		EtherStatus = false;
	}
	if(newsClientEther == playerid) newsClientEther = INVALID_PLAYER_ID;

    if(IsPlayerInAnyVehicle(playerid)) GetVehiclePos(GetPlayerVehicleID(playerid),p[0],p[1],p[2]);
    else GetPlayerPos(playerid,p[0],p[1],p[2]);

    if(p[0] != 0.0) 
	{
	    mysql_format:vb_string( "UPDATE gb_users SET uP1 = '%f',uP2 = '%f',uP3 = '%f',uInt = '%d',uWorld = '%d' WHERE uID = %d",
			p[0],
			p[1],
			p[2],
			GetPlayerInterior( playerid ),
			GetPlayerVirtualWorld( playerid ),
			Player[playerid][uID]
		);
	    mysql_tquery( mysql, vb_string, "", "" );
    }

	mysql_format:vb_string( "UPDATE gb_users SET uSuspect = '%d',uNumber = '%d', uStatus = '0',\
	uMute = '%d',uHunger = '%d',uMoney = '%d',uJobDouble = '%d|%d|%d|%d|%d|%d|%d',uJailSettings = '%d|%d|%d|%d|%d', uDMJail = '%d', uBMute = '%d', uPayTime = '%d' WHERE BINARY uName = '%s'",
	Player[playerid][uSuspect], Player[playerid][uNumber], Player[playerid][uMute], Player[playerid][uHunger],
	Player[playerid][uMoney],Player[playerid][uJobDouble][0],Player[playerid][uJobDouble][1],Player[playerid][uJobDouble][2],Player[playerid][uJobDouble][3],Player[playerid][uJobDouble][4],
	Player[playerid][uJobDouble][5],Player[playerid][uJobDouble][6],Player[playerid][uJailSettings][0],Player[playerid][uJailSettings][1],Player[playerid][uJailSettings][2],
	Player[playerid][uJailSettings][3],Player[playerid][uJailSettings][4],Player[playerid][uDMJail],Player[playerid][uBMute], Player[playerid][uPayTime], Player[playerid][uName]);
	mysql_tquery( mysql, vb_string, "", "" );
	SaveInventory( playerid );

	nowUpdateInfo(playerid , "d" , "gb_users" , "uName" , "uJobValue" , Player[playerid][uJobValue]);
 	nowUpdateInfo(playerid , "d" , "gb_users" , "uName" , "ValueSt" , Player[playerid][uValueSt]);

	if(GetPVarInt(playerid, "BKONFORPLAYER") == 1)
	{
		BackupClear(playerid, 0);
		SetPVarInt(playerid, "BKONFORPLAYER", 0);
	}
	nowUpdateInfo(playerid, "d" , "gb_users" , "uName" , "uMoney" , Player[playerid][uMoney]);

	mysql_format:vb_string( "INSERT INTO `gb_sessions` (`uName`, `pIP`, `pSessionStart`, `pSessionEnd`) VALUES ('%s', '%s', '%d', '%d')", Player[playerid][uName], Player[playerid][uIP], GetPVarInt(playerid, "SessionStart"), gettime());
    mysql_tquery( mysql, vb_string, "", "");
	
	return 1;
}

public OnPlayerEditDynamicObject(playerid, objectid, response, Float:x, Float:y, Float:z, Float:rx, Float:ry, Float:rz) {
	clear_massive();
	if( objectid && getData( playerid, "dr_model" ) ) {
		if( response == EDIT_RESPONSE_FINAL || response == EDIT_RESPONSE_CANCEL ) {
			new i = getData( playerid, "dr_id" ), omodel = getData( playerid, "dr_model" );
			DestroyDynamicObject( getData( playerid, "dr_object" ) );
			//MoveDynamicObject( objectid, x, y, z, 10.0, rx, ry, rz );
			
			_objectInfo[i][objText] = CreateDynamic3DTextLabel( _itemsInfo[getData( playerid, "dr_name" )][invName], 0xFFFFFF50, x, y, z, 2.0, INVALID_PLAYER_ID, INVALID_VEHICLE_ID, 0, -1, GetPlayerVirtualWorld(playerid));
			_objectInfo[i][objObject] = CreateDynamicObject( omodel, x, y, z, rx, ry, rz, GetPlayerVirtualWorld(playerid) );
   			MeAction(playerid,"выкинул(-а) что-то на землю",1);
   			_objectInfo[i][objPos][0] = x;
		   	_objectInfo[i][objPos][1] = y;
	    	_objectInfo[i][objPos][2] = z + 1;
	    	DeletePVar( playerid, "dr_id" ), DeletePVar( playerid, "dr_model" ), DeletePVar( playerid, "dr_name" );
	    	printf("[TEST] %s выкинул %d", Player[playerid][uName], omodel );
		}
	}
	if(response == EDIT_RESPONSE_FINAL) {
	    if( GetPVarInt(playerid, "IsPlayerCreateObject") == 1 ) {
            if(!IsValidDynamicObject(objectid)) return SendClientMessage(playerid, C_GRAY, "Ошибка в системе. Обратитесь к администратору! [#0001]");
            MoveDynamicObject(objectid, x, y, z, 10.0, rx, ry, rz);
            new idi = GetPVarInt(playerid, "IDMassive_Object"), string[16];
            ObjList[idi][oModel] = GetPVarInt(playerid, "ObJectCreateID");
            ObjList[idi][Obj_X] = x;
            ObjList[idi][Obj_Y] = y;
            ObjList[idi][Obj_Z] = z;
            ObjList[idi][ObjRx] = rx;
            ObjList[idi][ObjRy] = ry;
            ObjList[idi][ObjRz] = rz;
            format( string, sizeof string, "[%d]", ObjList[idi][oID] );
            ObjList[idi][o3DText] = CreateDynamic3DTextLabel( string, 0xE6E6E6AA, x, y, z + 0.5, 3.0 );
	        SetPVarInt(playerid, "IsPlayerCreateObject", 0);
            cObjectS++;
        }
    }
    if(response == EDIT_RESPONSE_CANCEL)
    {
        if(GetPVarInt(playerid, "IsPlayerCreateObject") == 1)
        {
            new idi = GetPVarInt(playerid, "IDMassive_Object");
            DestroyDynamicObject(ObjList[idi][oObject]);
            ObjList[idi][oObject] = 0;
            ObjList[idi][Obj_X] = 0;
            ObjList[idi][Obj_Y] = 0;
            ObjList[idi][Obj_Z] = 0;
            ObjList[idi][ObjRx] = 0;
            ObjList[idi][ObjRy] = 0;
            ObjList[idi][ObjRz] = 0;
            ObjList[idi][oModel] = 0;
            SetPVarInt(playerid, "IsPlayerCreateObject", 0);
        }
    }
	return 0;
}



public OnPlayerCommandText(playerid, cmdtext[]) {
	return 0;//
}

public OnPlayerStreamIn(playerid, forplayerid) {
	if(Player[playerid][uSettings][3] == 1) ShowPlayerNameTagForPlayer(playerid,forplayerid,0);
	return 1;
}

public OnPlayerExitVehicle(playerid,vehicleid) 
{

    if(RadioVeh[vehicleid] != -1) StopAudioStreamForPlayer(playerid);
    if(vehicleid >= ataxils[0] && vehicleid <= ataxils[1]) {
		if(V::[vehicleid][vTaxiDriver] == playerid && D::[playerid][dTaxiKey] == vehicleid) {
			SetPVarInt(playerid,"CountBackTaxi",MAX_COUNT_BACK_TAXI);
			DisablePlayerCheckpoint(playerid);
			if(GetPVarInt(playerid,"SelectTaxiMarsh") == 1) DeletePVar(playerid,"SelectTaxiMarsh");
		}
	}
	if(vehicleid >= buscars[0] && vehicleid <= buscars[1]) {
	    if(Player[playerid][uJob] == 2 && D::[playerid][dBusDuty] == true) {
	        if(V::[vehicleid][vBusDriver] == playerid && D::[playerid][dBusKey] == vehicleid) {
	        	if(GetPVarInt(playerid,"BusToGo") != -1) {
					SetPVarInt(playerid,"CountBackToBus",MAX_COUNT_BACK_BUS);
					DisablePlayerRaceCheckpoint(playerid);
	        	}
			}
	    }
	}
	if(vehicleid >= dalncars[0] && vehicleid <= dalncars[1]) {
		if(V::[vehicleid][vDalnDriver] == playerid && D::[playerid][dDalnKey] == vehicleid) SetPVarInt(playerid,"CountBackDaln",MAX_COUNT_BACK_DALN);
	}
	StopAudioStreamForPlayer(playerid);
	return 1;
}

public OnPlayerStateChange(playerid, newstate, oldstate) 
{
	// TODO

    new car = GetPlayerVehicleID(playerid),string[256];
   	if(newstate == PLAYER_STATE_DRIVER || newstate == PLAYER_STATE_PASSENGER)
   	{
		if(RadioVeh[GetPlayerVehicleID(playerid)] != -1)
		{
			StopAudioStreamForPlayer(playerid); //АВТОШОУ
			if( RadioVeh [GetPlayerVehicleID(playerid)] == sizeof Radio ) {
			    PlayAudioStreamForPlayer(playerid, RadioVehStation[GetPlayerVehicleID(playerid)] );
			}
			else {
				PlayAudioStreamForPlayer(playerid, Radio [ RadioVeh [GetPlayerVehicleID(playerid)] ] [ 1 ] );
			}
		}
	}
    switch(newstate) {
		case PLAYER_STATE_DRIVER: {


		    SetPVarInt(playerid,"VehID",GetPlayerVehicleID(playerid));
		    if(!IsVelo(car)) {
            	UpdateVehicleHud(playerid);
				if(Player[playerid][uSettings][0] == 1) {
				    for(new i; i != 3; i++) TextDrawShowForPlayer(playerid, SpeedFon[i]);
					for(new i; i != 8; i++) PlayerTextDrawShow(playerid,Speed[i][playerid]);
					UpdateFuelBar(playerid,GetPlayerVehicleID(playerid));
				}
				else {
				    for(new i; i != 3; i++) TextDrawHideForPlayer(playerid, SpeedFon[i]);
					for(new i; i != 8; i++) PlayerTextDrawHide(playerid,Speed[i][playerid]);
				}
			}

			PlayerTextDrawSetString(playerid,Speed[6][playerid],"");
      		SendClientMessage( playerid ,-1, ""gbInfo"Завести двигатель - "cBLUE"CTRL"cWHITE" | Ограничитель скорости - "cBLUE"2"cWHITE"." );
      		if(car >= ataxils[0] && car <= ataxils[1]) {
				if(V::[car][vTaxiDriver] == playerid && D::[playerid][dTaxiKey] == car && D::[playerid][dTaxiDuty] == true && D::[playerid][dArendTaxi] != -1 || D::[playerid][dArendTaxi] != 0) SetPVarInt(playerid,"CountBackTaxi",0);
				else {
				    GetVehicleParamsEx(car,eng,light,other1,other2,other3,other4,other5);
				    SetVehicleParamsEx(car,false,light,other1,other2,other3,other4,other5);
				    return SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
				}
			}
			else if(car >= dalncars[0] && car <= dalncars[1]) {
			    if(V::[car][vDalnDriver] == playerid && D::[playerid][dDalnKey] == car && D::[playerid][dDalnDuty] == true) {
			    	if(!IsTrailerAttachedToVehicle(car) && GetVehicleModel(car) == 403 || GetVehicleModel(car) == 514 || GetVehicleModel(car) == 515) {
						SendClientMessage(playerid,C_GRAY,""gbInfo"Отправляйтесь на склад и возьмите прицеп. ( "cBLUE"/gps{ffffff} )");
					}
					if(GetVehicleModel(car) == 498 || GetVehicleModel(car) == 456 || GetVehicleModel(car) == 499 || GetVehicleModel(car) == 414 && V::[car][vProducts] == 0) {
						SendClientMessage(playerid,C_GRAY,""gbInfo"Отправляйтесь на склад и возьмите товар. ( "cBLUE"/gps{ffffff} )");
					}
			    }
				if(V::[car][vDalnDriver] == playerid && D::[playerid][dDalnKey] == car && D::[playerid][dDalnDuty] == true && D::[playerid][dArendTaxi] != -1 || D::[playerid][dArendTaxi] != 0) SetPVarInt(playerid,"CountBackDaln",0);
				else {
				    GetVehicleParamsEx(car,eng,light,other1,other2,other3,other4,other5);
				    SetVehicleParamsEx(car,false,light,other1,other2,other3,other4,other5);
				    return SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет ключей от данного транспорта!");
				}
			}
			else if(car >= lspdcars[0] && car <= lspdcars[1]) {
				if(Player[playerid][uMember] != 2 || Player[playerid][uIsPlayerJob][0] == 0) {
					GetVehicleParamsEx(car,eng,light,other1,other2,other3,other4,other5);
