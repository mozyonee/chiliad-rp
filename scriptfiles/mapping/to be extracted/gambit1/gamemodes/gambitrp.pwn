			if(!isNumeric(inputtext)) return showPlayerDialog(playerid,d_frac + 8,1," ","{ffffff}Введите введите новый номер должности:\n\n"cRED"| Должность может быть не меньше 1 и не больше 15.","Далее","Закрыть");
			if(!IsPlayerConnected(GetPVarInt(playerid,"playerSelectIDFrac"))) return SendClientMessage(playerid,C_GRAY,""gbError"Этот человек покинул штат, так что его должность нельзя изменить!");
			if(Player[GetPVarInt(playerid,"playerSelectIDFrac")][uMember] != Player[playerid][uMember]) return SendClientMessage(playerid,C_GRAY,""gbError"Этот человек не находится в вашей организации!");
			if(strval(inputtext) < 1 || strval(inputtext) > 15) return showPlayerDialog(playerid,d_frac + 8,1," ","{ffffff}Введите введите новый номер должности:\n\n"cRED"| Должность может быть не меньше 1 и не больше 15.","Далее","Закрыть");
			Player[GetPVarInt(playerid,"playerSelectIDFrac")][uRank] = strval(inputtext);
