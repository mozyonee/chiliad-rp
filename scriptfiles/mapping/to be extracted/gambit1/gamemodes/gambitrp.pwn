  			if(!strlen(inputtext)) return showPlayerDialog(playerid,d_police + 2,1," ","{ffffff}Введите в окошко номер своего транспорта:\n\n"cRED"| Номер транспорта может состоять только из цифр.\n| Если транспорт принадлежит не вам, оформелние номера будет недоступно.","Далее","Закрыть");
			if(!isNumeric(inputtext)) return showPlayerDialog(playerid,d_police + 2,1," ","{ffffff}Введите в окошко номер своего транспорта:\n\n"cRED"| Номер транспорта может состоять только из цифр.\n| Если транспорт принадлежит не вам, оформелние номера будет недоступно.","Далее","Закрыть");
