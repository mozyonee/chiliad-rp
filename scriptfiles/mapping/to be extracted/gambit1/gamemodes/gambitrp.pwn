		    if( Player[playerid][uMoney] < 300) 
				return SendClientMessage( playerid,C_GRAY, !NO_MONEY );
		    
			new i = GetPVarInt(playerid, "SelectOrignFor");
		    
		    switch(GetPVarInt(playerid, "SelectOrign"))
			{
			    case 0: format(str, sizeof(str), "LS");
			    case 1: format(str, sizeof(str), "RC");
			}
		    switch( Car::[i][cModel] )
			{
			    case 510, 509, 481:
