			if(Player[playerid][uID] == id) return SendClientMessage(playerid,C_GRAY,""gbError"Вы не можете уволить самого себя из организации!");
			if(F::[Player[playerid][uMember]][fRank][1] > Player[playerid][uRank]) return SendClientMessage(playerid,C_GRAY,""gbError"Ваш ранг не достаточен!");
			format(query,sizeof(query),"UPDATE gb_users SET uMember = '0',uRank = '0' WHERE uID = '%d'",id);
			mysql_tquery(1, query, "", "");
			SendClientMessage(playerid,C_GRAY,""gbAccess"Вы уволили своего сотрудника из организации!");
			foreach(new i : Player) {
				if(GetPVarInt(playerid,"uLogin") == 0) continue;
				if(Player[i][uID] == id) {
