		case d_frac + 3: {
			if(!response) return 1;
			if(!strlen(inputtext)) return showPlayerDialog(playerid,d_frac + 3,1," ","{ffffff}Введите новое название для этого ранга: \n\n"cRED"| Название может быть не меньше 1 и не больше 15 символов.\n| В название ранга запрещены любые символы и цифры.","Далее","Закрыть");
			if(isNumeric(inputtext)) return showPlayerDialog(playerid,d_frac + 3,1," ","{ffffff}Введите новое название для этого ранга: \n\n"cRED"| Название может быть не меньше 1 и не больше 15 символов.\n| В название ранга запрещены любые символы и цифры.","Далее","Закрыть");
			if(NonSym(inputtext,48,1)) return showPlayerDialog(playerid,d_frac + 3,1," ","{ffffff}Введите новое название для этого ранга: \n\n"cRED"| Название может быть не меньше 1 и не больше 15 символов.\n| В название ранга запрещены любые символы.","Далее","Закрыть");
			new rank = GetPVarInt(playerid,"playerSelectSlotRank");
			SendClientMessage(playerid,C_GRAY,""gbAccess"Вы успешно сменили название текущего ранга!");
			strmid(FRank[Player[playerid][uLeader]][rank], inputtext, 0, strlen(inputtext), 48);
			format(query,sizeof(query),"UPDATE gb_frac SET fRank%d = '%s' WHERE fID = '%d' LIMIT 1",rank + 1,FRank[Player[playerid][uLeader]][rank],Player[playerid][uLeader]);
			mysql_tquery(1, query, "", "");
