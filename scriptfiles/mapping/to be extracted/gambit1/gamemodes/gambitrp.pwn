				}
			}
			
			
			else if(car >= carsalon[0][0] && car <= carsalon[1][0]) 
			{
			    switch(V::[car][vRentCar][0])
			    {
			        case 0:
			        {
                        if(Player[playerid][uLicenses][0] == 0)
                        {
                            removePlayerFromVehicle(playerid);
