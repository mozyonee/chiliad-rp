			if(Player[playerid][uMoney] < strval(inputtext) * Bizz::[id][bSettings][5]) return SendClientMessage(playerid,C_GRAY,""gbError"У вас недостаточно средств для покупки топлива!");
			if(Bizz::[id][bSettings][3] < strval(inputtext))
			{
			    if(Bizz::[id][bRating] > 0) Bizz::[id][bRating]--;
			    SetBizzInt(Bizz::[id][bID],"bRate", Bizz::[id][bRating]);
			    return SendClientMessage(playerid,C_GRAY,""gbError"Простите, но на этой АЗС закончилось толиво!");
			}
			Player[playerid][uMoney] -= strval(inputtext) * Bizz::[id][bSettings][5];
			format(query,sizeof(query),"UPDATE gb_users SET uMoney = '%d' WHERE BINARY uName = '%s'",Player[playerid][uMoney],Player[playerid][uName]);
			mysql_tquery(1, query, "", "");
			Bizz::[id][bSettings][3] -= strval(inputtext);

			if(!strcmp(Bizz::[id][bOwner],"None",true)) {}
			else Bizz::[id][bSettings][6] += strval(inputtext) * Bizz::[id][bSettings][5];

			V::[GetPlayerVehicleID(playerid)][vFuel] += floatstr(inputtext);
			format(string,sizeof(string),"%d|%d|%d|%d|%d|%d|%d|%d",Bizz::[id][bSettings][0],Bizz::[id][bSettings][1],Bizz::[id][bSettings][2],
			Bizz::[id][bSettings][3],Bizz::[id][bSettings][4],Bizz::[id][bSettings][5],Bizz::[id][bSettings][6],Bizz::[id][bSettings][7]);
			SetBizzStr(Bizz::[id][bID],"bSettings",string);
			if(Bizz::[id][bRating] < 5000) Bizz::[id][bRating]++;
			SetBizzInt(Bizz::[id][bID],"bRate", Bizz::[id][bRating]);
		}
