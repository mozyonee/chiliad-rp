				}
				switch(Player[playerid][uMember]) {
				    case 1,2,3,5: {}
				    default: SetPlayerColor(playerid,FracColor[Player[playerid][uMember]]);
				}
				DeletePVar(playerid,"playerInviteFrac");
			}
			else {
				DeletePVar(playerid,"playerInviteFrac");
				SendClientMessage(playerid,C_GRAY,""gbError"Вы отказались вступать в организацию!");
			}
		}
		case d_frac + 10: {
			if(!response) return 1;
			switch(listitem) {
				case 0: showPlayerDialog(playerid,d_frac + 3,1," ","{ffffff}Введите новое название для этого ранга: \n\n"cRED"| Название может быть не меньше 1 и не больше 15 символов.\n| В название ранга запрещены любые символы и цифры.","Далее","Закрыть");
			}
		}
		case d_frac + 11: {
			if(!response) return 1;
			new rank = GetPVarInt(playerid,"playerSelectSlotRank");
