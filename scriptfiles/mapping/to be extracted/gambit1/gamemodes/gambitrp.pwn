stock GetBackSkinWork(playerid)
{
    SetPlayerSkin(playerid,F::[Player[playerid][uMember]][fSkins][Player[playerid][uRank] - 1]);
    SendClientMessage(playerid,C_GRAY,""gbAccess"Вы взяли свою форму из шкафчика!");
	if(GetPVarInt(playerid, "PlayerColor") == 1)
	{
	    SetPlayerColor(playerid,FracColor[0]);
	}
	else SetPlayerColor(playerid,FracColor[Player[playerid][uMember]]);
	MeAction(playerid,"переоделся(ась)",1);

	if(IsPlayerAttachedObjectSlotUsed(playerid, 4)) RemovePlayerAttachedObject(playerid, 4);
	if(IsPlayerAttachedObjectSlotUsed(playerid, 5)) RemovePlayerAttachedObject(playerid, 5);
}

stock GetBackSkin(playerid) 
{
	if(_itemsInfo[Inv[playerid][invSlot][52]][invObject] == 0) 
	{
	    if(Player[playerid][uSex] == 1) {
			if(Player[playerid][uColor] == 1) SetPlayerSkin(playerid,18);
			else if(Player[playerid][uColor] == 2) SetPlayerSkin(playerid,154);
		}
		else if(Player[playerid][uSex] == 2) {
		    if(Player[playerid][uColor] == 1) SetPlayerSkin(playerid,139);
			else if(Player[playerid][uColor] == 2) SetPlayerSkin(playerid,138);
		}
	}
	else SetPlayerSkin(playerid,_itemsInfo[Inv[playerid][invSlot][52]][invObject]);
}

stock RemoveWeapon(playerid, weaponid) {
    if(!IsPlayerConnected(playerid) || weaponid < 0 || weaponid > 50) return;
    new saveweapon[13], saveammo[13];
    for(new slot = 0; slot < 13; slot++) GetWeaponData(playerid, slot, saveweapon[slot], saveammo[slot]);
    ResetWeapons(playerid);
    for(new slot; slot !=12; slot++) {
        if(saveweapon[slot] == weaponid || saveammo[slot] == 0) continue;
        givePlayerWeapon(playerid, saveweapon[slot], saveammo[slot]);
    }
    givePlayerWeapon(playerid, 0, 1);
}

stock GetWeaponSlot(weaponid)
{
	switch(weaponid)
	{
		case 0, 1: return 0;
  		case 2..9: return 1;
  		case 22..24: return 2;
  		case 25..27: return 3;
  		case 28..29,32: return 4;
  		case 30,31: return 5;
  		case 33..34: return 6;
  		case 35..38: return 7;
  		case 16..18: return 8;
  		case 41..43: return 9;
  		case 10..15: return 10;
  		case 44..46: return 11;
  		case 40: return 12;
 	}
 	return false;
}

