		            showPlayerDialog(playerid, d_enterfrac + 5, 2, "Гардероб", "1. "cGRAY"Заступить на дежурство в рабочей одежде{ffffff}\n2. "cGRAY"Заступить на дежурство в гражданской одежде", "Далее", "Закрыть");
