			showPlayerDialog(strval(inputtext),d_frac + 9,0," ",string,"Далее","Закрыть");
			SendClientMessage(playerid,C_GRAY,""gbInfo"Вы пригласили кого-то в свою организацию, ожидайте ответа!");
