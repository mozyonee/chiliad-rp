			if(!response) return 1;
			SetPVarInt(playerid,"playerSelectSlotGun",listitem);
			showPlayerDialog(playerid,d_frac + 15,1," ","{ffffff}Введите новый ранг с которого будет разрешено данное оружие:\n\n"cRED"| Вводимый ранг может быть не меньше 1 и не больше 15.","Далее","Закрыть");
		}
		case d_frac + 15:
		{
			new slot = GetPVarInt(playerid,"playerSelectSlotGun");
			DeletePVar(playerid,"playerSelectSlotGun");
			if(!response) return 1;
			if(!strlen(inputtext)) return showPlayerDialog(playerid,d_frac + 15,1," ","{ffffff}Введите новый ранг с которого будет разрешено данное оружие:\n\n"cRED"| Вводимый ранг может быть не меньше 1 и не больше 15.","Далее","Закрыть");
			if(!isNumeric(inputtext)) return showPlayerDialog(playerid,d_frac + 15,1," ","{ffffff}Введите новый ранг с которого будет разрешено данное оружие:\n\n"cRED"| Вводимый ранг может быть не меньше 1 и не больше 15.","Далее","Закрыть");
			if(strval(inputtext) < 1 || strval(inputtext) > 15) return showPlayerDialog(playerid,d_frac + 15,1," ","{ffffff}Введите новый ранг с которого будет разрешено данное оружие:\n\n"cRED"| Вводимый ранг может быть не меньше 1 и не больше 15.","Далее","Закрыть");
			F::[Player[playerid][uMember]][fGuns][slot] = strval(inputtext);
			format(query,sizeof(query),"UPDATE gb_frac SET fGuns = '%d|%d|%d|%d|%d|%d' WHERE fID = '%d' LIMIT 1",F::[Player[playerid][uMember]][fGuns][0],
			F::[Player[playerid][uMember]][fGuns][1],F::[Player[playerid][uMember]][fGuns][2],F::[Player[playerid][uMember]][fGuns][3],F::[Player[playerid][uMember]][fGuns][4],F::[Player[playerid][uMember]][fGuns][5],Player[playerid][uLeader]);
			mysql_tquery(1, query, "", "");
