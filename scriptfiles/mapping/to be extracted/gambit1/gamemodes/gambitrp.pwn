			SendClientMessage(GetPVarInt(playerid,"playerSelectIDFrac"),C_GRAY,""gbAccess"Вам установили новую должность в организации!");
			format(query,sizeof(query),"UPDATE gb_users SET uRank = '%d' WHERE BINARY uName = '%s'",Player[GetPVarInt(playerid,"playerSelectIDFrac")][uRank],Player[GetPVarInt(playerid,"playerSelectIDFrac")][uName]);
