forward VehicleToPoint(Float:radi, vehicleid, Float:x, Float:y, Float:z);
public VehicleToPoint(Float:radi, vehicleid, Float:x, Float:y, Float:z) {
	new Float:oldposx, Float:oldposy, Float:oldposz;
	new Float:tempposx, Float:tempposy, Float:tempposz;
	GetVehiclePos(vehicleid, oldposx, oldposy, oldposz);
	tempposx = (oldposx -x);
	tempposy = (oldposy -y);
	tempposz = (oldposz -z);
	if (((tempposx < radi) && (tempposx > -radi)) && ((tempposy < radi) && (tempposy > -radi)) && ((tempposz < radi) && (tempposz > -radi))) return 1;
	return 0;
}

function ClearAnimationsDelay(playerid) ApplyAnimation(playerid,"ped","IDLE_chat",4.1,1,0,0,0,1,1);


function OnMinuteTimer() 
{
	callHouse();
    foreach (new playerid : Player) 
	{
		new afk = getData( playerid, "PlayerAFK");
    	if( Player[playerid][uMute] > 0) Player[playerid][uMute]--;
    	if( Player[playerid][uBMute] > 0) Player[playerid][uBMute]--;
	

		if( Player[playerid][uHunger] >= 1 && afk <= 0 && !GetAccessAdmin( playerid, 1 )) 
		{
			Player[playerid][uHunger]--;
			if( Player[playerid][uSettings][2] == 1 ) Hunger( playerid, 0 );
			else Hunger(playerid, Player[playerid][uHunger]);
		}
		else if( afk <= 0 ) 
		{
			setPlayerHealth( playerid, Player[playerid][uHP] - 2.0 );
		}
		
		if( afk > 2400 && !GetAccessAdmin( playerid, 1 ) ) 
		{ 
			AntiCheatKick( playerid, "AFK", true, false );
			continue;
		}
		
		if( GetPlayerState( playerid ) == PLAYER_STATE_DRIVER) UpdateFuelBar( playerid, GetPlayerVehicleID(playerid) );
		prisonTimer( playerid );
		PlayerCountMinute[playerid] ++;
		
		if( !IsAfk( playerid ) )
		{
			Player[playerid][uPayTime]++;
			if(Player[playerid][uPayTime] >= 60) 
			{
				payDay( playerid );
			}
		}
		
        if( D::[playerid][dRentVehicleTime] && D::[playerid][dRentVehicleID] ) {
			D::[playerid][dRentVehicleTime] --;
		 	if( D::[playerid][dRentVehicleTime] <= 0 ) {
		 	    SendMes( playerid, -1, ""gbInfo"Время аренды истекло, хотите продлить?");
				RemovePlayerFromVehicle(playerid);
				SetVehicleToRespawn(D::[playerid][dRentVehicleID]);
			}
		}
        if( Player[playerid][uDMJail] > 0 ) {
			Player[playerid][uDMJail]--;
			if( Player[playerid][uDMJail] == 0 ) {
				Player[playerid][uDMJail] = 0;
				nowUpdateInfo( playerid , "d" , "gb_users" , "uName" , "uDMJail" , Player[playerid][uDMJail] );
				SendClientMessage( playerid, C_GRAY, ""gbAccess"Вы отсидели свой срок в Де Моргане." );
				SetPlayerInterior( playerid, 0 );
				SetPlayerVirtualWorld( playerid, 0 );
				setPlayerPos( playerid, 1543.9922, -1669.7343, 13.5575 );
			}
		}
    }
	
    for(new i; i != MAX_VEHICLES; i ++) 
	{
    	if( !IsValidVehicle( i ) ) 
			continue;
			
    	GetVehicleParamsEx( i, eng, light, other1, other2, other3, other4, other5 );
		
    	if( eng == 1 ) 
		{
    		V::[i][vFuel] -= 0.5;
			
    		if( V::[i][vFuel] == 0.0 ) 
			{
				SetVehicleParamsEx( i, false, light, other1, other2, other3, other4, other5 );
			}
		}
		
    	if( IsBuyingCar( i ) ) 
		{
    	    if( Car::[ i ][cStatus][0] <= 20 ) 
			{
    			GetVehicleParamsEx( i, eng, light, other1, other2, other3, other4, other5 );
    			if( eng == 1 ) {
    				switch( random( 10 ) ) 
					{
    					case 0 .. 4: {}
    					case 5 .. 9: SetVehicleParamsEx( i, false, light, other1, other2, other3, other4, other5 );
    				}
    			}
    		}
    	}
    }
    if( countWoods != 10 ) countWoods ++;
	else {
	    countWoods = 0;
		for( new i; i != MAX_WOODS; i++ ) {
		    if( WD::[i][woodCount] <= 0 ) {
		        WD::[i][woodObject] = CreateDynamicObject( 660, Woods[i][0], Woods[i][1], Woods[i][2], Woods[i][3], Woods[i][4], Woods[i][5] );
		        WD::[i][woodUse] = false;
				WD::[i][woodIsDrop] = false;
				WD::[i][woodCount] = 100;
		    }
		}
	}
    if( countSave != 10 ) countSave ++;
	else {
	    countSave = 0;
	    S::[0][sProducts] += 100;
	    MebelZavod += 100;
	    WoodsZavod += 100;
	    ToplivoZavod += 1000;
	    S::[0][wsWoodsSklad] += 100;

	    if( ToplivoZavod >= MAX_FUEL_IN_ZAVOD ) ToplivoZavod = 100000;

	    format( gb_string, sizeof gb_string,"Завод мебели\n\n{ffffff}Мебель: %d ед.\nДревесины: %d ед.",MebelZavod,WoodsZavod);
		UpdateDynamic3DTextLabelText( InfoFermText[7], C_BLUE, gb_string );
	    format( gb_string, sizeof gb_string, "Нефтеперерабатывающий завод{ffffff}\n\nТопливо: %d л.",ToplivoZavod );
	    UpdateDynamic3DTextLabelText( InfoFermText[8], C_BLUE, gb_string );
	    format( gb_string, sizeof gb_string, "Обработанная древесина\n{ffffff}%d кг.",S::[0][wsWoodsSklad] );
	    UpdateDynamic3DTextLabelText( S::[0][wsWoodsTS][0], C_BLUE, gb_string );
	    UpdateDynamic3DTextLabelText( S::[0][wsWoodsTS][1], C_BLUE, gb_string );
		SaveAllProducts();
	}
}

function OnSecondTimer() 
{
	clear_massive();
    new string[128];
	new text[256];
	strcat(text,""cBLUE"Очередь на загрузку:{FFFFFF}");
	for(new i;i<10;i++)
	{
		if(gTruckLoadTurn[0][i] != INVALID_PLAYER_ID && !IsPlayerConnected(gTruckLoadTurn[0][i])) gTruckLoadTurn[0][i] = INVALID_PLAYER_ID;
		if(i != 9 && gTruckLoadTurn[0][i] == INVALID_PLAYER_ID && gTruckLoadTurn[0][i+1] != INVALID_PLAYER_ID) {gTruckLoadTurn[0][i] = gTruckLoadTurn[0][i+1]; gTruckLoadTurn[0][i+1] = INVALID_PLAYER_ID;}
		if(gTruckLoadTurn[0][i] != INVALID_PLAYER_ID) format(text,sizeof(text),"%s\n%d. %s",text,i+1,Player[gTruckLoadTurn[0][i]][uName]);
		else format(text,sizeof(text),"%s\n%d. -",text,i+1);
	}
	UpdateDynamic3DTextLabelText(gTruckLoadTurnText[0], -1, text);
	if(gTruckLoadTurn[0][0] != INVALID_PLAYER_ID)
	{
	    new playerid = gTruckLoadTurn[0][0];
		new Float:posv[3][6] = {
       		{-520.3046,-488.6065,26.5456,1019.3719, -325.2847, 74.4603},
       		{-529.7679,-488.5077,26.5385,-529.7606,-500.6951,25.6024},
       		{-557.5859,-488.8280,26.5471,-557.7141,-500.6195,25.6110}
    	};
		if(IsPlayerConnected(playerid))
		{
		    if(PlayerTrailer[playerid] != -1)
		    {
		        if(PlayerTrailerTime[playerid] && GetPVarInt(playerid,"waitgruz") == 2) PlayerTrailerTime[playerid]--;
          		else if(PlayerTrailerTime[playerid] < 1 && GetPVarInt(playerid,"waitgruz") == 2)
		        {

    				V::[PlayerTrailer[playerid]][vWoods] = 0;
					V::[PlayerTrailer[playerid]][vMebel] = 0;
					V::[PlayerTrailer[playerid]][vToplivo] = 0;
					
					if (IsValidDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]))
					{
			    		DestroyDynamic3DTextLabel(V::[PlayerTrailer[playerid]][vTextTrailer]);
						V::[PlayerTrailer[playerid]][vTextTrailer] = Text3D: INVALID_3DTEXT_ID;
					}	
		   			
					DestroyVehicle(PlayerTrailer[playerid]);
			    	
			    	SetPVarInt(playerid,"dettachTrailer",0);
			       	PlayerTrailer[playerid] = -1;
					DisablePlayerCheckpoint(playerid);
     				SendClientMessage(playerid,C_GRAY,""gbError"Вы оставили свой прицеп на месте аренды.");
			   		gTruckLoadTurn[0][0] = INVALID_PLAYER_ID;
                    SetPVarInt(playerid,"waitgruz",0);
				}
		    }
		    else
			{
			    SendClientMessage(playerid,-1,""gbInfo"Подошла очередь загрузки вашей фуры");
				SendClientMessage(playerid,-1,""gbInfo"После загрузки у Вас будет всего минута, чтобы прицепить её.");
				SetPVarInt(playerid,"waitgruz",2);
				PlayerTrailerTime[playerid] = 80;
				switch(GetPVarInt(playerid,"PlayerSelectTrailer"))
				{
					case 1: {
						PlayerTrailer[playerid] = CreateVehicle(435,posv[0][3],posv[0][4],posv[0][5],180.0000,1,1,-1);
						format(string,sizeof(string),"Мебель\n{ffffff}%d/%d ед.",V::[PlayerTrailer[playerid]][vMebel],MAX_MEBEL_IN_VEHICLE);
						SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,-18.9291,-273.3552,5.4297,5.0));
						SetPVarInt(playerid,"PlayerSelectTrailerTwo",1);
					}
					case 2: {
						PlayerTrailer[playerid] = CreateVehicle(584,posv[0][3],posv[0][4],posv[0][5],180.0000,1,1,-1);
						format(string,sizeof(string),"Топливо\n{ffffff}%d/%d л.",V::[PlayerTrailer[playerid]][vToplivo],MAX_FUEL_IN_VEHICLE);
						SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,248.2978,1420.6721,10.5727,5.0));
						SetPVarInt(playerid,"PlayerSelectTrailerTwo",2);
					}
					case 4: {
						PlayerTrailer[playerid] = CreateVehicle(450,posv[0][3],posv[0][4],posv[0][5],180.0000,1,1,-1);
						format(string,sizeof(string),"Древесина\n{ffffff}%d/%d кг.",V::[PlayerTrailer[playerid]][vWoods],MAX_WOODS_IN_VEHICLE);
						SetPVarInt(playerid,"PlayerDriverCheckpoint",_:SetPlayerCheckpoint(playerid,-496.0325,-82.4771,61.2981,5.0));
						SetPVarInt(playerid,"PlayerSelectTrailerTwo",4);
					}
		  			default: SendClientMessage(playerid,C_GRAY,""gbError"Вы должны выбрать хотя бы один из прицепов.");
				}
				V::[PlayerTrailer[playerid]][vTextTrailer] = CreateDynamic3DTextLabel(string,C_BLUE,0.0,0.0,0.0,20.0,INVALID_PLAYER_ID,PlayerTrailer[playerid],1);
    		}
    		if(!IsPlayerInDynamicArea(playerid, strZones[4]) && (gTruckLoadTurn[0][0] == playerid))
			{
			    if(GetVehicleTrailer(GetPlayerVehicleID(playerid)) == PlayerTrailer[playerid])
			    {
					gTruckLoadTurn[0][0] = INVALID_PLAYER_ID;
			        PlayerTrailerTime[playerid] = 0;
			    }
			}
		}
	}
	new hour,minuts,second;
    gettime(hour,minuts,second);
	if( hour == 5 ) {
	    if( minuts < 5 && second == 0 ) {
			format( text, sizeof text, "Уважаемые игроки! Через %d мин. произойдёт рестарт сервера!", 5 - minuts);
	        SendClientMessageToAll(C_ORANGE, text );
	    }
	    else if( minuts == 5 && second == 0 ) {
     		SendClientMessageToAll(C_ORANGE, "Уважаемые игроки! В данный момент происходит рестарт сервера. Пожалуйста, войдите через минуту!");
        	foreach(new i : Player) KickEx(i);
    		SetTimer("ModePlanRestart",30*1000,false);
    		closeserver = true;
	    }
	}
    
	if( ghour != hour ) 
	{
		OnBusinessUpdate();
		
		callHouse();
	}
	
	if( ghour != hour ) ghour = hour;
	
	callWeather();
    foreach( new i:Player) // TYT
	{
		if(!IsPlayerConnected(i)) continue;
		if(GetPVarInt(i,"uLogin") == 0) continue;
		if(IsKicked(i)) continue;
		user_update_weather[i]++;
		if( user_update_weather[i] > 160 ) user_update_weather[i] = 0, updateWeather( i );
		if( stop_time[i] > 0 ) {
			stop_time[i]--;
			if( stop_time[i] < 1 ) {
				TogglePlayerControllable( i, true );
			}
		}
		
		SetPVarInt(i,"PlayerAFK",GetPVarInt(i,"PlayerAFK") + 1);
		
		cctvTimer( i );
    	DeathTimer( i );
		walktimer( i );
		AntiCheatTimer( i );
		
		if(Player[i][uJailSettings][2] != 0) {
			if(Player[i][uJailSettings][3] != 0) {
				Player[i][uJailSettings][3] --;
    			format(string,sizeof(string),"%d",Player[i][uJailSettings][3]);
    			GameTextForPlayer(i, string, 2000, 6);
    			ApplyAnimation(i, "CRACK", "crckdeth2", 4.0, 1, 0, 0, 0, 0);
    			new Float:health;
    			GetPlayerHealth(i,health);
    			if(health < 100.0) setPlayerHealth(i,health + 5);
			}
			else {
				Player[i][uJailSettings][2] = 0;
				Player[i][uJailSettings][3] = 0;
				format(string,sizeof(string),"%d|%d|%d|%d|%d",Player[i][uJailSettings][0],Player[i][uJailSettings][1],Player[i][uJailSettings][2],Player[i][uJailSettings][3],Player[i][uJailSettings][4]);
				nowUpdateInfo(i , "s" , "gb_users" , "uName" , "uJailSettings" , string);
				ClearAnimations(i);
				SendClientMessage(i,C_GRAY,""gbAccess"Вас выписали из больницы!");
