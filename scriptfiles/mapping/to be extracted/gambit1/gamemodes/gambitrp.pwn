				togglePlayerControllable(i,true);
				spawnFreezeTime(i);
			 	SetPVarInt(i, "RepeatKill", 0);
			}
		}
		if( Player[i][uJail] ) {
			if( Player[i][uJailTime] ) Player[i][uJailTime]--;
