stock UpdateFuelBar(playerid,vehicleid)
{
	PlayerTextDrawTextSize(playerid,Speed[7][playerid], 295.0 + 62.0 * (V::[vehicleid][vFuel] / MaxVehicleFuel[GetVehicleModel(vehicleid) - 400]), 0.000000);
	PlayerTextDrawShow(playerid,Speed[7][playerid]);
}

stock NonSym( str[], max = 0, min = 0 ) 
{
	static 
		BadNameChars[][2] = {"/","\n","`","~","%","^","&","[","]","{","}","|","'"};
	
	for( new i = 0; i < sizeof( BadNameChars ); i++ ) 
	{
		if( strfind( str, BadNameChars[i], true ) != -1 || strlen( str ) > max || strlen( str ) < min ) 
			return 1;
	}
	
	return 0;
}

stock strreplace(string[], find, replace) 
{
	for(new i=0; string[i]; i++) {
		if(string[i] != find) continue;
		string[i] = replace;
	}
}

stock GetAvailableSeat(vehicleid, start = 1)
{
	new seats = GetVehicleMaxSeats(vehicleid);

	for (new i = start; i < seats; i ++) if (!IsVehicleSeatUsed(vehicleid, i)) {
	    return i;
	}
	return -1;
}

stock GetVehicleMaxSeats(vehicleid)
{
    static const g_arrMaxSeats[] = {
		4, 2, 2, 2, 4, 4, 1, 2, 2, 4, 2, 2, 2, 4, 2, 2, 4, 2, 4, 2, 4, 4, 2, 2, 2, 1, 4, 4, 4, 2,
		1, 7, 1, 2, 2, 0, 2, 7, 4, 2, 4, 1, 2, 2, 2, 4, 1, 2, 1, 0, 0, 2, 1, 1, 1, 2, 2, 2, 4, 4,
		2, 2, 2, 2, 1, 1, 4, 4, 2, 2, 4, 2, 1, 1, 2, 2, 1, 2, 2, 4, 2, 1, 4, 3, 1, 1, 1, 4, 2, 2,
		4, 2, 4, 1, 2, 2, 2, 4, 4, 2, 2, 1, 2, 2, 2, 2, 2, 4, 2, 1, 1, 2, 1, 1, 2, 2, 4, 2, 2, 1,
		1, 2, 2, 2, 2, 2, 2, 2, 2, 4, 1, 1, 1, 2, 2, 2, 2, 7, 7, 1, 4, 2, 2, 2, 2, 2, 4, 4, 2, 2,
		4, 4, 2, 1, 2, 2, 2, 2, 2, 2, 4, 4, 2, 2, 1, 2, 4, 4, 1, 0, 0, 1, 1, 2, 1, 2, 2, 1, 2, 4,
		4, 2, 4, 1, 0, 4, 2, 2, 2, 2, 0, 0, 7, 2, 2, 1, 4, 4, 4, 2, 2, 2, 2, 2, 4, 2, 0, 0, 0, 4,
		0, 0
	};
	new
	    model = GetVehicleModel(vehicleid);

	if (400 <= model <= 611)
	    return g_arrMaxSeats[model - 400];

	return 0;
}

stock IsVehicleSeatUsed(vehicleid, seat)
{
	foreach (new i : Player) if (IsPlayerInVehicle(i, vehicleid) && GetPlayerVehicleSeat(i) == seat) {
	    return 1;
	}
	return 0;
}

stock getDay(day = 0,month = 0, year = 0) {
	if(!day) getdate(year, month, day);
	new j, e, days;
	if (month <= 2) {
    	month += 12;
    	--year;
    }
    j = year % 100;
  	e = year / 100;
  	days = (day + (month + 1) * 26/10 + j + j/4 + e/4 - 2 * e) % 7;
	return days;
}

stock IsVehicleOccupied(vehicleid) {
	foreach(new i : Player) {
		if(IsPlayerInVehicle(i,vehicleid)) return 1;
	}
	return 0;
}

stock SendAdminMessageToAll( color, const message[], id = -1 ) {
	foreach(new i : Player) {
		if( getData( i, "uLogin" ) ) {
			if( Player[i][uSettings][5] == 1 || id == i ) SendClientMessage( i, color, message );
		}
	}
}

stock PlayerToKvadrat(playerid, Float:min_x, Float:min_y, Float:max_x, Float:max_y) {
    new Float:xxp,Float:yyp,Float:zzp;
    GetPlayerPos(playerid, xxp, yyp, zzp);
    if((xxp <= max_x && xxp >= min_x) && (yyp <= max_y && yyp >= min_y)) return true;
    return false;
}

stock IsPlayerInBandOnline(id) {
    foreach(new i : Player) {
        if(Player[i][uMemberGang] == id) return true;
    }
    return false;
}

stock spawnFreezeTime(playerid) {
	togglePlayerControllable(playerid,false);
	SetPVarInt(playerid,"playerFreezingTime",MAX_TIME_UNFREEZE_P);
}

stock togglePlayerControllable(playerid,bool:value) {
	if(value == false) SetPVarInt(playerid,"playerFreezing",0);
	else SetPVarInt(playerid,"playerFreezing",1);
    return TogglePlayerControllable(playerid,value);
}

stock sendLongMessage(playerid,message[], color1, color2, color3, color4, color5,Float:radius = 20.0,type = 0,prox = 1)
{
    new len = strlen(message),_iL = len / MAX_CHARS_PER_LINE;
    if( ( len % MAX_CHARS_PER_LINE ) ) _iL++;
    new _Line[MAX_CHARS_PER_LINE + 5];
    new _:_i@Index;
    while( _i@Index < _iL ) {
        if( _i@Index == 0 ) strmid( _Line, message, ( _i@Index * MAX_CHARS_PER_LINE ), ( _i@Index * MAX_CHARS_PER_LINE ) + MAX_CHARS_PER_LINE );
        else strmid( _Line, message, ( _i@Index * MAX_CHARS_PER_LINE ), ( _i@Index * MAX_CHARS_PER_LINE ) + MAX_CHARS_PER_LINE );

        #if defined FINAL_DOTS
        if( _iL > 1 ) {
            if( _i@Index == 0 ) format( _Line, sizeof _Line, "%s ...", _Line );
            else if( _i@Index > 0 && ( _i@Index + 1 ) < _iL ) format( _Line, sizeof _Line, "... %s ...", _Line );
            else format( _Line, sizeof _Line, "... %s", _Line );
        }
        #endif
		
		if( !prox )
		{
			SendClientMessage( playerid, color1, _Line );
		}
		else 
		{
			ProxDetector(radius, playerid, _Line,color1,color2,color3,color4,color5, type);
        }
		
		_i@Index++;
    }
    return 1;
}

stock GetIDfromName(name[]) {
	new string[128];
	format(string,sizeof(string),"SELECT uID FROM gb_users WHERE BINARY uName = '%s'",name);
    mysql_tquery(1, string, "MySQLQuery", "dd", 0, 32);
    return 1;
}

stock GetVehicleInfo(veh) {
	new id;
	for(new i; i != 85; i ++) {
	    if(CarsPrice[i][0] == GetVehicleModel(veh)) id = i;
	}
	return id;
}
public OnVehicleStreamIn(vehicleid, forplayerid) {
 	return 1;
}

public OnVehicleStreamOut(vehicleid, forplayerid) {
    return 1;
}

stock TurnPlayerFaceToPlayer(playerid, facingtoid)
{
    new Float:angle;
    new Float:misc = 5.0;
    new Float:x, Float:y, Float:z;
    new Float:ix, Float:iy, Float:iz;
    GetPlayerPos(facingtoid, x, y, z);
    GetPlayerPos(playerid, ix, iy, iz);
    angle = 180.0-atan2(ix-x,iy-y);
    angle += misc;
    misc *= -1;
    SetPlayerFacingAngle(playerid, angle+misc);
}


function MySQLQuery(playerid, type) {
	clear_massive();
	new data[120];
	new string[500], str[215];
	new Rows, Fields;
    cache_get_data(Rows, Fields);
	switch(type) 
	{   
	    case 5:
	    {
	        new BussinesOwner[32], BussinesName[32];
	        for(new j; j != Rows; j++)
	        {
	            //
	            cache_get_field_content(j, "bID", BussinesOwner, mysql), Bizz::[j][bID] = strval(BussinesOwner);
				cache_get_field_content(j, "bOwner", BussinesOwner, mysql);
				cache_get_field_content(j, "bName", BussinesName, mysql);

				cache_get_field_content(j, "bEnter", data, mysql), sscanf(data,"p<|>a<f>[7]",Bizz::[j][bEnter]);
				cache_get_field_content(j, "bUpdate", data, mysql), sscanf(data,"p<|>a<d>[3]",Bizz::[j][bUpdate]);
				cache_get_field_content(j, "bSettings", data, mysql), sscanf(data,"p<|>a<d>[8]",Bizz::[j][bSettings]);
				Bizz::[j][bBizzRent] = cache_get_field_content_int(j, "bBizzRent");
				Bizz::[j][SellDate] = cache_get_field_content_int(j, "SellDate");
				Bizz::[j][bOwnerID] = cache_get_field_content_int(j, "bOwnerID");
				Bizz::[j][bSellHour] = cache_get_field_content_int(j, "bSellHour"); // загружаем часы, когда бизнес должен слететь
                Bizz::[j][bRating] = cache_get_field_content_int(j, "bRate");

				strmid(Bizz::[j][bOwner], BussinesOwner, 0, strlen(BussinesOwner), 255);
				strmid(Bizz::[j][bName], BussinesName, 0, strlen(BussinesName), 255);
		    	switch(Bizz::[j][bSettings][7]) {
		    		case 0:{
		    			switch(Bizz::[j][bSettings][1]) {
		    				case 17:
							{
								CreateDynamicMapIcon(Bizz::[j][bEnter][0], Bizz::[j][bEnter][1], Bizz::[j][bEnter][2], 17, 0xFFFFFFFF, -1, -1, -1, 333.0);
							}
							case 5:
							{
								CreateDynamicMapIcon(Bizz::[j][bEnter][0], Bizz::[j][bEnter][1], Bizz::[j][bEnter][2], 29, 0xFFFFFFFF, -1, -1, -1, 333.0);
								Bizz::[j][bActor] = CreateActor(155, 375.3097,-117.2786,1001.4922,182.6519);
								SetActorVirtualWorld(Bizz::[j][bActor], Bizz::[j][bID]);
								CreateDynamic3DTextLabel("[ Продавец ]",0xFFFFFFFF,375.3097,-117.2786,1001.4922+1, 2.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, Bizz::[j][bID]);
							}
							case 9:
							{
								CreateDynamicMapIcon(Bizz::[j][bEnter][0], Bizz::[j][bEnter][1], Bizz::[j][bEnter][2], 14, 0xFFFFFFFF, -1, -1, -1, 333.0);
								Bizz::[j][bActor] = CreateActor(167, 368.6948,-4.4924,1001.8516,180.1452);
								SetActorVirtualWorld(Bizz::[j][bActor], Bizz::[j][bID]);
								CreateDynamic3DTextLabel("[ Продавец ]",0xFFFFFFFF,368.6948,-4.4924,1001.8516+1, 2.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, Bizz::[j][bID]);
							}
							case 10:
							{
								CreateDynamicMapIcon(Bizz::[j][bEnter][0], Bizz::[j][bEnter][1], Bizz::[j][bEnter][2], 10, 0xFFFFFFFF, -1, -1, -1, 333.0);
								Bizz::[j][bActor] = CreateActor(205, 376.5307,-65.8494,1001.5078,177.9750);
								SetActorVirtualWorld(Bizz::[j][bActor], Bizz::[j][bID]);
								CreateDynamic3DTextLabel("[ Продавец ]",0xFFFFFFFF,376.5307,-65.8494,1001.5078+1, 2.0, INVALID_PLAYER_ID,INVALID_VEHICLE_ID, Bizz::[j][bID]);
							}
