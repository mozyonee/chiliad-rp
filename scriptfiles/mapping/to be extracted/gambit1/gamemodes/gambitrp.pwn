						showPlayerDialog(playerid, d_bizz + 34, DIALOG_STYLE_INPUT, "Аренда транспорта", string, "Далее", "Отмена");
			        }
			        case 1:
			        {
			            if(D::[playerid][dRentVehicleID] == car) { }
			            else
			            {
			                SendClientMessage(playerid, -1, ""gbError"Данный транспорт уже кто-то арендует.");
			 				removePlayerFromVehicle(playerid);
			            }
					}
			    }
			}
			else if(car >= carsalon[0][2] && car <= carsalon[1][2]) {
			    switch(V::[car][vRentCar][0])
			    {
			        case 0:
			        {
			            if(Player[playerid][uLicenses][2] == 0)
                        {
                            removePlayerFromVehicle(playerid);
						 	SendClientMessage(playerid,C_GRAY,""gbError"У Вас нет лицензии на воздушный транспорт!");
						 	return 1;
						}
			            if(D::[playerid][dRentVehicleID] > 0 && D::[playerid][dRentVehicleTime] != 0)
						{
						    removePlayerFromVehicle(playerid);
					 		SendClientMessage(playerid, -1, ""gbError"Вы уже арендуете транспорт");
					 		return 1;
						}
			            SetPVarInt(playerid, "rent_veh", car);
			            SetPVarInt(playerid, "rent_bizz", 85);
			            SetPVarInt(playerid, "rent_price", Bizz::[85][bSettings][5]*ProdVehicleLal(GetPlayerVehicleID(playerid)));
						format(string, sizeof(string), "{ffffff}Вы можете арендовать это транспортное средство на время.\n\nСтоимость аренды для данного ТС: "cGREEN"$%i/минут\n\nВведите, на сколько минут Вы хотите арендовать данное ТС:", Bizz::[85][bSettings][5]*ProdVehicleLal(GetPlayerVehicleID(playerid)));
						showPlayerDialog(playerid, d_bizz + 34, DIALOG_STYLE_INPUT, "Аренда транспорта", string, "Далее", "Отмена");
			        }
			        case 1:
