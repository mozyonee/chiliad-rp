stock SetBizzInt(idx, stolb[], znach) {
	new Query[128];
	format(Query, sizeof(Query), "UPDATE gb_business SET %s = '%d' WHERE bID = '%d'", stolb, znach, idx);
	return mysql_tquery(1, Query, "", "");
}
