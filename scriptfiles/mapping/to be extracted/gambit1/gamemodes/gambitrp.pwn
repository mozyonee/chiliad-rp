						format(string, sizeof(string), "{ffffff}Вы можете арендовать это транспортное средство на время.\n\n"gbInfo"Стоимость аренды для данного ТС: "cGREEN"$%i/минута\n\n"gbInfo"Введите, на сколько минут Вы хотите арендовать данное ТС:", Bizz::[84][bSettings][5]*ProdVehicleLal(GetPlayerVehicleID(playerid)));
						showPlayerDialog(playerid, d_bizz + 34, DIALOG_STYLE_INPUT, "Аренда транспорта", string, "Далее", "Отмена");
			        }
			        case 1:
			        {
			            if(D::[playerid][dRentVehicleID] == car) { }
			            else
			            {
			                SendClientMessage(playerid, -1, ""gbError"Данный транспорт уже кто-то арендует.");
			 				removePlayerFromVehicle(playerid);
			            }
					}
			    }
			}
			else if(car >= carsalon[0][1] && car <= carsalon[1][1]) {
			    switch(V::[car][vRentCar][0])
			    {
			        case 0:
			        {
			            if(Player[playerid][uLicenses][0] == 0)
                        {
                            removePlayerFromVehicle(playerid);
						 	SendClientMessage(playerid,C_GRAY,""gbError"У вас нет водительских удостоверений!");
						 	return 1;
						}
			            if(D::[playerid][dRentVehicleID] > 0 && D::[playerid][dRentVehicleTime] != 0)
						{
						    removePlayerFromVehicle(playerid);
					 		SendClientMessage(playerid, -1, ""gbError"Вы уже арендуете транспорт");
