	{1,"Кастет",331,"Контактное оружие ближнего боя.\nСпособное нанести тяжёлые увечья.",0.5,{0.000000, -30.000000, 0.000000, 1.500000}}, // 321
	{2,"Пол. дубинка",334,"Несмертельное оружие,спецсредство,используемое правоохранительными,охранными органами и силовыми структурами.",1.0,{0.000000, -30.000000, 0.000000, 1.500000}}, // 322
	{3,"Нож",335,"Холодное оружие способное наносить режущие и колотые раны.",0.3,{0.000000, -30.000000, 0.000000, 1.500000}}, // 323
	{4,"Бейсб. бита",336,"Бита выполнена в виде круглого в сечении стержня.\nИгрок удерживает биту в её самой тонкой части.\nБита равномерно утолщается, достигая максимальной толщины в части, используемой для удара", 1.0,{0.000000, -30.000000, 0.000000, 1.500000}}, // 324
	{5,"Лопата",337,"Ручной инструмент для работы с грунтом.",2.0,{0.000000, -30.000000, 0.000000, 1.500000}}, // 325
