		for(new i; i != cBizz; i++)
		{
			if(IsPlayerInRangeOfPoint(playerid,1.0,Bizz::[i][bEnter][0],Bizz::[i][bEnter][1],Bizz::[i][bEnter][2]))
			{
				if(Bizz::[i][bSettings][4] == 1) return SendClientMessage(playerid,C_GRAY,""gbError"В этом бизнесе закрыта входная дверь.");
				if(Bizz::[i][bSettings][7] == 12)
				{
					switch(Bizz::[i][bID])
					{
					    case 87: SetPlayerFightingStyle(playerid, FIGHT_STYLE_BOXING);
						case 88: SetPlayerFightingStyle(playerid, FIGHT_STYLE_KUNGFU);
						case 89: SetPlayerFightingStyle(playerid, FIGHT_STYLE_KNEEHEAD);
						
					}
					SetPVarInt(playerid, "StartTraining", 1);
				}
				setPlayerPos(playerid,Bizz::[i][bEnter][4],Bizz::[i][bEnter][5],Bizz::[i][bEnter][6]);
				SetPlayerInterior(playerid,Bizz::[i][bSettings][1]);
			    SetPlayerVirtualWorld(playerid,Bizz::[i][bID]);
			    spawnFreezeTime(playerid);
				SetPVarInt(playerid,"PlayerBizzID",i);
				SetPlayerTime(playerid, 88, 0);
				break;
			}
			else if(IsPlayerInRangeOfPoint(playerid,1.0,Bizz::[i][bEnter][4],Bizz::[i][bEnter][5],Bizz::[i][bEnter][6]) && GetPlayerVirtualWorld(playerid) == Bizz::[i][bID]) {
				if(Bizz::[i][bSettings][4] == 1) return SendClientMessage(playerid,C_GRAY,""gbError"В этом бизнесе закрыта входная дверь.");
				if(Bizz::[i][bSettings][7] == 12)
				{
				    new s = GetPlayerSkin(playerid);
					if(s == 96 || s == 80 || s == 81 || s == 203 || s == 204 || s == 190 || s == 298) GetBackSkin(playerid), SendClientMessage(playerid,C_GRAY,""gbAccess"Вы покинули спортзал, вам возвращена повседневная одежда");
					SetPVarInt(playerid, "StartTraining", 0), SetPVarInt(playerid, "StartTrainingTwo", 0), SetPlayerFightingStyle(playerid, FIGHT_STYLE_NORMAL);
				}
				setPlayerPos(playerid,Bizz::[i][bEnter][0],Bizz::[i][bEnter][1],Bizz::[i][bEnter][2]);
				SetPlayerInterior(playerid,0);
			    SetPlayerVirtualWorld(playerid,0);
			    SetPlayerTime(playerid, ghour+3, 0);
				break;
			}
		}
		for(new i; i != MAX_OBJECTS_DROP; i ++) {
		    if(_objectInfo[i][objDrop][0] == 0) continue;
		    if(IsPlayerInRangeOfPoint(playerid, 1.0,_objectInfo[i][objPos][0],_objectInfo[i][objPos][1],_objectInfo[i][objPos][2])) {
		        new Float:kg;
		        for(new g; g != 56; g++) kg += _itemsInfo[Inv[playerid][invSlot][g]][invKg];
				if(kg + _itemsInfo[_objectInfo[i][objDrop][0]][invKg] > MAX_PLAYER_KG + Player[playerid][uJobDouble][6]) return SendClientMessage(playerid,C_GRAY,""gbError"Вы уже и так много несёте с собой!");
				if(BoxUse[i] == 1 && _objectInfo[i][objDrop][0] == 469) {
					if(GetPVarInt(playerid, "PutBoomboxID") != i + 1) return SendClientMessage(playerid,C_GRAY,""gbError"Вам не пренадлежит этот BoomBox!");
	                else
					{
					    foreach(new j: Player)
					    {
					        if(!GetPVarInt(j, "uLogin")) continue;
							if(IsPlayerInDynamicArea(j, GetPVarInt(playerid, "BBArea"))) StopAudioStreamForPlayer(j);
						}
						SetPVarInt(playerid, "PutBoombox", 0);
						DeletePVar(playerid, "BBArea");
						DeletePVar(playerid, "BBX"); DeletePVar(playerid, "BBY"); DeletePVar(playerid, "BBZ");
						DeletePVar(playerid, "BBStation");
						DeletePVar(playerid, "PutBoomboxID");
						DeletePVar(playerid, "PutBoombox");
						BoxUse[i] = 0;
					}
				}
				DestroyDynamicObject(_objectInfo[i][objObject]);
                GivePlayerItem(playerid, _objectInfo[i][objDrop][0], _objectInfo[i][objDrop][1]);
				
                if (IsValidDynamic3DTextLabel(_objectInfo[i][objText]))
				{
                	DestroyDynamic3DTextLabel(_objectInfo[i][objText]);
					_objectInfo[i][objText] = Text3D: INVALID_3DTEXT_ID;
				}
				
                _objectInfo[i][objDrop][0] = 0;
	            _objectInfo[i][objDrop][1] = 0;
	            _objectInfo[i][objPos][0] = 0.0;
	            _objectInfo[i][objPos][1] = 0.0;
	            _objectInfo[i][objPos][2] = 0.0;
				break;
		    }
		}
		if(GetPVarInt(playerid, "ObjectFireStatus") >= 1)
		{
		    if(IsPlayerInRangeOfPoint(playerid, 5.0, GetPVarFloat(playerid, "ObjectFireX"), GetPVarFloat(playerid, "ObjectFireY"), GetPVarFloat(playerid, "ObjectFireZ"))) {
		        DestroyDynamicObject(GetPVarInt(playerid, "ObjectFireOne"));
			    DestroyDynamicObject(GetPVarInt(playerid, "ObjectFireTwo"));
			    DeletePVar(playerid, "ObjectFireOne");
			    DeletePVar(playerid, "ObjectFireTwo");
			    DeletePVar(playerid, "ObjectFireStatus");
			    DeletePVar(playerid, "ObjectFireX");
			    DeletePVar(playerid, "ObjectFireY");
			    DeletePVar(playerid, "ObjectFireZ");
			    SendClientMessage(playerid, -1, ""gbAccess"Вы успешно потушили свой кастер");
		    }
		}
		
		foreach(new i : Player)
		{
			if(Border::[i][bStatus] == false) continue;
			if(IsPlayerInRangeOfPoint(playerid, 3.0, Border::[i][bP][0], Border::[i][bP][1], Border::[i][bP][2]))
			{
			    if(Border::[i][bMember] != Player[playerid][uMember]) return 1;
				switch(Border::[i][bObject])
				{
					case 2899: GivePlayerItem(playerid,436,1);
					case 1237: GivePlayerItem(playerid,438,1);
					case 1423: GivePlayerItem(playerid,439,1);
					case 1425: GivePlayerItem(playerid,440,1);
					case 1459: GivePlayerItem(playerid,441,1);
					case 1481: GivePlayerItem(playerid,471,1);
					case 1255: GivePlayerItem(playerid,478,1);
					case 1646: GivePlayerItem(playerid,479,1);
				}
				DestroyDynamicObject(Border::[i][bObjects]);
				Border::[i][bP][0] = 0.0;
				Border::[i][bP][1] = 0.0;
				Border::[i][bP][2] = 0.0;
				Border::[i][bStatus] = false;
				Border::[i][bMember] = 0;
				break;
			}
		}
	}
	return 1;
}

public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid) {
    clear_massive();
	if(playertextid == FermSelectSkin[0][playerid])
	{
		if(D::[playerid][dWoodsDuty] != 0) {
		    switch(Player[playerid][uSex]) {
		        case 1: SetPlayerSkin(playerid,16);
		        case 2: SetPlayerSkin(playerid,13);
		    }
		    if(D::[playerid][dWoodsDuty] == 1) {
		    	SetPlayerAttachedObject(playerid,9,341,6);
				SetPVarInt(playerid,"PlayerUseBox",4);
				return SendClientMessage(playerid,C_GRAY,""gbInfo"Подойдите к одному из деревьев и начните спиливать его.");
			}
		    if(D::[playerid][dWoodsDuty] == 2) return SendClientMessage(playerid,C_GRAY,""gbInfo"Идите в цех и начните перерабатывать древесину.");
		}
		if(Player[playerid][uMember] == 3)
		{
		    switch(Player[playerid][uSex]) {
		        case 1: SetPlayerSkin(playerid, 277);
			}
			SetPlayerAttachedObject(playerid,4,19472,2,0.000000,0.159999,0.001999,88.099952,84.499992,2.000000,1.000000,1.000000,1.000000);
			SetPlayerAttachedObject(playerid,5,1008,1,0.000000,-0.093000,0.000000,-93.800010,-179.000000,1.499997,1.000000,1.000000,1.000000);

		}
	}

	if(playertextid == FermSelectSkin[1][playerid]) {
		if(D::[playerid][dWoodsDuty] != 0) {
		    switch(Player[playerid][uSex]) {
		        case 1: SetPlayerSkin(playerid,27);
		        case 2: SetPlayerSkin(playerid,56);
		    }
		    if(D::[playerid][dWoodsDuty] == 1) {
		    	SetPlayerAttachedObject(playerid,9,341,6);
				SetPVarInt(playerid,"PlayerUseBox",4);
				return SendClientMessage(playerid,C_GRAY,""gbInfo"Подойдите к одному из деревьев и начните спиливать его.");
			}
		    if(D::[playerid][dWoodsDuty] == 2) return SendClientMessage(playerid,C_GRAY,""gbInfo"Идите в цех и начните перерабатывать древесину.");
		}
		if(Player[playerid][uMember] == 3)
		{
		    switch(Player[playerid][uSex]) {
		        case 1: SetPlayerSkin(playerid, 278);
			}
			SetPlayerAttachedObject(playerid,4,19472,2,-0.016000,0.146999,-0.003999,94.600013,99.900039,-4.199994,1.000000,1.000000,1.000000);
			SetPlayerAttachedObject(playerid,5,1008,1,0.040999,-0.114999,0.000000,105.599998,0.000000,-177.499954,1.000000,1.000000,1.000000);

		}
	}
	
	if(GetPVarInt(playerid, "GuperOnSelect") == 1) {
		callPrisonSkin( playerid, playertextid );
	}    
	if(GetPVarInt(playerid, "GuperOnSelect") == 2)
	{
	    for(new i; i < 12; i++)
	    {
            if(GYMSkins[0][i] == 0) continue;
	        if(playertextid == NewSkinSelect[i][playerid])
	        {
	            if(i == 5 || i == 6) { if(Player[playerid][uSex] == 1) return SendClientMessage(playerid, -1, ""gbError"Данная одежда для Вас недоступна"); }

	            SetPlayerSkin(playerid, GYMSkins[0][i]);
	            SetPVarInt(playerid, "StartTrainingTwo", 1);
	            break;
	        }
	    }
	}
	if( getData( playerid, "GuperOnSelect" ) == 8 ) callSasdSkin( playerid, playertextid );
// Vovanm93
	if( getData( playerid, "GuperOnSelect" ) == 3 ) {
		for( new i; i < 12; i++ ) {
			if( playertextid == NewSkinSelect[i][playerid] ) {
				if( Player[playerid][uSex] == 1 ) {
					SetPlayerSkin( playerid, MedicalSkinList[i] );
					Player[playerid][uJobSkin] = MedicalSkinList[i];
				}
				else {
					SetPlayerSkin( playerid, MedicalSkinListMale[i] );
					Player[playerid][uJobSkin] = MedicalSkinListMale[i];
				}
				format:gb_string( "%s", Player[playerid][uSex] == 1 ? ("переоделся"):("переоделась") );
				MeAction( playerid, gb_string, 1 );
				
				Player[playerid][uIsPlayerJob][1] = 1;
				userUpdate( playerid, "uJobSkin", Player[playerid][uJobSkin] );
    			if( getData( playerid, "PlayerColor") == 1 ) SetPlayerColor( playerid, FracColor[0] );
				else SetPlayerColor( playerid, FracColor[ Player[playerid][uMember] ] );
				
				SendClientMessage( playerid,C_GRAY,""gbAccess"Вы успешно вышли на дежурство.");
				break;
			}
		}
	}
	
	if( getData( playerid, "GuperOnSelect" ) == 5 ) {
		for( new i; i < 12; i++ ) {
			if( playertextid == NewSkinSelect[i][playerid] ) {
				if( Player[playerid][uSex] == 1 ) {
					SetPlayerSkin( playerid, police_skin_male[i] );
					Player[playerid][uJobSkin] = police_skin_male[i];
				}
				else {
					SetPlayerSkin( playerid, police_skin_female[i] );
					Player[playerid][uJobSkin] = police_skin_female[i];
				}
				
				format:gb_string( "%s", Player[playerid][uSex] == 1 ? ("переоделся"):("переоделась") );
				MeAction( playerid, gb_string, 1 );
				Player[playerid][uIsPlayerJob][0] = 1;
				UpdatePlayerJob( playerid );
				userUpdate( playerid, "uJobSkin", Player[playerid][uJobSkin] );
    			if( getData( playerid, "PlayerColor") == 1 ) SetPlayerColor( playerid, FracColor[0] );
				else SetPlayerColor( playerid, FracColor[ Player[playerid][uMember] ] );
				break;
			}
		}
	}
//-----------------------------------	
	if(playertextid == FermSelectSkin[2][playerid]) {
		if(D::[playerid][dWoodsDuty] != 0) {
		    switch(Player[playerid][uSex]) {
		        case 1: SetPlayerSkin(playerid,260);
		        case 2: SetPlayerSkin(playerid,131);
		    }
		    if(D::[playerid][dWoodsDuty] == 1) {
		    	SetPlayerAttachedObject(playerid,9,341,6);
				SetPVarInt(playerid,"PlayerUseBox",4);
				return SendClientMessage(playerid,C_GRAY,""gbInfo"Подойдите к одному из деревьев и начните спиливать его.");
			}
		    if(D::[playerid][dWoodsDuty] == 2) return SendClientMessage(playerid,C_GRAY,""gbInfo"Идите в цех и начните перерабатывать древесину.");
		}
		if(Player[playerid][uMember] == 3)
		{
		    switch(Player[playerid][uSex]) {
		        case 1: SetPlayerSkin(playerid, 279);
			}
			SetPlayerAttachedObject(playerid,4,19472,2,-0.025000,0.157000,0.000999,-2.499999,89.799911,90.799964,1.212000,1.106000,1.231000);
			SetPlayerAttachedObject(playerid,5,1008,1,0.024000,-0.110999,0.000000,-90.500007,-179.199951,0.700001,1.000000,1.000000,1.000000);

		}
	}
	for(new i = 0; i < 16; i++) {
		if(playertextid != buyingShopItems[i][playerid]) continue;
		if(playertextid == buyingShopItems[i][playerid]) {
			SetPVarInt(playerid,"playerSelectBuyingSlot",i);
			new Float:kg,string[256];
    		for(new k; k != 56; k++) kg += _itemsInfo[Inv[playerid][invSlot][k]][invKg];
			switch(GetPVarInt(playerid,"UseSlots"))
			{
				case 3:
				{
					if(kg + _itemsInfo[Bizz::[GetPVarInt(playerid,"PlayerBizzID")][bItems][GetPVarInt(playerid,"playerSelectBuyingSlot")]][invKg] > MAX_PLAYER_KG + Player[playerid][uJobDouble][6]) return SendClientMessage(playerid,C_GRAY,""gbError"Вы уже и так много несёте с собой!");
					if(IsPlayerInRangeOfPoint(playerid,3.0,203.8694,-43.2627,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,207.0882,-129.1814,1003.5078) ||
	    			IsPlayerInRangeOfPoint(playerid,3.0,161.4221,-83.2581,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,206.3741,-8.1361,1001.2109) ||
	    			IsPlayerInRangeOfPoint(playerid,3.0,204.3264,-159.3523,1000.5234) || IsPlayerInRangeOfPoint(playerid,3.0,207.6243,-100.3268,1005.2578) ||
	    			IsPlayerInRangeOfPoint(playerid,3.0,210.1204,-102.2575,1005.2578) || IsPlayerInRangeOfPoint(playerid,3.0,210.5399,-34.1924,1001.9297) || IsPlayerInRangeOfPoint(playerid,3.0,206.9977,-135.6739,1002.8744) ||
	    			IsPlayerInRangeOfPoint(playerid,3.0,150.9207,-75.5895,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,211.3265,-9.5800,1001.2109) || IsPlayerInRangeOfPoint(playerid,3.0,198.8070,-157.5421,1000.5234) ||
	    			IsPlayerInRangeOfPoint(playerid,3.0,205.2868,-102.2578,1005.2578) || IsPlayerInRangeOfPoint(playerid,3.0,208.5928,-33.9872,1001.9297) || IsPlayerInRangeOfPoint(playerid,3.0,209.9369,-135.1686,1002.8672) ||
	    			IsPlayerInRangeOfPoint(playerid,3.0,149.3744,-78.7390,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,208.4021,-7.5041,1001.2109) || IsPlayerInRangeOfPoint(playerid,3.0,198.6052,-166.8229,1000.5234) ||
	    			IsPlayerInRangeOfPoint(playerid,3.0,212.4442,-96.4369,1005.2578) || IsPlayerInRangeOfPoint(playerid,3.0,197.3729,-40.3967,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,199.3410,-138.7777,1003.5078) ||
	    			IsPlayerInRangeOfPoint(playerid,3.0,147.4459,-72.5470,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,226.1939,-11.2933,1002.2109) || IsPlayerInRangeOfPoint(playerid,3.0,202.4432,-166.7652,1000.5234) ||
	    			IsPlayerInRangeOfPoint(playerid,3.0,205.0045,-96.9579,1005.2578) || IsPlayerInRangeOfPoint(playerid,3.0,210.7852,-44.9170,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,215.7504,-137.4998,1003.5078) ||
	    			IsPlayerInRangeOfPoint(playerid,3.0,166.4640,-80.5297,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,226.2144,-5.1318,1002.2109) || IsPlayerInRangeOfPoint(playerid,3.0,210.0818,-166.7970,1000.5234) ||
	    			IsPlayerInRangeOfPoint(playerid,3.0,202.5804,-96.4468,1005.2578) || IsPlayerInRangeOfPoint(playerid,3.0,197.3730,-48.3824,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,216.1559,-132.9930,1003.5078) ||
	    			IsPlayerInRangeOfPoint(playerid,3.0,156.3242,-80.4837,1001.8047) || IsPlayerInRangeOfPoint(playerid,3.0,215.5925,-9.6650,1001.2109) || IsPlayerInRangeOfPoint(playerid,3.0,206.6252,-166.7522,1000.5306)) {
	    				format(string,sizeof(string),"{ffffff}| Информация о товаре:"cGRAY"\n\nНазвание - %s\nЦена - "cGREEN"$%d",
						_itemsInfo[PlayerBuyingItemsShop[playerid][GetPVarInt(playerid,"playerSelectBuyingSlot")]][invName],
						PlayerBuyingItemsShopProd[playerid][GetPVarInt(playerid,"playerSelectBuyingSlot")] * Bizz::[GetPVarInt(playerid,"PlayerBizzID")][bSettings][5]);
						return showPlayerDialog(playerid,d_bizz + 9,0," ",string,"Купить","Закрыть");
					}
					format(string,sizeof(string),"{ffffff}| Информация о товаре:"cGRAY"\n\nНазвание - %s\nЦена - "cGREEN"$%d",
					_itemsInfo[Bizz::[GetPVarInt(playerid,"PlayerBizzID")][bItems][GetPVarInt(playerid,"playerSelectBuyingSlot")]][invName],
					Bizz::[GetPVarInt(playerid,"PlayerBizzID")][bProdItems][GetPVarInt(playerid,"playerSelectBuyingSlot")] * Bizz::[GetPVarInt(playerid,"PlayerBizzID")][bSettings][5]);
					showPlayerDialog(playerid,d_bizz + 8,0," ",string,"Купить","Закрыть");
				}
				case 4:
				{
					if(Player[playerid][uRank] < F::[Player[playerid][uMember]][fGuns][GetPVarInt(playerid,"playerSelectBuyingSlot")]) return SendClientMessage(playerid,C_GRAY,""gbError"У вас нет доступа к данному оружию!");
					new countguns = 0;
					for(new inv; inv != 56; inv ++) {
						switch(_itemsInfo[Inv[playerid][invSlot][inv]][invID]) {
    						case 65 .. 70, 97: countguns ++;
    					}
					}
					if(countguns >= 3) return SendClientMessage(playerid,C_GRAY,""gbError"У Вас уже достаточно оружия в инвентаре.");

				   	if(kg + _itemsInfo[FracGuns[Player[playerid][uMember]][GetPVarInt(playerid,"playerSelectBuyingSlot")]][invKg] > MAX_PLAYER_KG + Player[playerid][uJobDouble][6]) return SendClientMessage(playerid,C_GRAY,""gbError"Вы уже и так много несёте с собой!");
					switch(FracGuns[Player[playerid][uMember]][GetPVarInt(playerid,"playerSelectBuyingSlot")])
					{
					    case 426: GivePlayerItem(playerid, FracGuns[Player[playerid][uMember]][GetPVarInt(playerid,"playerSelectBuyingSlot")], FracMaterials[Player[playerid][uMember]][GetPVarInt(playerid,"playerSelectBuyingSlot")]);
					    case 458: GivePlayerItem(playerid, FracGuns[Player[playerid][uMember]][GetPVarInt(playerid,"playerSelectBuyingSlot")], FracMaterials[Player[playerid][uMember]][GetPVarInt(playerid,"playerSelectBuyingSlot")]-230);
					    case 428: GivePlayerItem(playerid, FracGuns[Player[playerid][uMember]][GetPVarInt(playerid,"playerSelectBuyingSlot")], FracMaterials[Player[playerid][uMember]][GetPVarInt(playerid,"playerSelectBuyingSlot")]);
					    case 429: GivePlayerItem(playerid, FracGuns[Player[playerid][uMember]][GetPVarInt(playerid,"playerSelectBuyingSlot")], FracMaterials[Player[playerid][uMember]][GetPVarInt(playerid,"playerSelectBuyingSlot")]);
					    case 430: GivePlayerItem(playerid, FracGuns[Player[playerid][uMember]][GetPVarInt(playerid,"playerSelectBuyingSlot")], FracMaterials[Player[playerid][uMember]][GetPVarInt(playerid,"playerSelectBuyingSlot")]);
					    case 431: GivePlayerItem(playerid, FracGuns[Player[playerid][uMember]][GetPVarInt(playerid,"playerSelectBuyingSlot")], FracMaterials[Player[playerid][uMember]][GetPVarInt(playerid,"playerSelectBuyingSlot")]);
					}
					SendClientMessage(playerid,C_GRAY,""gbAccess"Вы взяли служебное оружие из оружейной!");
				}
				case 8: {/****/
				    GivePlayerItem( playerid, 406, 1 );
				}
				case 9: {
					if( Player[playerid][uMember] ) sadoc_eat = { 406, 407, 408, 409 };
	        		else sadoc_eat = { 407, 408, 0, 0 };
					if( i < 4 ) {
					    if( !sadoc_eat[i] ) continue;
					    GivePlayerItem( playerid, sadoc_eat[i], 1 );
					}
				}
			}
		}
	}

	for(new i = 0; i < 18; i++) {
	    if(playertextid != slotUse[i][playerid]) continue;
	    if(playertextid == slotUse[i][playerid]) {
	        if(GetPVarInt(playerid,"changeSlotUse") == -1) {
				SetPVarInt(playerid,"selectSlotUse",i);
	            new Float:kg;
    			for(new k; k != 56; k++) kg += _itemsInfo[Inv[playerid][invSlot][k]][invKg];
				switch(GetPVarInt(playerid,"UseSlots")) {
					case 0: giveHouseInvTD( playerid );
				    case 1:
					{
				        new id = GetPVarInt(playerid,"PlayerVehicleID");
				        if(V::[id][vInvSlot][GetPVarInt(playerid,"selectSlotUse")] == 0)
						{
				        	if(GetPVarInt(playerid,"changeSlot") != -1 && Inv[playerid][invSlot][GetPVarInt(playerid,"changeSlot")] != 0)
							{
				    			switch(GetPVarInt(playerid,"UseSlots"))
								{
									case 1:
									{
    									switch(_itemsInfo[Inv[playerid][invSlot][GetPVarInt(playerid,"changeSlot")]][invID])
										{
    										case 65 .. 80,90,97:
											{
    											if(id >= lspdcars[0] && id <= lspdcars[1] || id >= sherifcar[0] && id <= sherifcar[1] ||
